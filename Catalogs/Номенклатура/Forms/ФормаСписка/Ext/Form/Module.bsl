// Подготавливает отбор и оформление списка по ассортименту.
// Без ФО — только элементы с пустым ассортиментом; с ФО — выбор, раскраска и отбор по значению.
//
&НаСервере
Процедура НастроитьОтборПоАссортименту()
	
	Если ПолучитьФункциональнуюОпцию("ДополнительныйАссортимент", Новый Структура("Пользователь", гоПользователь())) Тогда
		ДобавитьПолеАссортиментаВЗапросСписка();
		ЗаполнитьСписокВыбораАссортимента();
		ПокраситьСписокПоАссортименту();
		УстановитьОтборСпискаПоАссортименту();
	Иначе
		УстановитьОтборСпискаПоПустомуАссортименту();
	КонецЕсли;
	
КонецПроцедуры

// Раскрашивает строки списка цветом фона из справочника Ассортимент.
//
&НаСервере
Процедура ПокраситьСписокПоАссортименту()
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Ассортимент.Ссылка КАК Ссылка,
	|	Ассортимент.Цвет КАК Цвет
	|ИЗ
	|	Справочник.Ассортимент КАК Ассортимент
	|ГДЕ
	|	Ассортимент.Цвет <> """"";
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		
		ЭлементОформления = Список.УсловноеОформление.Элементы.Добавить();
		ЭлементОформления.Использование = Истина;
		ЭлементОформления.Оформление.УстановитьЗначениеПараметра("ЦветФона", гоЦветРГБ(Выборка.Цвет));
		
		Отбор = ЭлементОформления.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		Отбор.Использование = Истина;
		Отбор.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Ассортимент");
		Отбор.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
		Отбор.ПравоеЗначение = Выборка.Ссылка;
		
	КонецЦикла;
	
КонецПроцедуры

// Добавляет реквизит Ассортимент в текст запроса динамического списка.
//
&НаСервере
Процедура ДобавитьПолеАссортиментаВЗапросСписка()
	
	Если СтрНайти(Список.ТекстЗапроса, "Спр.Ассортимент") > 0 Тогда
		Возврат;
	КонецЕсли;
	
	Список.ТекстЗапроса = СтрЗаменить(Список.ТекстЗапроса,
		"Спр.JAN13 КАК JAN13",
		"Спр.JAN13 КАК JAN13,
		|	Спр.Ассортимент КАК Ассортимент");
	
КонецПроцедуры

// Заполняет выпадающий список поля Ассортимент: "<все>" и значения из ТЧ пользователя.
//
&НаСервере
Процедура ЗаполнитьСписокВыбораАссортимента()
	
	СписокВыбора = Элементы.Ассортимент.СписокВыбора;
	СписокВыбора.Очистить();
	СписокВыбора.Добавить(Справочники.Ассортимент.ПустаяСсылка(), "<все>");
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ПользователиАссортимент.Ассортимент КАК Ассортимент
	|ИЗ
	|	Справочник.Пользователи.Ассортимент КАК ПользователиАссортимент
	|ГДЕ
	|	ПользователиАссортимент.Ссылка = &Пользователь
	|	И ПользователиАссортимент.Ассортимент <> ЗНАЧЕНИЕ(Справочник.Ассортимент.ПустаяСсылка)
	|
	|УПОРЯДОЧИТЬ ПО
	|	ПользователиАссортимент.Ассортимент.Наименование";
	Запрос.УстановитьПараметр("Пользователь", гоПользователь());
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		СписокВыбора.Добавить(Выборка.Ассортимент);
	КонецЦикла;
	
КонецПроцедуры

// Оставляет в списке только номенклатуру с незаполненным ассортиментом (и все группы).
// Не обращается к реквизиту Ассортимент в запросе списка: при выключенной ФО он недоступен.
//
&НаСервере
Процедура УстановитьОтборСпискаПоПустомуАссортименту()
	
	Отбор = Список.КомпоновщикНастроек.ФиксированныеНастройки.Отбор;
	УдалитьЭлементОтбораПоПредставлению(Отбор, "ОтборПоАссортименту");
	
	НоменклатураСАссортиментом = ОбщегоНазначенияПривилегированный.НоменклатураСЗаполненнымАссортиментом();
	Если НоменклатураСАссортиментом.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	СписокИсключений = Новый СписокЗначений;
	СписокИсключений.ЗагрузитьЗначения(НоменклатураСАссортиментом);
	
	ЭлементОтбора = Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Ссылка");
	ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.НеВСписке;
	ЭлементОтбора.ПравоеЗначение = СписокИсключений;
	ЭлементОтбора.Представление = "ОтборПоАссортименту";
	ЭлементОтбора.Использование = Истина;
	ЭлементОтбора.РежимОтображения = РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Недоступный;
	
КонецПроцедуры

// Ставит отбор списка: элементы выбранного ассортимента и все группы. Пустой выбор — без отбора.
//
&НаСервере
Процедура УстановитьОтборСпискаПоАссортименту()
	
	Отбор = Список.КомпоновщикНастроек.ФиксированныеНастройки.Отбор;
	УдалитьЭлементОтбораПоПредставлению(Отбор, "ОтборПоАссортименту");
	
	Если НЕ ЗначениеЗаполнено(Ассортимент) Тогда
		Возврат;
	КонецЕсли;
	
	ГруппаОтбора = Отбор.Элементы.Добавить(Тип("ГруппаЭлементовОтбораКомпоновкиДанных"));
	ГруппаОтбора.ТипГруппы = ТипГруппыЭлементовОтбораКомпоновкиДанных.ГруппаИли;
	ГруппаОтбора.Представление = "ОтборПоАссортименту";
	ГруппаОтбора.Использование = Истина;
	ГруппаОтбора.РежимОтображения = РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Недоступный;
	
	ОтборГруппа = ГруппаОтбора.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборГруппа.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ЭтоГруппа");
	ОтборГруппа.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	ОтборГруппа.ПравоеЗначение = Истина;
	ОтборГруппа.Использование = Истина;
	
	ОтборАссортимент = ГруппаОтбора.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборАссортимент.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Ассортимент");
	ОтборАссортимент.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	ОтборАссортимент.ПравоеЗначение = Ассортимент;
	ОтборАссортимент.Использование = Истина;
	
КонецПроцедуры

// Удаляет элементы отбора с указанным представлением.
//
// Параметры:
//  Отбор         - ОтборКомпоновкиДанных - коллекция отбора;
//  Представление - Строка - представление удаляемого элемента.
//
&НаСервере
Процедура УдалитьЭлементОтбораПоПредставлению(Отбор, Представление)
	
	Удаляемые = Новый Массив;
	Для Каждого ЭлементОтбора Из Отбор.Элементы Цикл
		Если ЭлементОтбора.Представление = Представление Тогда
			Удаляемые.Добавить(ЭлементОтбора);
		КонецЕсли;
	КонецЦикла;
	
	Для Каждого ЭлементОтбора Из Удаляемые Цикл
		Отбор.Элементы.Удалить(ЭлементОтбора);
	КонецЦикла;
	
КонецПроцедуры

#Область ПодключаемаяПечать

&НаКлиенте
Процедура ВыполнитьПодключеннуюПечать(Команда)
	
	ВариантПечатнойФормы = СтрЗаменить(Команда.Имя, "ПодключеннаяПечать_", "");
	ТабДок = ПечатнаяФорма(ВариантПечатнойФормы);
	ПараметрыПечати = Новый Структура("Таб, Имя, НеДляПечати", ТабДок, НСтр("ru='Номенклатура';en='Goods'"), Ложь);
	ОткрытьФорму("ОбщаяФорма.ПечатьБезЗащиты", ПараметрыПечати, , Истина);
	
КонецПроцедуры

&НаСервере
Функция ПечатнаяФорма(ВариантПечатнойФормы)
	
	ТабДок = Новый ТабличныйДокумент;
	ПараметрыПечатиДанных = Новый Структура("Склады", ФильтрСклады.ВыгрузитьЗначения());
	Справочники.Номенклатура.ПечатьДокумента(Неопределено, ВариантПечатнойФормы, ТабДок, ПараметрыПечатиДанных);
	Возврат ТабДок;
	
КонецФункции

#КонецОбласти