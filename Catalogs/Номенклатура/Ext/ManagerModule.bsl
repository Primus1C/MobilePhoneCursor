// Возвращает доступные варианты печати справочника.
//
// Возвращаемое значение:
//  Структура - ключ — имя макета, значение — представление команды.
//
Функция ПолучитьСтруктуруПечатныхФорм() Экспорт

	Возврат Новый Структура("Иерархия,Список,Остатки",
		НСтр("ru='Товары (иерархия)';en='Goods (hierarchy)'"),
		НСтр("ru='Товары (список)';en='Goods (list)'"),
		НСтр("ru='Остатки';en='Stock'"));

КонецФункции

// Формирует табличный документ печатной формы номенклатуры.
//
// Параметры:
//  СсылкаНоменклатуры    - СправочникСсылка.Номенклатура - не используется (совместимость с печатью документов);
//  ВариантПечатнойФормы  - Строка - "Иерархия", "Список" или "Остатки";
//  ТабДокумент           - ТабличныйДокумент - заполняемый документ;
//  Параметры             - Произвольный - дополнительные параметры печати (для остатков — склады отбора).
//
Процедура ПечатьДокумента(СсылкаНоменклатуры, ВариантПечатнойФормы, ТабДокумент, Параметры = 0) Экспорт

	ТабДокумент.Очистить();
	Макет = Справочники.Номенклатура.ПолучитьМакет(ВариантПечатнойФормы);

	Если ВариантПечатнойФормы = "Иерархия" Тогда
		ПечатьИерархии(Макет, ТабДокумент);
	ИначеЕсли ВариантПечатнойФормы = "Остатки" Тогда
		ПечатьОстатков(Макет, ТабДокумент, Параметры);
	Иначе
		ПечатьСписка(Макет, ТабДокумент);
	КонецЕсли;

	ТабДокумент.ОтображатьГруппировки = Истина;
	ТабДокумент.ОтображатьСетку = Ложь;
	ТабДокумент.АвтоМасштаб = Истина;

КонецПроцедуры

// Выводит иерархическую печатную форму: группы и товары (тип Товар, без пометки удаления).
//
// Параметры:
//  Макет       - ТабличныйДокумент - макет Иерархия;
//  ТабДокумент - ТабличныйДокумент - результат печати.
//
Процедура ПечатьИерархии(Макет, ТабДокумент)

	глВывестиСекцию(ТабДокумент, Макет, "Шапка",
		Новый Структура("Представление", НСтр("ru='Номенклатура (иерархия)';en='Goods (hierarchy)'")));

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Спр.Ссылка КАК Ссылка,
	|	Спр.Родитель КАК Родитель,
	|	Спр.Код КАК Код,
	|	Спр.SKU КАК SKU,
	|	Спр.JAN13 КАК JAN13,
	|	Спр.UPC КАК UPC,
	|	Спр.Наименование КАК Наименование,
	|	Спр.Вес КАК Вес,
	|	Спр.ЗапретОтгрузки КАК ЗапретОтгрузки,
	|	Спр.ВыводитьИзАссортимента КАК ВыводитьИзАссортимента,
	|	Спр.ЭтоГруппа КАК ЭтоГруппа
	|ИЗ
	|	Справочник.Номенклатура КАК Спр
	|ГДЕ
	|	НЕ Спр.ПометкаУдаления
	|	И (Спр.ЭтоГруппа
	|			ИЛИ Спр.ТипНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.Товар))
	|
	|УПОРЯДОЧИТЬ ПО
	|	Спр.Наименование ИЕРАРХИЯ";

	Уровни = Новый Соответствие;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл

		УровеньРодителя = Уровни.Получить(Выборка.Родитель);
		Если УровеньРодителя = Неопределено Тогда
			УровеньРодителя = -1;
		КонецЕсли;
		Уровень = УровеньРодителя + 1;
		Уровни.Вставить(Выборка.Ссылка, Уровень);

		Если Выборка.ЭтоГруппа Тогда
			глВывестиСекцию(ТабДокумент, Макет, "Группа", Выборка, Уровень);
		Иначе
			глВывестиСекцию(ТабДокумент, Макет, "Строка", Выборка, Уровень);
		КонецЕсли;

	КонецЦикла;

КонецПроцедуры

// Выводит плоский список товаров (тип Товар, без пометки удаления) с родителем.
//
// Параметры:
//  Макет       - ТабличныйДокумент - макет Список;
//  ТабДокумент - ТабличныйДокумент - результат печати.
//
Процедура ПечатьСписка(Макет, ТабДокумент)

	глВывестиСекцию(ТабДокумент, Макет, "Шапка",
		Новый Структура("Представление", НСтр("ru='Номенклатура (список)';en='Goods (list)'")));

	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	Спр.Ссылка КАК Ссылка,
	               |	Спр.Код КАК Код,
	               |	Спр.SKU КАК SKU,
	               |	Спр.JAN13 КАК JAN13,
	               |	Спр.UPC КАК UPC,
	               |	Спр.Наименование КАК Наименование,
	               |	Спр.Вес КАК Вес,
	               |	Спр.Родитель КАК Родитель,
	               |	Спр.Родитель.Код КАК КодРодителя,
	               |	Спр.Родитель.Наименование КАК НаименованиеРодителя,
	               |	Спр.ЗапретОтгрузки КАК ЗапретОтгрузки,
	               |	Спр.ВыводитьИзАссортимента КАК ВыводитьИзАссортимента
	               |ИЗ
	               |	Справочник.Номенклатура КАК Спр
	               |ГДЕ
	               |	НЕ Спр.ЭтоГруппа
	               |	И НЕ Спр.ПометкаУдаления
	               |	И Спр.ТипНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.Товар)
	               |	И НЕ Спр.Родитель.ВыводитьИзАссортимента
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	Спр.Наименование";

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		глВывестиСекцию(ТабДокумент, Макет, "Строка", Выборка);
	КонецЦикла;

КонецПроцедуры

// Выводит иерархический список товаров с остатками по складам отбора формы списка.
//
// Параметры:
//  Макет       - ТабличныйДокумент - макет Остатки;
//  ТабДокумент - ТабличныйДокумент - результат печати;
//  Параметры   - Структура, Число - склады отбора в Параметры.Склады.
//
Процедура ПечатьОстатков(Макет, ТабДокумент, Параметры)

	Склады = Новый Массив;
	Если ТипЗнч(Параметры) = Тип("Структура") И Параметры.Свойство("Склады") Тогда
		Склады = Параметры.Склады;
	КонецЕсли;

	глВывестиСекцию(ТабДокумент, Макет, "Шапка",
		Новый Структура("Представление, Склад",
			НСтр("ru='Номенклатура (остатки)';en='Goods (stock)'"),
			ПредставлениеСкладовОтбора(Склады)));

	УсловиеОстатков = "Фирма = &Фирма";
	Если Склады.Количество() > 0 Тогда
		УсловиеОстатков = УсловиеОстатков + "
			|					И Склад В (&Склады)";
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Фирма", гоФирма());
	Запрос.УстановитьПараметр("Склады", Склады);
	Запрос.УстановитьПараметр("ОтборСкладов", Склады.Количество() > 0);
	Запрос.Текст = СтрШаблон(
	"ВЫБРАТЬ
	|	Остатки.Номенклатура КАК Номенклатура,
	|	СУММА(Остатки.ОстатокОстаток) КАК Остаток
	|ПОМЕСТИТЬ ВТОстатки
	|ИЗ
	|	РегистрНакопления.ОстаткиТовара.Остатки(, %1) КАК Остатки
	|
	|СГРУППИРОВАТЬ ПО
	|	Остатки.Номенклатура
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Буфер.Номенклатура КАК Номенклатура,
	|	СУММА(Буфер.Количество) КАК Количество
	|ПОМЕСТИТЬ ВТБуфер
	|ИЗ
	|	РегистрСведений.БуферСканированияДляОстатков КАК Буфер
	|ГДЕ
	|	Буфер.Фирма = &Фирма
	|	И (НЕ &ОтборСкладов
	|			ИЛИ Буфер.Склад В (&Склады))
	|
	|СГРУППИРОВАТЬ ПО
	|	Буфер.Номенклатура
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Спр.Ссылка КАК Ссылка,
	|	Спр.Родитель КАК Родитель,
	|	Спр.Код КАК Код,
	|	Спр.Наименование КАК Наименование,
	|	Спр.ЭтоГруппа КАК ЭтоГруппа,
	|	ЕСТЬNULL(ВТОстатки.Остаток, 0) - ЕСТЬNULL(ВТБуфер.Количество, 0) КАК Остаток
	|ИЗ
	|	Справочник.Номенклатура КАК Спр
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТОстатки КАК ВТОстатки
	|		ПО Спр.Ссылка = ВТОстатки.Номенклатура
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТБуфер КАК ВТБуфер
	|		ПО Спр.Ссылка = ВТБуфер.Номенклатура
	|ГДЕ
	|	НЕ Спр.ПометкаУдаления
	|	И (Спр.ЭтоГруппа
	|			ИЛИ Спр.ТипНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.Товар))
	|
	|УПОРЯДОЧИТЬ ПО
	|	Спр.Наименование ИЕРАРХИЯ", УсловиеОстатков);

	Уровни = Новый Соответствие;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл

		УровеньРодителя = Уровни.Получить(Выборка.Родитель);
		Если УровеньРодителя = Неопределено Тогда
			УровеньРодителя = -1;
		КонецЕсли;
		Уровень = УровеньРодителя + 1;
		Уровни.Вставить(Выборка.Ссылка, Уровень);

		Если Выборка.ЭтоГруппа Тогда
			глВывестиСекцию(ТабДокумент, Макет, "Группа", Выборка, Уровень);
		Иначе
			глВывестиСекцию(ТабДокумент, Макет, "Строка", Выборка, Уровень);
		КонецЕсли;

	КонецЦикла;

КонецПроцедуры

// Текст строки склада в шапке печатной формы остатков.
//
// Параметры:
//  Склады - Массив из СправочникСсылка.Склады - склады отбора формы списка.
//
// Возвращаемое значение:
//  Строка - наименование склада или список наименований.
//
Функция ПредставлениеСкладовОтбора(Склады)

	Если Склады.Количество() = 0 Тогда
		Возврат НСтр("ru='Все склады';en='All warehouses'");
	КонецЕсли;

	Имена = Новый Массив;
	Для Каждого Склад Из Склады Цикл
		Имена.Добавить(Строка(Склад));
	КонецЦикла;

	Возврат СтрСоединить(Имена, ", ");

КонецФункции
