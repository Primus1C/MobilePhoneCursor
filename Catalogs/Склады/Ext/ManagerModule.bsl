Процедура ОбработкаПолученияПредставления(Данные, Представление, СтандартнаяОбработка)
	
	//Если ТекущийЯзыкСистемы() = "en" Тогда
	Если ПользователиИнформационнойБазы.ТекущийПользователь().Язык = Метаданные.Языки.Английский Тогда 
		СтандартнаяОбработка = Ложь;
	    Представление = Данные.НаименованиеАнгл;
	КонецЕсли;

КонецПроцедуры

Процедура ОбработкаПолученияПолейПредставления(Поля, СтандартнаяОбработка) 
	
	СтандартнаяОбработка = Ложь;
	
	Поля.Добавить("Наименование");
	Поля.Добавить("НаименованиеАнгл");
	
КонецПроцедуры

// Ограничивает данные выбора складов списком, доступным текущему пользователю.
// Стандартный поиск по наименованию и коду (с начала строки) сохраняется.
//
// Параметры:
//  ДанныеВыбора         - СписокЗначений - формируемые данные выбора;
//  Параметры            - Структура - параметры получения данных выбора;
//  СтандартнаяОбработка - Булево - признак стандартной обработки.
//
Процедура ОбработкаПолученияДанныхВыбора(ДанныеВыбора, Параметры, СтандартнаяОбработка)
	
	Если НЕ ОбщегоНазначенияПовтИсп.ОграничитьДоступПоСкладам() Тогда
		Возврат;
	КонецЕсли;
	
	Если НЕ Параметры.Свойство("Отбор") Тогда
		Параметры.Вставить("Отбор", Новый Структура);
	КонецЕсли;
	
	Параметры.Отбор.Вставить("Ссылка", Новый ФиксированныйМассив(ОбщегоНазначенияПовтИсп.МассивДоступныхСкладов()));
	
КонецПроцедуры

