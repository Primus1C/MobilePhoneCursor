
Процедура ОбработкаЗаполнения(ДанныеЗаполнения, ТекстЗаполнения, СтандартнаяОбработка) 
	
	Активен = Истина;  
	
КонецПроцедуры

Процедура ПередЗаписью(Отказ)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;  
	
	Если ПометкаУдаления Тогда
		Активен = Ложь;
	КонецЕсли;
	
	ПроверитьИдентификациюСотрудников(Отказ);

КонецПроцедуры

// Проверяет уникальность и допустимость имён методов в табличной части ИдентификацияСотрудников.
//
Процедура ПроверитьИдентификациюСотрудников(Отказ)

	ДопустимыеМетоды = Новый Соответствие;
	Для Каждого ИмяМетода Из StockAPI_Утилиты.ИменаMutatingОбработчиковStockAPI() Цикл
		ДопустимыеМетоды.Вставить(ВРег(СокрЛП(ИмяМетода)), Истина);
	КонецЦикла;

	Уникальные = Новый Соответствие;
	Для Каждого СтрокаТЧ Из ИдентификацияСотрудников Цикл

		ИмяМетода = СокрЛП(СтрокаТЧ.ИмяМетода);
		Если ИмяМетода = "" Тогда
			ТекстСообщения = СтрШаблон("Строка %1 табличной части «Идентификация сотрудников»: не заполнено имя метода.", СтрокаТЧ.НомерСтроки);
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, ЭтотОбъект, СтрШаблон("ИдентификацияСотрудников[%1].ИмяМетода", СтрокаТЧ.НомерСтроки - 1), , Отказ);
			Продолжить;
		КонецЕсли;

		Ключ = ВРег(ИмяМетода);
		Если Уникальные.Получить(Ключ) <> Неопределено Тогда
			ТекстСообщения = СтрШаблон("Метод %1 указан более одного раза в настройках API.", ИмяМетода);
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, ЭтотОбъект, , , Отказ);
			Продолжить;
		КонецЕсли;
		Уникальные.Вставить(Ключ, Истина);

		Если ДопустимыеМетоды.Получить(Ключ) = Неопределено Тогда
			ТекстСообщения = СтрШаблон("Метод %1 не является изменяющим обработчиком HTTP-сервиса StockAPI.", ИмяМетода);
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, ЭтотОбъект, СтрШаблон("ИдентификацияСотрудников[%1].ИмяМетода", СтрокаТЧ.НомерСтроки - 1), , Отказ);
		КонецЕсли;

	КонецЦикла;

КонецПроцедуры
