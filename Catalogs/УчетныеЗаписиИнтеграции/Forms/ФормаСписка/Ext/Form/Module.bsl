
#Область ОбработчикиСобытийФормы

&НаКлиенте
Процедура ОбработкаВыбора(ВыбранноеЗначение, ИсточникВыбора)
	
	Если КонтекстЗаполненияТЧ = "" Тогда
		Возврат;
	КонецЕсли;
	
	МассивВыбранного = МассивИзВыбранногоЗначения(ВыбранноеЗначение);
	Если МассивВыбранного.Количество() = 0 Тогда
		КонтекстЗаполненияТЧ = "";
		УчетныеЗаписиДляЗаполнения.Очистить();
		Возврат;
	КонецЕсли;
	
	МассивУчетныхЗаписей = МассивУчетныхЗаписейДляЗаполнения();
	ВидЗаполнения = КонтекстЗаполненияТЧ;
	КонтекстЗаполненияТЧ = "";
	УчетныеЗаписиДляЗаполнения.Очистить();
	
	ЗакрытьФормуИсточникаВыбора(ИсточникВыбора);
	
	КоличествоИзмененных = ДобавитьЗначенияВУчетныеЗаписиНаСервере(МассивУчетныхЗаписей, ВидЗаполнения, МассивВыбранного);
	клНамекнуть(
		"Учётные записи интеграции",
		СтрШаблон("Изменено учетных записей: %1", КоличествоИзмененных),
		БиблиотекаКартинок.ДиалогИнформация);
	ОбновитьОтображениеСписка(МассивУчетныхЗаписей);
	
КонецПроцедуры

#КонецОбласти


#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ЗадатьСклады(Команда)
	
	ЗапроситьПодтверждениеЗаполнения("Склады", "склады", "Справочник.Склады.ФормаВыбора");
	
КонецПроцедуры

&НаКлиенте
Процедура ЗадатьПокупателей(Команда)
	
	ЗапроситьПодтверждениеЗаполнения("Контрагенты", "покупателей", "Справочник.Контрагенты.ФормаВыбораГруппы");
	
КонецПроцедуры

&НаКлиенте
Процедура ЗадатьПоставщиков(Команда)
	
	ЗапроситьПодтверждениеЗаполнения("Поставщики", "поставщиков", "Справочник.Контрагенты.ФормаВыбораГруппы");
	
КонецПроцедуры

#КонецОбласти


#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ЗапроситьПодтверждениеЗаполнения(ВидЗаполнения, ТекстНазначения, ИмяФормыВыбора)
	
	Если Не ЗаполнитьСписокВыделенныхУчетныхЗаписей() Тогда
		Возврат;
	КонецЕсли;
	
	ДополнительныеПараметры = Новый Структура("ВидЗаполнения, ИмяФормыВыбора", ВидЗаполнения, ИмяФормыВыбора);
	ТекстВопроса = СтрШаблон(
		"Установить %1? 
		|Выбрано учетных записей: %2",
		ТекстНазначения,
		УчетныеЗаписиДляЗаполнения.Количество());
	клВопрос(Новый ОписаниеОповещения("ПодтверждениеЗаполненияТЧЗавершение", ЭтотОбъект, ДополнительныеПараметры), ТекстВопроса);
	
КонецПроцедуры

&НаКлиенте
Процедура ПодтверждениеЗаполненияТЧЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если Не Результат Тогда
		УчетныеЗаписиДляЗаполнения.Очистить();
		Возврат;
	КонецЕсли;
	
	КонтекстЗаполненияТЧ = ДополнительныеПараметры.ВидЗаполнения;
	ОткрытьФормуВыбораЗначений(ДополнительныеПараметры.ИмяФормыВыбора);
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьФормуВыбораЗначений(ИмяФормыВыбора)
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("РежимВыбора", Истина);
	ПараметрыФормы.Вставить("МножественныйВыбор", Истина);
	ПараметрыФормы.Вставить("ЗакрыватьПриВыборе", Истина);
	
	ОткрытьФорму(ИмяФормыВыбора, ПараметрыФормы, ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Функция ЗаполнитьСписокВыделенныхУчетныхЗаписей()
	
	УчетныеЗаписиДляЗаполнения.Очистить();
	Для Каждого ВыделеннаяСтрока Из Элементы.Список.ВыделенныеСтроки Цикл
		УчетныеЗаписиДляЗаполнения.Добавить(ВыделеннаяСтрока);
	КонецЦикла;
	
	Если УчетныеЗаписиДляЗаполнения.Количество() = 0 Тогда
		ПоказатьПредупреждение(, "Выберите одну или несколько учётных записей интеграции.");
		Возврат Ложь;
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции

&НаКлиенте
Процедура ЗакрытьФормуИсточникаВыбора(ИсточникВыбора)
	
	Если ИсточникВыбора = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ТипЗнч(ИсточникВыбора) = Тип("ФормаКлиентскогоПриложения") Тогда
		Если ИсточникВыбора.Открыта() Тогда
			ИсточникВыбора.Закрыть();
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьОтображениеСписка(МассивУчетныхЗаписей)
	
	Для Каждого СсылкаУчетнойЗаписи Из МассивУчетныхЗаписей Цикл
		ОповеститьОбИзменении(СсылкаУчетнойЗаписи);
	КонецЦикла;
	Элементы.Список.Обновить();
	
КонецПроцедуры

&НаКлиенте
Функция МассивУчетныхЗаписейДляЗаполнения()
	
	Массив = Новый Массив;
	Для Каждого ЭлементСписка Из УчетныеЗаписиДляЗаполнения Цикл
		Массив.Добавить(ЭлементСписка.Значение);
	КонецЦикла;
	Возврат Массив;
	
КонецФункции

&НаКлиенте
Функция МассивИзВыбранногоЗначения(ВыбранноеЗначение)
	
	Массив = Новый Массив;
	Если ВыбранноеЗначение = Неопределено Тогда
		Возврат Массив;
	КонецЕсли;
	
	Если ТипЗнч(ВыбранноеЗначение) = Тип("Массив") Тогда
		Для Каждого Значение Из ВыбранноеЗначение Цикл
			Если ЗначениеЗаполнено(Значение) Тогда
				Массив.Добавить(Значение);
			КонецЕсли;
		КонецЦикла;
	ИначеЕсли ЗначениеЗаполнено(ВыбранноеЗначение) Тогда
		Массив.Добавить(ВыбранноеЗначение);
	КонецЕсли;
	
	Возврат Массив;
	
КонецФункции

// Добавляет выбранные значения в табличные части учётных записей без дублирования.
//
// Параметры:
//  МассивУчетныхЗаписей - Массив из СправочникСсылка.УчетныеЗаписиИнтеграции;
//  ВидЗаполнения        - Строка - "Склады", "Контрагенты" или "Поставщики";
//  МассивВыбранного     - Массив - склады или группы контрагентов.
//
// Возвращаемое значение:
//  Число - количество учётных записей, в которых были добавлены новые строки.
//
&НаСервереБезКонтекста
Функция ДобавитьЗначенияВУчетныеЗаписиНаСервере(МассивУчетныхЗаписей, ВидЗаполнения, МассивВыбранного)
	
	КоличествоИзмененных = 0;
	
	Для Каждого СсылкаУчетнойЗаписи Из МассивУчетныхЗаписей Цикл
		
		Если Не ЗначениеЗаполнено(СсылкаУчетнойЗаписи) Тогда
			Продолжить;
		КонецЕсли;
		
		Объект = СсылкаУчетнойЗаписи.ПолучитьОбъект();
		Если Объект = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		БылиИзменения = Ложь;
		
		Если ВидЗаполнения = "Склады" Тогда
			БылиИзменения = ДобавитьСкладыВОбъект(Объект, МассивВыбранного);
		ИначеЕсли ВидЗаполнения = "Контрагенты" Тогда
			БылиИзменения = ДобавитьГруппыКонтрагентовВТЧ(Объект.Контрагенты, МассивВыбранного);
		ИначеЕсли ВидЗаполнения = "Поставщики" Тогда
			БылиИзменения = ДобавитьГруппыКонтрагентовВТЧ(Объект.Поставщики, МассивВыбранного);
		КонецЕсли;
		
		Если БылиИзменения Тогда
			Объект.Записать();
			КоличествоИзмененных = КоличествоИзмененных + 1;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат КоличествоИзмененных;
	
КонецФункции

// Добавляет склады в ТЧ «Склады» объекта учётной записи.
//
// Параметры:
//  Объект           - СправочникОбъект.УчетныеЗаписиИнтеграции;
//  МассивСкладов    - Массив из СправочникСсылка.Склады.
//
// Возвращаемое значение:
//  Булево - Истина, если добавлена хотя бы одна строка.
//
&НаСервереБезКонтекста
Функция ДобавитьСкладыВОбъект(Объект, МассивСкладов)
	
	БылиИзменения = Ложь;
	
	Для Каждого Склад Из МассивСкладов Цикл
		
		Если Не ЗначениеЗаполнено(Склад) Тогда
			Продолжить;
		КонецЕсли;
		
		Если ЕстьСкладВТЧ(Объект.Склады, Склад) Тогда
			Продолжить;
		КонецЕсли;
		
		НоваяСтрока = Объект.Склады.Добавить();
		НоваяСтрока.Склад = Склад;
		БылиИзменения = Истина;
		
	КонецЦикла;
	
	Возврат БылиИзменения;
	
КонецФункции

// Добавляет группы контрагентов в табличную часть без дублирования.
//
// Параметры:
//  ТабличнаяЧасть      - ТабличнаяЧасть - Контрагенты или Поставщики;
//  МассивГрупп         - Массив из СправочникСсылка.Контрагенты.
//
// Возвращаемое значение:
//  Булево - Истина, если добавлена хотя бы одна строка.
//
&НаСервереБезКонтекста
Функция ДобавитьГруппыКонтрагентовВТЧ(ТабличнаяЧасть, МассивГрупп)
	
	БылиИзменения = Ложь;
	
	Для Каждого ГруппаКонтрагентов Из МассивГрупп Цикл
		
		Если Не ЗначениеЗаполнено(ГруппаКонтрагентов) Тогда
			Продолжить;
		КонецЕсли;
		
		Если ЕстьГруппаКонтрагентовВТЧ(ТабличнаяЧасть, ГруппаКонтрагентов) Тогда
			Продолжить;
		КонецЕсли;
		
		НоваяСтрока = ТабличнаяЧасть.Добавить();
		НоваяСтрока.ГруппаКонтрагентов = ГруппаКонтрагентов;
		БылиИзменения = Истина;
		
	КонецЦикла;
	
	Возврат БылиИзменения;
	
КонецФункции

&НаСервереБезКонтекста
Функция ЕстьСкладВТЧ(ТабличнаяЧасть, Склад)
	
	Для Каждого СтрокаТЧ Из ТабличнаяЧасть Цикл
		Если СтрокаТЧ.Склад = Склад Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Ложь;
	
КонецФункции

&НаСервереБезКонтекста
Функция ЕстьГруппаКонтрагентовВТЧ(ТабличнаяЧасть, ГруппаКонтрагентов)
	
	Для Каждого СтрокаТЧ Из ТабличнаяЧасть Цикл
		Если СтрокаТЧ.ГруппаКонтрагентов = ГруппаКонтрагентов Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Ложь;
	
КонецФункции

&НаСервереБезКонтекста
Процедура СписокПриПолученииДанныхНаСервере(ИмяЭлемента, Настройки, Строки)
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ссылки", Строки.ПолучитьКлючи());
	Запрос.Текст = "ВЫБРАТЬ
	               |	УчетныеЗаписиИнтеграцииСклады.Ссылка КАК Ссылка,
	               |	УчетныеЗаписиИнтеграцииСклады.Склад.Наименование КАК Склад
	               |ИЗ
	               |	Справочник.УчетныеЗаписиИнтеграции.Склады КАК УчетныеЗаписиИнтеграцииСклады
	               |ГДЕ
	               |	УчетныеЗаписиИнтеграцииСклады.Ссылка В(&Ссылки)
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	УчетныеЗаписиИнтеграцииСклады.Ссылка,
	               |	УчетныеЗаписиИнтеграцииСклады.НомерСтроки
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	УчетныеЗаписиИнтеграцииКонтрагенты.Ссылка КАК Ссылка,
	               |	УчетныеЗаписиИнтеграцииКонтрагенты.ГруппаКонтрагентов.Наименование КАК Контрагент
	               |ИЗ
	               |	Справочник.УчетныеЗаписиИнтеграции.Контрагенты КАК УчетныеЗаписиИнтеграцииКонтрагенты
	               |ГДЕ
	               |	УчетныеЗаписиИнтеграцииКонтрагенты.Ссылка В(&Ссылки)
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	УчетныеЗаписиИнтеграцииКонтрагенты.Ссылка,
	               |	УчетныеЗаписиИнтеграцииКонтрагенты.НомерСтроки";
	Пакет = Запрос.ВыполнитьПакет();
	
	СкладыПоЗаписям = Новый Соответствие;
	Выборка = Пакет[0].Выбрать();
	Пока Выборка.Следующий() Цикл
		
		СписокСкладов = СкладыПоЗаписям.Получить(Выборка.Ссылка);
		Если СписокСкладов = Неопределено Тогда
			СписокСкладов = Новый СписокЗначений;
			СкладыПоЗаписям.Вставить(Выборка.Ссылка, СписокСкладов);
		КонецЕсли;
		СписокСкладов.Добавить(Выборка.Склад);
		
	КонецЦикла;
	
	КонтрагентыПоЗаписям = Новый Соответствие;
	Выборка = Пакет[1].Выбрать();
	Пока Выборка.Следующий() Цикл
		
		СписокКонтрагентов = КонтрагентыПоЗаписям.Получить(Выборка.Ссылка);
		Если СписокКонтрагентов = Неопределено Тогда
			СписокКонтрагентов = Новый СписокЗначений;
			КонтрагентыПоЗаписям.Вставить(Выборка.Ссылка, СписокКонтрагентов);
		КонецЕсли;
		СписокКонтрагентов.Добавить(Выборка.Контрагент);
		
	КонецЦикла;
	
	Для Каждого КлючИЗначение Из Строки Цикл
		
		СписокСкладов = СкладыПоЗаписям.Получить(КлючИЗначение.Ключ);
		Если СписокСкладов = Неопределено Тогда
			СписокСкладов = Новый СписокЗначений;
		КонецЕсли;
		КлючИЗначение.Значение.Данные.СкладыСтрокой = СписокСкладов;
		
		СписокКонтрагентов = КонтрагентыПоЗаписям.Получить(КлючИЗначение.Ключ);
		Если СписокКонтрагентов = Неопределено Тогда
			СписокКонтрагентов = Новый СписокЗначений;
		КонецЕсли;
		КлючИЗначение.Значение.Данные.КонтрагентыСтрокой = СписокКонтрагентов;
		
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти
