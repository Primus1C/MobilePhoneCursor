
&НаСервереБезКонтекста
Процедура СписокПриПолученииДанныхНаСервере(ИмяЭлемента, Настройки, Строки)
	
	МассивСсылок = Новый Массив;
	Для Каждого Стр Из Строки Цикл
		МассивСсылок.Добавить(Стр.Ключ);
	КонецЦикла;
	
	Если МассивСсылок.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ссылки", МассивСсылок);
	Запрос.Текст = "ВЫБРАТЬ
	               |	УчетныеЗаписиИнтеграцииСклады.Ссылка КАК Ссылка,
	               |	УчетныеЗаписиИнтеграцииСклады.Склад.Наименование КАК Склад
	               |ИЗ
	               |	Справочник.УчетныеЗаписиИнтеграции.Склады КАК УчетныеЗаписиИнтеграцииСклады
	               |ГДЕ
	               |	УчетныеЗаписиИнтеграцииСклады.Ссылка В(&Ссылки)
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	УчетныеЗаписиИнтеграцииСклады.Ссылка,
	               |	УчетныеЗаписиИнтеграцииСклады.НомерСтроки
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	УчетныеЗаписиИнтеграцииКонтрагенты.Ссылка КАК Ссылка,
	               |	УчетныеЗаписиИнтеграцииКонтрагенты.ГруппаКонтрагентов.Наименование КАК Контрагент
	               |ИЗ
	               |	Справочник.УчетныеЗаписиИнтеграции.Контрагенты КАК УчетныеЗаписиИнтеграцииКонтрагенты
	               |ГДЕ
	               |	УчетныеЗаписиИнтеграцииКонтрагенты.Ссылка В(&Ссылки)
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	УчетныеЗаписиИнтеграцииКонтрагенты.Ссылка,
	               |	УчетныеЗаписиИнтеграцииКонтрагенты.НомерСтроки";
   	Пакет = Запрос.ВыполнитьПакет();
				   
	
	СкладыПоЗаписям = Новый Соответствие;
	Выборка = Пакет[0].Выбрать();
	Пока Выборка.Следующий() Цикл
		
		СкладыСтрокой = СкладыПоЗаписям.Получить(Выборка.Ссылка);
		Если СкладыСтрокой = Неопределено Тогда
			СкладыСтрокой = Выборка.Склад;
		Иначе
			СкладыСтрокой = СкладыСтрокой + ", " + Выборка.Склад;
		КонецЕсли;
		СкладыПоЗаписям.Вставить(Выборка.Ссылка, СкладыСтрокой);
		
	КонецЦикла;
	
	//Для Каждого Стр Из Строки Цикл
	//	СкладыСтрокой = СкладыПоЗаписям.Получить(Стр.Ключ);
	//	Стр.Значение.Данные.СкладыСтрокой = ?(СкладыСтрокой = Неопределено, "", СкладыСтрокой);
	//КонецЦикла;
	
	// контрагенты
	
	КонтрагентыПоЗаписям = Новый Соответствие;
	Выборка = Пакет[1].Выбрать();
	Пока Выборка.Следующий() Цикл
		
		КонтрагентыСтрокой = КонтрагентыПоЗаписям.Получить(Выборка.Ссылка);
		Если КонтрагентыСтрокой = Неопределено Тогда
			КонтрагентыСтрокой = Выборка.Контрагент;
		Иначе
			КонтрагентыСтрокой = КонтрагентыСтрокой + ", " + Выборка.Контрагент;
		КонецЕсли;
		КонтрагентыПоЗаписям.Вставить(Выборка.Ссылка, КонтрагентыСтрокой);
		
	КонецЦикла;
	
	Для Каждого Стр Из Строки Цикл
		СкладыСтрокой = СкладыПоЗаписям.Получить(Стр.Ключ);
		Стр.Значение.Данные.СкладыСтрокой = ?(СкладыСтрокой = Неопределено, "", СкладыСтрокой);
		КонтрагентыСтрокой = КонтрагентыПоЗаписям.Получить(Стр.Ключ);
		Стр.Значение.Данные.КонтрагентыСтрокой = ?(КонтрагентыСтрокой = Неопределено, "", КонтрагентыСтрокой);
	КонецЦикла;
	
КонецПроцедуры
