#Область Команды
 	
&НаКлиенте
Процедура СгенерироватьТокен(Команда)
	
	Если ЗначениеЗаполнено(Объект.ТокенАвторизации) Тогда
		ОписаниеОповещения = Новый ОписаниеОповещения("ПослеПодтвержденияГенерации", ЭтаФорма);
		ПоказатьВопрос(ОписаниеОповещения, "Токен уже существует. Сгенерировать новый? Доступ по старому токену будет закрыт.", РежимДиалогаВопрос.ДаНет);
	Иначе
		Объект.ТокенАвторизации = StockAPI_Утилиты.СгенерироватьТокенSHA256();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеПодтвержденияГенерации(Результат, Параметры) Экспорт  
	
	Если Результат = КодВозвратаДиалога.Да Тогда
		Объект.ТокенАвторизации = StockAPI_Утилиты.СгенерироватьТокенSHA256();
	КонецЕсли;
	
КонецПроцедуры


&НаКлиенте
Процедура ЗаполнитьМетоды(Команда)  
	
	ЗаполнитьМетодыНаСервере(); 
	Модифицированность = Истина;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьМетодыНаСервере()

	ИменаМетодов = StockAPI_Утилиты.ИменаMutatingОбработчиковStockAPI();
	Существующие = Новый Соответствие;

	Для Каждого СтрокаТЧ Из Объект.ИдентификацияСотрудников Цикл
		ИмяМетода = СокрЛП(СтрокаТЧ.ИмяМетода);
		Если ИмяМетода <> "" Тогда
			Существующие.Вставить(ВРег(ИмяМетода), Истина);
		КонецЕсли;
	КонецЦикла;

	Для Каждого ИмяМетода Из ИменаМетодов Цикл
		Если Существующие.Получить(ВРег(ИмяМетода)) = Неопределено Тогда
			НовСтр = Объект.ИдентификацияСотрудников.Добавить();
			НовСтр.ИмяМетода = ИмяМетода;
			НовСтр.ОбязательныйСотрудник = Ложь;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Процедура ЭкспортВJSON(Команда)
	
	Если НЕ ЗначениеЗаполнено(Объект.Description) Тогда
		ПоказатьПредупреждение(, "Заполните наименование элемента перед экспортом.");
		Возврат;
	КонецЕсли;
	
	Диалог = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.ВыборКаталога);
	Диалог.Заголовок = "Выберите папку для экспорта";
	Диалог.ПроверятьСуществованиеФайла = Истина;
	Диалог.Показать(Новый ОписаниеОповещения("ПослеВыбораПапкиЭкспортаJSON", ЭтотОбъект));
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеВыбораПапкиЭкспортаJSON(ВыбранныеФайлы, ДополнительныеПараметры) Экспорт
	
	Если ВыбранныеФайлы = Неопределено Или ВыбранныеФайлы.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Каталог = ВыбранныеФайлы[0];
	ИмяФайла = ИмяФайлаЭкспортаJSON(Объект.Description);
	ПолноеИмяФайла = Каталог + ПолучитьРазделительПутиКлиента() + ИмяФайла;
	
	АдресФайла = ЭкспортВJSONНаСервере();
	
	ПолучаемыеФайлы = Новый Массив;
	ПолучаемыеФайлы.Добавить(Новый ОписаниеПередаваемогоФайла(ПолноеИмяФайла, АдресФайла));
	
	НачатьПолучениеФайлов(
		Новый ОписаниеОповещения("ПослеЭкспортаВJSON", ЭтотОбъект),
		ПолучаемыеФайлы,
		,
		Ложь);
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеЭкспортаВJSON(ПолученныеФайлы, ДополнительныеПараметры) Экспорт
КонецПроцедуры

// Формирует имя файла экспорта по наименованию элемента.
//
// Параметры:
//  Наименование - Строка - наименование элемента справочника.
//
// Возвращаемое значение:
//  Строка - безопасное имя файла с расширением .json.
//
&НаКлиенте
Функция ИмяФайлаЭкспортаJSON(Наименование)
	
	ИмяФайла = СокрЛП(Строка(Наименование));
	НедопустимыеСимволы = "\/:*?""<>|";
	Для Индекс = 1 По СтрДлина(НедопустимыеСимволы) Цикл
		ИмяФайла = СтрЗаменить(ИмяФайла, Сред(НедопустимыеСимволы, Индекс, 1), "_");
	КонецЦикла;
	
	Если НЕ ЗначениеЗаполнено(ИмяФайла) Тогда
		ИмяФайла = "УчетнаяЗаписьИнтеграции";
	КонецЕсли;
	
	Возврат ИмяФайла + ".json";
	
КонецФункции

&НаСервере
Функция ЭкспортВJSONНаСервере()
	
	Данные = ДанныеЭлементаДляJSON();
	
	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.УстановитьСтроку();
	ЗаписатьJSON(ЗаписьJSON, Данные);
	ТекстJSON = ЗаписьJSON.Закрыть();
	
	Возврат ПоместитьВоВременноеХранилище(
		ПолучитьДвоичныеДанныеИзСтроки(ТекстJSON, КодировкаТекста.UTF8),
		УникальныйИдентификатор);
	
КонецФункции

// Собирает реквизиты и табличные части элемента в структуру для JSON.
//
// Возвращаемое значение:
//  Структура - данные элемента справочника.
//
&НаСервере
Функция ДанныеЭлементаДляJSON()
	
	Данные = Новый Структура;
	Данные.Вставить("Метаданные", "Справочник.УчетныеЗаписиИнтеграции");
	Данные.Вставить("Код", Объект.Code);
	Данные.Вставить("Наименование", Объект.Description);
	Данные.Вставить("ТокенАвторизации", Объект.ТокенАвторизации);
	Данные.Вставить("Комментарий", Объект.Комментарий);
	Данные.Вставить("Активен", Объект.Активен);
	Данные.Вставить("WebhookURL", Объект.WebhookURL);
	Данные.Вставить("WebhookАктивен", Объект.WebhookАктивен);
	Данные.Вставить("WebhookToken", Объект.WebhookToken);
	Данные.Вставить("ОтправлятьОстатки", Объект.ОтправлятьОстатки);
	Данные.Вставить("ОтправлятьЦены", Объект.ОтправлятьЦены);
	Данные.Вставить("Администратор", Объект.Администратор);
	Данные.Вставить("РазрешитьПревышениеЦен", Объект.РазрешитьПревышениеЦен);
	Данные.Вставить("РазрешитьСнижениеЦенНа", Объект.РазрешитьСнижениеЦенНа);
	
	МассивСкладов = Новый Массив;
	Для Каждого СтрокаТЧ Из Объект.Склады Цикл
		СтрокаДанных = Новый Структура;
		СтрокаДанных.Вставить("Склад", СсылкаВДанныеJSON(СтрокаТЧ.Склад));
		МассивСкладов.Добавить(СтрокаДанных);
	КонецЦикла;
	Данные.Вставить("Склады", МассивСкладов);
	
	МассивКонтрагентов = Новый Массив;
	Для Каждого СтрокаТЧ Из Объект.Контрагенты Цикл
		СтрокаДанных = Новый Структура;
		СтрокаДанных.Вставить("ГруппаКонтрагентов", СсылкаВДанныеJSON(СтрокаТЧ.ГруппаКонтрагентов));
		МассивКонтрагентов.Добавить(СтрокаДанных);
	КонецЦикла;
	Данные.Вставить("Контрагенты", МассивКонтрагентов);
	
	МассивИдентификации = Новый Массив;
	Для Каждого СтрокаТЧ Из Объект.ИдентификацияСотрудников Цикл
		СтрокаДанных = Новый Структура;
		СтрокаДанных.Вставить("ИмяМетода", СтрокаТЧ.ИмяМетода);
		СтрокаДанных.Вставить("ОбязательныйСотрудник", СтрокаТЧ.ОбязательныйСотрудник);
		МассивИдентификации.Добавить(СтрокаДанных);
	КонецЦикла;
	Данные.Вставить("ИдентификацияСотрудников", МассивИдентификации);
	
	Возврат Данные;
	
КонецФункции

// Преобразует ссылку справочника в описание {Тип, Код} для JSON.
//
// Параметры:
//  Ссылка - ЛюбаяСсылка - ссылка справочника.
//
// Возвращаемое значение:
//  Структура, Неопределено - описание ссылки или Неопределено для пустой.
//
&НаСервере
Функция СсылкаВДанныеJSON(Ссылка)
	
	Если НЕ ЗначениеЗаполнено(Ссылка) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Возврат Новый Структура("Тип,Код", "Справочник." + Ссылка.Метаданные().Имя, Ссылка.Code);
	
КонецФункции

&НаКлиенте
Процедура ИмпортИзJSON(Команда)
	
	Диалог = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Открытие);
	Диалог.Заголовок = "Выберите файл JSON для импорта";
	Диалог.Фильтр = "Файлы JSON (*.json)|*.json|Все файлы (*.*)|*.*";
	Диалог.Расширение = "json";
	Диалог.МножественныйВыбор = Ложь;
	Диалог.ПроверятьСуществованиеФайла = Истина;
	Диалог.Показать(Новый ОписаниеОповещения("ПослеВыбораФайлаИмпортаJSON", ЭтотОбъект));
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеВыбораФайлаИмпортаJSON(ВыбранныеФайлы, ДополнительныеПараметры) Экспорт
	
	Если ВыбранныеФайлы = Неопределено Или ВыбранныеФайлы.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	НачатьПомещениеФайла(
		Новый ОписаниеОповещения("ПослеПомещенияФайлаИмпортаJSON", ЭтотОбъект),
		,
		ВыбранныеФайлы[0],
		Ложь,
		УникальныйИдентификатор);
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеПомещенияФайлаИмпортаJSON(ФайлВыбран, Адрес, ВыбранноеИмяФайла, ДополнительныеПараметры) Экспорт
	
	Если НЕ ФайлВыбран Тогда
		Возврат;
	КонецЕсли;
	
	ТекстОшибки = ИмпортИзJSONНаСервере(Адрес);
	Если ЗначениеЗаполнено(ТекстОшибки) Тогда
		ПоказатьПредупреждение(, ТекстОшибки);
		Возврат;
	КонецЕсли;
	
	Модифицированность = Истина;
	УстановитьВидимостьДоступность();
	
КонецПроцедуры

// Заполняет реквизиты формы из JSON. Ссылочные значения ищет по кодам справочников.
//
// Параметры:
//  АдресФайла - Строка - адрес двоичных данных файла во временном хранилище.
//
// Возвращаемое значение:
//  Строка - текст ошибки или пустая строка при успехе.
//
&НаСервере
Функция ИмпортИзJSONНаСервере(АдресФайла)
	
	ДвоичныеДанные = ПолучитьИзВременногоХранилища(АдресФайла);
	Если ТипЗнч(ДвоичныеДанные) <> Тип("ДвоичныеДанные") Тогда
		Возврат "Не удалось прочитать файл JSON.";
	КонецЕсли;
	
	ТекстJSON = ПолучитьСтрокуИзДвоичныхДанных(ДвоичныеДанные, КодировкаТекста.UTF8);
	
	ЧтениеJSON = Новый ЧтениеJSON;
	ЧтениеJSON.УстановитьСтроку(ТекстJSON);
	Попытка
		Данные = ПрочитатьJSON(ЧтениеJSON);
		ЧтениеJSON.Закрыть();
	Исключение
		ЧтениеJSON.Закрыть();
		Возврат "Ошибка разбора JSON: " + ОписаниеОшибки();
	КонецПопытки;
	
	Если ТипЗнч(Данные) <> Тип("Структура") Тогда
		Возврат "В файле JSON ожидается объект с реквизитами элемента.";
	КонецЕсли;
	
	Ошибки = Новый Массив;
	ЗначенияСкладов = Новый Массив;
	ЗначенияКонтрагентов = Новый Массив;
	
	Если Данные.Свойство("Склады") И ТипЗнч(Данные.Склады) = Тип("Массив") Тогда
		НомерСтроки = 0;
		Для Каждого СтрокаДанных Из Данные.Склады Цикл
			НомерСтроки = НомерСтроки + 1;
			ИмяРеквизита = СтрШаблон("Склады[%1].Склад", НомерСтроки);
			Если ТипЗнч(СтрокаДанных) <> Тип("Структура") Или НЕ СтрокаДанных.Свойство("Склад") Тогда
				Ошибки.Добавить(СтрШаблон("Некорректные данные в реквизите %1.", ИмяРеквизита));
				Продолжить;
			КонецЕсли;
			ЗначенияСкладов.Добавить(СсылкаИзДанныхJSON(СтрокаДанных.Склад, ИмяРеквизита, Ошибки));
		КонецЦикла;
	КонецЕсли;
	
	Если Данные.Свойство("Контрагенты") И ТипЗнч(Данные.Контрагенты) = Тип("Массив") Тогда
		НомерСтроки = 0;
		Для Каждого СтрокаДанных Из Данные.Контрагенты Цикл
			НомерСтроки = НомерСтроки + 1;
			ИмяРеквизита = СтрШаблон("Контрагенты[%1].ГруппаКонтрагентов", НомерСтроки);
			Если ТипЗнч(СтрокаДанных) <> Тип("Структура") Или НЕ СтрокаДанных.Свойство("ГруппаКонтрагентов") Тогда
				Ошибки.Добавить(СтрШаблон("Некорректные данные в реквизите %1.", ИмяРеквизита));
				Продолжить;
			КонецЕсли;
			ЗначенияКонтрагентов.Добавить(СсылкаИзДанныхJSON(СтрокаДанных.ГруппаКонтрагентов, ИмяРеквизита, Ошибки));
		КонецЦикла;
	КонецЕсли;
	
	Если Ошибки.Количество() > 0 Тогда
		Возврат СтрСоединить(Ошибки, Символы.ПС);
	КонецЕсли;
	
	Если Данные.Свойство("Наименование") Тогда
		Объект.Description = Строка(Данные.Наименование);
	КонецЕсли;
	Если Данные.Свойство("ТокенАвторизации") Тогда
		Объект.ТокенАвторизации = Строка(Данные.ТокенАвторизации);
	КонецЕсли;
	Если Данные.Свойство("Комментарий") Тогда
		Объект.Комментарий = Строка(Данные.Комментарий);
	КонецЕсли;
	Если Данные.Свойство("Активен") Тогда
		Объект.Активен = Булево(Данные.Активен);
	КонецЕсли;
	Если Данные.Свойство("WebhookURL") Тогда
		Объект.WebhookURL = Строка(Данные.WebhookURL);
	КонецЕсли;
	Если Данные.Свойство("WebhookАктивен") Тогда
		Объект.WebhookАктивен = Булево(Данные.WebhookАктивен);
	КонецЕсли;
	Если Данные.Свойство("WebhookToken") Тогда
		Объект.WebhookToken = Строка(Данные.WebhookToken);
	КонецЕсли;
	Если Данные.Свойство("ОтправлятьОстатки") Тогда
		Объект.ОтправлятьОстатки = Булево(Данные.ОтправлятьОстатки);
	КонецЕсли;
	Если Данные.Свойство("ОтправлятьЦены") Тогда
		Объект.ОтправлятьЦены = Булево(Данные.ОтправлятьЦены);
	КонецЕсли;
	Если Данные.Свойство("Администратор") Тогда
		Объект.Администратор = Булево(Данные.Администратор);
	КонецЕсли;
	Если Данные.Свойство("РазрешитьПревышениеЦен") Тогда
		Объект.РазрешитьПревышениеЦен = Булево(Данные.РазрешитьПревышениеЦен);
	КонецЕсли;
	Если Данные.Свойство("РазрешитьСнижениеЦенНа") Тогда
		Объект.РазрешитьСнижениеЦенНа = Число(Данные.РазрешитьСнижениеЦенНа);
	КонецЕсли;
	
	Объект.Склады.Очистить();
	Для Каждого СсылкаСклада Из ЗначенияСкладов Цикл
		Если ЗначениеЗаполнено(СсылкаСклада) Тогда
			НоваяСтрока = Объект.Склады.Добавить();
			НоваяСтрока.Склад = СсылкаСклада;
		КонецЕсли;
	КонецЦикла;
	
	Объект.Контрагенты.Очистить();
	Для Каждого СсылкаКонтрагента Из ЗначенияКонтрагентов Цикл
		Если ЗначениеЗаполнено(СсылкаКонтрагента) Тогда
			НоваяСтрока = Объект.Контрагенты.Добавить();
			НоваяСтрока.ГруппаКонтрагентов = СсылкаКонтрагента;
		КонецЕсли;
	КонецЦикла;
	
	Объект.ИдентификацияСотрудников.Очистить();
	Если Данные.Свойство("ИдентификацияСотрудников") И ТипЗнч(Данные.ИдентификацияСотрудников) = Тип("Массив") Тогда
		Для Каждого СтрокаДанных Из Данные.ИдентификацияСотрудников Цикл
			Если ТипЗнч(СтрокаДанных) <> Тип("Структура") Тогда
				Продолжить;
			КонецЕсли;
			НоваяСтрока = Объект.ИдентификацияСотрудников.Добавить();
			Если СтрокаДанных.Свойство("ИмяМетода") Тогда
				НоваяСтрока.ИмяМетода = Строка(СтрокаДанных.ИмяМетода);
			КонецЕсли;
			Если СтрокаДанных.Свойство("ОбязательныйСотрудник") Тогда
				НоваяСтрока.ОбязательныйСотрудник = Булево(СтрокаДанных.ОбязательныйСотрудник);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	Возврат "";
	
КонецФункции

// Ищет ссылку справочника по описанию из JSON (Тип + Код).
//
// Параметры:
//  ОписаниеСсылки - Структура, Неопределено - описание ссылки;
//  ИмяРеквизита   - Строка - имя реквизита для текста ошибки;
//  Ошибки         - Массив - накопитель текстов ошибок.
//
// Возвращаемое значение:
//  ЛюбаяСсылка, Неопределено - найденная ссылка или Неопределено.
//
&НаСервере
Функция СсылкаИзДанныхJSON(ОписаниеСсылки, ИмяРеквизита, Ошибки)
	
	Если ОписаниеСсылки = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Если ТипЗнч(ОписаниеСсылки) <> Тип("Структура")
		Или НЕ ОписаниеСсылки.Свойство("Тип")
		Или НЕ ОписаниеСсылки.Свойство("Код") Тогда
		Ошибки.Добавить(СтрШаблон("Некорректное описание ссылки в реквизите %1.", ИмяРеквизита));
		Возврат Неопределено;
	КонецЕсли;
	
	ИмяТипа = Строка(ОписаниеСсылки.Тип);
	Если НЕ СтрНачинаетсяС(ИмяТипа, "Справочник.") Тогда
		Ошибки.Добавить(СтрШаблон("Неподдерживаемый тип ссылки ""%1"" в реквизите %2.", ИмяТипа, ИмяРеквизита));
		Возврат Неопределено;
	КонецЕсли;
	
	ИмяСправочника = Сред(ИмяТипа, СтрДлина("Справочник.") + 1);
	Если Метаданные.Справочники.Найти(ИмяСправочника) = Неопределено Тогда
		Ошибки.Добавить(СтрШаблон("Не найден справочник %1 (реквизит %2).", ИмяСправочника, ИмяРеквизита));
		Возврат Неопределено;
	КонецЕсли;
	
	Ссылка = Справочники[ИмяСправочника].НайтиПоКоду(ОписаниеСсылки.Код);
	Если НЕ ЗначениеЗаполнено(Ссылка) Тогда
		Ошибки.Добавить(СтрШаблон(
			"Не найден элемент справочника %1 по коду %2 (реквизит %3).",
			ИмяСправочника,
			ОписаниеСсылки.Код,
			ИмяРеквизита));
		Возврат Неопределено;
	КонецЕсли;
	
	Возврат Ссылка;
	
КонецФункции

#КонецОбласти

