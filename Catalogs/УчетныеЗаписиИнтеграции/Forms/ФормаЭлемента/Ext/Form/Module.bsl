#Область СобытияФормы
	
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Элементы.ИдентификацияСотрудниковИмяМетода.СписокВыбора.ЗагрузитьЗначения(StockAPI_Утилиты.ИменаMutatingОбработчиковStockAPI());
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)  
	
	УстановитьВидимостьДоступность(); 
	
КонецПроцедуры    

&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)
	
	ИменаМетодов = Новый Соответствие;
	Для Каждого СтрокаИдентификации Из Объект.ИдентификацияСотрудников Цикл
		ИмяМетода = ВРег(СокрЛП(СтрокаИдентификации.ИмяМетода));
		Если ИмяМетода = "" Тогда
			Продолжить;
		КонецЕсли;
		НомерПервойСтроки = ИменаМетодов.Получить(ИмяМетода);
		Если НомерПервойСтроки <> Неопределено Тогда
			Сообщить(СтрШаблон(
			"Метод %1 повторяется в строках %2 и %3 табличной части «Идентификация сотрудников».",
			СтрокаИдентификации.ИмяМетода,
			НомерПервойСтроки,
			СтрокаИдентификации.НомерСтроки));
			Отказ = Истина;
			Возврат;
		КонецЕсли;
		ИменаМетодов.Вставить(ИмяМетода, СтрокаИдентификации.НомерСтроки);
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти


#Область СобытияЭлементов

&НаКлиенте
Процедура WebhookАктивенПриИзменении(Элемент)
	
	Если Объект.WebhookАктивен и Не ЗначениеЗаполнено(Объект.WebhookURL) Тогда
		Объект.WebhookАктивен = ложь;
		Сообщить("Не заполнен URL");
	КонецЕсли;                  
	
	УстановитьВидимостьДоступность();  
	
КонецПроцедуры
	
#КонецОбласти     


&НаКлиенте
Процедура УстановитьВидимостьДоступность()
	
	Элементы.ГруппаWebHookПодч.Доступность = Объект.WebhookАктивен;
	
КонецПроцедуры


#Область Команды
 	
&НаКлиенте
Процедура СгенерироватьТокен(Команда)
	
	Если ЗначениеЗаполнено(Объект.ТокенАвторизации) Тогда
		ОписаниеОповещения = Новый ОписаниеОповещения("ПослеПодтвержденияГенерации", ЭтаФорма);
		ПоказатьВопрос(ОписаниеОповещения, "Токен уже существует. Сгенерировать новый? Доступ по старому токену будет закрыт.", РежимДиалогаВопрос.ДаНет);
	Иначе
		Объект.ТокенАвторизации = StockAPI_Утилиты.СгенерироватьТокенSHA256();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеПодтвержденияГенерации(Результат, Параметры) Экспорт  
	
	Если Результат = КодВозвратаДиалога.Да Тогда
		Объект.ТокенАвторизации = StockAPI_Утилиты.СгенерироватьТокенSHA256();
	КонецЕсли;
	
КонецПроцедуры


&НаКлиенте
Процедура ЗаполнитьМетоды(Команда)  
	
	ЗаполнитьМетодыНаСервере(); 
	Модифицированность = Истина;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьМетодыНаСервере()

	ИменаМетодов = StockAPI_Утилиты.ИменаMutatingОбработчиковStockAPI();
	Существующие = Новый Соответствие;

	Для Каждого СтрокаТЧ Из Объект.ИдентификацияСотрудников Цикл
		ИмяМетода = СокрЛП(СтрокаТЧ.ИмяМетода);
		Если ИмяМетода <> "" Тогда
			Существующие.Вставить(ВРег(ИмяМетода), Истина);
		КонецЕсли;
	КонецЦикла;

	Для Каждого ИмяМетода Из ИменаМетодов Цикл
		Если Существующие.Получить(ВРег(ИмяМетода)) = Неопределено Тогда
			НовСтр = Объект.ИдентификацияСотрудников.Добавить();
			НовСтр.ИмяМетода = ИмяМетода;
			НовСтр.ОбязательныйСотрудник = Ложь;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры    

#КонецОбласти

