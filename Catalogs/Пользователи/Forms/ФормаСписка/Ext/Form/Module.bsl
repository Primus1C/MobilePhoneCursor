	//СтандартнаяОбработка = Ложь;
КонецПроцедуры

&НаСервереБезКонтекста
Процедура СписокПриПолученииДанныхНаСервере(ИмяЭлемента, Настройки, Строки)

	УстановитьПривилегированныйРежим(Истина);
	
	МассивСсылок = Новый Массив;
	Для каждого Стр Из Строки Цикл
		МассивСсылок.Добавить(Стр.Ключ);
	КонецЦикла;
	
	СоответствиеГрупп = Новый Соответствие;
	Если МассивСсылок.Количество() > 0 Тогда
		Запрос = Новый Запрос;
		Запрос.УстановитьПараметр("Ссылки", МассивСсылок);
		Запрос.Текст = "ВЫБРАТЬ
		               |	ТЧ.Ссылка КАК Ссылка,
		               |	ТЧ.Группа.Наименование КАК Наименование
		               |ИЗ
		               |	Справочник.Пользователи.Контрагенты КАК ТЧ
		               |ГДЕ
		               |	ТЧ.Ссылка В(&Ссылки)
		               |
		               |УПОРЯДОЧИТЬ ПО
		               |	ТЧ.НомерСтроки";
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			ИменаГрупп = СоответствиеГрупп.Получить(Выборка.Ссылка);
			Если ИменаГрупп = Неопределено Тогда
				ИменаГрупп = Новый Массив;
				СоответствиеГрупп.Вставить(Выборка.Ссылка, ИменаГрупп);
			КонецЕсли;
			Если ЗначениеЗаполнено(Выборка.Наименование) Тогда
				ИменаГрупп.Добавить(Выборка.Наименование);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	Для каждого Стр Из Строки Цикл
		
		лПользовательИБ = ПользователиИнформационнойБазы.НайтиПоУникальномуИдентификатору(Стр.Ключ.ИдентификаторПользователяИБ);
		Если лПользовательИБ <> Неопределено Тогда
			лРоли = "";
			Для каждого Р Из лПользовательИБ.Роли Цикл
				лРоли = лРоли + Р.Имя + ", ";
			КонецЦикла;
			Стр.Значение.Данные.Роли = Лев(лРоли, СтрДлина(лРоли) - 2);
		КонецЕсли;
		
		Данные = Стр.Значение.Данные;
		ИменаГрупп = СоответствиеГрупп.Получить(Стр.Ключ);
		Если ИменаГрупп <> Неопределено И ИменаГрупп.Количество() > 0 Тогда
			Стр.Значение.Данные.ГруппыКонтрагентов = СтрСоединить(ИменаГрупп, ", ");
		КонецЕсли;
		
		Если ЗначениеЗаполнено(Данные.ГруппыКонтрагентов) Тогда
			Стр.Значение.Данные.ГруппыКонтрагентов = СтрШаблон("%1 %2: %3",
														?(Данные.ВариантДоступаККонтрагентам = Перечисления.ВариантДоступа.Запретить, "Запрещено", "Разрешено"),
														Стр.Ключ.Контрагенты.Количество(),
														Данные.ГруппыКонтрагентов);
		
		КонецЕсли;     

	КонецЦикла;

	УстановитьПривилегированныйРежим(Ложь);
	
КонецПроцедуры


#Область Команды
	
&НаКлиенте
Процедура РазрешитьДоступ(Команда)
	клВопрос(Новый ОписаниеОповещения("РазрешитьДоступЗавершение", ЭтотОбъект), "Разрешить всем пользователям доступ к товарным остаткам?");
КонецПроцедуры

&НаКлиенте
Процедура РазрешитьДоступЗавершение(Результат, ДополнительныеПараметры) Экспорт
	Если НЕ Результат Тогда Возврат КонецЕсли;
	Ном = 0;
	УстановитьДоступ(Истина, Ном);
	клНамекнуть("Товарные остатки", "Установлен доступ пользователей: " + Ном, БиблиотекаКартинок.ДиалогИнформация);
КонецПроцедуры

&НаКлиенте
Процедура ЗапретитьДоступ(Команда)
	клВопрос(Новый ОписаниеОповещения("ЗапретитьДоступЗавершение", ЭтотОбъект), "Запретить всем пользователям (кроме администраторов) доступ к товарным остаткам?");
КонецПроцедуры

&НаКлиенте
Процедура ЗапретитьДоступЗавершение(Результат, ДополнительныеПараметры) Экспорт
	Если НЕ Результат Тогда Возврат КонецЕсли;
	Ном = 0;
	УстановитьДоступ(Ложь, Ном);
	клНамекнуть("Товарные остатки", "Запрещен доступ пользователей: " + Ном, БиблиотекаКартинок.ДиалогИнформация);
КонецПроцедуры

&НаСервере
Процедура УстановитьДоступ(Доступ, Ном)

	УстановитьПривилегированныйРежим(Истина);

	Запр = Новый Запрос;
	Запр.Текст = "ВЫБРАТЬ
	             |	Пользователи.Ссылка КАК Ссылка
	             |ИЗ
	             |	Справочник.Пользователи КАК Пользователи
	             |ГДЕ
	             |	НЕ Пользователи.ПометкаУдаления";
    Выборка = Запр.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		
		лПользовательИБ = ПользователиИнформационнойБазы.НайтиПоУникальномуИдентификатору(Выборка.Ссылка.ИдентификаторПользователяИБ);
		Если лПользовательИБ = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		ЭтоАдмин = Ложь;
		Для каждого Р Из лПользовательИБ.Роли Цикл
			Если Р.Имя = "Администратор" Тогда
				ЭтоАдмин = Истина;
			КонецЕсли;	
			
		КонецЦикла;
		Если НЕ ЭтоАдмин Тогда
			спр = Выборка.Ссылка.ПолучитьОбъект();
			спр.ДоступКОстаткамТоваров = Доступ; 
			спр.Записать();
			Ном = Ном + 1;
		КонецЕсли;
	КонецЦикла;
	
	УстановитьПривилегированныйРежим(Ложь);
	
КонецПроцедуры   

#КонецОбласти

 
