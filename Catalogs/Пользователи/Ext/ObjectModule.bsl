Процедура ПриЗаписи(Отказ)

	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;

	Если ДополнительныеСвойства.Свойство("УведомитьОПодключенииКЗадачам") Тогда
		УведомитьОПодключенииКПодсистемеЗадач(Ссылка);
	КонецЕсли;
	
	Если ДополнительныеСвойства.Свойство("КомментарийИзмененийТЧ") Тогда
		гоЗаписьЖурналаРегистрации(
			ДополнительныеСвойства.КомментарийИзмененийТЧ,
			"Пользователи",
			"Изменение табличных частей",
			Ссылка,
			2);
	КонецЕсли;

КонецПроцедуры

// Отправляет напоминание пользователю о подключении к подсистеме задач.
//
// Параметры:
//  ПользовательСсылка - СправочникСсылка.Пользователи - пользователь, которому адресовано уведомление.
//
Процедура УведомитьОПодключенииКПодсистемеЗадач(ПользовательСсылка)

	Если НЕ ЗначениеЗаполнено(ПользовательСсылка) Тогда
		Возврат;
	КонецЕсли;

	ТекстСообщения = НСтр("ru = 'Вы подключены к подсистеме задач. Использование: Сервис -> Задачи'; en = 'You have been connected to the tasks subsystem. Usage: Service -> Tasks'");

	МенеджерЗаписи = РегистрыСведений.Сооб_Сообщения.СоздатьМенеджерЗаписи();
	МенеджерЗаписи.Получатель = ПользовательСсылка;
	МенеджерЗаписи.ТипСообщения = Перечисления.Сооб_ТипСообщения.Напоминание;
	МенеджерЗаписи.Категория = Перечисления.Сооб_Категория.ВнеОчереди;
	МенеджерЗаписи.Автор = гоПользователь();
	МенеджерЗаписи.ЗапланированнаяДатаДоставки = ТекущаяДатаСеанса();
	МенеджерЗаписи.ДатаМожноУдалять = ТекущаяДатаСеанса() + 24 * 60 * 60;
	МенеджерЗаписи.УникИдент = Новый УникальныйИдентификатор;
	МенеджерЗаписи.Тема = НСтр("ru = 'Задачи'; en = 'Tasks'");
	МенеджерЗаписи.Сообщение = ТекстСообщения;
	МенеджерЗаписи.ДатаСоздания = ТекущаяДатаСеанса();
	МенеджерЗаписи.Записать();

КонецПроцедуры

// Сравнивает табличные части с данными в ИБ и при наличии изменений
// сохраняет текст комментария в ДополнительныеСвойства.КомментарийИзмененийТЧ.
//
Процедура ПодготовитьКомментарийИзмененийТабличныхЧастей()
	
	ОписанияТЧ = Новый Массив;
	ОписанияТЧ.Добавить(Новый Структура("Имя, Поля", "Склады", "Склад"));
	ОписанияТЧ.Добавить(Новый Структура("Имя, Поля", "ОграниченияПоСкладам", "Склад,Ограничение"));
	ОписанияТЧ.Добавить(Новый Структура("Имя, Поля", "ДенежныеСчета", "ДенежныйСчет"));
	ОписанияТЧ.Добавить(Новый Структура("Имя, Поля", "СкладыКонтрагентов", "Склад"));
	ОписанияТЧ.Добавить(Новый Структура("Имя, Поля", "Контрагенты", "Группа"));
	ОписанияТЧ.Добавить(Новый Структура("Имя, Поля", "Офисы", "Офис"));
	
	СтарыеЗначенияПоТЧ = Новый Соответствие;
	Если ЭтоНовый() Тогда
		Для Каждого ОписаниеТЧ Из ОписанияТЧ Цикл
			СтарыеЗначенияПоТЧ.Вставить(ОписаниеТЧ.Имя, Новый Массив);
		КонецЦикла;
	Иначе
		СтарыйОбъект = Ссылка.ПолучитьОбъект();
		Для Каждого ОписаниеТЧ Из ОписанияТЧ Цикл
			СтарыеЗначенияПоТЧ.Вставить(
				ОписаниеТЧ.Имя,
				ЗначенияСтрокТабличнойЧасти(СтарыйОбъект[ОписаниеТЧ.Имя], ОписаниеТЧ.Поля));
		КонецЦикла;
	КонецЕсли;
	
	ЧастиКомментария = Новый Массив;
	Для Каждого ОписаниеТЧ Из ОписанияТЧ Цикл
		
		СтарыеЗначения = СтарыеЗначенияПоТЧ[ОписаниеТЧ.Имя];
		НовыеЗначения = ЗначенияСтрокТабличнойЧасти(ЭтотОбъект[ОписаниеТЧ.Имя], ОписаниеТЧ.Поля);
		Удаленные = РазностьСтроковыхЗначений(СтарыеЗначения, НовыеЗначения);
		Добавленные = РазностьСтроковыхЗначений(НовыеЗначения, СтарыеЗначения);
		Если Удаленные.Количество() = 0 И Добавленные.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		ЧастиСтроки = Новый Массив;
		ЧастиСтроки.Добавить(ОписаниеТЧ.Имя + ":");
		Если Добавленные.Количество() > 0 Тогда
			ЧастиСтроки.Добавить(СтрШаблон("добавлены %1", СтрСоединить(Добавленные, ", ")));
		КонецЕсли;
		Если Удаленные.Количество() > 0 Тогда
			ЧастиСтроки.Добавить(СтрШаблон("удалены %1", СтрСоединить(Удаленные, ", ")));
		КонецЕсли;
		ЧастиКомментария.Добавить(СтрСоединить(ЧастиСтроки, " "));
	КонецЦикла;
	
	Если ЧастиКомментария.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ДополнительныеСвойства.Вставить("КомментарийИзмененийТЧ", СтрСоединить(ЧастиКомментария, "; "));
	
КонецПроцедуры

// Возвращает представления строк табличной части по указанным полям.
//
// Параметры:
//  ТабличнаяЧасть - ТабличнаяЧасть - сравниваемая ТЧ;
//  ПоляСтрокой    - Строка - имена полей через запятую.
//
// Возвращаемое значение:
//  Массив из Строка - представления строк.
//
Функция ЗначенияСтрокТабличнойЧасти(ТабличнаяЧасть, ПоляСтрокой)
	
	ИменаПолей = СтрРазделить(ПоляСтрокой, ",", Ложь);
	Результат = Новый Массив;
	Для Каждого СтрокаТЧ Из ТабличнаяЧасть Цикл
		Части = Новый Массив;
		Для Каждого ИмяПоля Из ИменаПолей Цикл
			Части.Добавить(Строка(СтрокаТЧ[СокрЛП(ИмяПоля)]));
		КонецЦикла;
		Результат.Добавить(СтрСоединить(Части, " / "));
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// Возвращает элементы первого массива, которых нет во втором.
//
// Параметры:
//  Исходные   - Массив из Строка;
//  Исключения - Массив из Строка.
//
// Возвращаемое значение:
//  Массив из Строка - отсортированная разность.
//
Функция РазностьСтроковыхЗначений(Исходные, Исключения)
	
	ИсключенияСоответствие = Новый Соответствие;
	Для Каждого Элемент Из Исключения Цикл
		ИсключенияСоответствие.Вставить(Элемент, Истина);
	КонецЦикла;
	
	Список = Новый СписокЗначений;
	Для Каждого Элемент Из Исходные Цикл
		Если ИсключенияСоответствие.Получить(Элемент) = Неопределено Тогда
			Список.Добавить(Элемент);
		КонецЕсли;
	КонецЦикла;
	Список.СортироватьПоЗначению();
	
	Возврат Список.ВыгрузитьЗначения();
	
КонецФункции

