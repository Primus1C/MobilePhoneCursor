&НаКлиенте
Процедура ОбработкаКоманды(ПараметрКоманды, ПараметрыВыполненияКоманды) 
	
	Если ПараметрКоманды = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Результат = ПерепровестиНаСервере(ПараметрКоманды);
	Если Результат.Ошибка <> "" Тогда
		ПоказатьПредупреждение(, Результат.Ошибка, , "Документ не проведен!");
	Иначе
		ОповеститьОбИзменении(ПараметрКоманды);
		// при необходимости — обновить форму документа
		ПоказатьПредупреждение(, "Документ проведен: " + ПараметрКоманды, , );
	КонецЕсли;   
	
КонецПроцедуры

&НаСервере
Функция ПерепровестиНаСервере(СсылкаДокумента)
	
	Результат = Новый Структура("Ошибка", "");
	Если НЕ ЗначениеЗаполнено(СсылкаДокумента) Или НЕ СсылкаДокумента.Проведен Тогда
		Результат.Ошибка = "Документ не проведён.";
		Возврат Результат;
	КонецЕсли;
	
	омСервер.УстановитьПараметрСеанса("ГрупповоеПерепроведениеДокументов", Истина);
	Попытка
		ДокОбъект = СсылкаДокумента.ПолучитьОбъект();
		ДокОбъект.Записать(РежимЗаписиДокумента.Проведение);
	Исключение
		Результат.Ошибка = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;
	омСервер.УстановитьПараметрСеанса("ГрупповоеПерепроведениеДокументов", Ложь);
	
	Возврат Результат;
	
КонецФункции