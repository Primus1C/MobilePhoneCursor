#Область Роутер

// ─── HTTP-утилиты (остаются в роутере — работают с объектами HTTPСервис*) ───────

Функция ПрочитатьТелоJSON(Запрос) Экспорт

	Тело = Запрос.ПолучитьТелоКакСтроку();
	StockAPI_Утилиты.УстановитьКэшТелаЗапросаПротокола(Тело);
	Если СокрЛП(Тело) = "" Тогда
		Возврат Новый Структура;
	КонецЕсли;

	ЧтениеJSON = Новый ЧтениеJSON;
	ЧтениеJSON.УстановитьСтроку(Тело);

	Возврат ПрочитатьJSON(ЧтениеJSON);

КонецФункции

// Подготавливает данные изменяющего запроса: тело JSON (или multipart для инвойса),
// параметры URL, проверка сотрудника.
//
// Параметры:
//  Запрос              - HTTPСервисЗапрос - входящий запрос;
//  ИмяМетода           - Строка - имя обработчика HTTP-сервиса;
//  УчетнаяЗапись       - СправочникСсылка.УчетныеЗаписиИнтеграции - учётная запись API;
//  ДопПараметрыURL     - Строка - дополнительные имена параметров URL через запятую;
//  РазрешитьMultipart  - Булево - разбирать multipart/form-data (для invoicePOST).
//
// Возвращаемое значение:
//  Структура - поля ДанныеЗапроса, Ошибка, Сотрудник.
//
Функция ПодготовитьДанныеИзменения(Запрос, ИмяМетода, УчетнаяЗапись, ДопПараметрыURL = "",
	РазрешитьMultipart = Ложь)

	Результат = Новый Структура("ДанныеЗапроса, Ошибка, Сотрудник", Неопределено, "", Справочники.Сотрудники.ПустаяСсылка());

	Если РазрешитьMultipart Тогда
		РазборТела = StockAPI_Утилиты.ПрочитатьТелоЗапросаJSONИлиMultipart(Запрос);
		Если РазборТела.Ошибка <> "" Тогда
			Результат.Ошибка = РазборТела.Ошибка;
			Возврат Результат;
		КонецЕсли;
		ДанныеЗапроса = РазборТела.ДанныеЗапроса;
	Иначе
		ДанныеЗапроса = ПрочитатьТелоJSON(Запрос);
	КонецЕсли;
	
	ИменаПараметров = "employeeCode,employeePin";
	Если СокрЛП(ДопПараметрыURL) <> "" Тогда
		ИменаПараметров = ИменаПараметров + "," + ДопПараметрыURL;
	КонецЕсли;
	StockAPI_Утилиты.ДополнитьДанныеЗапросаПараметрамиURL(ДанныеЗапроса, Запрос, ИменаПараметров);

	ПроверкаСотрудника = StockAPI_Утилиты.ПроверитьСотрудникаЗапроса(УчетнаяЗапись, ИмяМетода, ДанныеЗапроса);
	Если ПроверкаСотрудника.Ошибка <> "" Тогда
		Результат.Ошибка = ПроверкаСотрудника.Ошибка;
		Возврат Результат;
	КонецЕсли;

	Результат.ДанныеЗапроса = ДанныеЗапроса;
	Результат.Сотрудник = ПроверкаСотрудника.Сотрудник;
	Возврат Результат;

КонецФункции

Функция ОтветJSON(КодСостояния, Данные)

	StockAPI_Утилиты.УдалитьСвойства(Данные, "Конфликт,КонфликтСтатуса,НеНайден");
	
	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.УстановитьСтроку();
	ЗаписатьJSON(ЗаписьJSON, Данные);

	Ответ = Новый HTTPСервисОтвет(КодСостояния);
	Ответ.УстановитьТелоИзСтроки(ЗаписьJSON.Закрыть());
	Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");

	Возврат Ответ;

КонецФункции

Функция ОтветФайла(КодСостояния, ДвоичныеДанные, ИмяФайла, ТипСодержимого)

	Ответ = Новый HTTPСервисОтвет(КодСостояния);
	Ответ.УстановитьТелоИзДвоичныхДанных(ДвоичныеДанные);
	Ответ.Заголовки.Вставить("Content-Type", ТипСодержимого);
	Ответ.Заголовки.Вставить("Content-Disposition", "attachment; filename=""" + ИмяФайла + """");
	Возврат Ответ;

КонецФункции

Функция ОтветИзмененияЗаказа(Результат)

	Если Результат.success Тогда
		StockAPI_Утилиты.УдалитьСвойства(Результат, "НеНайден,Отгружен");
		Возврат ОтветJSON(200, Результат);
	КонецЕсли;

	КодСостояния = 400;
	Если Результат.НеНайден Тогда
		КодСостояния = 404;
	ИначеЕсли Результат.Отгружен Тогда
		КодСостояния = 409;
	КонецЕсли;

	StockAPI_Утилиты.УдалитьСвойства(Результат, "НеНайден,Отгружен");

	Возврат ОтветJSON(КодСостояния, Результат);

КонецФункции

Функция ОтветИзмененияИнвойса(Результат)

	Если Результат.success Тогда
		StockAPI_Утилиты.УдалитьСвойства(Результат, "НеНайден,Приходован,replaced");
		Возврат ОтветJSON(200, Результат);
	КонецЕсли;

	КодСостояния = 400;
	Если Результат.НеНайден Тогда
		КодСостояния = 404;
	ИначеЕсли Результат.Приходован Тогда
		КодСостояния = 409;
	КонецЕсли;

	StockAPI_Утилиты.УдалитьСвойства(Результат, "НеНайден,Приходован");

	Возврат ОтветJSON(КодСостояния, Результат);

КонецФункции

Функция ОтветИзмененияПриходной(Результат)

	Если Результат.success Тогда
		StockAPI_Утилиты.УдалитьСвойства(Результат, "НеНайден");
		Возврат ОтветJSON(200, Результат);
	КонецЕсли;

	КодСостояния = 400;
	Если Результат.Свойство("НеНайден") И Результат.НеНайден Тогда
		КодСостояния = 404;
	КонецЕсли;

	StockAPI_Утилиты.УдалитьСвойства(Результат, "НеНайден");

	Возврат ОтветJSON(КодСостояния, Результат);

КонецФункции

