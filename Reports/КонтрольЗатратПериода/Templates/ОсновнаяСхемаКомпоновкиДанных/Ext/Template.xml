		<field xsi:type="DataSetFieldField">
			<dataPath>Номенклатура</dataPath>
			<field>Номенклатура</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Количество</dataPath>
			<field>Количество</field>
		</field>
		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ
	ЕСТЬNULL(Ожидание.Инвойс, Факт.Инвойс) КАК Инвойс,
	ЕСТЬNULL(Ожидание.Поставка, Факт.Поставка) КАК Поставка,
	ЕСТЬNULL(Ожидание.ДатаИнвойса, Факт.ДатаИнвойса) КАК ДатаИнвойса,
	ЕСТЬNULL(Ожидание.КПНИнвойс, 0) КАК КПНИнвойс,
	ЕСТЬNULL(Ожидание.ВПНИнвойс, 0) КАК ВПНИнвойс,
	ЕСТЬNULL(Ожидание.КПНИнвойс, 0) - ЕСТЬNULL(Ожидание.ВПНИнвойс, 0) КАК НеВПНИнвойс,
	ЕСТЬNULL(Факт.НаценкаПН, 0) КАК НаценкаПН,
	ЕСТЬNULL(Ожидание.КПНИнвойс, 0) - ЕСТЬNULL(Факт.НаценкаПН, 0) КАК ДельтаНаценкаПН
ИЗ
	(ВЫБРАТЬ
		Затраты.Инвойс КАК Инвойс,
		Затраты.Поставка КАК Поставка,
		Затраты.Инвойс.Дата КАК ДатаИнвойса,
		СУММА(Затраты.СуммаВБазВалюте * ЕСТЬNULL(КоличестваИнвойсов.Количество, 0)) КАК КПНИнвойс,
		СУММА(Затраты.СуммаВБазВалюте * ЕСТЬNULL(ПНТовары.Количество, 0)) КАК ВПНИнвойс
	ИЗ
		РегистрСведений.Затраты КАК Затраты
			ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
				ПН.Ссылка.ВКД_Инвойс КАК Инвойс,
				ПН.Ссылка.Поставка КАК Поставка,
				ПН.Номенклатура КАК Номенклатура,
				СУММА(ПН.Количество) КАК Количество
			ИЗ
				Документ.ПриходнаяНакладная.Товары КАК ПН
			ГДЕ
				ПН.Ссылка.Проведен
				И ПН.Ссылка.ВКД_Инвойс &lt;&gt; ЗНАЧЕНИЕ(Документ._Инвойс.ПустаяСсылка)
			
			СГРУППИРОВАТЬ ПО
				ПН.Ссылка.ВКД_Инвойс,
				ПН.Ссылка.Поставка,
				ПН.Номенклатура) КАК ПНТовары
			ПО Затраты.Инвойс = ПНТовары.Инвойс
				И Затраты.Поставка = ПНТовары.Поставка
				И Затраты.Номенклатура = ПНТовары.Номенклатура
			ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
				СводИнвойс.Инвойс КАК Инвойс,
				СводИнвойс.Номенклатура КАК Номенклатура,
				СводИнвойс.Поставка КАК Поставка,
				СУММА(СводИнвойс.Количество) КАК Количество
			ИЗ
				(ВЫБРАТЬ
					Поставки.Ссылка КАК Инвойс,
					Поставки.Номенклатура КАК Номенклатура,
					Поставки.Поставка КАК Поставка,
					Поставки.Количество КАК Количество
				ИЗ
					Документ._Инвойс.Поставки КАК Поставки
				ГДЕ
					Поставки.Ссылка.КоличествоПоставок &gt; 1
					И Поставки.Номенклатура.ТипНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.Товар)
				
				ОБЪЕДИНИТЬ ВСЕ
				
				ВЫБРАТЬ
					Товары.Ссылка,
					Товары.Номенклатура,
					0,
					Товары.Количество
				ИЗ
					Документ._Инвойс.ВКД_Товары КАК Товары
				ГДЕ
					Товары.Ссылка.КоличествоПоставок &lt;= 1
					И Товары.Номенклатура.ТипНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.Товар)) КАК СводИнвойс
			
			СГРУППИРОВАТЬ ПО
				СводИнвойс.Инвойс,
				СводИнвойс.Номенклатура,
				СводИнвойс.Поставка) КАК КоличестваИнвойсов
			ПО Затраты.Инвойс = КоличестваИнвойсов.Инвойс
				И Затраты.Номенклатура = КоличестваИнвойсов.Номенклатура
				И Затраты.Поставка = КоличестваИнвойсов.Поставка
	ГДЕ
		Затраты.Инвойс &lt;&gt; ЗНАЧЕНИЕ(Документ._Инвойс.ПустаяСсылка)
		И Затраты.Партия = ЗНАЧЕНИЕ(Справочник.Партии.ПустаяСсылка)
		И Затраты.Инвойс.Дата МЕЖДУ &amp;ДатаНачала И &amp;ДатаОкончания
	
	СГРУППИРОВАТЬ ПО
		Затраты.Инвойс,
		Затраты.Поставка,
		Затраты.Инвойс.Дата) КАК Ожидание
		ПОЛНОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
			ПН.Ссылка.ВКД_Инвойс КАК Инвойс,
			ПН.Ссылка.Поставка КАК Поставка,
			ПН.Ссылка.ВКД_Инвойс.Дата КАК ДатаИнвойса,
			СУММА((ПН.ВКД_ЦенаСЗатратами - ПН.ЦенаЗакупки) * ПН.Количество) КАК НаценкаПН
		ИЗ
			Документ.ПриходнаяНакладная.Товары КАК ПН
		ГДЕ
			ПН.Ссылка.Проведен
			И ПН.Ссылка.ВКД_Инвойс &lt;&gt; ЗНАЧЕНИЕ(Документ._Инвойс.ПустаяСсылка)
			И ПН.Ссылка.ВКД_Инвойс.Дата МЕЖДУ &amp;ДатаНачала И &amp;ДатаОкончания
			И (ПН.ВКД_ЦенаСЗатратами - ПН.ЦенаЗакупки) &lt;&gt; 0
		
		СГРУППИРОВАТЬ ПО
			ПН.Ссылка.ВКД_Инвойс,
			ПН.Ссылка.Поставка,
			ПН.Ссылка.ВКД_Инвойс.Дата) КАК Факт
		ПО Ожидание.Инвойс = Факт.Инвойс
			И Ожидание.Поставка = Факт.Поставка</query>
	</dataSet>
