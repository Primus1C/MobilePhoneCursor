		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ
	База.Источник КАК Источник,
	ВЫБОР
		КОГДА База.Источник ССЫЛКА Документ.ДвижениеДенег
			ТОГДА ВЫРАЗИТЬ(База.Источник КАК Документ.ДвижениеДенег).ВидДвиженияДенег
		ИНАЧЕ ЗНАЧЕНИЕ(Перечисление.ВидДвиженияДенег.ПустаяСсылка)
	КОНЕЦ КАК ВидДвижения,
	База.ТипДокумента КАК ТипДокумента,
	База.Дата КАК Дата,
	База.Валюта КАК Валюта,
	База.СуммаДокумента КАК СуммаДокумента,
	База.СуммаРегистра КАК СуммаРегистра,
	ВЫБОР
		КОГДА База.ТипДокумента = "Отправка перемещений"
			ТОГДА 0
		КОГДА База.ТипДокумента = "Дополнительные затраты"
			ТОГДА База.СуммаДокумента
		ИНАЧЕ База.СуммаКПНРегистра
	КОНЕЦ КАК СуммаКПН,
	ВЫБОР
		КОГДА База.ТипДокумента = "Отправка перемещений"
			ТОГДА 0
		КОГДА База.ТипДокумента = "Дополнительные затраты"
			ТОГДА База.СуммаРегистра
		ИНАЧЕ ЕСТЬNULL(ВПН.СуммаВПН, 0)
	КОНЕЦ КАК СуммаВПН,
	ВЫБОР
		КОГДА База.ТипДокумента = "Отправка перемещений"
			ТОГДА 0
		КОГДА База.ТипДокумента = "Дополнительные затраты"
			ТОГДА База.СуммаДокумента - База.СуммаРегистра
		ИНАЧЕ База.СуммаКПНРегистра - ЕСТЬNULL(ВПН.СуммаВПН, 0)
	КОНЕЦ КАК СуммаНеВПН
ИЗ
	(ВЫБРАТЬ
		ЕСТЬNULL(ДокументыЗатрат.Источник, РегистрЗатрат.Источник) КАК Источник,
		ЕСТЬNULL(ДокументыЗатрат.ТипДокумента, РегистрЗатрат.ТипДокумента) КАК ТипДокумента,
		ЕСТЬNULL(ДокументыЗатрат.Дата, РегистрЗатрат.Дата) КАК Дата,
		ЕСТЬNULL(ДокументыЗатрат.Валюта, РегистрЗатрат.Валюта) КАК Валюта,
		ЕСТЬNULL(ДокументыЗатрат.СуммаДокумента, 0) КАК СуммаДокумента,
		ЕСТЬNULL(РегистрЗатрат.СуммаРегистра, 0) КАК СуммаРегистра,
		ЕСТЬNULL(РегистрЗатрат.СуммаКПНРегистра, 0) КАК СуммаКПНРегистра
	ИЗ
		(ВЫБРАТЬ
			ЗатратыОтправка.Ссылка КАК Источник,
			"Отправка" КАК ТипДокумента,
			ЗатратыОтправка.Ссылка.Дата КАК Дата,
			ЗатратыОтправка.Ссылка.ВалютаЗатрат КАК Валюта,
			СУММА(ЗатратыОтправка.Сумма) КАК СуммаДокумента
		ИЗ
			Документ.Отправка.Затраты КАК ЗатратыОтправка
		ГДЕ
			ЗатратыОтправка.Ссылка.Проведен
			И ЗатратыОтправка.Ссылка.Дата МЕЖДУ &amp;ДатаНачала И &amp;ДатаОкончания
		
		СГРУППИРОВАТЬ ПО
			ЗатратыОтправка.Ссылка,
			ЗатратыОтправка.Ссылка.Дата,
			ЗатратыОтправка.Ссылка.ВалютаЗатрат
		
		ОБЪЕДИНИТЬ ВСЕ
		
		ВЫБРАТЬ
			ЗатратыAWB.Ссылка,
			"Отправка AWB",
			ЗатратыAWB.Ссылка.Дата,
			ЗатратыAWB.Ссылка.ВалютаЗатрат,
			СУММА(ЗатратыAWB.Сумма)
		ИЗ
			Документ.ОтправкаAWB.Затраты КАК ЗатратыAWB
		ГДЕ
			ЗатратыAWB.Ссылка.Проведен
			И ЗатратыAWB.Ссылка.Дата МЕЖДУ &amp;ДатаНачала И &amp;ДатаОкончания
		
		СГРУППИРОВАТЬ ПО
			ЗатратыAWB.Ссылка,
			ЗатратыAWB.Ссылка.Дата,
			ЗатратыAWB.Ссылка.ВалютаЗатрат
		
		ОБЪЕДИНИТЬ ВСЕ
		
		ВЫБРАТЬ
			ЗатратыПеремещений.Ссылка,
			"Отправка перемещений",
			ЗатратыПеремещений.Ссылка.Дата,
			ЗатратыПеремещений.Ссылка.ВалютаЗатрат,
			СУММА(ВЫБОР
					КОГДА ЗатратыПеремещений.Ссылка.Окончательно
						ТОГДА ЗатратыПеремещений.Сумма
					ИНАЧЕ 0
				КОНЕЦ)
		ИЗ
			Документ.ОтправкаПеремещений.Затраты КАК ЗатратыПеремещений
		ГДЕ
			ЗатратыПеремещений.Ссылка.Проведен
			И ЗатратыПеремещений.Ссылка.Дата МЕЖДУ &amp;ДатаНачала И &amp;ДатаОкончания
		
		СГРУППИРОВАТЬ ПО
			ЗатратыПеремещений.Ссылка,
			ЗатратыПеремещений.Ссылка.Дата,
			ЗатратыПеремещений.Ссылка.ВалютаЗатрат
		
		ОБЪЕДИНИТЬ ВСЕ
		
		ВЫБРАТЬ
			Инвойс.Ссылка,
			"Инвойс",
			Инвойс.Дата,
			Инвойс.Валюта,
			Инвойс.СуммаЗатрат
		ИЗ
			Документ._Инвойс КАК Инвойс
		ГДЕ
			Инвойс.Проведен
			И Инвойс.ЕстьЗатраты
			И Инвойс.СуммаЗатрат &lt;&gt; 0
			И Инвойс.Дата МЕЖДУ &amp;ДатаНачала И &amp;ДатаОкончания
			И НЕ Инвойс.Ссылка В
					(ВЫБРАТЬ РАЗЛИЧНЫЕ
						ДДИнвойсыЛогистика.Инвойс
					ИЗ
						Документ.ДвижениеДенег.Инвойсы КАК ДДИнвойсыЛогистика
					ГДЕ
						ДДИнвойсыЛогистика.Ссылка.Проведен
						И ДДИнвойсыЛогистика.Ссылка.ВидДвиженияДенег = ЗНАЧЕНИЕ(Перечисление.ВидДвиженияДенег.Логистика))
		
		ОБЪЕДИНИТЬ ВСЕ
		
		ВЫБРАТЬ
			ДДИнвойсы.Ссылка,
			"Движение денег (логистика)",
			ДДИнвойсы.Ссылка.Дата,
			ДДИнвойсы.Ссылка.Валюта,
			СУММА(ДДИнвойсы.Сумма)
		ИЗ
			Документ.ДвижениеДенег.Инвойсы КАК ДДИнвойсы
		ГДЕ
			ДДИнвойсы.Ссылка.Проведен
			И ДДИнвойсы.Ссылка.ВидДвиженияДенег = ЗНАЧЕНИЕ(Перечисление.ВидДвиженияДенег.Логистика)
			И ДДИнвойсы.Ссылка.Дата МЕЖДУ &amp;ДатаНачала И &amp;ДатаОкончания
		
		СГРУППИРОВАТЬ ПО
			ДДИнвойсы.Ссылка,
			ДДИнвойсы.Ссылка.Дата,
			ДДИнвойсы.Ссылка.Валюта
		
		ОБЪЕДИНИТЬ ВСЕ
		
		ВЫБРАТЬ
			ДопЗатраты.Ссылка,
			"Дополнительные затраты",
			ДопЗатраты.Ссылка.Дата,
			ДопЗатраты.Ссылка.Валюта,
			СУММА(ДопЗатраты.СуммаНаценки)
		ИЗ
			Документ.ВКД_ДополнительныеЗатраты.Документы КАК ДопЗатраты
		ГДЕ
			ДопЗатраты.Ссылка.Проведен
			И ДопЗатраты.Ссылка.Дата МЕЖДУ &amp;ДатаНачала И &amp;ДатаОкончания
		
		СГРУППИРОВАТЬ ПО
			ДопЗатраты.Ссылка,
			ДопЗатраты.Ссылка.Дата,
			ДопЗатраты.Ссылка.Валюта) КАК ДокументыЗатрат
			ПОЛНОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
				Затраты.Источник КАК Источник,
				ВЫБОР
					КОГДА Затраты.Источник ССЫЛКА Документ.Отправка
						ТОГДА "Отправка"
					КОГДА Затраты.Источник ССЫЛКА Документ.ОтправкаAWB
						ТОГДА "Отправка AWB"
					КОГДА Затраты.Источник ССЫЛКА Документ.ОтправкаПеремещений
						ТОГДА "Отправка перемещений"
					КОГДА Затраты.Источник ССЫЛКА Документ._Инвойс
						ТОГДА "Инвойс"
					КОГДА Затраты.Источник ССЫЛКА Документ.ДвижениеДенег
						ТОГДА "Движение денег (логистика)"
					КОГДА Затраты.Источник ССЫЛКА Документ.ВКД_ДополнительныеЗатраты
						ТОГДА "Дополнительные затраты"
					ИНАЧЕ "Прочее"
				КОНЕЦ КАК ТипДокумента,
				Затраты.Источник.Дата КАК Дата,
				Затраты.Валюта КАК Валюта,
				СУММА(ВЫБОР
						КОГДА Затраты.Партия &lt;&gt; ЗНАЧЕНИЕ(Справочник.Партии.ПустаяСсылка)
							ТОГДА Затраты.Сумма * ЕСТЬNULL(КоличестваПартий.Количество, 0)
						ИНАЧЕ Затраты.Сумма * ЕСТЬNULL(КоличестваИнвойсов.Количество, 0)
					КОНЕЦ) КАК СуммаРегистра,
				СУММА(ВЫБОР
						КОГДА Затраты.Партия = ЗНАЧЕНИЕ(Справочник.Партии.ПустаяСсылка)
							ТОГДА Затраты.Сумма * ЕСТЬNULL(КоличестваИнвойсов.Количество, 0)
						ИНАЧЕ 0
					КОНЕЦ) КАК СуммаКПНРегистра
			ИЗ
				РегистрСведений.Затраты КАК Затраты
					ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
						ПНТовары.Партия КАК Партия,
						ПНТовары.Номенклатура КАК Номенклатура,
						СУММА(ПНТовары.Количество) КАК Количество
					ИЗ
						Документ.ПриходнаяНакладная.Товары КАК ПНТовары
					ГДЕ
						ПНТовары.Ссылка.Проведен
						И ПНТовары.Партия &lt;&gt; ЗНАЧЕНИЕ(Справочник.Партии.ПустаяСсылка)
					
					СГРУППИРОВАТЬ ПО
						ПНТовары.Партия,
						ПНТовары.Номенклатура) КАК КоличестваПартий
					ПО Затраты.Партия = КоличестваПартий.Партия
						И Затраты.Номенклатура = КоличестваПартий.Номенклатура
					ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
						СводИнвойс.Инвойс КАК Инвойс,
						СводИнвойс.Номенклатура КАК Номенклатура,
						СводИнвойс.Поставка КАК Поставка,
						СУММА(СводИнвойс.Количество) КАК Количество
					ИЗ
						(ВЫБРАТЬ
							Поставки.Ссылка КАК Инвойс,
							Поставки.Номенклатура КАК Номенклатура,
							Поставки.Поставка КАК Поставка,
							Поставки.Количество КАК Количество
						ИЗ
							Документ._Инвойс.Поставки КАК Поставки
						ГДЕ
							Поставки.Ссылка.КоличествоПоставок &gt; 1
							И Поставки.Номенклатура.ТипНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.Товар)
						
						ОБЪЕДИНИТЬ ВСЕ
						
						ВЫБРАТЬ
							Товары.Ссылка,
							Товары.Номенклатура,
							0,
							Товары.Количество
						ИЗ
							Документ._Инвойс.ВКД_Товары КАК Товары
						ГДЕ
							Товары.Ссылка.КоличествоПоставок &lt;= 1
							И Товары.Номенклатура.ТипНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.Товар)) КАК СводИнвойс
					
					СГРУППИРОВАТЬ ПО
						СводИнвойс.Инвойс,
						СводИнвойс.Номенклатура,
						СводИнвойс.Поставка) КАК КоличестваИнвойсов
					ПО Затраты.Инвойс = КоличестваИнвойсов.Инвойс
						И Затраты.Номенклатура = КоличестваИнвойсов.Номенклатура
						И Затраты.Поставка = КоличестваИнвойсов.Поставка
			ГДЕ
				Затраты.Источник.Дата МЕЖДУ &amp;ДатаНачала И &amp;ДатаОкончания
			
			СГРУППИРОВАТЬ ПО
				Затраты.Источник,
				Затраты.Источник.Дата,
				Затраты.Валюта,
				ВЫБОР
					КОГДА Затраты.Источник ССЫЛКА Документ.Отправка
						ТОГДА "Отправка"
					КОГДА Затраты.Источник ССЫЛКА Документ.ОтправкаAWB
						ТОГДА "Отправка AWB"
					КОГДА Затраты.Источник ССЫЛКА Документ.ОтправкаПеремещений
						ТОГДА "Отправка перемещений"
					КОГДА Затраты.Источник ССЫЛКА Документ._Инвойс
						ТОГДА "Инвойс"
					КОГДА Затраты.Источник ССЫЛКА Документ.ДвижениеДенег
						ТОГДА "Движение денег (логистика)"
					КОГДА Затраты.Источник ССЫЛКА Документ.ВКД_ДополнительныеЗатраты
						ТОГДА "Дополнительные затраты"
					ИНАЧЕ "Прочее"
				КОНЕЦ) КАК РегистрЗатрат
			ПО ДокументыЗатрат.Источник = РегистрЗатрат.Источник
				И ДокументыЗатрат.Валюта = РегистрЗатрат.Валюта) КАК База
		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
			Затраты.Источник КАК Источник,
			Затраты.Валюта КАК Валюта,
			СУММА(Затраты.Сумма * ЕСТЬNULL(ПНТовары.Количество, 0)) КАК СуммаВПН
		ИЗ
			РегистрСведений.Затраты КАК Затраты
				ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
					ПН.Ссылка.ВКД_Инвойс КАК Инвойс,
					ПН.Ссылка.Поставка КАК Поставка,
					ПН.Номенклатура КАК Номенклатура,
					СУММА(ПН.Количество) КАК Количество
				ИЗ
					Документ.ПриходнаяНакладная.Товары КАК ПН
				ГДЕ
					ПН.Ссылка.Проведен
					И ПН.Ссылка.ВКД_Инвойс &lt;&gt; ЗНАЧЕНИЕ(Документ._Инвойс.ПустаяСсылка)
				
				СГРУППИРОВАТЬ ПО
					ПН.Ссылка.ВКД_Инвойс,
					ПН.Ссылка.Поставка,
					ПН.Номенклатура) КАК ПНТовары
				ПО Затраты.Инвойс = ПНТовары.Инвойс
					И Затраты.Поставка = ПНТовары.Поставка
					И Затраты.Номенклатура = ПНТовары.Номенклатура
		ГДЕ
			Затраты.Источник.Дата МЕЖДУ &amp;ДатаНачала И &amp;ДатаОкончания
			И Затраты.Партия = ЗНАЧЕНИЕ(Справочник.Партии.ПустаяСсылка)
		
		СГРУППИРОВАТЬ ПО
			Затраты.Источник,
			Затраты.Валюта) КАК ВПН
		ПО База.Источник = ВПН.Источник
			И База.Валюта = ВПН.Валюта</query>
	</dataSet>
