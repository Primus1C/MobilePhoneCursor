		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ
	ПриходнаяНакладная.ВКД_Инвойс КАК ИнвойсПриемки,
	МАКСИМУМ(ПриходнаяНакладная.Дата) КАК ДатаПоследнейПриемки
ПОМЕСТИТЬ ВТ_ДатыПриемок
ИЗ
	Документ.ПриходнаяНакладная КАК ПриходнаяНакладная
ГДЕ
	ПриходнаяНакладная.Проведен
	И ПриходнаяНакладная.ВКД_Инвойс &lt;&gt; ЗНАЧЕНИЕ(Документ._Инвойс.ПустаяСсылка)

СГРУППИРОВАТЬ ПО
	ПриходнаяНакладная.ВКД_Инвойс
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	ДатыПриемок.ИнвойсПриемки КАК ИнвойсПриемки,
	ДатыПриемок.ДатаПоследнейПриемки КАК ДатаПоследнейПриемки,
	МАКСИМУМ(ПриходнаяНакладная.Склад) КАК СкладПоследнейПриемки
ПОМЕСТИТЬ ВТ_Приемки
ИЗ
	ВТ_ДатыПриемок КАК ДатыПриемок
		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ПриходнаяНакладная КАК ПриходнаяНакладная
		ПО ДатыПриемок.ИнвойсПриемки = ПриходнаяНакладная.ВКД_Инвойс
			И ДатыПриемок.ДатаПоследнейПриемки = ПриходнаяНакладная.Дата
			И (ПриходнаяНакладная.Проведен)

СГРУППИРОВАТЬ ПО
	ДатыПриемок.ИнвойсПриемки,
	ДатыПриемок.ДатаПоследнейПриемки
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	ДокИнвойс.Ссылка КАК Инвойс,
	ВЫБОР
		КОГДА ДокИнвойс.ВКД_ДатаИнвойсаПоставщика = ДАТАВРЕМЯ(1, 1, 1)
			ТОГДА ДокИнвойс.Дата
		ИНАЧЕ ДокИнвойс.ВКД_ДатаИнвойсаПоставщика
	КОНЕЦ КАК ДатаИнвойса,
	ВЫБОР
		КОГДА ДокИнвойс.ВКД_НомерИнвойсаПоставщика = ""
			ТОГДА ДокИнвойс.Номер
		ИНАЧЕ ДокИнвойс.ВКД_НомерИнвойсаПоставщика
	КОНЕЦ КАК НомерИнвойса,
	ДокИнвойс.Контрагент КАК Поставщик,
	ДокИнвойс.ВКД_Количество КАК Количество,
	ДокИнвойс.Сумма КАК СуммаПоИнвойсу,
	ВЫБОР
		КОГДА СостоянияИнвойсов.СтатусОплатыАвто &lt;&gt; ЗНАЧЕНИЕ(перечисление.Долги.ПустаяСсылка)
			ТОГДА СостоянияИнвойсов.СтатусОплатыАвто
		КОГДА СостоянияИнвойсов.СтатусОплаты = ЗНАЧЕНИЕ(перечисление.СтатусыОплаты.NotPaid)
			ТОГДА ЗНАЧЕНИЕ(перечисление.Долги.Неоплачено)
		КОГДА СостоянияИнвойсов.СтатусОплаты = ЗНАЧЕНИЕ(перечисление.СтатусыОплаты.PartlyPaid)
			ТОГДА ЗНАЧЕНИЕ(перечисление.Долги.Частично)
		КОГДА СостоянияИнвойсов.СтатусОплаты = ЗНАЧЕНИЕ(перечисление.СтатусыОплаты.PaidNotReceivded)
			ТОГДА ЗНАЧЕНИЕ(перечисление.Долги.Частично)
		КОГДА СостоянияИнвойсов.СтатусОплаты = ЗНАЧЕНИЕ(перечисление.СтатусыОплаты.Paid)
			ТОГДА ЗНАЧЕНИЕ(перечисление.Долги.Полностью)
		КОГДА СостоянияИнвойсов.СтатусОплаты = ЗНАЧЕНИЕ(перечисление.СтатусыОплаты.WithoutPayment)
			ТОГДА ЗНАЧЕНИЕ(перечисление.Долги.НеЗакрыто)
		ИНАЧЕ ЗНАЧЕНИЕ(перечисление.Долги.ПустаяСсылка)
	КОНЕЦ КАК СтатусПоОплате,
	ВЫБОР
		КОГДА СостоянияИнвойсов.ДатаОплаты = ДАТАВРЕМЯ(1, 1, 1)
			ТОГДА ДокИнвойс.ДокументОснование.ДатаОплаты
		ИНАЧЕ СостоянияИнвойсов.ДатаОплаты
	КОНЕЦ КАК ДатаОплаты,
	ДокИнвойс.ДокументОснование.ДатаНаСкладеОтправителя КАК ETA,
	ДокИнвойс.ДокументОснование.СкладОтправитель КАК Отправитель,
	ДокИнвойс.ДокументОснование.СкладПолучатель КАК Получатель,
	СостоянияИнвойсов.СтатусИнспекции КАК СтатусПоИнспекции,
	ДокИнвойс.ДатаИнспекции КАК ДатаИнспекции,
	Приемки.СкладПоследнейПриемки КАК СкладПолучатель,
	СостоянияИнвойсов.Статус КАК СтатусПоДоставке,
	Приемки.ДатаПоследнейПриемки КАК ДатаПоследнейПриемки
ИЗ
	Документ._Инвойс КАК ДокИнвойс
		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СостоянияИнвойсов КАК СостоянияИнвойсов
		ПО ДокИнвойс.Ссылка = СостоянияИнвойсов.Инвойс
		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_Приемки КАК Приемки
		ПО ДокИнвойс.Ссылка = Приемки.ИнвойсПриемки
ГДЕ
	НЕ ДокИнвойс.ПометкаУдаления
	И ДокИнвойс.Дата МЕЖДУ &amp;НачалоПериода И &amp;КонецПериода
	И (&amp;СкидкиИУслуги
			ИЛИ НЕ ДокИнвойс.ВидОперации В (ЗНАЧЕНИЕ(Перечисление.ВидыОперацииИнвойс.Доставка), ЗНАЧЕНИЕ(Перечисление.ВидыОперацииИнвойс.Скидка)))</query>
	</dataSet>
	<totalField>
		<dataPath>Количество</dataPath>
		<expression>Сумма(Количество)</expression>
	</totalField>
	<totalField>
		<dataPath>СуммаПоИнвойсу</dataPath>
		<expression>Сумма(СуммаПоИнвойсу)</expression>
	</totalField>
