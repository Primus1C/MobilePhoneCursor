&НаКлиенте
Процедура ХронологияДокументов(Команда)
	
	ТабДок = ХронологияДокументовНаСервере();
	Если ТабДок = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ПараметрыПечати = Новый Структура("Таб, Имя, НеДляПечати", ТабДок, "Хронология документов", Истина);
	ОткрытьФорму("ОбщаяФорма.ПечатьБезЗащиты", ПараметрыПечати, , Истина);
	
КонецПроцедуры

// Собирает документы текущего отчета и выводит их события журнала регистрации
// в порядке времени. Подряд идущие события одного документа — отдельный блок.
//
// Возвращаемое значение:
//  ТабличныйДокумент, Неопределено - отчет хронологии или пусто, если формировать нечего.
//
&НаСервере
Функция ХронологияДокументовНаСервере()
	
	ДокументыОтчета = ДокументыТекущегоОтчета();
	Если ДокументыОтчета = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Если ДокументыОтчета.Количество() = 0 Тогда
		Сообщить(НСтр("ru = 'В отчете нет документов.'; en = 'The report has no documents.'"));
		Возврат Неопределено;
	КонецЕсли;
	
	События = СобытияДокументов(ДокументыОтчета);
	Если События.Количество() = 0 Тогда
		Сообщить(НСтр("ru = 'По документам отчета нет записей журнала регистрации.'; en = 'There are no event log records for the report documents.'"));
		Возврат Неопределено;
	КонецЕсли;
	
	События.Сортировать("Дата, Порядок");
	Возврат ТабличныйДокументХронологии(События);
	
КонецФункции

// Выполняет компоновку с текущими настройками и возвращает регистраторы детальных строк.
//
// Возвращаемое значение:
//  Массив из ДокументСсылка, Неопределено - документы отчета; Неопределено, если компоновка не удалась.
//
&НаСервере
Функция ДокументыТекущегоОтчета()
	
	Настройки = Отчет.КомпоновщикНастроек.ПолучитьНастройки();
	ПараметрЦен = Настройки.ПараметрыДанных.Элементы.Найти("СкрытьЦены");
	Если ПараметрЦен <> Неопределено Тогда
		ПараметрЦен.Значение = НЕ ОбщегоНазначенияПовтИсп.ДоступныЦеныЗакупки();
		ПараметрЦен.Использование = Истина;
	КонецЕсли;
	
	СхемаКомпоновкиДанных = РеквизитФормыВЗначение("Отчет").ПолучитьМакет("ОсновнаяСхемаКомпоновкиДанных");
	КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
	МакетКомпоновки = КомпоновщикМакета.Выполнить(
		СхемаКомпоновкиДанных,
		Настройки,
		,
		,
		Тип("ГенераторМакетаКомпоновкиДанныхДляКоллекцииЗначений"));
	
	ПроцессорКомпоновки = Новый ПроцессорКомпоновкиДанных;
	ПроцессорКомпоновки.Инициализировать(МакетКомпоновки);
	
	Дерево = Новый ДеревоЗначений;
	ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВКоллекциюЗначений;
	ПроцессорВывода.УстановитьОбъект(Дерево);
	ПроцессорВывода.Вывести(ПроцессорКомпоновки);
	
	Если Дерево.Колонки.Найти("Регистратор") = Неопределено Тогда
		Сообщить(НСтр("ru = 'В настройках отчета нет колонки документа.'; en = 'The report settings have no document column.'"));
		Возврат Неопределено;
	КонецЕсли;
	
	ДокументыОтчета = Новый Массив;
	УжеДобавленные = Новый Соответствие;
	ДобавитьРегистраторыДерева(Дерево.Строки, ДокументыОтчета, УжеДобавленные);
	Возврат ДокументыОтчета;
	
КонецФункции

// Добавляет в массив заполненные регистраторы-документы из строк дерева компоновки.
//
// Параметры:
//  СтрокиДерева     - КоллекцияСтрокДереваЗначений - строки текущего уровня;
//  ДокументыОтчета  - Массив - найденные документы;
//  УжеДобавленные   - Соответствие - документы, которые уже попали в массив.
//
&НаСервере
Процедура ДобавитьРегистраторыДерева(СтрокиДерева, ДокументыОтчета, УжеДобавленные)
	
	Для Каждого СтрокаДерева Из СтрокиДерева Цикл
		Регистратор = СтрокаДерева.Регистратор;
		Если ЗначениеЗаполнено(Регистратор)
			И Документы.ТипВсеСсылки().СодержитТип(ТипЗнч(Регистратор))
			И УжеДобавленные.Получить(Регистратор) = Неопределено Тогда
			УжеДобавленные.Вставить(Регистратор, Истина);
			ДокументыОтчета.Добавить(Регистратор);
		КонецЕсли;
		ДобавитьРегистраторыДерева(СтрокаДерева.Строки, ДокументыОтчета, УжеДобавленные);
	КонецЦикла;
	
КонецПроцедуры

// Читает журнал регистрации по каждому документу так же, как форма журнала по объекту:
// с даты документа по конец текущего дня, без ограничения числа событий.
// События, у которых внутреннее имя начинается с «Журнал по объекту.», не включаются.
// Колонка представления данных заполняется печатным представлением документа.
//
// Параметры:
//  ДокументыОтчета - Массив из ДокументСсылка - регистраторы отчета.
//
// Возвращаемое значение:
//  ТаблицаЗначений - события с колонками журнала и служебным полем Порядок.
//
&НаСервере
Функция СобытияДокументов(ДокументыОтчета)
	
	События = Новый ТаблицаЗначений;
	События.Колонки.Добавить("Дата");
	События.Колонки.Добавить("Порядок");
	События.Колонки.Добавить("ИмяПользователя");
	События.Колонки.Добавить("ПредставлениеСобытия");
	События.Колонки.Добавить("Комментарий");
	События.Колонки.Добавить("ПредставлениеДанных");
	События.Колонки.Добавить("Событие");
	События.Колонки.Добавить("Данные");
	
	КонецПериода = КонецДня(ТекущаяДатаСеанса());
	Порядок = 0;
	КолонкиЖурнала = "Дата,ИмяПользователя,Событие,ПредставлениеСобытия,Комментарий,ПредставлениеДанных,Данные";
	
	Для Каждого ДокументОтчета Из ДокументыОтчета Цикл
		
		НачалоПериода = ДокументОтчета.Дата;
		Если НЕ ЗначениеЗаполнено(НачалоПериода) Тогда
			НачалоПериода = '00010101';
		КонецЕсли;
		Если КонецПериода < НачалоПериода Тогда
			КонецПериодаДокумента = КонецДня(НачалоПериода);
		Иначе
			КонецПериодаДокумента = КонецПериода;
		КонецЕсли;
		
		Фильтр = Новый Структура("ДатаНачала, ДатаОкончания, Данные", НачалоПериода, КонецПериодаДокумента, ДокументОтчета);
		Журнал = Новый ТаблицаЗначений;
		ВыгрузитьЖурналРегистрации(Журнал, Фильтр, КолонкиЖурнала);
		ПредставлениеДокумента = ОбщегоНазначения.ПредставлениеДокументаДляПечати(ДокументОтчета);
		
		Для Каждого СтрокаЖурнала Из Журнал.НайтиСтроки(Новый Структура("Данные", ДокументОтчета)) Цикл
				Если Лев(СтрокаЖурнала.Событие, 18) = "Журнал по объекту." Тогда
				Продолжить;
			КонецЕсли;
			Порядок = Порядок + 1;
			НоваяСтрока = События.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаЖурнала);
			НоваяСтрока.ПредставлениеДанных = ПредставлениеДокумента;
			НоваяСтрока.Порядок = Порядок;
		КонецЦикла;
		
	КонецЦикла;
	
	Возврат События;
	
КонецФункции

// Печатает события в порядке времени. Смена документа начинает новый блок.
//
// Параметры:
//  События - ТаблицаЗначений - строки, уже отсортированные по дате.
//
// Возвращаемое значение:
//  ТабличныйДокумент - хронология.
//
&НаСервере
Функция ТабличныйДокументХронологии(События)
	
	Администратор = гоАдминистратор();
	ЧислоКолонок = ?(Администратор, 6, 5);
	
	Таб = Новый ТабличныйДокумент;
	Таб.ОриентацияСтраницы = ОриентацияСтраницы.Ландшафт;
	Таб.АвтоМасштаб = Истина;
	Таб.ОтображатьСетку = Ложь;
	Таб.ТолькоПросмотр = Истина;
	
	Заголовки = Новый Массив;
	Заголовки.Добавить(НСтр("ru = 'Дата'; en = 'Date'"));
	Заголовки.Добавить(НСтр("ru = 'Имя пользователя'; en = 'User name'"));
	Заголовки.Добавить(НСтр("ru = 'Событие'; en = 'Event'"));
	Заголовки.Добавить(НСтр("ru = 'Комментарий'; en = 'Note'"));
	Заголовки.Добавить(НСтр("ru = 'Представление данных'; en = 'Data presentation'"));
	Если Администратор Тогда
		Заголовки.Добавить(НСтр("ru = 'Событие (внутр)'; en = 'Event (internal)'"));
	КонецЕсли;
	
	ШиринаКолонок = Новый Массив;
	ШиринаКолонок.Добавить(18);
	ШиринаКолонок.Добавить(22);
	ШиринаКолонок.Добавить(28);
	ШиринаКолонок.Добавить(40);
	ШиринаКолонок.Добавить(36);
	ШиринаКолонок.Добавить(28);
	Для НомерКолонки = 1 По ЧислоКолонок Цикл
		Таб.Область(, НомерКолонки, , НомерКолонки).ШиринаКолонки = ШиринаКолонок[НомерКолонки - 1];
	КонецЦикла;
	
	НомерСтроки = 1;
	ВывестиСтрокуХронологии(Таб, НомерСтроки, ЧислоКолонок, Заголовки, Истина, Ложь);
	Таб.ПовторятьПриПечатиСтроки = Таб.Область(1, 1, 1, ЧислоКолонок);
	
	ТекущийДокумент = Неопределено;
	Для Каждого Событие Из События Цикл
		Если Событие.Данные <> ТекущийДокумент Тогда
			ТекущийДокумент = Событие.Данные;
			НомерСтроки = НомерСтроки + 1;
			ОбластьБлока = Таб.Область(НомерСтроки, 1, НомерСтроки, ЧислоКолонок);
			ОбластьБлока.Объединить();
			ОбластьБлока.Текст = гоИмяДок(ТекущийДокумент);
			ОбластьБлока.Шрифт = Новый Шрифт(, , Истина);
			ОбластьБлока.ЦветФона = WebЦвета.АкварельноСиний;
			ОбластьБлока.Расшифровка = ТекущийДокумент;
		КонецЕсли;
		
		Значения = Новый Массив;
		Значения.Добавить(Формат(Событие.Дата, "ДФ='dd.MM.yyyy ЧЧ:мм:сс'"));
		Значения.Добавить(Событие.ИмяПользователя);
		Значения.Добавить(Событие.ПредставлениеСобытия);
		Значения.Добавить(Событие.Комментарий);
		Значения.Добавить(Событие.ПредставлениеДанных);
		Если Администратор Тогда
			Значения.Добавить(Событие.Событие);
		КонецЕсли;
		НомерСтроки = НомерСтроки + 1;
		ВывестиСтрокуХронологии(Таб, НомерСтроки, ЧислоКолонок, Значения, Ложь, Истина);
	КонецЦикла;
	
	Возврат Таб;
	
КонецФункции

// Заполняет одну строку табличного документа значениями колонок.
//
// Параметры:
//  Таб            - ТабличныйДокумент - приемник;
//  НомерСтроки    - Число - номер строки;
//  ЧислоКолонок   - Число - сколько колонок выводить;
//  Значения       - Массив из Строка - тексты ячеек;
//  ЭтоШапка       - Булево - строка заголовков колонок;
//  ПереноситьТекст - Булево - перенос длинного текста.
//
&НаСервере
Процедура ВывестиСтрокуХронологии(Таб, НомерСтроки, ЧислоКолонок, Значения, ЭтоШапка, ПереноситьТекст)
	
	Для НомерКолонки = 1 По ЧислоКолонок Цикл
		Ячейка = Таб.Область(НомерСтроки, НомерКолонки);
		Ячейка.Текст = Значения[НомерКолонки - 1];
		Ячейка.РазмещениеТекста = ?(ПереноситьТекст, ТипРазмещенияТекстаТабличногоДокумента.Переносить, ТипРазмещенияТекстаТабличногоДокумента.Обрезать);
		Если ЭтоШапка Тогда
			Ячейка.Шрифт = Новый Шрифт(, , Истина);
			Ячейка.ЦветФона = WebЦвета.СветлоСерый;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры
