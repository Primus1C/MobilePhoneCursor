&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если НЕ ЗначениеЗаполнено(НачалоПериода) Тогда
		НачалоПериода = НачалоМесяца(ТекущаяДатаСеанса());
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(КонецПериода) Тогда
		КонецПериода = КонецДня(ТекущаяДатаСеанса());
	КонецЕсли;
	ТолькоРазница = Истина;
	
КонецПроцедуры

&НаКлиенте
Процедура Сформировать(Команда)
	
	Если НЕ ЗначениеЗаполнено(НачалоПериода) Или НЕ ЗначениеЗаполнено(КонецПериода) Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Укажите период.'"));
		Возврат;
	КонецЕсли;
	
	Если НачалоПериода > КонецПериода Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Начало периода больше окончания.'"));
		Возврат;
	КонецЕсли;
	
	ТекстОшибки = "";
	Если НЕ СформироватьНаСервере(ТекстОшибки) Тогда
		ПоказатьПредупреждение(, ТекстОшибки);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция СформироватьНаСервере(ТекстОшибки)
	
	ТекстОшибки = "";
	ОтчетОбъект = РеквизитФормыВЗначение("Отчет");
	Соединение = ОтчетОбъект.ПодключитьВнешнююБазу(ТекстОшибки);
	Если Соединение = Неопределено Тогда
		Если НЕ ЗначениеЗаполнено(ТекстОшибки) Тогда
			ТекстОшибки = НСтр("ru = 'Не удалось подключиться к внешней базе по COM.'");
		КонецЕсли;
		Возврат Ложь;
	КонецЕсли;
	
	Попытка
		ЦеныТекущие = ОтчетОбъект.ЦеныПриходныхТекущейБазы(НачалоПериода, КонецПериода);
		ЦеныВнешние = ОтчетОбъект.ЦеныПриходныхВнешнейБазы(Соединение, НачалоПериода, КонецПериода);
		ТаблицаСравнения = ОтчетОбъект.СравнитьЦеныПриходных(ЦеныТекущие, ЦеныВнешние, ТолькоРазница);
		Результат = ОтчетОбъект.ТабличныйДокументСравнения(ТаблицаСравнения);
	Исключение
		ТекстОшибки = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		Возврат Ложь;
	КонецПопытки;
	
	Возврат Истина;
	
КонецФункции
