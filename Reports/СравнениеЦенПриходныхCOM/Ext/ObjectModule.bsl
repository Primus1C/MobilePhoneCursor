// Сравнение цен закупки ПриходнаяНакладная текущей и внешней базы (COM).
// Синхронизация строк: номер документа + код номенклатуры.

#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

// Параметры COM-подключения к внешней базе (идентичная конфигурация).
// Измените значения под вашу среду.
//
// Возвращаемое значение:
//  Структура - Srvr, Ref, Usr, Pwd (для клиент-сервера) либо File (для файловой базы).
//
Функция ПараметрыПодключенияВнешнейБазы() Экспорт
	
	Параметры = Новый Структура;
	// Клиент-сервер:
	Параметры.Вставить("Srvr", "localhost");
	Параметры.Вставить("Ref", "BaseName");
	Параметры.Вставить("Usr", "Администратор");
	Параметры.Вставить("Pwd", "");
	// Файловая база (если заполнен File — используется он вместо Srvr/Ref):
	Параметры.Вставить("File", "");
	
	Возврат Параметры;
	
КонецФункции

// Строка соединения для V83.COMConnector.
//
Функция СтрокаСоединенияВнешнейБазы() Экспорт
	
	Параметры = ПараметрыПодключенияВнешнейБазы();
	Если ЗначениеЗаполнено(Параметры.File) Тогда
		Возврат СтрШаблон("File=""%1"";Usr=""%2"";Pwd=""%3"";",
			Параметры.File, Параметры.Usr, Параметры.Pwd);
	КонецЕсли;
	
	Возврат СтрШаблон("Srvr=""%1"";Ref=""%2"";Usr=""%3"";Pwd=""%4"";",
		Параметры.Srvr, Параметры.Ref, Параметры.Usr, Параметры.Pwd);
	
КонецФункции

// Подключается к внешней базе через COM.
//
// Параметры:
//  ОписаниеОшибки - Строка - текст ошибки подключения (выходной).
//
// Возвращаемое значение:
//  COMОбъект, Неопределено - внешнее соединение либо Неопределено при ошибке.
//
Функция ПодключитьВнешнююБазу(ОписаниеОшибки) Экспорт
	
	ОписаниеОшибки = "";
	Попытка
		Коннектор = Новый COMОбъект("V83.COMConnector");
		Возврат Коннектор.Connect(СтрокаСоединенияВнешнейБазы());
	Исключение
		ОписаниеОшибки = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		Возврат Неопределено;
	КонецПопытки;
	
КонецФункции

// Текст запроса цен приходных за период (номер + код номенклатуры + средневзвешенная цена).
//
Функция ТекстЗапросаЦенПриходных()
	
	Возврат
	"ВЫБРАТЬ
	|	ПН.Номер КАК Номер,
	|	ПН.Дата КАК Дата,
	|	Товары.Номенклатура.Код КАК КодНоменклатуры,
	|	Товары.Номенклатура.Наименование КАК Номенклатура,
	|	ВЫБОР
	|		КОГДА СУММА(Товары.Количество) = 0
	|			ТОГДА 0
	|		ИНАЧЕ СУММА(Товары.СуммаЗакупки) / СУММА(Товары.Количество)
	|	КОНЕЦ КАК Цена
	|ИЗ
	|	Документ.ПриходнаяНакладная.Товары КАК Товары
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ПриходнаяНакладная КАК ПН
	|		ПО Товары.Ссылка = ПН.Ссылка
	|ГДЕ
	|	ПН.Проведен
	|	И ПН.Дата МЕЖДУ &НачалоПериода И &КонецПериода
	|	И НЕ ПН.ПометкаУдаления
	|
	|СГРУППИРОВАТЬ ПО
	|	ПН.Номер,
	|	ПН.Дата,
	|	Товары.Номенклатура.Код,
	|	Товары.Номенклатура.Наименование
	|
	|УПОРЯДОЧИТЬ ПО
	|	Дата,
	|	Номер,
	|	КодНоменклатуры";
	
КонецФункции

// Цены приходных текущей базы за период.
//
// Параметры:
//  НачалоПериода - Дата;
//  КонецПериода  - Дата.
//
// Возвращаемое значение:
//  ТаблицаЗначений - Номер, Дата, КодНоменклатуры, Номенклатура, Цена.
//
Функция ЦеныПриходныхТекущейБазы(НачалоПериода, КонецПериода) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = ТекстЗапросаЦенПриходных();
	Запрос.УстановитьПараметр("НачалоПериода", НачалоДня(НачалоПериода));
	Запрос.УстановитьПараметр("КонецПериода", КонецДня(КонецПериода));
	
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции

// Цены приходных внешней базы за период (через COM-соединение).
//
// Параметры:
//  Соединение    - COMОбъект - результат Connect;
//  НачалоПериода - Дата;
//  КонецПериода  - Дата.
//
// Возвращаемое значение:
//  ТаблицаЗначений - Номер, Дата, КодНоменклатуры, Номенклатура, Цена.
//
Функция ЦеныПриходныхВнешнейБазы(Соединение, НачалоПериода, КонецПериода) Экспорт
	
	Результат = НоваяТаблицаЦенПриходных();
	
	Запрос = Соединение.NewObject("Query");
	Запрос.Text = ТекстЗапросаЦенПриходных();
	Запрос.SetParameter("НачалоПериода", НачалоДня(НачалоПериода));
	Запрос.SetParameter("КонецПериода", КонецДня(КонецПериода));
	
	Выборка = Запрос.Execute().Choose();
	Пока Выборка.Next() Цикл
		СтрокаТЗ = Результат.Добавить();
		СтрокаТЗ.Номер = СокрЛП(Строка(Выборка.Номер));
		СтрокаТЗ.Дата = Выборка.Дата;
		СтрокаТЗ.КодНоменклатуры = Выборка.КодНоменклатуры;
		СтрокаТЗ.Номенклатура = Строка(Выборка.Номенклатура);
		СтрокаТЗ.Цена = Выборка.Цена;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция НоваяТаблицаЦенПриходных()
	
	Таблица = Новый ТаблицаЗначений;
	Таблица.Колонки.Добавить("Номер", Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(20)));
	Таблица.Колонки.Добавить("Дата", Новый ОписаниеТипов("Дата"));
	Таблица.Колонки.Добавить("КодНоменклатуры");
	Таблица.Колонки.Добавить("Номенклатура", Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(150)));
	Таблица.Колонки.Добавить("Цена", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(19, 4)));
	
	Возврат Таблица;
	
КонецФункции

// Сравнивает таблицы цен; ключ синхронизации — номер документа + код номенклатуры.
//
// Параметры:
//  ЦеныТекущие   - ТаблицаЗначений;
//  ЦеныВнешние   - ТаблицаЗначений;
//  ТолькоРазница - Булево - если Истина, строки с одинаковой ценой не включаются.
//
// Возвращаемое значение:
//  ТаблицаЗначений - Номер, Номенклатура, КодНоменклатуры, ЦенаТекущая, ЦенаВнешняя, Разница, Комментарий.
//
Функция СравнитьЦеныПриходных(ЦеныТекущие, ЦеныВнешние, ТолькоРазница = Истина) Экспорт
	
	Результат = Новый ТаблицаЗначений;
	Результат.Колонки.Добавить("Номер", Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(20)));
	Результат.Колонки.Добавить("Дата", Новый ОписаниеТипов("Дата"));
	Результат.Колонки.Добавить("КодНоменклатуры");
	Результат.Колонки.Добавить("Номенклатура", Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(150)));
	Результат.Колонки.Добавить("ЦенаТекущая", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(19, 4)));
	Результат.Колонки.Добавить("ЦенаВнешняя", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(19, 4)));
	Результат.Колонки.Добавить("Разница", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(19, 4)));
	Результат.Колонки.Добавить("Комментарий", Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(100)));
	
	ИндексВнешних = Новый Соответствие;
	Для Каждого СтрокаВнешняя Из ЦеныВнешние Цикл
		Ключ = КлючСтрокиЦены(СтрокаВнешняя.Номер, СтрокаВнешняя.КодНоменклатуры);
		ИндексВнешних.Вставить(Ключ, СтрокаВнешняя);
	КонецЦикла;
	
	ОбработанныеКлючи = Новый Соответствие;
	
	Для Каждого СтрокаТекущая Из ЦеныТекущие Цикл
		
		Номер = СокрЛП(Строка(СтрокаТекущая.Номер));
		Ключ = КлючСтрокиЦены(Номер, СтрокаТекущая.КодНоменклатуры);
		ОбработанныеКлючи.Вставить(Ключ, Истина);
		
		СтрокаВнешняя = ИндексВнешних.Получить(Ключ);
		ЦенаТекущая = Окр(СтрокаТекущая.Цена, 4);
		
		Если СтрокаВнешняя = Неопределено Тогда
			Если ТолькоРазница Тогда
				ДобавитьСтрокуСравнения(Результат, Номер, СтрокаТекущая.Дата, СтрокаТекущая.КодНоменклатуры,
					СтрокаТекущая.Номенклатура, ЦенаТекущая, 0, ЦенаТекущая, "Нет во внешней базе");
			КонецЕсли;
			Продолжить;
		КонецЕсли;
		
		ЦенаВнешняя = Окр(СтрокаВнешняя.Цена, 4);
		Разница = ЦенаТекущая - ЦенаВнешняя;
		Если ТолькоРазница И Разница = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		Комментарий = ?(Разница = 0, "", "Цена отличается");
		ДобавитьСтрокуСравнения(Результат, Номер, СтрокаТекущая.Дата, СтрокаТекущая.КодНоменклатуры,
			СтрокаТекущая.Номенклатура, ЦенаТекущая, ЦенаВнешняя, Разница, Комментарий);
		
	КонецЦикла;
	
	Для Каждого СтрокаВнешняя Из ЦеныВнешние Цикл
		
		Номер = СокрЛП(Строка(СтрокаВнешняя.Номер));
		Ключ = КлючСтрокиЦены(Номер, СтрокаВнешняя.КодНоменклатуры);
		Если ОбработанныеКлючи.Получить(Ключ) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		Если НЕ ТолькоРазница Тогда
			Продолжить;
		КонецЕсли;
		
		ЦенаВнешняя = Окр(СтрокаВнешняя.Цена, 4);
		ДобавитьСтрокуСравнения(Результат, Номер, СтрокаВнешняя.Дата, СтрокаВнешняя.КодНоменклатуры,
			СтрокаВнешняя.Номенклатура, 0, ЦенаВнешняя, -ЦенаВнешняя, "Нет в текущей базе");
		
	КонецЦикла;
	
	Результат.Сортировать("Дата, Номер, КодНоменклатуры");
	
	Возврат Результат;
	
КонецФункции

Функция КлючСтрокиЦены(Номер, КодНоменклатуры)
	
	Возврат СокрЛП(Строка(Номер)) + "|" + СокрЛП(Строка(КодНоменклатуры));
	
КонецФункции

Процедура ДобавитьСтрокуСравнения(Результат, Номер, Дата, КодНоменклатуры, Номенклатура,
	ЦенаТекущая, ЦенаВнешняя, Разница, Комментарий)
	
	СтрокаТЗ = Результат.Добавить();
	СтрокаТЗ.Номер = Номер;
	СтрокаТЗ.Дата = Дата;
	СтрокаТЗ.КодНоменклатуры = КодНоменклатуры;
	СтрокаТЗ.Номенклатура = Номенклатура;
	СтрокаТЗ.ЦенаТекущая = ЦенаТекущая;
	СтрокаТЗ.ЦенаВнешняя = ЦенаВнешняя;
	СтрокаТЗ.Разница = Разница;
	СтрокаТЗ.Комментарий = Комментарий;
	
КонецПроцедуры

// Формирует табличный документ по результату сравнения.
//
Функция ТабличныйДокументСравнения(ТаблицаСравнения) Экспорт
	
	ТабДок = Новый ТабличныйДокумент;
	ТабДок.ТолькоПросмотр = Истина;
	
	Заголовки = Новый Массив;
	Заголовки.Добавить("Номер");
	Заголовки.Добавить("Дата");
	Заголовки.Добавить("Код");
	Заголовки.Добавить("Номенклатура");
	Заголовки.Добавить("Цена (текущая)");
	Заголовки.Добавить("Цена (внешняя)");
	Заголовки.Добавить("Разница");
	Заголовки.Добавить("Комментарий");
	
	Для Индекс = 0 По Заголовки.ВГраница() Цикл
		Область = ТабДок.Область(1, Индекс + 1);
		Область.Текст = Заголовки[Индекс];
		Область.Шрифт = Новый Шрифт(, , Истина);
	КонецЦикла;
	
	НомерСтроки = 2;
	Для Каждого СтрокаТЗ Из ТаблицаСравнения Цикл
		ТабДок.Область(НомерСтроки, 1).Текст = СтрокаТЗ.Номер;
		ТабДок.Область(НомерСтроки, 2).Текст = Формат(СтрокаТЗ.Дата, "ДФ=dd.MM.yyyy");
		ТабДок.Область(НомерСтроки, 3).Текст = Формат(СтрокаТЗ.КодНоменклатуры, "ЧГ=0");
		ТабДок.Область(НомерСтроки, 4).Текст = СтрокаТЗ.Номенклатура;
		ТабДок.Область(НомерСтроки, 5).Текст = Формат(СтрокаТЗ.ЦенаТекущая, "ЧДЦ=4; ЧН=0");
		ТабДок.Область(НомерСтроки, 6).Текст = Формат(СтрокаТЗ.ЦенаВнешняя, "ЧДЦ=4; ЧН=0");
		ТабДок.Область(НомерСтроки, 7).Текст = Формат(СтрокаТЗ.Разница, "ЧДЦ=4; ЧН=0");
		ТабДок.Область(НомерСтроки, 8).Текст = СтрокаТЗ.Комментарий;
		НомерСтроки = НомерСтроки + 1;
	КонецЦикла;
	
	ТабДок.Область(, 1, , 1).ШиринаКолонки = 12;
	ТабДок.Область(, 2, , 2).ШиринаКолонки = 12;
	ТабДок.Область(, 3, , 3).ШиринаКолонки = 10;
	ТабДок.Область(, 4, , 4).ШиринаКолонки = 40;
	ТабДок.Область(, 5, , 5).ШиринаКолонки = 14;
	ТабДок.Область(, 6, , 6).ШиринаКолонки = 14;
	ТабДок.Область(, 7, , 7).ШиринаКолонки = 12;
	ТабДок.Область(, 8, , 8).ШиринаКолонки = 22;
	
	Возврат ТабДок;
	
КонецФункции

#КонецЕсли
