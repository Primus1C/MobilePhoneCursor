Процедура ПриКомпоновкеРезультата(ДокументРезультат, ДанныеРасшифровки, СтандартнаяОбработка)
	
	ДокументРезультат.КлючПараметровПечати = Метаданные().Имя + ".Печать";
	СкрытьРезервНаУровнеПартии(КомпоновщикНастроек.Настройки);
	
КонецПроцедуры

// На строках партий колонка «Резерв» не выводится: значение живёт только
// на складе, номенклатуре и общих итогах.
//
// Параметры:
//  Настройки - НастройкиКомпоновкиДанных - настройки формируемого отчёта.
//
Процедура СкрытьРезервНаУровнеПартии(Настройки)
	
	ЭлементОформления = Настройки.УсловноеОформление.Элементы.Добавить();
	ЭлементОформления.Использование = Истина;
	
	ПолеОформления = ЭлементОформления.Поля.Элементы.Добавить();
	ПолеОформления.Поле = Новый ПолеКомпоновкиДанных("РезервОстаток");
	ПолеОформления.Использование = Истина;
	
	ОтборПартии = ЭлементОформления.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборПартии.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Партия");
	ОтборПартии.ВидСравнения = ВидСравненияКомпоновкиДанных.Заполнено;
	ОтборПартии.Использование = Истина;
	
	ЭлементОформления.Оформление.УстановитьЗначениеПараметра("Текст", "");
	ЭлементОформления.Оформление.УстановитьЗначениеПараметра("Видимость", Ложь);
	
КонецПроцедуры
