
// Формирует отчет программно, чтобы после вывода свернуть группировки табличного документа.
// Стандартная обработка отключается только ради вызова ПоказатьУровеньГруппировокСтрок.
//
Процедура ПриКомпоновкеРезультата(ДокументРезультат, ДанныеРасшифровки, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	Настройки = КомпоновщикНастроек.ПолучитьНастройки();
	ЗаполнитьПараметрыПериодаИзСтандартногоПериода(Настройки);
	
	КомпоновщикМакет = Новый КомпоновщикМакетаКомпоновкиДанных;
	Макет = КомпоновщикМакет.Выполнить(СхемаКомпоновкиДанных, Настройки, ДанныеРасшифровки);
	ПроцессорКомпоновки = Новый ПроцессорКомпоновкиДанных;
	ПроцессорКомпоновки.Инициализировать(Макет, , ДанныеРасшифровки);
	ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВТабличныйДокумент;
	ПроцессорВывода.УстановитьДокумент(ДокументРезультат);
	ПроцессорВывода.Вывести(ПроцессорКомпоновки);
	ДокументРезультат.ПоказатьУровеньГруппировокСтрок(0);
	
КонецПроцедуры

// Копирует даты из параметра ПериодОтчета в НачалоПериода / КонецПериода (тип Дата).
// Нужно, чтобы в виртуальные таблицы не попал СтандартныйПериод.
//
// Параметры:
//  Настройки - НастройкиКомпоновкиДанных - настройки отчета перед компоновкой.
//
Процедура ЗаполнитьПараметрыПериодаИзСтандартногоПериода(Настройки)
	
	ПараметрПериод = Настройки.ПараметрыДанных.НайтиЗначениеПараметра(
		Новый ПараметрКомпоновкиДанных("ПериодОтчета"));
	Если ПараметрПериод = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Период = ПараметрПериод.Значение;
	Если ТипЗнч(Период) <> Тип("СтандартныйПериод") Тогда
		Возврат;
	КонецЕсли;
	
	УстановитьЗначениеПараметраДанных(Настройки, "НачалоПериода", Период.ДатаНачала);
	УстановитьЗначениеПараметраДанных(Настройки, "КонецПериода", Период.ДатаОкончания);
	
КонецПроцедуры

// Устанавливает значение параметра данных настроек компоновки.
//
// Параметры:
//  Настройки - НастройкиКомпоновкиДанных;
//  ИмяПараметра - Строка;
//  Значение - Произвольный.
//
Процедура УстановитьЗначениеПараметраДанных(Настройки, ИмяПараметра, Значение)
	
	Параметр = Настройки.ПараметрыДанных.НайтиЗначениеПараметра(
		Новый ПараметрКомпоновкиДанных(ИмяПараметра));
	Если Параметр = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Параметр.Значение = Значение;
	Параметр.Использование = Истина;
	
КонецПроцедуры
