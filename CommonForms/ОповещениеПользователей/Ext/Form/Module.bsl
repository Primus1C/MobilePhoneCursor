#Область ОбработчикиСобытийФормы

// Загружает сохраненные тексты сообщений текущего пользователя.
//
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ПрочитатьШаблоныНаСервере();
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементов

// Подставляет текст выбранной строки списка в поле сообщения.
//
// Параметры:
//  Элемент              - ТаблицаФормы - таблица шаблонов;
//  ВыбраннаяСтрока      - Число - идентификатор строки;
//  Поле                 - ПолеФормы - поле, в котором выполнен выбор;
//  СтандартнаяОбработка - Булево - признак стандартной обработки.
//
&НаКлиенте
Процедура ШаблоныВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	ПодставитьТекстТекущейСтроки();
	
КонецПроцедуры

// Сохраняет список текстов после изменения таблицы.
//
// Параметры:
//  Элемент - ТаблицаФормы - таблица шаблонов.
//
&НаКлиенте
Процедура ШаблоныПриИзменении(Элемент)
	
	ЗаписатьШаблоныНаСервере();
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

// Подставляет текст текущей строки списка в поле сообщения.
//
// Параметры:
//  Команда - КомандаФормы - выполняемая команда.
//
&НаКлиенте
Процедура Выбрать(Команда)
	
	ПодставитьТекстТекущейСтроки();
	
КонецПроцедуры

// Добавляет текст поля сообщения в список, если его там еще нет.
//
// Параметры:
//  Команда - КомандаФормы - выполняемая команда.
//
&НаКлиенте
Процедура СохранитьВСписок(Команда)
	
	Текст = СокрЛП(ТекстСообщения);
	Если Текст = "" Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого СтрокаШаблона Из Шаблоны Цикл
		Если СтрокаШаблона.Текст = Текст Тогда
			Возврат;
		КонецЕсли;
	КонецЦикла;
	
	НоваяСтрока = Шаблоны.Добавить();
	НоваяСтрока.Текст = Текст;
	Элементы.Шаблоны.ТекущаяСтрока = НоваяСтрока.ПолучитьИдентификатор();
	ЗаписатьШаблоныНаСервере();
	
КонецПроцедуры

// Удаляет текущую строку списка сохраненных текстов.
//
// Параметры:
//  Команда - КомандаФормы - выполняемая команда.
//
&НаКлиенте
Процедура УдалитьИзСписка(Команда)
	
	ТекущиеДанные = Элементы.Шаблоны.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Шаблоны.Удалить(ТекущиеДанные);
	ЗаписатьШаблоныНаСервере();
	
КонецПроцедуры

// Отправляет текст поля сообщения всем пользователям.
//
// Параметры:
//  Команда - КомандаФормы - выполняемая команда.
//
&НаКлиенте
Процедура Отправить(Команда)
	
	Текст = СокрЛП(ТекстСообщения);
	Если Текст = "" Тогда
		Возврат;
	КонецЕсли;
	
	омСервер.ЗаписатьСообщениеВсемПользователям(Текст);
	Закрыть();
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Копирует текст текущей строки списка в поле сообщения.
//
&НаКлиенте
Процедура ПодставитьТекстТекущейСтроки()
	
	ТекущиеДанные = Элементы.Шаблоны.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ТекстСообщения = ТекущиеДанные.Текст;
	
КонецПроцедуры

// Загружает сохраненные тексты из хранилища общих настроек текущего пользователя.
//
&НаСервере
Процедура ПрочитатьШаблоныНаСервере()
	
	Шаблоны.Очистить();
	Сохраненные = ХранилищеОбщихНастроек.Загрузить("Оповещение", "Шаблоны");
	Если ТипЗнч(Сохраненные) <> Тип("Массив") Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого ТекстШаблона Из Сохраненные Цикл
		Если ТипЗнч(ТекстШаблона) <> Тип("Строка") Тогда
			Продолжить;
		КонецЕсли;
		ТекстШаблона = СокрЛП(ТекстШаблона);
		Если ТекстШаблона = "" Тогда
			Продолжить;
		КонецЕсли;
		НоваяСтрока = Шаблоны.Добавить();
		НоваяСтрока.Текст = ТекстШаблона;
	КонецЦикла;
	
КонецПроцедуры

// Сохраняет тексты списка в хранилище общих настроек текущего пользователя.
//
&НаСервере
Процедура ЗаписатьШаблоныНаСервере()
	
	МассивТекстов = Новый Массив;
	Для Каждого СтрокаШаблона Из Шаблоны Цикл
		ТекстШаблона = СокрЛП(СтрокаШаблона.Текст);
		Если ТекстШаблона = "" Тогда
			Продолжить;
		КонецЕсли;
		МассивТекстов.Добавить(ТекстШаблона);
	КонецЦикла;
	
	ХранилищеОбщихНастроек.Сохранить("Оповещение", "Шаблоны", МассивТекстов);
	
КонецПроцедуры

#КонецОбласти
