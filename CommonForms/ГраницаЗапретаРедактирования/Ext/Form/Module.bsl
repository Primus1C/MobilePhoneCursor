
&НаКлиенте
Процедура ПослеЗаписи(ПараметрыЗаписи)                                              
	
	Установить();
	
КонецПроцедуры 

&НаКлиенте
// Открывает журнал регистрации по константе «Дата запрета редактирования».
//
// Параметры:
//  Команда - КомандаФормы
//
Процедура ЖурналСобытий(Команда)
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("ИмяКонстанты", "ДатаЗапретаРедактирования");
	ПараметрыФормы.Вставить("СобытиеЖурнала", "Администрирование.Дата запрета редактирования");
	ОткрытьФорму("ОбщаяФорма.ЖурналПоОбъекту", ПараметрыФормы, ЭтаФорма);
	
КонецПроцедуры

&НаСервере
Процедура Установить()

	ПараметрыСеанса.ДатаЗапретаРедактирования = Константы.ДатаЗапретаРедактирования.Получить();

КонецПроцедуры

