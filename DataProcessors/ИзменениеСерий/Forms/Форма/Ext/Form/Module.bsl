#Область ОбработчикиКомандФормы

// Добавляет "-" перед серией в элементах справочника Партии по строкам Товары выбранного документа.
//
// Параметры:
//  Команда - КомандаФормы - команда формы.
//
&НаКлиенте
Процедура ИзменитьСерииВПартиях(Команда)
	
	ИзменитьСерииВПартияхНаСервере();
	
КонецПроцедуры

// Устанавливает Серия в строках Товары равной Партия.Серия и записывает документ без проведения.
//
// Параметры:
//  Команда - КомандаФормы - команда формы.
//
&НаКлиенте
Процедура УстановитьСерииИзПартий(Команда)
	
	УстановитьСерииИзПартийНаСервере();
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Добавляет "-" перед Серия в уникальных партиях строк Товары выбранного документа.
//
&НаСервере
Процедура ИзменитьСерииВПартияхНаСервере()
	
	Статус = "";
	
	Если НЕ ЗначениеЗаполнено(Объект.ВыбДокумент) Тогда
		Статус = "Выберите документ.";
		Возврат;
	КонецЕсли;
	
	ДокументОбъект = Объект.ВыбДокумент.ПолучитьОбъект();
	ОбработанныеПартии = Новый Соответствие;
	Изменено = 0;
	Пропущено = 0;
	
	НачатьТранзакцию();
	Попытка
		
		Для Каждого СтрокаТовары Из ДокументОбъект.Товары Цикл
			
			Если НЕ ЗначениеЗаполнено(СтрокаТовары.Партия) Тогда
				Продолжить;
			КонецЕсли;
			Если ОбработанныеПартии[СтрокаТовары.Партия] <> Неопределено Тогда
				Продолжить;
			КонецЕсли;
			ОбработанныеПартии.Вставить(СтрокаТовары.Партия, Истина);
			
			ПартияОбъект = СтрокаТовары.Партия.ПолучитьОбъект();
			Если ПартияОбъект = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			Если СтрНачинаетсяС(ПартияОбъект.Серия, "-") Тогда
				Пропущено = Пропущено + 1;
				Продолжить;
			КонецЕсли;
			
			ПартияОбъект.Серия = "-" + ПартияОбъект.Серия;
			ПартияОбъект.Записать();
			Изменено = Изменено + 1;
			
		КонецЦикла;
		
		ЗафиксироватьТранзакцию();
		
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;
	
	Статус = СтрШаблон("Изменено партий: %1. Пропущено (серия уже с ""-""): %2.", Изменено, Пропущено);
	
КонецПроцедуры

// Заполняет Серия в строках Товары значением Партия.Серия и записывает документ без проведения.
//
&НаСервере
Процедура УстановитьСерииИзПартийНаСервере()
	
	Статус = "";
	
	Если НЕ ЗначениеЗаполнено(Объект.ВыбДокумент) Тогда
		Статус = "Выберите документ.";
		Возврат;
	КонецЕсли;
	
	ДокументОбъект = Объект.ВыбДокумент.ПолучитьОбъект();
	Обновлено = 0;
	
	Для Каждого СтрокаТовары Из ДокументОбъект.Товары Цикл
		
		Если НЕ ЗначениеЗаполнено(СтрокаТовары.Партия) Тогда
			Продолжить;
		КонецЕсли;
		
		СерияПартии = СтрокаТовары.Партия.Серия;
		Если СтрокаТовары.Серия = СерияПартии Тогда
			Продолжить;
		КонецЕсли;
		
		СтрокаТовары.Серия = СерияПартии;
		Обновлено = Обновлено + 1;
		
	КонецЦикла;
	
	ДокументОбъект.Записать(РежимЗаписиДокумента.Запись);
	Статус = СтрШаблон("Обновлено строк: %1. Документ записан без проведения.", Обновлено);
	
КонецПроцедуры

#КонецОбласти
