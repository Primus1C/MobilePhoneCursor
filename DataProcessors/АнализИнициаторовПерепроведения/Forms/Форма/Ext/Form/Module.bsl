#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если НЕ ЗначениеЗаполнено(НачалоПериода) Тогда
		НачалоПериода = НачалоДня(ТекущаяДатаСеанса());
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(КонецПериода) Тогда
		КонецПериода = КонецДня(ТекущаяДатаСеанса());
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Сформировать(Команда)
	
	СформироватьНаСервере();
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура СформироватьНаСервере()
	
	Результат.Очистить();
	Статус = "";
	
	Если НЕ ЗначениеЗаполнено(НачалоПериода) ИЛИ НЕ ЗначениеЗаполнено(КонецПериода) Тогда
		Статус = "Укажите период.";
		Возврат;
	КонецЕсли;
	Если НачалоПериода > КонецПериода Тогда
		Статус = "Начало периода больше окончания.";
		Возврат;
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Истина);
	
	СобытияЖурнала = ВыгрузитьСобытияРегистрацииКДопПроведению(НачалоПериода, КонецПериода);
	КартаПредставлений = КартаПредставленийДокументов(СобытияЖурнала);
	
	ГрафЖертваИнициатор = Новый Соответствие;
	ЖертвыПериода = Новый Соответствие;
	ЧислоРазобрано = 0;
	
	Для Каждого СтрокаСобытия Из СобытияЖурнала Цикл
		
		Инициатор = ИнициаторИзКомментария(СтрокаСобытия.Комментарий, КартаПредставлений);
		Если НЕ ЗначениеЗаполнено(Инициатор) Тогда
			Продолжить;
		КонецЕсли;
		Если НЕ ЗначениеЗаполнено(СтрокаСобытия.Данные) Тогда
			Продолжить;
		КонецЕсли;
		Если НЕ Документы.ТипВсеСсылки().СодержитТип(ТипЗнч(СтрокаСобытия.Данные)) Тогда
			Продолжить;
		КонецЕсли;
		Если НЕ Документы.ТипВсеСсылки().СодержитТип(ТипЗнч(Инициатор)) Тогда
			Продолжить;
		КонецЕсли;
		
		ГрафЖертваИнициатор.Вставить(СтрокаСобытия.Данные, Инициатор);
		ЖертвыПериода.Вставить(СтрокаСобытия.Данные, Истина);
		ДополнитьКартуПредставлений(КартаПредставлений, Инициатор);
		ЧислоРазобрано = ЧислоРазобрано + 1;
		
	КонецЦикла;
	
	КэшКорней = Новый Соответствие;
	СтрокиПоКорню = Новый Соответствие;
	
	Для Каждого КлючИЗначение Из ЖертвыПериода Цикл
		
		Жертва = КлючИЗначение.Ключ;
		ОписаниеКорня = НайтиКореньЦепочки(Жертва, ГрафЖертваИнициатор, КартаПредставлений, КэшКорней);
		Корень = ОписаниеКорня.Корень;
		Если НЕ ЗначениеЗаполнено(Корень) Тогда
			Продолжить;
		КонецЕсли;
		
		СтрокаРезультата = СтрокиПоКорню.Получить(Корень);
		Если СтрокаРезультата = Неопределено Тогда
			СтрокаРезультата = Результат.Добавить();
			СтрокаРезультата.Документ = Корень;
			Попытка
				СтрокаРезультата.ДатаДокумента = Корень.Дата;
				СтрокаРезультата.ВидДокумента = Корень.Метаданные().Синоним;
			Исключение
				СтрокаРезультата.ДатаДокумента = Неопределено;
				СтрокаРезультата.ВидДокумента = Строка(ТипЗнч(Корень));
			КонецПопытки;
			СтрокаРезультата.ЧислоЗависимых = 0;
			СтрокаРезультата.ПримерЦепочки = ОписаниеКорня.Цепочка;
			СтрокиПоКорню.Вставить(Корень, СтрокаРезультата);
		КонецЕсли;
		
		СтрокаРезультата.ЧислоЗависимых = СтрокаРезультата.ЧислоЗависимых + 1;
		Если СтрДлина(ОписаниеКорня.Цепочка) > СтрДлина(СтрокаРезультата.ПримерЦепочки) Тогда
			СтрокаРезультата.ПримерЦепочки = ОписаниеКорня.Цепочка;
		КонецЕсли;
		
	КонецЦикла;
	
	Результат.Сортировать("ДатаДокумента, ВидДокумента");
	
	Статус = СтрШаблон(
		"Событий регистрации в периоде: %1, разобрано пар: %2, корневых документов: %3",
		СобытияЖурнала.Количество(),
		ЧислоРазобрано,
		Результат.Количество());
	
	УстановитьПривилегированныйРежим(Ложь);
	
КонецПроцедуры

// Выгружает из журнала регистрации события постановки в очередь доп.проведения за период.
// Уровень «Предупреждение» — как при записи гоЗаписьЖурналаРегистрации(..., 4).
//
// Параметры:
//  ДатаНачала    - Дата - начало периода;
//  ДатаОкончания - Дата - конец периода.
//
// Возвращаемое значение:
//  ТаблицаЗначений - колонки журнала с отбором по комментарию регистрации.
//
&НаСервере
Функция ВыгрузитьСобытияРегистрацииКДопПроведению(ДатаНачала, ДатаОкончания)
	
	Фильтр = Новый Структура;
	Фильтр.Вставить("ДатаНачала", ДатаНачала);
	Фильтр.Вставить("ДатаОкончания", ДатаОкончания);
	Фильтр.Вставить("Уровень", УровеньЖурналаРегистрации.Предупреждение);
	
	ТаблицаСобытий = Новый ТаблицаЗначений;
	ВыгрузитьЖурналРегистрации(
		ТаблицаСобытий,
		Фильтр,
		"Дата,Комментарий,ПредставлениеДанных,Данные",
		,
		);
	
	РезультатОтбора = ТаблицаСобытий.СкопироватьКолонки();
	Префикс = ПрефиксРегистрацииКДопПроведению();
	
	Для Каждого СтрокаСобытия Из ТаблицаСобытий Цикл
		Если СтрНачинаетсяС(СтрокаСобытия.Комментарий, Префикс) Тогда
			ЗаполнитьЗначенияСвойств(РезультатОтбора.Добавить(), СтрокаСобытия);
		КонецЕсли;
	КонецЦикла;
	
	Возврат РезультатОтбора;
	
КонецФункции

// Строит соответствие «представление документа → ссылка» по выгрузке журнала.
//
// Параметры:
//  СобытияЖурнала - ТаблицаЗначений - события с колонками Данные, ПредставлениеДанных.
//
// Возвращаемое значение:
//  Соответствие - ключ Строка, значение ДокументСсылка.
//
&НаСервере
Функция КартаПредставленийДокументов(СобытияЖурнала)
	
	Карта = Новый Соответствие;
	Для Каждого СтрокаСобытия Из СобытияЖурнала Цикл
		Если ЗначениеЗаполнено(СтрокаСобытия.Данные)
			И Документы.ТипВсеСсылки().СодержитТип(ТипЗнч(СтрокаСобытия.Данные)) Тогда
			ДополнитьКартуПредставлений(Карта, СтрокаСобытия.Данные, СтрокаСобытия.ПредставлениеДанных);
		КонецЕсли;
	КонецЦикла;
	Возврат Карта;
	
КонецФункции

// Добавляет в карту представлений ссылку документа.
//
// Параметры:
//  Карта               - Соответствие - карта представлений;
//  ДокументСсылка      - ДокументСсылка - документ;
//  ПредставлениеДанных - Строка - представление из журнала (необязательно).
//
&НаСервере
Процедура ДополнитьКартуПредставлений(Карта, ДокументСсылка, ПредставлениеДанных = "")
	
	Если НЕ ЗначениеЗаполнено(ДокументСсылка) Тогда
		Возврат;
	КонецЕсли;
	
	Карта.Вставить(Строка(ДокументСсылка), ДокументСсылка);
	Если ЗначениеЗаполнено(ПредставлениеДанных) Тогда
		Карта.Вставить(СокрЛП(ПредставлениеДанных), ДокументСсылка);
	КонецЕсли;
	
КонецПроцедуры

// Извлекает инициатора из комментария события регистрации / регламентного проведения.
// Поддерживает новый формат «внутр // представление» и старый — только представление.
//
// Параметры:
//  Комментарий         - Строка - комментарий журнала;
//  КартаПредставлений  - Соответствие - представление → ссылка.
//
// Возвращаемое значение:
//  ДокументСсылка, Неопределено - инициатор либо Неопределено.
//
&НаСервере
Функция ИнициаторИзКомментария(Комментарий, КартаПредставлений)
	
	Хвост = ХвостКомментарияИнициатора(Комментарий);
	Если Хвост = "" Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ПозицияРазделителя = СтрНайти(Хвост, " // ");
	Если ПозицияРазделителя > 0 Тогда
		ВнутрСтрока = Лев(Хвост, ПозицияРазделителя - 1);
		Попытка
			Значение = ЗначениеИзСтрокиВнутр(ВнутрСтрока);
			Если ЗначениеЗаполнено(Значение)
				И Документы.ТипВсеСсылки().СодержитТип(ТипЗнч(Значение)) Тогда
				Возврат Значение;
			КонецЕсли;
		Исключение
			// старый или повреждённый формат — ниже по представлению
		КонецПопытки;
		Хвост = Сред(Хвост, ПозицияРазделителя + 4);
	КонецЕсли;
	
	Возврат КартаПредставлений.Получить(СокрЛП(Хвост));
	
КонецФункции

// Возвращает часть комментария после префикса регистрации или регламентного проведения.
//
// Параметры:
//  Комментарий - Строка - полный комментарий события.
//
// Возвращаемое значение:
//  Строка - хвост с данными инициатора или пустая строка.
//
&НаСервере
Функция ХвостКомментарияИнициатора(Комментарий)
	
	ПрефиксРег = ПрефиксРегистрацииКДопПроведению();
	Если СтрНачинаетсяС(Комментарий, ПрефиксРег) Тогда
		Возврат Сред(Комментарий, СтрДлина(ПрефиксРег) + 1);
	КонецЕсли;
	
	ПрефиксРегл = ПрефиксРегламентногоПроведения();
	Если СтрНачинаетсяС(Комментарий, ПрефиксРегл) Тогда
		Возврат Сред(Комментарий, СтрДлина(ПрефиксРегл) + 1);
	КонецЕсли;
	
	Возврат "";
	
КонецФункции

&НаСервере
Функция ПрефиксРегистрацииКДопПроведению()
	
	Возврат "Регистрация к доп.проведению документом ";
	
КонецФункции

&НаСервере
Функция ПрефиксРегламентногоПроведения()
	
	Возврат "Регламентное проведение: инициатор ";
	
КонецФункции

// Поднимается по цепочке жертва → инициатор до документа без авто-инициатора (пользовательское проведение).
//
// Параметры:
//  Жертва                 - ДокументСсылка - документ, перепроведённый автоматически;
//  ГрафЖертваИнициатор    - Соответствие - жертва → инициатор;
//  КартаПредставлений     - Соответствие - представления документов;
//  КэшКорней              - Соответствие - кэш найденных корней по документам цепочки.
//
// Возвращаемое значение:
//  Структура:
//      * Корень   - ДокументСсылка - корневой документ пользовательского проведения;
//      * Цепочка  - Строка - представление цепочки от жертвы к корню.
//
&НаСервере
Функция НайтиКореньЦепочки(Жертва, ГрафЖертваИнициатор, КартаПредставлений, КэшКорней)
	
	Кэшированный = КэшКорней.Получить(Жертва);
	Если Кэшированный <> Неопределено Тогда
		Возврат Кэшированный;
	КонецЕсли;
	
	Текущий = Жертва;
	Посещенные = Новый Соответствие;
	ФрагментыЦепочки = Новый Массив;
	ФрагментыЦепочки.Добавить(Строка(Текущий));
	
	Пока Истина Цикл
		
		Если Посещенные.Получить(Текущий) = Истина Тогда
			Прервать;
		КонецЕсли;
		Посещенные.Вставить(Текущий, Истина);
		
		Инициатор = ГрафЖертваИнициатор.Получить(Текущий);
		Если Инициатор = Неопределено Тогда
			Инициатор = ИнициаторДокументаИзЖурнала(Текущий, КартаПредставлений);
			Если ЗначениеЗаполнено(Инициатор) Тогда
				ГрафЖертваИнициатор.Вставить(Текущий, Инициатор);
				ДополнитьКартуПредставлений(КартаПредставлений, Инициатор);
			КонецЕсли;
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(Инициатор) Тогда
			Прервать;
		КонецЕсли;
		
		Текущий = Инициатор;
		ФрагментыЦепочки.Добавить(Строка(Текущий));
		
	КонецЦикла;
	
	Описание = Новый Структура("Корень, Цепочка", Текущий, СтрСоединить(ФрагментыЦепочки, " ← "));
	КэшКорней.Вставить(Жертва, Описание);
	
	Возврат Описание;
	
КонецФункции

// Ищет в журнале регистрации инициатора автоперепроведения конкретного документа (вне периода формы).
//
// Параметры:
//  ДокументСсылка     - ДокументСсылка - документ-жертва;
//  КартаПредставлений - Соответствие - карта представлений.
//
// Возвращаемое значение:
//  ДокументСсылка, Неопределено - инициатор либо Неопределено.
//
&НаСервере
Функция ИнициаторДокументаИзЖурнала(ДокументСсылка, КартаПредставлений)
	
	Если НЕ ЗначениеЗаполнено(ДокументСсылка) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Фильтр = Новый Структура;
	Фильтр.Вставить("Данные", ДокументСсылка);
	Фильтр.Вставить("Уровень", УровеньЖурналаРегистрации.Предупреждение);
	
	ТаблицаСобытий = Новый ТаблицаЗначений;
	ВыгрузитьЖурналРегистрации(
		ТаблицаСобытий,
		Фильтр,
		"Дата,Комментарий,ПредставлениеДанных,Данные",
		,
		5000);
	
	Префикс = ПрефиксРегистрацииКДопПроведению();
	Инициатор = Неопределено;
	
	Для Каждого СтрокаСобытия Из ТаблицаСобытий Цикл
		Если НЕ СтрНачинаетсяС(СтрокаСобытия.Комментарий, Префикс) Тогда
			Продолжить;
		КонецЕсли;
		Найденный = ИнициаторИзКомментария(СтрокаСобытия.Комментарий, КартаПредставлений);
		Если ЗначениеЗаполнено(Найденный) Тогда
			Инициатор = Найденный;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Инициатор;
	
КонецФункции

#КонецОбласти
