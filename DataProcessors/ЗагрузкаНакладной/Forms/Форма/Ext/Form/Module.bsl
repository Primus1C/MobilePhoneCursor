#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если НомерКолонкиКодТовара = 0 Тогда
		НомерКолонкиКодТовара = 1;
	КонецЕсли;
	Если НомерКолонкиКоличество = 0 Тогда
		НомерКолонкиКоличество = 2;
	КонецЕсли;
	Если НомерКолонкиЦена = 0 Тогда
		НомерКолонкиЦена = 3;
	КонецЕсли;
	Если НомерКолонкиСерии = 0 Тогда
		НомерКолонкиСерии = 4;
	КонецЕсли;
	Если НомерКолонкиНаименование1С = 0 Тогда
		НомерКолонкиНаименование1С = 5;
	КонецЕсли;
	Если НомерКолонкиОшибки = 0 Тогда
		НомерКолонкиОшибки = 6;
	КонецЕсли;
	
	Если Таблица.ВысотаТаблицы = 0 Тогда
		Таблица.Область(1, 1, 1, 1).Текст = "";
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Загрузить(Команда)
	
	ОчищатьТовары = Истина;
	Если ЗначениеЗаполнено(Накладная) И ТабличнаяЧастьНакладнойЗаполнена(Накладная) Тогда
		клНетДа(Новый ОписаниеОповещения("ЗагрузитьПослеВопроса", ЭтотОбъект),
			"Табличная часть накладной не пуста. Очистить перед заполнением?",
			,
			Истина);
		Возврат;
	КонецЕсли;
	
	ЗагрузитьНаСервере(ОчищатьТовары);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьПослеВопроса(Результат, ДопПараметры) Экспорт
	
	ЗагрузитьНаСервере(Результат);
	
КонецПроцедуры

&НаКлиенте
Процедура ВывестиНаименования1С(Команда)
	
	ВывестиНаименования1СНаСервере();
	
КонецПроцедуры

&НаКлиенте
Процедура Сравнить(Команда)
	
	СравнитьНаСервере();
	
КонецПроцедуры

&НаКлиенте
Процедура ПодобратьНакладные(Команда)
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("РежимВыбора", Истина);
	ПараметрыФормы.Вставить("МножественныйВыбор", Истина);
	ПараметрыФормы.Вставить("ЗакрыватьПриВыборе", Ложь);
	ОткрытьФорму("Документ.ПриходнаяНакладная.ФормаВыбора", ПараметрыФормы, Элементы.НакладныеДляСравнения);
	
КонецПроцедуры

&НаКлиенте
Процедура НакладныеДляСравненияОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	ДобавитьНакладныеВСписок(ВыбранноеЗначение);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаВыбора(ВыбранноеЗначение, ИсточникВыбора)
	
	ДобавитьНакладныеВСписок(ВыбранноеЗначение);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Добавляет выбранные накладные в список сравнения без повторов.
//
// Параметры:
//  ВыбранноеЗначение - ДокументСсылка.ПриходнаяНакладная, Массив - выбранные документы.
//
&НаКлиенте
Процедура ДобавитьНакладныеВСписок(ВыбранноеЗначение)
	
	МассивНакладных = Новый Массив;
	Если ТипЗнч(ВыбранноеЗначение) = Тип("Массив") Тогда
		МассивНакладных = ВыбранноеЗначение;
	Иначе
		МассивНакладных.Добавить(ВыбранноеЗначение);
	КонецЕсли;
	
	Для Каждого СсылкаНакладной Из МассивНакладных Цикл
		
		Если НЕ ЗначениеЗаполнено(СсылкаНакладной) Тогда
			Продолжить;
		КонецЕсли;
		
		НайдСтроки = НакладныеДляСравнения.НайтиСтроки(Новый Структура("Накладная", СсылкаНакладной));
		Если НайдСтроки.Количество() > 0 Тогда
			Продолжить;
		КонецЕсли;
		
		НовСтр = НакладныеДляСравнения.Добавить();
		НовСтр.Накладная = СсылкаНакладной;
		
	КонецЦикла;
	
КонецПроцедуры

// Сравнивает табличный документ с выбранными приходными накладными и пишет ошибки в колонку.
//
&НаСервере
Процедура СравнитьНаСервере()
	
	Статус = "";
	
	Если НомерКолонкиКодТовара < 1 Тогда
		СообщитьОбОшибке("Укажите номер колонки кода товара.");
		Возврат;
	КонецЕсли;
	
	Если НомерКолонкиСерии < 1 Тогда
		СообщитьОбОшибке("Укажите номер колонки серий.");
		Возврат;
	КонецЕсли;
	
	Если НомерКолонкиЦена < 1 Тогда
		СообщитьОбОшибке("Укажите номер колонки цены.");
		Возврат;
	КонецЕсли;
	
	Если НомерКолонкиОшибки < 1 Тогда
		СообщитьОбОшибке("Укажите номер колонки ошибок.");
		Возврат;
	КонецЕсли;
	
	Если Таблица.ВысотаТаблицы = 0 Тогда
		СообщитьОбОшибке("Таблица пустая.");
		Возврат;
	КонецЕсли;
	
	МассивНакладных = Новый Массив;
	Для Каждого СтрокаСписка Из НакладныеДляСравнения Цикл
		Если ЗначениеЗаполнено(СтрокаСписка.Накладная) И МассивНакладных.Найти(СтрокаСписка.Накладная) = Неопределено Тогда
			МассивНакладных.Добавить(СтрокаСписка.Накладная);
		КонецЕсли;
	КонецЦикла;
	
	Если МассивНакладных.Количество() = 0 Тогда
		СообщитьОбОшибке("Подберите приходные накладные для сравнения.");
		Возврат;
	КонецЕсли;
	
	ОчиститьКолонкуОшибок();
	
	СтрокиНакладныхПоСериям = СтрокиНакладныхПоСериям(МассивНакладных);
	СтрокиТаблицыПоСериям = СтрокиТаблицыПоСериям();
	ПриходыСерий = НомераДокументовПриходаСерий(СерииБезНакладных(СтрокиТаблицыПоСериям, СтрокиНакладныхПоСериям));
	
	СтрокСОшибками = 0;
	ОбработанныеСтроки = Новый Соответствие;
	
	Для Каждого КлючИЗначение Из СтрокиТаблицыПоСериям Цикл
		Для Каждого ОписаниеСтроки Из КлючИЗначение.Значение Цикл
			ОбработанныеСтроки.Вставить(ОписаниеСтроки.НомерСтроки, Истина);
		КонецЦикла;
	КонецЦикла;
	
	Для Каждого КлючСтроки Из ОбработанныеСтроки Цикл
		
		НомерСтроки = КлючСтроки.Ключ;
		ОшибкиСтроки = ОшибкиСравненияСтроки(
			НомерСтроки,
			СтрокиТаблицыПоСериям,
			СтрокиНакладныхПоСериям,
			ПриходыСерий);
		
		Если ОшибкиСтроки.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		ЗаписатьТекстЯчейки(Таблица, НомерСтроки, НомерКолонкиОшибки, СтрСоединить(ОшибкиСтроки, "; "));
		СтрокСОшибками = СтрокСОшибками + 1;
		
	КонецЦикла;
	
	Если СтрокСОшибками = 0 Тогда
		Статус = "Расхождений не найдено.";
	Иначе
		Статус = СтрШаблон("Строк с ошибками: %1.", СтрокСОшибками);
	КонецЕсли;
	
КонецПроцедуры

// Очищает колонку ошибок во всех строках табличного документа.
//
&НаСервере
Процедура ОчиститьКолонкуОшибок()
	
	Для НомерСтроки = 1 По Таблица.ВысотаТаблицы Цикл
		ЗаписатьТекстЯчейки(Таблица, НомерСтроки, НомерКолонкиОшибки, "");
	КонецЦикла;
	
КонецПроцедуры

// Собирает строки выбранных накладных с заполненной серией, сгруппированные по серии.
//
// Параметры:
//  МассивНакладных - Массив из ДокументСсылка.ПриходнаяНакладная - накладные сравнения.
//
// Возвращаемое значение:
//  Соответствие - ключ серия, значение массив структур (Код, Цена, Номер, Дата).
//
&НаСервере
Функция СтрокиНакладныхПоСериям(МассивНакладных)
	
	Результат = Новый Соответствие;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Накладные", МассивНакладных);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Товары.Номенклатура.Код КАК Код,
	|	Товары.Серия КАК Серия,
	|	Товары.ВКД_ЦенаСоСкидкой КАК Цена,
	|	Товары.Ссылка.Номер КАК Номер,
	|	Товары.Ссылка.Дата КАК Дата
	|ИЗ
	|	Документ.ПриходнаяНакладная.Товары КАК Товары
	|ГДЕ
	|	Товары.Ссылка В (&Накладные)
	|	И Товары.Серия <> """"";
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		
		Серия = СокрЛП(Выборка.Серия);
		Если НЕ ЗначениеЗаполнено(Серия) Тогда
			Продолжить;
		КонецЕсли;
		
		СтрокиСерии = Результат.Получить(Серия);
		Если СтрокиСерии = Неопределено Тогда
			СтрокиСерии = Новый Массив;
			Результат.Вставить(Серия, СтрокиСерии);
		КонецЕсли;
		
		СтрокиСерии.Добавить(Новый Структура("Код, Цена, Номер, Дата",
			Выборка.Код, Выборка.Цена, Выборка.Номер, Выборка.Дата));
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// Разбирает строки табполя с кодом и сериями; ключ соответствия — серия.
//
// Возвращаемое значение:
//  Соответствие - ключ серия, значение массив структур (НомерСтроки, Код, Цена).
//
&НаСервере
Функция СтрокиТаблицыПоСериям()
	
	Результат = Новый Соответствие;
	
	Для НомерСтроки = 1 По Таблица.ВысотаТаблицы Цикл
		
		ЕстьОшибкаКода = Ложь;
		КодТовара = КодНоменклатурыИзЯчейки(
			СодержимоеЯчейкиКода(Таблица, НомерСтроки, НомерКолонкиКодТовара),
			ЕстьОшибкаКода);
		Если ЕстьОшибкаКода ИЛИ КодТовара = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		ОшибкиСерий = Новый Массив;
		СерииСтроки = СерииИзЯчейки(ТекстСерийИзЯчейки(Таблица, НомерСтроки, НомерКолонкиСерии), НомерСтроки, ОшибкиСерий);
		Если СерииСтроки.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		Цена = ПреобразоватьЧисло(ЗначениеЯчейкиТаблицы(Таблица, НомерСтроки, НомерКолонкиЦена));
		
		Для Каждого СерияСтрокой Из СерииСтроки Цикл
			
			СтрокиСерии = Результат.Получить(СерияСтрокой);
			Если СтрокиСерии = Неопределено Тогда
				СтрокиСерии = Новый Массив;
				Результат.Вставить(СерияСтрокой, СтрокиСерии);
			КонецЕсли;
			
			СтрокиСерии.Добавить(Новый Структура("НомерСтроки, Код, Цена", НомерСтроки, КодТовара, Цена));
			
		КонецЦикла;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// Формирует список ошибок сравнения для одной строки таблицы.
//
// Параметры:
//  НомерСтроки             - Число - номер строки таблицы;
//  СтрокиТаблицыПоСериям   - Соответствие - серии таблицы;
//  СтрокиНакладныхПоСериям - Соответствие - серии накладных;
//  ПриходыСерий            - Соответствие - серия → номер документа прихода (кроме текущей накладной).
//
// Возвращаемое значение:
//  Массив из Строка - тексты ошибок строки.
//
&НаСервере
Функция ОшибкиСравненияСтроки(НомерСтроки, СтрокиТаблицыПоСериям, СтрокиНакладныхПоСериям, ПриходыСерий)
	
	ОшибкиСтроки = Новый Массив;
	ДобавленныеСерии = Новый Соответствие;
	
	Для Каждого КлючИЗначение Из СтрокиТаблицыПоСериям Цикл
		
		Серия = КлючИЗначение.Ключ;
		ОписанияТаблицы = КлючИЗначение.Значение;
		
		ЕстьВЭтойСтроке = Ложь;
		КодТаблицы = Неопределено;
		ЦенаТаблицы = Неопределено;
		Для Каждого ОписаниеСтроки Из ОписанияТаблицы Цикл
			Если ОписаниеСтроки.НомерСтроки = НомерСтроки Тогда
				ЕстьВЭтойСтроке = Истина;
				КодТаблицы = ОписаниеСтроки.Код;
				ЦенаТаблицы = ОписаниеСтроки.Цена;
			КонецЕсли;
		КонецЦикла;
		
		Если НЕ ЕстьВЭтойСтроке ИЛИ ДобавленныеСерии.Получить(Серия) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		ДобавленныеСерии.Вставить(Серия, Истина);
		
		Если ОписанияТаблицы.Количество() > 1 Тогда
			ОшибкиСтроки.Добавить(СтрШаблон("серия '%1' повторяется в таблице (%2)",
				Серия, ПредставлениеНомеровСтрок(ОписанияТаблицы)));
		КонецЕсли;
		
		ОписанияНакладных = СтрокиНакладныхПоСериям.Получить(Серия);
		Если ОписанияНакладных = Неопределено Тогда
			ОшибкиСтроки.Добавить(ТекстОшибкиОтсутствияСерии(Серия, ПриходыСерий));
			Продолжить;
		КонецЕсли;
		
		Если ОписанияНакладных.Количество() > 1 Тогда
			ОшибкиСтроки.Добавить(СтрШаблон("серия '%1' встречается в накладных %2",
				Серия, ПредставлениеНакладныхСерии(ОписанияНакладных)));
			Продолжить;
		КонецЕсли;
		
		СтрокаНакладной = ОписанияНакладных[0];
		Если СтрокаНакладной.Код <> КодТаблицы Тогда
			ОшибкиСтроки.Добавить(СтрШаблон(
				"серия '%1': товар таблицы (код %2) не соответствует товару накладной (код %3)",
				Серия,
				Формат(КодТаблицы, "ЧГ=0"),
				Формат(СтрокаНакладной.Код, "ЧГ=0")));
		КонецЕсли;
		
		Если СтрокаНакладной.Цена <> ЦенаТаблицы Тогда
			ОшибкиСтроки.Добавить(СтрШаблон(
				"серия '%1': цена таблицы %2 не совпадает с ценой накладной %3",
				Серия,
				Формат(ЦенаТаблицы, "ЧН=0; ЧГ=0"),
				Формат(СтрокаНакладной.Цена, "ЧН=0; ЧГ=0")));
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат ОшибкиСтроки;
	
КонецФункции

// Серии таблицы, которых нет в выбранных накладных.
//
// Параметры:
//  СтрокиТаблицыПоСериям   - Соответствие - серии таблицы;
//  СтрокиНакладныхПоСериям - Соответствие - серии накладных.
//
// Возвращаемое значение:
//  Массив из Строка - серии без совпадения в накладных.
//
&НаСервере
Функция СерииБезНакладных(СтрокиТаблицыПоСериям, СтрокиНакладныхПоСериям)
	
	Результат = Новый Массив;
	Для Каждого КлючИЗначение Из СтрокиТаблицыПоСериям Цикл
		Если СтрокиНакладныхПоСериям.Получить(КлючИЗначение.Ключ) = Неопределено Тогда
			Результат.Добавить(КлючИЗначение.Ключ);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;
	
КонецФункции

// Ищет приход серии в регистре ОстаткиТовара, кроме движений текущей накладной.
//
// Параметры:
//  Серии - Массив из Строка - серии без совпадения в накладных сравнения.
//
// Возвращаемое значение:
//  Соответствие - серия → номер документа первого прихода.
//
&НаСервере
Функция НомераДокументовПриходаСерий(Серии)
	
	Результат = Новый Соответствие;
	Если Серии.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Серии", Серии);
	Запрос.УстановитьПараметр("ТекущийДокумент", Накладная);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	СОКРЛП(ОстаткиТовара.Партия.Серия) КАК Серия,
	|	ОстаткиТовара.Регистратор КАК Регистратор,
	|	ОстаткиТовара.Регистратор.Номер КАК НомерДокумента,
	|	ОстаткиТовара.Период КАК Период
	|ИЗ
	|	РегистрНакопления.ОстаткиТовара КАК ОстаткиТовара
	|ГДЕ
	|	ОстаткиТовара.Активность
	|	И ОстаткиТовара.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)
	|	И СОКРЛП(ОстаткиТовара.Партия.Серия) В (&Серии)
	|	И ОстаткиТовара.Регистратор <> &ТекущийДокумент
	|
	|УПОРЯДОЧИТЬ ПО
	|	Период";
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		
		Если Результат.Получить(Выборка.Серия) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		НомерДокумента = СокрЛП(Строка(Выборка.НомерДокумента));
		Если НЕ ЗначениеЗаполнено(НомерДокумента) Тогда
			НомерДокумента = Строка(Выборка.Регистратор);
		КонецЕсли;
		Результат.Вставить(Выборка.Серия, НомерДокумента);
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// Текст ошибки «серия отсутствует в накладных» с признаком более раннего прихода.
//
// Параметры:
//  Серия        - Строка - серия из таблицы;
//  ПриходыСерий - Соответствие - серия → номер документа прихода.
//
// Возвращаемое значение:
//  Строка - текст ошибки.
//
&НаСервере
Функция ТекстОшибкиОтсутствияСерии(Серия, ПриходыСерий)
	
	НомерДокумента = ПриходыСерий.Получить(Серия);
	Если ЗначениеЗаполнено(НомерДокумента) Тогда
		Возврат СтрШаблон("серия '%1' отсутствует в накладных, серия приходовалась ранее - %2",
			Серия, НомерДокумента);
	КонецЕсли;
	
	Возврат СтрШаблон("серия '%1' отсутствует в накладных, серия НЕ приходовалась ранее", Серия);
	
КонецФункции

// Собирает уникальные номера строк табполя, где встречается серия.
//
// Параметры:
//  ОписанияТаблицы - Массив из Структура - элементы с полем НомерСтроки.
//
// Возвращаемое значение:
//  Строка - «строка N» или «строки N, M».
//
&НаСервере
Функция ПредставлениеНомеровСтрок(ОписанияТаблицы)
	
	УникальныеНомера = Новый Массив;
	Для Каждого ОписаниеСтроки Из ОписанияТаблицы Цикл
		ПредставлениеНомера = Формат(ОписаниеСтроки.НомерСтроки, "ЧГ=0");
		Если УникальныеНомера.Найти(ПредставлениеНомера) = Неопределено Тогда
			УникальныеНомера.Добавить(ПредставлениеНомера);
		КонецЕсли;
	КонецЦикла;
	
	Если УникальныеНомера.Количество() = 1 Тогда
		Возврат "строка " + УникальныеНомера[0];
	КонецЕсли;
	
	Возврат "строки " + СтрСоединить(УникальныеНомера, ", ");
	
КонецФункции

// Список накладных, в которых встречается серия: «номер (дд.ММ.гггг), …».
//
// Параметры:
//  ОписанияНакладных - Массив из Структура - элементы с полями Номер, Дата.
//
// Возвращаемое значение:
//  Строка - уникальные накладные через запятую.
//
&НаСервере
Функция ПредставлениеНакладныхСерии(ОписанияНакладных)
	
	Уникальные = Новый Массив;
	Для Каждого ОписаниеНакладной Из ОписанияНакладных Цикл
		Представление = СтрШаблон("%1 (%2)",
			СокрЛП(ОписаниеНакладной.Номер),
			Формат(ОписаниеНакладной.Дата, "ДФ=dd.MM.yyyy"));
		Если Уникальные.Найти(Представление) = Неопределено Тогда
			Уникальные.Добавить(Представление);
		КонецЕсли;
	КонецЦикла;
	
	Возврат СтрСоединить(Уникальные, ", ");
	
КонецФункции


// Заполняет ТЧ Товары выбранной приходной накладной строками табличного документа.
//
// Параметры:
//  ОчищатьТовары - Булево - Истина, очистить ТЧ перед заполнением.
//
&НаСервере
Процедура ЗагрузитьНаСервере(ОчищатьТовары)
	
	Статус = "";
	
	Если НЕ ЗначениеЗаполнено(Накладная) Тогда
		СообщитьОбОшибке("Укажите приходную накладную.");
		Возврат;
	КонецЕсли;
	
	Если НомерКолонкиКодТовара < 1 Тогда
		СообщитьОбОшибке("Укажите номер колонки кода товара.");
		Возврат;
	КонецЕсли;
	
	Если Таблица.ВысотаТаблицы = 0 Тогда
		СообщитьОбОшибке("Таблица пустая.");
		Возврат;
	КонецЕсли;
	
	Если НомерКолонкиОшибки < 1 Тогда
		СообщитьОбОшибке("Укажите номер колонки ошибок.");
		Возврат;
	КонецЕсли;
	
	ОчиститьКолонкуОшибок();
	
	Ошибки = Новый Массив;
	ОшибкиПоСтрокам = Новый Соответствие;
	СтрокиТоваров = СтрокиТоваровИзТаблицы(Ошибки, ОшибкиПоСтрокам);
	ЗаписатьОшибкиЗагрузкиВТаблицу(ОшибкиПоСтрокам);
	
	Если Ошибки.Количество() > 0 Тогда
		Для Каждого ТекстОшибки Из Ошибки Цикл
			СообщитьОбОшибке(ТекстОшибки);
		КонецЦикла;
		Статус = СтрШаблон("Загрузка не выполнена. Ошибок: %1.", Ошибки.Количество());
		Возврат;
	КонецЕсли;
	
	Если СтрокиТоваров.Количество() = 0 Тогда
		ПропущеноСерий = КоличествоПропущенныхСерий(ОшибкиПоСтрокам);
		Если ПропущеноСерий > 0 Тогда
			Статус = СтрШаблон("Загрузка не выполнена. Пропущено: %1.", ПропущеноСерий);
		Иначе
			СообщитьОбОшибке("Нет строк для загрузки: в колонке кода товара нет заполненных значений.");
		КонецЕсли;
		Возврат;
	КонецЕсли;
	
	НачатьТранзакцию();
	Попытка
		
		ДокументОбъект = Накладная.ПолучитьОбъект();
		ДокументОбъект.Заблокировать();
		
		Если ОчищатьТовары Тогда
			ДокументОбъект.Товары.Очистить();
		КонецЕсли;
		ДобавитьСтрокиТоваров(ДокументОбъект, СтрокиТоваров);
		
		Если ДокументОбъект.Проведен Тогда
			ДокументОбъект.Записать(РежимЗаписиДокумента.Проведение);
		Иначе
			ДокументОбъект.Записать(РежимЗаписиДокумента.Запись);
		КонецЕсли;
		
		ЗафиксироватьТранзакцию();
		
	Исключение
		
		Если ТранзакцияАктивна() Тогда
			ОтменитьТранзакцию();
		КонецЕсли;
		
		ТекстИсключения = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		СообщитьОбОшибке(СтрШаблон("Не удалось загрузить накладную: %1", ТекстИсключения));
		Статус = "Загрузка не выполнена.";
		Возврат;
		
	КонецПопытки;
	
	ПропущеноСерий = КоличествоПропущенныхСерий(ОшибкиПоСтрокам);
	Если ПропущеноСерий = 0 Тогда
		Статус = СтрШаблон("Загружено строк: %1.", ДокументОбъект.Товары.Количество());
	Иначе
		Статус = СтрШаблон("Загружено строк: %1. Пропущено: %2.",
			ДокументОбъект.Товары.Количество(), ПропущеноСерий);
	КонецЕсли;
	
КонецПроцедуры

// Истина, если в ТЧ Товары выбранной накладной есть строки.
//
// Параметры:
//  СсылкаНакладной - ДокументСсылка.ПриходнаяНакладная - накладная.
//
// Возвращаемое значение:
//  Булево - Истина, если табличная часть не пуста.
//
&НаСервереБезКонтекста
Функция ТабличнаяЧастьНакладнойЗаполнена(СсылкаНакладной)
	
	Если НЕ ЗначениеЗаполнено(СсылкаНакладной) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Возврат СсылкаНакладной.Товары.Количество() > 0;
	
КонецФункции

// Заполняет колонку наименования 1С по коду товара в строках табличного документа.
//
&НаСервере
Процедура ВывестиНаименования1СНаСервере()
	
	Статус = "";
	
	Если НомерКолонкиКодТовара < 1 Тогда
		СообщитьОбОшибке("Укажите номер колонки кода товара.");
		Возврат;
	КонецЕсли;
	
	Если НомерКолонкиНаименование1С < 1 Тогда
		СообщитьОбОшибке("Укажите номер колонки наименования 1С.");
		Возврат;
	КонецЕсли;
	
	Если Таблица.ВысотаТаблицы = 0 Тогда
		СообщитьОбОшибке("Таблица пустая.");
		Возврат;
	КонецЕсли;
	
	Заполнено = 0;
	Ошибки = Новый Массив;
	
	Для НомерСтроки = 1 По Таблица.ВысотаТаблицы Цикл
		
		ЕстьОшибкаКода = Ложь;
		КодТовара = КодНоменклатурыИзЯчейки(
			СодержимоеЯчейкиКода(Таблица, НомерСтроки, НомерКолонкиКодТовара),
			ЕстьОшибкаКода);
		Если ЕстьОшибкаКода Тогда
			Ошибки.Добавить(СтрШаблон(
				"Строка %1: код номенклатуры не удалось преобразовать в число.",
				НомерСтроки));
			Продолжить;
		КонецЕсли;
		Если КодТовара = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		Номенклатура = Справочники.Номенклатура.НайтиПоКоду(КодТовара);
		Если НЕ ЗначениеЗаполнено(Номенклатура) Тогда
			Ошибки.Добавить(СтрШаблон("Строка %1: номенклатура с кодом %2 не найдена.",
				НомерСтроки, Формат(КодТовара, "ЧГ=0")));
			Продолжить;
		КонецЕсли;
		
		ЗаписатьТекстЯчейки(Таблица, НомерСтроки, НомерКолонкиНаименование1С, СокрЛП(Номенклатура.Наименование));
		Заполнено = Заполнено + 1;
		
	КонецЦикла;
	
	Для Каждого ТекстОшибки Из Ошибки Цикл
		СообщитьОбОшибке(ТекстОшибки);
	КонецЦикла;
	
	Если Ошибки.Количество() = 0 Тогда
		Статус = СтрШаблон("Заполнено наименований: %1.", Заполнено);
	Иначе
		Статус = СтрШаблон("Заполнено наименований: %1. Ошибок: %2.", Заполнено, Ошибки.Количество());
	КонецЕсли;
	
КонецПроцедуры

// Разбирает табличный документ в массив строк для ТЧ Товары.
// Пропущенные серии и строки без номенклатуры пишутся в колонку ошибок, загрузка остальных продолжается.
// Для каждой серии в ТЧ количество всегда 1.
//
// Параметры:
//  Ошибки           - Массив из Строка - тексты ошибок разбора, из-за которых загрузка не выполняется;
//  ОшибкиПоСтрокам  - Соответствие - номер строки таблицы → массив текстов ошибок, выводимых в колонку.
//
// Возвращаемое значение:
//  Массив из Структура - Номенклатура, Количество, Цена, Серия.
//
&НаСервере
Функция СтрокиТоваровИзТаблицы(Ошибки, ОшибкиПоСтрокам)
	
	СтрокиТоваров = Новый Массив;
	КандидатыСерий = Новый Массив;
	
	Для НомерСтроки = 1 По Таблица.ВысотаТаблицы Цикл
		
		ЕстьОшибкаКода = Ложь;
		КодТовара = КодНоменклатурыИзЯчейки(
			СодержимоеЯчейкиКода(Таблица, НомерСтроки, НомерКолонкиКодТовара),
			ЕстьОшибкаКода);
		Если ЕстьОшибкаКода Тогда
			Ошибки.Добавить(СтрШаблон(
				"Строка %1: код номенклатуры не удалось преобразовать в число.",
				НомерСтроки));
			Продолжить;
		КонецЕсли;
		Если КодТовара = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		Номенклатура = Справочники.Номенклатура.НайтиПоКоду(КодТовара);
		Если НЕ ЗначениеЗаполнено(Номенклатура) Тогда
			ДобавитьОшибкуСтрокиТаблицы(ОшибкиПоСтрокам, НомерСтроки,
				СтрШаблон("номенклатура с кодом %1 не найдена", Формат(КодТовара, "ЧГ=0")));
			Продолжить;
		КонецЕсли;
		
		Если Номенклатура.ЭтоГруппа Тогда
			Ошибки.Добавить(СтрШаблон("Строка %1: '%2' является группой номенклатуры.",
				НомерСтроки, СокрЛП(Номенклатура.Наименование)));
			Продолжить;
		КонецЕсли;
		
		Цена = ПреобразоватьЧисло(ЗначениеЯчейкиТаблицы(Таблица, НомерСтроки, НомерКолонкиЦена));
		Если Цена < 0 Тогда
			Ошибки.Добавить(СтрШаблон("Строка %1: цена не может быть отрицательной.", НомерСтроки));
			Продолжить;
		КонецЕсли;
		
		Количество = ПреобразоватьЧисло(ЗначениеЯчейкиТаблицы(Таблица, НомерСтроки, НомерКолонкиКоличество));
		Если Количество < 0 Тогда
			Ошибки.Добавить(СтрШаблон("Строка %1: количество не может быть отрицательным.", НомерСтроки));
			Продолжить;
		КонецЕсли;
		
		КоличествоОшибокДоСерий = Ошибки.Количество();
		СерииСтроки = СерииИзЯчейки(ТекстСерийИзЯчейки(Таблица, НомерСтроки, НомерКолонкиСерии), НомерСтроки, Ошибки);
		Если Ошибки.Количество() > КоличествоОшибокДоСерий Тогда
			Продолжить;
		КонецЕсли;
		
		Если СерииСтроки.Количество() > 0 Тогда
			
			Для Каждого СерияСтрокой Из СерииСтроки Цикл
				КандидатыСерий.Добавить(Новый Структура("НомерСтроки, Номенклатура, Цена, Серия",
					НомерСтроки, Номенклатура, Цена, СерияСтрокой));
			КонецЦикла;
			
		Иначе
			
			Если Количество = 0 Тогда
				Количество = 1;
			КонецЕсли;
			
			Стр = Новый Структура("Номенклатура, Количество, Цена, Серия",
				Номенклатура, Количество, Цена, "");
			СтрокиТоваров.Добавить(Стр);
			
		КонецЕсли;
		
	КонецЦикла;
	
	ДобавитьСтрокиСерийСПроверкой(СтрокиТоваров, КандидатыСерий, ОшибкиПоСтрокам);
	
	Возврат СтрокиТоваров;
	
КонецФункции

// Проверяет кандидатов с сериями: повтор в таблице, ранний приход, чужой товар.
// Пропущенные серии не добавляются в ТЧ, тексты ошибок копятся по строкам таблицы.
//
// Параметры:
//  СтрокиТоваров    - Массив из Структура - принимаемые строки загрузки;
//  КандидатыСерий   - Массив из Структура - НомерСтроки, Номенклатура, Цена, Серия;
//  ОшибкиПоСтрокам  - Соответствие - номер строки → массив текстов ошибок.
//
&НаСервере
Процедура ДобавитьСтрокиСерийСПроверкой(СтрокиТоваров, КандидатыСерий, ОшибкиПоСтрокам)
	
	Если КандидатыСерий.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Серии = Новый Массив;
	Для Каждого Кандидат Из КандидатыСерий Цикл
		Если Серии.Найти(Кандидат.Серия) = Неопределено Тогда
			Серии.Добавить(Кандидат.Серия);
		КонецЕсли;
	КонецЦикла;
	
	ДокументыПрихода = ДокументыПриходаСерий(Серии);
	ПартииПоСериям = ПартииПоСериям(Серии);
	ПервыеСтрокиСерий = Новый Соответствие;
	
	Для Каждого Кандидат Из КандидатыСерий Цикл
		
		ОшибкиСерии = Новый Массив;
		
		ПерваяСтрока = ПервыеСтрокиСерий.Получить(Кандидат.Серия);
		Если ПерваяСтрока = Неопределено Тогда
			ПервыеСтрокиСерий.Вставить(Кандидат.Серия, Кандидат.НомерСтроки);
		Иначе
			ОшибкиСерии.Добавить(СтрШаблон("есть в таблице, строка %1", Формат(ПерваяСтрока, "ЧГ=0")));
		КонецЕсли;
		
		ДокументПрихода = ДокументыПрихода.Получить(Кандидат.Серия);
		Если ДокументПрихода <> Неопределено Тогда
			ОшибкиСерии.Добавить(СтрШаблон("приходовалось ранее %1 (%2)",
				СокрЛП(ДокументПрихода.Номер),
				Формат(ДокументПрихода.Дата, "ДФ=dd.MM.yyyy")));
		КонецЕсли;
		
		ТекстЧужогоТовара = ТекстОшибкиЧужогоТовараСерии(Кандидат.Серия, Кандидат.Номенклатура, ПартииПоСериям);
		Если ЗначениеЗаполнено(ТекстЧужогоТовара) Тогда
			ОшибкиСерии.Добавить(ТекстЧужогоТовара);
		КонецЕсли;
		
		Если ОшибкиСерии.Количество() > 0 Тогда
			ДобавитьОшибкуСтрокиТаблицы(ОшибкиПоСтрокам, Кандидат.НомерСтроки, СтрСоединить(ОшибкиСерии, "; "));
			Продолжить;
		КонецЕсли;
		
		Стр = Новый Структура("Номенклатура, Количество, Цена, Серия",
			Кандидат.Номенклатура, 1, Кандидат.Цена, Кандидат.Серия);
		СтрокиТоваров.Добавить(Стр);
		
	КонецЦикла;
	
КонецПроцедуры

// Ищет первый приход серии документом ПриходнаяНакладная, кроме текущей накладной формы.
//
// Параметры:
//  Серии - Массив из Строка - серии кандидатов загрузки.
//
// Возвращаемое значение:
//  Соответствие - серия → структура с полями Номер, Дата.
//
&НаСервере
Функция ДокументыПриходаСерий(Серии)
	
	Результат = Новый Соответствие;
	Если Серии.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Серии", Серии);
	Запрос.УстановитьПараметр("ТекущийДокумент", Накладная);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	СОКРЛП(ОстаткиТовара.Партия.Серия) КАК Серия,
	|	ОстаткиТовара.Регистратор.Номер КАК НомерДокумента,
	|	ОстаткиТовара.Регистратор.Дата КАК ДатаДокумента,
	|	ОстаткиТовара.Период КАК Период
	|ИЗ
	|	РегистрНакопления.ОстаткиТовара КАК ОстаткиТовара
	|ГДЕ
	|	ОстаткиТовара.Активность
	|	И ОстаткиТовара.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)
	|	И ОстаткиТовара.Регистратор ССЫЛКА Документ.ПриходнаяНакладная
	|	И СОКРЛП(ОстаткиТовара.Партия.Серия) В (&Серии)
	|	И ОстаткиТовара.Регистратор <> &ТекущийДокумент
	|
	|УПОРЯДОЧИТЬ ПО
	|	Период";
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		
		Если Результат.Получить(Выборка.Серия) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		Результат.Вставить(Выборка.Серия, Новый Структура("Номер, Дата",
			Выборка.НомерДокумента, Выборка.ДатаДокумента));
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// Собирает партии по сериям: владельцы (номенклатура) без пометки удаления.
//
// Параметры:
//  Серии - Массив из Строка - серии кандидатов загрузки.
//
// Возвращаемое значение:
//  Соответствие - серия → массив структур (Номенклатура, Наименование, Код).
//
&НаСервере
Функция ПартииПоСериям(Серии)
	
	Результат = Новый Соответствие;
	Если Серии.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Серии", Серии);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	СОКРЛП(Партии.Серия) КАК Серия,
	|	Партии.Владелец КАК Номенклатура,
	|	Партии.Владелец.Наименование КАК Наименование,
	|	Партии.Владелец.Код КАК Код
	|ИЗ
	|	Справочник.Партии КАК Партии
	|ГДЕ
	|	СОКРЛП(Партии.Серия) В (&Серии)
	|	И Партии.Серия <> """"
	|	И НЕ Партии.ПометкаУдаления
	|
	|СГРУППИРОВАТЬ ПО
	|	СОКРЛП(Партии.Серия),
	|	Партии.Владелец,
	|	Партии.Владелец.Наименование,
	|	Партии.Владелец.Код";
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		
		Владельцы = Результат.Получить(Выборка.Серия);
		Если Владельцы = Неопределено Тогда
			Владельцы = Новый Массив;
			Результат.Вставить(Выборка.Серия, Владельцы);
		КонецЕсли;
		
		Владельцы.Добавить(Новый Структура("Номенклатура, Наименование, Код",
			Выборка.Номенклатура, Выборка.Наименование, Выборка.Код));
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// Текст ошибки, если серия уже есть в справочнике партий у другой номенклатуры.
//
// Параметры:
//  Серия            - Строка - серия из таблицы;
//  Номенклатура     - СправочникСсылка.Номенклатура - товар строки таблицы;
//  ПартииПоСериям   - Соответствие - серия → массив владельцев партий.
//
// Возвращаемое значение:
//  Строка - текст ошибки или пустая строка.
//
&НаСервере
Функция ТекстОшибкиЧужогоТовараСерии(Серия, Номенклатура, ПартииПоСериям)
	
	Владельцы = ПартииПоСериям.Получить(Серия);
	Если Владельцы = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	
	Для Каждого ВладелецПартии Из Владельцы Цикл
		Если ВладелецПартии.Номенклатура <> Номенклатура Тогда
			Возврат СтрШаблон("серия принадлежит товару %1 (%2)",
				СокрЛП(ВладелецПартии.Наименование),
				Формат(ВладелецПартии.Код, "ЧГ=0"));
		КонецЕсли;
	КонецЦикла;
	
	Возврат "";
	
КонецФункции

// Добавляет текст ошибки пропущенной серии в соответствие по номеру строки таблицы.
//
// Параметры:
//  ОшибкиПоСтрокам - Соответствие - номер строки → массив строк;
//  НомерСтроки     - Число - номер строки таблицы;
//  ТекстОшибки     - Строка - текст ошибки серии.
//
&НаСервере
Процедура ДобавитьОшибкуСтрокиТаблицы(ОшибкиПоСтрокам, НомерСтроки, ТекстОшибки)
	
	ОшибкиСтроки = ОшибкиПоСтрокам.Получить(НомерСтроки);
	Если ОшибкиСтроки = Неопределено Тогда
		ОшибкиСтроки = Новый Массив;
		ОшибкиПоСтрокам.Вставить(НомерСтроки, ОшибкиСтроки);
	КонецЕсли;
	
	ОшибкиСтроки.Добавить(ТекстОшибки);
	
КонецПроцедуры

// Записывает ошибки пропущенных серий в колонку ошибок таблицы.
//
// Параметры:
//  ОшибкиПоСтрокам - Соответствие - номер строки → массив текстов ошибок.
//
&НаСервере
Процедура ЗаписатьОшибкиЗагрузкиВТаблицу(ОшибкиПоСтрокам)
	
	Для Каждого КлючИЗначение Из ОшибкиПоСтрокам Цикл
		ЗаписатьТекстЯчейки(Таблица, КлючИЗначение.Ключ, НомерКолонкиОшибки,
			СтрСоединить(КлючИЗначение.Значение, "; "));
	КонецЦикла;
	
КонецПроцедуры

// Количество записей об ошибках, выведенных в колонку таблицы.
//
// Параметры:
//  ОшибкиПоСтрокам - Соответствие - номер строки → массив текстов ошибок.
//
// Возвращаемое значение:
//  Число - сколько ошибок записано в колонку.
//
&НаСервере
Функция КоличествоПропущенныхСерий(ОшибкиПоСтрокам)
	
	Результат = 0;
	Для Каждого КлючИЗначение Из ОшибкиПоСтрокам Цикл
		Результат = Результат + КлючИЗначение.Значение.Количество();
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// Добавляет строки в ТЧ Товары и создаёт партии.
//
// Параметры:
//  ДокументОбъект - ДокументОбъект.ПриходнаяНакладная - заполняемый документ;
//  СтрокиТоваров  - Массив из Структура - Номенклатура, Количество, Цена, Серия.
//
&НаСервере
Процедура ДобавитьСтрокиТоваров(ДокументОбъект, СтрокиТоваров)
	
	Для Каждого СтрТовара Из СтрокиТоваров Цикл
		
		Партия = НайтиИлиСоздатьПартию(
			ДокументОбъект.Ссылка,
			СтрТовара.Номенклатура,
			СтрТовара.Цена,
			СтрТовара.Серия,
			ДокументОбъект.Валюта,
			ДокументОбъект.Дата,
			ДокументОбъект.Фирма,
			ДокументОбъект.Контрагент);
		
		НовСтр = ДокументОбъект.Товары.Добавить();
		НовСтр.Номенклатура = СтрТовара.Номенклатура;
		НовСтр.Партия = Партия;
		НовСтр.Серия = СтрТовара.Серия;
		НовСтр.Количество = СтрТовара.Количество;
		НовСтр.ЦенаЗакупки = СтрТовара.Цена;
		НовСтр.СуммаЗакупки = СтрТовара.Цена * СтрТовара.Количество;
		НовСтр.ВКД_ЦенаСоСкидкой = СтрТовара.Цена;
		НовСтр.ВКД_СуммаСоСкидкой = НовСтр.СуммаЗакупки;
		НовСтр.ВКД_ЦенаСЗатратами = СтрТовара.Цена;
		НовСтр.ВКД_СуммаСЗатратами = НовСтр.СуммаЗакупки;
		
	КонецЦикла;
	
КонецПроцедуры

// Ищет партию по номенклатуре и серии среди партий накладной; при отсутствии создаёт новую.
//
// Параметры:
//  СсылкаДокумента - ДокументСсылка.ПриходнаяНакладная - накладная;
//  Номенклатура    - СправочникСсылка.Номенклатура - номенклатура;
//  Цена            - Число - цена закупки;
//  Серия           - Строка - серия;
//  Валюта          - СправочникСсылка.Валюты - валюта документа;
//  Дата            - Дата - дата документа;
//  Фирма           - СправочникСсылка.Фирмы - фирма документа;
//  Контрагент      - СправочникСсылка.Контрагенты - поставщик.
//
// Возвращаемое значение:
//  СправочникСсылка.Партии - найденная или созданная партия.
//
&НаСервере
Функция НайтиИлиСоздатьПартию(СсылкаДокумента, Номенклатура, Цена, Серия, Валюта, Дата, Фирма, Контрагент)
	
	Партия = НайтиПартию(СсылкаДокумента, Номенклатура, Серия);
	Если ЗначениеЗаполнено(Партия) Тогда
		Возврат Партия;
	КонецЕсли;
	
	Возврат СоздатьПартию(СсылкаДокумента, Номенклатура, Цена, Серия, Валюта, Дата, Фирма, Контрагент);
	
КонецФункции

// Ищет партию накладной по номенклатуре и серии (без пометки удаления — в приоритете).
//
// Параметры:
//  СсылкаДокумента - ДокументСсылка.ПриходнаяНакладная - накладная;
//  Номенклатура    - СправочникСсылка.Номенклатура - номенклатура;
//  Серия           - Строка - серия.
//
// Возвращаемое значение:
//  СправочникСсылка.Партии - найденная партия или пустая ссылка.
//
&НаСервере
Функция НайтиПартию(СсылкаДокумента, Номенклатура, Серия)
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
	Запрос.УстановитьПараметр("Серия", Серия);
	Запрос.УстановитьПараметр("Док", СсылкаДокумента);
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Партии.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.Партии КАК Партии
	|ГДЕ
	|	Партии.Владелец = &Номенклатура
	|	И Партии.Серия = &Серия
	|	И Партии.Док = &Док
	|
	|УПОРЯДОЧИТЬ ПО
	|	Партии.ПометкаУдаления";
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;
	
	Возврат Справочники.Партии.ПустаяСсылка();
	
КонецФункции

// Создаёт элемент справочника Партии для строки приходной накладной.
//
// Параметры:
//  СсылкаДокумента - ДокументСсылка.ПриходнаяНакладная - владелец партии;
//  Номенклатура    - СправочникСсылка.Номенклатура - номенклатура;
//  Цена            - Число - цена закупки;
//  Серия           - Строка - серия;
//  Валюта          - СправочникСсылка.Валюты - валюта документа;
//  Дата            - Дата - дата документа;
//  Фирма           - СправочникСсылка.Фирмы - фирма документа;
//  Контрагент      - СправочникСсылка.Контрагенты - поставщик.
//
// Возвращаемое значение:
//  СправочникСсылка.Партии - созданная партия.
//
&НаСервере
Функция СоздатьПартию(СсылкаДокумента, Номенклатура, Цена, Серия, Валюта, Дата, Фирма, Контрагент)
	
	ПартияОбъект = Справочники.Партии.СоздатьЭлемент();
	ПартияОбъект.Владелец = Номенклатура;
	ПартияОбъект.Док = СсылкаДокумента;
	ПартияОбъект.Наименование = "ПН_" + Лев(гоМгновение(Дата), 8);
	ПартияОбъект.Контрагент = Контрагент;
	ПартияОбъект.ЦенаЗакупки = Цена;
	ПартияОбъект.Валюта = Валюта;
	ПартияОбъект.ДатаПартии = НачалоДня(Дата);
	ПартияОбъект.Фирма = Фирма;
	ПартияОбъект.Серия = Серия;
	ПартияОбъект.ВКД_ЦенаСоСкидкой = Цена;
	ПартияОбъект.ЦенаЗакупкиВБазВалюте = РаботаСВалютой.Пересчитать2025(
		Цена, Валюта, ПараметрыСеанса.БазоваяВалюта, Фирма, Дата);
	ПартияОбъект.Записать();
	
	Возврат ПартияОбъект.Ссылка;
	
КонецФункции

// Возвращает видимый текст ячейки серий (не типизированное значение).
// Нужно, чтобы список «серия, серия» не схлопывался в одно число.
//
// Параметры:
//  ТабличныйДокумент - ТабличныйДокумент - источник;
//  НомерСтроки       - Число - номер строки (1-based);
//  НомерКолонки      - Число - номер колонки (1-based).
//
// Возвращаемое значение:
//  Строка - текст ячейки.
//
&НаСервере
Функция ТекстСерийИзЯчейки(ТабличныйДокумент, НомерСтроки, НомерКолонки)
	
	Если НомерКолонки < 1 ИЛИ НомерСтроки < 1 Тогда
		Возврат "";
	КонецЕсли;
	Если НомерСтроки > ТабличныйДокумент.ВысотаТаблицы
		ИЛИ НомерКолонки > ТабличныйДокумент.ШиринаТаблицы Тогда
		Возврат "";
	КонецЕсли;
	
	Область = ТабличныйДокумент.Область(НомерСтроки, НомерКолонки, НомерСтроки, НомерКолонки);
	Текст = СокрЛП(Область.Текст);
	Если ЗначениеЗаполнено(Текст) Тогда
		Возврат Текст;
	КонецЕсли;
	
	Если Область.СодержитЗначение И ЗначениеЗаполнено(Область.Значение) Тогда
		Если ТипЗнч(Область.Значение) = Тип("Число") Тогда
			Возврат Формат(Область.Значение, "ЧГ=0");
		КонецЕсли;
		Возврат СокрЛП(Строка(Область.Значение));
	КонецЕсли;
	
	Возврат "";
	
КонецФункции

// Разбирает ячейку серий: несколько значений через запятую (запятая и пробел тоже).
//
// Параметры:
//  ТекстСерий   - Строка - содержимое ячейки;
//  НомерСтроки  - Число - номер строки таблицы;
//  Ошибки       - Массив из Строка - тексты ошибок.
//
// Возвращаемое значение:
//  Массив из Строка - серии.
//
&НаСервере
Функция СерииИзЯчейки(ТекстСерий, НомерСтроки, Ошибки)
	
	Результат = Новый Массив;
	Если НЕ ЗначениеЗаполнено(ТекстСерий) Тогда
		Возврат Результат;
	КонецЕсли;
	
	НормализованныйТекст = СтрЗаменить(ТекстСерий, Символы.ПС, ",");
	НормализованныйТекст = СтрЗаменить(НормализованныйТекст, Символы.ВК, ",");
	Части = СтрРазделить(НормализованныйТекст, ",", Ложь);
	Для Каждого Часть Из Части Цикл
		
		СерияСтрокой = СокрЛП(Часть);
		Если НЕ ЗначениеЗаполнено(СерияСтрокой) Тогда
			Продолжить;
		КонецЕсли;
		
		Если СтрДлина(СерияСтрокой) > 30 Тогда
			Ошибки.Добавить(СтрШаблон(
				"Строка %1: серия '%2' длиннее 30 символов.",
				НомерСтроки,
				СерияСтрокой));
			Продолжить;
		КонецЕсли;
		
		Результат.Добавить(СерияСтрокой);
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// Возвращает содержимое ячейки кода: сначала видимый текст (с пробелами между цифрами), затем значение.
//
// Параметры:
//  ТабличныйДокумент - ТабличныйДокумент - источник;
//  НомерСтроки       - Число - номер строки (1-based);
//  НомерКолонки      - Число - номер колонки (1-based).
//
// Возвращаемое значение:
//  Произвольный, Неопределено - текст, число или Неопределено, если ячейка пустая.
//
&НаСервере
Функция СодержимоеЯчейкиКода(ТабличныйДокумент, НомерСтроки, НомерКолонки)
	
	Если НомерКолонки < 1 ИЛИ НомерСтроки < 1 Тогда
		Возврат Неопределено;
	КонецЕсли;
	Если НомерСтроки > ТабличныйДокумент.ВысотаТаблицы
		ИЛИ НомерКолонки > ТабличныйДокумент.ШиринаТаблицы Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Область = ТабличныйДокумент.Область(НомерСтроки, НомерКолонки, НомерСтроки, НомерКолонки);
	Текст = СокрЛП(Область.Текст);
	Если ЗначениеЗаполнено(Текст) Тогда
		Возврат Текст;
	КонецЕсли;
	
	Если Область.СодержитЗначение И ЗначениеЗаполнено(Область.Значение) Тогда
		Возврат Область.Значение;
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции

// Записывает текст в ячейку табличного документа.
//
// Параметры:
//  ТабличныйДокумент - ТабличныйДокумент - таблица;
//  НомерСтроки       - Число - номер строки (1-based);
//  НомерКолонки      - Число - номер колонки (1-based);
//  Текст             - Строка - записываемый текст.
//
&НаСервере
Процедура ЗаписатьТекстЯчейки(ТабличныйДокумент, НомерСтроки, НомерКолонки, Текст)
	
	Область = ТабличныйДокумент.Область(НомерСтроки, НомерКолонки, НомерСтроки, НомерКолонки);
	Область.СодержитЗначение = Ложь;
	Область.Текст = Текст;
	
КонецПроцедуры

// Преобразует значение ячейки в числовой код номенклатуры.
// Пробелы и неразрывные пробелы удаляются, затем значение приводится к числу.
//
// Параметры:
//  ЗначениеЯчейки          - Произвольный, Неопределено - значение из таблицы;
//  ЕстьОшибкаПреобразования - Булево - Истина, если непустое значение нельзя привести к числу.
//
// Возвращаемое значение:
//  Число, Неопределено - код номенклатуры; Неопределено, если ячейка пустая.
//
&НаСервере
Функция КодНоменклатурыИзЯчейки(ЗначениеЯчейки, ЕстьОшибкаПреобразования)
	
	ЕстьОшибкаПреобразования = Ложь;
	
	Если ЗначениеЯчейки = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Если ТипЗнч(ЗначениеЯчейки) = Тип("Число") Тогда
		Возврат ЗначениеЯчейки;
	КонецЕсли;
	
	Текст = СокрЛП(Строка(ЗначениеЯчейки));
	Текст = СтрЗаменить(Текст, Символ(160), "");
	Текст = СтрЗаменить(Текст, " ", "");
	Если НЕ ЗначениеЗаполнено(Текст) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Попытка
		Возврат Число(Текст);
	Исключение
		ЕстьОшибкаПреобразования = Истина;
		Возврат Неопределено;
	КонецПопытки;
	
КонецФункции

// Возвращает значение ячейки табличного документа.
//
// Параметры:
//  ТабличныйДокумент - ТабличныйДокумент - источник;
//  НомерСтроки       - Число - номер строки (1-based);
//  НомерКолонки      - Число - номер колонки (1-based).
//
// Возвращаемое значение:
//  Произвольный, Неопределено - значение ячейки или Неопределено для пустой ячейки.
//
&НаСервере
Функция ЗначениеЯчейкиТаблицы(ТабличныйДокумент, НомерСтроки, НомерКолонки)
	
	Если НомерКолонки < 1 ИЛИ НомерСтроки < 1 Тогда
		Возврат Неопределено;
	КонецЕсли;
	Если НомерСтроки > ТабличныйДокумент.ВысотаТаблицы
		ИЛИ НомерКолонки > ТабличныйДокумент.ШиринаТаблицы Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Область = ТабличныйДокумент.Область(НомерСтроки, НомерКолонки, НомерСтроки, НомерКолонки);
	Если Область.СодержитЗначение Тогда
		Возврат Область.Значение;
	КонецЕсли;
	
	Текст = СокрЛП(Область.Текст);
	Если НЕ ЗначениеЗаполнено(Текст) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Возврат Текст;
	
КонецФункции

// Преобразует значение ячейки в число.
//
// Параметры:
//  ЗначениеЯчейки - Произвольный - значение из таблицы.
//
// Возвращаемое значение:
//  Число - числовое значение, 0 если пусто или не удалось преобразовать.
//
&НаСервере
Функция ПреобразоватьЧисло(ЗначениеЯчейки)
	
	Если ЗначениеЯчейки = Неопределено Тогда
		Возврат 0;
	КонецЕсли;
	
	Если ТипЗнч(ЗначениеЯчейки) = Тип("Число") Тогда
		Возврат ЗначениеЯчейки;
	КонецЕсли;
	
	Текст = СокрЛП(Строка(ЗначениеЯчейки));
	Текст = СтрЗаменить(Текст, Символ(160), "");
	Текст = СтрЗаменить(Текст, " ", "");
	Текст = СтрЗаменить(Текст, ",", ".");
	Если НЕ ЗначениеЗаполнено(Текст) Тогда
		Возврат 0;
	КонецЕсли;
	
	Отрицательное = Ложь;
	Если Лев(Текст, 1) = "(" И Прав(Текст, 1) = ")" Тогда
		Отрицательное = Истина;
		Текст = Сред(Текст, 2, СтрДлина(Текст) - 2);
	ИначеЕсли Лев(Текст, 1) = "-" Тогда
		Отрицательное = Истина;
		Текст = Сред(Текст, 2);
	КонецЕсли;
	
	Попытка
		ЧислоЗначение = Число(Текст);
		Возврат ?(Отрицательное, -ЧислоЗначение, ЧислоЗначение);
	Исключение
		Возврат 0;
	КонецПопытки;
	
КонецФункции

// Выводит сообщение пользователю.
//
// Параметры:
//  Текст - Строка - текст сообщения.
//
&НаСервере
Процедура СообщитьОбОшибке(Текст)
	
	Сообщение = Новый СообщениеПользователю;
	Сообщение.Текст = Текст;
	Сообщение.Сообщить();
	
КонецПроцедуры

#КонецОбласти
