#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	// Лист «Серийные номера» отчёта Яндекс.Маркет (вставка с колонки A, строка данных — с 3-й).
	Если КолонкаДата = 0 Тогда
		КолонкаДата = 5;
	КонецЕсли;
	Если КолонкаНомерВходящий = 0 Тогда
		КолонкаНомерВходящий = 1;
	КонецЕсли;
	Если КолонкаКоличество = 0 Тогда
		КолонкаКоличество = 3;
	КонецЕсли;
	Если КолонкаСерия = 0 Тогда
		КолонкаСерия = 6;
	КонецЕсли;
	Если КолонкаЦена = 0 Тогда
		КолонкаЦена = 7;
	КонецЕсли;
	Если КолонкаТовар = 0 Тогда
		КолонкаТовар = 4;
	КонецЕсли;
	// Лист «Отчёт о платежном поручении» (вставка с колонки A, строка данных — с 3-й).
	Если КолонкаПлатежиНомерВходящий = 0 Тогда
		КолонкаПлатежиНомерВходящий = 8;
	КонецЕсли;
	Если КолонкаПлатежиТовар = 0 Тогда
		КолонкаПлатежиТовар = 13;
	КонецЕсли;
	Если КолонкаПлатежиКоличество = 0 Тогда
		КолонкаПлатежиКоличество = 15;
	КонецЕсли;
	Если КолонкаПлатежиСуммаДоллар = 0 Тогда
		КолонкаПлатежиСуммаДоллар = 16;
	КонецЕсли;
	Если КолонкаПлатежиСуммаРубль = 0 Тогда
		КолонкаПлатежиСуммаРубль = 17;
	КонецЕсли;
	
	Если СерийныеНомера.ВысотаТаблицы = 0 Тогда
		СерийныеНомера.Область(1, 1, 1, 1).Текст = "";
	КонецЕсли;
	Если Платежи.ВысотаТаблицы = 0 Тогда
		Платежи.Область(1, 1, 1, 1).Текст = "";
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	УстановитьПодсказкуВводаОтчетаКомиссионера();
КонецПроцедуры

#КонецОбласти


#Область ОбработчикиСобытийЭлементов

&НаКлиенте
Процедура ВалютаПриИзменении(Элемент)
	УстановитьПодсказкуВводаОтчетаКомиссионера();
КонецПроцедуры
              
&НаКлиенте
Процедура УстановитьПодсказкуВводаОтчетаКомиссионера()

	Элементы.ОтчетКомиссионера.ПодсказкаВвода = "будет создан новый (" + Валюта + ")";	

КонецПроцедуры

#КонецОбласти


#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ТолькоПоиск(Команда)
	
	ТекстИтога = ТолькоПоискНаСервере();
	ПоказатьПредупреждение(, ТекстИтога);
	
КонецПроцедуры

&НаКлиенте
Процедура Импорт(Команда)
	
	РезультатИмпорта = ИмпортНаСервере();
	ПоказатьИтогИмпорта(РезультатИмпорта);
	
КонецПроцедуры

&НаКлиенте
Процедура ПоказатьИтогИмпорта(РезультатИмпорта)
	
	ТекстСообщения = СтрШаблон("Документов создано %1, перезаполнено %2.",
		РезультатИмпорта.Создано, РезультатИмпорта.Перезаполнено);
	
	Если ЗначениеЗаполнено(РезультатИмпорта.ОтчетКомиссионера) Тогда
		ТекстСообщения = СтрШаблон("%1%2Отчёт комиссионера: %3",
			ТекстСообщения, Символы.ПС, РезультатИмпорта.ОтчетКомиссионера);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(РезультатИмпорта.ОшибкиИдентификации) Тогда
		ТекстСообщения = СтрШаблон("%1%2%2%3",
			ТекстСообщения, Символы.ПС, РезультатИмпорта.ОшибкиИдентификации);
	КонецЕсли;
	
	ПоказатьПредупреждение(, ТекстСообщения);
	
КонецПроцедуры

#КонецОбласти


#Область ОбработчикиСобытийЭлементовТаблицыФормыРезультат

// Открывает документ из колонки результата по гиперссылке.
//
&НаКлиенте
Процедура РезультатВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	Если Поле.Имя = "РезультатЗаказ" Тогда
		СтандартнаяОбработка = Ложь;
		Если ЗначениеЗаполнено(Элемент.ТекущиеДанные.Заказ) Тогда
			ПоказатьЗначение(, Элемент.ТекущиеДанные.Заказ);
		КонецЕсли;
	ИначеЕсли Поле.Имя = "РезультатРасходнаяНакладная" Тогда
		СтандартнаяОбработка = Ложь;
		Если ЗначениеЗаполнено(Элемент.ТекущиеДанные.РасходнаяНакладная) Тогда
			ПоказатьЗначение(, Элемент.ТекущиеДанные.РасходнаяНакладная);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти


#Область СлужебныеПроцедурыИФункции

&НаСервере
Функция ИмпортНаСервере()
	
	РезультатИмпорта = Новый Структура(
		"Создано, Перезаполнено, ОшибкиИдентификации, ОтчетКомиссионера",
		0, 0, "",
		Документы.ОтчетКомиссионера.ПустаяСсылка());
	
	Результат.Очистить();
	Статус = "";
	
	ТекстОшибки = ПроверитьНастройкиИмпорта();
	Если ЗначениеЗаполнено(ТекстОшибки) Тогда
		Статус = ТекстОшибки;
		РезультатИмпорта.ОшибкиИдентификации = ТекстОшибки;
		Возврат РезультатИмпорта;
	КонецЕсли;
	
	СтрокиИмпорта = РазобратьСерийныеНомера();
	Если СтрокиИмпорта.Количество() = 0 Тогда
		Статус = "Нет строк для импорта.";
		Возврат РезультатИмпорта;
	КонецЕсли;
	
	ОшибкиИдентификации = СобратьОшибкиИдентификации(СтрокиИмпорта);
	Если ОшибкиИдентификации.Количество() > 0 Тогда
		РезультатИмпорта.ОшибкиИдентификации = СтрСоединить(ОшибкиИдентификации, Символы.ПС);
	КонецЕсли;
	
	ОшибкиПлатежей = Новый Массив;
	ДанныеПлатежей = РазобратьПлатежи(ОшибкиПлатежей);
	Если ОшибкиПлатежей.Количество() > 0 Тогда
		ТекстОшибокПлатежей = СтрСоединить(ОшибкиПлатежей, Символы.ПС);
		Если ЗначениеЗаполнено(РезультатИмпорта.ОшибкиИдентификации) Тогда
			РезультатИмпорта.ОшибкиИдентификации = СтрШаблон("%1%2%3",
				РезультатИмпорта.ОшибкиИдентификации, Символы.ПС, ТекстОшибокПлатежей);
		Иначе
			РезультатИмпорта.ОшибкиИдентификации = ТекстОшибокПлатежей;
		КонецЕсли;
	КонецЕсли;
	
	ГруппыЗаказов = СгруппироватьСтрокиПоЗаказам(СтрокиИмпорта);
	СтрокиСОшибками = СтрокиСОшибкамиИдентификации(СтрокиИмпорта);
	ЗаказыОтчета = Новый Массив;
	
	Для Каждого ГруппаЗаказа Из ГруппыЗаказов Цикл
		
		СтрокаРезультата = Результат.Добавить();
		СтрокаРезультата.НомерВходящий = ГруппаЗаказа.НомерВходящий;
		СтрокаРезультата.Дата = ГруппаЗаказа.Дата;
		СтрокаРезультата.Заказ = НайтиИнвойсПродажиПоНомеруВходящему(
			ГруппаЗаказа.НомерВходящий, ГруппаЗаказа.Контрагент);
		
		Если ГруппаСодержитСтрокуСОшибкой(ГруппаЗаказа, СтрокиСОшибками) Тогда
			ОшибкиГруппы = ОшибкиСерийГруппыЗаказа(ГруппаЗаказа);
			СтрокаРезультата.Ошибка = ?(ОшибкиГруппы.Количество() > 0,
				СтрСоединить(ОшибкиГруппы, "; "),
				"Ошибка идентификации строк заказа.");
			ЗаполнитьСтатусыПроведенияСтрокиРезультата(СтрокаРезультата);
			Продолжить;
		КонецЕсли;
		
		Попытка
			РезультатЗаказа = СоздатьДокументыПоЗаказу(ГруппаЗаказа, СтрокаРезультата, ДанныеПлатежей);
			Если РезультатЗаказа.Перезаполнено Тогда
				РезультатИмпорта.Перезаполнено = РезультатИмпорта.Перезаполнено + 1;
			ИначеЕсли РезультатЗаказа.Записано Тогда
				РезультатИмпорта.Создано = РезультатИмпорта.Создано + 1;
			КонецЕсли;
			Если РезультатЗаказа.ВключитьВОтчет Тогда
				ЗаказыОтчета.Добавить(Новый Структура("ГруппаЗаказа, Накладная, СтрокаРезультата",
					ГруппаЗаказа, РезультатЗаказа.Накладная, СтрокаРезультата));
			КонецЕсли;
		Исключение
			СтрокаРезультата.Ошибка = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		КонецПопытки;
		
		ЗаполнитьСтатусыПроведенияСтрокиРезультата(СтрокаРезультата);
		
	КонецЦикла;
	
	Если ЗаказыОтчета.Количество() > 0 Тогда
		Попытка
			РезультатИмпорта.ОтчетКомиссионера = ЗаписатьСводныйОтчетКомиссионера(ЗаказыОтчета, ДанныеПлатежей);
		Исключение
			ТекстОшибкиОтчета = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
			Если ЗначениеЗаполнено(РезультатИмпорта.ОшибкиИдентификации) Тогда
				РезультатИмпорта.ОшибкиИдентификации = СтрШаблон("%1%2%3",
					РезультатИмпорта.ОшибкиИдентификации, Символы.ПС, ТекстОшибкиОтчета);
			Иначе
				РезультатИмпорта.ОшибкиИдентификации = ТекстОшибкиОтчета;
			КонецЕсли;
		КонецПопытки;
	КонецЕсли;
	
	Статус = СтрШаблон("Документов создано %1, перезаполнено %2.",
		РезультатИмпорта.Создано, РезультатИмпорта.Перезаполнено);
	Если ЗначениеЗаполнено(РезультатИмпорта.ОтчетКомиссионера) Тогда
		Статус = СтрШаблон("%1 Отчёт комиссионера: %2", Статус, РезультатИмпорта.ОтчетКомиссионера);
	КонецЕсли;
	
	Возврат РезультатИмпорта;
	
КонецФункции

// Ищет существующие заказ и расходную накладную без записи документов.
//
// Возвращаемое значение:
//  Строка - текст итога поиска.
//
&НаСервере
Функция ТолькоПоискНаСервере()
	
	Результат.Очистить();
	Статус = "";
	
	Если НЕ ЗначениеЗаполнено(Контрагент) Тогда
		ТекстОшибки = "Не указан контрагент.";
		Статус = ТекстОшибки;
		Возврат ТекстОшибки;
	КонецЕсли;
	
	СтрокиИмпорта = РазобратьСерийныеНомера();
	Если СтрокиИмпорта.Количество() = 0 Тогда
		Статус = "Нет строк для поиска.";
		Возврат Статус;
	КонецЕсли;
	
	ГруппыЗаказов = СгруппироватьСтрокиПоЗаказам(СтрокиИмпорта);
	
	НайденоЗаказов = 0;
	НайденоНакладных = 0;
	Для Каждого ГруппаЗаказа Из ГруппыЗаказов Цикл
		
		СтрокаРезультата = Результат.Добавить();
		СтрокаРезультата.НомерВходящий = ГруппаЗаказа.НомерВходящий;
		СтрокаРезультата.Дата = ГруппаЗаказа.Дата;
		ЗаполнитьСтрокуРезультатаНайденнымиДокументами(ГруппаЗаказа, СтрокаРезультата);
		ЗаполнитьСтатусыПроведенияСтрокиРезультата(СтрокаРезультата);
		
		Если ЗначениеЗаполнено(СтрокаРезультата.Заказ) Тогда
			НайденоЗаказов = НайденоЗаказов + 1;
		КонецЕсли;
		Если ЗначениеЗаполнено(СтрокаРезультата.РасходнаяНакладная) Тогда
			НайденоНакладных = НайденоНакладных + 1;
		КонецЕсли;
		
	КонецЦикла;
	
	Статус = СтрШаблон("Найдено заказов: %1, расходных накладных: %2.",
		НайденоЗаказов,
		НайденоНакладных);
	
	Возврат Статус;
	
КонецФункции

// Заполняет строку результата найденными документами и текстом о недостающих.
//
// Параметры:
//  ГруппаЗаказа     - Структура - данные заказа из серийных номеров;
//  СтрокаРезультата - СтрокаТаблицыЗначений - строка таблицы Результат.
//
&НаСервере
Процедура ЗаполнитьСтрокуРезультатаНайденнымиДокументами(ГруппаЗаказа, СтрокаРезультата)
	
	СтрокаРезультата.Заказ = НайтиИнвойсПродажиПоНомеруВходящему(
		ГруппаЗаказа.НомерВходящий, ГруппаЗаказа.Контрагент);
	СтрокаРезультата.РасходнаяНакладная = НайтиРасходнуюНакладную(
		ГруппаЗаказа.НомерВходящий, ГруппаЗаказа.Контрагент, ГруппаЗаказа.Дата);
	
	НеНайдено = ОшибкиСерийГруппыЗаказа(ГруппаЗаказа);
	Если НЕ ЗначениеЗаполнено(СтрокаРезультата.Заказ) Тогда
		НеНайдено.Добавить("не найден заказ");
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(СтрокаРезультата.РасходнаяНакладная) Тогда
		НеНайдено.Добавить("не найдена расходная накладная");
	КонецЕсли;
	Если НеНайдено.Количество() > 0 Тогда
		СтрокаРезультата.Ошибка = СтрСоединить(НеНайдено, "; ");
	КонецЕсли;
	
КонецПроцедуры

// Заполняет индексы картинок состояния документов в строке результата.
//
// Параметры:
//  СтрокаРезультата - СтрокаТаблицыЗначений - строка таблицы Результат.
//
&НаСервере
Процедура ЗаполнитьСтатусыПроведенияСтрокиРезультата(СтрокаРезультата)
	
	СтрокаРезультата.ЗаказСтатусПроведения = ОбщегоНазначенияСервер.СтатусПроведения(СтрокаРезультата.Заказ);
	СтрокаРезультата.РасходнаяНакладнаяСтатусПроведения = ОбщегоНазначенияСервер.СтатусПроведения(
		СтрокаРезультата.РасходнаяНакладная);
	
КонецПроцедуры

// Проверяет заполненность настроек импорта.
//
// Возвращаемое значение:
//  Строка - текст ошибки или пустая строка.
//
&НаСервере
Функция ПроверитьНастройкиИмпорта()
	
	Если НЕ ЗначениеЗаполнено(Контрагент) Тогда
		Возврат "Не указан контрагент.";
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(Валюта) Тогда
		Возврат "Не указана валюта.";
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(Склад) Тогда
		Возврат "Не указан склад.";
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(СтатьяОтчетаПродажи) Тогда
		Возврат "Не указана статья отчета продажи.";
	КонецЕсли;
	
	Возврат "";
	
КонецФункции

// Разбирает табличный документ серийных номеров в массив структур строк импорта.
//
// Возвращаемое значение:
//  Массив из Структура - строки импорта.
//
&НаСервере
Функция РазобратьСерийныеНомера()
	
	РезультатРазбора = Новый Массив;
	
	Для НомерСтроки = 1 По СерийныеНомера.ВысотаТаблицы Цикл
		
		Серия = СокрЛП(ТекстЯчейкиТаблицы(СерийныеНомера, НомерСтроки, КолонкаСерия));
		Если НЕ ЗначениеЗаполнено(Серия) Тогда
			Продолжить;
		КонецЕсли;
		
		Партия = НайтиПартиюПоСерии(Серия);
		Номенклатура = Справочники.Номенклатура.ПустаяСсылка();
		Если ЗначениеЗаполнено(Партия) Тогда
			Номенклатура = Партия.Владелец;
		КонецЕсли;
		
		СтрокаИмпорта = Новый Структура;
		СтрокаИмпорта.Вставить("НомерСтроки", НомерСтроки);
		Если ЗначениеЗаполнено(Дата) Тогда
			СтрокаИмпорта.Вставить("Дата", Дата);
		Иначе
			СтрокаИмпорта.Вставить("Дата", ПреобразоватьДату(ЗначениеЯчейкиТаблицы(СерийныеНомера, НомерСтроки, КолонкаДата)));
		КонецЕсли;
		СтрокаИмпорта.Вставить("НомерВходящий", СокрЛП(ТекстЯчейкиТаблицы(СерийныеНомера, НомерСтроки, КолонкаНомерВходящий)));
		СтрокаИмпорта.Вставить("Количество", ПреобразоватьКоличество(ЗначениеЯчейкиТаблицы(СерийныеНомера, НомерСтроки, КолонкаКоличество)));
		СтрокаИмпорта.Вставить("Серия", Серия);
		СтрокаИмпорта.Вставить("Цена", ПреобразоватьЦену(ЗначениеЯчейкиТаблицы(СерийныеНомера, НомерСтроки, КолонкаЦена)));
		СтрокаИмпорта.Вставить("Товар", СокрЛП(ТекстЯчейкиТаблицы(СерийныеНомера, НомерСтроки, КолонкаТовар)));
		СтрокаИмпорта.Вставить("Контрагент", Контрагент);
		СтрокаИмпорта.Вставить("Партия", Партия);
		СтрокаИмпорта.Вставить("Номенклатура", Номенклатура);
		
		РезультатРазбора.Добавить(СтрокаИмпорта);
		
	КонецЦикла;
	
	Возврат РезультатРазбора;
	
КонецФункции

// Разбирает табличный документ платежей.
// Товарные строки (количество > 0): ключ Товар + "|" + НомерВходящий; дубли — ошибка.
// Строки без количества: суммируются в КомиссияПоЗаказам по колонке суммы в долларах.
//
// Параметры:
//  Ошибки - Массив из Строка - накопитель текстов ошибок.
//
// Возвращаемое значение:
//  Структура - Товары (Соответствие), КомиссияПоЗаказам (Соответствие).
//
&НаСервере
Функция РазобратьПлатежи(Ошибки)
	
	РезультатРазбора = Новый Структура("Товары, КомиссияПоЗаказам",
		Новый Соответствие, Новый Соответствие);
	
	Для НомерСтроки = 1 По Платежи.ВысотаТаблицы Цикл
		
		Товар = СокрЛП(ТекстЯчейкиТаблицы(Платежи, НомерСтроки, КолонкаПлатежиТовар));
		НомерВходящий = СокрЛП(ТекстЯчейкиТаблицы(Платежи, НомерСтроки, КолонкаПлатежиНомерВходящий));
		Если НЕ ЗначениеЗаполнено(НомерВходящий) Тогда
			Продолжить;
		КонецЕсли;
		
		Количество = ПреобразоватьКоличество(ЗначениеЯчейкиТаблицы(Платежи, НомерСтроки, КолонкаПлатежиКоличество));
		СуммаДоллар = ПреобразоватьЦену(ЗначениеЯчейкиТаблицы(Платежи, НомерСтроки, КолонкаПлатежиСуммаДоллар));
		СуммаРубль = ПреобразоватьЦену(ЗначениеЯчейкиТаблицы(Платежи, НомерСтроки, КолонкаПлатежиСуммаРубль));
		
		Если Количество <= 0 Тогда
			Если СуммаДоллар <> 0 Тогда
				НакопленнаяКомиссия = РезультатРазбора.КомиссияПоЗаказам.Получить(НомерВходящий);
				Если НакопленнаяКомиссия = Неопределено Тогда
					НакопленнаяКомиссия = 0;
				КонецЕсли;
				РезультатРазбора.КомиссияПоЗаказам.Вставить(НомерВходящий, НакопленнаяКомиссия + СуммаДоллар);
			КонецЕсли;
			Продолжить;
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(Товар) Тогда
			Продолжить;
		КонецЕсли;
		
		Ключ = КлючПлатежа(Товар, НомерВходящий);
		Существующее = РезультатРазбора.Товары.Получить(Ключ);
		Если Существующее = Неопределено Тогда
			РезультатРазбора.Товары.Вставить(Ключ, Новый Структура(
				"Товар, НомерВходящий, Количество, СуммаДоллар, СуммаРубль, ЕстьОшибка",
				Товар, НомерВходящий, Количество, СуммаДоллар, СуммаРубль, Ложь));
		Иначе
			Существующее.ЕстьОшибка = Истина;
			Ошибки.Добавить(СтрШаблон(
				"Платежи, строка %1: дубль ключа товар+номер входящий (%2 / %3).",
				НомерСтроки, Товар, НомерВходящий));
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат РезультатРазбора;
	
КонецФункции

// Формирует ключ поиска строки платежей.
//
// Параметры:
//  Товар         - Строка - наименование товара из отчёта;
//  НомерВходящий - Строка - номер заказа.
//
// Возвращаемое значение:
//  Строка - ключ соответствия.
//
&НаСервере
Функция КлючПлатежа(Товар, НомерВходящий)
	
	Возврат СтрШаблон("%1|%2", Товар, НомерВходящий);
	
КонецФункции

// Создаёт и записывает заказ и расходную накладную по группе заказа.
// Отчёт комиссионера сюда не входит: он один на весь импорт.
//
// Параметры:
//  ГруппаЗаказа     - Структура - данные заказа;
//  СтрокаРезультата - СтрокаТаблицыЗначений - строка таблицы результата;
//  ДанныеПлатежей   - Структура - Товары, КомиссияПоЗаказам.
//
// Возвращаемое значение:
//  Структура - Перезаполнено, Записано, ВключитьВОтчет (Булево), Накладная (ДокументСсылка.РасходнаяНакладная).
//
&НаСервере
Функция СоздатьДокументыПоЗаказу(ГруппаЗаказа, СтрокаРезультата, ДанныеПлатежей)
	
	РезультатЗаказа = Новый Структура("Перезаполнено, Записано, ВключитьВОтчет, Накладная",
		Ложь, Ложь, Ложь, Документы.РасходнаяНакладная.ПустаяСсылка());
	
	ТекстОшибки = ПроверитьГруппуЗаказа(ГруппаЗаказа);
	Если ЗначениеЗаполнено(ТекстОшибки) Тогда
		СтрокаРезультата.Ошибка = ТекстОшибки;
		Возврат РезультатЗаказа;
	КонецЕсли;
	
	ТекстОшибки = ПроверитьПлатежиГруппы(ГруппаЗаказа, ДанныеПлатежей.Товары);
	Если ЗначениеЗаполнено(ТекстОшибки) Тогда
		СтрокаРезультата.Ошибка = ТекстОшибки;
		Возврат РезультатЗаказа;
	КонецЕсли;
	
	ИнвойсПродажи = СтрокаРезультата.Заказ;
	СуществующаяНакладная = НайтиРасходнуюНакладную(
		ГруппаЗаказа.НомерВходящий, ГруппаЗаказа.Контрагент, ГруппаЗаказа.Дата);
	
	Если ЗначениеЗаполнено(СуществующаяНакладная) И НЕ ПерезаполнятьСуществующие Тогда
		СтрокаРезультата.Ошибка = СтрШаблон("Уже существует расходная накладная %1 (заказ %2).",
			СуществующаяНакладная, ГруппаЗаказа.НомерВходящий);
		СтрокаРезультата.РасходнаяНакладная = СуществующаяНакладная;
		РезультатЗаказа.Накладная = СуществующаяНакладная;
		РезультатЗаказа.ВключитьВОтчет = Истина;
		Возврат РезультатЗаказа;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(СуществующаяНакладная) Тогда
		ОтменитьПроведениеРасходнойНакладной(СуществующаяНакладная);
	КонецЕсли;
	
	ПерезаполнятьИнвойс = ЗначениеЗаполнено(ИнвойсПродажи) И ПерезаполнятьСуществующие;
	Если ПерезаполнятьИнвойс Тогда
		ОтменитьПроведениеДокумента(ИнвойсПродажи);
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(ИнвойсПродажи) Тогда
		ИнвойсОбъект = Документы.ИнвойсПродажи.СоздатьДокумент();
	ИначеЕсли ПерезаполнятьИнвойс Тогда
		ИнвойсОбъект = ИнвойсПродажи.ПолучитьОбъект();
		РезультатЗаказа.Перезаполнено = Истина;
	Иначе
		ИнвойсОбъект = Неопределено;
	КонецЕсли;
	
	Если ИнвойсОбъект <> Неопределено Тогда
		ЗаполнитьИнвойсПродажи(ИнвойсОбъект, ГруппаЗаказа);
		ЗаписатьДокумент(ИнвойсОбъект);
		ИнвойсПродажи = ИнвойсОбъект.Ссылка;
		СтрокаРезультата.Заказ = ИнвойсПродажи;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(СуществующаяНакладная) Тогда
		НакладнаяОбъект = СуществующаяНакладная.ПолучитьОбъект();
		РезультатЗаказа.Перезаполнено = Истина;
	Иначе
		НакладнаяОбъект = Документы.РасходнаяНакладная.СоздатьДокумент();
	КонецЕсли;
	
	ЗаполнитьРасходнуюНакладную(НакладнаяОбъект, ГруппаЗаказа, ИнвойсПродажи);
	ЗаписатьДокумент(НакладнаяОбъект);
	СтрокаРезультата.РасходнаяНакладная = НакладнаяОбъект.Ссылка;
	РезультатЗаказа.Накладная = НакладнаяОбъект.Ссылка;
	РезультатЗаказа.ВключитьВОтчет = Истина;
	РезультатЗаказа.Записано = Истина;
	
	Возврат РезультатЗаказа;
	
КонецФункции

// Проверяет отсутствие дублей ключей платежей для строк группы заказа.
//
// Параметры:
//  ГруппаЗаказа   - Структура - данные заказа;
//  ПлатежиПоКлючу - Соответствие - строки платежей по товару.
//
// Возвращаемое значение:
//  Строка - текст ошибки или пустая строка.
//
&НаСервере
Функция ПроверитьПлатежиГруппы(ГруппаЗаказа, ПлатежиПоКлючу)
	
	ПроверенныеКлючи = Новый Соответствие;
	Для Каждого СтрокаИмпорта Из ГруппаЗаказа.Строки Цикл
		
		Если НЕ ЗначениеЗаполнено(СтрокаИмпорта.Товар) Тогда
			Продолжить;
		КонецЕсли;
		
		Ключ = КлючПлатежа(СтрокаИмпорта.Товар, ГруппаЗаказа.НомерВходящий);
		Если ПроверенныеКлючи.Получить(Ключ) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		ПроверенныеКлючи.Вставить(Ключ, Истина);
		
		ДанныеПлатежа = ПлатежиПоКлючу.Получить(Ключ);
		Если ДанныеПлатежа <> Неопределено И ДанныеПлатежа.ЕстьОшибка Тогда
			Возврат СтрШаблон(
				"В платежах несколько строк с ключом товар+номер входящий (%1 / %2).",
				СтрокаИмпорта.Товар, ГруппаЗаказа.НомерВходящий);
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат "";
	
КонецФункции

// Отменяет проведение документа, если он проведён.
//
// Параметры:
//  СсылкаДокумента - ДокументСсылка - документ.
//
&НаСервере
Процедура ОтменитьПроведениеДокумента(СсылкаДокумента)
	
	Если НЕ ЗначениеЗаполнено(СсылкаДокумента) Или НЕ СсылкаДокумента.Проведен Тогда
		Возврат;
	КонецЕсли;
	
	ДокументОбъект = СсылкаДокумента.ПолучитьОбъект();
	ДокументОбъект.Записать(РежимЗаписиДокумента.ОтменаПроведения);
	
КонецПроцедуры

// Снимает флаг Окончательно, очищает товары и отменяет проведение расходной накладной.
// Иначе отмена проведения запрещена модулем документа.
//
// Параметры:
//  СсылкаДокумента - ДокументСсылка.РасходнаяНакладная - документ.
//
&НаСервере
Процедура ОтменитьПроведениеРасходнойНакладной(СсылкаДокумента)
	
	Если НЕ ЗначениеЗаполнено(СсылкаДокумента) Тогда
		Возврат;
	КонецЕсли;
	
	ДокументОбъект = СсылкаДокумента.ПолучитьОбъект();
	ДокументОбъект.Окончательно = Ложь;
	ДокументОбъект.Товары.Очистить();
	Если ДокументОбъект.Проведен Тогда
		ДокументОбъект.Записать(РежимЗаписиДокумента.ОтменаПроведения);
	Иначе
		ДокументОбъект.Записать(РежимЗаписиДокумента.Запись);
	КонецЕсли;
	
КонецПроцедуры

// Записывает документ с учётом флага проведения.
//
// Параметры:
//  ДокументОбъект - ДокументОбъект - записываемый документ.
//
&НаСервере
Процедура ЗаписатьДокумент(ДокументОбъект)
	
	РежимЗаписи = ?(Проводить, РежимЗаписиДокумента.Проведение, РежимЗаписиДокумента.Запись);
	ДокументОбъект.Записать(РежимЗаписи);
	
КонецПроцедуры

// Проверяет корректность данных группы заказа.
//
// Параметры:
//  ГруппаЗаказа - Структура - данные заказа.
//
// Возвращаемое значение:
//  Строка - текст ошибки или пустая строка.
//
&НаСервере
Функция ПроверитьГруппуЗаказа(ГруппаЗаказа)
	
	Если НЕ ЗначениеЗаполнено(ГруппаЗаказа.НомерВходящий) Тогда
		Возврат "Не заполнен номер входящий.";
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(ГруппаЗаказа.Контрагент) Тогда
		Возврат "Не указан контрагент.";
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(ГруппаЗаказа.Дата) Тогда
		Возврат СтрШаблон("Не удалось определить дату заказа %1.", ГруппаЗаказа.НомерВходящий);
	КонецЕсли;
	
	ОшибкиСтрок = Новый Массив;
	Для Каждого СтрокаИмпорта Из ГруппаЗаказа.Строки Цикл
		
		Если СтрокаИмпорта.Количество <= 0 Тогда
			ОшибкиСтрок.Добавить(СтрШаблон("строка %1: некорректное количество", СтрокаИмпорта.НомерСтроки));
		КонецЕсли;
		
	КонецЦикла;
	
	Если ОшибкиСтрок.Количество() > 0 Тогда
		Возврат СтрСоединить(ОшибкиСтрок, "; ");
	КонецЕсли;
	
	Возврат "";
	
КонецФункции

// Заполняет заказ (ИнвойсПродажи) по строкам серийных номеров.
//
// Параметры:
//  ИнвойсОбъект - ДокументОбъект.ИнвойсПродажи - заполняемый документ;
//  ГруппаЗаказа - Структура - данные заказа.
//
&НаСервере
Процедура ЗаполнитьИнвойсПродажи(ИнвойсОбъект, ГруппаЗаказа)
	
	Если ИнвойсОбъект.ЭтоНовый() Тогда
		ИнвойсОбъект.Дата = ДатаСоВременем(ГруппаЗаказа.Дата, 9, 0);
	Иначе
		ИнвойсОбъект.Дата = ГруппаЗаказа.Дата;
	КонецЕсли;
	ИнвойсОбъект.ПометкаУдаления = Ложь;
	ИнвойсОбъект.Фирма = гоФирма();
	ИнвойсОбъект.Контрагент = ГруппаЗаказа.Контрагент;
	ИнвойсОбъект.Валюта = Валюта;
	ИнвойсОбъект.Склад = Склад;
	ИнвойсОбъект.НомерВходящий = ГруппаЗаказа.НомерВходящий;
	ИнвойсОбъект.Проформа = Перечисления.ВидыИнвойса.ЗаказКомиссионера;
	ИнвойсОбъект.РезервироватьТовар = Ложь;
	ИнвойсОбъект.ДатаОтгрузки = НачалоДня(ИнвойсОбъект.Дата);
	ИнвойсОбъект.Товары.Очистить();
	
	Для Каждого СтрокаИмпорта Из ГруппаЗаказа.Строки Цикл
		
		НоваяСтрока = ИнвойсОбъект.Товары.Добавить();
		НоваяСтрока.Номенклатура = СтрокаИмпорта.Номенклатура;
		НоваяСтрока.Количество = СтрокаИмпорта.Количество;
		НоваяСтрока.Цена = СтрокаИмпорта.Цена;
		НоваяСтрока.Сумма = НоваяСтрока.Количество * НоваяСтрока.Цена;
		НоваяСтрока.ЦенаКомитента = НоваяСтрока.Цена;
		НоваяСтрока.СуммаКомитента = НоваяСтрока.Сумма;
		
	КонецЦикла;
	
КонецПроцедуры

// Заполняет расходную накладную (комиссия) по строкам серийных номеров заказа.
//
// Параметры:
//  НакладнаяОбъект - ДокументОбъект.РасходнаяНакладная - заполняемый документ;
//  ГруппаЗаказа    - Структура - данные заказа;
//  ИнвойсПродажи - ДокументСсылка.ИнвойсПродажи - заказ по номеру входящему.
//
&НаСервере
Процедура ЗаполнитьРасходнуюНакладную(НакладнаяОбъект, ГруппаЗаказа, ИнвойсПродажи)
	
	Если НакладнаяОбъект.ЭтоНовый() Тогда
		НакладнаяОбъект.Дата = ДатаСоВременем(ГруппаЗаказа.Дата, 9, 30);
	Иначе
		НакладнаяОбъект.Дата = ГруппаЗаказа.Дата;
	КонецЕсли;
	НакладнаяОбъект.Фирма = гоФирма();
	НакладнаяОбъект.Контрагент = ГруппаЗаказа.Контрагент;
	НакладнаяОбъект.Склад = Склад;
	НакладнаяОбъект.Комиссия = Истина;
	НакладнаяОбъект.СкладКомиссии = ГруппаЗаказа.Контрагент.СкладКомиссии;
	НакладнаяОбъект.Валюта = Валюта;
	НакладнаяОбъект.ДокументОснование = ИнвойсПродажи;
	НакладнаяОбъект.Примечание = ГруппаЗаказа.НомерВходящий;
	НакладнаяОбъект.Окончательно = Проводить;
	НакладнаяОбъект.Товары.Очистить();
	
	Для Каждого СтрокаИмпорта Из ГруппаЗаказа.Строки Цикл
		
		НоваяСтрока = НакладнаяОбъект.Товары.Добавить();
		НоваяСтрока.Номенклатура = СтрокаИмпорта.Номенклатура;
		НоваяСтрока.Партия = СтрокаИмпорта.Партия;
		Если ЗначениеЗаполнено(СтрокаИмпорта.Партия) Тогда
			НоваяСтрока.Серия = СтрокаИмпорта.Партия.Серия;
		Иначе
			НоваяСтрока.Серия = СтрокаИмпорта.Серия;
		КонецЕсли;
		НоваяСтрока.Количество = СтрокаИмпорта.Количество;
		НоваяСтрока.ЦенаПродажи = СтрокаИмпорта.Цена;
		НоваяСтрока.СуммаПродажи = НоваяСтрока.Количество * НоваяСтрока.ЦенаПродажи;
		
	КонецЦикла;
	
КонецПроцедуры

// Создаёт или перезаполняет один ОтчетКомиссионера по всем заказам импорта.
// Пустая ссылка на форме — новый документ, заполненная — перезаполнение выбранного.
// Сумма комиссии заказа пишется в Товары.СуммаКомиссии (со знаком минус, как раньше в шапке).
// Если у заказа несколько строк, сумма делится пропорционально Сумме, остаток — на последнюю строку.
// Шапка СуммаКомиссии — итог табличной части: проведение читает сумму из шапки.
//
// Параметры:
//  ЗаказыОтчета   - Массив из Структура - ГруппаЗаказа, Накладная, СтрокаРезультата;
//  ДанныеПлатежей - Структура - Товары, КомиссияПоЗаказам.
//
// Возвращаемое значение:
//  ДокументСсылка.ОтчетКомиссионера - записанный документ.
//
&НаСервере
Функция ЗаписатьСводныйОтчетКомиссионера(ЗаказыОтчета, ДанныеПлатежей)
	
	Если ЗначениеЗаполнено(ОтчетКомиссионера) Тогда
		ОтменитьПроведениеДокумента(ОтчетКомиссионера);
		ОтчетОбъект = ОтчетКомиссионера.ПолучитьОбъект();
		Если ОтчетОбъект = Неопределено Тогда
			ВызватьИсключение "Выбранный отчёт комиссионера не найден.";
		КонецЕсли;
	Иначе
		ОтчетОбъект = Документы.ОтчетКомиссионера.СоздатьДокумент();
	КонецЕсли;
	
	ЗаполнитьШапкуСводногоОтчета(ОтчетОбъект, ДатаСводногоОтчета(ЗаказыОтчета));
	ОтчетОбъект.Товары.Очистить();
	
	Для Каждого ЗаказОтчета Из ЗаказыОтчета Цикл
		
		ГруппаЗаказа = ЗаказОтчета.ГруппаЗаказа;
		СуммаКомиссии = ДанныеПлатежей.КомиссияПоЗаказам.Получить(ГруппаЗаказа.НомерВходящий);
		Если СуммаКомиссии = Неопределено Тогда
			СуммаКомиссии = 0;
		КонецЕсли;
		
		ОшибкиОтчета = Новый Массив;
		ИндексНачала = ОтчетОбъект.Товары.Количество();
		ДобавитьСтрокиЗаказаВОтчетКомиссионера(
			ОтчетОбъект, ГруппаЗаказа, ДанныеПлатежей.Товары, ЗаказОтчета.Накладная,
			ЗаказОтчета.СтрокаРезультата.Заказ, ОшибкиОтчета);
		ИндексКонца = ОтчетОбъект.Товары.Количество() - 1;
		
		Если ИндексКонца < ИндексНачала Тогда
			Если СуммаКомиссии <> 0 Тогда
				ОшибкиОтчета.Добавить(СтрШаблон(
					"заказ %1: комиссия не попала в отчёт, нет строк товаров",
					ГруппаЗаказа.НомерВходящий));
			КонецЕсли;
		Иначе
			РаспределитьСуммуКомиссииЗаказа(ОтчетОбъект.Товары, ИндексНачала, ИндексКонца, СуммаКомиссии);
		КонецЕсли;
		
		Если ОшибкиОтчета.Количество() > 0 Тогда
			ТекстОшибок = СтрСоединить(ОшибкиОтчета, "; ");
			Если ЗначениеЗаполнено(ЗаказОтчета.СтрокаРезультата.Ошибка) Тогда
				ЗаказОтчета.СтрокаРезультата.Ошибка = СтрШаблон("%1; %2",
					ЗаказОтчета.СтрокаРезультата.Ошибка, ТекстОшибок);
			Иначе
				ЗаказОтчета.СтрокаРезультата.Ошибка = ТекстОшибок;
			КонецЕсли;
		КонецЕсли;
		
	КонецЦикла;
	
	ОтчетОбъект.СуммаКомиссии = ОтчетОбъект.Товары.Итог("СуммаКомиссии");
	ЗаписатьДокумент(ОтчетОбъект);
	ОтчетКомиссионера = ОтчетОбъект.Ссылка;
	Возврат ОтчетОбъект.Ссылка;
	
КонецФункции

// Дата сводного отчёта: реквизит формы Дата, иначе самая поздняя дата заказов импорта.
//
// Параметры:
//  ЗаказыОтчета - Массив из Структура - группы заказов, поле ГруппаЗаказа.Дата.
//
// Возвращаемое значение:
//  Дата - день документа без времени.
//
&НаСервере
Функция ДатаСводногоОтчета(ЗаказыОтчета)
	
	Если ЗначениеЗаполнено(Дата) Тогда
		Возврат Дата;
	КонецЕсли;
	
	ДатаОтчета = '00010101';
	Для Каждого ЗаказОтчета Из ЗаказыОтчета Цикл
		Если ЗаказОтчета.ГруппаЗаказа.Дата > ДатаОтчета Тогда
			ДатаОтчета = ЗаказОтчета.ГруппаЗаказа.Дата;
		КонецЕсли;
	КонецЦикла;
	
	Возврат ДатаОтчета;
	
КонецФункции

// Заполняет шапку сводного отчёта комиссионера. Документ-основание не заполняется:
// в одном документе строки нескольких заказов.
//
// Параметры:
//  ОтчетОбъект - ДокументОбъект.ОтчетКомиссионера - заполняемый документ;
//  ДатаОтчета  - Дата - день документа.
//
&НаСервере
Процедура ЗаполнитьШапкуСводногоОтчета(ОтчетОбъект, ДатаОтчета)
	
	Если НЕ ЗначениеЗаполнено(ДатаОтчета) Тогда
		ДатаОтчета = ТекущаяДатаСеанса();
	КонецЕсли;
	
	ОтчетОбъект.Дата = ДатаСоВременем(ДатаОтчета, 10, 0);
	ОтчетОбъект.ПометкаУдаления = Ложь;
	ОтчетОбъект.ВидОперации = Перечисления.ВидыОперацииОтчетКомиссионера.Продажа;
	ОтчетОбъект.Фирма = гоФирма();
	ОтчетОбъект.Контрагент = Контрагент;
	ОтчетОбъект.СкладКомиссии = Склад;
	ОтчетОбъект.Валюта = Валюта;
	ОтчетОбъект.Статья = СтатьяОтчетаПродажи;
	ОтчетОбъект.ВалютаКомиссии = гоПараметрСеанса("БазоваяВалюта");
	ОтчетОбъект.СтатьяКомиссии = СтатьяОтчетаПродажи;
	ОтчетОбъект.ДокументОснование = Документы.ИнвойсПродажи.ПустаяСсылка();
	
	Если ОтчетОбъект.Валюта = ОтчетОбъект.ВалютаКомиссии Тогда
		ОтчетОбъект.Курс = 1;
	Иначе
		ОтчетОбъект.Курс = РаботаСВалютой.Курс(ОтчетОбъект.Валюта, ОтчетОбъект.Дата, ОтчетОбъект.Фирма);
	КонецЕсли;
	
КонецПроцедуры

// Добавляет в сводный отчёт строки, товар которых есть и в серийных номерах, и в платежах этого заказа.
// Серия берётся из серийных номеров. Строка только одного листа в отчёт не попадает.
// Цена и Сумма — из расходной накладной, количество — из серийного номера.
// ЦенаОтчета — из платежа того же товара: в рублях, если валюта документа совпадает с валютой учёта, иначе в долларах.
//
// Параметры:
//  ОтчетОбъект      - ДокументОбъект.ОтчетКомиссионера - приемник строк;
//  ГруппаЗаказа     - Структура - данные заказа;
//  ПлатежиПоКлючу   - Соответствие - товарные строки платежей;
//  Накладная        - ДокументСсылка.РасходнаяНакладная - цены продажи;
//  Заказ            - ДокументСсылка.ИнвойсПродажи - заказ строки;
//  ОшибкиЗаполнения - Массив из Строка - накопитель ошибок.
//
&НаСервере
Процедура ДобавитьСтрокиЗаказаВОтчетКомиссионера(ОтчетОбъект, ГруппаЗаказа, ПлатежиПоКлючу,
	Накладная, Заказ, ОшибкиЗаполнения)
	
	ДокументВРублях = (Валюта = гоПараметрСеанса("валюта"));
	
	Для Каждого СтрокаСерии Из ГруппаЗаказа.Строки Цикл
		
		ДанныеПлатежа = ПлатежиПоКлючу.Получить(КлючПлатежа(СтрокаСерии.Товар, ГруппаЗаказа.НомерВходящий));
		Если ДанныеПлатежа = Неопределено Или ДанныеПлатежа.ЕстьОшибка Тогда
			Продолжить;
		КонецЕсли;
		
		СтрокаНакладной = НайтиСтрокуРасходнойНакладной(Накладная, СтрокаСерии);
		Если СтрокаНакладной = Неопределено Тогда
			ОшибкиЗаполнения.Добавить(СтрШаблон(
				"товар %1: не найдена строка в расходной накладной (серия %2)",
				СтрокаСерии.Товар, СтрокаСерии.Серия));
			Продолжить;
		КонецЕсли;
		
		НоваяСтрока = ОтчетОбъект.Товары.Добавить();
		НоваяСтрока.Заказ = Заказ;
		НоваяСтрока.Номенклатура = СтрокаСерии.Номенклатура;
		НоваяСтрока.Партия = СтрокаСерии.Партия;
		Если ЗначениеЗаполнено(СтрокаСерии.Партия) Тогда
			НоваяСтрока.Серия = СтрокаСерии.Партия.Серия;
		Иначе
			НоваяСтрока.Серия = СтрокаСерии.Серия;
		КонецЕсли;
		НоваяСтрока.Количество = СтрокаСерии.Количество;
		НоваяСтрока.Цена = СтрокаНакладной.ЦенаПродажи;
		НоваяСтрока.Сумма = НоваяСтрока.Цена * НоваяСтрока.Количество;
		НоваяСтрока.ЦенаОтчета = ЦенаОтчетаПоПлатежу(ДанныеПлатежа, ДокументВРублях);
		
	КонецЦикла;
	
КонецПроцедуры

// Цена отчёта единицы товара: сумма платежа той же пары товар+заказ, делённая на количество платежа.
//
// Параметры:
//  ДанныеПлатежа   - Структура - строка платежей (СуммаДоллар, СуммаРубль, Количество);
//  ДокументВРублях - Булево - брать сумму в рублях.
//
// Возвращаемое значение:
//  Число - цена отчёта.
//
&НаСервере
Функция ЦенаОтчетаПоПлатежу(ДанныеПлатежа, ДокументВРублях)
	
	СуммаПлатежа = ?(ДокументВРублях, ДанныеПлатежа.СуммаРубль, ДанныеПлатежа.СуммаДоллар);
	Если ДанныеПлатежа.Количество > 0 Тогда
		Возврат СуммаПлатежа / ДанныеПлатежа.Количество;
	КонецЕсли;
	
	Возврат СуммаПлатежа;
	
КонецФункции

// Раскладывает комиссию заказа по строкам табличной части со знаком минус.
// База распределения — Сумма строки. Последняя строка получает остаток от округления.
//
// Параметры:
//  Товары              - ТабличнаяЧасть - Товары отчёта комиссионера;
//  ИндексНачала        - Число - первая строка заказа;
//  ИндексКонца         - Число - последняя строка заказа;
//  СуммаКомиссииЗаказа - Число - комиссия заказа из платежей (USD, без знака).
//
&НаСервере
Процедура РаспределитьСуммуКомиссииЗаказа(Товары, ИндексНачала, ИндексКонца, СуммаКомиссииЗаказа)
	
	СуммаКРаспределению = -СуммаКомиссииЗаказа;
	КоличествоСтрок = ИндексКонца - ИндексНачала + 1;
	Если КоличествоСтрок = 1 Или СуммаКРаспределению = 0 Тогда
		Товары[ИндексНачала].СуммаКомиссии = СуммаКРаспределению;
		Возврат;
	КонецЕсли;
	
	База = 0;
	Для Индекс = ИндексНачала По ИндексКонца Цикл
		База = База + Товары[Индекс].Сумма;
	КонецЦикла;
	Если База = 0 Тогда
		Товары[ИндексНачала].СуммаКомиссии = СуммаКРаспределению;
		Возврат;
	КонецЕсли;
	
	Распределено = 0;
	Для Индекс = ИндексНачала По ИндексКонца - 1 Цикл
		Доля = Окр(СуммаКРаспределению * Товары[Индекс].Сумма / База, 2);
		Товары[Индекс].СуммаКомиссии = Доля;
		Распределено = Распределено + Доля;
	КонецЦикла;
	Товары[ИндексКонца].СуммаКомиссии = СуммаКРаспределению - Распределено;
	
КонецПроцедуры

// Ищет строку РасходнаяНакладная.Товары по партии или паре номенклатура + серия.
//
// Параметры:
//  НакладнаяОбъект - ДокументОбъект.РасходнаяНакладная;
//  СтрокаСерии     - Структура - строка импорта (Партия, Серия, Номенклатура).
//
// Возвращаемое значение:
//  СтрокаТабличнойЧасти, Неопределено - строка накладной или Неопределено.
//
&НаСервере
Функция НайтиСтрокуРасходнойНакладной(НакладнаяОбъект, СтрокаСерии)
	
	Если ЗначениеЗаполнено(СтрокаСерии.Партия) Тогда
		Для Каждого СтрокаНакладной Из НакладнаяОбъект.Товары Цикл
			Если СтрокаНакладной.Партия = СтрокаСерии.Партия Тогда
				Возврат СтрокаНакладной;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	СерияСтрокой = СокрЛП(СтрокаСерии.Серия);
	Для Каждого СтрокаНакладной Из НакладнаяОбъект.Товары Цикл
		Если СтрокаНакладной.Номенклатура = СтрокаСерии.Номенклатура
			И СокрЛП(СтрокаНакладной.Серия) = СерияСтрокой Тогда
			Возврат СтрокаНакладной;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Неопределено;
	
КонецФункции

// Ищет заказ (ИнвойсПродажи) по номеру входящему и контрагенту.
//
// Параметры:
//  НомерВходящий    - Строка - номер из колонки КолонкаНомерВходящий;
//  КонтрагентЗаказа - СправочникСсылка.Контрагенты.
//
// Возвращаемое значение:
//  ДокументСсылка.ИнвойсПродажи.
//
&НаСервере
Функция НайтиИнвойсПродажиПоНомеруВходящему(НомерВходящий, КонтрагентЗаказа)
	
	Если НЕ ЗначениеЗаполнено(НомерВходящий) Тогда
		Возврат Документы.ИнвойсПродажи.ПустаяСсылка();
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Инвойс.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.ИнвойсПродажи КАК Инвойс
	|ГДЕ
	|	Инвойс.НомерВходящий = &НомерВходящий
	|	И Инвойс.Контрагент = &Контрагент
	|
	|УПОРЯДОЧИТЬ ПО
	|	Инвойс.ПометкаУдаления,
	|	Инвойс.Дата УБЫВ";
	Запрос.УстановитьПараметр("НомерВходящий", НомерВходящий);
	Запрос.УстановитьПараметр("Контрагент", КонтрагентЗаказа);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;
	
	Возврат Документы.ИнвойсПродажи.ПустаяСсылка();
	
КонецФункции

// Ищет расходную накладную по номеру входящему в примечании, контрагенту и дате.
//
// Параметры:
//  НомерВходящий    - Строка - номер заказа маркетплейса;
//  КонтрагентЗаказа - СправочникСсылка.Контрагенты;
//  ДатаЗаказа       - Дата - дата документа.
//
// Возвращаемое значение:
//  ДокументСсылка.РасходнаяНакладная.
//
&НаСервере
Функция НайтиРасходнуюНакладную(НомерВходящий, КонтрагентЗаказа, ДатаЗаказа)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Накладная.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.РасходнаяНакладная КАК Накладная
	|ГДЕ
	|	Накладная.Примечание = &НомерВходящий
	|	И Накладная.Контрагент = &Контрагент
	|	И НАЧАЛОПЕРИОДА(Накладная.Дата, ДЕНЬ) = &Дата
	|	И Накладная.Комиссия
	|	И НЕ Накладная.ПометкаУдаления
	|
	|УПОРЯДОЧИТЬ ПО
	|	Накладная.Дата УБЫВ";
	Запрос.УстановитьПараметр("НомерВходящий", НомерВходящий);
	Запрос.УстановитьПараметр("Контрагент", КонтрагентЗаказа);
	Запрос.УстановитьПараметр("Дата", НачалоДня(ДатаЗаказа));
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;
	
	Возврат Документы.РасходнаяНакладная.ПустаяСсылка();
	
КонецФункции

// Возвращает текст ячейки табличного документа.
//
// Параметры:
//  ТабличныйДокумент - ТабличныйДокумент - источник;
//  НомерСтроки       - Число - номер строки (1-based);
//  НомерКолонки      - Число - номер колонки (1-based).
//
// Возвращаемое значение:
//  Строка - текст ячейки.
//
&НаСервере
Функция ТекстЯчейкиТаблицы(ТабличныйДокумент, НомерСтроки, НомерКолонки)
	
	ЗначениеЯчейки = ЗначениеЯчейкиТаблицы(ТабличныйДокумент, НомерСтроки, НомерКолонки);
	Если ЗначениеЯчейки = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	
	Если ТипЗнч(ЗначениеЯчейки) = Тип("Число") Тогда
		Возврат Формат(ЗначениеЯчейки, "ЧГ=0; ЧДЦ=0");
	КонецЕсли;
	
	Возврат СокрЛП(Строка(ЗначениеЯчейки));
	
КонецФункции

// Возвращает значение ячейки табличного документа.
//
// Параметры:
//  ТабличныйДокумент - ТабличныйДокумент - источник;
//  НомерСтроки       - Число - номер строки (1-based);
//  НомерКолонки      - Число - номер колонки (1-based).
//
// Возвращаемое значение:
//  Произвольный, Неопределено - значение ячейки или Неопределено для пустой ячейки.
//
&НаСервере
Функция ЗначениеЯчейкиТаблицы(ТабличныйДокумент, НомерСтроки, НомерКолонки)
	
	Если НомерКолонки < 1 ИЛИ НомерСтроки < 1 Тогда
		Возврат Неопределено;
	КонецЕсли;
	Если НомерСтроки > ТабличныйДокумент.ВысотаТаблицы
		ИЛИ НомерКолонки > ТабличныйДокумент.ШиринаТаблицы Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Область = ТабличныйДокумент.Область(НомерСтроки, НомерКолонки, НомерСтроки, НомерКолонки);
	Если Область.СодержитЗначение Тогда
		Возврат Область.Значение;
	КонецЕсли;
	
	Текст = СокрЛП(Область.Текст);
	Если НЕ ЗначениеЗаполнено(Текст) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Возврат Текст;
	
КонецФункции

// Группирует строки импорта по дате, номеру входящему и контрагенту.
//
// Параметры:
//  СтрокиИмпорта - Массив из Структура - разобранные строки.
//
// Возвращаемое значение:
//  Массив из Структура - группы заказов.
//
&НаСервере
Функция СгруппироватьСтрокиПоЗаказам(СтрокиИмпорта)
	
	Группы = Новый Соответствие;
	
	Для Каждого СтрокаИмпорта Из СтрокиИмпорта Цикл
		
		КлючГруппы = СтрШаблон("%1|%2|%3",
			Формат(СтрокаИмпорта.Дата, "ДФ=yyyyMMdd"),
			СтрокаИмпорта.НомерВходящий,
			Строка(СтрокаИмпорта.Контрагент.УникальныйИдентификатор()));
		Группа = Группы.Получить(КлючГруппы);
		Если Группа = Неопределено Тогда
			Группа = Новый Структура("Дата, НомерВходящий, Контрагент, Строки",
				СтрокаИмпорта.Дата, СтрокаИмпорта.НомерВходящий, СтрокаИмпорта.Контрагент, Новый Массив);
			Группы.Вставить(КлючГруппы, Группа);
		КонецЕсли;
		Группа.Строки.Добавить(СтрокаИмпорта);
		
	КонецЦикла;
	
	РезультатГрупп = Новый Массив;
	Для Каждого КлючИЗначение Из Группы Цикл
		РезультатГрупп.Добавить(КлючИЗначение.Значение);
	КонецЦикла;
	
	Возврат РезультатГрупп;
	
КонецФункции

// Собирает ошибки идентификации по всем строкам импорта.
//
// Параметры:
//  СтрокиИмпорта - Массив из Структура - разобранные строки.
//
// Возвращаемое значение:
//  Массив из Строка - тексты ошибок.
//
&НаСервере
Функция СобратьОшибкиИдентификации(СтрокиИмпорта)
	
	Ошибки = Новый Массив;
	
	Для Каждого СтрокаИмпорта Из СтрокиИмпорта Цикл
		
		Если НЕ ЗначениеЗаполнено(СтрокаИмпорта.Партия) Тогда
			Ошибки.Добавить(СтрШаблон("Строка %1: не найдена партия по серии ""%2""",
				СтрокаИмпорта.НомерСтроки, СтрокаИмпорта.Серия));
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Ошибки;
	
КонецФункции

// Возвращает соответствие номеров строк с ошибками идентификации.
//
// Параметры:
//  СтрокиИмпорта - Массив из Структура - разобранные строки.
//
// Возвращаемое значение:
//  Соответствие - ключ: номер строки, значение: Истина.
//
&НаСервере
Функция СтрокиСОшибкамиИдентификации(СтрокиИмпорта)
	
	РезультатСоответствие = Новый Соответствие;
	Ошибки = СобратьОшибкиИдентификации(СтрокиИмпорта);
	Если Ошибки.Количество() = 0 Тогда
		Возврат РезультатСоответствие;
	КонецЕсли;
	
	Для Каждого СтрокаИмпорта Из СтрокиИмпорта Цикл
		
		ЕстьОшибка = Ложь;
		Если НЕ ЗначениеЗаполнено(СтрокаИмпорта.Партия) Тогда
			ЕстьОшибка = Истина;
		КонецЕсли;
		
		Если ЕстьОшибка Тогда
			РезультатСоответствие.Вставить(СтрокаИмпорта.НомерСтроки, Истина);
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат РезультатСоответствие;
	
КонецФункции

// Формирует тексты ошибок для серий группы заказа, по которым не найдена партия.
//
// Параметры:
//  ГруппаЗаказа - Структура - данные заказа из серийных номеров.
//
// Возвращаемое значение:
//  Массив из Строка - тексты вида «Серия ХХХ не найдена».
//
&НаСервере
Функция ОшибкиСерийГруппыЗаказа(ГруппаЗаказа)
	
	Ошибки = Новый Массив;
	
	Для Каждого СтрокаИмпорта Из ГруппаЗаказа.Строки Цикл
		Если НЕ ЗначениеЗаполнено(СтрокаИмпорта.Партия) Тогда
			Ошибки.Добавить(СтрШаблон("Серия %1 не найдена", СтрокаИмпорта.Серия));
		КонецЕсли;
	КонецЦикла;
	
	Возврат Ошибки;
	
КонецФункции

// Проверяет наличие строк с ошибками идентификации в группе заказа.
//
// Параметры:
//  ГруппаЗаказа      - Структура - группа заказа;
//  СтрокиСОшибками  - Соответствие - номера строк с ошибками.
//
// Возвращаемое значение:
//  Булево - Истина, если в группе есть проблемные строки.
//
&НаСервере
Функция ГруппаСодержитСтрокуСОшибкой(ГруппаЗаказа, СтрокиСОшибками)
	
	Для Каждого СтрокаИмпорта Из ГруппаЗаказа.Строки Цикл
		Если СтрокиСОшибками.Получить(СтрокаИмпорта.НомерСтроки) = Истина Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Ложь;
	
КонецФункции


// Ищет партию по серии в справочнике партий.
//
// Параметры:
//  Серия - Строка - серия.
//
// Возвращаемое значение:
//  СправочникСсылка.Партии - найденная партия или пустая ссылка.
//
&НаСервере
Функция НайтиПартиюПоСерии(Серия)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Партии.Ссылка КАК Партия
	|ИЗ
	|	Справочник.Партии КАК Партии
	|ГДЕ
	|	Партии.Серия = &Серия
	|	И НЕ Партии.ПометкаУдаления";
	Запрос.УстановитьПараметр("Серия", Серия);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Партия;
	КонецЕсли;
	
	Возврат Справочники.Партии.ПустаяСсылка();
	
КонецФункции

// Возвращает дату документа с заданными часами и минутами.
//
// Параметры:
//  ДатаДокумента - Дата - исходная дата (берётся начало дня);
//  Часы          - Число - часы;
//  Минуты        - Число - минуты.
//
// Возвращаемое значение:
//  Дата
//
&НаСервере
Функция ДатаСоВременем(ДатаДокумента, Часы, Минуты)
	
	Возврат НачалоДня(ДатаДокумента) + Часы * 3600 + Минуты * 60;
	
КонецФункции

// Преобразует значение ячейки в дату.
//
// Параметры:
//  ЗначениеЯчейки - Произвольный - значение из отчёта.
//
// Возвращаемое значение:
//  Дата - распознанная дата или пустая дата.
//
&НаСервере
Функция ПреобразоватьДату(ЗначениеЯчейки)
	
	Если ЗначениеЯчейки = Неопределено Тогда
		Возврат Дата(1, 1, 1);
	КонецЕсли;
	
	Если ТипЗнч(ЗначениеЯчейки) = Тип("Дата") Тогда
		Возврат ЗначениеЯчейки;
	КонецЕсли;
	
	Текст = СокрЛП(Строка(ЗначениеЯчейки));
	Если НЕ ЗначениеЗаполнено(Текст) Тогда
		Возврат Дата(1, 1, 1);
	КонецЕсли;
	
	РазобраннаяДата = РазобратьДатуИзСтроки(Текст);
	Если ЗначениеЗаполнено(РазобраннаяДата) Тогда
		Возврат РазобраннаяДата;
	КонецЕсли;
	
	Попытка
		Возврат Дата(Текст);
	Исключение
	КонецПопытки;
	
	Попытка
		Возврат XMLЗначение(Тип("Дата"), Текст);
	Исключение
	КонецПопытки;
	
	Возврат Дата(1, 1, 1);
	
КонецФункции

// Разбирает дату из строки формата «дд.ММ.гггг» или «дд.ММ.гггг ЧЧ:мм».
//
// Параметры:
//  Текст - Строка - текст даты из отчёта.
//
// Возвращаемое значение:
//  Дата - распознанная дата или пустая дата.
//
&НаСервере
Функция РазобратьДатуИзСтроки(Текст)
	
	СтрокаДаты = СокрЛП(Текст);
	Если СтрДлина(СтрокаДаты) < 10 Тогда
		Возврат Дата(1, 1, 1);
	КонецЕсли;
	
	Попытка
		лДень = Число(Сред(СтрокаДаты, 1, 2));
		лМесяц = Число(Сред(СтрокаДаты, 4, 2));
		лГод = Число(Сред(СтрокаДаты, 7, 4));
		лЧас = 0;
		лМинута = 0;
		лСекунда = 0;
		
		ПозицияПробела = СтрНайти(СтрокаДаты, " ");
		Если ПозицияПробела > 0 Тогда
			СтрокаВремени = СокрЛП(Сред(СтрокаДаты, ПозицияПробела + 1));
			Если СтрДлина(СтрокаВремени) >= 5 Тогда
				лЧас = Число(Сред(СтрокаВремени, 1, 2));
				лМинута = Число(Сред(СтрокаВремени, 4, 2));
				Если СтрДлина(СтрокаВремени) >= 8 Тогда
					лСекунда = Число(Сред(СтрокаВремени, 7, 2));
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		
		Возврат Дата(лГод, лМесяц, лДень, лЧас, лМинута, лСекунда);
	Исключение
		Возврат Дата(1, 1, 1);
	КонецПопытки;
	
КонецФункции

// Преобразует значение ячейки в количество.
//
// Параметры:
//  ЗначениеЯчейки - Произвольный - значение из отчёта.
//
// Возвращаемое значение:
//  Число - количество.
//
&НаСервере
Функция ПреобразоватьКоличество(ЗначениеЯчейки)
	
	Если ЗначениеЯчейки = Неопределено Тогда
		Возврат 0;
	КонецЕсли;
	
	Если ТипЗнч(ЗначениеЯчейки) = Тип("Число") Тогда
		Возврат ЗначениеЯчейки;
	КонецЕсли;
	
	Текст = СокрЛП(Строка(ЗначениеЯчейки));
	Текст = СтрЗаменить(Текст, Символ(160), "");
	Текст = СтрЗаменить(Текст, " ", "");
	Текст = СтрЗаменить(Текст, ",", ".");
	Если НЕ ЗначениеЗаполнено(Текст) Тогда
		Возврат 0;
	КонецЕсли;
	
	Отрицательное = Ложь;
	Если Лев(Текст, 1) = "(" И Прав(Текст, 1) = ")" Тогда
		Отрицательное = Истина;
		Текст = Сред(Текст, 2, СтрДлина(Текст) - 2);
	ИначеЕсли Лев(Текст, 1) = "-" Тогда
		Отрицательное = Истина;
		Текст = Сред(Текст, 2);
	КонецЕсли;
	
	Попытка
		ЧислоЗначение = Число(Текст);
		Возврат ?(Отрицательное, -ЧислоЗначение, ЧислоЗначение);
	Исключение
		Возврат 0;
	КонецПопытки;
	
КонецФункции

// Преобразует значение ячейки в цену.
//
// Параметры:
//  ЗначениеЯчейки - Произвольный - значение из отчёта.
//
// Возвращаемое значение:
//  Число - цена.
//
&НаСервере
Функция ПреобразоватьЦену(ЗначениеЯчейки)
	
	Возврат ПреобразоватьКоличество(ЗначениеЯчейки);
	
КонецФункции


#КонецОбласти
