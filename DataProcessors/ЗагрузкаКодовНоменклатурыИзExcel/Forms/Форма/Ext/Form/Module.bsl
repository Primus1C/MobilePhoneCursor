#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Загрузить(Команда)
	
	ВыбратьФайлExcel("Загрузить");
	
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьНаличие(Команда)
	
	ВыбратьФайлExcel("ПроверитьНаличие");
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Открывает диалог выбора Excel и передаёт режим обработки в оповещение.
//
// Параметры:
//  РежимОбработки - Строка - "Загрузить" или "ПроверитьНаличие".
//
&НаКлиенте
Процедура ВыбратьФайлExcel(РежимОбработки)
	
	Диалог = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Открытие);
	Диалог.Заголовок = НСтр("ru = 'Выберите файл Excel'");
	Диалог.Фильтр = НСтр("ru = 'Excel (*.xlsx;*.xls)|*.xlsx;*.xls|Все файлы (*.*)|*.*'");
	Диалог.МножественныйВыбор = Ложь;
	Диалог.ПроверятьСуществованиеФайла = Истина;
	Диалог.Показать(Новый ОписаниеОповещения("ПослеВыбораФайлаExcel", ЭтотОбъект, РежимОбработки));
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеВыбораФайлаExcel(ВыбранныеФайлы, РежимОбработки) Экспорт
	
	Если ВыбранныеФайлы = Неопределено Или ВыбранныеФайлы.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	НачатьПомещениеФайла(
		Новый ОписаниеОповещения("ПослеПомещенияФайлаExcel", ЭтотОбъект, РежимОбработки),
		,
		ВыбранныеФайлы[0],
		Ложь,
		УникальныйИдентификатор);
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеПомещенияФайлаExcel(ФайлВыбран, Адрес, ВыбранноеИмяФайла, РежимОбработки) Экспорт
	
	Если НЕ ФайлВыбран Тогда
		Возврат;
	КонецЕсли;
	
	Расширение = РасширениеФайлаИзИмени(ВыбранноеИмяФайла);
	ОбработатьФайлНаСервере(Адрес, Расширение, РежимОбработки);
	
КонецПроцедуры

// Возвращает расширение файла без точки (нижний регистр).
//
// Параметры:
//  ИмяФайла - Строка
//
// Возвращаемое значение:
//  Строка
//
&НаКлиенте
Функция РасширениеФайлаИзИмени(ИмяФайла)
	
	Имя = Строка(ИмяФайла);
	Позиция = СтрНайти(Имя, ".", НаправлениеПоиска.СКонца);
	Если Позиция = 0 Тогда
		Возврат "";
	КонецЕсли;
	
	Возврат НРег(Сред(Имя, Позиция + 1));
	
КонецФункции

// Читает Excel и выполняет загрузку кодов или проверку наличия номенклатуры.
//
// Параметры:
//  АдресФайла     - Строка - адрес двоичных данных во временном хранилище;
//  Расширение     - Строка - xlsx или xls;
//  РежимОбработки - Строка - "Загрузить" или "ПроверитьНаличие".
//
&НаСервере
Процедура ОбработатьФайлНаСервере(АдресФайла, Расширение, РежимОбработки)
	
	Ошибки.Очистить();
	Статус = "";
	
	ДвоичныеДанные = ПолучитьИзВременногоХранилища(АдресФайла);
	Если ТипЗнч(ДвоичныеДанные) <> Тип("ДвоичныеДанные") Тогда
		Статус = НСтр("ru = 'Не удалось прочитать файл.'");
		Возврат;
	КонецЕсли;
	
	Расш = НРег(СокрЛП(Строка(Расширение)));
	Если Расш <> "xlsx" И Расш <> "xls" Тогда
		Расш = "xlsx";
	КонецЕсли;
	
	ИмяВременногоФайла = ПолучитьИмяВременногоФайла(Расш);
	Попытка
		ДвоичныеДанные.Записать(ИмяВременногоФайла);
		ТабДок = Новый ТабличныйДокумент;
		ТабДок.Прочитать(ИмяВременногоФайла, СпособЧтенияЗначенийТабличногоДокумента.Значение);
	Исключение
		УдалитьФайлыБезопасно(ИмяВременногоФайла);
		Статус = СтрШаблон(НСтр("ru = 'Ошибка чтения Excel: %1'"), КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат;
	КонецПопытки;
	
	УдалитьФайлыБезопасно(ИмяВременногоФайла);
	
	Если РежимОбработки = "ПроверитьНаличие" Тогда
		ПроверитьНаличиеНоменклатурыВТаблице(ТабДок);
		Возврат;
	КонецЕсли;
	
	ЧислоЗаписанных = 0;
	ВысотаТаблицы = ТабДок.ВысотаТаблицы;
	
	Для НомерСтроки = 2 По ВысотаТаблицы Цикл
		
		Наименование = ТекстЯчейки(ТабДок, НомерСтроки, 1);
		Если Наименование = "" Тогда
			Продолжить;
		КонецЕсли;
		
		SKUИзФайла = ТекстЯчейки(ТабДок, НомерСтроки, 2);
		UPCИзФайла = ТекстЯчейки(ТабДок, НомерСтроки, 3);
		JANИзФайла = ТекстЯчейки(ТабДок, НомерСтроки, 4);
		
		Найденные = НайтиНоменклатуруПоНаименованию(Наименование);
		Если Найденные.Количество() = 0 Тогда
			ДобавитьОшибку(НомерСтроки, Наименование,
				НСтр("ru = 'Товар не найден по наименованию'"));
			Продолжить;
		КонецЕсли;
		Если Найденные.Количество() > 1 Тогда
			ДобавитьОшибку(НомерСтроки, Наименование,
				СтрШаблон(НСтр("ru = 'Найдено несколько элементов номенклатуры (%1)'"), Найденные.Количество()));
			Продолжить;
		КонецЕсли;
		
		ДанныеНоменклатуры = Найденные[0];
		Если ОбработатьКодыНоменклатуры(
			ДанныеНоменклатуры,
			НомерСтроки,
			Наименование,
			SKUИзФайла,
			UPCИзФайла,
			JANИзФайла) Тогда
			ЧислоЗаписанных = ЧислоЗаписанных + 1;
		КонецЕсли;
		
	КонецЦикла;
	
	Статус = СтрШаблон(НСтр("ru = 'Записано элементов справочника: %1. Ошибок: %2.'"),
		ЧислоЗаписанных,
		Ошибки.Количество());
	
КонецПроцедуры

// Проверяет наличие номенклатуры по наименованию из колонки 3 со строки 9.
// Не найденные по наименованию добавляются в таблицу Ошибки.
//
// Параметры:
//  ТабДок - ТабличныйДокумент - данные Excel.
//
&НаСервере
Процедура ПроверитьНаличиеНоменклатурыВТаблице(ТабДок)
	
	КолонкаНаименования = 3;
	ПерваяСтрока = 9;
	ВысотаТаблицы = ТабДок.ВысотаТаблицы;
	
	Если ВысотаТаблицы < ПерваяСтрока Тогда
		Статус = НСтр("ru = 'В файле нет строк для проверки (данные со строки 9, колонка 3).'");
		Возврат;
	КонецЕсли;
	
	СтрокиФайла = Новый Массив;
	Наименования = Новый Массив;
	УникальныеНаименования = Новый Соответствие;
	
	Для НомерСтроки = ПерваяСтрока По ВысотаТаблицы Цикл
		
		Наименование = ТекстЯчейки(ТабДок, НомерСтроки, КолонкаНаименования);
		Если Наименование = "" Тогда
			Продолжить;
		КонецЕсли;
		
		СтрокиФайла.Добавить(Новый Структура("НомерСтроки, Наименование", НомерСтроки, Наименование));
		Если УникальныеНаименования.Получить(Наименование) = Неопределено Тогда
			УникальныеНаименования.Вставить(Наименование, Истина);
			Наименования.Добавить(Наименование);
		КонецЕсли;
		
	КонецЦикла;
	
	Если СтрокиФайла.Количество() = 0 Тогда
		Статус = НСтр("ru = 'В колонке 3 со строки 9 нет наименований для проверки.'");
		Возврат;
	КонецЕсли;
	
	НайденныеНаименования = НаименованияНоменклатурыИзСправочника(Наименования);
	
	Для Каждого СтрокаФайла Из СтрокиФайла Цикл
		Если НайденныеНаименования.Получить(СтрокаФайла.Наименование) = Неопределено Тогда
			ДобавитьОшибку(СтрокаФайла.НомерСтроки, СтрокаФайла.Наименование,
				НСтр("ru = 'Товар не найден по наименованию'"));
		КонецЕсли;
	КонецЦикла;
	
	Статус = СтрШаблон(НСтр("ru = 'Проверено наименований: %1. Не найдено: %2.'"),
		СтрокиФайла.Количество(),
		Ошибки.Количество());
	
КонецПроцедуры

// Возвращает соответствие наименований, которые есть в справочнике Номенклатура.
//
// Параметры:
//  Наименования - Массив из Строка - наименования из Excel.
//
// Возвращаемое значение:
//  Соответствие - ключ: наименование, значение: Истина.
//
&НаСервере
Функция НаименованияНоменклатурыИзСправочника(Наименования)
	
	НайденныеНаименования = Новый Соответствие;
	Если Наименования.Количество() = 0 Тогда
		Возврат НайденныеНаименования;
	КонецЕсли;
	
	Запр = Новый Запрос;
	Запр.УстановитьПараметр("Наименования", Наименования);
	Запр.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Ном.Наименование КАК Наименование
	|ИЗ
	|	Справочник.Номенклатура КАК Ном
	|ГДЕ
	|	Ном.Наименование В (&Наименования)
	|	И НЕ Ном.ЭтоГруппа
	|	И НЕ Ном.ПометкаУдаления";
	
	Выборка = Запр.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		НайденныеНаименования.Вставить(Выборка.Наименование, Истина);
	КонецЦикла;
	
	Возврат НайденныеНаименования;
	
КонецФункции

// Ищет элементы номенклатуры по точному наименованию (без групп и помеченных на удаление).
//
// Параметры:
//  Наименование - Строка
//
// Возвращаемое значение:
//  Массив из Структура - Ссылка, SKU, UPC, JAN13
//
&НаСервере
Функция НайтиНоменклатуруПоНаименованию(Наименование)
	
	Запр = Новый Запрос;
	Запр.УстановитьПараметр("Наименование", Наименование);
	Запр.Текст =
	"ВЫБРАТЬ
	|	Ном.Ссылка КАК Ссылка,
	|	Ном.SKU КАК SKU,
	|	Ном.UPC КАК UPC,
	|	Ном.JAN13 КАК JAN13
	|ИЗ
	|	Справочник.Номенклатура КАК Ном
	|ГДЕ
	|	Ном.Наименование = &Наименование
	|	И НЕ Ном.ЭтоГруппа
	|	И НЕ Ном.ПометкаУдаления";
	
	Результат = Новый Массив;
	Выборка = Запр.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Элемент = Новый Структура;
		Элемент.Вставить("Ссылка", Выборка.Ссылка);
		Элемент.Вставить("SKU", СокрЛП(Строка(Выборка.SKU)));
		Элемент.Вставить("UPC", СокрЛП(Строка(Выборка.UPC)));
		Элемент.Вставить("JAN13", СокрЛП(Строка(Выборка.JAN13)));
		Результат.Добавить(Элемент);
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// Сравнивает коды Excel с 1С: пустые в 1С заполняет, при расхождении — ошибка без записи кода.
//
// Параметры:
//  ДанныеНоменклатуры - Структура - Ссылка, SKU, UPC, JAN13;
//  НомерСтроки - Число;
//  Наименование - Строка;
//  SKUИзФайла - Строка;
//  UPCИзФайла - Строка;
//  JANИзФайла - Строка.
//
// Возвращаемое значение:
//  Булево - Истина, если элемент справочника был записан.
//
&НаСервере
Функция ОбработатьКодыНоменклатуры(ДанныеНоменклатуры, НомерСтроки, Наименование,
	SKUИзФайла, UPCИзФайла, JANИзФайла)
	
	НовыйSKU = Неопределено;
	НовыйUPC = Неопределено;
	НовыйJAN = Неопределено;
	
	ОбработатьОдинКод(
		"SKU",
		SKUИзФайла,
		ДанныеНоменклатуры.SKU,
		12,
		НомерСтроки,
		Наименование,
		НовыйSKU);
	
	ОбработатьОдинКод(
		"UPC",
		UPCИзФайла,
		ДанныеНоменклатуры.UPC,
		12,
		НомерСтроки,
		Наименование,
		НовыйUPC);
	
	ОбработатьОдинКод(
		"JAN",
		JANИзФайла,
		ДанныеНоменклатуры.JAN13,
		13,
		НомерСтроки,
		Наименование,
		НовыйJAN);
	
	Если НовыйSKU = Неопределено И НовыйUPC = Неопределено И НовыйJAN = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ОбъектНоменклатуры = ДанныеНоменклатуры.Ссылка.ПолучитьОбъект();
	Если НовыйSKU <> Неопределено Тогда
		ОбъектНоменклатуры.SKU = НовыйSKU;
	КонецЕсли;
	Если НовыйUPC <> Неопределено Тогда
		ОбъектНоменклатуры.UPC = НовыйUPC;
	КонецЕсли;
	Если НовыйJAN <> Неопределено Тогда
		ОбъектНоменклатуры.JAN13 = НовыйJAN;
	КонецЕсли;
	
	Попытка
		ОбъектНоменклатуры.Записать();
	Исключение
		ДобавитьОшибку(НомерСтроки, Наименование,
			СтрШаблон(НСтр("ru = 'Ошибка записи: %1'"), КраткоеПредставлениеОшибки(ИнформацияОбОшибке())));
		Возврат Ложь;
	КонецПопытки;
	
	Возврат Истина;
	
КонецФункции

// Решает, записывать ли код из Excel в 1С.
//
// Параметры:
//  ИмяКода - Строка - SKU / UPC / JAN;
//  ЗначениеФайла - Строка;
//  Значение1С - Строка;
//  МаксДлина - Число;
//  НомерСтроки - Число;
//  Наименование - Строка;
//  НовоеЗначение - Строка, Неопределено - исходящий: значение для записи или Неопределено.
//
&НаСервере
Процедура ОбработатьОдинКод(ИмяКода, ЗначениеФайла, Значение1С, МаксДлина,
	НомерСтроки, Наименование, НовоеЗначение)
	
	НовоеЗначение = Неопределено;
	
	Если ЗначениеФайла = "" Тогда
		Возврат;
	КонецЕсли;
	
	ЗначениеДляЗаписи = Лев(ЗначениеФайла, МаксДлина);
	
	Если Значение1С = "" Тогда
		НовоеЗначение = ЗначениеДляЗаписи;
		Возврат;
	КонецЕсли;
	
	Если Значение1С <> ЗначениеДляЗаписи И Значение1С <> ЗначениеФайла Тогда
		ДобавитьОшибку(НомерСтроки, Наименование,
			СтрШаблон(НСтр("ru = '%1 в Excel (%2) отличается от значения в 1С (%3). Код не записан.'"),
				ИмяКода,
				ЗначениеФайла,
				Значение1С));
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ДобавитьОшибку(НомерСтроки, Наименование, ТекстОшибки)
	
	СтрокаОшибки = Ошибки.Добавить();
	СтрокаОшибки.НомерСтроки = НомерСтроки;
	СтрокаОшибки.Наименование = Наименование;
	СтрокаОшибки.Текст = ТекстОшибки;
	
КонецПроцедуры

&НаСервере
Процедура УдалитьФайлыБезопасно(ИмяФайла)
	
	Попытка
		УдалитьФайлы(ИмяФайла);
	Исключение
		// временный файл мог уже отсутствовать
	КонецПопытки;
	
КонецПроцедуры

// Текст ячейки Excel: для чисел — без научной записи и дробной части.
//
// Параметры:
//  ТабДок - ТабличныйДокумент;
//  НомерСтроки - Число;
//  НомерКолонки - Число.
//
// Возвращаемое значение:
//  Строка
//
&НаСервере
Функция ТекстЯчейки(ТабДок, НомерСтроки, НомерКолонки)
	
	Область = ТабДок.Область(НомерСтроки, НомерКолонки);
	ЗначениеЯчейки = Область.Текст;
	
	//Если ТипЗнч(ЗначениеЯчейки) = Тип("Число") Тогда
	//	Возврат Формат(ЗначениеЯчейки, "ЧГ=0; ЧДЦ=0");
	//КонецЕсли;
	
	Если ЗначениеЯчейки = Неопределено Или ЗначениеЯчейки = Null Тогда
		Возврат СокрЛП(Строка(Область.Текст));
	КонецЕсли;
	
	Возврат СокрЛП(Строка(ЗначениеЯчейки));
	
КонецФункции

#КонецОбласти
