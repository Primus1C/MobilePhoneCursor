
Процедура ОбработкаЗаполнения(ДанныеЗаполнения, ТекстЗаполнения, СтандартнаяОбработка)
	
	Приоритет = Перечисления.Важность.ВРабочемПорядке;
	Автор = гоПользователь();
	Статус = Перечисления.СтатусыЗадач.Новая;
	
КонецПроцедуры

Процедура ПриКопировании(ОбъектКопирования)
	
	ДатаВыполнения = Дата(1, 1, 1);
	Автор = гоПользователь();
	Статус = Перечисления.СтатусыЗадач.Новая;
	Выполнена = Ложь;
	Комментарии.Очистить();
	
КонецПроцедуры

Процедура ПередЗаписью(Отказ)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	Если ДополнительныеСвойства.Свойство("МиграцияСтатусовЗадач") Тогда
		Возврат;
	КонецЕсли;
	
	Тэги = СокрЛП(Тэги);
	ТекущийПользователь = гоПользователь();  
	РольРазработка = омСервер.ЕстьРоль("Разработка");
	ЭтоНовый = ЭтоНовый();
	
	Если НЕ ЗначениеЗаполнено(Статус) Тогда
		Статус = ?(Выполнена, Перечисления.СтатусыЗадач.Выполнена, Перечисления.СтатусыЗадач.Новая);
	КонецЕсли;
	
	Если ЭтоНовый Тогда
		Если НЕ ЗначениеЗаполнено(Автор) Тогда
			Автор = ТекущийПользователь;
		КонецЕсли;
		Если Автор <> ТекущийПользователь И НЕ РольРазработка Тогда
			Отказ = Истина;
			Сообщить("Автор задачи должен быть текущим пользователем.");
			Возврат;
		КонецЕсли;
		Если НЕ гоРеквизит(Автор, "ПостановщикЗадач") Тогда
			Отказ = Истина;
			Сообщить("Создавать задачи может только пользователь с признаком «Постановщик задач».");
			Возврат;
		КонецЕсли;
		Если НЕ ЗначениеЗаполнено(Пользователь) Тогда
			Отказ = Истина;
			Сообщить("Не указан исполнитель задачи.");
			Возврат;
		КонецЕсли;
		Если НЕ гоРеквизит(Пользователь, "ИсполнительЗадач") Тогда
			Отказ = Истина;
			Сообщить("Выбранный пользователь не является исполнителем задач.");
			Возврат;
		КонецЕсли;
		Если НЕ ЗначениеЗаполнено(СокрЛП(Описание)) Тогда
			Отказ = Истина;
			Сообщить("Заполните описание задачи.");
			Возврат;
		КонецЕсли;
		Статус = Перечисления.СтатусыЗадач.Новая;
		Выполнена = Ложь;
		Если Пользователь <> ТекущийПользователь Тогда
			ДополнительныеСвойства.Вставить("УведомитьПолучателя", Пользователь);
		КонецЕсли;
		Возврат;
	КонецЕсли;
	
	СтарыйСтатус = гоРеквизит(Ссылка, "Статус");
	СтарыйВыполнена = гоРеквизит(Ссылка, "Выполнена");
	Если НЕ ЗначениеЗаполнено(СтарыйСтатус) Тогда
		СтарыйСтатус = ?(СтарыйВыполнена, Перечисления.СтатусыЗадач.Выполнена, Перечисления.СтатусыЗадач.Новая);
	КонецЕсли;
	
	Если Автор <> гоРеквизит(Ссылка, "Автор") И НЕ РольРазработка Тогда
		Отказ = Истина;
		Сообщить("Автор задачи не может быть изменён.");
		Возврат;
	КонецЕсли;
	Если Пользователь <> гоРеквизит(Ссылка, "Пользователь") Тогда
		Отказ = Истина;
		Сообщить("Исполнитель задачи не может быть изменён.");
		Возврат;
	КонецЕсли;
	ИзмененыРеквизитыРазработки =
		СокрЛП(Описание) <> СокрЛП(гоРеквизит(Ссылка, "Описание"))
		Или Наименование <> гоРеквизит(Ссылка, "Наименование")
		Или Приоритет <> гоРеквизит(Ссылка, "Приоритет")
		Или СокрЛП(Тэги) <> СокрЛП(гоРеквизит(Ссылка, "Тэги"))
		Или СсылкаНаОбъект <> гоРеквизит(Ссылка, "СсылкаНаОбъект");
	
	Если ИзмененыРеквизитыРазработки И НЕ РольРазработка Тогда
		Отказ = Истина;
		Сообщить("После создания задачи реквизиты (тэги, наименование, описание, ссылка, приоритет) может менять только роль «Разработка».");
		Возврат;
	КонецЕсли;
	
	Если СтарыйСтатус = Перечисления.СтатусыЗадач.Закрыта Тогда
		Отказ = Истина;
		Сообщить("Закрытая задача недоступна для изменения.");
		Возврат;
	КонецЕсли;
	
	СтатусЗавершён = Статус = Перечисления.СтатусыЗадач.Выполнена
		Или Статус = Перечисления.СтатусыЗадач.Закрыта;
	
	СтатусИзменен = Статус <> СтарыйСтатус;
	Если НЕ СтатусИзменен Тогда
		Если Выполнена <> СтатусЗавершён Тогда
			Выполнена = СтатусЗавершён;
		КонецЕсли;
		ТекстКомментария = "";
		Если ДополнительныеСвойства.Свойство("ТекстКомментария") Тогда
			ТекстКомментария = СокрЛП(Строка(ДополнительныеСвойства.ТекстКомментария));
		КонецЕсли;
		Если ТекстКомментария <> "" Тогда
			СтрокаКомментария = Комментарии.Добавить();
			СтрокаКомментария.Дата = ТекущаяДатаСеанса();
			СтрокаКомментария.Пользователь = ТекущийПользователь;
			СтрокаКомментария.Текст = ТекстКомментария;
			СтрокаКомментария.Статус = Статус;
		КонецЕсли;
		Возврат;
	КонецЕсли;
	
	Если НЕ ПереходСтатусаДопустим(СтарыйСтатус, Статус, ТекущийПользователь, Автор, Пользователь) И НЕ РольРазработка Тогда
		Отказ = Истина;
		Сообщить("Недопустимый переход статуса или недостаточно прав.");
		Возврат;
	КонецЕсли;
	
	ТекстКомментария = "";
	Если ДополнительныеСвойства.Свойство("ТекстКомментария") Тогда
		ТекстКомментария = СокрЛП(Строка(ДополнительныеСвойства.ТекстКомментария));
	КонецЕсли;
	
	ЭтоАвтор = ТекущийПользователь = Автор;
	ЭтоИсполнитель = ТекущийПользователь = Пользователь;
	КомментарийДоступен = (ЭтоАвтор
			И (СтарыйСтатус = Перечисления.СтатусыЗадач.Новая
				Или СтарыйСтатус = Перечисления.СтатусыЗадач.ТребуетУточнения
				Или СтарыйСтатус = Перечисления.СтатусыЗадач.Выполнена))
		Или (ЭтоИсполнитель
			И (СтарыйСтатус = Перечисления.СтатусыЗадач.Новая
				Или СтарыйСтатус = Перечисления.СтатусыЗадач.ВРаботе
				Или СтарыйСтатус = Перечисления.СтатусыЗадач.Выполнена));
	
	// Без обязательного комментария: поле недоступно роли, «взять в работу»,
	// «Выполнена», «Принять задачу» (закрыта).
	// Обязателен комментарий: «Требует уточнения», «Вернуть в работу».
	ПереходБезКомментария = НЕ КомментарийДоступен
		Или Статус = Перечисления.СтатусыЗадач.Закрыта
		Или Статус = Перечисления.СтатусыЗадач.Выполнена
		Или (Статус = Перечисления.СтатусыЗадач.ВРаботе
			И СтарыйСтатус = Перечисления.СтатусыЗадач.Новая);
	Если НЕ ПереходБезКомментария И ТекстКомментария = "" Тогда
		Отказ = Истина;
		Сообщить("Для смены статуса заполните комментарий.");
		Возврат;
	КонецЕсли;
	
	Если Статус = Перечисления.СтатусыЗадач.ВРаботе
		И СтарыйСтатус <> Перечисления.СтатусыЗадач.Выполнена Тогда
		ВзятоВРаботу = ТекущаяДатаСеанса();
	КонецЕсли;
	
	Если ТекстКомментария <> "" Тогда
		СтрокаКомментария = Комментарии.Добавить();
		СтрокаКомментария.Дата = ТекущаяДатаСеанса();
		СтрокаКомментария.Пользователь = ТекущийПользователь;
		СтрокаКомментария.Текст = ТекстКомментария;
		СтрокаКомментария.Статус = Статус;
	КонецЕсли;
	
	Если СтатусЗавершён Тогда
		Если Статус = Перечисления.СтатусыЗадач.Выполнена Тогда
			ДополнительныеСвойства.Вставить("РазрешитьВыполнение", Истина);
		КонецЕсли;
		Выполнена = Истина;
		Если НЕ ЗначениеЗаполнено(ДатаВыполнения) Тогда
			ДатаВыполнения = ТекущаяДатаСеанса();
		КонецЕсли;
	Иначе
		Выполнена = Ложь;
		ДатаВыполнения = Дата(1, 1, 1);
	КонецЕсли;
	
	Получатель = ПолучательПриПередачеЗадачи(СтарыйСтатус, Статус, Автор, Пользователь, ТекущийПользователь);
	Если ЗначениеЗаполнено(Получатель) Тогда
		ДополнительныеСвойства.Вставить("УведомитьПолучателя", Получатель);
	КонецЕсли;
	
КонецПроцедуры

Процедура ПриЗаписи(Отказ)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	Если ДополнительныеСвойства.Свойство("УведомитьПолучателя") Тогда
		УведомитьОПередачеЗадачи(Ссылка, ДополнительныеСвойства.УведомитьПолучателя);
	КонецЕсли;
	
КонецПроцедуры

Процедура ПриВыполнении(Отказ)
	
	Если НЕ ДополнительныеСвойства.Свойство("РазрешитьВыполнение") Тогда
		Отказ = Истина;
		Сообщить("Выполнение задачи доступно только через статус «Выполнена».");
		Возврат;
	КонецЕсли;
	
	ДатаВыполнения = ТекущаяДатаСеанса();
	
КонецПроцедуры

// Отправляет всплывающее напоминание принимающей стороне задачи.
//
// Параметры:
//  ЗадачаСсылка - ЗадачаСсылка.Задача - задача;
//  Получатель   - СправочникСсылка.Пользователи - пользователь, которому адресовано уведомление.
//
Процедура УведомитьОПередачеЗадачи(ЗадачаСсылка, Получатель)
	
	Если НЕ ЗначениеЗаполнено(ЗадачаСсылка) Или НЕ ЗначениеЗаполнено(Получатель) Тогда
		Возврат;
	КонецЕсли;
	
	// Уведомление только принимающей стороне, не инициатору передачи.
	Если Получатель = гоПользователь() Тогда
		Возврат;
	КонецЕсли;
	
	АвторЗадачи = гоРеквизит(ЗадачаСсылка, "Автор");
	ИсполнительЗадачи = гоРеквизит(ЗадачаСсылка, "Пользователь");
	Если Получатель = АвторЗадачи Тогда
		Если НЕ гоРеквизит(Получатель, "ПостановщикЗадач") Тогда
			Возврат;
		КонецЕсли;
	ИначеЕсли Получатель = ИсполнительЗадачи Тогда
		Если НЕ гоРеквизит(Получатель, "ИсполнительЗадач") Тогда
			Возврат;
		КонецЕсли;
	Иначе
		Возврат;
	КонецЕсли;
	
	НомерЗадачи 		= гоРеквизит(ЗадачаСсылка, "Номер");
	НаименованиеЗадачи 	= гоРеквизит(ЗадачаСсылка, "Наименование");
	АвторЗадачи			= гоРеквизит(ЗадачаСсылка, "Автор");
	СтатусЗадачи 		= гоРеквизит(ЗадачаСсылка, "Статус");
	
	Если СтатусЗадачи = Перечисления.СтатусыЗадач.Новая Тогда
		ТекстСообщения = СтрШаблон(НСтр("ru = 'Вам назначена новая задача %1: %2.'; en = 'A new task %1 has been assigned to you: %2.'"),
			НомерЗадачи, НаименованиеЗадачи);
	ИначеЕсли СтатусЗадачи = Перечисления.СтатусыЗадач.ВРаботе Тогда
		ТекстСообщения = СтрШаблон(НСтр("ru = 'Автор %1 вернул задачу %2: %3 с уточнением.'; en = 'The author %1 returned task %2: %3 with clarification.'"),
			АвторЗадачи, НомерЗадачи, НаименованиеЗадачи);
	ИначеЕсли СтатусЗадачи = Перечисления.СтатусыЗадач.Выполнена Тогда
		ТекстСообщения = СтрШаблон(НСтр("ru = 'Задача %1: %2 выполнена. Подтвердите выполнение или верните на доработку.'; en = 'Task %1: %2 is completed. Confirm completion or return for revision.'"),
			НомерЗадачи, НаименованиеЗадачи);
	ИначеЕсли СтатусЗадачи = Перечисления.СтатусыЗадач.Закрыта Тогда
		ТекстСообщения = СтрШаблон(НСтр("ru = 'Автор %1 закрыл задачу %2: %3.'; en = 'The author closed task %1: %2.'"),
			АвторЗадачи, НомерЗадачи, НаименованиеЗадачи);
	Иначе
		ТекстСообщения = СтрШаблон(НСтр("ru = 'Вам передана задача %1: %2. Статус: %3.'; en = 'Task %1 has been passed to you: %2. Status: %3.'"),
			НомерЗадачи, НаименованиеЗадачи, Строка(СтатусЗадачи));
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Истина);
	МенеджерЗаписи = РегистрыСведений.Сооб_Сообщения.СоздатьМенеджерЗаписи();
	МенеджерЗаписи.Получатель 					= Получатель;
	МенеджерЗаписи.ТипСообщения 				= Перечисления.Сооб_ТипСообщения.Напоминание;
	МенеджерЗаписи.Категория 					= Перечисления.Сооб_Категория.ВнеОчереди;
	МенеджерЗаписи.Автор 						= гоПользователь();                        				
	МенеджерЗаписи.ЗапланированнаяДатаДоставки 	= ТекущаяДатаСеанса();
	МенеджерЗаписи.ДатаМожноУдалять 			= ТекущаяДатаСеанса() + 24 * 60 * 60;
	МенеджерЗаписи.УникИдент 					= Новый УникальныйИдентификатор;
	МенеджерЗаписи.Тема 						= НСтр("ru = 'Задача'; en = 'Task'");
	МенеджерЗаписи.Сообщение 					= ТекстСообщения;
	МенеджерЗаписи.СсылкаНаОбъект 				= ЗадачаСсылка;
	МенеджерЗаписи.ДатаСоздания 				= ТекущаяДатаСеанса();
	МенеджерЗаписи.Записать();
	УстановитьПривилегированныйРежим(Ложь);
	
КонецПроцедуры

// Проверяет допустимость перехода статуса для текущего пользователя.
//
// Параметры:
//  СтарыйСтатус         - ПеречислениеСсылка.СтатусыЗадач;
//  НовыйСтатус          - ПеречислениеСсылка.СтатусыЗадач;
//  ТекущийПользователь  - СправочникСсылка.Пользователи;
//  АвторЗадачи          - СправочникСсылка.Пользователи;
//  ИсполнительЗадачи    - СправочникСсылка.Пользователи.
//
// Возвращаемое значение:
//  Булево - Истина, если переход допустим.
//
Функция ПереходСтатусаДопустим(СтарыйСтатус, НовыйСтатус, ТекущийПользователь, АвторЗадачи, ИсполнительЗадачи)
	
	ЭтоАвтор = ТекущийПользователь = АвторЗадачи;
	ЭтоИсполнитель = ТекущийПользователь = ИсполнительЗадачи;
	
	Если СтарыйСтатус = Перечисления.СтатусыЗадач.Новая Тогда
		Возврат ЭтоИсполнитель
			И (НовыйСтатус = Перечисления.СтатусыЗадач.ВРаботе
				Или НовыйСтатус = Перечисления.СтатусыЗадач.ТребуетУточнения);
	ИначеЕсли СтарыйСтатус = Перечисления.СтатусыЗадач.ВРаботе Тогда
		Возврат ЭтоИсполнитель
			И (НовыйСтатус = Перечисления.СтатусыЗадач.ТребуетУточнения
				Или НовыйСтатус = Перечисления.СтатусыЗадач.Выполнена);
	ИначеЕсли СтарыйСтатус = Перечисления.СтатусыЗадач.ТребуетУточнения Тогда
		Возврат ЭтоАвтор И НовыйСтатус = Перечисления.СтатусыЗадач.ВРаботе;
	ИначеЕсли СтарыйСтатус = Перечисления.СтатусыЗадач.Выполнена Тогда
		Возврат ЭтоАвтор
			И (НовыйСтатус = Перечисления.СтатусыЗадач.Закрыта
				Или НовыйСтатус = Перечисления.СтатусыЗадач.ВРаботе);
	КонецЕсли;
	
	Возврат Ложь;
	
КонецФункции

// Возвращает пользователя, которому передаётся задача (принимающая сторона).
// Инициатору передачи уведомление не формируется.
//
// Параметры:
//  СтарыйСтатус         - ПеречислениеСсылка.СтатусыЗадач;
//  НовыйСтатус          - ПеречислениеСсылка.СтатусыЗадач;
//  АвторЗадачи          - СправочникСсылка.Пользователи;
//  ИсполнительЗадачи    - СправочникСсылка.Пользователи;
//  ТекущийПользователь  - СправочникСсылка.Пользователи - кто выполняет передачу.
//
// Возвращаемое значение:
//  СправочникСсылка.Пользователи - получатель уведомления или пустая ссылка.
//
Функция ПолучательПриПередачеЗадачи(СтарыйСтатус, НовыйСтатус, АвторЗадачи, ИсполнительЗадачи, ТекущийПользователь)
	
	// «Взять в работу» — задача остаётся у исполнителя, передачи нет.
	Если СтарыйСтатус = Перечисления.СтатусыЗадач.Новая
		И НовыйСтатус = Перечисления.СтатусыЗадач.ВРаботе Тогда
		Возврат Справочники.Пользователи.ПустаяСсылка();
	КонецЕсли;
	
	Если ТекущийПользователь = АвторЗадачи Тогда
		Получатель = ИсполнительЗадачи;
	ИначеЕсли ТекущийПользователь = ИсполнительЗадачи Тогда
		Получатель = АвторЗадачи;
	Иначе
		Возврат Справочники.Пользователи.ПустаяСсылка();
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(Получатель) Или Получатель = ТекущийПользователь Тогда
		Возврат Справочники.Пользователи.ПустаяСсылка();
	КонецЕсли;
	
