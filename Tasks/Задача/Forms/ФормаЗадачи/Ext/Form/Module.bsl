#Область ДействияФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ЗаполнитьКэшТэгов();
	СформироватьГиперссылкиФайловНаФорме();
	НастроитьПараметрыВыбораИсполнителя();
	
	Если НЕ Объект.Ссылка.Пустая() Тогда
		МигрироватьСтатусЕслиНужно(Объект.Ссылка);
		ЗначениеВРеквизитФормы(Объект.Ссылка.ПолучитьОбъект(), "Объект");
		СформироватьГиперссылкиФайловНаФорме();
	КонецЕсли;
	
	Если НЕ ДоступКЗадачеРазрешен(Отказ) Тогда
		Возврат;
	КонецЕсли;
	
	УстановитьПодсказкуГрупповогоДоступа();
	ЗаполнитьСписокИсполнителей();
	ЗаполнитьИсториюКомментариев();
	УстановитьДоступностьЭлементов();
	УстановитьЗаголовокФормы();
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	УстановитьДоступностьКомандСтатуса();
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	Если ИмяСобытия = "ОбновитьСтрокуПрикреплений" Тогда
		СформироватьГиперссылкиФайловНаФорме();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)
	
	ПараметрыЗаписи.Вставить("ТекстКомментария", НовыйКомментарий);
	
КонецПроцедуры

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	
	Если ПараметрыЗаписи.Свойство("ТекстКомментария") Тогда
		ТекущийОбъект.ДополнительныеСвойства.Вставить("ТекстКомментария", ПараметрыЗаписи.ТекстКомментария);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗаписи(ПараметрыЗаписи)
	
	НовыйКомментарий = "";
	УстановитьДоступностьКомандСтатуса();
	
КонецПроцедуры

&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)
	
	ЗаполнитьИсториюКомментариев();
	УстановитьДоступностьЭлементов();
	СформироватьГиперссылкиФайловНаФорме();
	УстановитьЗаголовокФормы();
	
КонецПроцедуры

// Устанавливает заголовок формы по номеру, дате и сроку выполнения задачи.
//
&НаСервере
Процедура УстановитьЗаголовокФормы()
	
	Если ЗначениеЗаполнено(Объект.Ссылка) Тогда
		лВыполнение = СтрШаблон("- %1 %2",
			НСтр("ru = 'дней выполнения'; en = 'execution days'"),
			ОбщегоНазначенияСервер.КоличествоДнейВПериоде(Объект.Дата, ТекущаяДатаСеанса()));
	Иначе
		лВыполнение = "";
	КонецЕсли;
	
	Заголовок = СтрШаблон("%1 %2 (%3) %4",
		НСтр("ru = 'Задача'; en = 'Task'"),
		Объект.Номер,
		Формат(Объект.Дата, "ДФ=dd.MM.yyyy"),
		лВыполнение);
	
КонецПроцедуры

#КонецОбласти


#Область КомандыСтатуса

&НаКлиенте
Процедура ВзятьВРаботу(Команда)
	
	// Комментарий не обязателен; ВзятоВРаботу ставится на сервере при записи.
	ПеревестиСтатус(ПредопределенноеЗначение("Перечисление.СтатусыЗадач.ВРаботе"), Ложь);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗапроситьУточнение(Команда)
	
	ПеревестиСтатус(ПредопределенноеЗначение("Перечисление.СтатусыЗадач.ТребуетУточнения"), Истина);
	
КонецПроцедуры

&НаКлиенте
Процедура ВернутьВРаботу(Команда)
	
	ПеревестиСтатус(ПредопределенноеЗначение("Перечисление.СтатусыЗадач.ВРаботе"), Истина);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗавершитьЗадачу(Команда)
	
	ПеревестиСтатус(ПредопределенноеЗначение("Перечисление.СтатусыЗадач.Выполнена"), Ложь);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗакрытьЗадачу(Команда)
	
	ПеревестиСтатус(ПредопределенноеЗначение("Перечисление.СтатусыЗадач.Закрыта"), Ложь);
	
КонецПроцедуры

&НаКлиенте
Процедура ПеревестиСтатус(НовыйСтатус, ТребоватьКомментарий = Истина)
	
	Если ТребоватьКомментарий И СокрЛП(НовыйКомментарий) = "" Тогда
		клОшибка("Для смены статуса заполните комментарий.");
		Возврат;
	КонецЕсли;
	
	Объект.Статус = НовыйСтатус;
	Если НЕ Записать() Тогда
		Возврат;
	КонецЕсли;
	
	УстановитьДоступностьКомандСтатуса();
	
КонецПроцедуры

#КонецОбласти


#Область Доступность

&НаСервере
Функция ДоступКЗадачеРазрешен(Отказ)
	
	ТекущийПользователь = гоПользователь();
	ПостановщикЗадач = гоРеквизит(ТекущийПользователь, "ПостановщикЗадач");
	ПросмотрВсехЗадач = гоРеквизит(ТекущийПользователь, "ПросмотрВсехЗадач");
	
	Если Объект.Ссылка.Пустая() Тогда
		Если НЕ ПостановщикЗадач Тогда
			Отказ = Истина;
			Сообщить("Создавать задачи может только постановщик задач.");
			Возврат Ложь;
		КонецЕсли;
		ТолькоПросмотрЗадачи = Ложь;
		Возврат Истина;
	КонецЕсли;
	
	ЭтоАвтор = Объект.Автор = ТекущийПользователь;
	ЭтоИсполнитель = Объект.Пользователь = ТекущийПользователь;
	
	Если ПросмотрВсехЗадач И НЕ ЭтоАвтор И НЕ ЭтоИсполнитель Тогда
		ТолькоПросмотрЗадачи = Истина;
		Возврат Истина;
	КонецЕсли;
	
	Если ЭтоАвтор Или ЭтоИсполнитель Тогда
		ТолькоПросмотрЗадачи = Объект.Статус = Перечисления.СтатусыЗадач.Закрыта
			Или (Объект.Статус = Перечисления.СтатусыЗадач.Выполнена И НЕ ЭтоАвтор);
		Возврат Истина;
	КонецЕсли;
	
	Отказ = Истина;
	Сообщить("Недостаточно прав для открытия задачи.");
	Возврат Ложь;
	
КонецФункции

&НаСервере
Процедура УстановитьДоступностьЭлементов()
	
	ЭтоНовый = Объект.Ссылка.Пустая();
	ТолькоПросмотр = НЕ РежимРедактирования
		И (ТолькоПросмотрЗадачи
			Или (НЕ ЭтоНовый И Объект.Статус = Перечисления.СтатусыЗадач.Закрыта));
	
	Элементы.Автор.ТолькоПросмотр 			= НЕ РежимРедактирования;
	//Элементы.Статус.ТолькоПросмотр 			= Истина;
	Элементы.ДатаВыполнения.ТолькоПросмотр 	= НЕ РежимРедактирования;
	//Элементы.История.ТолькоПросмотр 		= Истина;
	
	РольРазработка = омСервер.ЕстьРоль("Разработка"); 
	Элементы.ФормаРазрешитьРедактирование.Видимость	= РольРазработка;
	РеквизитыНовойЗадачиДоступны = ЭтоНовый ИЛИ РежимРедактирования;
	
	Элементы.Описание.ТолькоПросмотр 		= НЕ РеквизитыНовойЗадачиДоступны;
	Элементы.Комментарии.Видимость 			= РежимРедактирования;
	Элементы.Комментарии.ТолькоПросмотр 		= НЕ РежимРедактирования;
	Элементы.Комментарии.ИзменятьСоставСтрок	= РежимРедактирования;
	Элементы.Комментарии.ИзменятьПорядокСтрок = РежимРедактирования;
	Элементы.Наименование.ТолькоПросмотр 	= НЕ РеквизитыНовойЗадачиДоступны;
	Элементы.Пользователь.ТолькоПросмотр 	= НЕ ЭтоНовый И НЕ РежимРедактирования Или ТолькоПросмотр;  // исполнитель
	Элементы.Приоритет.ТолькоПросмотр 		= НЕ РеквизитыНовойЗадачиДоступны;
	Элементы.Тэги.ТолькоПросмотр 			= НЕ РеквизитыНовойЗадачиДоступны;
	Элементы.СсылкаНаОбъект.ТолькоПросмотр 	= НЕ РеквизитыНовойЗадачиДоступны;
	Элементы.ДобавитьФайл.Доступность 		= НЕ ТолькоПросмотр И НЕ ЭтоНовый;
	
	Элементы.ФормаВыполнитьИЗакрыть.Видимость = Ложь;
	
	ТекущийПользователь = гоПользователь();
	ЭтоАвтор = Объект.Автор = ТекущийПользователь;
	ЭтоИсполнитель = Объект.Пользователь = ТекущийПользователь;
	Статус = Объект.Статус;
	
	Элементы.ГруппаКомментарии.Видимость = НЕ ЭтоНовый;
	ПоказатьНовыйКомментарий = НЕ ЭтоНовый
		И ((ЭтоАвтор
				И (Статус = Перечисления.СтатусыЗадач.Новая
					Или Статус = Перечисления.СтатусыЗадач.ТребуетУточнения
					Или Статус = Перечисления.СтатусыЗадач.Выполнена))
			Или (ЭтоИсполнитель
				И (Статус = Перечисления.СтатусыЗадач.Новая
					Или Статус = Перечисления.СтатусыЗадач.ВРаботе
					Или Статус = Перечисления.СтатусыЗадач.Выполнена)));
	Элементы.НовыйКомментарий.Видимость = ПоказатьНовыйКомментарий Или РежимРедактирования;
	Элементы.НовыйКомментарий.ТолькоПросмотр = НЕ ПоказатьНовыйКомментарий И НЕ РежимРедактирования;
	Элементы.История.Видимость = НЕ ЭтоНовый
		И (Статус <> Перечисления.СтатусыЗадач.Новая
			Или Объект.Комментарии.Количество() > 0);
	
	Элементы.ВзятьВРаботу.Видимость = НЕ ТолькоПросмотр И НЕ ЭтоНовый
		И ЭтоИсполнитель И Статус = Перечисления.СтатусыЗадач.Новая;
	Элементы.ЗапроситьУточнение.Видимость = НЕ ТолькоПросмотр И НЕ ЭтоНовый
		И ЭтоИсполнитель
		И (Статус = Перечисления.СтатусыЗадач.Новая
			Или Статус = Перечисления.СтатусыЗадач.ВРаботе);
	Элементы.ВернутьВРаботу.Видимость = НЕ ТолькоПросмотр И НЕ ЭтоНовый
		И ЭтоАвтор
		И (Статус = Перечисления.СтатусыЗадач.ТребуетУточнения
			Или Статус = Перечисления.СтатусыЗадач.Выполнена);
	Элементы.ЗавершитьЗадачу.Видимость = НЕ ТолькоПросмотр И НЕ ЭтоНовый
		И ЭтоИсполнитель И Статус = Перечисления.СтатусыЗадач.ВРаботе;
	Элементы.ЗакрытьЗадачу.Видимость = НЕ ТолькоПросмотр И НЕ ЭтоНовый
		И ЭтоАвтор И Статус = Перечисления.СтатусыЗадач.Выполнена;
		
	Если РольРазработка И РежимРедактирования Тогда
		Элементы.ВзятьВРаботу.Видимость 		= Истина;
		Элементы.ЗапроситьУточнение.Видимость   = Истина;
	    Элементы.ВернутьВРаботу.Видимость       = Истина;
		Элементы.ЗавершитьЗадачу.Видимость      = Истина;
		Элементы.ЗакрытьЗадачу.Видимость        = Истина;
	КонецЕсли;	  
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьДоступностьКомандСтатуса()
	
	УстановитьДоступностьЭлементов();
	
КонецПроцедуры

&НаСервере
Процедура НастроитьПараметрыВыбораИсполнителя()
	
	МассивПараметров = Новый Массив;
	МассивПараметров.Добавить(Новый ПараметрВыбора("Отбор.ИсполнительЗадач", Истина));
	МассивПараметров.Добавить(Новый ПараметрВыбора("Отбор.ПометкаУдаления", Ложь));
	Элементы.Пользователь.ПараметрыВыбора = Новый ФиксированныйМассив(МассивПараметров);
	
КонецПроцедуры

// Заполняет пустой статус существующей задачи по флагу Выполнена.
//
// Параметры:
//  ЗадачаСсылка - ЗадачаСсылка.Задача - задача для миграции.
//
&НаСервереБезКонтекста
Процедура МигрироватьСтатусЕслиНужно(ЗадачаСсылка)
	
	Если ЗначениеЗаполнено(гоРеквизит(ЗадачаСсылка, "Статус")) Тогда
		Возврат;
	КонецЕсли;
	
	ОбъектЗадачи = ЗадачаСсылка.ПолучитьОбъект();
	ОбъектЗадачи.ДополнительныеСвойства.Вставить("МиграцияСтатусовЗадач", Истина);
	Если гоРеквизит(ЗадачаСсылка, "Выполнена") Тогда
		ОбъектЗадачи.Статус = Перечисления.СтатусыЗадач.Выполнена;
	Иначе
		ОбъектЗадачи.Статус = Перечисления.СтатусыЗадач.Новая;
	КонецЕсли;
	ОбъектЗадачи.Записать();
	
КонецПроцедуры
 
&НаКлиенте
Процедура РазрешитьРедактирование(Команда)
	
	РежимРедактирования = Истина;
	УстановитьДоступностьЭлементов();

КонецПроцедуры

#КонецОбласти


// Формирует HTML-хронологию комментариев в реквизите формы История.
//
&НаСервере
Процедура ЗаполнитьИсториюКомментариев()
	
	Части = Новый Массив;
	Части.Добавить("<!DOCTYPE html><html><head><meta charset=""utf-8"">");
	Части.Добавить("<style type=""text/css"">");
	Части.Добавить("*{box-sizing:border-box;}");
	Части.Добавить("body{margin:4px 8px;background:#ffffff;font-family:Arial,sans-serif;font-size:12pt;}");
	Части.Добавить(".comment-row{display:flex;align-items:flex-start;margin:0 0 12px 0;}");
	Части.Добавить(".comment-person{text-align:center;line-height:40px;width:40px;height:40px;max-height:40px;max-width:40px;font-size:large;font-weight:600;border-radius:50%;display:inline-block;flex-shrink:0;box-shadow:inset 0 -2px 3px rgba(0,0,0,0.18),inset 0 2px 3px rgba(255,255,255,0.45),0 1px 2px rgba(0,0,0,0.12);}");
	Части.Добавить(".comment-person-author{background:radial-gradient(circle at 30% 28%,#ffe2b0 0%,#febc65 48%,#e6a04a 100%);color:#000000;}");
	Части.Добавить(".comment-person-executor{background:radial-gradient(circle at 30% 28%,#5b8fd9 0%,#1c55ae 48%,#143f82 100%);color:#ffffff;}");
	Части.Добавить(".comment-body{display:flex;flex-direction:column;padding-left:12px;flex:1;}");
	Части.Добавить(".comment-meta{color:#4a5d73;font-size:12px;font-weight:600;margin:0 0 4px 0;}");
	Части.Добавить(".comment-text{color:#1f2933;font-size:13px;font-weight:400;line-height:1.45;white-space:pre-wrap;}");
	Части.Добавить("</style></head><body>");
	
	Для Каждого СтрокаКомментария Из Объект.Комментарии Цикл
		
		ЭтоАвторКомментария = СтрокаКомментария.Пользователь = Объект.Автор;
		КлассКружка = ?(ЭтоАвторКомментария, "comment-person comment-person-author", "comment-person comment-person-executor");
		ИмяПользователя = Строка(СтрокаКомментария.Пользователь);
		
		Части.Добавить("<div class=""comment-row"">");
		Части.Добавить(СтрШаблон("<span class=""%1"">%2</span>",
			КлассКружка,
			ЭкранироватьТекстHTML(ИнициалыПользователя(ИмяПользователя))));
		Части.Добавить("<div class=""comment-body"">");
		Части.Добавить(СтрШаблон("<div class=""comment-meta"">%1 · %2</div>",
			ЭкранироватьТекстHTML(ИмяПользователя),
			Формат(СтрокаКомментария.Дата, "ДФ='dd.MM.yyyy HH:mm:ss'")));
		Части.Добавить(СтрШаблон("<div class=""comment-text"">%1</div>",
			ЭкранироватьТекстHTML(СтрокаКомментария.Текст)));
		Части.Добавить("</div></div>");
		
	КонецЦикла;
	
	Части.Добавить("</body></html>");
	История = СтрСоединить(Части, "");
	
КонецПроцедуры

// Формирует инициалы по имени пользователя (как в чате сообщений инвойса).
//
// Параметры:
//  ИмяПользователя - Строка - представление пользователя.
//
// Возвращаемое значение:
//  Строка - одна или две буквы инициалов.
//
&НаСервере
Функция ИнициалыПользователя(Знач ИмяПользователя)
	
	ИмяПользователя = СокрЛП(СтрЗаменить(ИмяПользователя, "_", " "));
	Поз = Найти(ИмяПользователя, " ");
	Если Поз = 0 Тогда
		Возврат ВРег(Лев(ИмяПользователя, 2));
	КонецЕсли;
	
	Возврат ВРег(Лев(ИмяПользователя, 1) + Сред(ИмяПользователя, Поз + 1, 1));
	
КонецФункции

// Экранирует спецсимволы HTML и переносит строки в &lt;br&gt;.
//
// Параметры:
//  ИсходныйТекст - Строка - исходный текст.
//
// Возвращаемое значение:
//  Строка - текст, безопасный для вставки в HTML.
//
&НаСервере
Функция ЭкранироватьТекстHTML(Знач ИсходныйТекст)
	
	Результат = Строка(ИсходныйТекст);
	Результат = СтрЗаменить(Результат, "&", "&amp;");
	Результат = СтрЗаменить(Результат, "<", "&lt;");
	Результат = СтрЗаменить(Результат, ">", "&gt;");
	Результат = СтрЗаменить(Результат, """", "&quot;");
	Результат = СтрЗаменить(Результат, Символы.ПС, "<br>");
	Результат = СтрЗаменить(Результат, Символы.ВК, "");
	Возврат Результат;
	
КонецФункции

&НаСервере  
Процедура ЗаполнитьСписокИсполнителей()

	Запр = Новый Запрос;
	Запр.Текст = "ВЫБРАТЬ
	             |	Пользователи.Ссылка КАК Ссылка
	             |ИЗ
	             |	Справочник.Пользователи КАК Пользователи
	             |ГДЕ
	             |	Пользователи.ИсполнительЗадач
	             |	И НЕ Пользователи.ПометкаУдаления
	             |
	             |УПОРЯДОЧИТЬ ПО
	             |	Пользователи.Наименование";
    мас = Запр.Выполнить().Выгрузить().ВыгрузитьКолонку(0);
	Элементы.Пользователь.СписокВыбора.ЗагрузитьЗначения(мас);
	Если мас.Количество() = 1 Тогда
		Объект.Пользователь = мас[0];
	КонецЕсли;
	
КонецПроцедуры

&НаСервере 
Процедура УстановитьПодсказкуГрупповогоДоступа()

	Запр = Новый Запрос;
	Запр.Текст = "ВЫБРАТЬ
	             |	Пользователи.Наименование КАК Наименование
	             |ИЗ
	             |	Справочник.Пользователи КАК Пользователи
	             |ГДЕ
	             |	НЕ Пользователи.ПометкаУдаления
	             |	И Пользователи.ПросмотрЗадачСГрупповымДоступом
	             |
	             |УПОРЯДОЧИТЬ ПО
	             |	Наименование";     
	Выборка = Запр.Выполнить().Выбрать(); 
	Стр = "";
	Пока Выборка.Следующий() Цикл
		Стр = Стр + Выборка.Наименование + ", ";
	КонецЦикла;
    Элементы.ГрупповойДоступ.Подсказка = "Задача видна пользователям:" + Символы.ПС + Лев(Стр, СтрДлина(Стр)-2);
	
КонецПроцедуры


#Область Тэги
	
&НаСервере
Процедура ЗаполнитьКэшТэгов()
	
	КэшТэгов.Очистить();
	МасТэговЭтойЗадачи = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(Объект.Тэги, ",");
	Запр = Новый Запрос;
	Запр.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
	             |	Задача.Тэги КАК Тэги
	             |ИЗ
	             |	Задача.Задача КАК Задача
	             |ГДЕ
	             |	Задача.Тэги <> """"
	             |";
	Выборка = Запр.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		мас = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(Выборка.Тэги, ",");
		Для Каждого Эл Из мас Цикл
			тэг = СокрЛП(Эл);
			Если КэшТэгов.НайтиПоЗначению(тэг) = Неопределено Тогда
				КэшТэгов.Добавить(тэг, тэг, МасТэговЭтойЗадачи.Найти(тэг) <> Неопределено);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	КэшТэгов.СортироватьПоЗначению();
	
КонецПроцедуры

&НаКлиенте
Процедура ТэгиНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	Оповещение = Новый ОписаниеОповещения("ПослеОтметкиЭлементов", ЭтотОбъект);
	КэшТэгов.ПоказатьОтметкуЭлементов(Оповещение, "Тэги");
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеОтметкиЭлементов(Список, Параметры) Экспорт
	
	Если Список <> Неопределено Тогда
		Объект.Тэги = "";
		Для Каждого Элемент Из Список Цикл
			Если Элемент.Пометка Тогда
				Если Объект.Тэги <> "" Тогда
					Объект.Тэги = Объект.Тэги + ", ";
				КонецЕсли;
				Объект.Тэги = Объект.Тэги + Элемент.Значение;
			КонецЕсли;
		КонецЦикла;
		Модифицированность = Истина;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти


#Область РаботаСФайлами

&НаКлиенте
Процедура НажатиеГиперссылкиФайла(Элемент, СтандартнаяОбработка)
	
	ПараметрыФормы = Новый Структура("ВладелецСсылка, НазначениеФайла, ИмяАктивнойГиперссылки, ДобавлениеФайла",
		Объект.Ссылка,
		ПредопределенноеЗначение("Перечисление.НазначениеФайлов.Прочее"),
		?(Элемент = Неопределено, "", Элемент.Имя),
		Элемент = Неопределено);
	ОткрытьФорму("Обработка.Предпросмотр.Форма.ФормаПредпросмотра", ПараметрыФормы, ЭтаФорма);
	
КонецПроцедуры

&НаСервере
Процедура СформироватьГиперссылкиФайловНаФорме()
	
	ОбщегоНазначенияСервер.СформироватьГиперссылкиФайловНаФорме(Объект.Ссылка,
		ЭтаФорма,
		Элементы.ГруппаФайлы,
		Перечисления.НазначениеФайлов.Прочее,
		"НажатиеГиперссылкиФайла");
	
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьФайл(Команда)
	
	СтандартнаяОбработка = Ложь;
	НажатиеГиперссылкиФайла(Неопределено, СтандартнаяОбработка);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаВыбораФайла(ЕстьВыборПользователя, Адрес, ВыбранноеИмяФайла, ДопПараметры) Экспорт
	
	Если ЕстьВыборПользователя = Ложь Тогда
		Возврат;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Объект.Ссылка) Тогда
		ОбработкаВыбораФайлаПрикрепить(Адрес, ВыбранноеИмяФайла, ДопПараметры);
		Возврат;
	КонецЕсли;
	
	клДаНет(Новый ОписаниеОповещения("ОбработкаВыбораФайлаПослеЗаписи", ЭтотОбъект,
			Новый Структура("Адрес, ВыбранноеИмяФайла, ДопПараметры", Адрес, ВыбранноеИмяФайла, ДопПараметры)),
		НСтр("ru = 'Задача еще не записана. Записать задачу и прикрепить файл?'; en = 'Задача еще не записана. Записать задачу и прикрепить файл?'"));
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаВыбораФайлаПослеЗаписи(Результат, Параметры) Экспорт
	
	Если НЕ Результат Тогда
		Возврат;
	КонецЕсли;
	
	Записать();
	ОбработкаВыбораФайлаПрикрепить(Параметры.Адрес, Параметры.ВыбранноеИмяФайла, Параметры.ДопПараметры);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаВыбораФайлаПрикрепить(Адрес, ВыбранноеИмяФайла, ДопПараметры)
	
	Если ОбщегоНазначенияСервер.ПолучитьТипКлиента() = "WebServerExtension" Тогда
		л_ОписаниеФайла = Новый Структура();
		л_ОписаниеФайла.Вставить("Имя", ВыбранноеИмяФайла);
		л_ОписаниеФайла.Вставить("ИмяБезРасширения", ОбщегоНазначения.ПолучитьИмяБезРасширения(ВыбранноеИмяФайла));
		л_ОписаниеФайла.Вставить("ПолноеИмя", "");
		л_ОписаниеФайла.Вставить("Путь", "");
		л_ОписаниеФайла.Вставить("Расширение", ОбщегоНазначения.ПолучитьРасширение(ВыбранноеИмяФайла));
		л_ОписаниеФайла.Вставить("Размер", ПолучитьИзВременногоХранилища(Адрес).Размер());
		л_ОписаниеФайла.Вставить("Назначение", ДопПараметры);
		
		л_Отказ = Ложь;
		л_Сообщение = "";
		л_КлючЗаписи = Новый Структура("ОбъектУИД,ОбъектСсылка,МестоХраненияФайлов,ИмяФайла,РасширениеИмениФайла,Автор");
		
		ОбщегоНазначенияСервер.ДобавитьВложенныйФайл(Адрес, Объект.Ссылка, л_ОписаниеФайла, л_Отказ, , л_КлючЗаписи, л_Сообщение);
		
		Если НЕ л_Отказ Тогда
			ЭтаФорма.ОтобразитьИзменениеДанных(л_КлючЗаписи, ВидИзмененияДанных.Добавление);
			Оповестить("ОбновитьСтрокуПрикреплений", л_ОписаниеФайла.Имя, ЭтаФорма);
		КонецЕсли;
		
		Если НЕ ПустаяСтрока(л_Сообщение) Тогда
			Сообщить(л_Сообщение);
		КонецЕсли;
		
	Иначе
		
		л_Файл = Новый Файл(ВыбранноеИмяФайла);
		л_ОписаниеФайла = Новый Структура("Имя,ИмяБезРасширения,ПолноеИмя,Путь,Расширение");
		ЗаполнитьЗначенияСвойств(л_ОписаниеФайла, л_Файл);
		л_ОписаниеФайла.Вставить("Размер", 0);
		л_ОписаниеФайла.Вставить("Файл", л_Файл);
		л_ОписаниеФайла.Вставить("АдресВременногоХранилища", Адрес);
		л_ОписаниеФайла.Вставить("Назначение", ДопПараметры);
		
		л_Файл.НачатьПроверкуСуществования(Новый ОписаниеОповещения("ПослеПроверкиСуществованияФайла", ЭтаФорма, л_ОписаниеФайла));
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеПроверкиСуществованияФайла(ФайлСуществует, ПараметрыФайла) Экспорт
	
	Если ФайлСуществует Тогда
		ПараметрыФайла.Файл.НачатьПолучениеРазмера(Новый ОписаниеОповещения("ПослеПолученияРазмераФайла", ЭтаФорма, ПараметрыФайла));
	Иначе
		клОшибка(СтрШаблон(НСтр("ru = 'Папка %1 не существует!'; en = 'Folder %1 does not exist!'"), ПараметрыФайла.Путь));
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеПолученияРазмераФайла(Результат, Параметр) Экспорт
	
	Параметр.Размер = Результат;
	Параметр.Удалить("Файл");
	
	л_Отказ = Ложь;
	л_Сообщение = "";
	л_КлючЗаписи = Новый Структура("ОбъектУИД,ОбъектСсылка,МестоХраненияФайлов,ИмяФайла,РасширениеИмениФайла,Автор,НазначениеФайла");
	
	ОбщегоНазначенияСервер.ДобавитьВложенныйФайл(Параметр.АдресВременногоХранилища, Объект.Ссылка, Параметр, л_Отказ, , л_КлючЗаписи, л_Сообщение);
	
	Если НЕ л_Отказ Тогда
		ЭтаФорма.ОтобразитьИзменениеДанных(л_КлючЗаписи, ВидИзмененияДанных.Добавление);
		Оповестить("ОбновитьСтрокуПрикреплений", Параметр.Имя, ЭтаФорма);
	КонецЕсли;
	
	Если НЕ ПустаяСтрока(л_Сообщение) Тогда
		Сообщить(л_Сообщение);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти
