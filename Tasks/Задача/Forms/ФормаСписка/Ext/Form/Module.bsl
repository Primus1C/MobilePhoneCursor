&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ТекущийПользователь = гоПользователь();
	Если НЕ ЗначениеЗаполнено(ТекущийПользователь) Тогда
		Отказ = Истина;
		Сообщить("Не определён текущий пользователь.");
		Возврат;
	КонецЕсли;
	
	РеквизитыПользователя = Новый Структура(
		"ПостановщикЗадач,ИсполнительЗадач,ПросмотрВсехЗадач",
		гоРеквизит(ТекущийПользователь, "ПостановщикЗадач"),
		гоРеквизит(ТекущийПользователь, "ИсполнительЗадач"),
		гоРеквизит(ТекущийПользователь, "ПросмотрВсехЗадач"));
	
	Если НЕ РеквизитыПользователя.ПостановщикЗадач
		И НЕ РеквизитыПользователя.ИсполнительЗадач
		И НЕ РеквизитыПользователя.ПросмотрВсехЗадач Тогда
		Отказ = Истина;
		Сообщить("Недостаточно прав для работы с задачами.");
		Возврат;
	КонецЕсли;
	
	МигрироватьСтатусыЗадач();
	НастроитьОтборСписка(ТекущийПользователь, РеквизитыПользователя);
	
	ФильтрСтатусНовая 			= Истина;
	ФильтрСтатусВРаботе 		= Истина;
	ФильтрСтатусТребуетУточнения = Истина;
	ФильтрСтатусВыполнена 		= Истина;
	ФильтрСтатусЗакрыта 		= Ложь;
	УстановитьОтборПоСтатусам();
	
	Если Элементы.Найти("ФормаСоздать") <> Неопределено Тогда
		Элементы.ФормаСоздать.Доступность = РеквизитыПользователя.ПостановщикЗадач;
		Элементы.ФормаСоздать.Видимость = РеквизитыПользователя.ПостановщикЗадач;
	КонецЕсли;
	
	Элементы.ДекорацияИнфо.Заголовок = Константы.ИнфоПользователейЗадач.Получить();
	Элементы. ДекорацияКартинка.Видимость = ЗначениеЗаполнено(Элементы.ДекорацияИнфо.Заголовок);
	
КонецПроцедуры

// Настраивает отбор динамического списка по ролям текущего пользователя.
//
// Параметры:
//  ТекущийПользователь   - СправочникСсылка.Пользователи;
//  РеквизитыПользователя - Структура - флаги ПостановщикЗадач, ИсполнительЗадач, ПросмотрВсехЗадач.
//
&НаСервере
Процедура НастроитьОтборСписка(ТекущийПользователь, РеквизитыПользователя)
	
	Список.Отбор.Элементы.Очистить();
	
	Если РеквизитыПользователя.ПросмотрВсехЗадач Тогда
		Возврат;
	КонецЕсли;
	
	ГруппаИли = Список.Отбор.Элементы.Добавить(Тип("ГруппаЭлементовОтбораКомпоновкиДанных"));
	ГруппаИли.ТипГруппы = ТипГруппыЭлементовОтбораКомпоновкиДанных.ГруппаИли;
	ГруппаИли.Использование = Истина;
	
	Если РеквизитыПользователя.ПостановщикЗадач Тогда
		ЭлементОтбора = ГруппаИли.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Автор");
		ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
		ЭлементОтбора.ПравоеЗначение = ТекущийПользователь;
		ЭлементОтбора.Использование = Истина;
	КонецЕсли;
	
	Если РеквизитыПользователя.ИсполнительЗадач Тогда
		ЭлементОтбора = ГруппаИли.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Пользователь");
		ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
		ЭлементОтбора.ПравоеЗначение = ТекущийПользователь;
		ЭлементОтбора.Использование = Истина;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ФильтрСтатусПриИзменении(Элемент)
	
	УстановитьОтборПоСтатусам();
	
КонецПроцедуры

// Устанавливает отбор списка по отмеченным статусам (логика «ИЛИ»: видны задачи любого из выбранных статусов).
//
&НаСервере
Процедура УстановитьОтборПоСтатусам()
	
	Статусы = Новый СписокЗначений;
	Если ФильтрСтатусНовая Тогда
		Статусы.Добавить(Перечисления.СтатусыЗадач.Новая);
	КонецЕсли;
	Если ФильтрСтатусВРаботе Тогда
		Статусы.Добавить(Перечисления.СтатусыЗадач.ВРаботе);
	КонецЕсли;
	Если ФильтрСтатусТребуетУточнения Тогда
		Статусы.Добавить(Перечисления.СтатусыЗадач.ТребуетУточнения);
	КонецЕсли;
	Если ФильтрСтатусВыполнена Тогда
		Статусы.Добавить(Перечисления.СтатусыЗадач.Выполнена);
	КонецЕсли;
	Если ФильтрСтатусЗакрыта Тогда
		Статусы.Добавить(Перечисления.СтатусыЗадач.Закрыта);
	КонецЕсли;
	
	ЭлементОтбора = Неопределено;
	Для Каждого Элемент Из Список.Отбор.Элементы Цикл
		Если ТипЗнч(Элемент) = Тип("ЭлементОтбораКомпоновкиДанных")
			И Строка(Элемент.ЛевоеЗначение) = "Статус" Тогда
			ЭлементОтбора = Элемент;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Если ЭлементОтбора = Неопределено Тогда
		ЭлементОтбора = Список.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Статус");
		ЭлементОтбора.РежимОтображения = РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Недоступный;
	КонецЕсли;
	
	ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.ВСписке;
	ЭлементОтбора.ПравоеЗначение = Статусы;
	ЭлементОтбора.Использование = Истина;
	
КонецПроцедуры

// Заполняет пустой статус существующих задач по флагу Выполнена.
//
&НаСервереБезКонтекста
Процедура МигрироватьСтатусыЗадач()
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Задача.Ссылка КАК Ссылка,
	|	Задача.Выполнена КАК Выполнена
	|ИЗ
	|	Задача.Задача КАК Задача
	|ГДЕ
	|	Задача.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыЗадач.ПустаяСсылка)";
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ОбъектЗадачи = Выборка.Ссылка.ПолучитьОбъект();
		ОбъектЗадачи.ДополнительныеСвойства.Вставить("МиграцияСтатусовЗадач", Истина);
		Если Выборка.Выполнена Тогда
			ОбъектЗадачи.Статус = Перечисления.СтатусыЗадач.Выполнена;
		Иначе
			ОбъектЗадачи.Статус = Перечисления.СтатусыЗадач.Новая;
		КонецЕсли;
		ОбъектЗадачи.Записать();
	КонецЦикла;
	
КонецПроцедуры
