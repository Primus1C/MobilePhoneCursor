
&НаСервереБезКонтекста
Процедура СписокПриПолученииДанныхНаСервере(ИмяЭлемента, Настройки, Строки)
	
	Запр = Новый Запрос;
	Запр.УстановитьПараметр("Ссылки", Строки.ПолучитьКлючи());
	Запр.Текст = "ВЫБРАТЬ
	             |	УстановкаЦенВидыЦен.Ссылка КАК Ссылка,
	             |	УстановкаЦенВидыЦен.ВидЦены КАК ВидЦены,
	             |	УстановкаЦенВидыЦен.Валюта.Код КАК КодВалюты
	             |ИЗ
	             |	Документ.УстановкаЦен.ВидыЦен КАК УстановкаЦенВидыЦен
	             |ГДЕ
	             |	УстановкаЦенВидыЦен.Ссылка В(&Ссылки)
	             |
	             |УПОРЯДОЧИТЬ ПО
	             |	УстановкаЦенВидыЦен.Ссылка,
	             |	УстановкаЦенВидыЦен.НомерСтроки";
	
	ВидыПоДокументам = Новый Соответствие;
	Выборка = Запр.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		
		СписокВидов = ВидыПоДокументам.Получить(Выборка.Ссылка);
		Если СписокВидов = Неопределено Тогда
			СписокВидов = Новый СписокЗначений;
			ВидыПоДокументам.Вставить(Выборка.Ссылка, СписокВидов);
		КонецЕсли;
		
		Представление = СтрШаблон("%1 (%2)", Выборка.ВидЦены, СокрЛП(Строка(Выборка.КодВалюты)));
		СписокВидов.Добавить(Представление);
		
	КонецЦикла;
	
	Для Каждого КлючИЗначение Из Строки Цикл
		
		СписокВидов = ВидыПоДокументам.Получить(КлючИЗначение.Ключ);
		Если СписокВидов = Неопределено Тогда
			СписокВидов = Новый СписокЗначений;
		КонецЕсли;
		КлючИЗначение.Значение.Данные.ВидыЦенИВалюты = СписокВидов;
		
	КонецЦикла;
	
КонецПроцедуры