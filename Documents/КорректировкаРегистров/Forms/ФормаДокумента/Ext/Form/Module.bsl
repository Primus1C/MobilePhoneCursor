
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ПоказатьРегистры();
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовФормы

// Подключаемый обработчик начала редактирования строки таблицы движений.
//
// Параметры:
//  Элемент     - ТаблицаФормы - таблица движений регистра;
//  НоваяСтрока - Булево - признак добавления новой строки;
//  Копирование - Булево - признак копирования строки.
//
&НаКлиенте
Процедура Подключаемый_ТаблицаПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	
	Если НоваяСтрока Тогда
		Если Элемент.ТекущиеДанные.Свойство("Период") Тогда
			Элемент.ТекущиеДанные.Период = Объект.Дата;
		КонецЕсли;
		ОбновитьШрифтыЗаголовковСтраниц(ЭтотОбъект);
	КонецЕсли;
	
КонецПроцедуры

// Подключаемый обработчик изменения состава строк таблицы движений.
//
// Параметры:
//  Элемент - ТаблицаФормы - таблица движений регистра.
//
&НаКлиенте
Процедура Подключаемый_ТаблицаПриИзмененииСостава(Элемент)
	
	ОбновитьШрифтыЗаголовковСтраниц(ЭтотОбъект);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ПоказатьРегистры()
	
	МетаданныеДокумента = Метаданные.Документы.КорректировкаРегистров;
	
	Для Каждого МетаданныеРегистра Из МетаданныеДокумента.Движения Цикл
		ПоказатьТаблицуРегистраНаСтранице(МетаданныеРегистра);
	КонецЦикла;
	
	ОбновитьШрифтыЗаголовковСтраниц(ЭтотОбъект);
	
КонецПроцедуры

// Создаёт страницу и таблицу формы для регистра из состава движений документа.
//
// Параметры:
//  МетаданныеРегистра - ОбъектМетаданных - метаданные регистра накопления или сведений.
//
&НаСервере
Процедура ПоказатьТаблицуРегистраНаСтранице(МетаданныеРегистра)
	
	ИмяРегистра = МетаданныеРегистра.Имя;
	
	Если Метаданные.РегистрыНакопления.Содержит(МетаданныеРегистра) Тогда
		СтраницаРодитель = Элементы.НастройкаРегистровНакопления;
		МенеджерРегистра = РегистрыНакопления[ИмяРегистра];
	ИначеЕсли Метаданные.РегистрыСведений.Содержит(МетаданныеРегистра) Тогда
		СтраницаРодитель = Элементы.НастройкаРегистровСведений;
		МенеджерРегистра = РегистрыСведений[ИмяРегистра];
	Иначе
		Возврат;
	КонецЕсли;
	
	МассивКолонок = СоздатьМассивПолейРегистра(МенеджерРегистра, МетаданныеРегистра);
	СтраницаДляРегистра = СоздатьСтраницу("Страница" + ИмяРегистра, МетаданныеРегистра.Синоним, СтраницаРодитель);
	ТаблицаФормы = СоздатьТаблицуФормыРегистра(ИмяРегистра, МассивКолонок, СтраницаДляРегистра);
	
	ТаблицаФормы.УстановитьДействие("ПриНачалеРедактирования", "Подключаемый_ТаблицаПриНачалеРедактирования");
	ТаблицаФормы.УстановитьДействие("ПослеУдаления", "Подключаемый_ТаблицаПриИзмененииСостава");
	
КонецПроцедуры

// Создаёт страницу панели для регистра.
//
// Параметры:
//  ИмяСтраницы - Строка - имя элемента формы;
//  Заголовок   - Строка - заголовок страницы;
//  Родитель    - ГруппаФормы - родительская группа страниц.
//
// Возвращаемое значение:
//  ГруппаФормы - созданная страница.
//
&НаСервере
Функция СоздатьСтраницу(ИмяСтраницы, Заголовок, Родитель)
	
	НовыйЭлемент = Элементы.Добавить(ИмяСтраницы, Тип("ГруппаФормы"), Родитель);
	НовыйЭлемент.Вид = ВидГруппыФормы.Страница;
	НовыйЭлемент.Заголовок = Заголовок;
	НовыйЭлемент.РастягиватьПоВертикали = Истина;
	НовыйЭлемент.РастягиватьПоГоризонтали = Истина;
	
	Возврат НовыйЭлемент;
	
КонецФункции

// Создаёт таблицу формы, связанную с набором записей движений регистра.
//
// Параметры:
//  ИмяРегистра   - Строка - имя регистра;
//  КолонкиТаблицы - Массив из Структура - описание колонок;
//  Родитель      - ГруппаФормы - страница регистра.
//
// Возвращаемое значение:
//  ТаблицаФормы - созданная таблица.
//
&НаСервере
Функция СоздатьТаблицуФормыРегистра(ИмяРегистра, КолонкиТаблицы, Родитель)
	
	ТаблицаФормы = Элементы.Добавить("ТаблицаДвижений" + ИмяРегистра, Тип("ТаблицаФормы"), Родитель);
	ТаблицаФормы.ПутьКДанным = "Объект.Движения." + ИмяРегистра;
	Родитель.ПутьКДаннымЗаголовка = ТаблицаФормы.ПутьКДанным + ".КоличествоСтрок";
	
	МассивДобавленныхПолей = Новый Массив;
	Для Каждого Колонка Из КолонкиТаблицы Цикл
		ПолеФормы = Элементы.Добавить(ТаблицаФормы.Имя + Колонка.Имя, Тип("ПолеФормы"), ТаблицаФормы);
		ПолеФормы.ПутьКДанным = ТаблицаФормы.ПутьКДанным + "." + Колонка.Имя;
		ПолеФормы.Заголовок = Колонка.Заголовок;
		ПолеФормы.Вид = ВидПоляФормы.ПолеВвода;
		МассивДобавленныхПолей.Добавить(ПолеФормы);
	КонецЦикла;
	
	Счетчик = 0;
	Для Каждого ПолеФормы Из МассивДобавленныхПолей Цикл
		Если КолонкиТаблицы[Счетчик].СвязиПараметровВыбора <> Неопределено
			И КолонкиТаблицы[Счетчик].СвязиПараметровВыбора.Количество() > 0 Тогда
			ПолеФормы.СвязиПараметровВыбора = СоздатьСвязиПараметровВыбора(
				КолонкиТаблицы[Счетчик].СвязиПараметровВыбора,
				"Элементы." + ТаблицаФормы.Имя + ".ТекущиеДанные");
		КонецЕсли;
		Счетчик = Счетчик + 1;
	КонецЦикла;
	
	Возврат ТаблицаФормы;
	
КонецФункции

// Формирует описание колонок таблицы по метаданным регистра.
//
// Параметры:
//  МенеджерРегистра   - РегистрНакопленияМенеджер, РегистрСведенийМенеджер - менеджер регистра;
//  МетаданныеРегистра - ОбъектМетаданных - метаданные регистра.
//
// Возвращаемое значение:
//  Массив из Структура - колонки с ключами Имя, Заголовок, СвязиПараметровВыбора.
//
&НаСервере
Функция СоздатьМассивПолейРегистра(МенеджерРегистра, МетаданныеРегистра)
	
	ТаблицаРегистра = МенеджерРегистра.СоздатьНаборЗаписей().ВыгрузитьКолонки();
	ТаблицаРегистра.Колонки.Удалить("Регистратор");
	Если ТаблицаРегистра.Колонки.Найти("МоментВремени") <> Неопределено Тогда
		ТаблицаРегистра.Колонки.Удалить("МоментВремени");
	КонецЕсли;
	
	МассивКолонок = Новый Массив;
	Для Каждого Колонка Из ТаблицаРегистра.Колонки Цикл
		МассивКолонок.Добавить(Новый Структура("Имя, Заголовок, СвязиПараметровВыбора", Колонка.Имя));
	КонецЦикла;
	
	ВидыПолей = Новый Массив;
	ВидыПолей.Добавить("Измерения");
	ВидыПолей.Добавить("Ресурсы");
	ВидыПолей.Добавить("Реквизиты");
	
	Для Каждого ВидПоля Из ВидыПолей Цикл
		Для Каждого Поле Из МетаданныеРегистра[ВидПоля] Цикл
			Для Каждого ЭлементМассива Из МассивКолонок Цикл
				Если ЭлементМассива.Имя = Поле.Имя Тогда
					ЭлементМассива.Заголовок = Поле.Синоним;
					ЭлементМассива.СвязиПараметровВыбора = Поле.СвязиПараметровВыбора;
				КонецЕсли;
			КонецЦикла;
		КонецЦикла;
	КонецЦикла;
	
	Для Каждого ЭлементМассива Из МассивКолонок Цикл
		Если Не ЗначениеЗаполнено(ЭлементМассива.Заголовок) Тогда
			Если ЭлементМассива.Имя = "Период" Тогда
				ЭлементМассива.Заголовок = НСтр("ru = 'Период'");
			ИначеЕсли ЭлементМассива.Имя = "НомерСтроки" Тогда
				ЭлементМассива.Заголовок = НСтр("ru = 'N'");
			ИначеЕсли ЭлементМассива.Имя = "Активность" Тогда
				ЭлементМассива.Заголовок = НСтр("ru = 'Активность'");
			ИначеЕсли ЭлементМассива.Имя = "ВидДвижения" Тогда
				ЭлементМассива.Заголовок = НСтр("ru = 'Вид движения'");
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	Возврат МассивКолонок;
	
КонецФункции

// Преобразует связи параметров выбора метаданных в связи элементов формы.
//
// Параметры:
//  ИсходныйМассив - КоллекцияЗначенийСвойстваОбъектаМетаданных - исходные связи;
//  ПутьКДанным    - Строка - префикс пути к данным текущей строки таблицы.
//
// Возвращаемое значение:
//  ФиксированныйМассив - связи параметров выбора для поля формы.
//
&НаСервере
Функция СоздатьСвязиПараметровВыбора(ИсходныйМассив, ПутьКДанным)
	
	НовыйМассив = Новый Массив;
	Для Каждого Элемент Из ИсходныйМассив Цикл
		НовыйМассив.Добавить(Новый СвязьПараметраВыбора(
			Элемент.Имя,
			ПутьКДанным + "." + Элемент.ПутьКДанным,
			Элемент.ИзменениеЗначения));
	КонецЦикла;
	
	Возврат Новый ФиксированныйМассив(НовыйМассив);
	
КонецФункции

// Делает жирным заголовок страницы регистра, если в наборе есть строки, и родительской закладки вида регистров.
//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения - форма документа.
//
&НаКлиентеНаСервереБезКонтекста
Процедура ОбновитьШрифтыЗаголовковСтраниц(Форма)
	
	ЕстьДвиженияНакопления = ОбновитьШрифтыСтраницРегистров(
		Форма, Форма.Элементы.НастройкаРегистровНакопления);
	ЕстьДвиженияСведений = ОбновитьШрифтыСтраницРегистров(
		Форма, Форма.Элементы.НастройкаРегистровСведений);
	
	УстановитьЖирныйШрифтЗаголовка(Форма.Элементы.РегистрыНакопления, ЕстьДвиженияНакопления);
	УстановитьЖирныйШрифтЗаголовка(Форма.Элементы.РегистрыСведений, ЕстьДвиженияСведений);
	
КонецПроцедуры

// Обновляет шрифт заголовков страниц регистров в группе и возвращает признак наличия строк.
//
// Параметры:
//  Форма      - ФормаКлиентскогоПриложения - форма документа;
//  ГруппаСтраниц - ГруппаФормы - группа страниц регистров.
//
// Возвращаемое значение:
//  Булево - Истина, если хотя бы у одного регистра есть строки.
//
&НаКлиентеНаСервереБезКонтекста
Функция ОбновитьШрифтыСтраницРегистров(Форма, ГруппаСтраниц)
	
	ЕстьДанные = Ложь;
	
	Для Каждого СтраницаРегистра Из ГруппаСтраниц.ПодчиненныеЭлементы Цикл
		
		ИмяРегистра = СтрЗаменить(СтраницаРегистра.Имя, "Страница", "");
		ЕстьСтроки = Форма.Объект.Движения[ИмяРегистра].Количество() > 0;
		УстановитьЖирныйШрифтЗаголовка(СтраницаРегистра, ЕстьСтроки);
		Если ЕстьСтроки Тогда
			ЕстьДанные = Истина;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат ЕстьДанные;
	
КонецФункции

// Устанавливает или сбрасывает жирный шрифт заголовка страницы.
//
// Параметры:
//  Страница   - ГруппаФормы - страница формы;
//  ЖирныйШрифт - Булево - Истина, чтобы выделить заголовок.
//
&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьЖирныйШрифтЗаголовка(Страница, ЖирныйШрифт)
	
	Страница.ШрифтЗаголовка = Новый Шрифт(Страница.ШрифтЗаголовка, , , ЖирныйШрифт);
	
КонецПроцедуры

#КонецОбласти
