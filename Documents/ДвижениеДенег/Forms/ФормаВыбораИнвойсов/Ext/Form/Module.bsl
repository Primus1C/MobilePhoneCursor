#Область СобытияФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Курс 	= Параметры.Курс;
	Валюта 	= Параметры.Валюта; 
	Вал 	= Валюта.Символ; 
	
	//Элементы.ИнвойсыИнвойсСумма.Заголовок = СтрШаблон("%1 (%2)", НСтр("ru = 'Сумма'; en = 'Сумма'"), Вал); 
	Элементы.ИнвойсыПривязано.Заголовок = СтрШаблон("%1 (%2)", НСтр("ru = 'Привязано'; en = 'Привязано'"), Вал); 
	Элементы.ИнвойсыОстатокДолга.Заголовок = СтрШаблон("%1 (%2)", НСтр("ru = 'Остаток долга'; en = 'Остаток долга'"), Вал); 
	Если Параметры.Дата <> Дата(1,1,1) Тогда
		Дата = Параметры.Дата;  
		лДата = Дата;    
	ИначеЕсли ЗначениеЗаполнено(Параметры.Документ.Ссылка) Тогда
		Дата = Параметры.Документ.Ссылка.МоментВремени();  
		лДата = Параметры.Документ.Ссылка.МоментВремени().Дата;
	Иначе
		Дата = ТекущаяДатаСеанса();
		лДата = Дата;
	КонецЕсли;
	//Заголовок = СтрШаблон("%1: %2 %3", Параметры.Контрагент, НСтр("ru = 'оплата (привязка) инвойсов на'; en = 'payment (binding) of invoices at'"), лДата);
	Заголовок = СтрШаблон("%1: %2", Параметры.Контрагент, НСтр("ru = 'оплата (привязка) инвойсов'; en = 'payment (binding) of invoices'"));
	
	//СуммаОбщая = Параметры.Документ.Сумма - Параметры.Документ.СуммаПривязаноИнвойсов;
	СуммаОбщая 			= Параметры.Документ.Сумма;
	СуммаПривязано 		= Параметры.Документ.СуммаПривязаноИнвойсов;
	СуммаНеПривязано 	= Макс(0, СуммаОбщая - СуммаПривязано);
	
	глПокраситьВалютыТЗ(ЭтаФорма, "ИнвойсыИнвойсВалюта", "Инвойсы.Инвойс.ДокументОснование.Валюта");  
	
	Запрос = Новый Запрос;     
	// значения формы док-та
	Запрос.УстановитьПараметр("Контрагент", 		Параметры.Контрагент);
	Запрос.УстановитьПараметр("ДвижениеДенег",		Параметры.Документ.Ссылка);
	Запрос.УстановитьПараметр("Проведен",			Параметры.Документ.Ссылка.Проведен);
	Запрос.УстановитьПараметр("ТЧ", 				Параметры.ИнвойсыТЧ.Выгрузить());  
	Запрос.УстановитьПараметр("Курс", 				Курс);
	Запрос.УстановитьПараметр("Валюта", 			Валюта);
	Запрос.УстановитьПараметр("НоменклатураСкидка", Константы.НоменклатураСкидка.Получить());	// значения ссылки док-та
	Запрос.УстановитьПараметр("Дата", ?(ЗначениеЗаполнено(Дата), Дата, ТекущаяДатаСеанса()));
	Запрос.Текст = ТекстЗапросаВыбораИнвойсовДляПривязки();
	Выгрузка = Запрос.Выполнить().Выгрузить();
	ДополнитьТаблицуИнвойсовПослеЗапроса(Выгрузка);
	ЗаполнитьСтатусыПроведенияИнвойсов(Выгрузка);
	Инвойсы.Загрузить(Выгрузка);
	
	масИнвойсыДокумента = Параметры.ИнвойсыТЧ.Выгрузить().ВыгрузитьКолонку("Инвойс");
	ЗаполнитьВыбранныеИнвойсыИКорректировкуКР(масИнвойсыДокумента, Параметры.СуммаКР);
	СуммаПривязано = Инвойсы.Итог("Привязано");
	СуммаНеПривязано = Макс(0, СуммаОбщая - СуммаПривязано);
	УстановитьУсловноеОформление();
	
КонецПроцедуры

// Текст запроса списка инвойсов для привязки (группировка товар + скидка по ИнвойсЗакупки).
// Сумма документа: Количество × (ЦенаИнвойса + Наценка), наценка — к цене, если в шапке включена Наценка.
// Инвойс скидки / парный товарный без остатка в регистре попадают в список с долгом 0 (не с суммой документа).
//
// Возвращаемое значение:
//  Строка - текст запроса.
//
Функция ТекстЗапросаВыбораИнвойсовДляПривязки()
	
	Возврат "ВЫБРАТЬ
		|	тч.Инвойс КАК Инвойс,
		|	тч.Сумма КАК Сумма,
		|	тч.СуммаОплаты КАК СуммаОплаты,
		|	тч.СуммаКР КАК СуммаКР,
		|	тч.НеПересчитыватьПриходТовара КАК НеПересчитыватьПриходТовара
		|ПОМЕСТИТЬ ТЧ
		|ИЗ
		|	&тч КАК тч
		|;
		|////////////////////////////////////////////////////////////////////////////////
		|
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ИнвойсТовары.Ссылка КАК Инвойс
		|ПОМЕСТИТЬ ИнвойсыСоСкидкой
		|ИЗ
		|	Документ._Инвойс.ВКД_Товары КАК ИнвойсТовары
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ._Инвойс КАК _Инвойс
		|		ПО ИнвойсТовары.Ссылка = _Инвойс.Ссылка
		|ГДЕ
		|	ИнвойсТовары.Номенклатура = &НоменклатураСкидка
		|	И _Инвойс.Контрагент = &Контрагент
		|	И _Инвойс.Проведен
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	Парные.Инвойс КАК Инвойс
		|ПОМЕСТИТЬ ПарныеТоварныеИнвойсы
		|ИЗ
		|	(ВЫБРАТЬ
		|			Товарный.Ссылка КАК Инвойс
		|		ИЗ
		|			ИнвойсыСоСкидкой КАК ИнвойсыСоСкидкой
		|				ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ._Инвойс КАК ИнвойсСкидки
		|				ПО ИнвойсыСоСкидкой.Инвойс = ИнвойсСкидки.Ссылка
		|				ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ._Инвойс КАК Товарный
		|				ПО Товарный.ДокументОснование = ИнвойсСкидки.ДокументОснование
		|					И Товарный.ДокументОснование <> ЗНАЧЕНИЕ(Документ.ИнвойсЗакупки.ПустаяСсылка)
		|					И (Товарный.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацииИнвойс.Товар)
		|						ИЛИ Товарный.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацииИнвойс.ПустаяСсылка))
		|					И Товарный.Контрагент = &Контрагент
		|					И Товарный.Проведен
		|		
		|		ОБЪЕДИНИТЬ
		|		
		|		ВЫБРАТЬ
		|			Товарный.Ссылка
		|		ИЗ
		|			РегистрНакопления.РасчетыПоИнвойсам.Остатки(, Контрагент = &Контрагент) КАК РасчетыПоИнвойсам
		|				ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ._Инвойс КАК ИнвойсСкидки
		|				ПО РасчетыПоИнвойсам.Инвойс = ИнвойсСкидки.Ссылка
		|				ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ._Инвойс КАК Товарный
		|				ПО Товарный.ДокументОснование = ИнвойсСкидки.ДокументОснование
		|					И Товарный.ДокументОснование <> ЗНАЧЕНИЕ(Документ.ИнвойсЗакупки.ПустаяСсылка)
		|					И (Товарный.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацииИнвойс.Товар)
		|						ИЛИ Товарный.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацииИнвойс.ПустаяСсылка))
		|					И Товарный.Контрагент = &Контрагент
		|					И Товарный.Проведен
		|		ГДЕ
		|			ИнвойсСкидки.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацииИнвойс.Скидка)) КАК Парные
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	Свод.Инвойс КАК Инвойс,
		|	СУММА(Свод.Сумма) КАК Долг,
		|	СУММА(Свод.СуммаОплаты) КАК Привязано,
		|	СУММА(Свод.СуммаКР) КАК СуммаКР,
		|	ЕСТЬNULL(МАКСИМУМ(Свод.НеПересчитыватьПриходТовара), ЛОЖЬ) КАК НеПересчитыватьПриходТовара
		|ПОМЕСТИТЬ ВзаиморасчетыПоИнвойсу
		|ИЗ
		|	(ВЫБРАТЬ
		|			""Данные из формы документа"" КАК Источник,
		|			ТЧ.Инвойс КАК Инвойс,
		|			-ТЧ.Сумма КАК Сумма,
		|			ТЧ.СуммаОплаты КАК СуммаОплаты,
		|			ТЧ.СуммаКР КАК СуммаКР,
		|			ТЧ.НеПересчитыватьПриходТовара КАК НеПересчитыватьПриходТовара
		|		ИЗ
		|			ТЧ КАК ТЧ
		|		
		|		ОБЪЕДИНИТЬ ВСЕ
		|		
		|		ВЫБРАТЬ
		|			""Движения текущего документа в РН (возвращаем в остаток)"",
		|			РасчетыДокумента.Инвойс,
		|			РасчетыДокумента.Сумма,
		|			0,
		|			0,
		|			NULL
		|		ИЗ
		|			РегистрНакопления.РасчетыПоИнвойсам КАК РасчетыДокумента
		|		ГДЕ
		|			РасчетыДокумента.Регистратор = &ДвижениеДенег
		|			И РасчетыДокумента.Активность
		|			И РасчетыДокумента.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход)
		|			И РасчетыДокумента.Контрагент = &Контрагент
		|			И РасчетыДокумента.Инвойс <> ЗНАЧЕНИЕ(Документ._Инвойс.ПустаяСсылка)
		|		
		|		ОБЪЕДИНИТЬ ВСЕ
		|		
		|		ВЫБРАТЬ
		|			""Данные из РН РасчетыПоИнвойсам, не на дату, а все; включают движения тек.док-та"",
		|			РасчетыПоИнвойсам.Инвойс,
		|			РасчетыПоИнвойсам.СуммаОстаток,
		|			0,
		|			0,
		|			NULL
		|		ИЗ
		|			РегистрНакопления.РасчетыПоИнвойсам.Остатки(, Контрагент = &Контрагент) КАК РасчетыПоИнвойсам
		|		
		|		ОБЪЕДИНИТЬ ВСЕ
		|		
		|		ВЫБРАТЬ
		|			""Инвойсы со скидкой"",
		|			ИнвойсыСоСкидкой.Инвойс,
		|			0,
		|			0,
		|			0,
		|			NULL
		|		ИЗ
		|			ИнвойсыСоСкидкой КАК ИнвойсыСоСкидкой
		|				ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
		|					РасчетыПоИнвойсам.Инвойс КАК Инвойс
		|				ИЗ
		|					РегистрНакопления.РасчетыПоИнвойсам.Остатки(, Контрагент = &Контрагент) КАК РасчетыПоИнвойсам) КАК ОстаткиПоИнвойсам
		|				ПО ИнвойсыСоСкидкой.Инвойс = ОстаткиПоИнвойсам.Инвойс
		|		ГДЕ
		|			ОстаткиПоИнвойсам.Инвойс ЕСТЬ NULL
		|		
		|		ОБЪЕДИНИТЬ ВСЕ
		|		
		|		ВЫБРАТЬ
		|			""Парный товарный инвойс по закупке"",
		|			ПарныеТоварныеИнвойсы.Инвойс,
		|			0,
		|			0,
		|			0,
		|			NULL
		|		ИЗ
		|			ПарныеТоварныеИнвойсы КАК ПарныеТоварныеИнвойсы
		|				ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
		|					РасчетыПоИнвойсам.Инвойс КАК Инвойс
		|				ИЗ
		|					РегистрНакопления.РасчетыПоИнвойсам.Остатки(, Контрагент = &Контрагент) КАК РасчетыПоИнвойсам) КАК ОстаткиПоИнвойсам
		|				ПО ПарныеТоварныеИнвойсы.Инвойс = ОстаткиПоИнвойсам.Инвойс
		|		ГДЕ
		|			ОстаткиПоИнвойсам.Инвойс ЕСТЬ NULL) КАК Свод
		|
		|СГРУППИРОВАТЬ ПО
		|	Свод.Инвойс
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	Товары.Ссылка КАК Инвойс,
		|	СУММА(Товары.Количество * (ВЫБОР
		|			КОГДА Товары.ЦенаИнвойса = 0
		|				ТОГДА Товары.ЦенаЗакупки
		|			ИНАЧЕ Товары.ЦенаИнвойса
		|		КОНЕЦ + ВЫБОР
		|			КОГДА Товары.Ссылка.Наценка
		|				ТОГДА Товары.Наценка
		|			ИНАЧЕ 0
		|		КОНЕЦ)) КАК СуммаДокумента
		|ПОМЕСТИТЬ СуммыИнвойсов
		|ИЗ
		|	Документ._Инвойс.ВКД_Товары КАК Товары
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВзаиморасчетыПоИнвойсу КАК ВзаиморасчетыПоИнвойсу
		|		ПО Товары.Ссылка = ВзаиморасчетыПоИнвойсу.Инвойс
		|
		|СГРУППИРОВАТЬ ПО
		|	Товары.Ссылка
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВзаиморасчетыПоИнвойсу.Инвойс КАК Инвойс,
		|	_Инвойс.ДокументОснование КАК ИнвойсЗакупки,
		|	_Инвойс.ВидОперации КАК ВидОперации,
		|	ЕСТЬNULL(СуммыИнвойсов.СуммаДокумента, _Инвойс.СуммаВВалютеИнвойса) КАК СуммаДокумента,
		|	ВзаиморасчетыПоИнвойсу.Долг КАК Долг,
		|	ВзаиморасчетыПоИнвойсу.Привязано КАК Привязано,
		|	ВзаиморасчетыПоИнвойсу.СуммаКР КАК СуммаКР,
		|	ВзаиморасчетыПоИнвойсу.НеПересчитыватьПриходТовара КАК НеПересчитыватьПриходТовара,
		|	ВзаиморасчетыПоИнвойсу.Долг / ВЫБОР
		|		КОГДА _Инвойс.ДокументОснование.Валюта = &Валюта
		|			ТОГДА 1
		|		ИНАЧЕ &Курс
		|	КОНЕЦ КАК ОстатокДолга,
		|	ВЫБОР
		|		КОГДА _Инвойс.ДокументОснование.Валюта = &Валюта
		|			ТОГДА 1
		|		ИНАЧЕ &Курс
		|	КОНЕЦ КАК Курс,
		|	ВЫБОР
		|		КОГДА _Инвойс.ДокументОснование <> ЗНАЧЕНИЕ(Документ.ИнвойсЗакупки.ПустаяСсылка)
		|				И (_Инвойс.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацииИнвойс.Товар)
		|					ИЛИ _Инвойс.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацииИнвойс.Скидка)
		|					ИЛИ _Инвойс.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацииИнвойс.ПустаяСсылка))
		|			ТОГДА _Инвойс.ДокументОснование
		|		ИНАЧЕ NULL
		|	КОНЕЦ КАК ГруппаЗакупки,
		|	ВЫБОР
		|		КОГДА _Инвойс.ДокументОснование <> ЗНАЧЕНИЕ(Документ.ИнвойсЗакупки.ПустаяСсылка)
		|				И (_Инвойс.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацииИнвойс.Товар)
		|					ИЛИ _Инвойс.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацииИнвойс.Скидка)
		|					ИЛИ _Инвойс.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацииИнвойс.ПустаяСсылка))
		|			ТОГДА NULL
		|		ИНАЧЕ _Инвойс.Ссылка
		|	КОНЕЦ КАК ГруппаИнвойса
		|ПОМЕСТИТЬ Детали
		|ИЗ
		|	ВзаиморасчетыПоИнвойсу КАК ВзаиморасчетыПоИнвойсу
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ._Инвойс КАК _Инвойс
		|		ПО ВзаиморасчетыПоИнвойсу.Инвойс = _Инвойс.Ссылка
		|		ЛЕВОЕ СОЕДИНЕНИЕ СуммыИнвойсов КАК СуммыИнвойсов
		|		ПО ВзаиморасчетыПоИнвойсу.Инвойс = СуммыИнвойсов.Инвойс
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	Детали.ГруппаЗакупки КАК ГруппаЗакупки,
		|	Детали.ГруппаИнвойса КАК ГруппаИнвойса,
		|	МАКСИМУМ(ВЫБОР
		|			КОГДА Детали.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацииИнвойс.Товар)
		|					ИЛИ Детали.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацииИнвойс.ПустаяСсылка)
		|				ТОГДА Детали.Инвойс
		|			ИНАЧЕ NULL
		|		КОНЕЦ) КАК Инвойс,
		|	МАКСИМУМ(ВЫБОР
		|			КОГДА Детали.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацииИнвойс.Скидка)
		|				ТОГДА Детали.Инвойс
		|			ИНАЧЕ NULL
		|		КОНЕЦ) КАК ИнвойсСкидки,
		|	МАКСИМУМ(Детали.ИнвойсЗакупки) КАК ИнвойсЗакупки,
		|	СУММА(ВЫБОР
		|			КОГДА Детали.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацииИнвойс.Скидка)
		|				ТОГДА 0
		|			ИНАЧЕ Детали.СуммаДокумента
		|		КОНЕЦ) КАК Сумма,
		|	СУММА(ВЫБОР
		|			КОГДА Детали.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацииИнвойс.Скидка)
		|				ТОГДА -Детали.СуммаДокумента
		|			ИНАЧЕ 0
		|		КОНЕЦ) КАК СуммаСкидки,
		|	СУММА(Детали.СуммаКР) КАК СуммаКР,
		|	СУММА(Детали.Привязано) КАК Привязано,
		|	СУММА(Детали.ОстатокДолга) КАК ОстатокДолга,
		|	СУММА(ВЫБОР
		|			КОГДА Детали.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацииИнвойс.Скидка)
		|				ТОГДА Детали.ОстатокДолга
		|			ИНАЧЕ 0
		|		КОНЕЦ) КАК ОстатокДолгаСкидки,
		|	СУММА(ВЫБОР
		|			КОГДА Детали.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацииИнвойс.Скидка)
		|				ТОГДА 0
		|			ИНАЧЕ Детали.ОстатокДолга
		|		КОНЕЦ) КАК ОстатокДолгаТовар,
		|	МАКСИМУМ(Детали.Курс) КАК Курс,
		|	МАКСИМУМ(Детали.НеПересчитыватьПриходТовара) КАК НеПересчитыватьПриходТовара,
		|	СУММА(Детали.Долг) > 0 КАК Неоплачено
		|ПОМЕСТИТЬ Группы
		|ИЗ
		|	Детали КАК Детали
		|
		|СГРУППИРОВАТЬ ПО
		|	Детали.ГруппаЗакупки,
		|	Детали.ГруппаИнвойса
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	Группы.Инвойс КАК Инвойс,
		|	Группы.ИнвойсЗакупки КАК ИнвойсЗакупки,
		|	Группы.ИнвойсСкидки КАК ИнвойсСкидки,
		|	Группы.Сумма КАК Сумма,
		|	Группы.СуммаСкидки КАК СуммаСкидки,
		|	Группы.Сумма + Группы.СуммаСкидки КАК СуммаИтого,
		|	Группы.СуммаКР КАК СуммаКР,
		|	Группы.Привязано КАК Привязано,
		|	Группы.ОстатокДолга КАК ОстатокДолга,
		|	Группы.ОстатокДолгаСкидки КАК ОстатокДолгаСкидки,
		|	Группы.ОстатокДолгаТовар КАК ОстатокДолгаТовар,
		|	Группы.Курс КАК Курс,
		|	Группы.Неоплачено КАК Неоплачено,
		|	Группы.НеПересчитыватьПриходТовара КАК НеПересчитыватьПриходТовара,
		|	СостоянияИнвойсов.СтатусОплатыАвто КАК Состояние,
		|	ЕСТЬNULL(ПоступленияТоваров.ЕстьПриходТовара, ЛОЖЬ) КАК ЕстьПриходТовара
		|ИЗ
		|	Группы КАК Группы
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СостоянияИнвойсов КАК СостоянияИнвойсов
		|		ПО Группы.Инвойс = СостоянияИнвойсов.Инвойс
		|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
		|			ОприходованиеНоменклатуры.Документ КАК Инвойс,
		|			СУММА(ОприходованиеНоменклатуры.КоличествоРасход) > 0 КАК ЕстьПриходТовара
		|		ИЗ
		|			РегистрНакопления.ВКД_ОприходованиеНоменклатуры.Обороты(, &Дата, , ) КАК ОприходованиеНоменклатуры
		|
		|		СГРУППИРОВАТЬ ПО
		|			ОприходованиеНоменклатуры.Документ) КАК ПоступленияТоваров
		|		ПО Группы.Инвойс = ПоступленияТоваров.Инвойс";
	
	КонецФункции

// Дополняет таблицу инвойсов вычисляемыми колонками после запроса.
//
// Параметры:
//  Таблица - ТаблицаЗначений - результат запроса формы выбора.
//
Процедура ДополнитьТаблицуИнвойсовПослеЗапроса(Таблица)
	
	Если Таблица.Колонки.Найти("СуммаСоСкидкой") = Неопределено Тогда
		Таблица.Колонки.Добавить("СуммаСоСкидкой", Новый ОписаниеТипов("Строка", , , , Новый КвалификаторыСтроки(50)));
	КонецЕсли;
	
	Для Каждого СтрокаТаблицы Из Таблица Цикл
		Сумма = ?(Таблица.Колонки.Найти("Сумма") = Неопределено, 0, СтрокаТаблицы.Сумма);
		СуммаСкидки = ?(Таблица.Колонки.Найти("СуммаСкидки") = Неопределено, 0, СтрокаТаблицы.СуммаСкидки);
		Если СуммаСкидки > 0 Тогда
			СуммаСкидки = -СуммаСкидки;
			СтрокаТаблицы.СуммаСкидки = СуммаСкидки;
		КонецЕсли;
		СуммаИтого = Сумма + СуммаСкидки;
		Если Таблица.Колонки.Найти("СуммаИтого") <> Неопределено Тогда
			СтрокаТаблицы.СуммаИтого = СуммаИтого;
		КонецЕсли;
		СтрокаТаблицы.СуммаСоСкидкой = ПредставлениеСуммыСоСкидкой(Сумма, СуммаСкидки, СуммаИтого);
	КонецЦикла;
	
КонецПроцедуры

// Заполняет индекс пиктограммы состояния документа для колонки Инвойс.
//
// Параметры:
//  Таблица - ТаблицаЗначений - строки формы выбора инвойсов.
//
Процедура ЗаполнитьСтатусыПроведенияИнвойсов(Таблица)
	
	Если Таблица.Колонки.Найти("СтатусПроведения") = Неопределено Тогда
		Таблица.Колонки.Добавить("СтатусПроведения", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(1, 0, ДопустимыйЗнак.Неотрицательный)));
	КонецЕсли;
	
	Для Каждого СтрокаТаблицы Из Таблица Цикл
		СтрокаТаблицы.СтатусПроведения = ОбщегоНазначенияСервер.СтатусПроведения(СтрокаТаблицы.Инвойс);
	КонецЦикла;
	
КонецПроцедуры

// Формирует текст вида "1800 - 10 = 1790" для колонки СуммаСоСкидкой.
//
// Параметры:
//  Сумма       - Число - сумма товарного инвойса;
//  СуммаСкидки - Число - сумма скидки (в таблице отрицательная);
//  СуммаИтого  - Число - итог к оплате (Сумма + СуммаСкидки).
//
// Возвращаемое значение:
//  Строка - представление суммы.
//
Функция ПредставлениеСуммыСоСкидкой(Сумма, СуммаСкидки, СуммаИтого)
	
	Если СуммаСкидки = 0 Тогда
		Возврат Формат(Сумма, "ЧДЦ=2");
	КонецЕсли;
	
	СуммаСкидкиМодуль = ?(СуммаСкидки < 0, -СуммаСкидки, СуммаСкидки);
	Возврат СтрШаблон("%1 - %2 = %3", Формат(Сумма, "ЧДЦ=2"), Формат(СуммаСкидкиМодуль, "ЧДЦ=2"), Формат(СуммаИтого, "ЧДЦ=2"));
	
КонецФункции

// Заполняет список выбранных инвойсов и корректирует остаток долга по курсовой разнице.
//
// Параметры:
//  масИнвойсыДокумента - Массив - инвойсы из ТЧ документа;
//  СуммаКР             - Число - курсовая разница документа.
//
Процедура ЗаполнитьВыбранныеИнвойсыИКорректировкуКР(масИнвойсыДокумента, СуммаКР)
	
	СписокВыбранных = Новый СписокЗначений;
	
	Для Каждого ИнвойсДокумента Из масИнвойсыДокумента Цикл
		ДобавитьВСписокВыбранныхБезДублей(СписокВыбранных, ИнвойсДокумента);
	КонецЦикла;
	
	Если масИнвойсыДокумента.ВГраница() > -1 Тогда
		НайдСтроки = Инвойсы.НайтиСтроки(Новый Структура("Инвойс", масИнвойсыДокумента[0]));
		Если НайдСтроки.Количество() = 0 Тогда
			НайдСтроки = Инвойсы.НайтиСтроки(Новый Структура("ИнвойсСкидки", масИнвойсыДокумента[0]));
		КонецЕсли;
		Если НайдСтроки.Количество() > 0 Тогда
			НайдСтрока = НайдСтроки[0];
			ДобавитьВСписокВыбранныхБезДублей(СписокВыбранных, НайдСтрока.Инвойс);
			ДобавитьВСписокВыбранныхБезДублей(СписокВыбранных, НайдСтрока.ИнвойсСкидки);
			НайдСтрока.ОстатокДолга = НайдСтрока.ОстатокДолга - СуммаКР;
		КонецЕсли;
	КонецЕсли;
	
	ВыбранныеИнвойсы.ЗагрузитьЗначения(СписокВыбранных.ВыгрузитьЗначения());
	
КонецПроцедуры

Процедура ДобавитьВСписокВыбранныхБезДублей(СписокВыбранных, Значение)
	
	Если НЕ ЗначениеЗаполнено(Значение) Тогда
		Возврат;
	КонецЕсли;
	Если СписокВыбранных.НайтиПоЗначению(Значение) = Неопределено Тогда
		СписокВыбранных.Добавить(Значение);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура УстановитьУсловноеОформление()

	// ВыбранныеИнвойсы
	
	ЭлементОформления = ЭтаФорма.УсловноеОформление.Элементы.Добавить();
	ЭлементОформления.Оформление.УстановитьЗначениеПараметра("ЦветФона", Метаданные.ЭлементыСтиля.ЦветФонаСтрокиИсключаемойИзВыбора.Значение);
	ЭлементОформления.Оформление.УстановитьЗначениеПараметра("Шрифт", Новый Шрифт(,, Истина)); 
	ЭлементОтбора = ЭлементОформления.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ЭлементОтбора.ЛевоеЗначение  = Новый ПолеКомпоновкиДанных("Инвойсы.Инвойс"); 
	ЭлементОтбора.ВидСравнения   = ВидСравненияКомпоновкиДанных.ВСписке;
	ЭлементОтбора.ПравоеЗначение = ВыбранныеИнвойсы;
	ЭлементОтбора.Использование  = Истина;
	ОформляемоеПоле = ЭлементОформления.Поля.Элементы.Добавить();
	ОформляемоеПоле.Поле = Новый ПолеКомпоновкиДанных("ИнвойсыИнвойс"); 
	ОформляемоеПоле.Использование = Истина;
	
	// Состояние (статусы)

	Запр = Новый Запрос; 
	Запр.Текст = "ВЫБРАТЬ
	             |	ЦветаОформления.Значение КАК Цвет,
	             |	ЦветаОформления.Настройка.ИмяПредопределенныхДанных КАК Статус
	             |ИЗ
	             |	РегистрСведений.ЦветаОформления КАК ЦветаОформления
	             |ГДЕ
	             |	ЦветаОформления.Настройка.Родитель = &ГруппаНастроек
	             |	И ЦветаОформления.Значение <> """"";
	Запр.УстановитьПараметр("ГруппаНастроек", ПланыВидовХарактеристик.ЦветаОформления.СтатусыПривязкиИнвойсов);
	Выборка = Запр.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
	
		ЭлементОформления = ЭтаФорма.УсловноеОформление.Элементы.Добавить();
		ЭлементОформления.Оформление.УстановитьЗначениеПараметра("ЦветФона", гоЦветРГБ(Выборка.Цвет));
		ЭлементОтбора = ЭлементОформления.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		ЭлементОтбора.ЛевоеЗначение 	= Новый ПолеКомпоновкиДанных("Инвойсы.Состояние");
		ЭлементОтбора.ВидСравнения  	= ВидСравненияКомпоновкиДанных.Равно;
		ЭлементОтбора.ПравоеЗначение 	= Перечисления.Долги[СтрЗаменить(Выборка.Статус,"Инв_","")];
		ЭлементОтбора.Использование 	= Истина;
		
		ОформляемоеПоле = ЭлементОформления.Поля.Элементы.Добавить();
		ОформляемоеПоле.Поле 			= Новый ПолеКомпоновкиДанных("ИнвойсыСостояние");
		ОформляемоеПоле.Использование 	= Истина;
	
	КонецЦикла;
	
КонецПроцедуры

