// Обработка результата поиска по номеру: смена фильтра кассы при необходимости.
//
// Параметры:
//  ДокументСсылка - ДокументСсылка.ДвижениеДенег - найденный документ.
//
&НаКлиенте
Процедура ОбработатьНайденныйДокументПоНомеру(ДокументСсылка) Экспорт
	
	КассаДокумента = гоРеквизит(ДокументСсылка, "ДСчет");
	
	Если НЕ ЗначениеЗаполнено(ФильтрДСчет) Или КассаДокумента = ФильтрДСчет Тогда
		ПозиционироватьСписокНаДокументе(ДокументСсылка);
		Возврат;
	КонецЕсли;
	
	Если КассаДоступнаПользователю(КассаДокумента) Тогда
		ТекстВопроса = СтрШаблон(
			НСтр("ru = 'Документ принадлежит кассе ""%1"". Сменить кассу в фильтре и перейти к документу?'; en = 'The document belongs to cash account ""%1"". Switch the cash filter and go to the document?'"),
			Строка(КассаДокумента));
		клДаНет(
			Новый ОписаниеОповещения("СменитьКассуПослеПоискаПоНомеру", ЭтотОбъект, ДокументСсылка),
			ТекстВопроса);
	Иначе
		клОшибка(СтрШаблон(
			НСтр("ru = 'Документ принадлежит другой кассе (%1), недоступной текущему пользователю.'; en = 'The document belongs to another cash account (%1) that is not available to the current user.'"),
			Строка(КассаДокумента)));
	КонецЕсли;
	
КонецПроцедуры

// Устанавливает кассу фильтра после подтверждения и позиционирует список.
//
// Параметры:
//  Ответ          - Булево - Истина, если пользователь подтвердил смену кассы;
//  ДокументСсылка - ДокументСсылка.ДвижениеДенег - найденный документ.
//
&НаКлиенте
Процедура СменитьКассуПослеПоискаПоНомеру(Ответ, ДокументСсылка) Экспорт
	
	Если Ответ <> Истина Тогда
		Возврат;
	КонецЕсли;
	
	КассаДокумента = гоРеквизит(ДокументСсылка, "ДСчет");
	УстановитьКассу(КассаДокумента);
	ОтобразитьИконкуПартионногоУчета(ФильтрДСчет, Элементы.ДекорацияПартУчетДСчет);
	гоЗаголовокИнтервал(ЭтаФорма, Ложь, Истина);
	ПозиционироватьСписокНаДокументе(ДокументСсылка);
	
КонецПроцедуры

// Расширяет интервал дат при необходимости и устанавливает текущую строку списка.
//
// Параметры:
//  ДокументСсылка - ДокументСсылка.ДвижениеДенег - документ для позиционирования.
//
&НаКлиенте
Процедура ПозиционироватьСписокНаДокументе(ДокументСсылка)
	
	ДатаДокумента = гоРеквизит(ДокументСсылка, "Дата");
	ИнтервалИзменен = Ложь;
	Если ЗначениеЗаполнено(НачДата) И ДатаДокумента < НачДата Тогда
		НачДата = НачалоДня(ДатаДокумента);
		ИнтервалИзменен = Истина;
	КонецЕсли;
	Если ЗначениеЗаполнено(КонДата) И ДатаДокумента > КонецДня(КонДата) Тогда
		КонДата = НачалоДня(ДатаДокумента);
		ИнтервалИзменен = Истина;
	КонецЕсли;
	Если ИнтервалИзменен Тогда
		гоЗаголовокИнтервал(ЭтаФорма, Ложь, Истина);
	КонецЕсли;
	
	Элементы.Список.Обновить();
	Элементы.Список.ТекущаяСтрока = ДокументСсылка;
	ТекущийЭлемент = Элементы.Список;
	
КонецПроцедуры

// Проверяет доступность кассы текущему пользователю по ТЧ денежных счетов.
//
// Параметры:
//  Касса - СправочникСсылка.ДенежныеСчета - проверяемая касса.
//
// Возвращаемое значение:
//  Булево - Истина, если касса доступна (или ограничения по кассам нет).
//
&НаСервереБезКонтекста
Функция КассаДоступнаПользователю(Касса)
	
	Если НЕ ЗначениеЗаполнено(Касса) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	МассивКасс = ОбщегоНазначенияПовтИсп.МассивДоступныхКасс();
	Если МассивКасс.Количество() = 0 Тогда
		Возврат Истина;
	КонецЕсли;
	
	Возврат МассивКасс.Найти(Касса) <> Неопределено;
	
КонецФункции

&НаКлиенте
Процедура ОбновитьОстатки(Команда)
	
	Если СпиКас.Количество() <> 0 И СпиКас.НайтиПоЗначению(ФильтрДСчет) = Неопределено Тогда 
		ОстаткиПоСчету = "?";
		Элементы.ДекорацияОстаткиПоСчету.Заголовок = "?";
	Иначе		
		СтруктураОстатков = СтруктураОстатков(ФильтрДСчет); 
		ОстаткиПоСчету = СтруктураОстатков.Строка;
		Элементы.ДекорацияОстаткиПоСчету.Заголовок = Новый ФорматированнаяСтрока(ОбщегоНазначенияСервер.ТекстHTMLВФорматированнуюСтроку(СтруктураОстатков.ФмтСтрока)); 
	КонецЕсли;  
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция СтруктураОстатков(Касса) 
	
	Если гоПЗ(Касса) Тогда 
		Результат = "?"; 
		ФмтРезультат = "?"; 
		ГраницаСсылка = Неопределено;
	Иначе	
		Результат = ""; 
		ФмтРезультат = ""; 
		ГраницаСсылка = Неопределено;
		Фильтр = Новый Структура("Фирма,Касса", Касса.Владелец, Касса);
		Табл = РегистрыНакопления.Деньги.Остатки(, Фильтр, "Валюта", "Остаток");
		Если Табл.Количество() > 0 Тогда 
			Для Каждого стрТабл Из Табл Цикл  
				Граница = Последовательности.ПартииВалют.ПолучитьГраницу(Новый Структура("Касса,Валюта", Касса, стрТабл.Валюта));		
				Если ЗначениеЗаполнено(Граница) Тогда
					СтрГраница = " (" + Граница.Дата + ")"; 
					ГраницаСсылка = Граница.Ссылка;
				Иначе	
					СтрГраница = "";
				КонецЕсли;  
				гоРезСоо(Результат, гоСуммаЗнВал(стрТабл.Остаток, стрТабл.Валюта, 2) + СтрГраница, ",   ");  
				ФмтРезультат = СтрШаблон("%1%2 %3%4",
							?(ЗначениеЗаполнено(ФмтРезультат), ФмтРезультат + ",&#160;", ФмтРезультат),
							омСервер.Фрмт(стрТабл.Остаток, "ЧИСЛО_ЦВ2"), 
							омСервер.Фрмт(стрТабл.Валюта, "НАДПИСЬ_ЦВ2"),
							омСервер.Фрмт(?(ЗначениеЗаполнено(Граница), СтрШаблон(" (%1)", Формат(Граница.Дата,"ДЛФ=D")) ,""), "НАДПИСЬ_ЦВ1")
							);

			КонецЦикла; 
		КонецЕсли;  
	КонецЕсли; 
	
	Возврат Новый Структура("Строка,ФмтСтрока,ГраницаСсылка", Результат, ФмтРезультат, ГраницаСсылка);    
	
КонецФункции

