&НаСервере
Процедура ПроблемныйДокументПоследовательностиНаСервере()
	
	Касса  = ФильтрДСчет;
	Валюта = Справочники.Валюты.НайтиПоКоду("JPY");
	
	Отбор = Новый Структура("Касса, Валюта", Касса, Валюта);
	Граница = Последовательности.ПартииВалют.ПолучитьГраницу(Отбор);
	
	Если НЕ ЗначениеЗаполнено(Граница) Тогда
		ДатаГраницы     = Дата(1, 1, 1);
		ДокументГраницы = Документы.ДвижениеДенег.ПустаяСсылка();
	Иначе
		ДатаГраницы     = Граница.Дата;
		ДокументГраницы = Граница.Ссылка;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Касса",           Касса);
	Запрос.УстановитьПараметр("Валюта",          Валюта);
	Запрос.УстановитьПараметр("ДатаГраницы",     ДатаГраницы);
	Запрос.УстановитьПараметр("ДокументГраницы", ДокументГраницы);
	Запрос.Текст =  "ВЫБРАТЬ ПЕРВЫЕ 1
	                |	Пос.Период КАК Период,
	                |	Пос.Регистратор КАК Документ,
	                |	Пос.Регистратор.Номер КАК Номер,
	                |	Пос.Регистратор.Окончательно КАК Окончательно,
	                |	Пос.Регистратор.ВидДвиженияДенег КАК ВидДвиженияДенег,
	                |	Пос.Регистратор.ДСчет КАК ДСчет,
	                |	Пос.Регистратор.СубДСчет КАК СубДСчет,
	                |	Пос.Регистратор.Валюта КАК ВалютаДок,
	                |	Пос.Регистратор.СубДВалюта КАК СубДВалюта,
	                |	Пос.Регистратор.Сумма КАК Сумма
	                |ИЗ
	                |	Последовательность.ПартииВалют КАК Пос
	                |ГДЕ
	                |	Пос.Касса = &Касса
	                |	И Пос.Валюта = &Валюта
	                |	И Пос.Регистратор.Проведен
	                |	И (Пос.Период > &ДатаГраницы
	                |			ИЛИ Пос.Период = &ДатаГраницы
	                |				И Пос.Регистратор <> &ДокументГраницы)
	                |
	                |УПОРЯДОЧИТЬ ПО
	                |	Пос.Период,
	                |	Пос.Регистратор";
	
	Результат = Запрос.Выполнить().Выбрать();
	Если Результат.Следующий() Тогда
		// кандидат, на котором обычно «встаёт» Восстановить()
		ПроблемныйДокумент = Результат.Документ;  
		//Сообщить(ПроблемныйДокумент); 
		Сообщение = Новый СообщениеПользователю();   
		Сообщение.Текст = Строка(ПроблемныйДокумент);
		Сообщение.КлючДанных = ПроблемныйДокумент;
		Сообщение.Сообщить();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПроблемныйДокументПоследовательности(Команда)
	ПроблемныйДокументПоследовательностиНаСервере();
