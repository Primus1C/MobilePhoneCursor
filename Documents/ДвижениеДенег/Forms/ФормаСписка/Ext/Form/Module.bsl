&НаСервере
Процедура УстановитьКассу(Принудительно = 0)   
	
	Если НЕ (Принудительно = 0) Тогда ФильтрДСчет = Принудительно КонецЕсли; 
	
	гоСтандартныйОтбор(Список, 1, ЗначениеЗаполнено(ФильтрДСчет), ФильтрДСчет);
	
	ПараметрыСеанса.ДСчет = ФильтрДСчет;
	
	//2017.03.22
	Если СпиКас.Количество() <> 0 Тогда
		Если СпиКас.НайтиПоЗначению(ФильтрДСчет) = Неопределено Тогда ОстаткиПоСчету = "?"; Возврат; КонецЕсли; КонецЕсли;
	
	СтруктураОстатков 	= СтруктураОстатков(ФильтрДСчет); 
	ОстаткиПоСчету 		= СтруктураОстатков.Строка;   
	ГраницаСсылка 		= СтруктураОстатков.ГраницаСсылка;
	Элементы.ГраницаСсылка.Видимость = омСервер.ЕстьРоль("Разработка");
    Элементы.ПроблемныйДокументПоследовательности.Видимость = омСервер.ЕстьРоль("Разработка");
	
	//Элементы.ДекорацияОстаткиПоСчету.Видимость = омСервер.ЕстьРоль("Разработка");
	//Элементы.ДекорацияОстаткиПоСчету.Заголовок = Новый ФорматированнаяСтрока(ОбщегоНазначенияСервер.ТекстHTMLВФорматированнуюСтроку(СтруктураОстатков.ФмтСтрока)); 
	
	Элементы.ОтчетПартииВалюты.Видимость = ФильтрДСчет.ВестиПартионныйУчет;
	
КонецПроцедуры

