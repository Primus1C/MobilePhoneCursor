// Разбивает привязку по строке формы выбора на товарный и скидочный инвойсы.
//
// Параметры:
//  Эл - СтрокаТаблицыЗначений, Структура - строка формы выбора инвойсов.
//
// Возвращаемое значение:
//  Массив из Структura - поля Инвойс, Привязано, Курс, ОстатокДолга, СуммаИнвойса, НеПересчитыватьПриходТовара.
//
&НаКлиенте
Функция СтрокиПривязкиПоСтрокеФормыВыбора(Эл)
	
	Результат = Новый Массив;
	
	Если НЕ (ЗначениеЗаполнено(Эл.ИнвойсСкидки) И Эл.СуммаСкидки <> 0 И ЗначениеЗаполнено(Эл.Инвойс)) Тогда
		Стр = Новый Структура("Инвойс, Привязано, Курс, ОстатокДолга, СуммаИнвойса, НеПересчитыватьПриходТовара");
		ЗаполнитьЗначенияСвойств(Стр, Эл);
		Стр.СуммаИнвойса = ?(Эл.СуммаСкидки <> 0, Эл.СуммаИтого, Эл.Сумма);
		Результат.Добавить(Стр);
		Возврат Результат;
	КонецЕсли;
	
	Привязка = Эл.Привязано;
	ПривязкаСкидки = Мин(Привязка, Макс(0, Эл.ОстатокДолгаСкидки));
	ПривязкаТовар = Привязка - ПривязкаСкидки;
	Если ПривязкаТовар > Макс(0, Эл.ОстатокДолгаТовар) Тогда
		ПривязкаТовар = Макс(0, Эл.ОстатокДолгаТовар);
	КонецЕсли;
	
	Если ПривязкаТовар > 0 И ЗначениеЗаполнено(Эл.Инвойс) Тогда
		СтрТовар = Новый Структура("Инвойс, Привязано, Курс, ОстатокДолга, СуммаИнвойса, НеПересчитыватьПриходТовара",
			Эл.Инвойс, ПривязкаТовар, Эл.Курс, Эл.ОстатокДолгаТовар - ПривязкаТовар, Эл.Сумма, Эл.НеПересчитыватьПриходТовара);
		Результат.Добавить(СтрТовар);
	КонецЕсли;
	
	Если ПривязкаСкидки > 0 Тогда
		СтрСкидка = Новый Структура("Инвойс, Привязано, Курс, ОстатокДолга, СуммаИнвойса, НеПересчитыватьПриходТовара",
			Эл.ИнвойсСкидки, ПривязкаСкидки, Эл.Курс, Эл.ОстатокДолгаСкидки - ПривязкаСкидки, -Эл.СуммаСкидки, Ложь);
		Результат.Добавить(СтрСкидка);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Процедура ЗаписатьПривязкуИнвойсаВТЧ(СтрПривязки)
	
	НайдСтроки = Объект.Инвойсы.НайтиСтроки(Новый Структура("Инвойс", СтрПривязки.Инвойс));
	Если НайдСтроки.Количество() = 0 Тогда
		СтрокаТЧ = Объект.Инвойсы.Добавить();
		СтрокаТЧ.Инвойс = СтрПривязки.Инвойс;
	Иначе
		СтрокаТЧ = НайдСтроки[0];
	КонецЕсли;
	
	СтрокаТЧ.СуммаОплаты = СтрПривязки.Привязано;
	СтрокаТЧ.Сумма = СтрПривязки.Привязано * СтрПривязки.Курс;
	СтрокаТЧ.Долг = СтрПривязки.ОстатокДолга;
	СтрокаТЧ.НеПересчитыватьПриходТовара = СтрПривязки.НеПересчитыватьПриходТовара;
	СтрокаТЧ.Состояние = РаботаСИнвойсами.СостояниеДолга(СтрокаТЧ.СуммаОплаты, СтрПривязки.СуммаИнвойса);
	СтрокаТЧ.СтатусПроведения = ОбщегоНазначенияСервер.СтатусПроведения(СтрокаТЧ.Инвойс);
	
КонецПроцедуры

&НаКлиенте
Процедура ПривязатьИнвойсыЗавершение(Рез, ДопПараметры) Экспорт
	Если НЕ ТипЗнч(Рез) = Тип("Массив") Тогда Возврат КонецЕсли; 
	// Получили данные:
	//		Привязано - в валюте инвойса
	//		ОстатокДолга - в валюте инвойса
	
	Для Каждого Эл Из Рез Цикл
		СтрокиПривязки = СтрокиПривязкиПоСтрокеФормыВыбора(Эл);
		Для Каждого СтрПривязки Из СтрокиПривязки Цикл
			ЗаписатьПривязкуИнвойсаВТЧ(СтрПривязки);
		КонецЦикла;
	КонецЦикла;
	
	Объект.СуммаПривязаноИнвойсов = Объект.Инвойсы.Итог("Сумма");
    МоиИтоги();
	Модифицированность = Истина;
	
КонецПроцедуры


&НаКлиенте
Процедура ОчиститьПривязкиИнвойсов(Команда)

	Объект.Инвойсы.Очистить(); 
	Объект.СуммаПривязаноИнвойсов = 0; 
	Модифицированность = Истина;
    МоиИтоги();
	
КонецПроцедуры

&НаСервере
Процедура ОтобразитьСтатусыПроведения()
	
	Для каждого СтрокаТЧ Из Объект.Инвойсы Цикл
		СтрокаТЧ.СтатусПроведения = ОбщегоНазначенияСервер.СтатусПроведения(СтрокаТЧ.Инвойс);
	КонецЦикла;

КонецПроцедуры

