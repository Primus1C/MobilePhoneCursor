	ЗаполнитьКэшДанных(); 
	
	РассчитатьСредневзвешенныйКурс();
	ОтобразитьСтатусыПроведения();
	ОбновитьОстатокКассыНаСервере();
	
	// © Primus1C  ОКОНЧАНИЕ ◄

КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	клФормаДокументаПриОткрытии(ЭтаФорма, Объект);
	
	Если НЕ ЗначениеЗаполнено(Объект.ДСчет) Тогда клОшибка("Не задана текущая касса!"); Отказ = Истина; Возврат; КонецЕсли;
	
	стрПросмотр = клПросмотр(ЭтаФорма, , Объект.Ссылка);
	
	// © Primus1C  08.11.2023  НАЧАЛО ►
	ОтобразитьЦветВалюты();   
	Элементы.ИнфоДок.Заголовок = "";  
	ОтобразитьИконкуПартионногоУчета(Объект.ДСчет, Элементы.ДекорацияПартУчетДСчет);
	ОтобразитьИконкуПартионногоУчета(Объект.СубДСчет, Элементы.ДекорацияПартУчетСубДСчет);
	// © Primus1C  ОКОНЧАНИЕ ◄    
	
	УстановитьВидимостьДоступность();
	ОтобразитьДолгиИнвойсов();  
	УстановитьЗаголовокЗакладкиИнвойсы();
	МоиИтоги(); 

КонецПроцедуры

&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи) 
	
	Если НЕ РазрешенаОплатаКонтрагентаВЗакрытомПериодеНаКлиенте() Тогда
		Возврат;
	КонецЕсли;
	
	Если ПараметрыЗаписи.РежимЗаписи = РежимЗаписиДокумента.ОтменаПроведения Тогда
		клОшибка(СтрШаблон(НСтр("ru = 'Период закрыт: %1. Отмена проведения запрещена.'"),
			Формат(гоПараметрСеанса("ДатаЗапретаРедактирования"), "ДФ=dd.MM.yyyy")));
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	
	Если Объект.ПометкаУдаления И НЕ ПометкаУдаленияДокументаНаСервере(Объект.Ссылка) Тогда
		клОшибка(СтрШаблон(НСтр("ru = 'Период закрыт: %1. Пометка на удаление запрещена.'"),
			Формат(гоПараметрСеанса("ДатаЗапретаРедактирования"), "ДФ=dd.MM.yyyy")));
		Отказ = Истина;
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	
	// Интерактивное проведение оплаты покупателя/поставщику — без каскада зависимых документов.
	Если (ТекущийОбъект.ВидДвиженияДенег = Перечисления.ВидДвиженияДенег.Поставщики
			Или ТекущийОбъект.ВидДвиженияДенег = Перечисления.ВидДвиженияДенег.Покупатели)
		И ПараметрыЗаписи.РежимЗаписи = РежимЗаписиДокумента.Проведение Тогда
		ТекущийОбъект.ДополнительныеСвойства.Вставить("БезЗависимыхДокументов", Истина);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗаписи(ПараметрыЗаписи)  
	
	// © Primus1C  06.07.2023  НАЧАЛО ►
	ОбщегоНазначения.ОтобразитьСостояниеДокумента(Объект, СостояниеДокумента, КартинкаСостоянияДокумента);
	// © Primus1C  ОКОНЧАНИЕ ◄
	УстановитьВидимостьДоступность();
	МоиОстатки();
	МоиИтоги(); 
	
КонецПроцедуры

