&НаКлиенте  
// Заполняет СубДВалюта
//
Процедура УстановитьВалютуИнвойсовПоставщика()

	Если этоПоставщикиПоИнвойсам Тогда
		масВалют = ДругиеВалютыИвойсовКонтрагента();
		Если масВалют.Количество() = 0 Тогда
			Объект.СубДВалюта = ПредопределенноеЗначение("Справочник.Валюты.ПустаяСсылка");	
		Иначе	
		    Объект.СубДВалюта = масВалют[0];
		КонецЕсли; 
		УстановитьВидимостьКурсаОплатыИнвойсов();
	КонецЕсли;

