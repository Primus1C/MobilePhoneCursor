// Заполняет реквизит формы ОстатокКассы разницей:
// остаток кассы (Деньги) − остаток партий (ПартииВалюты) по кассе и валюте документа.
//
&НаСервере
Процедура ОбновитьОстатокКассыНаСервере()
	
	ОстатокКассы = 0;
	
	Если Не ЗначениеЗаполнено(Объект.ДСчет) Или Не ЗначениеЗаполнено(Объект.Валюта) Тогда
		Возврат;
	КонецЕсли;
	
	ФирмаКассы = Объект.ДСчет.Владелец;
	Если Не ЗначениеЗаполнено(ФирмаКассы) Тогда
		ФирмаКассы = Объект.Фирма;
	КонецЕсли;
	
	МоментОстатка = ?(ЗначениеЗаполнено(Объект.Ссылка), Объект.Ссылка.МоментВремени(), Объект.Дата);
	
	ОстатокДенег = 0;
	Фильтр = Новый Структура("Фирма,Касса,Валюта", ФирмаКассы, Объект.ДСчет, Объект.Валюта);
	Табл = РегистрыНакопления.Деньги.Остатки(МоментОстатка, Фильтр, , "Остаток");
	Если Табл.Количество() > 0 Тогда
		ОстатокДенег = Табл[0].Остаток;
	КонецЕсли;
	
	ОстатокПартий = 0;
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ПартииВалютыОстатки.СуммаОстаток КАК Сумма
	               |ИЗ
	               |	РегистрНакопления.ПартииВалюты.Остатки(
	               |			&Дата,
	               |			Валюта = &Валюта
	               |				И Касса = &Касса) КАК ПартииВалютыОстатки";
	Запрос.УстановитьПараметр("Дата", МоментОстатка);
	Запрос.УстановитьПараметр("Валюта", Объект.Валюта);
	Запрос.УстановитьПараметр("Касса", Объект.ДСчет);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		ОстатокПартий = Выборка.Сумма;
	КонецЕсли;
	
	ОстатокКассы = ОстатокДенег - ОстатокПартий;
	
КонецПроцедуры

	
