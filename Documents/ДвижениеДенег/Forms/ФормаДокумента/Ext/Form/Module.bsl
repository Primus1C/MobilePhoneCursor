	//Возврат;
	
	// © Primus1C  ОКОНЧАНИЕ ◄
	
	
	Если (Объект.СубДКурс = 0) ИЛИ (Объект.СубДКурс = 1) Тогда
		Кур1 = омСервер.Курс(Объект.Валюта, 	Объект.Фирма, Объект.Дата);
		Кур2 = омСервер.Курс(Объект.СубДВалюта, Объект.Фирма, Объект.Дата);
		
		Если Кур1 = 1 Тогда
			Объект.СубДКурс = Кур2;
			Объект.СубДОбратный = 0;
		ИначеЕсли Кур2 = 1 Тогда
			Объект.СубДКурс = Кур1;
			Объект.СубДОбратный = 1;
		Иначе
			Если Кур1 < Кур2 Тогда
				Объект.СубДКурс = Окр(Кур2 / Кур1, 5);
				Объект.СубДОбратный = 0;
			Иначе
				Объект.СубДКурс = Окр(Кур1 / Кур2, 5);
				Объект.СубДОбратный = 1;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	Если Объект.СубДКурс = 0 Тогда Объект.СубДКурс = 1 КонецЕсли;
		
	Если Объект.СубДОбратный = 1 Тогда
		Объект.СубДСумма = Окр(Объект.Сумма * Объект.СубДКурс, 2);
	Иначе
		Объект.СубДСумма = Окр(Объект.Сумма / Объект.СубДКурс, 2);
	КонецЕсли;

КонецПроцедуры


