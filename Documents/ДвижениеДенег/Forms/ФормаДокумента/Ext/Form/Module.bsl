&НаКлиенте
Процедура МояЗаписать(ПроверятьМодифицированность = Истина)
	УстановитьВидимостьДоступность();
	
	Если ПроверятьМодифицированность Тогда
		Если НЕ Модифицированность Тогда Возврат КонецЕсли; КонецЕсли; 
		
	Записать(РежимЗаписиПроведение);
	МоиОстатки();
	МоиИтоги();
КонецПроцедуры

&НаКлиенте
Процедура УстановитьВидимостьДоступность(ОбработатьВидДД = Ложь)
	
	НетСтрок = Объект.Привязки.Количество() = 0;
	ЕстьСтроки = НЕ НетСтрок;
	
	//2015.11.20
	этоПоставщики 				= (Объект.ВидДвиженияДенег = гоПеречисление("ВидДвиженияДенег.Поставщики"));
	этоПокупатели 				= (Объект.ВидДвиженияДенег = гоПеречисление("ВидДвиженияДенег.Покупатели"));
	этоРасходы 					= (Объект.ВидДвиженияДенег = гоПеречисление("ВидДвиженияДенег.Расходы"));
	этоДоходы 					= (Объект.ВидДвиженияДенег = гоПеречисление("ВидДвиженияДенег.Доходы"));
	этоПеремещение 				= (Объект.ВидДвиженияДенег = гоПеречисление("ВидДвиженияДенег.Перемещение"));
	этоОбменВалюты 				= (Объект.ВидДвиженияДенег = гоПеречисление("ВидДвиженияДенег.ОбменВалюты"));
	этоПодотчет 				= (Объект.ВидДвиженияДенег = гоПеречисление("ВидДвиженияДенег.Подотчет"));
	этоЗарплата 				= (Объект.ВидДвиженияДенег = гоПеречисление("ВидДвиженияДенег.Зарплата")); 
	этоИнвестиции 				= Объект.ВидДвиженияДенег = гоПеречисление("ВидДвиженияДенег.Инвестиции");
	этоБиржа 					= Объект.ВидДвиженияДенег = гоПеречисление("ВидДвиженияДенег.Биржа");
	этоЛогистика 				= Объект.ВидДвиженияДенег = гоПеречисление("ВидДвиженияДенег.Логистика"); 
	этоПоставщикиПоИнвойсам 	= Объект.ВидДвиженияДенег = гоПеречисление("ВидДвиженияДенег.Поставщики") И ВзаиморасчетыПоИнвойсам(Объект.Контрагент); 
	//этоПеремещениеСПартионнымУчетом = этоПеремещение 
	//									И омСервер.ПолучитьРеквизит(Объект.ДСчет,"ВестиПартионныйУчет") 
	//									И омСервер.ПолучитьРеквизит(Объект.СубДСчет,"ВестиПартионныйУчет") 
	//									И омСервер.ПолучитьРеквизит(Объект.Валюта,"ВестиПартионныйУчет");
	этоВводОстатков = (Объект.ВидДвиженияДенег = гоПеречисление("ВидДвиженияДенег.ВводОстатков"));
	
	//2015.11.21
	Если ОбработатьВидДД Тогда
		//получается, что приход может бытть достаточно редко
		//2016.01.31 + ИЛИ этоВводОстатков
		Объект.ПриходРасход = ?(этоПокупатели ИЛИ этоДоходы ИЛИ этоВводОстатков ИЛИ этоИнвестиции ИЛИ ЭтоБиржа, 
								гоПеречисление("ПриходРасход.Приход"), 
								гоПеречисление("ПриходРасход.Расход"));
	КонецЕсли; 
	
	//2015.11.20
	//ну и так далее подобные ситуации
	Элементы.Статья.Видимость 					= этоРасходы ИЛИ этоДоходы ИЛИ этоБиржа ИЛИ этоЛогистика;
	Элементы.ГруппаСубДСчет.Видимость 			= этоПеремещение ИЛИ этоОбменВалюты;
	Элементы.ГруппаПривязки.Видимость 			= этоПоставщики ИЛИ этоПокупатели ИЛИ этоЛогистика;
	//2015.11.21
	Элементы.СубДВалюта.Видимость 				= этоОбменВалюты;
	Элементы.СубДКурс.Видимость 				= этоОбменВалюты; 
	УстановитьВидимостьКурсаОплатыИнвойсов();
	Элементы.СубДОбратный.Видимость 			= этоОбменВалюты;
	Элементы.СубДСумма.Видимость 				= этоОбменВалюты;
	//Элементы.РассчитыватьСреднийКурс.Видимость 	= этоОбменВалюты ИЛИ этоПеремещениеСПартионнымУчетом;
	Элементы.РассчитыватьСреднийКурс.Видимость 	= этоОбменВалюты;
	Элементы.Сотрудник.Видимость 				= этоПодотчет ИЛИ этоЗарплата;
	Элементы.МесяцЗП.Видимость 					= этоЗарплата;
	//2015.11.22
	Элементы.ГруппаКонтрагент.Видимость 	= этоПоставщики ИЛИ этоПокупатели ИЛИ этоДоходы ИЛИ этоРасходы ИЛИ этоИнвестиции;  
	//2015.11.23
	Элементы.ГрИтогиОстатки.Видимость 		= этоПоставщики ИЛИ этоПокупатели;
	
	Элементы.ГруппаЛогистика.Видимость 		= этоЛогистика;
	
	Если НЕ гоМенеджер() Тогда  
		//Элементы.ФормаОтчетОборотыПодотчетаОборотыЛица.Видимость = этоПодотчет ИЛИ этоЗарплата;   
		//Если Элементы.Найти("ФормаОтчетОборотыЗарплатыОборотыСотрудника") <> Неопределено Тогда
		//	Элементы.ФормаОтчетОборотыЗарплатыОборотыСотрудника.Видимость = этоПодотчет ИЛИ этоЗарплата;
		//КонецЕсли;
	КонецЕсли; 
	Элементы.ФормаОтчетДолгиДолги.Видимость = этоПоставщики ИЛИ этоПокупатели ИЛИ этоДоходы ИЛИ этоРасходы;
	
	//наоброт, привязывать можно только когда проведено / окончательно
	// (для оплаты покупателя/поставщику — без требования Окончательно, см. ниже)
	Элементы.ПривязкиПривязать.Доступность 			= Объект.Окончательно;
	Элементы.ПривязкиОчиститьПривязки.Доступность 	= Объект.Окончательно;
	
	//получается, что никогда не нужно будет это задавать, все происходит автоматические
	Элементы.ПриходРасход.ТолькоПросмотр = Истина;
	
	// © Primus1C  08.11.2023  НАЧАЛО ►   
	ВестиПартионныйУчет = ВестиПартионныйУчет(Объект.ДСчет).ВестиПартионныйУчет;
	Элементы.ГруппаОстатокКассы.Видимость		= этоВводОстатков И ВестиПартионныйУчет;
	Элементы.ЗаполнитьСуммойОстатка.Видимость 	= этоВводОстатков И ВестиПартионныйУчет И НЕ Объект.Окончательно;
	
	Элементы.ГруппаКР.Видимость 				= этоОбменВалюты ИЛИ этоПоставщикиПоИнвойсам;
	Элементы.ПроцентИнвестиций.Видимость 		= этоИнвестиции;    
	Элементы.Договор.Видимость 					= этоИнвестиции;    
	Элементы.ГруппаНакладные.Видимость 			= НЕ этоЛогистика; 
	Элементы.ГруппаИнвойсы.Видимость 			= этоЛогистика ИЛИ этоПоставщикиПоИнвойсам; 
	Элементы.Затрата.Видимость 					= этоЛогистика;
	
	Элементы.ГруппаСреднийКурс.Видимость 		= этоПоставщикиПоИнвойсам 
													И омСервер.ПолучитьРеквизит(Объект.Валюта,"ВестиПартионныйУчет")
													И ВестиПартионныйУчет;
	Элементы.ИнвойсыДолг.Видимость 				= этоПоставщикиПоИнвойсам;
	Элементы.ИнвойсыСостояние.Видимость 		= этоПоставщикиПоИнвойсам; 
	Элементы.ИнвойсыГруппаПривязка.Видимость	= этоПоставщикиПоИнвойсам;
	
	Если омСервер.ЕстьРоль("Разработка") Тогда
		Элементы.ИнвойсыСумма.ТолькоПросмотр 		= Ложь; 
		Элементы.ИнвойсыСумма.Доступность 			= Истина;
		Элементы.ИнвойсыСуммаОплаты.ТолькоПросмотр 	= Ложь;
		Элементы.ИнвойсыСуммаОплаты.Доступность 	= Истина;
	КонецЕсли;
	
	этоОплатаКонтрагента = этоПоставщики Или этоПокупатели;
	НастроитьДоступностьПоОкончательноИПериоду(этоОплатаКонтрагента);
	
	// После общей настройки: локальные ограничения шапки при открытом периоде без «Окончательно».
	Если НЕ ПериодДокументаЗакрытНаКлиенте() И НЕ Объект.Окончательно Тогда
		Элементы.Сумма.ТолькоПросмотр = ЕстьСтроки;
		Элементы.Валюта.ТолькоПросмотр = ЕстьСтроки;
		Элементы.Контрагент.ТолькоПросмотр = ЕстьСтроки;
		Элементы.ВидДвиженияДенег.ТолькоПросмотр = ЕстьСтроки;
		Элементы.ПриходРасход.ТолькоПросмотр = Истина;
	КонецЕсли;
	
	// Оплата покупателя/поставщику: Привязать без Окончательно (в т.ч. закрытый период).
	// Остальные виды — только при Окончательно.
	ДоступнаПривязка = этоОплатаКонтрагента Или Объект.Окончательно;
	Если Элементы.Найти("ПривязкиПривязать") <> Неопределено Тогда
		Элементы.ПривязкиПривязать.Доступность = ДоступнаПривязка;
	КонецЕсли;
	Если Элементы.Найти("ПривязкиОчиститьПривязки") <> Неопределено Тогда
		Элементы.ПривязкиОчиститьПривязки.Доступность = ДоступнаПривязка;
	КонецЕсли;
	
	Если ПериодДокументаЗакрытНаКлиенте() Или Объект.Окончательно Тогда
		ОтключитьКомандыРедактированияНаПанелиФормы(этоОплатаКонтрагента);
	КонецЕсли;
	
	// © Primus1C  ОКОНЧАНИЕ ◄

КонецПроцедуры

// Вызов общей настройки доступности.
// Командная панель формы — при Окончательно и в закрытом периоде для любого вида движения.
// ТЧ: при Окончательно — для всех видов; в закрытом периоде — только оплата покупателя/поставщику.
//
// Параметры:
//  этоОплатаКонтрагента - Булево - вид «Покупатели» или «Поставщики».
//
&НаКлиенте
Процедура НастроитьДоступностьПоОкончательноИПериоду(этоОплатаКонтрагента)
	
	ДоступныеПриОкончательно = МассивЭлементовТЧДвиженияДенег();
	ДобавитьКоманднуюПанельФормыВМассив(ДоступныеПриОкончательно);
	
	ДоступныВЗакрытомПериоде = Новый Массив;
	ДобавитьКоманднуюПанельФормыВМассив(ДоступныВЗакрытомПериоде);
	Если этоОплатаКонтрагента Тогда
		Для Каждого ЭлементТЧ Из МассивЭлементовТЧДвиженияДенег() Цикл
			ДоступныВЗакрытомПериоде.Добавить(ЭлементТЧ);
		КонецЦикла;
	КонецЕсли;
	
	ОбщегоНазначенияКлиент.НастроитьДоступностьЭлементовФормыДокумента(
		ЭтаФорма,
		Объект.Дата,
		ДоступныеПриОкончательно,
		Неопределено,
		ДоступныВЗакрытомПериоде,
		Объект.Окончательно);
	
КонецПроцедуры

// Добавляет командную панель формы в массив разрешённых элементов, если она есть.
//
// Параметры:
//  МассивЭлементов - Массив
//
&НаКлиенте
Процедура ДобавитьКоманднуюПанельФормыВМассив(МассивЭлементов)
	
	ПанельФормы = Элементы.Найти("ФормаКоманднаяПанель");
	Если ПанельФормы <> Неопределено Тогда
		МассивЭлементов.Добавить(ПанельФормы);
	КонецЕсли;
	
КонецПроцедуры

// Отключает на командной панели формы команды записи/проведения/удаления
// при блокировке документа (Окончательно / закрытый период).
// Оплата покупателя/поставщику: проведение остаётся (правка ТЧ).
// Прочие виды в закрытом периоде: запись/проведение тоже отключаются.
// При Окончательно команда «Записать» недоступна (сохранение привязок ТЧ — через проведение).
//
// Параметры:
//  этоОплатаКонтрагента - Булево
//
&НаКлиенте
Процедура ОтключитьКомандыРедактированияНаПанелиФормы(этоОплатаКонтрагента)
	
	ИменаЗапрещенных = Новый Массив;
	ИменаЗапрещенных.Добавить("ФормаОтменаПроведения");
	ИменаЗапрещенных.Добавить("ФормаУстановитьПометкуУдаления");
	
	Если Объект.Окончательно Тогда
		ИменаЗапрещенных.Добавить("ФормаЗаписать");
		ИменаЗапрещенных.Добавить("ФормаЗаписатьИЗакрыть");
	КонецЕсли;
	
	Если НЕ этоОплатаКонтрагента И ПериодДокументаЗакрытНаКлиенте() Тогда
		ИменаЗапрещенных.Добавить("ФормаЗаписать");
		ИменаЗапрещенных.Добавить("ФормаЗаписатьИЗакрыть");
		ИменаЗапрещенных.Добавить("ФормаПровести");
		ИменаЗапрещенных.Добавить("ФормаПровестиИЗакрыть");
		ИменаЗапрещенных.Добавить("ФормаУдалить");
	КонецЕсли;
	
	Для Каждого ИмяКнопки Из ИменаЗапрещенных Цикл
		Кнопка = Элементы.Найти(ИмяКнопки);
		Если Кнопка <> Неопределено Тогда
			Кнопка.Доступность = Ложь;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

// Элементы табличных частей, которые остаются доступны при Окончательно / в закрытом периоде.
//
// Возвращаемое значение:
//  Массив
//
&НаКлиенте
Функция МассивЭлементовТЧДвиженияДенег()
	
	Результат = Новый Массив;
	
	Имена = Новый Массив;
	Имена.Добавить("Привязки");
	Имена.Добавить("Инвойсы");
	Имена.Добавить("ГруппаОплатаИнвойсов");
	Имена.Добавить("ГруппаПривязки");
	
	Для Каждого ИмяЭлемента Из Имена Цикл
		ЭлементФормы = Элементы.Найти(ИмяЭлемента);
		Если ЭлементФормы <> Неопределено Тогда
			Результат.Добавить(ЭлементФормы);
		КонецЕсли;
	КонецЦикла;
	
	Возврат Результат;
	
