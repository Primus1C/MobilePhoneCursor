//
&НаКлиенте
Функция ПериодДокументаЗакрытНаКлиенте()
	
	лДатаЗапрета = гоПараметрСеанса("ДатаЗапретаРедактирования");
	Если лДатаЗапрета = Дата(1, 1, 1) Или Объект.Дата = Дата(1, 1, 1) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Возврат Объект.Дата <= КонецДня(лДатаЗапрета);
	
