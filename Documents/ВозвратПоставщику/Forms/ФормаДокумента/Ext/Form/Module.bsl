КонецПроцедуры

&НаКлиенте
Процедура УдалитьТоварыБезОстатка(Команда)

	Если ЭтаФорма.ТолькоПросмотр Тогда Возврат КонецЕсли;
	Если Объект.Окончательно Тогда Возврат КонецЕсли;

	Если НЕ ЗначениеЗаполнено(Объект.Дата) Тогда клОшибка(НСтр("ru = 'Не задана дата документа!'; en = 'Document date not specified!'")); Возврат; КонецЕсли;
	Если гоПЗ(Объект.Склад) Тогда клОшибка(НСтр("ru = 'Не задан склад!'; en = 'Warehouse not specified!'")); Возврат; КонецЕсли;

	клНетДа(Новый ОписаниеОповещения("УдалитьТоварыБезОстаткаЗавершение", ЭтотОбъект),
		НСтр("ru = 'Удалить строки, по которым на складе на дату документа недостаточно товара?'; en = 'Delete rows with insufficient stock in the warehouse on the document date?'"));

КонецПроцедуры

&НаКлиенте
Процедура УдалитьТоварыБезОстаткаЗавершение(Результат, ДопПараметры) Экспорт

	Если НЕ Результат Тогда Возврат КонецЕсли;

	КоличествоУдаленных = УдалитьТоварыБезОстаткаНаСервере();

	Если КоличествоУдаленных = 0 Тогда
		Сообщить(НСтр("ru = 'Строк с недостаточным остатком не найдено.'; en = 'No rows with insufficient stock found.'"));
		Возврат;
	КонецЕсли;

	Сообщить(СтрШаблон(НСтр("ru = 'Удалено строк с недостаточным остатком: %1'; en = 'Rows with insufficient stock deleted: %1'"), КоличествоУдаленных));
	гоЗаписьЖурналаРегистрации("Удалено строк: " + КоличествоУдаленных,
		ИмяДокумента + ?(Объект.Окончательно, "ПослеОкончательно", ""), "Удаление товаров без остатка", Объект.Ссылка, 2);

	МояЗаписать(Ложь);

КонецПроцедуры

// Удаляет из табличной части строки, по партиям которых на складе документа недостаточно товара для списания.
// Остаток берется по регистру ОстаткиТовара на момент документа (собственные движения документа не учитываются).
//
// Возвращаемое значение:
//  Число - количество удаленных строк.
//
&НаСервере
Функция УдалитьТоварыБезОстаткаНаСервере()

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Т.Партия КАК Партия,
	|	Т.Количество КАК Количество
	|ПОМЕСТИТЬ ВТСтрокиТовары
	|ИЗ
	|	&Товары КАК Т
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Т.Партия КАК Партия,
	|	СУММА(Т.Количество) КАК Количество
	|ПОМЕСТИТЬ ВТТовары
	|ИЗ
	|	ВТСтрокиТовары КАК Т
	|ГДЕ
	|	Т.Партия <> ЗНАЧЕНИЕ(Справочник.Партии.ПустаяСсылка)
	|
	|СГРУППИРОВАТЬ ПО
	|	Т.Партия
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Партия
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТТовары.Партия КАК Партия
	|ИЗ
	|	ВТТовары КАК ВТТовары
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ОстаткиТовара.Остатки(
	|				&Граница,
	|				Партия В
	|						(ВЫБРАТЬ
	|							Т.Партия
	|						ИЗ
	|							ВТТовары КАК Т)
	|					И Склад = &Склад
	|					И Фирма = &Фирма) КАК ОстаткиТовара
	|		ПО ВТТовары.Партия = ОстаткиТовара.Партия
	|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	|			Буфер.Партия КАК Партия,
	|			СУММА(Буфер.Количество) КАК Количество
	|		ИЗ
	|			РегистрСведений.БуферСканированияДляОстатков КАК Буфер
	|		ГДЕ
	|			Буфер.Склад = &Склад
	|			И Буфер.Фирма = &Фирма
	|			И Буфер.Партия В
	|					(ВЫБРАТЬ
	|						Т.Партия
	|					ИЗ
	|						ВТТовары КАК Т)
	|		
	|		СГРУППИРОВАТЬ ПО
	|			Буфер.Партия) КАК Буфер
	|		ПО ВТТовары.Партия = Буфер.Партия
	|ГДЕ
	|	ВТТовары.Количество > ЕСТЬNULL(ОстаткиТовара.ОстатокОстаток, 0) - ЕСТЬNULL(Буфер.Количество, 0)";

	Запрос.УстановитьПараметр("Товары", Объект.Товары.Выгрузить(, "Партия, Количество"));
	Запрос.УстановитьПараметр("Граница", Новый Граница(Новый МоментВремени(Объект.Дата, Объект.Ссылка), ВидГраницы.Исключая));
	Запрос.УстановитьПараметр("Склад", Объект.Склад);
	Запрос.УстановитьПараметр("Фирма", Объект.Фирма);

	КоличествоУдаленных = 0;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Для Каждого СтрокаТовара Из Объект.Товары.НайтиСтроки(Новый Структура("Партия", Выборка.Партия)) Цикл
			Объект.Товары.Удалить(СтрокаТовара);
			КоличествоУдаленных = КоличествоУдаленных + 1;
		КонецЦикла;
	КонецЦикла;

	Возврат КоличествоУдаленных;

КонецФункции

#КонецОбласти


&НаСервере
Процедура ЗаполнитьПривязки(Откуда)   
	
	локПривязки = ЗначениеИзСтрокиВнутр(Откуда);
	
	Если Объект.Привязки.Количество() <> 0 Тогда Объект.Привязки.Очистить() КонецЕсли; 
	
	Для Каждого Стр Из локПривязки Цикл
		Если Стр.СуммаДокумента = 0 Тогда Продолжить КонецЕсли;
		
		Нов = Объект.Привязки.Добавить();
		
		Нов.Сумма1 = Стр.СуммаДокумента;
		Нов.Валюта1 = Стр.ВалютаДокумента;
		Нов.Сумма2 = Стр.СуммаДолга;
		Нов.Валюта2 = Стр.ВалютаДолга;
		Нов.КроссКурс = Стр.КроссКурс;
		Нов.ОбратныйКурс = Стр.ОбратныйКурс;
		Нов.Док2 = Стр.Док;
		Нов.Примечание = Стр.Примечание;
		Нов.ЭтоПредоплата = Стр.ЭтоПредоплата;
	КонецЦикла; 
	
КонецПроцедуры

&НаКлиенте
Процедура МоиПривязки()  
	
	Если гоПЗ(Объект.Контрагент) Тогда Возврат КонецЕсли; 
	Если гоПЗ(Объект.Валюта) Тогда Возврат КонецЕсли; 
	Если НЕ Объект.Окончательно Тогда Возврат КонецЕсли; 
	//2016.08.26
	//Если гоЧужойДокумент(Объект.КемСоздан) Тогда Возврат КонецЕсли; 
	
	лПривязать = Объект.Сумма;
	Если лПривязать = 0 Тогда Возврат КонецЕсли; 
	
	МояЗаписать(Ложь);
	
	Если НЕ Объект.Проведен Тогда клОшибка("Документ не проведен!"); Возврат; КонецЕсли;
	
	Пар = Новый Структура("Док, Привязки, ТолькоПривязки", Объект.Ссылка, Объект.Привязки, 0);
	
	ОткрытьФорму("Обработка.ПривязкаДолгов.Форма.Форма", Пар, ЭтотОбъект, , , ,
		Новый ОписаниеОповещения("МоиПривязкиЗавершение", ЭтотОбъект)); 
		
КонецПроцедуры

&НаКлиенте
Процедура МоиПривязкиЗавершение(Рез, ДопПараметры) Экспорт
	Если Рез = Неопределено Тогда Возврат КонецЕсли; 
	
	СохМасПривязки = клПривязкиВМассив(Объект);
	ЗаполнитьПривязки(Рез.ПривязкиСтрока);
	МояЗаписать(Ложь);
	клОповеститьПривязки(Объект, СохМасПривязки);
КонецПроцедуры


&НаКлиенте
Процедура ОплатыЗачет(Команда)
	МоиПривязки();
КонецПроцедуры


