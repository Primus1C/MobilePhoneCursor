	// © Primus1C  ОКОНЧАНИЕ ◄
КонецПроцедуры

&НаКлиенте
Процедура МоиОстатки()
	стрОстатки = "?";
	Стр = Элементы.Товары.ТекущиеДанные;
	Если Стр = Неопределено Тогда Возврат КонецЕсли; 
	стрОстатки = омСервер.МоиОстатки(Объект.Ссылка, Стр.Номенклатура, Стр.Партия);
КонецПроцедуры

&НаКлиенте
Процедура МояЗаписать(ПроверятьМодифицированность = Истина)
	УстановитьВидимостьДоступность();
	
	Если ПроверятьМодифицированность Тогда
		Если НЕ Модифицированность Тогда Возврат КонецЕсли; КонецЕсли; 
		
	Записать(РежимЗаписиПроведение);
	МоиОстатки();
	МоиИтоги();
КонецПроцедуры

&НаКлиенте
Процедура УстановитьВидимостьДоступность()

	НетСтрок = Объект.Товары.Количество() = 0;
	ЕстьСтроки = НЕ НетСтрок;
	НеЗакрыто = НЕ Объект.Окончательно;
	
	Элементы.ТоварыУдалитьВсе.Видимость = НеЗакрыто;
	Элементы.ТоварыУдалитьТоварыБезОстатка.Видимость = НеЗакрыто И ОбщегоНазначенияПовтИсп.ДоступБухгалтерии();
	
	НастроитьДоступностьПоОкончательноИПериоду();
	
	Если НЕ ДокументЗаблокированДляРедактированияНаКлиенте() Тогда
		Элементы.Склад.ТолькоПросмотр = ЕстьСтроки;
		Элементы.Валюта.ТолькоПросмотр = ЕстьСтроки;
		Элементы.Контрагент.ТолькоПросмотр = ЕстьСтроки;
	КонецЕсли;
	
КонецПроцедуры

// Настройка доступности через общую процедуру: закрытый период / Окончательно / примечание.
//
&НаКлиенте
Процедура НастроитьДоступностьПоОкончательноИПериоду()
	
	ИменаТЧ = Новый Массив;
	ИменаТЧ.Добавить("Товары");
	
	ДопЗапрещенные = Новый Массив;
	ДопЗапрещенные.Добавить("ТоварыУдалитьВсе");
	ДопЗапрещенные.Добавить("ТоварыУдалитьТоварыБезОстатка");
	ДопЗапрещенные.Добавить("ТоварыИзБуфераОбмена");
	
	ОбщегоНазначенияКлиент.НастроитьДоступностьДокументаПоОкончательноИПериоду(
		ЭтаФорма,
		Объект.Дата,
		Объект.Окончательно,
		ИменаТЧ,
		ДокументЗаблокированПоПрочимПричинамНаКлиенте(),
		ДопЗапрещенные,
		Истина,
		Избранный,
		Истина);
	
КонецПроцедуры

// Избранный, оплата или привязанные суммы — документ нельзя редактировать.
//
// Возвращаемое значение:
//  Булево
//
&НаКлиенте
Функция ДокументЗаблокированПоПрочимПричинамНаКлиенте()
	
	Если Избранный Тогда
		Возврат Истина;
	КонецЕсли;
	
	Если Объект.СуммаПривязано <> 0 Тогда
		Возврат Истина;
	КонецЕсли;
	
	Если НЕ Объект.Ссылка.Пустая() Тогда 
		ОплатыВозвраты = омСервер.ЕстьОплатаДокумента(Объект.Ссылка);
		Если ОплатыВозвраты.ЕстьОплата Тогда
			Возврат Истина; 
		КонецЕсли;
	КонецЕсли;
	
	Возврат Ложь;
	
КонецФункции

// Документ недоступен для редактирования (период, Окончательно или прочие причины).
//
// Возвращаемое значение:
//  Булево
//
&НаКлиенте
Функция ДокументЗаблокированДляРедактированияНаКлиенте()
	
	Возврат ОбщегоНазначенияКлиент.ДокументЗаблокированДляРедактированияНаКлиенте(
		Объект.Дата,
		Объект.Окончательно,
		ДокументЗаблокированПоПрочимПричинамНаКлиенте());
	
КонецФункции

// Проверяет, что дата документа в закрытом периоде.
//
// Возвращаемое значение:
//  Булево
//
&НаКлиенте
Функция ПериодДокументаЗакрытНаКлиенте()
	
	Возврат ОбщегоНазначенияКлиент.ПериодДокументаЗакрытНаКлиенте(Объект.Дата);
	
КонецФункции


