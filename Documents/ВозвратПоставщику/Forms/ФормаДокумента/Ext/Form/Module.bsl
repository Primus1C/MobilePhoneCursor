&НаКлиенте
Процедура ИзБуфераОбмена(Команда)

	Если ЭтаФорма.ТолькоПросмотр Тогда Возврат КонецЕсли; 
	Если Объект.Окончательно Тогда Возврат КонецЕсли; 
	
	МоиИтоги();
	Если НЕ (стрОплата = "") Тогда Возврат КонецЕсли; 
	
	Если гоПЗ(Объект.Склад) Тогда клОшибка(НСтр("ru = 'Не задан склад!'; en = 'Warehouse not specified!'")); Возврат; КонецЕсли; 
	Если гоПЗ(Объект.Контрагент) Тогда клОшибка(НСтр("ru = 'Не задан контрагент!'; en = 'Counterparty not specified!'")); Возврат; КонецЕсли; 
	Если гоПЗ(Объект.Валюта) Тогда клОшибка(НСтр("ru = 'Не задана валюта!'; en = 'Currency not specified!'")); Возврат; КонецЕсли; 
	
	Если гоПЗ(Объект.Ссылка) Тогда МояЗаписать(Ложь) КонецЕсли; 
	
	РаботаСоСканеромШК.ПолучитьИМЕИИзБуфера(Новый ОписаниеОповещения("ИзБуфераОбменаПослеПолученияБуфера", ЭтотОбъект));
	
КонецПроцедуры

&НаКлиенте
Процедура ИзБуфераОбменаПослеПолученияБуфера(Буф, ДопПараметры) Экспорт
	
	КвоСтрок = СтрЧислоСтрок(Буф);
	
	МассивСерий = Новый Массив;
	Для Н = 1 По КвоСтрок Цикл
		НовСер = "";
		С = СтрПолучитьСтроку(Буф, Н);
		Пока (НовСер = "") И (С <> "") Цикл
			НовСер = гоСледПолеТаб(С);
		КонецЦикла;
		Серия = СокрЛП(НовСер);
		Если Серия <> "" Тогда
			МассивСерий.Добавить(Серия);
		КонецЕсли;
	КонецЦикла;
	
	Если МассивСерий.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	СоотвПартий = СведенияПартийПоСериям(МассивСерий);
	
	Ошибки = Новый СписокЗначений;
	СтрокиКПереносу = Новый Массив;
	УжеВДокументе = Новый Соответствие;
	УжеВБуфере = Новый Соответствие;
	
	Для Каждого Серия Из МассивСерий Цикл
		
		КлючСерии = ВРег(Серия);
		Если УжеВБуфере.Получить(КлючСерии) <> Неопределено Тогда
			Ошибки.Добавить(СтрШаблон("Серия %1 повторяется в буфере!", Серия));
			Продолжить;
		КонецЕсли;
		УжеВБуфере.Вставить(КлючСерии, Истина);
		
		СписокПартий = СоотвПартий.Получить(КлючСерии);
		Если СписокПартий = Неопределено Тогда
			Ошибки.Добавить(СтрШаблон("Нет остатков по серии: %1!", Серия));
			Продолжить;
		КонецЕсли;
		
		Если СписокПартий.Количество() > 1 Тогда
			Ошибки.Добавить(СтрШаблон("Серия %1: найдено несколько партий на остатке (неоднозначно)!", Серия));
			Продолжить;
		КонецЕсли;
		
		СведенияПартии = СписокПартий[0];
		
		Если СведенияПартии.Контрагент <> Объект.Контрагент Тогда
			Ошибки.Добавить(СтрШаблон("Серия %1: не тот поставщик (%2)!", Серия, гоИмя(СведенияПартии.Контрагент)));
			Продолжить;
		КонецЕсли;
		
		Если СведенияПартии.Валюта <> Объект.Валюта Тогда
			Ошибки.Добавить(СтрШаблон("Серия %1: не та валюта (%2)!", Серия, гоИмя(СведенияПартии.Валюта)));
			Продолжить;
		КонецЕсли;
		
		Если УжеВДокументе.Получить(СведенияПартии.Партия) <> Неопределено
			Или Объект.Товары.НайтиСтроки(Новый Структура("Партия", СведенияПартии.Партия)).Количество() > 0 Тогда
			Ошибки.Добавить(СтрШаблон("Серия %1: уже есть в документе!", Серия));
			Продолжить;
		КонецЕсли;
		
		УжеВДокументе.Вставить(СведенияПартии.Партия, Истина);
		
		СтрокаКПереносу = Новый Структура;
		СтрокаКПереносу.Вставить("Серия", Серия);
		СтрокаКПереносу.Вставить("Номенклатура", СведенияПартии.Номенклатура);
		СтрокаКПереносу.Вставить("Партия", СведенияПартии.Партия);
		СтрокаКПереносу.Вставить("ЦенаЗакупки", СведенияПартии.ЦенаЗакупки);
		СтрокиКПереносу.Добавить(СтрокаКПереносу);
		
	КонецЦикла;
	
	Если Ошибки.Количество() = 0 Тогда
		ИзБуфераОбменаЗаполнитьТовары(СтрокиКПереносу);
		Возврат;
	КонецЕсли;
	
	ТекстОшибок = "";
	Для Каждого Ош Из Ошибки Цикл
		гоРезСоо(ТекстОшибок, Ош.Значение, Символы.ПС);
	КонецЦикла;
	
	Если СтрокиКПереносу.Количество() = 0 Тогда
		клОшибка(ТекстОшибок, , "Ошибки заполнения из буфера");
		Возврат;
	КонецЕсли;
	
	ТекстВопроса = ТекстОшибок + Символы.ПС + Символы.ПС
		+ "Перенести непроблемные серии в документ?";
	клНетДа(Новый ОписаниеОповещения("ИзБуфераОбменаПослеВопросаОПереносе", ЭтотОбъект, СтрокиКПереносу), ТекстВопроса);
	
КонецПроцедуры

&НаКлиенте
Процедура ИзБуфераОбменаПослеВопросаОПереносе(Результат, СтрокиКПереносу) Экспорт
	
	Если Не Результат Тогда
		Возврат;
	КонецЕсли;
	
	ИзБуфераОбменаЗаполнитьТовары(СтрокиКПереносу);
	
КонецПроцедуры

&НаКлиенте
Процедура ИзБуфераОбменаЗаполнитьТовары(СтрокиКПереносу)
	
	Если СтрокиКПереносу.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	НовыхСтрок = 0;
	Для Каждого Сведения Из СтрокиКПереносу Цикл
		НовСтр = Объект.Товары.Добавить();
		НовСтр.Номенклатура = Сведения.Номенклатура;
		НовСтр.Партия 		= Сведения.Партия;
		НовСтр.Серия 		= Сведения.Серия;
		НовСтр.Количество 	= 1;
		НовСтр.ЦенаЗакупки 	= Сведения.ЦенаЗакупки;
		НовСтр.СуммаЗакупки = Сведения.ЦенаЗакупки;
		НовыхСтрок = НовыхСтрок + 1;
	КонецЦикла;
	
	МояЗаписать(Ложь);
	гоЗаписьЖурналаРегистрации("Добавлено из буфера обмена строк: " + НовыхСтрок,
		ИмяДокумента + ?(Объект.Окончательно, "ПослеОкончательно", ""), "Добавление строк", Объект.Ссылка, 2);
	
	Если Объект.Товары.Количество() > 0 Тогда
		Элементы.Товары.ТекущаяСтрока = Объект.Товары[Объект.Товары.Количество() - 1].ПолучитьИдентификатор();
	КонецЕсли;
	
	МоиИтоги();
	
КонецПроцедуры

// Возвращает соответствие ВРег(Серия) -> Массив структур сведений партий на остатке.
//
// Параметры:
//  МассивСерий - Массив из Строка - серии из буфера обмена.
//
// Возвращаемое значение:
//  Соответствие - ключ ВРег(серия), значение Массив из Структура:
//   * Партия       - СправочникСсылка.Партии;
//   * Номенклатура - СправочникСсылка.Номенклатура;
//   * Контрагент   - СправочникСсылка.Контрагенты;
//   * Валюта       - СправочникСсылка.Валюты;
//   * ЦенаЗакупки  - Число;
//   * Остаток      - Число.
//
&НаСервере
Функция СведенияПартийПоСериям(МассивСерий)
	
	МассивВРег = Новый Массив;
	МассивНРег = Новый Массив;
	Для Каждого Эл Из МассивСерий Цикл
		МассивВРег.Добавить(ВРег(Эл));
		МассивНРег.Добавить(НРег(Эл));
	КонецЦикла;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	Рег.Партия КАК Партия,
	               |	Рег.ОстатокОстаток - ЕСТЬNULL(Буфер.Количество, 0) КАК Остаток,
	               |	Рег.Партия.Серия КАК Серия,
	               |	Рег.Номенклатура КАК Номенклатура,
	               |	Рег.Партия.Контрагент КАК Контрагент,
	               |	Рег.Партия.Валюта КАК Валюта,
	               |	Рег.Партия.ЦенаЗакупки КАК ЦенаЗакупки
	               |ИЗ
	               |	РегистрНакопления.ОстаткиТовара.Остатки КАК Рег
	               |		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	               |			БуферПартий.Партия КАК Партия,
	               |			СУММА(БуферПартий.Количество) КАК Количество
	               |		ИЗ
	               |			РегистрСведений.БуферСканированияДляОстатков КАК БуферПартий
	               |		ГДЕ
	               |			БуферПартий.Фирма = &Фирма
	               |			И БуферПартий.Склад = &Склад
	               |		
	               |		СГРУППИРОВАТЬ ПО
	               |			БуферПартий.Партия) КАК Буфер
	               |		ПО Рег.Партия = Буфер.Партия
	               |ГДЕ
	               |	Рег.Фирма = &Фирма
	               |	И Рег.Склад = &Склад
	               |	И Рег.ОстатокОстаток - ЕСТЬNULL(Буфер.Количество, 0) >= 1
	               |	И (Рег.Партия.Серия В (&Серии)
	               |			ИЛИ Рег.Партия.Серия В (&СерииНРег)
	               |			ИЛИ Рег.Партия.Серия В (&СерииВРег))
	               |	И НЕ Рег.Партия.Серия В
	               |			(ВЫБРАТЬ
	               |				БуферСерий.Серия
	               |			ИЗ
	               |				РегистрСведений.БуферСканированияДляОстатков КАК БуферСерий
	               |			ГДЕ
	               |				(БуферСерий.Серия В (&Серии)
	               |					ИЛИ БуферСерий.Серия В (&СерииНРег)
	               |					ИЛИ БуферСерий.Серия В (&СерииВРег)))";
	Запрос.УстановитьПараметр("Серии", МассивСерий);
	Запрос.УстановитьПараметр("СерииНРег", МассивНРег);
	Запрос.УстановитьПараметр("СерииВРег", МассивВРег);
	Запрос.УстановитьПараметр("Склад", Объект.Склад);
	Запрос.УстановитьПараметр("Фирма", Объект.Фирма);
	
	СоотвПартий = Новый Соответствие;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		
		КлючСерии = ВРег(СокрЛП(Выборка.Серия));
		СписокПартий = СоотвПартий.Получить(КлючСерии);
		Если СписокПартий = Неопределено Тогда
			СписокПартий = Новый Массив;
			СоотвПартий.Вставить(КлючСерии, СписокПартий);
		КонецЕсли;
		
		УжеЕсть = Ложь;
		Для Каждого ЭлСписка Из СписокПартий Цикл
			Если ЭлСписка.Партия = Выборка.Партия Тогда
				УжеЕсть = Истина;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		Если УжеЕсть Тогда
			Продолжить;
		КонецЕсли;
		
		СведенияПартии = Новый Структура("Партия,Номенклатура,Контрагент,Валюта,ЦенаЗакупки,Остаток",
			Выборка.Партия, Выборка.Номенклатура, Выборка.Контрагент,
			Выборка.Валюта, Выборка.ЦенаЗакупки, Выборка.Остаток);
		СписокПартий.Добавить(СведенияПартии);
		
	КонецЦикла;
	
	Возврат СоотвПартий;
	
КонецФункции


&НаКлиенте
Процедура УдалитьВсе(Команда) 
	
	Если ЭтаФорма.ТолькоПросмотр Тогда Возврат КонецЕсли;
	Если Объект.Окончательно Тогда Возврат КонецЕсли; 
	
	МоиИтоги();
	Если НЕ (стрОплата = "") Тогда Возврат КонецЕсли; 
	
	клНетДа(Новый ОписаниеОповещения("УдалитьВсеЗавершение", ЭтотОбъект), "Удалить все строки?"); 
	
КонецПроцедуры

