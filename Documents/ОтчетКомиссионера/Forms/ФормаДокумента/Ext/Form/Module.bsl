// Красный текст ЦенаОтчета, если не совпадает с ЦенойКомитента.
//
&НаСервере
Процедура УстановитьУсловноеОформлениеЦеныКомиссионера()
	
	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("ЦветТекста", WebЦвета.Красный);
	
	ЭлементОтбора = ЭлементУО.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Объект.Товары.ЦенаОтчетаОтличается");
	ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	ЭлементОтбора.ПравоеЗначение = Истина;
	ЭлементОтбора.Использование = Истина;
	
	ОформляемоеПоле = ЭлементУО.Поля.Элементы.Добавить();
	ОформляемоеПоле.Поле = Новый ПолеКомпоновкиДанных("ТоварыЦенаОтчета");
	ОформляемоеПоле.Использование = Истина;
	
КонецПроцедуры

// Заполняет дополнительную колонку ЦенаКомитента по регистру ТоварыНаКомиссии.
//
&НаСервере
Процедура ЗаполнитьЦеныКомитента()
	
	Партии = Новый Массив;
	ДокументыПродажи = Новый Массив;
	Для Каждого СтрокаТЧ Из Объект.Товары Цикл
		Если ЗначениеЗаполнено(СтрокаТЧ.Партия) И Партии.Найти(СтрокаТЧ.Партия) = Неопределено Тогда
			Партии.Добавить(СтрокаТЧ.Партия);
		КонецЕсли;
		Если ЗначениеЗаполнено(СтрокаТЧ.ДокументПродажи) И ДокументыПродажи.Найти(СтрокаТЧ.ДокументПродажи) = Неопределено Тогда
			ДокументыПродажи.Добавить(СтрокаТЧ.ДокументПродажи);
		КонецЕсли;
	КонецЦикла;
	
	ЭтоВозврат = Объект.ВидОперации = Перечисления.ВидыОперацииОтчетКомиссионера.ВозвратОтПокупателя;
	Если ЗначениеЗаполнено(Объект.Ссылка) Тогда
		Граница = Новый Граница(Объект.Ссылка.МоментВремени(), ВидГраницы.Исключая);
	Иначе
		Граница = Объект.Дата;
	КонецЕсли;
	
	ЦеныКомитента = Комиссия.ЦеныКомитентаПоПартиям(
		Партии,
		Граница,
		Объект.Контрагент,
		Объект.СкладКомиссии,
		ЭтоВозврат,
		ДокументыПродажи);
	
	Для Каждого СтрокаТЧ Из Объект.Товары Цикл
		ЦенаКомитента = ЦеныКомитента.Получить(СтрокаТЧ.Партия);
		СтрокаТЧ.ЦенаКомитента = ?(ЦенаКомитента = Неопределено, 0, ЦенаКомитента);
		ОбновитьОтличиеЦеныОтчета(СтрокаТЧ);
	КонецЦикла;
	
КонецПроцедуры

// Признак для условного оформления: ЦенаОтчета не равна ЦенеКомитента.
//
// Параметры:
//  СтрокаТЧ - ДанныеФормыЭлементКоллекции - строка табличной части Товары.
//
&НаКлиентеНаСервереБезКонтекста
Процедура ОбновитьОтличиеЦеныОтчета(СтрокаТЧ)
	
	СтрокаТЧ.ЦенаОтчетаОтличается = (СтрокаТЧ.ЦенаОтчета <> СтрокаТЧ.ЦенаКомитента);
	
КонецПроцедуры

