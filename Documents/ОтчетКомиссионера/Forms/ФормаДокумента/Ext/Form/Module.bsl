&НаКлиенте
Процедура ТоварыСерияПриИзменении(Элемент)
	
	ТекДанные = Элементы.Товары.ТекущиеДанные;
	//ЗаполнитьРеквизитыПоСерии(ТекДанные, ТекДанные.Серия);
	
	СписокПартий = ОстаткиПартий(ТекДанные.Серия);        
	КолвоПартий = СписокПартий.Количество();
	Если КолвоПартий = 0 Тогда
		//Сигнал(); 
		ОбщегоНазначенияКлиент.Звук();
		клОшибка(?(ЭтоВозвратОтПокупателя(),
			СтрШаблон(НСтр("ru = 'Нет в отчете комиссионера (продажа) серии: %1'; en = 'Series %1 was not found in a consignment sale report'"), ТекДанные.Серия),
			"Нет остатков по серии: " + ТекДанные.Серия + "!"));
		Возврат;
	ИначеЕсли КолвоПартий > 1 Тогда
		//Сигнал();  
		ОбщегоНазначенияКлиент.Звук();
		//Эле = СписокПартий.ВыбратьЭлемент("Найдено несколько партий с такой серией, выберите:");
		//Если Эле = Неопределено Тогда Возврат КонецЕсли;
		//ТекПартия = Эле.Значение;
		ВыбратьВариант(СписокПартий);
	Иначе
		//ТекПартия = СписокПартий[0]; 
		ЗаполнитьРеквизитыПоСерии(ТекДанные, СписокПартий.Получить(0).Значение); 
     КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьРеквизитыПоСерии(СтрокаТЧ, СтруктураДанных)
	
	СтрокаТЧ.Номенклатура 	= СтруктураДанных.Номенклатура;
	СтрокаТЧ.Партия 		= СтруктураДанных.Партия;  
	СтрокаТЧ.Количество 	= 1;
	Если СтруктураДанных.Свойство("ДокументПродажи") Тогда
		СтрокаТЧ.ДокументПродажи = СтруктураДанных.ДокументПродажи;
	КонецЕсли;
	Если СтруктураДанных.Свойство("Цена") И ЗначениеЗаполнено(СтруктураДанных.Цена) Тогда
		СтрокаТЧ.Цена = СтруктураДанных.Цена;
		СтрокаТЧ.Сумма = СтрокаТЧ.Цена * СтрокаТЧ.Количество;
	КонецЕсли;
	Если СтруктураДанных.Свойство("ЦенаКомитента") Тогда
		СтрокаТЧ.ЦенаКомитента = СтруктураДанных.ЦенаКомитента;
	КонецЕсли;
	ОбновитьОтличиеЦеныОтчета(СтрокаТЧ);
	
КонецПроцедуры

&НаСервере
Функция ОстаткиПартий(Серия)
	
	спис = Новый СписокЗначений;
	Если Объект.ВидОперации = Перечисления.ВидыОперацииОтчетКомиссионера.ВозвратОтПокупателя Тогда
		ТаблицаПартий = ТаблицаПартийИзОтчетовПродажи(Серия);
	Иначе
		ТаблицаПартий = Комиссия.ОстаткиПартийНаКомиссии(Серия, Объект.Ссылка.МоментВремени(), Объект.Фирма, Объект.СкладКомиссии);
	КонецЕсли;
	Для каждого парт Из ТаблицаПартий Цикл
		СтруктураПартии = Новый Структура("Номенклатура,ИмяНоменклатуры,Партия,Количество,Сумма,СуммаКомиссионера,ДокументПродажи,Цена,ЦенаКомитента");
		ЗаполнитьЗначенияСвойств(СтруктураПартии, парт);
		спис.Добавить(СтруктураПартии, парт.ИмяНоменклатуры);	
	КонецЦикла;	
    Возврат спис;
	
КонецФункции

// Партии серии из последнего проведённого отчёта комиссионера (продажа) текущего контрагента и склада.
//
// Параметры:
//  Серия - Строка - серия для поиска.
//
// Возвращаемое значение:
//  ТаблицаЗначений - Номенклатура, Партия, Серия, Цена, ДокументПродажи и др.
//
&НаСервере
Функция ТаблицаПартийИзОтчетовПродажи(Серия)
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Контрагент", Объект.Контрагент);
	Запрос.УстановитьПараметр("Склад", Объект.СкладКомиссии);
	Запрос.УстановитьПараметр("Дата", Объект.Дата);
	Запрос.УстановитьПараметр("Серия", Серия);
	Запрос.УстановитьПараметр("СерияВРег", ВРег(Серия));
	Запрос.УстановитьПараметр("СерияНРег", НРег(Серия));
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ОтчетТовары.Номенклатура КАК Номенклатура,
	|	ОтчетТовары.Номенклатура.Наименование КАК ИмяНоменклатуры,
	|	ОтчетТовары.Партия КАК Партия,
	|	ВЫБОР
	|		КОГДА ОтчетТовары.Серия <> """"
	|			ТОГДА ОтчетТовары.Серия
	|		ИНАЧЕ ОтчетТовары.Партия.Серия
	|	КОНЕЦ КАК Серия,
	|	ОтчетТовары.Ссылка КАК ДокументПродажи,
	|	ВЫБОР
	|		КОГДА ОтчетТовары.Цена <> 0
	|			ТОГДА ОтчетТовары.Цена
	|		КОГДА ОтчетТовары.Количество = 0
	|			ТОГДА 0
	|		ИНАЧЕ ОтчетТовары.Сумма / ОтчетТовары.Количество
	|	КОНЕЦ КАК Цена,
	|	1 КАК Количество,
	|	ОтчетТовары.Ссылка.Дата КАК ДатаОтчета
	|ИЗ
	|	Документ.ОтчетКомиссионера.Товары КАК ОтчетТовары
	|ГДЕ
	|	ОтчетТовары.Ссылка.Проведен
	|	И НЕ ОтчетТовары.Ссылка.ПометкаУдаления
	|	И (ОтчетТовары.Ссылка.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацииОтчетКомиссионера.Продажа)
	|			ИЛИ ОтчетТовары.Ссылка.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацииОтчетКомиссионера.ПустаяСсылка))
	|	И ОтчетТовары.Ссылка.Контрагент = &Контрагент
	|	И ОтчетТовары.Ссылка.СкладКомиссии = &Склад
	|	И ОтчетТовары.Ссылка.Дата <= &Дата
	|	И ОтчетТовары.Номенклатура.ТипНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.Товар)
	|	И (ОтчетТовары.Серия = &Серия
	|			ИЛИ ОтчетТовары.Серия = &СерияНРег
	|			ИЛИ ОтчетТовары.Серия = &СерияВРег
	|			ИЛИ ОтчетТовары.Партия.Серия = &Серия
	|			ИЛИ ОтчетТовары.Партия.Серия = &СерияНРег
	|			ИЛИ ОтчетТовары.Партия.Серия = &СерияВРег)
	|
	|УПОРЯДОЧИТЬ ПО
	|	ДатаОтчета УБЫВ,
	|	ДокументПродажи УБЫВ";
	
	ТаблицаПартий = Запрос.Выполнить().Выгрузить();
	ТаблицаПартий.Колонки.Добавить("Сумма");
	ТаблицаПартий.Колонки.Добавить("ЦенаКомитента");
	
	Результат = ТаблицаПартий.СкопироватьКолонки();
	ОбработанныеПартии = Новый Соответствие;
	Для Каждого СтрокаПартии Из ТаблицаПартий Цикл
		Если ОбработанныеПартии.Получить(СтрокаПартии.Партия) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		ОбработанныеПартии.Вставить(СтрокаПартии.Партия, Истина);
		НоваяСтрока = Результат.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаПартии);
		НоваяСтрока.Сумма = НоваяСтрока.Цена;
	КонецЦикла;
	
	Партии = Результат.ВыгрузитьКолонку("Партия");
	ДокументыПродажи = Результат.ВыгрузитьКолонку("ДокументПродажи");
	ЦеныКомитента = Комиссия.ЦеныКомитентаПоПартиям(
		Партии,
		Объект.Дата,
		Объект.Контрагент,
		Объект.СкладКомиссии,
		Истина,
		ДокументыПродажи);
	Для Каждого СтрокаПартии Из Результат Цикл
		ЦенаКомитента = ЦеныКомитента.Получить(СтрокаПартии.Партия);
		СтрокаПартии.ЦенаКомитента = ?(ЦенаКомитента = Неопределено, 0, ЦенаКомитента);
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции 

&НаКлиенте
Процедура ВыбратьВариант(СписокВариантов) Экспорт

	// Создаем описание оповещения. 
	// 1-й параметр: Имя процедуры, которая сработает после закрытия
	// 2-й параметр: Модуль, где находится эта процедура (ЭтаФорма)
	ОповещениеОЗакрытии = Новый ОписаниеОповещения("ПослеЗакрытияФормыВыбораВарианта", ЭтаФорма);
	
	// Открываем форму. ОписаниеОповещения передается 7-м параметром  
	ПараметрыОткрытия = Новый Структура("Список, Заголовок", СписокВариантов, НСтр("ru = 'Выберите партию'; en = 'Select tha batch'"));
	ОткрытьФорму("ОбщаяФорма.ВыборПростогоВарианта", ПараметрыОткрытия, ЭтаФорма, , , , ОповещениеОЗакрытии);	

КонецПроцедуры

&НаКлиенте
Процедура ПослеЗакрытияФормыВыбораВарианта(РезультатЗакрытия, ДополнительныеПараметры) Экспорт
	
	Если РезультатЗакрытия <> Неопределено Тогда
		ЗаполнитьРеквизитыПоСерии(Элементы.Товары.ТекущиеДанные, РезультатЗакрытия.ВыбранноеЗначение)
	КонецЕсли;
	
КонецПроцедуры


&НаКлиенте
Процедура ТоварыПриИзменении(Элемент)
	
	ОтобразитьИтоги();

КонецПроцедуры

&НаКлиенте
Процедура ТоварыПослеУдаления(Элемент)
	
	Объект.СуммаКомиссии = Объект.Товары.Итог("СуммаКомиссии");
	ОтобразитьИтоги();
	
КонецПроцедуры

&НаКлиенте
Процедура ТоварыСуммаКомиссииПриИзменении(Элемент)

	Объект.СуммаКомиссии = Объект.Товары.Итог("СуммаКомиссии");

КонецПроцедуры


&НаКлиенте
Процедура ТоварыПриАктивизацииСтроки(Элемент)
		
	// 1. Отключаем предыдущий вызов, чтобы они не накапливались при быстром скроллинге
    ОтключитьОбработчикОжидания("ОбновитьИнфоСтрокуАсинхронно");
    
    // 2. Подключаем обработчик однократно с задержкой 0.2 секунды
    ПодключитьОбработчикОжидания("ОбновитьИнфоСтрокуАсинхронно", 0.2, Истина);

КонецПроцедуры

&НаКлиенте
Процедура ОбновитьИнфоСтрокуАсинхронно()
    
    ТекДанные = Элементы.Товары.ТекущиеДанные;
    
    Если ТекДанные = Неопределено Тогда 
        Элементы.ДекорацияИнфоСтроки.Заголовок = "";
        Возврат;
    КонецЕсли;
    
    Ит = 0;
    НайдСтроки = Объект.Товары.НайтиСтроки(Новый Структура("Номенклатура", ТекДанные.Номенклатура));
    Для каждого НайдСтрока Из НайдСтроки Цикл
        Ит = Ит + НайдСтрока.Количество;
    КонецЦикла;
    
    Если Ит > 0 Тогда
        Стр = СтрШаблон("%1: %2", 
                        НСтр("ru = 'Количество товара текущей строки'; en = 'Quantity of the current line good'"),
                        омСервер.Фрмт(Ит, "ЧИСЛОЦЕЛ_ЦВ1"));
                        
        Элементы.ДекорацияИнфоСтроки.Заголовок = Новый ФорматированнаяСтрока(ОбщегоНазначенияСервер.ТекстHTMLВФорматированнуюСтроку(Стр));                
    Иначе
        Элементы.ДекорацияИнфоСтроки.Заголовок = "";
    КонецЕсли;    
    
КонецПроцедуры  

&НаКлиенте
Процедура ТоварыПартияПриИзменении(Элемент)
	
	ТекДанные = Элементы.Товары.ТекущиеДанные;
	ТекДанные.Серия = гоРеквизит(ТекДанные.Партия, "Серия");
	Если ЭтоВозвратОтПокупателя() И ЗначениеЗаполнено(ТекДанные.Серия) Тогда
		СведенияПартии = СведенияПартии(ТекДанные.Серия);
		Если СведенияПартии <> Неопределено Тогда
			ЗаполнитьРеквизитыПоСерии(ТекДанные, СведенияПартии);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ТоварыЦенаОтчетаПриИзменении(Элемент)
	
	ТекДанные = Элементы.Товары.ТекущиеДанные;
	Если ТекДанные <> Неопределено Тогда
		ОбновитьОтличиеЦеныОтчета(ТекДанные);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ТоварыЦенаПриИзменении(Элемент)

	ТекДанные = Элементы.Товары.ТекущиеДанные;
    ТекДанные.Сумма = ТекДанные.Цена * ТекДанные.Количество;
	
КонецПроцедуры

&НаКлиенте
Процедура ТоварыСуммаПриИзменении(Элемент)

	ТекДанные = Элементы.Товары.ТекущиеДанные;
	Если ТекДанные.Количество = 0 Тогда
	 	ТекДанные.Количество = 1;
	КонецЕсли;	
	ТекДанные.Цена = ТекДанные.Сумма / ТекДанные.Количество;
	
КонецПроцедуры

&НаКлиенте
Процедура ТоварыКоличествоПриИзменении(Элемент)

	ТекДанные = Элементы.Товары.ТекущиеДанные;
    ТекДанные.Сумма = ТекДанные.Цена * ТекДанные.Количество;
	
КонецПроцедуры

#КонецОбласти  


#Область ПодключаемаяПечать
	
&НаКлиенте
Процедура ВыполнитьПодключеннуюПечать(Команда)
	
	ВариантПечатнойФормы = СтрЗаменить(Команда.Имя, "ПодключеннаяПечать_", "");   
	ТабДок = ПечатнаяФорма(ВариантПечатнойФормы);
	ПараметрыПечати = Новый Структура("Таб, Имя, НеДляПечати", ТабДок, гоИмя(Объект.Ссылка, Ложь), Ложь);
	ОткрытьФорму("ОбщаяФорма.ПечатьБезЗащиты", ПараметрыПечати, , Истина); 
		
КонецПроцедуры  

&НаСервере
Функция ПечатнаяФорма(ВариантПечатнойФормы)

	ТабДок = Новый ТабличныйДокумент;
	Документы.ОтчетКомиссионера.ПечатьДокумента(Объект.Ссылка, ВариантПечатнойФормы, ТабДок);
	Возврат ТабДок;
	
КонецФункции 

#КонецОбласти

