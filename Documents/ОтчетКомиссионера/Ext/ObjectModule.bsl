
Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;

    омСервер.ЗаписатьОбщиеРеквизиты(ЭтотОбъект);  
	
	Если ВидОперации = Перечисления.ВидыОперацииОтчетКомиссионера.Продажа Тогда 
		Для каждого СтрокаТЧ Из Товары Цикл
			СтрокаТЧ.ДокументПродажи = Документы.ОтчетКомиссионера.ПустаяСсылка();	
		КонецЦикла;
	КонецЕсли;
    Количество = Товары.Итог("Количество");
	Сумма = Товары.Итог("Сумма");

КонецПроцедуры

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, ТекстЗаполнения, СтандартнаяОбработка)

	ОбщегоНазначенияСервер.ЗаполнитьРеквизитыДокументаПоУмолчанию(ЭтотОбъект);
    ВидОперации = Перечисления.ВидыОперацииОтчетКомиссионера.Продажа;
	
КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	
	ТоварыУслуги = ТаблицаТоварыУслуги();
	ТаблицаТовары = ТоварыУслуги.Товары;
	ТаблицаУслуги = ТоварыУслуги.Услуги;
	ПроверкаВозможностиПроведения(ТаблицаТовары, Отказ);

	Если Отказ Тогда
		Возврат;
	КонецЕсли;  
	
	Если ВидОперации = Перечисления.ВидыОперацииОтчетКомиссионера.ВозвратОтПокупателя Тогда
		СформироватьДвиженияВозвратаОтПокупателя(Отказ);
		Возврат;
	КонецЕсли;
	
	Доход = 0;
	ДолгТоваров = 0;
	ПроцентКомиссии = 1 - Контрагент.ПроцентКомиссионногоВознаграждения / 100;
	
	Движения.ОстаткиТовара.Записывать 		= Истина;
	Движения.ТоварыНаКомиссии.Записывать 	= Истина;
	Движения.Продажи.Записывать 			= Истина;
	Движения.РасходыДоходы.Записывать 		= Истина;
	Движения.Долги.Записывать 				= Истина;

	Для Каждого ТекСтрокаТовары Из ТаблицаТовары Цикл  
		
		// РН ОстаткиТовара
		Движение = Движения.ОстаткиТовара.Добавить();
		Движение.ВидДвижения 	= ВидДвиженияНакопления.Расход;
		Движение.Период 		= Дата;
		Движение.Номенклатура 	= ТекСтрокаТовары.Номенклатура;
		Движение.Партия 		= ТекСтрокаТовары.Партия;
		Движение.Склад 			= СкладКомиссии;
		Движение.Фирма 			= Фирма;
		Движение.Остаток 		= ТекСтрокаТовары.Количество; 
		
		// РН ТоварыНаКомиссии
		Движение = Движения.ТоварыНаКомиссии.Добавить();
		Движение.ВидДвижения 		= ВидДвиженияНакопления.Расход; 
		Движение.Период 			= Дата;
 		Движение.Номенклатура 		= ТекСтрокаТовары.Номенклатура;
		Движение.Партия 			= ТекСтрокаТовары.Партия;
		Движение.Контрагент 		= Контрагент;
		Движение.Склад 				= СкладКомиссии;
        Движение.Количество			= ТекСтрокаТовары.Количество;  
		К = ТекСтрокаТовары.Количество / ТекСтрокаТовары.КоличествоНаКомиссии; 
		СуммаЗакупкиСЗатратами  = ТекСтрокаТовары.СуммаНаКомиссии * К; //(долл)  
		СуммаПередачиНаКомиссию = ТекСтрокаТовары.СуммаКомиссионера * К; // (долл)
		Движение.Сумма				= СуммаЗакупкиСЗатратами; 		
		Движение.СуммаКомиссионера 	= СуммаПередачиНаКомиссию;    
		
		// РН Продажи 
		Движение = Движения.Продажи.Добавить(); 
		Движение.Период				= Дата;
		Движение.Номенклатура		= ТекСтрокаТовары.Номенклатура;
		Движение.Партия				= ТекСтрокаТовары.Партия;
		Движение.ДокументПрихода	= ТекСтрокаТовары.ДокументПрихода;
		Движение.Покупатель			= Контрагент;
		Движение.Поставщик			= ТекСтрокаТовары.Поставщик;
		Движение.Валюта				= Валюта;
		Движение.Автор				= КемСоздан;
		Движение.Склад				= СкладКомиссии;
		Движение.Фирма				= Фирма;
		Движение.Количество			= ТекСтрокаТовары.Количество;     
		// суммой продажи считаем полную сумму, которую прислал комиссионер (несмотря на то, что от нее отнимается процент вознаграждения)
		Движение.Сумма				= ТекСтрокаТовары.Сумма;
		Движение.СуммаВБазВалюте	= ТекСтрокаТовары.Сумма / Курс;
		Движение.Наценка            = ТекСтрокаТовары.Сумма - СуммаЗакупкиСЗатратами * Курс;
		Движение.НаценкаВБазВалюте	= ТекСтрокаТовары.Сумма / Курс - СуммаЗакупкиСЗатратами; 
		// доход  
		Доход = Доход + 
				//ТекСтрокаТовары.СуммаКомиссионера - ТекСтрокаТовары.СуммаНаКомиссии + 					// превышение цены, по к-рой передан товар над ценой закупки
				//(ТекСтрокаТовары.Сумма / Курс - ТекСтрокаТовары.СуммаКомиссионера) * ПроцентКомиссии;   // разница от цены реализации и ценой, по к-рой товар передан комиссионеру
				ТекСтрокаТовары.Сумма / Курс - СуммаПередачиНаКомиссию;
		//ДолгТоваров = ДолгТоваров + ТекСтрокаТовары.Сумма - СуммаПередачиНаКомиссию * Курс;
		ДолгТоваров = ДолгТоваров + ТекСтрокаТовары.Сумма / Курс;
				
	КонецЦикла;
	
	// РН РасходыДоходы
	Движение = Движения.РасходыДоходы.Добавить();
	Движение.Период 	= Дата;
	Движение.Фирма 		= Фирма;
	Движение.Вид 		= Перечисления.ДоходРасход.Доход;
	Движение.Статья 	= Статья;
	Движение.Валюта 	= Валюта;
	Движение.Сумма 		= Доход;
	
	Для Каждого ТекСтрокаУслуги Из ТаблицаУслуги Цикл  
		Движение = Движения.РасходыДоходы.Добавить();
		Движение.Период 	= Дата;
		Движение.Фирма 		= Фирма;
		Движение.Вид 		= Перечисления.ДоходРасход.Расход;
		Движение.Статья 	= ТекСтрокаУслуги.Статья;
		Движение.Валюта 	= Валюта;
		Движение.Сумма 		= - ТекСтрокаУслуги.Сумма;
	КонецЦикла;
	
	// РН Долги
	Движение = Движения.Долги.ДобавитьПриход();
	Движение.Период 				= Дата;
	Движение.Фирма 					= Фирма;
	Движение.Док 					= Ссылка;
	Движение.Валюта 				= Валюта;
	Движение.Контрагент 			= Контрагент;
	Движение.ДолгПокупателя 		= ДолгТоваров + ТаблицаУслуги.Итог("Сумма");
	Движение.ПредоплатаПокупателя 	= 0;
	Движение.ДолгПоставщику 		= 0;
	Движение.ПредоплатаПоставщику 	= 0;

    // КОМИССИЯ
	
	Если СуммаКомиссии <> 0 Тогда
	
		Движение = Движения.РасходыДоходы.Добавить();
		Движение.Период 	= Дата;
		Движение.Фирма 		= Фирма;
		Движение.Вид 		= Перечисления.ДоходРасход.Расход;
		Движение.Статья 	= СтатьяКомиссии;
		Движение.Валюта 	= ВалютаКомиссии;
		Движение.Сумма 		= СуммаКомиссии;
		
		Движение = Движения.Долги.ДобавитьПриход();
		Движение.Период 				= Дата;
		Движение.Фирма 					= Фирма;
		Движение.Док 					= Ссылка;
		Движение.Валюта 				= ВалютаКомиссии;
		Движение.Контрагент 			= Контрагент;
		Движение.ДолгПокупателя 		= - СуммаКомиссии;
		Движение.ПредоплатаПокупателя 	= 0;
		Движение.ДолгПоставщику 		= 0;
		Движение.ПредоплатаПоставщику 	= 0; 
		
	КонецЕсли;
	
КонецПроцедуры


Процедура ПроверкаВозможностиПроведения(ТаблицаТовары, Отказ)
	
	Ошибки = Новый СписокЗначений;
	
	// Запрет незаполненных установлен в свойствах реквизитов шапки
	ПроведениеДокументов.ПроверитьЗаполнениеРеквизитов(ЭтотОбъект, "Контрагент,СкладКомиссии,Валюта,Курс", Отказ); 
	
	ПроведениеДокументов.ПроверитьНаОстаткиТоваров(ТаблицаТовары, МоментВремени(), СкладКомиссии, Ошибки, Фирма);
	ПроведениеДокументов.ПроверитьДубли(ТаблицаТовары, Ошибки);
	Если ВидОперации <> Перечисления.ВидыОперацииОтчетКомиссионера.ВозвратОтПокупателя Тогда
		ПроверитьОстаткиТоваровНаКомиссии(ТаблицаТовары, Ошибки);
	КонецЕсли;
	
	Для каждого Ош Из Ошибки Цикл
		Отказ = Истина;
		Сообщить(Ош.Значение);
	КонецЦикла; 
	
КонецПроцедуры

// Проверяет достаточность остатков регистра ТоварыНаКомиссии по складу комиссии и комиссионеру.
//
// Параметры:
//  ТаблицаТовары - ТаблицаЗначений - строки товаров: НомерСтроки, Количество, КоличествоНаКомиссии, Партия;
//  Ошибки        - СписокЗначений - тексты ошибок проведения.
//
Процедура ПроверитьОстаткиТоваровНаКомиссии(ТаблицаТовары, Ошибки)
	
	ОстаткиПоПартиям = Новый Соответствие;
	СтрокиОшибок = Новый Массив;
	
	Для Каждого СтрокаТовара Из ТаблицаТовары Цикл
		
		Если СтрокаТовара.Количество <= 0 Тогда
			Продолжить;
		КонецЕсли;
		
		Остаток = ОстаткиПоПартиям.Получить(СтрокаТовара.Партия);
		Если Остаток = Неопределено Тогда
			Остаток = СтрокаТовара.КоличествоНаКомиссии;
		КонецЕсли;
		
		Если СтрокаТовара.Количество > Остаток Тогда
			СтрокиОшибок.Добавить(СтрШаблон(
				НСтр("ru = 'строка %1: требуется %2, в наличии %3'; en = 'line %1: %2 required, %3 available'"),
				СтрокаТовара.НомерСтроки,
				СтрокаТовара.Количество,
				Остаток));
			ОстаткиПоПартиям.Вставить(СтрокаТовара.Партия, 0);
		Иначе
			ОстаткиПоПартиям.Вставить(СтрокаТовара.Партия, Остаток - СтрокаТовара.Количество);
		КонецЕсли;
		
	КонецЦикла;
	
	Если СтрокиОшибок.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Ошибки.Добавить(СтрШаблон(
		НСтр("ru = 'Недостаточно комиссионных товаров на складе %1 у комиссионера %2:'; en = 'Not enough consignment goods at warehouse %1 for commission agent %2:'"),
		СкладКомиссии,
		Контрагент));
	Для Каждого ТекстСтроки Из СтрокиОшибок Цикл
		Ошибки.Добавить(ТекстСтроки);
	КонецЦикла;
	
КонецПроцедуры

Функция ТаблицаТоварыУслуги()
	
	Запр = Новый Запрос;
	Запр.УстановитьПараметр("Ссылка", 	Ссылка);
	Запр.УстановитьПараметр("Дата", 	МоментВремени());
	Запр.УстановитьПараметр("Склад", 	СкладКомиссии);
	Запр.УстановитьПараметр("Контрагент", Контрагент);
	Запр.Текст = "ВЫБРАТЬ
	             |	ТоварыТЧ.НомерСтроки КАК НомерСтроки,
	             |	ТоварыТЧ.Номенклатура КАК Номенклатура,
	             |	ТоварыТЧ.Номенклатура.ТипНоменклатуры КАК ТипНоменклатуры,
	             |	ТоварыТЧ.Серия КАК Серия,
	             |	ТоварыТЧ.Партия КАК Партия,
	             |	ТоварыТЧ.Цена КАК Цена,
	             |	ТоварыТЧ.Количество КАК Количество,
	             |	ТоварыТЧ.Сумма КАК Сумма,
	             |	ТоварыТЧ.Партия.Контрагент КАК Поставщик,
	             |	ТоварыТЧ.Партия.Док КАК ДокументПрихода,
	             |	ЕСТЬNULL(ТоварыНаКомиссии.КоличествоОстаток, 0) КАК КоличествоНаКомиссии,
	             |	ЕСТЬNULL(ТоварыНаКомиссии.СуммаОстаток, 0) КАК СуммаНаКомиссии,
	             |	ЕСТЬNULL(ТоварыНаКомиссии.СуммаКомиссионераОстаток, 0) КАК СуммаКомиссионера
	             |ИЗ
	             |	Документ.ОтчетКомиссионера.Товары КАК ТоварыТЧ
	             |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ТоварыНаКомиссии.Остатки(
	             |				&Дата,
	             |				Контрагент = &Контрагент
	             |					И Склад = &Склад) КАК ТоварыНаКомиссии
	             |		ПО ТоварыТЧ.Партия = ТоварыНаКомиссии.Партия
	             |ГДЕ
	             |	ТоварыТЧ.Ссылка = &Ссылка
	             |	И ТоварыТЧ.Номенклатура.ТипНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.Товар)
	             |;
	             |
	             |////////////////////////////////////////////////////////////////////////////////
	             |ВЫБРАТЬ
	             |	ТоварыТЧ.НомерСтроки КАК НомерСтроки,
	             |	ТоварыТЧ.Номенклатура КАК Номенклатура,
	             |	ТоварыТЧ.Номенклатура.Статья КАК Статья,
	             |	ТоварыТЧ.Сумма КАК Сумма
	             |ИЗ
	             |	Документ.ОтчетКомиссионера.Товары КАК ТоварыТЧ
	             |ГДЕ
	             |	ТоварыТЧ.Ссылка = &Ссылка
	             |	И ТоварыТЧ.Номенклатура.ТипНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.Услуга)";
	Пакет = Запр.ВыполнитьПакет();
	
    Возврат Новый Структура("Товары,Услуги", Пакет[0].Выгрузить(), Пакет[1].Выгрузить());
	
КонецФункции 


// Сторно продажи комиссионного товара, возвращённого конечным покупателем на склад комиссии.
// Движения строятся по ДокументПродажи (отчёт с ВидОперации = Продажа). Сумма комиссии и услуги не сторнируются.
//
// Параметры:
//  Отказ - Булево - Истина, если проведение невозможно.
//
Процедура СформироватьДвиженияВозвратаОтПокупателя(Отказ)
	
	ПроведениеДокументов.ПроверитьЗаполнениеРеквизитов(ЭтотОбъект, "Контрагент,СкладКомиссии,Валюта,Курс", Отказ);
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	Если НЕ Контрагент.Комиссионер Тогда
		Сообщить(НСтр("ru = 'У контрагента должен быть установлен признак «Комиссионер».'; en = 'The counterparty must have the Consignee flag set.'"));
		Отказ = Истина;
	КонецЕсли;
	
	Если НЕ СкладКомиссии.СкладКомиссии Тогда
		Сообщить(НСтр("ru = 'У склада должен быть установлен признак «Склад комиссии».'; en = 'The warehouse must have the Consignment warehouse flag set.'"));
		Отказ = Истина;
	КонецЕсли;
	
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	Ошибки = Новый СписокЗначений;
	ПроведениеДокументов.ПроверитьДубли(Товары, Ошибки);
	Для Каждого Ош Из Ошибки Цикл
		Отказ = Истина;
		Сообщить(Ош.Значение);
	КонецЦикла;
	
	ПроверитьОтсутствиеОстатковПриВозвратеОтПокупателя(Отказ);
	
	Запр = Новый Запрос;
	Запр.УстановитьПараметр("Ссылка", Ссылка);
	Запр.УстановитьПараметр("Контрагент", Контрагент);
	Запр.УстановитьПараметр("Склад", СкладКомиссии);
	Запр.Текст =
	"ВЫБРАТЬ
	|	ТоварыТЧ.ДокументПродажи КАК ДокументПродажи,
	|	ТоварыТЧ.Партия КАК Партия
	|ПОМЕСТИТЬ ВТКлючи
	|ИЗ
	|	Документ.ОтчетКомиссионера.Товары КАК ТоварыТЧ
	|ГДЕ
	|	ТоварыТЧ.Ссылка = &Ссылка
	|	И ТоварыТЧ.Количество <> 0
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ОтчетТовары.Ссылка КАК ДокументПродажи,
	|	ОтчетТовары.Партия КАК Партия,
	|	СУММА(ОтчетТовары.Количество) КАК КоличествоОтчета,
	|	СУММА(ОтчетТовары.Сумма) КАК СуммаОтчета
	|ПОМЕСТИТЬ ВТКоличествоПродажи
	|ИЗ
	|	Документ.ОтчетКомиссионера.Товары КАК ОтчетТовары
	|ГДЕ
	|	ОтчетТовары.Ссылка В
	|			(ВЫБРАТЬ
	|				ВТКлючи.ДокументПродажи
	|			ИЗ
	|				ВТКлючи)
	|	И ОтчетТовары.Партия В
	|			(ВЫБРАТЬ
	|				ВТКлючи.Партия
	|			ИЗ
	|				ВТКлючи)
	|
	|СГРУППИРОВАТЬ ПО
	|	ОтчетТовары.Ссылка,
	|	ОтчетТовары.Партия
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Продажи.Регистратор КАК ДокументПродажи,
	|	Продажи.Партия КАК Партия,
	|	МАКСИМУМ(Продажи.ДокументПрихода) КАК ДокументПрихода,
	|	МАКСИМУМ(Продажи.Покупатель) КАК Покупатель,
	|	МАКСИМУМ(Продажи.Поставщик) КАК Поставщик,
	|	МАКСИМУМ(Продажи.Валюта) КАК Валюта,
	|	МАКСИМУМ(Продажи.Автор) КАК Автор,
	|	МАКСИМУМ(Продажи.Склад) КАК Склад,
	|	МАКСИМУМ(Продажи.Фирма) КАК Фирма,
	|	СУММА(Продажи.Количество) КАК Количество,
	|	СУММА(Продажи.Сумма) КАК Сумма,
	|	СУММА(Продажи.Наценка) КАК Наценка,
	|	СУММА(Продажи.СуммаВБазВалюте) КАК СуммаВБазВалюте,
	|	СУММА(Продажи.НаценкаВБазВалюте) КАК НаценкаВБазВалюте
	|ПОМЕСТИТЬ ВТПродажи
	|ИЗ
	|	РегистрНакопления.Продажи КАК Продажи
	|ГДЕ
	|	Продажи.Регистратор В
	|			(ВЫБРАТЬ
	|				ВТКлючи.ДокументПродажи
	|			ИЗ
	|				ВТКлючи)
	|	И Продажи.Партия В
	|			(ВЫБРАТЬ
	|				ВТКлючи.Партия
	|			ИЗ
	|				ВТКлючи)
	|
	|СГРУППИРОВАТЬ ПО
	|	Продажи.Регистратор,
	|	Продажи.Партия
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТоварыНаКомиссии.Регистратор КАК ДокументПродажи,
	|	ТоварыНаКомиссии.Партия КАК Партия,
	|	МАКСИМУМ(ТоварыНаКомиссии.Контрагент) КАК Контрагент,
	|	МАКСИМУМ(ТоварыНаКомиссии.Склад) КАК Склад,
	|	СУММА(ТоварыНаКомиссии.Количество) КАК Количество,
	|	СУММА(ТоварыНаКомиссии.Сумма) КАК Сумма,
	|	СУММА(ТоварыНаКомиссии.СуммаКомиссионера) КАК СуммаКомиссионера
	|ПОМЕСТИТЬ ВТКомиссия
	|ИЗ
	|	РегистрНакопления.ТоварыНаКомиссии КАК ТоварыНаКомиссии
	|ГДЕ
	|	ТоварыНаКомиссии.Регистратор В
	|			(ВЫБРАТЬ
	|				ВТКлючи.ДокументПродажи
	|			ИЗ
	|				ВТКлючи)
	|	И ТоварыНаКомиссии.Партия В
	|			(ВЫБРАТЬ
	|				ВТКлючи.Партия
	|			ИЗ
	|				ВТКлючи)
	|	И ТоварыНаКомиссии.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход)
	|
	|СГРУППИРОВАТЬ ПО
	|	ТоварыНаКомиссии.Регистратор,
	|	ТоварыНаКомиссии.Партия
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВозвратТовары.ДокументПродажи КАК ДокументПродажи,
	|	ВозвратТовары.Партия КАК Партия,
	|	СУММА(ВозвратТовары.Количество) КАК КоличествоВозвращено
	|ПОМЕСТИТЬ ВТДругиеВозвраты
	|ИЗ
	|	Документ.ОтчетКомиссионера.Товары КАК ВозвратТовары
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТКлючи КАК ВТКлючи
	|		ПО ВозвратТовары.ДокументПродажи = ВТКлючи.ДокументПродажи
	|			И ВозвратТовары.Партия = ВТКлючи.Партия
	|ГДЕ
	|	ВозвратТовары.Ссылка.Проведен
	|	И ВозвратТовары.Ссылка <> &Ссылка
	|	И ВозвратТовары.Ссылка.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацииОтчетКомиссионера.ВозвратОтПокупателя)
	|	И ВозвратТовары.Количество <> 0
	|
	|СГРУППИРОВАТЬ ПО
	|	ВозвратТовары.ДокументПродажи,
	|	ВозвратТовары.Партия
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТоварыТЧ.НомерСтроки КАК НомерСтроки,
	|	ТоварыТЧ.Номенклатура КАК Номенклатура,
	|	ТоварыТЧ.Партия КАК Партия,
	|	ТоварыТЧ.Количество КАК Количество,
	|	ТоварыТЧ.ДокументПродажи КАК ДокументПродажи,
	|	ТоварыТЧ.Номенклатура.ТипНоменклатуры КАК ТипНоменклатуры,
	|	ТоварыТЧ.Партия.Контрагент КАК ПоставщикПартии,
	|	ТоварыТЧ.Партия.Док КАК ДокументПриходаПартии,
	|	ЕСТЬNULL(ТоварыТЧ.ДокументПродажи.Проведен, ЛОЖЬ) КАК ДокументПродажиПроведен,
	|	ТоварыТЧ.ДокументПродажи.ПометкаУдаления КАК ДокументПродажиПометкаУдаления,
	|	ТоварыТЧ.ДокументПродажи.ВидОперации КАК ВидОперацииПродажи,
	|	ТоварыТЧ.ДокументПродажи.Контрагент КАК КонтрагентПродажи,
	|	ТоварыТЧ.ДокументПродажи.СкладКомиссии КАК СкладПродажи,
	|	ТоварыТЧ.ДокументПродажи.Дата КАК ДатаПродажи,
	|	ЕСТЬNULL(ТоварыТЧ.ДокументПродажи.Курс, 0) КАК КурсПродажи,
	|	ТоварыТЧ.ДокументПродажи.Валюта КАК ВалютаПродажи,
	|	ТоварыТЧ.ДокументПродажи.Статья КАК СтатьяПродажи,
	|	ЕСТЬNULL(ВТКоличествоПродажи.КоличествоОтчета, 0) КАК КоличествоОтчета,
	|	ЕСТЬNULL(ВТКоличествоПродажи.СуммаОтчета, 0) КАК СуммаОтчета,
	|	ЕСТЬNULL(ВТПродажи.Количество, 0) КАК КоличествоПродаж,
	|	ЕСТЬNULL(ВТПродажи.Сумма, 0) КАК СуммаПродаж,
	|	ЕСТЬNULL(ВТПродажи.Наценка, 0) КАК Наценка,
	|	ЕСТЬNULL(ВТПродажи.СуммаВБазВалюте, 0) КАК СуммаВБазВалюте,
	|	ЕСТЬNULL(ВТПродажи.НаценкаВБазВалюте, 0) КАК НаценкаВБазВалюте,
	|	ВТПродажи.ДокументПрихода КАК ДокументПрихода,
	|	ВТПродажи.Покупатель КАК Покупатель,
	|	ВТПродажи.Поставщик КАК Поставщик,
	|	ВТПродажи.Автор КАК Автор,
	|	ВТПродажи.Склад КАК СкладПродаж,
	|	ВТПродажи.Фирма КАК ФирмаПродаж,
	|	ЕСТЬNULL(ВТКомиссия.Количество, 0) КАК КоличествоКомиссии,
	|	ЕСТЬNULL(ВТКомиссия.Сумма, 0) КАК СуммаНаКомиссии,
	|	ЕСТЬNULL(ВТКомиссия.СуммаКомиссионера, 0) КАК СуммаКомиссионера,
	|	ЕСТЬNULL(ВТКомиссия.Контрагент, &Контрагент) КАК КонтрагентКомиссии,
	|	ЕСТЬNULL(ВТКомиссия.Склад, &Склад) КАК СкладКомиссииДвижений,
	|	ЕСТЬNULL(ВТДругиеВозвраты.КоличествоВозвращено, 0) КАК КоличествоВозвращено
	|ИЗ
	|	Документ.ОтчетКомиссионера.Товары КАК ТоварыТЧ
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТКоличествоПродажи КАК ВТКоличествоПродажи
	|		ПО ТоварыТЧ.ДокументПродажи = ВТКоличествоПродажи.ДокументПродажи
	|			И ТоварыТЧ.Партия = ВТКоличествоПродажи.Партия
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТПродажи КАК ВТПродажи
	|		ПО ТоварыТЧ.ДокументПродажи = ВТПродажи.ДокументПродажи
	|			И ТоварыТЧ.Партия = ВТПродажи.Партия
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТКомиссия КАК ВТКомиссия
	|		ПО ТоварыТЧ.ДокументПродажи = ВТКомиссия.ДокументПродажи
	|			И ТоварыТЧ.Партия = ВТКомиссия.Партия
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТДругиеВозвраты КАК ВТДругиеВозвраты
	|		ПО ТоварыТЧ.ДокументПродажи = ВТДругиеВозвраты.ДокументПродажи
	|			И ТоварыТЧ.Партия = ВТДругиеВозвраты.Партия
	|ГДЕ
	|	ТоварыТЧ.Ссылка = &Ссылка
	|	И ТоварыТЧ.Количество <> 0
	|
	|УПОРЯДОЧИТЬ ПО
	|	ТоварыТЧ.НомерСтроки";
	
	ТаблицаДанных = Запр.Выполнить().Выгрузить();
	
	ОстатокПоКлючу = Новый Соответствие;
	Для Каждого СтрокаДанных Из ТаблицаДанных Цикл
		
		Если СтрокаДанных.ТипНоменклатуры = Перечисления.ТипыНоменклатуры.Услуга Тогда
			Сообщить(СтрШаблон(НСтр("ru = 'Строка %1: услуги в возврате от покупателя не допускаются.'; en = 'Row %1: services are not allowed in a customer return.'"), СтрокаДанных.НомерСтроки));
			Отказ = Истина;
			Продолжить;
		КонецЕсли;
		
		Если СтрокаДанных.ТипНоменклатуры <> Перечисления.ТипыНоменклатуры.Товар Тогда
			Сообщить(СтрШаблон(НСтр("ru = 'Строка %1: тип номенклатуры должен быть только Товар.'; en = 'Row %1: item type must be Goods.'"), СтрокаДанных.НомерСтроки));
			Отказ = Истина;
			Продолжить;
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(СтрокаДанных.ДокументПродажи) Тогда
			Сообщить(СтрШаблон(НСтр("ru = 'Строка %1: не заполнен документ продажи.'; en = 'Row %1: sales document is not filled.'"), СтрокаДанных.НомерСтроки));
			Отказ = Истина;
			Продолжить;
		КонецЕсли;
		
		Если НЕ СтрокаДанных.ДокументПродажиПроведен ИЛИ СтрокаДанных.ДокументПродажиПометкаУдаления Тогда
			Сообщить(СтрШаблон(НСтр("ru = 'Строка %1: документ продажи должен быть проведён.'; en = 'Row %1: the sales document must be posted.'"), СтрокаДанных.НомерСтроки));
			Отказ = Истина;
			Продолжить;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(СтрокаДанных.ВидОперацииПродажи)
			И СтрокаДанных.ВидОперацииПродажи <> Перечисления.ВидыОперацииОтчетКомиссионера.Продажа Тогда
			Сообщить(СтрШаблон(НСтр("ru = 'Строка %1: документ продажи должен иметь вид операции «Продажа».'; en = 'Row %1: the sales document must have the Sale operation.'"), СтрокаДанных.НомерСтроки));
			Отказ = Истина;
			Продолжить;
		КонецЕсли;
		
		Если СтрокаДанных.КонтрагентПродажи <> Контрагент Тогда
			Сообщить(СтрШаблон(НСтр("ru = 'Строка %1: контрагент документа продажи не совпадает с контрагентом возврата.'; en = 'Row %1: sales document counterparty does not match the return.'"), СтрокаДанных.НомерСтроки));
			Отказ = Истина;
		КонецЕсли;
		
		Если СтрокаДанных.СкладПродажи <> СкладКомиссии Тогда
			Сообщить(СтрШаблон(НСтр("ru = 'Строка %1: склад комиссии документа продажи не совпадает со складом возврата.'; en = 'Row %1: sales document consignment warehouse does not match the return.'"), СтрокаДанных.НомерСтроки));
			Отказ = Истина;
		КонецЕсли;
		
		Если СтрокаДанных.ДатаПродажи > Дата Тогда
			Сообщить(СтрШаблон(НСтр("ru = 'Строка %1: дата документа продажи больше даты возврата.'; en = 'Row %1: sales document date is later than the return date.'"), СтрокаДанных.НомерСтроки));
			Отказ = Истина;
		КонецЕсли;
		
		Если СтрокаДанных.КурсПродажи = 0 Тогда
			Сообщить(СтрШаблон(НСтр("ru = 'Строка %1: в документе продажи не указан курс.'; en = 'Row %1: the sales document has no exchange rate.'"), СтрокаДанных.НомерСтроки));
			Отказ = Истина;
			Продолжить;
		КонецЕсли;
		
		Если СтрокаДанных.КоличествоОтчета = 0 Тогда
			Сообщить(СтрШаблон(НСтр("ru = 'Строка %1: партия не найдена в документе продажи.'; en = 'Row %1: the lot was not found in the sales document.'"), СтрокаДанных.НомерСтроки));
			Отказ = Истина;
			Продолжить;
		КонецЕсли;
		
		КлючОстатка = СтрШаблон("%1/%2", СтрокаДанных.ДокументПродажи.УникальныйИдентификатор(), СтрокаДанных.Партия.УникальныйИдентификатор());
		Если ОстатокПоКлючу.Получить(КлючОстатка) = Неопределено Тогда
			ОстатокПоКлючу.Вставить(КлючОстатка, СтрокаДанных.КоличествоОтчета - СтрокаДанных.КоличествоВозвращено);
		КонецЕсли;
		Осталось = ОстатокПоКлючу.Получить(КлючОстатка);
		Если СтрокаДанных.Количество > Осталось Тогда
			Сообщить(СтрШаблон(НСтр("ru = 'Строка %1: количество возврата (%2) превышает количество в документе продажи за вычетом других возвратов (%3).'; en = 'Row %1: return quantity (%2) exceeds the sales document quantity minus other returns (%3).'"),
				СтрокаДанных.НомерСтроки, СтрокаДанных.Количество, Осталось));
			Отказ = Истина;
			Продолжить;
		КонецЕсли;
		ОстатокПоКлючу.Вставить(КлючОстатка, Осталось - СтрокаДанных.Количество);
		
	КонецЦикла;
	
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	Движения.ОстаткиТовара.Записывать = Истина;
	Движения.ТоварыНаКомиссии.Записывать = Истина;
	Движения.Продажи.Записывать = Истина;
	Движения.РасходыДоходы.Записывать = Истина;
	Движения.Долги.Записывать = Истина;
	
	ПроцентКомиссии = 1 - Контрагент.ПроцентКомиссионногоВознаграждения / 100;
	
	Для Каждого СтрокаДанных Из ТаблицаДанных Цикл
		
		Если СтрокаДанных.ТипНоменклатуры <> Перечисления.ТипыНоменклатуры.Товар Тогда
			Продолжить;
		КонецЕсли;
		
		Коэффициент = СтрокаДанных.Количество / СтрокаДанных.КоличествоОтчета;
		СуммаПродаж = ?(СтрокаДанных.СуммаПродаж = 0, СтрокаДанных.СуммаОтчета, СтрокаДанных.СуммаПродаж);
		
		Движение = Движения.ОстаткиТовара.ДобавитьРасход();
		Движение.Период 		= Дата;
		Движение.Фирма 			= Фирма;
		Движение.Склад 			= СкладКомиссии;
		Движение.Номенклатура 	= СтрокаДанных.Номенклатура;
		Движение.Партия 		= СтрокаДанных.Партия;
		Движение.Остаток 		= - СтрокаДанных.Количество;
		
		Движение = Движения.ТоварыНаКомиссии.ДобавитьРасход();
		Движение.Период 			= Дата;
		Движение.Номенклатура 		= СтрокаДанных.Номенклатура;
		Движение.Партия 			= СтрокаДанных.Партия;
		Движение.Контрагент 		= СтрокаДанных.КонтрагентКомиссии;
		Движение.Склад 				= СтрокаДанных.СкладКомиссииДвижений;
		Движение.Количество 		= - СтрокаДанных.Количество;
		Движение.Сумма 				= - СтрокаДанных.СуммаНаКомиссии * Коэффициент;
		Движение.СуммаКомиссионера 	= - СтрокаДанных.СуммаКомиссионера * Коэффициент;
		
		Движение = Движения.Продажи.Добавить();
		Движение.Период				= Дата;
		Движение.Номенклатура		= СтрокаДанных.Номенклатура;
		Движение.Партия				= СтрокаДанных.Партия;
		Движение.ДокументПрихода	= ?(ЗначениеЗаполнено(СтрокаДанных.ДокументПрихода), СтрокаДанных.ДокументПрихода, СтрокаДанных.ДокументПриходаПартии);
		Движение.Покупатель			= ?(ЗначениеЗаполнено(СтрокаДанных.Покупатель), СтрокаДанных.Покупатель, Контрагент);
		Движение.Поставщик			= ?(ЗначениеЗаполнено(СтрокаДанных.Поставщик), СтрокаДанных.Поставщик, СтрокаДанных.ПоставщикПартии);
		Движение.Валюта				= ?(ЗначениеЗаполнено(СтрокаДанных.ВалютаПродажи), СтрокаДанных.ВалютаПродажи, Валюта);
		Движение.Автор				= СтрокаДанных.Автор;
		Движение.Склад				= ?(ЗначениеЗаполнено(СтрокаДанных.СкладПродаж), СтрокаДанных.СкладПродаж, СкладКомиссии);
		Движение.Фирма				= ?(ЗначениеЗаполнено(СтрокаДанных.ФирмаПродаж), СтрокаДанных.ФирмаПродаж, Фирма);
		Движение.Количество			= - СтрокаДанных.Количество;
		Движение.Сумма				= - СуммаПродаж * Коэффициент;
		Движение.СуммаВБазВалюте	= - ?(СтрокаДанных.СуммаВБазВалюте = 0, СуммаПродаж / СтрокаДанных.КурсПродажи, СтрокаДанных.СуммаВБазВалюте) * Коэффициент;
		Движение.Наценка			= - (СуммаПродаж - СтрокаДанных.СуммаНаКомиссии * СтрокаДанных.КурсПродажи) * Коэффициент;
		Движение.НаценкаВБазВалюте	= - (СуммаПродаж / СтрокаДанных.КурсПродажи - СтрокаДанных.СуммаНаКомиссии) * Коэффициент;
		
		ДоходСтроки = (СуммаПродаж / СтрокаДанных.КурсПродажи - СтрокаДанных.СуммаКомиссионера) * ПроцентКомиссии * Коэффициент;
		
		СтатьяДохода = СтрокаДанных.СтатьяПродажи;
		Если НЕ ЗначениеЗаполнено(СтатьяДохода) Тогда
			СтатьяДохода = Справочники.Статьи.ДоходОтПродажи;
		КонецЕсли;
		
		Движение = Движения.РасходыДоходы.Добавить();
		Движение.Период 	= Дата;
		Движение.Фирма 		= Фирма;
		Движение.Вид 		= Перечисления.ДоходРасход.Доход;
		Движение.Статья 	= СтатьяДохода;
		Движение.Валюта 	= ?(ЗначениеЗаполнено(СтрокаДанных.ВалютаПродажи), СтрокаДанных.ВалютаПродажи, Валюта);
		Движение.Сумма 		= - ДоходСтроки;
		
		Движение = Движения.Долги.ДобавитьРасход();
		Движение.Период 				= Дата;
		Движение.Фирма 					= Фирма;
		Движение.Док 					= СтрокаДанных.ДокументПродажи;
		Движение.Валюта 				= ?(ЗначениеЗаполнено(СтрокаДанных.ВалютаПродажи), СтрокаДанных.ВалютаПродажи, Валюта);
		Движение.Контрагент 			= Контрагент;
		Движение.ДолгПокупателя 		= (СуммаПродаж - СтрокаДанных.СуммаКомиссионера * СтрокаДанных.КурсПродажи) * Коэффициент;
		
	КонецЦикла;
	
КонецПроцедуры

// Для возврата от покупателя товар приходуется на склад комиссии, текущего остатка после продажи нет.
// Проверяет, что партия ещё не числится на складе и на комиссии (не продана / уже возвращена).
//
// Параметры:
//  Отказ - Булево - Истина, если партия уже есть в остатках.
//
Процедура ПроверитьОтсутствиеОстатковПриВозвратеОтПокупателя(Отказ)
	
	Запр = Новый Запрос;
	Запр.УстановитьПараметр("Ссылка", Ссылка);
	Запр.УстановитьПараметр("Граница", Новый Граница(МоментВремени(), ВидГраницы.Исключая));
	Запр.УстановитьПараметр("Фирма", Фирма);
	Запр.УстановитьПараметр("Склад", СкладКомиссии);
	Запр.УстановитьПараметр("Контрагент", Контрагент);
	Запр.Текст =
	"ВЫБРАТЬ
	|	ТоварыТЧ.НомерСтроки КАК НомерСтроки,
	|	ЕСТЬNULL(ОстаткиСклада.ОстатокОстаток, 0) КАК ОстатокСклада,
	|	ЕСТЬNULL(ОстаткиКомиссии.КоличествоОстаток, 0) КАК ОстатокКомиссии
	|ИЗ
	|	Документ.ОтчетКомиссионера.Товары КАК ТоварыТЧ
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ОстаткиТовара.Остатки(
	|				&Граница,
	|				Фирма = &Фирма
	|					И Склад = &Склад
	|					И Партия В
	|						(ВЫБРАТЬ
	|							Т.Партия
	|						ИЗ
	|							Документ.ОтчетКомиссионера.Товары КАК Т
	|						ГДЕ
	|							Т.Ссылка = &Ссылка)) КАК ОстаткиСклада
	|		ПО ТоварыТЧ.Партия = ОстаткиСклада.Партия
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ТоварыНаКомиссии.Остатки(
	|				&Граница,
	|				Контрагент = &Контрагент
	|					И Склад = &Склад
	|					И Партия В
	|						(ВЫБРАТЬ
	|							Т.Партия
	|						ИЗ
	|							Документ.ОтчетКомиссионера.Товары КАК Т
	|						ГДЕ
	|							Т.Ссылка = &Ссылка)) КАК ОстаткиКомиссии
	|		ПО ТоварыТЧ.Партия = ОстаткиКомиссии.Партия
	|ГДЕ
	|	ТоварыТЧ.Ссылка = &Ссылка
	|	И ТоварыТЧ.Количество <> 0
	|	И ТоварыТЧ.Номенклатура.ТипНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.Товар)
	|	И (ЕСТЬNULL(ОстаткиСклада.ОстатокОстаток, 0) > 0
	|		ИЛИ ЕСТЬNULL(ОстаткиКомиссии.КоличествоОстаток, 0) > 0)";
	
	Выборка = Запр.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Если Выборка.ОстатокСклада > 0 Тогда
			Сообщить(СтрШаблон(НСтр("ru = 'Строка %1: на складе комиссии уже есть эта партия (остаток %2).'; en = 'Row %1: this lot is already at the consignment warehouse (remaining %2).'"),
				Выборка.НомерСтроки, Выборка.ОстатокСклада));
			Отказ = Истина;
		КонецЕсли;
		Если Выборка.ОстатокКомиссии > 0 Тогда
			Сообщить(СтрШаблон(НСтр("ru = 'Строка %1: товар ещё числится на комиссии (остаток %2).'; en = 'Row %1: the goods are still on consignment (remaining %2).'"),
				Выборка.НомерСтроки, Выборка.ОстатокКомиссии));
			Отказ = Истина;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры
