// Возвращает доступные варианты печати документа
//
// Вовращаемое значение:
//  Струткура, каждая строка которой соответствует одному из вариантов печати
//  
Функция ПолучитьСтруктуруПечатныхФорм() Экспорт

	Возврат Новый Структура("ОтчетКомиссионера", 
							НСтр("ru='Отчет комиссионера';en='Commission Agent's Report'")
							);		

КонецФункции 

Процедура ПечатьДокумента(ДокСсылка, ВариантПечатнойФормы, ТабДокумент, Параметры = 0) Экспорт
	
	ТабДокумент.Очистить();
	Макет = Документы.ОтчетКомиссионера.ПолучитьМакет(ВариантПечатнойФормы);
	
	ЗапросШ = Новый Запрос;
	ЗапросШ.УстановитьПараметр("Ссылка", ДокСсылка);
	ЗапросШ.УстановитьПараметр("ПредставлениеДокумента",  ОбщегоНазначения.ПредставлениеДокументаДляПечати(ДокСсылка, ПолучитьСтруктуруПечатныхФорм()[ВариантПечатнойФормы]));
	ЗапросШ.Текст = "ВЫБРАТЬ
	                |	Док.Номер КАК Номер,
	                |	Док.Дата КАК Дата,
	                |	Док.Контрагент КАК Контрагент,
	                |	Док.ВидОперации КАК ВидОперации,
	                |	ВЫРАЗИТЬ(Док.Примечание КАК СТРОКА(1000)) КАК Примечание,
	                |	&ПредставлениеДокумента КАК ПредставлениеДокумента,
	                |	Док.СкладКомиссии КАК СкладКомиссии,
	                |	Док.Валюта КАК Валюта,
	                |	Док.Количество КАК Количество,
	                |	Док.Сумма КАК Сумма,
	                |	Док.ДокументОснование КАК ДокументОснование,
	                |	Док.СтатьяКомиссии КАК СтатьяКомиссии,
	                |	Док.ВалютаКомиссии КАК ВалютаКомиссии
	                |ИЗ
	                |	Документ.ОтчетКомиссионера КАК Док
	                |ГДЕ
	                |	Док.Ссылка = &Ссылка";
	Шапка = ЗапросШ.Выполнить().Выбрать();
	Шапка.Следующий();
	
	
  	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ссылка", ДокСсылка);

	ОбластьМакета = Макет.ПолучитьОбласть("Шапка");
	ОбластьМакета.Параметры.Заполнить(Шапка); 
	ТабДокумент.Вывести(ОбластьМакета);
	
	Запрос.Текст = "ВЫБРАТЬ
	               |	Товары.Номенклатура КАК Номенклатура,
	               |	Товары.Серия КАК Серия,
	               |	Товары.Партия КАК Партия,
	               |	Товары.Цена КАК Цена,
	               |	Товары.ЦенаОтчета КАК ЦенаОтчета,
	               |	Товары.Количество КАК Количество,
	               |	Товары.Сумма КАК Сумма,
	               |	Товары.ДокументПродажи КАК ДокументПродажи,
	               |	Товары.НомерСтроки КАК НомерСтроки
	               |ИЗ
	               |	Документ.ОтчетКомиссионера.Товары КАК Товары
	               |ГДЕ
	               |	Товары.Ссылка = &Ссылка";
	
	ТаблицаТовары = Запрос.Выполнить().Выгрузить();
	ЭтоВозврат = Шапка.ВидОперации = Перечисления.ВидыОперацииОтчетКомиссионера.ВозвратОтПокупателя;
	Граница = Новый Граница(ДокСсылка.МоментВремени(), ВидГраницы.Исключая);
	ЦеныКомитента = Комиссия.ЦеныКомитентаПоПартиям(
		ТаблицаТовары.ВыгрузитьКолонку("Партия"),
		Граница,
		Шапка.Контрагент,
		Шапка.СкладКомиссии,
		ЭтоВозврат,
		ТаблицаТовары.ВыгрузитьКолонку("ДокументПродажи"));
	
	ОбластьДно = Макет.ПолучитьОбласть("Дно");
	Если ТаблицаТовары.Количество() > 0 Тогда
		ОбластьДно.Параметры.Заполнить(ТаблицаТовары[ТаблицаТовары.Количество() - 1]);
	КонецЕсли;
				   
	ОбластьТовар = Макет.ПолучитьОбласть("Товар");
	НомерКолонкиЦенаОтчета = НомерКолонкиПараметраМакета(ОбластьТовар, "ЦенаОтчета");
	ЦветОбычный = Новый Цвет;
	СуммаЦенКомитента = 0;
	
	Для Каждого СтрокаТовара Из ТаблицаТовары Цикл
		ОбластьТовар.Параметры.Заполнить(СтрокаТовара);
		ЦенаКомитента = ЦеныКомитента.Получить(СтрокаТовара.Партия);
		Если ЦенаКомитента = Неопределено Тогда
			ЦенаКомитента = 0;
		КонецЕсли;
		ОбластьТовар.Параметры.ЦенаКомитента = ЦенаКомитента;
		СуммаЦенКомитента = СуммаЦенКомитента + ЦенаКомитента;
		Если НомерКолонкиЦенаОтчета > 0 Тогда
			ЯчейкаЦенаОтчета = ОбластьТовар.Область(1, НомерКолонкиЦенаОтчета, 1, НомерКолонкиЦенаОтчета);
			Если СтрокаТовара.ЦенаОтчета <> ЦенаКомитента Тогда
				ЯчейкаЦенаОтчета.ЦветТекста = WebЦвета.Красный;
			Иначе
				ЯчейкаЦенаОтчета.ЦветТекста = ЦветОбычный;
			КонецЕсли;
		КонецЕсли;
		ТабДокумент.Вывести(ОбластьТовар);
	КонецЦикла;

	ОбластьДно.Параметры.ЦенаКомитента = СуммаЦенКомитента;
	ТабДокумент.Вывести(ОбластьДно);

КонецПроцедуры

// Номер колонки ячейки области макета с указанным именем параметра.
//
// Параметры:
//  ОбластьМакета  - ТабличныйДокумент - область строки макета;
//  ИмяПараметра   - Строка - имя параметра ячейки.
//
// Возвращаемое значение:
//  Число - номер колонки (1...) или 0, если параметр не найден.
//
Функция НомерКолонкиПараметраМакета(ОбластьМакета, ИмяПараметра)
	
	Для НомерКолонки = 1 По ОбластьМакета.ШиринаТаблицы Цикл
		Если ОбластьМакета.Область(1, НомерКолонки, 1, НомерКолонки).Параметр = ИмяПараметра Тогда
			Возврат НомерКолонки;
		КонецЕсли;
	КонецЦикла;
	
	Возврат 0;
	
КонецФункции

