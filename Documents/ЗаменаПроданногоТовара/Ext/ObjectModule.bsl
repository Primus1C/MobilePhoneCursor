
#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ОбработчикиСобытий

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, СтандартнаяОбработка)
	
	Фирма = гоФирма();
	КемСоздан = гоПользователь();
	Создан = ТекущаяДатаСеанса();
	Окончательно = Ложь;
	
	Если ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.РасходнаяНакладная") Тогда
		ЗаполнитьПоРасходнойНакладной(ДанныеЗаполнения);
	ИначеЕсли ТипЗнч(ДанныеЗаполнения) = Тип("Структура")
		И ДанныеЗаполнения.Свойство("Основание")
		И ТипЗнч(ДанныеЗаполнения.Основание) = Тип("ДокументСсылка.РасходнаяНакладная") Тогда
		ЗаполнитьПоРасходнойНакладной(ДанныеЗаполнения.Основание);
	Иначе
		Склад = Фирма.Склад;
		МассивСкладов = ОбщегоНазначенияПовтИсп.МассивДоступныхСкладов();
		Если МассивСкладов.Количество() <> 0 Тогда
			Склад = МассивСкладов[0];
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

Процедура ПриКопировании(ОбъектКопирования)
	
	КемСоздан = гоПользователь();
	Создан = ТекущаяДатаСеанса();
	КемСохранен = Справочники.Пользователи.ПустаяСсылка();
	Сохранен = Дата(1, 1, 1);
	Окончательно = Ложь;
	
КонецПроцедуры

Процедура ПриУстановкеНовогоНомера(СтандартнаяОбработка, Префикс)
	
	Префикс = глПрефиксДефис(Фирма);
	
КонецПроцедуры

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	омСервер.ЗаписатьОбщиеРеквизиты(ЭтотОбъект);
	
КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	
	ПроверитьЗаполнениеПередПроведением(Отказ);
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	ПроверитьОстаткиПередПроведением(Отказ);
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	Движения.ОстаткиТовара.Записывать = Истина;
	Движения.Продажи.Записывать = Истина;
	
	ВалютаБазовая = гоПараметрСеанса("БазоваяВалюта");
	
	Для Каждого СтрокаТовара Из Товары Цикл
		
		// Возврат от покупателя на склад.
		ДвижениеОстатков = Движения.ОстаткиТовара.ДобавитьРасход();
		ДвижениеОстатков.Период = Дата;
		ДвижениеОстатков.Фирма = Фирма;
		ДвижениеОстатков.Склад = Склад;
		ДвижениеОстатков.Номенклатура = СтрокаТовара.Номенклатура;
		ДвижениеОстатков.Партия = СтрокаТовара.Партия;
		ДвижениеОстатков.Остаток = -1;
		
		// Выдача взамен со склада.
		ДвижениеОстатков = Движения.ОстаткиТовара.ДобавитьРасход();
		ДвижениеОстатков.Период = Дата;
		ДвижениеОстатков.Фирма = Фирма;
		ДвижениеОстатков.Склад = Склад;
		ДвижениеОстатков.Номенклатура = СтрокаТовара.НоменклатураВозврат;
		ДвижениеОстатков.Партия = СтрокаТовара.ПартияВозврат;
		ДвижениеОстатков.Остаток = 1;
		
		ДанныеПродажи = ДанныеПродажиПоПартии(ДокументОснование, СтрокаТовара.Номенклатура, СтрокаТовара.Партия);
		Если ДанныеПродажи = Неопределено Тогда
			Сообщить(СтрШаблон(
				"Строка %1: не найдены продажи по партии %2 в расходной накладной %3.",
				СтрокаТовара.НомерСтроки,
				СтрокаТовара.Партия,
				ДокументОснование));
			Отказ = Истина;
			Продолжить;
		КонецЕсли;
		
		// Сторно продажи возвращённого товара.
		ДвижениеПродажи = Движения.Продажи.Добавить();
		ДвижениеПродажи.Период = Дата;
		ДвижениеПродажи.Фирма = Фирма;
		ДвижениеПродажи.Покупатель = ДанныеПродажи.Покупатель;
		ДвижениеПродажи.Валюта = ДанныеПродажи.Валюта;
		ДвижениеПродажи.Номенклатура = ДанныеПродажи.Номенклатура;
		ДвижениеПродажи.Партия = ДанныеПродажи.Партия;
		ДвижениеПродажи.Поставщик = ДанныеПродажи.Поставщик;
		ДвижениеПродажи.ДокументПрихода = ДанныеПродажи.ДокументПрихода;
		ДвижениеПродажи.Автор = ДанныеПродажи.Автор;
		ДвижениеПродажи.Склад = ДанныеПродажи.Склад;
		ДвижениеПродажи.Количество = -ДанныеПродажи.Количество;
		ДвижениеПродажи.Сумма = -ДанныеПродажи.Сумма;
		ДвижениеПродажи.Наценка = -ДанныеПродажи.Наценка;
		ДвижениеПродажи.СуммаВБазВалюте = -ДанныеПродажи.СуммаВБазВалюте;
		ДвижениеПродажи.НаценкаВБазВалюте = -ДанныеПродажи.НаценкаВБазВалюте;
		
		// Продажа товара, выданного взамен (сумма как у исходной продажи — деньги не меняются).
		ЦенаЗакупки = СтрокаТовара.ПартияВозврат.ЦенаЗакупки;
		НаценкаНовая = ДанныеПродажи.Сумма - ЦенаЗакупки * ДанныеПродажи.Количество;
		СуммаВБазВалюте = РаботаСВалютой.Пересчитать2025(
			ДанныеПродажи.Сумма, ДанныеПродажи.Валюта, ВалютаБазовая, Фирма, Дата);
		НаценкаВБазВалюте = РаботаСВалютой.Пересчитать2025(
			НаценкаНовая, ДанныеПродажи.Валюта, ВалютаБазовая, Фирма, Дата);
		
		ДвижениеПродажи = Движения.Продажи.Добавить();
		ДвижениеПродажи.Период = Дата;
		ДвижениеПродажи.Фирма = Фирма;
		ДвижениеПродажи.Покупатель = ДанныеПродажи.Покупатель;
		ДвижениеПродажи.Валюта = ДанныеПродажи.Валюта;
		ДвижениеПродажи.Номенклатура = СтрокаТовара.НоменклатураВозврат;
		ДвижениеПродажи.Партия = СтрокаТовара.ПартияВозврат;
		ДвижениеПродажи.Поставщик = СтрокаТовара.ПартияВозврат.Контрагент;
		ДвижениеПродажи.ДокументПрихода = СтрокаТовара.ПартияВозврат.Док;
		ДвижениеПродажи.Автор = ДанныеПродажи.Автор;
		ДвижениеПродажи.Склад = Склад;
		ДвижениеПродажи.Количество = ДанныеПродажи.Количество;
		ДвижениеПродажи.Сумма = ДанныеПродажи.Сумма;
		ДвижениеПродажи.Наценка = НаценкаНовая;
		ДвижениеПродажи.СуммаВБазВалюте = СуммаВБазВалюте;
		ДвижениеПродажи.НаценкаВБазВалюте = НаценкаВБазВалюте;
		
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Заполняет шапку и ТЧ по расходной накладной (возврат от покупателя; выдача взамен — вручную).
//
// Параметры:
//  РасходнаяНакладная - ДокументСсылка.РасходнаяНакладная - основание.
//
Процедура ЗаполнитьПоРасходнойНакладной(РасходнаяНакладная)
	
	ДокументОснование = РасходнаяНакладная;
	Контрагент = РасходнаяНакладная.Контрагент;
	Склад = РасходнаяНакладная.Склад;
	Если ЗначениеЗаполнено(РасходнаяНакладная.Фирма) Тогда
		Фирма = РасходнаяНакладная.Фирма;
	КонецЕсли;
	
	Товары.Очистить();
	Для Каждого СтрокаРН Из РасходнаяНакладная.Товары Цикл
		Если НЕ ЗначениеЗаполнено(СтрокаРН.Партия) Тогда
			Продолжить;
		КонецЕсли;
		НоваяСтрока = Товары.Добавить();
		НоваяСтрока.Номенклатура = СтрокаРН.Номенклатура;
		НоваяСтрока.Партия = СтрокаРН.Партия;
		НоваяСтрока.Серия = СтрокаРН.Серия;
	КонецЦикла;
	
КонецПроцедуры

// Проверяет остатки: возврат не должен уже быть на складе; выдача взамен должна быть в наличии.
//
// Параметры:
//  Отказ - Булево - признак отказа.
//
Процедура ПроверитьОстаткиПередПроведением(Отказ)
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Фирма", Фирма);
	Запрос.УстановитьПараметр("Склад", Склад);
	Запрос.УстановитьПараметр("Дата", Дата);
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	Запрос.Текст = "ВЫБРАТЬ
	               |	Товары.НомерСтроки КАК НомерСтроки,
	               |	Товары.Партия КАК ПартияВозврата,
	               |	Товары.ПартияВозврат КАК ПартияВыдачи,
	               |	ЕСТЬNULL(ОстаткиВозврата.ОстатокОстаток, 0) КАК ОстатокВозврата,
	               |	ЕСТЬNULL(ОстаткиВыдачи.ОстатокОстаток, 0) КАК ОстатокВыдачи
	               |ИЗ
	               |	Документ.ЗаменаПроданногоТовара.Товары КАК Товары
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ОстаткиТовара.Остатки(
	               |				&Дата,
	               |				Фирма = &Фирма
	               |					И Склад = &Склад
	               |					И Партия В
	               |						(ВЫБРАТЬ
	               |							Т.Партия
	               |						ИЗ
	               |							Документ.ЗаменаПроданногоТовара.Товары КАК Т
	               |						ГДЕ
	               |							Т.Ссылка = &Ссылка)) КАК ОстаткиВозврата
	               |		ПО Товары.Партия = ОстаткиВозврата.Партия
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ОстаткиТовара.Остатки(
	               |				&Дата,
	               |				Фирма = &Фирма
	               |					И Склад = &Склад
	               |					И Партия В
	               |						(ВЫБРАТЬ
	               |							Т.ПартияВозврат
	               |						ИЗ
	               |							Документ.ЗаменаПроданногоТовара.Товары КАК Т
	               |						ГДЕ
	               |							Т.Ссылка = &Ссылка)) КАК ОстаткиВыдачи
	               |		ПО Товары.ПартияВозврат = ОстаткиВыдачи.Партия
	               |ГДЕ
	               |	Товары.Ссылка = &Ссылка";
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Если Выборка.ОстатокВозврата > 0 Тогда
			Сообщить(СтрШаблон(
				"Строка %1: партия возврата уже есть на складе.",
				Выборка.НомерСтроки));
			Отказ = Истина;
		КонецЕсли;
		Если Выборка.ОстатокВыдачи < 1 Тогда
			Сообщить(СтрШаблон(
				"Строка %1: недостаточно остатка для выдачи взамен.",
				Выборка.НомерСтроки));
			Отказ = Истина;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

// Проверяет обязательные реквизиты перед проведением.
//
// Параметры:
//  Отказ - Булево - признак отказа.
//
Процедура ПроверитьЗаполнениеПередПроведением(Отказ)
	
	Если НЕ ЗначениеЗаполнено(Контрагент) Тогда
		Сообщить("Не заполнен контрагент.");
		Отказ = Истина;
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(Склад) Тогда
		Сообщить("Не заполнен склад.");
		Отказ = Истина;
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(ДокументОснование) Тогда
		Сообщить("Не заполнен документ-основание (расходная накладная).");
		Отказ = Истина;
	КонецЕсли;
	Если Товары.Количество() = 0 Тогда
		Сообщить("Табличная часть «Товары» пуста.");
		Отказ = Истина;
	КонецЕсли;
	
	Для Каждого СтрокаТовара Из Товары Цикл
		Если НЕ ЗначениеЗаполнено(СтрокаТовара.Номенклатура)
			Или НЕ ЗначениеЗаполнено(СтрокаТовара.Партия) Тогда
			Сообщить(СтрШаблон(
				"Строка %1: заполните номенклатуру и партию возврата от покупателя.",
				СтрокаТовара.НомерСтроки));
			Отказ = Истина;
		КонецЕсли;
		Если НЕ ЗначениеЗаполнено(СтрокаТовара.НоменклатураВозврат)
			Или НЕ ЗначениеЗаполнено(СтрокаТовара.ПартияВозврат) Тогда
			Сообщить(СтрШаблон(
				"Строка %1: заполните номенклатуру и партию выдачи взамен.",
				СтрокаТовара.НомерСтроки));
			Отказ = Истина;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

// Возвращает запись регистра Продажи по расходной накладной, номенклатуре и партии.
//
// Параметры:
//  Регистратор   - ДокументСсылка.РасходнаяНакладная;
//  Номенклатура  - СправочникСсылка.Номенклатура;
//  Партия        - СправочникСсылка.Партии.
//
// Возвращаемое значение:
//  Структура, Неопределено - поля аналитики и ресурсов продажи.
//
Функция ДанныеПродажиПоПартии(Регистратор, Номенклатура, Партия)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Продажи.Покупатель КАК Покупатель,
	|	Продажи.Поставщик КАК Поставщик,
	|	Продажи.Автор КАК Автор,
	|	Продажи.Валюта КАК Валюта,
	|	Продажи.Номенклатура КАК Номенклатура,
	|	Продажи.Партия КАК Партия,
	|	Продажи.ДокументПрихода КАК ДокументПрихода,
	|	Продажи.Сумма КАК Сумма,
	|	Продажи.Количество КАК Количество,
	|	Продажи.Наценка КАК Наценка,
	|	Продажи.Склад КАК Склад,
	|	Продажи.СуммаВБазВалюте КАК СуммаВБазВалюте,
	|	Продажи.НаценкаВБазВалюте КАК НаценкаВБазВалюте
	|ИЗ
	|	РегистрНакопления.Продажи КАК Продажи
	|ГДЕ
	|	Продажи.Регистратор = &Регистратор
	|	И Продажи.Партия = &Партия
	|	И Продажи.Номенклатура = &Номенклатура";
	Запрос.УстановитьПараметр("Регистратор", Регистратор);
	Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
	Запрос.УстановитьПараметр("Партия", Партия);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если НЕ Выборка.Следующий() Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Результат = Новый Структура(
		"Покупатель, Поставщик, Автор, Валюта, Номенклатура, Партия, ДокументПрихода,
		|Сумма, Количество, Наценка, Склад, СуммаВБазВалюте, НаценкаВБазВалюте");
	ЗаполнитьЗначенияСвойств(Результат, Выборка);
	Возврат Результат;
	
КонецФункции

#КонецОбласти

#КонецЕсли
