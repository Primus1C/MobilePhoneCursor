КонецПроцедуры

#КонецОбласти

#Область РеквизитыФормы

&НаКлиенте
Процедура ТоварыНоменклатураПриИзменении(Элемент)

	ТекущиеДанные = Элементы.Товары.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ТекущиеДанные.Партия = Неопределено;
	ТекущиеДанные.Серия = "";

КонецПроцедуры

&НаКлиенте
Процедура ТоварыПартияПриИзменении(Элемент)

	ТекущиеДанные = Элементы.Товары.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ТекущиеДанные.Серия = гоРеквизит(ТекущиеДанные.Партия, "Серия");

КонецПроцедуры

&НаКлиенте
Процедура ТоварыНоменклатураВозвратПриИзменении(Элемент)

	ТекущиеДанные = Элементы.Товары.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ТекущиеДанные.ПартияВозврат = Неопределено;
	ТекущиеДанные.СерияВозврат = "";

КонецПроцедуры

&НаКлиенте
Процедура ТоварыПартияВозвратПриИзменении(Элемент)

	ТекущиеДанные = Элементы.Товары.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ТекущиеДанные.СерияВозврат = гоРеквизит(ТекущиеДанные.ПартияВозврат, "Серия");

КонецПроцедуры

#КонецОбласти

#Область Команды

&НаКлиенте
Процедура ИзменитьПримечание(Команда)

	клИзменитьПримечаниеДокумента(ЭтаФорма);

КонецПроцедуры

#КонецОбласти
