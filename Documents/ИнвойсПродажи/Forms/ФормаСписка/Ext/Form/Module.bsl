&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	гоСтандартныйОтборПоПолю("Контрагенты", Список, "Контрагент");
	УстановитьОтборПоПроформе();

	глПокраситьВалюты(ЭтаФорма, "Валюта");
   	глПокраситьПомеченныеНаУдаление(ЭтаФорма);

	глПокраситьСтатусы(ЭтаФорма, "Список", , , , Истина);  

	СтруктураПечатныхФорм = Документы.ИнвойсПродажи.ПолучитьСтруктуруПечатныхФорм();  
	ПараметрыРазмещения = Новый Структура("Форма, ЭтоФормаОбъекта, КоманднаяПанель", ЭтаФорма, Ложь, Неопределено);
	ОбщегоНазначенияСервер.ПодключитьКомандыПечати(ПараметрыРазмещения, СтруктураПечатныхФорм);   

КонецПроцедуры

&НаКлиенте
Процедура СписокПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа, Параметр)
	
	Если Копирование Или НЕ ЗначениеЗаполнено(Параметры.ОтборПоПроформе) Тогда
		Возврат;
	КонецЕсли;
	
	Отказ = Истина;
	ЗначенияЗаполнения = Новый Структура("Проформа", Параметры.ОтборПоПроформе);
	ОткрытьФорму("Документ.ИнвойсПродажи.ФормаОбъекта", Новый Структура("ЗначенияЗаполнения", ЗначенияЗаполнения), Элемент);
	
КонецПроцедуры

// Накладывает фиксированный отбор списка по параметру формы ОтборПоПроформе.
//
&НаСервере
Процедура УстановитьОтборПоПроформе()
	
	Если НЕ ЗначениеЗаполнено(Параметры.ОтборПоПроформе) Тогда
		Возврат;
	КонецЕсли;
	
	ЭлементОтбора = Список.КомпоновщикНастроек.ФиксированныеНастройки.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Проформа");
	ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	ЭлементОтбора.ПравоеЗначение = Параметры.ОтборПоПроформе;
	ЭлементОтбора.Использование = Истина;
	ЭлементОтбора.РежимОтображения = РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Недоступный;
	
	АвтоЗаголовок = Ложь;
	Заголовок = Строка(Параметры.ОтборПоПроформе);
	
КонецПроцедуры


#Область ПодключаемаяПечать
	
&НаКлиенте
Процедура ВыполнитьПодключеннуюПечать(Команда)
	
	ВариантПечатнойФормы = СтрЗаменить(Команда.Имя, "ПодключеннаяПечать_", "");   
	ТабДок = ПечатнаяФорма(ВариантПечатнойФормы);
	ПараметрыПечати = Новый Структура("Таб, Имя, НеДляПечати", ТабДок, гоИмя(ТекущийЭлемент.ТекущаяСтрока, Ложь), Ложь);
	ОткрытьФорму("ОбщаяФорма.ПечатьБезЗащиты", ПараметрыПечати, , Истина); 
		
КонецПроцедуры  

&НаСервере
Функция ПечатнаяФорма(ВариантПечатнойФормы)

	ТабДок = Новый ТабличныйДокумент;
	Документы.ИнвойсПродажи.ПечатьДокумента(ТекущийЭлемент.ТекущаяСтрока, ВариантПечатнойФормы, ТабДок);
	Возврат ТабДок;
	
КонецФункции 

#КонецОбласти 

