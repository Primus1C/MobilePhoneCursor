&НаСервере
Процедура ОтобразитьСтатус()
	
	СтруктураСтатуса = РаботаСИнвойсами.ПолучитьСтатусИнвойсаПродажи(Объект.Ссылка);	
	Статус = СтруктураСтатуса.Состояние;
	Если ЗначениеЗаполнено(Статус) Тогда
		Элементы.Статус.Подсказка = СтрШаблон("Установлен %1 %2", СтруктураСтатуса.Зарегистрировано, СтруктураСтатуса.КемИзменено); 
	Иначе	
		Элементы.Статус.Подсказка = ""; 
	КонецЕсли; 
	СтатусГотовКОтгрузке	= ЗначениеЗаполнено(СтруктураСтатуса.ГотовКОтгрузке);
	СтатусЗаблокирован      = ЗначениеЗаполнено(СтруктураСтатуса.Заблокирован);
	СтатусОтмененЗаказчиком = ЗначениеЗаполнено(СтруктураСтатуса.ОтмененЗаказчиком);

КонецПроцедуры

&НаСервере
Процедура ОтобразитьДекорациюРезервирование()
	
	Элементы.ГруппаРезервПредупреждение.Видимость = (Объект.Проформа = Перечисления.ВидыИнвойса.ЗаказПокупателя ИЛИ Объект.Проформа = Перечисления.ВидыИнвойса.ЗаказКомиссионера)
													И СтатусОтмененЗаказчиком 
													И НЕ РаботаСИнвойсами.ВыполнятьРезервирование(Объект.Ссылка);

КонецПроцедуры 

&НаКлиенте
Процедура УстановитьВидимостьДоступность()
	
	этоЗаказ = Объект.Проформа = ПредопределенноеЗначение("Перечисление.ВидыИнвойса.ЗаказПокупателя");
	этоКомиссия = Объект.Проформа = ПредопределенноеЗначение("Перечисление.ВидыИнвойса.ЗаказКомиссионера");
	этоВнешнийЗаказ = этоЗаказ ИЛИ этоКомиссия;
	
	Элементы.НомерВходящий.Видимость 		= этоВнешнийЗаказ;
	Элементы.ГруппаУчетнаяЗапись.Видимость 	= этоВнешнийЗаказ;
	Элементы.Получатель.Видимость 			= НЕ этоВнешнийЗаказ;
	Элементы.ГруппаФирма.Видимость			= НЕ этоВнешнийЗаказ;	
    Элементы.ГруппаДеньги.Видимость 		= НЕ этоВнешнийЗаказ; 
	
	Элементы.ТоварыЦенаКомитента.Видимость = этоКомиссия;
	Элементы.ТоварыСуммаКомитента.Видимость = этоКомиссия;   
	
	Если этоВнешнийЗаказ Тогда
		Элементы.ГруппаУчетнаяЗапись.Заголовок = Строка(Объект.Проформа);	
	КонецЕсли;
	
КонецПроцедуры

