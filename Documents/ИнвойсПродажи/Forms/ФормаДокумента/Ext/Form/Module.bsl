#Область Команды
	
&НаКлиенте
Процедура УстановитьЦены(Команда)

	ВыделенныеСтроки = Элементы.Товары.ВыделенныеСтроки;
	Если ВыделенныеСтроки.Количество() = 0 Тогда
		клОшибка("Выделите строки, для которых требуется установить цены.");
		Возврат;
	КонецЕсли;

	ИдентификаторыСтрок = Новый Массив;
	Для Каждого ИдентификаторСтроки Из ВыделенныеСтроки Цикл
		ИдентификаторыСтрок.Добавить(ИдентификаторСтроки);
	КонецЦикла;

	ДанныеЗаполнения = ДанныеЗаполненияУстановкиЦен(ИдентификаторыСтрок);
	Если ДанныеЗаполнения.Ошибка <> "" Тогда
		клОшибка(ДанныеЗаполнения.Ошибка);
		Возврат;
	КонецЕсли;

	ПараметрыФормы = Новый Структура("Основание", ДанныеЗаполнения);
	ОткрытьФорму("Документ.УстановкаЦен.ФормаОбъекта", ПараметрыФормы, ЭтаФорма);

КонецПроцедуры

// Подготавливает данные нового документа установки цен по выделенным строкам ИнвойсаПродажи.
//
// Параметры:
//  ВыделенныеСтроки - Массив - идентификаторы выделенных строк табличной части Товары.
//
// Возвращаемое значение:
//  Структура - поля ЭтоЗаполнениеИзИнвойсаПродажи, Ошибка, Фирма, Склад, ВидЦены, Товары.
//
&НаСервере
Функция ДанныеЗаполненияУстановкиЦен(ВыделенныеСтроки)

	Товары = Новый Массив;

	Результат = Новый Структура(
		"ЭтоЗаполнениеИзИнвойсаПродажи, Ошибка, Фирма, Склад, ВидЦены, Валюта, Товары",
		Истина,
		"",
		Объект.Фирма,
		Объект.Склад,    
		Объект.ВидЦены,
		Объект.Валюта,
		Товары);
		
	Ошибки = Новый СписокЗначений;
	Если НЕ ЗначениеЗаполнено(Объект.ВидЦены) Тогда
		Ошибки.Добавить("Не заполнен вид цены.");
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(Объект.Валюта) Тогда
		Ошибки.Добавить("Не заполнена валюта.");
	КонецЕсли;
	Если Ошибки.Количество() > 0 Тогда
		Для каждого Ош Из Ошибки Цикл
			Результат.Ошибка = Результат.Ошибка + Ош.Значение + Символы.ПС;
		КонецЦикла;
		Возврат Результат;
	КонецЕсли;

	Для Каждого ИдентификаторСтроки Из ВыделенныеСтроки Цикл
		СтрокаИнвойса = Объект.Товары[ИдентификаторСтроки];
		Если НЕ ЗначениеЗаполнено(СтрокаИнвойса.Номенклатура) Тогда
			Продолжить;
		КонецЕсли;

		Результат.Товары.Добавить(Новый Структура("Номенклатура, Цена", СтрокаИнвойса.Номенклатура, СтрокаИнвойса.Цена));
	КонецЦикла;

	Если Результат.Товары.Количество() = 0 Тогда
		Результат.Ошибка = "В выделенных строках не заполнена номенклатура.";
	КонецЕсли;

	Возврат Результат;

КонецФункции

