// Возвращает доступные варианты печати документа
//
// Вовращаемое значение:
//  Структура, каждая строка которой соответствует одному из вариантов печати
//  
Функция ПолучитьСтруктуруПечатныхФорм() Экспорт

	Возврат Новый Структура("Печать", 
							НСтр("ru='Печать';en='Prnt'")
							);		

КонецФункции 


Процедура ПечатьДокумента(ДокСсылка, ВариантПечатнойФормы, ТабДокумент, Параметры = 0) Экспорт
	
	ТабДокумент.Очистить();
	
	Если НЕ ЗначениеЗаполнено(ДокСсылка) Тогда
		Сообщить(НСтр("ru = 'Документ не записан. Запишите документ перед печатью.'; en = 'The document is not saved. Save it before printing.'"));
		Возврат;
	КонецЕсли;
	
	Макет = Документы.НачислениеПроцентовПоКредитам.ПолучитьМакет(ВариантПечатнойФормы);
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ссылка", ДокСсылка);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Док.ДатаНачала КАК ДатаНачала,
	|	Док.ДатаОкончания КАК ДатаОкончания
	|ИЗ
	|	Документ.НачислениеПроцентовПоКредитам КАК Док
	|ГДЕ
	|	Док.Ссылка = &Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Начисления.НомерСтроки КАК НомерСтроки,
	|	Начисления.Контрагент КАК Контрагент,
	|	Начисления.Договор КАК Договор,
	|	Начисления.Договор.Сумма КАК СуммаДоговора,
	|	Начисления.Ставка КАК ПроцентНачислений,
	|	Начисления.Сумма КАК Сумма
	|ИЗ
	|	Документ.НачислениеПроцентовПоКредитам.Начисления КАК Начисления
	|ГДЕ
	|	Начисления.Ссылка = &Ссылка
	|
	|УПОРЯДОЧИТЬ ПО
	|	НомерСтроки";
	Пакет = Запрос.ВыполнитьПакет();
	ВыборкаШапки = Пакет[0].Выбрать();
	Если НЕ ВыборкаШапки.Следующий() Тогда
		Возврат;
	КонецЕсли;
	
	ТаблицаСтрок = Пакет[1].Выгрузить();
	ТаблицаРасчета = ТаблицаСтрок.Скопировать(, "НомерСтроки, Договор, ПроцентНачислений");
	ТаблицаРасчета.Колонки.ПроцентНачислений.Имя = "Ставка";
	РезультатРасчета = РассчитатьНачисления(ТаблицаРасчета, ВыборкаШапки.ДатаНачала, ВыборкаШапки.ДатаОкончания);
	ПорядокПоСтрокам = Новый Соответствие;
	Для Каждого СтрокаРасчета Из РезультатРасчета Цикл
		ПорядокПоСтрокам.Вставить(СтрокаРасчета.НомерСтроки, СтрокаРасчета.ПорядокРасчета);
	КонецЦикла;
	
	КоличествоДней = ОбщегоНазначенияСервер.КоличествоДнейВПериоде(ВыборкаШапки.ДатаНачала, ВыборкаШапки.ДатаОкончания);
	ПериодНачислений = СтрШаблон("%1 — %2",
		Формат(ВыборкаШапки.ДатаНачала, "ДФ=dd.MM.yyyy"),
		Формат(ВыборкаШапки.ДатаОкончания, "ДФ=dd.MM.yyyy"));
	
	Шапка = Новый Структура("ПредставлениеДокумента, Период",
		ОбщегоНазначения.ПредставлениеДокументаДляПечати(ДокСсылка),
		ПериодНачислений);
	глВывестиСекцию(ТабДокумент, Макет, "Шапка", Шапка);
	
	ИтогоСумма = 0;
	Для Каждого СтрокаТЧ Из ТаблицаСтрок Цикл
		СтрокаПечати = Новый Структура;
		СтрокаПечати.Вставить("НомерСтроки", СтрокаТЧ.НомерСтроки);
		СтрокаПечати.Вставить("Контрагент", СтрокаТЧ.Контрагент);
		СтрокаПечати.Вставить("СуммаДоговора", СтрокаТЧ.СуммаДоговора);
		СтрокаПечати.Вставить("ПроцентНачислений", СтрокаТЧ.ПроцентНачислений);
		СтрокаПечати.Вставить("ПериодНачислений", ПериодНачислений);
		СтрокаПечати.Вставить("КоличествоДней", КоличествоДней);
		СтрокаПечати.Вставить("Сумма", СтрокаТЧ.Сумма);
		ПорядокРасчета = ПорядокПоСтрокам.Получить(СтрокаТЧ.НомерСтроки);
		СтрокаПечати.Вставить("ПорядокРасчета", ?(ПорядокРасчета = Неопределено, "", ПорядокРасчета));
		глВывестиСекцию(ТабДокумент, Макет, "Строка", СтрокаПечати);
		ИтогоСумма = ИтогоСумма + СтрокаТЧ.Сумма;
	КонецЦикла;
	
	глВывестиСекцию(ТабДокумент, Макет, "Дно", Новый Структура("ИтогоСумма", ИтогоСумма));
	
	ТабДокумент.ОриентацияСтраницы = ОриентацияСтраницы.Ландшафт;
	ТабДокумент.АвтоМасштаб = Истина;
	
КонецПроцедуры

// Рассчитывает проценты по строкам начислений за период по остаткам тела инвестиции в регистре.
// Тело берётся на начало каждого дня; изменение тела (ДвижениеДенег, вид Инвестиции) действует со следующего дня.
// Если движений тела по договору нет — база равна сумме кредитного договора.
//
// Параметры:
//  ТаблицаНачислений - ТаблицаЗначений - колонки НомерСтроки, Договор, Ставка;
//  ДатаНачала        - Дата - начало периода начисления;
//  ДатаОкончания     - Дата - окончание периода начисления.
//
// Возвращаемое значение:
//  ТаблицаЗначений - колонки НомерСтроки, Сумма, ПорядокРасчета.
//
Функция РассчитатьНачисления(ТаблицаНачислений, ДатаНачала, ДатаОкончания) Экспорт
	
	Результат = Новый ТаблицаЗначений;
	Результат.Колонки.Добавить("НомерСтроки", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(10, 0)));
	Результат.Колонки.Добавить("Сумма", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15, 2)));
	Результат.Колонки.Добавить("ПорядокРасчета", Новый ОписаниеТипов("Строка"));
	
	Если ТаблицаНачислений.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;
	
	ДатаНачалаДня = НачалоДня(ДатаНачала);
	ДатаОкончанияДня = НачалоДня(ДатаОкончания);
	Договоры = ТаблицаНачислений.ВыгрузитьКолонку("Договор");
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Договоры", Договоры);
	Запрос.УстановитьПараметр("ДатаНачала", ДатаНачалаДня);
	Запрос.УстановитьПараметр("ДатаОкончания", КонецДня(ДатаОкончанияДня));
	Запрос.Текст =
	"ВЫБРАТЬ
	|	КредитныеДоговоры.Ссылка КАК Договор,
	|	КредитныеДоговоры.Сумма КАК СуммаДоговора,
	|	КредитныеДоговоры.ПериодНачисления КАК ПериодНачисления
	|ИЗ
	|	Справочник.КредитныеДоговоры КАК КредитныеДоговоры
	|ГДЕ
	|	КредитныеДоговоры.Ссылка В(&Договоры)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Остатки.Договор КАК Договор,
	|	Остатки.ТелоОстаток КАК Тело
	|ИЗ
	|	РегистрНакопления.РасчетыПоКредитамИЗаймам.Остатки(&ДатаНачала, Договор В (&Договоры)) КАК Остатки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Движения.Договор КАК Договор,
	|	НАЧАЛОПЕРИОДА(Движения.Период, ДЕНЬ) КАК День,
	|	СУММА(ВЫБОР
	|			КОГДА Движения.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)
	|				ТОГДА Движения.Тело
	|			ИНАЧЕ -Движения.Тело
	|		КОНЕЦ) КАК ОборотТела
	|ИЗ
	|	РегистрНакопления.РасчетыПоКредитамИЗаймам КАК Движения
	|ГДЕ
	|	Движения.Договор В(&Договоры)
	|	И Движения.Период >= &ДатаНачала
	|	И Движения.Период <= &ДатаОкончания
	|	И Движения.Тело <> 0
	|
	|СГРУППИРОВАТЬ ПО
	|	Движения.Договор,
	|	НАЧАЛОПЕРИОДА(Движения.Период, ДЕНЬ)
	|
	|УПОРЯДОЧИТЬ ПО
	|	Договор,
	|	День";
	Пакет = Запрос.ВыполнитьПакет();
	
	РеквизитыДоговоров = Новый Соответствие;
	ВыборкаДоговоров = Пакет[0].Выбрать();
	Пока ВыборкаДоговоров.Следующий() Цикл
		РеквизитыДоговоров.Вставить(ВыборкаДоговоров.Договор,
			Новый Структура("СуммаДоговора, ПериодНачисления",
				ВыборкаДоговоров.СуммаДоговора,
				ВыборкаДоговоров.ПериодНачисления));
	КонецЦикла;
	
	ТелоНаНачало = Новый Соответствие;
	ВыборкаОстатков = Пакет[1].Выбрать();
	Пока ВыборкаОстатков.Следующий() Цикл
		ТелоНаНачало.Вставить(ВыборкаОстатков.Договор, ВыборкаОстатков.Тело);
	КонецЦикла;
	
	ОборотыПоДоговорам = Новый Соответствие;
	ВыборкаОборотов = Пакет[2].Выбрать();
	Пока ВыборкаОборотов.Следующий() Цикл
		ОборотыДоговора = ОборотыПоДоговорам.Получить(ВыборкаОборотов.Договор);
		Если ОборотыДоговора = Неопределено Тогда
			ОборотыДоговора = Новый Соответствие;
			ОборотыПоДоговорам.Вставить(ВыборкаОборотов.Договор, ОборотыДоговора);
		КонецЕсли;
		ОборотыДоговора.Вставить(ВыборкаОборотов.День, ВыборкаОборотов.ОборотТела);
	КонецЦикла;
	
	Для Каждого СтрокаНачисления Из ТаблицаНачислений Цикл
		
		РеквизитыДоговора = РеквизитыДоговоров.Получить(СтрокаНачисления.Договор);
		Если РеквизитыДоговора = Неопределено Тогда
			РеквизитыДоговора = Новый Структура("СуммаДоговора, ПериодНачисления", 0, Перечисления.ПериодНачисления.Месяц);
		КонецЕсли;
		
		Тело = ТелоНаНачало.Получить(СтрокаНачисления.Договор);
		Если Тело = Неопределено Тогда
			Тело = 0;
		КонецЕсли;
		ОборотыДоговора = ОборотыПоДоговорам.Получить(СтрокаНачисления.Договор);
		Если ОборотыДоговора = Неопределено Тогда
			ОборотыДоговора = Новый Соответствие;
		КонецЕсли;
		
		Если Тело = 0 И ОборотыДоговора.Количество() = 0 Тогда
			Тело = РеквизитыДоговора.СуммаДоговора;
		КонецЕсли;
		
		РасчетСтроки = РассчитатьСуммуПоОтрезкамТела(
			Тело,
			ОборотыДоговора,
			СтрокаНачисления.Ставка,
			РеквизитыДоговора.ПериодНачисления,
			ДатаНачалаДня,
			ДатаОкончанияДня);
		
		СтрокаРезультата = Результат.Добавить();
		СтрокаРезультата.НомерСтроки = СтрокаНачисления.НомерСтроки;
		СтрокаРезультата.Сумма = РасчетСтроки.Сумма;
		СтрокаРезультата.ПорядокРасчета = РасчетСтроки.ПорядокРасчета;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// Считает проценты по отрезкам постоянного тела внутри периода.
//
// Параметры:
//  ТелоНаНачало     - Число - тело на начало первого дня периода;
//  ОборотыПоДням    - Соответствие - ключ Дата (начало дня), значение оборот тела за день;
//  Ставка           - Число - процентная ставка;
//  ПериодНачисления - ПеречислениеСсылка.ПериодНачисления - день или месяц;
//  ДатаНачала       - Дата - начало периода (день);
//  ДатаОкончания    - Дата - окончание периода (день).
//
// Возвращаемое значение:
//  Структура - Сумма, ПорядокРасчета.
//
Функция РассчитатьСуммуПоОтрезкамТела(ТелоНаНачало, ОборотыПоДням, Ставка, ПериодНачисления, ДатаНачала, ДатаОкончания)
	
	Границы = Новый ТаблицаЗначений;
	Границы.Колонки.Добавить("Дата", Новый ОписаниеТипов("Дата", , , Новый КвалификаторыДаты(ЧастиДаты.Дата)));
	ДобавитьГраницуОтрезка(Границы, ДатаНачала);
	
	Для Каждого ОборотДня Из ОборотыПоДням Цикл
		ДеньПослеИзменения = НачалоДня(ОборотДня.Ключ) + 86400;
		Если ДеньПослеИзменения >= ДатаНачала И ДеньПослеИзменения <= ДатаОкончания Тогда
			ДобавитьГраницуОтрезка(Границы, ДеньПослеИзменения);
		КонецЕсли;
	КонецЦикла;
	
	МесяцГраницы = НачалоМесяца(ДобавитьМесяц(ДатаНачала, 1));
	Пока МесяцГраницы <= ДатаОкончания Цикл
		ДобавитьГраницуОтрезка(Границы, МесяцГраницы);
		МесяцГраницы = ДобавитьМесяц(МесяцГраницы, 1);
	КонецЦикла;
	ДобавитьГраницуОтрезка(Границы, ДатаОкончания + 86400);
	Границы.Сортировать("Дата");
	
	Сумма = 0;
	ЧастиПорядка = Новый Массив;
	
	Для Индекс = 0 По Границы.Количество() - 2 Цикл
		
		ДатаОтрезка = Границы[Индекс].Дата;
		ДатаСледующей = Границы[Индекс + 1].Дата;
		
		Тело = ТелоНаНачало;
		Для Каждого ОборотДня Из ОборотыПоДням Цикл
			Если ОборотДня.Ключ < ДатаОтрезка Тогда
				Тело = Тело + ОборотДня.Значение;
			КонецЕсли;
		КонецЦикла;
		
		ДнейОтрезка = (ДатаСледующей - ДатаОтрезка) / 86400;
		Если ДнейОтрезка <= 0 Или Тело = 0 Или Ставка = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		Если ПериодНачисления = Перечисления.ПериодНачисления.День Тогда
			Делитель = День(КонецГода(ДатаОтрезка));
		Иначе
			Делитель = День(КонецМесяца(ДатаОтрезка));
		КонецЕсли;
		Если Делитель = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		СуммаОтрезка = Окр(Тело * Ставка / 100 * ДнейОтрезка / Делитель, 2);
		Сумма = Сумма + СуммаОтрезка;
		ЧастиПорядка.Добавить(ТекстПорядкаРасчета(Тело, ДнейОтрезка, Ставка, СуммаОтрезка));
		
	КонецЦикла;
	
	Возврат Новый Структура("Сумма, ПорядокРасчета", Сумма, СтрСоединить(ЧастиПорядка, "; "));
	
КонецФункции

// Добавляет дату в таблицу границ отрезка, если её ещё нет.
//
// Параметры:
//  Границы      - ТаблицаЗначений - колонка Дата;
//  ДатаГраницы  - Дата - граница отрезка.
//
Процедура ДобавитьГраницуОтрезка(Границы, ДатаГраницы)
	
	Если Границы.Найти(ДатаГраницы, "Дата") = Неопределено Тогда
		СтрокаГраницы = Границы.Добавить();
		СтрокаГраницы.Дата = ДатаГраницы;
	КонецЕсли;
	
КонецПроцедуры

// Формирует строку порядка расчёта процентов по шаблону
// «ТелоИнвестиции * Количество дней * ПроцентнаяСтавка = СуммаНачислений».
//
// Параметры:
//  ТелоИнвестиции   - Число - база начисления (тело инвестиции);
//  КоличествоДней   - Число - число дней отрезка;
//  ПроцентнаяСтавка - Число - ставка, %;
//  СуммаНачислений  - Число - рассчитанная сумма процентов.
//
// Возвращаемое значение:
//  Строка - текст для колонки печатной формы.
//
Функция ТекстПорядкаРасчета(ТелоИнвестиции, КоличествоДней, ПроцентнаяСтавка, СуммаНачислений)
	
	Возврат СтрШаблон("%1 * %2 * %3 = %4",
		Формат(ТелоИнвестиции, "ЧДЦ=2; ЧН=0; ЧГ="),
		Формат(КоличествоДней, "ЧДЦ=0; ЧН=0; ЧГ="),
		Формат(ПроцентнаяСтавка, "ЧДЦ=1; ЧН=0; ЧГ="),
		Формат(СуммаНачислений, "ЧДЦ=2; ЧН=0; ЧГ="));
	
КонецФункции
