#Область ДействияФормы   

&НаКлиенте
Процедура ПриОткрытии(Отказ)

	клФормаДокументаПриОткрытии(ЭтаФорма, Объект);

	клНастроитьИзменениеПримечанияВЗакрытомПериоде(ЭтаФорма);
	
	РассчитатьДней();

КонецПроцедуры

&НаКлиенте
Процедура ПослеЗаписи(ПараметрыЗаписи)

	ОбщегоНазначения.ОтобразитьСостояниеДокумента(Объект, СостояниеДокумента, КартинкаСостоянияДокумента); 

КонецПроцедуры

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	СтруктураПечатныхФорм = Документы.НачислениеПроцентовПоКредитам.ПолучитьСтруктуруПечатныхФорм();
	ПараметрыРазмещения = Новый Структура("Форма, ЭтоФормаОбъекта, КоманднаяПанель", ЭтаФорма, Истина, Неопределено);
	ОбщегоНазначенияСервер.ПодключитьКомандыПечати(ПараметрыРазмещения, СтруктураПечатныхФорм);

КонецПроцедуры

&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)
	
	клФормаДокументаПередЗаписью(Объект, Отказ);

КонецПроцедуры
 
#КонецОбласти     


#Область СобытияШапки

&НаКлиенте
Процедура ДатаНачалаПриИзменении(Элемент)
	РассчитатьДней();
КонецПроцедуры

&НаКлиенте
Процедура ДатаОкончанияПриИзменении(Элемент)
	РассчитатьДней();
КонецПроцедуры 

&НаКлиенте
Процедура РассчитатьДней()
	
	Если Объект.ДатаНачала = Дата(1,1,1) ИЛИ Объект.ДатаОкончания = Дата(1,1,1) Тогда
		Дней = 0;	
	Иначе
		Дней = ОбщегоНазначенияСервер.КоличествоДнейВПериоде(Объект.ДатаНачала, Объект.ДатаОкончания);	
	КонецЕсли;

КонецПроцедуры

#КонецОбласти  

#Область СобытияТЧ
	
&НаКлиенте
Процедура НачисленияДоговорПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.Начисления.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ТекущиеДанные.Договор) Тогда
		ТекущиеДанные.Контрагент = гоРеквизит(ТекущиеДанные.Договор, "Владелец");
		ТекущиеДанные.Ставка = гоРеквизит(ТекущиеДанные.Договор, "ПроцентнаяСтавка");
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти


#Область Команды	

&НаКлиенте
Процедура Заполнить(Команда)
	
	Если Не ПериодДокументаКорректен() Тогда
		Возврат;
	КонецЕсли;
	
	Если Объект.Начисления.Количество() = 0 Тогда
		ЗаполнитьНаСервере();
	Иначе
		ПоказатьВопрос(Новый ОписаниеОповещения("ЗаполнитьПослеВопроса", ЭтотОбъект),
			НСтр("ru = 'При заполнении табличная часть будет очищена. Продолжить?'; en = 'The table will be cleared and refilled. Continue?'"),
			РежимДиалогаВопрос.ДаНет);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьПослеВопроса(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = КодВозвратаДиалога.Да Тогда
		ЗаполнитьНаСервере();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура Рассчитать(Команда)
	
	Если Не ПериодДокументаКорректен() Тогда
		Возврат;
	КонецЕсли;
	
	Если Объект.Начисления.Количество() = 0 Тогда
		клПредупреждение(НСтр("ru = 'Табличная часть пуста. Сначала выполните заполнение.'; en = 'The table is empty. Fill it first.'"));
		Возврат;
	КонецЕсли;
	
	РассчитатьНаСервере();
	
КонецПроцедуры

// Проверяет заполнение и корректность периода начисления в шапке документа.
//
// Возвращаемое значение:
//  Булево - Истина, если даты заполнены и дата начала не позже даты окончания.
//
&НаКлиенте
Функция ПериодДокументаКорректен()
	
	Если Не ЗначениеЗаполнено(Объект.ДатаНачала) Тогда
		клПредупреждение(НСтр("ru = 'Не заполнена дата начала периода.'; en = 'Period start date is not filled in.'"));
		Возврат Ложь;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Объект.ДатаОкончания) Тогда
		клПредупреждение(НСтр("ru = 'Не заполнена дата окончания периода.'; en = 'Period end date is not filled in.'"));
		Возврат Ложь;
	КонецЕсли;
	
	Если Объект.ДатаНачала > Объект.ДатаОкончания Тогда
		клПредупреждение(НСтр("ru = 'Дата начала не может быть больше даты окончания.'; en = 'Start date cannot be later than end date.'"));
		Возврат Ложь;
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции

// Заполняет табличную часть действующими кредитными договорами, пересекающимися с периодом документа.
//
&НаСервере
Процедура ЗаполнитьНаСервере()
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	КредитныеДоговоры.Владелец КАК Контрагент,
	|	КредитныеДоговоры.Ссылка КАК Договор,
	|	КредитныеДоговоры.ПроцентнаяСтавка КАК Ставка,
	|	0 КАК Сумма
	|ИЗ
	|	Справочник.КредитныеДоговоры КАК КредитныеДоговоры
	|ГДЕ
	|	НЕ КредитныеДоговоры.ПометкаУдаления
	|	И (КредитныеДоговоры.ДатаНачала = ДАТАВРЕМЯ(1, 1, 1)
	|			ИЛИ КредитныеДоговоры.ДатаНачала <= &ДатаОкончания)
	|	И (КредитныеДоговоры.ДатаОкончания = ДАТАВРЕМЯ(1, 1, 1)
	|			ИЛИ КредитныеДоговоры.ДатаОкончания >= &ДатаНачала)
	|
	|УПОРЯДОЧИТЬ ПО
	|	Контрагент,
	|	Договор
	|АВТОУПОРЯДОЧИВАНИЕ";
	Запрос.УстановитьПараметр("ДатаНачала", Объект.ДатаНачала);
	Запрос.УстановитьПараметр("ДатаОкончания", Объект.ДатаОкончания);
	
	Объект.Начисления.Загрузить(Запрос.Выполнить().Выгрузить());
	Модифицированность = Истина;
	
КонецПроцедуры

// Рассчитывает суммы процентов по строкам табличной части за период документа.
// База — остаток тела инвестиции в регистре на каждый день (см. РассчитатьНачисления).
//
&НаСервере
Процедура РассчитатьНаСервере()
	
	ТаблицаНачислений = Объект.Начисления.Выгрузить(, "НомерСтроки, Договор, Ставка");
	РезультатРасчета = Документы.НачислениеПроцентовПоКредитам.РассчитатьНачисления(
		ТаблицаНачислений,
		Объект.ДатаНачала,
		Объект.ДатаОкончания);
	
	Для Каждого СтрокаРасчета Из РезультатРасчета Цикл
		Объект.Начисления[СтрокаРасчета.НомерСтроки - 1].Сумма = СтрокаРасчета.Сумма;
	КонецЦикла;
	
	Модифицированность = Истина;
	
КонецПроцедуры

&НаКлиенте
Процедура ИзменитьПримечание(Команда)
	
	клИзменитьПримечаниеДокумента(ЭтаФорма);
	
КонецПроцедуры

#КонецОбласти

#Область ПодключаемаяПечать
	
&НаКлиенте
Процедура ВыполнитьПодключеннуюПечать(Команда)
	
	Если НЕ ЗначениеЗаполнено(Объект.Ссылка) Тогда
		клПредупреждение(НСтр("ru = 'Документ не записан. Запишите документ перед печатью.'; en = 'The document is not saved. Save it before printing.'"));
		Возврат;
	КонецЕсли;
	
	ВариантПечатнойФормы = СтрЗаменить(Команда.Имя, "ПодключеннаяПечать_", "");
	ТабДок = ПечатнаяФорма(ВариантПечатнойФормы);
	ПараметрыПечати = Новый Структура("Таб, Имя, НеДляПечати", ТабДок, гоИмя(Объект.Ссылка, Ложь), Ложь);
	ОткрытьФорму("ОбщаяФорма.ПечатьБезЗащиты", ПараметрыПечати, , Истина);
		
КонецПроцедуры  

&НаСервере
Функция ПечатнаяФорма(ВариантПечатнойФормы)

	ТабДок = Новый ТабличныйДокумент;
	Документы.НачислениеПроцентовПоКредитам.ПечатьДокумента(Объект.Ссылка, ВариантПечатнойФормы, ТабДок);
	Возврат ТабДок;
	
КонецФункции 

#КонецОбласти
