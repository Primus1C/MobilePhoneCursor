Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)   
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;  
	
	//Если глЗапретЗаписиПоДате(Ссылка) Тогда Отказ = Истина; Возврат; КонецЕсли;
	
	омСервер.ЗаписатьОбщиеРеквизиты(ЭтотОбъект);
	
	// © Primus1C  17.09.2024  НАЧАЛО ►  
	
	// ПересчитыватьЦены - флаг режима разработчика, нетипичное поведение накладной	
	ПересчитыватьЦены = НЕ (ДополнительныеСвойства.Свойство("БезПересчетаЦен") И ДополнительныеСвойства.БезПересчетаЦен);
	
	// 0. Перезаполним цены из инвойса (для разных цен одной позиции цены заполняются по возрастанию)
	
	Если ЗначениеЗаполнено(ВКД_Инвойс) Тогда
		Если ПересчитыватьЦены Тогда
			ЗаполнитьЦеныЗакупкиПоСрезамИнвойса();
		КонецЕсли;
	КонецЕсли;	
	
	// 1. Распределим в ТЧ затраты "док-тов доп.затрат"
	
	//ТаблицаТовары = Товары.Выгрузить();  
	
	Если ПересчитыватьЦены Тогда
	
		Запрос = Новый Запрос;
		Запрос.УстановитьПараметр("Приходная", Ссылка);	
		Запрос.УстановитьПараметр("ДопЗатраты", Затраты.Выгрузить(,"ДокументЗатрат").ВыгрузитьКолонку(0));	
		Запрос.Текст = "ВЫБРАТЬ 
		               |	ЕСТЬNULL(СУММА(ВКД_ДополнительныеЗатратыДокументы.СуммаНаценки), 0) КАК СуммаНаценки,
		               |	ВКД_ДополнительныеЗатратыДокументы.Ссылка.Валюта КАК ВалютаЗатрат
		               |ИЗ
		               |	Документ.ВКД_ДополнительныеЗатраты.Документы КАК ВКД_ДополнительныеЗатратыДокументы
		               |ГДЕ
		               |	ВКД_ДополнительныеЗатратыДокументы.Ссылка В(&ДопЗатраты)
		               |	И ВКД_ДополнительныеЗатратыДокументы.Документ = &Приходная
		               |
		               |СГРУППИРОВАТЬ ПО
		               |	ВКД_ДополнительныеЗатратыДокументы.Ссылка.Валюта";
	    Выборка = Запрос.Выполнить().Выбрать();
		// было: Выборка.Следующий(); ОбщаяСуммаКРаспределению = омСервер.ПересчетЗн(Выборка.СуммаНаценки, Валюта, ПараметрыСеанса.БазоваяВалюта, Фирма, Дата, 5);
		// перевод шёл в доллар, а ЦенаЗакупки — в валюте ПН, поэтому при Валюта ≠ доллар дельта и цена были в разных валютах.
		// стало: каждый документ доп.затрат переводим из его валюты в валюту ПН (Пересчитать2025), затем распределяем на строки.
		ОбщаяСуммаКРаспределению = 0;
		Пока Выборка.Следующий() Цикл
			ОбщаяСуммаКРаспределению = ОбщаяСуммаКРаспределению
				+ РаботаСВалютой.Пересчитать2025(Выборка.СуммаНаценки, Выборка.ВалютаЗатрат, Валюта, Фирма, Дата, 5);
		КонецЦикла;
		//Для каждого Стр из ТаблицаТовары Цикл	  
		Для каждого Стр из Товары Цикл	  
			Если ОбщаяСуммаКРаспределению = 0 Тогда 
				ДельтаЦены = 0;
			Иначе
				Если ВариантРаспределения = 1 Тогда
					лВесоваяЧасть = Стр.СуммаЗакупки / Сумма * 100  ;
					лСуммаКРаспределению = ОбщаяСуммаКРаспределению * лВесоваяЧасть / 100;
					ДельтаЦены = лСуммаКРаспределению / Стр.Количество;
				ИначеЕсли ВариантРаспределения = 2 Тогда
					ДельтаЦены = ОбщаяСуммаКРаспределению / ВКД_Количество;
				Иначе
					ДельтаЦены = 0;
				КонецЕсли;         
			КонецЕсли; 		
			Стр.ВКД_ЦенаСЗатратами = Стр.ЦенаЗакупки + ДельтаЦены;
			Стр.ВКД_СуммаСЗатратами = Стр.ВКД_ЦенаСЗатратами * Стр.Количество;
		КонецЦикла;
	
	КонецЕсли;
	
	// 2. Подготовим затраты док-тов "Отправка" и логистики инвойса
	
	ЗатратыОтправки = Документы.ПриходнаяНакладная.ЗатратыОтправки(ВКД_Инвойс, Поставка);
	ЗатратыЛогистики = Документы.ПриходнаяНакладная.ЗатратыЛогистикиИнвойса(ВКД_Инвойс, Поставка);
	
	СуммаСЗатратамиДоПересчета = 0;
	Если НЕ ЭтоНовый() Тогда
		СуммаСЗатратамиДоПересчета = Ссылка.ВКД_СуммаСЗатратами;
	КонецЕсли;
	
	// © Primus1C  ОКОНЧАНИЕ ◄
	
	// 3. Создание/обновление партий
	
	ИзмененныеПартии = Новый Массив;
	НеактуальныеПартии = ПолучитьПартии(Ссылка);
	
	Для Каждого Стр Из Товары Цикл 
		
		ТекПар = Стр.Партия;
		Если НЕ ЗначениеЗаполнено(ТекПар) Тогда Продолжить КонецЕсли; 
		
		СтаПар = ТекПар.ПолучитьОбъект();
		ЕстИзм = 0;
		
		Если СтаПар.ПометкаУдаления Тогда СтаПар.УстановитьПометкуУдаления(Ложь); КонецЕсли;
		
		Имя = "ПН_" + Лев(гоМгновение(Дата), 8);
		
		ОбновитьРеквизитПартии(СтаПар.Наименование,	 	Имя, 					ЕстИзм);
		ОбновитьРеквизитПартии(СтаПар.Контрагент, 		Контрагент, 			ЕстИзм);
		ОбновитьРеквизитПартии(СтаПар.Док, 				Ссылка, 				ЕстИзм);
		ОбновитьРеквизитПартии(СтаПар.ДатаПартии, 		НачалоДня(Дата), 		ЕстИзм);
		ОбновитьРеквизитПартии(СтаПар.Валюта, 			Валюта, 				ЕстИзм);
		ОбновитьРеквизитПартии(СтаПар.Фирма, 			Фирма, 					ЕстИзм);
		ОбновитьРеквизитПартии(СтаПар.Консигнация, 		Консигнация, 			ЕстИзм);
		ОбновитьРеквизитПартии(СтаПар.ЦенаЗакупки,  	Стр.ЦенаЗакупки, 		ЕстИзм);
		ОбновитьРеквизитПартии(СтаПар.ВКД_ЦенаСоСкидкой,Стр.ВКД_ЦенаСоСкидкой, 	ЕстИзм);
		
		Если ЕстИзм > 0 Тогда 
			СтаПар.Записать();
			ИзмененныеПартии.Добавить(Стр.Партия); 
		КонецЕсли;
		
		Если НеактуальныеПартии.Количество() > 0 Тогда
			ПаблСтр = НеактуальныеПартии.Найти(ТекПар, "Ссылка");
			Если НЕ (ПаблСтр = Неопределено) Тогда НеактуальныеПартии.Удалить(ПаблСтр) КонецЕсли;
		КонецЕсли;  
		
		// © Primus1C  17.09.2024  НАЧАЛО ► 
		Если ПересчитыватьЦены Тогда
		ПересчитатьСтроку(Стр, ЗатратыОтправки, ЗатратыЛогистики);  
		КонецЕсли;
		// © Primus1C  ОКОНЧАНИЕ ◄    
		
	КонецЦикла; 
	
	Для Каждого ПаблСтр Из НеактуальныеПартии Цикл
		Тек = ПаблСтр.Ссылка.ПолучитьОбъект();
		Тек.УстановитьПометкуУдаления(Истина);
	КонецЦикла;  

	// 4. Итоги - реквизиты шапки 
	
	//ПересчитатьИтоги();
	Сумма = Товары.Итог("СуммаЗакупки");
	Строк = Товары.Количество();
	СуммаПривязано = Привязки.Итог("Сумма1");
	//ВКД++
	ВКД_СуммаСоСкидкой = Товары.Итог("ВКД_СуммаСоСкидкой");
	ВКД_СуммаСЗатратами = Товары.Итог("ВКД_СуммаСЗатратами");
	ВКД_Количество = Товары.Итог("Количество");
	//ВКД--
	ЕстьЗатраты = Товары.Итог("ЦенаЗакупки") <> Товары.Итог("ВКД_ЦенаСЗатратами");
	
	ПартииДляПересчетаРасходных = Новый Массив;
	Для Каждого ПартияИзмененная Из ИзмененныеПартии Цикл
		ПартииДляПересчетаРасходных.Добавить(ПартияИзмененная);
	КонецЦикла;
	Если НЕ ЭтоНовый() И ВКД_СуммаСЗатратами <> СуммаСЗатратамиДоПересчета Тогда
		Для Каждого Стр Из Товары Цикл
			Если ЗначениеЗаполнено(Стр.Партия) И ПартииДляПересчетаРасходных.Найти(Стр.Партия) = Неопределено Тогда
				ПартииДляПересчетаРасходных.Добавить(Стр.Партия);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	ДополнительныеСвойства.Вставить("ИзмененныеПартии", ИзмененныеПартии);  // для пересчета расх/возвр.накладных
	ДополнительныеСвойства.Вставить("ПартииДляПересчетаРасходных", ПартииДляПересчетаРасходных);
	
	//2015.11.27
	//изначально суммы КР у нас нет
	СуммаКР = 0;
	
	//2016.01.30
	//есть флаг, когда долги не возникают, поэтому привязки не трогаем
	Если НЕ ТоварУжеОплачен Тогда  
		//а тут нужно подумать, есть 2 варианта, когда закрывается предоплата или когда приход выступает оплатой покупателя
		Для Каждого Стр Из Привязки Цикл
			//итак, мы закрываем для начала предоплату поставщика
			//когда то мы заплатили 100 долларов, сейчас приходуем в ГРН и указываем свой курс в окне привязок
			//все как в ДД для поставщиков
			//второй вариант - мы закрываем долг покупателя, тоже по своему курсу, например, там 100 доларов, а тут рубли - тоже потеря
			правильнаяСумма = омСервер.ПересчетЗн(Стр.Сумма2, Стр.Валюта2, Валюта, Фирма, Дата, 2);
			//ТУТ ПОМЕНЯЛИ МЕСТАМИ, а то неправильно получается при закрытии рублевой предоплаты по курсу 65
			Если правильнаяСумма <> Стр.Сумма1 Тогда гоПлюс(СуммаКР, Стр.Сумма1 - правильнаяСумма) КонецЕсли; 
		КонецЦикла; 
	КонецЕсли;  
	
КонецПроцедуры

// Заполняет ЦенаЗакупки / суммы в ТЧ Товары по ценовым срезам инвойса (FIFO).
// Строка с количеством, затрагивающим несколько цен, разбивается на несколько строк.
// Непокрытый остаток количества (сверх регистра) остаётся отдельной строкой с нулевой ценой.
// Запрос: остаток по Документ+Поставка без движений текущей накладной (перезапись не «теряет» свой срез).
//
Процедура ЗаполнитьЦеныЗакупкиПоСрезамИнвойса()
	
	Если Не ЗначениеЗаполнено(ВКД_Инвойс) Тогда
		Возврат;
	КонецЕсли;
	
	Запр = Новый Запрос;
	Запр.УстановитьПараметр("Регистратор", ВКД_Инвойс);
	Запр.УстановитьПараметр("Поставка", Поставка);
	Запр.УстановитьПараметр("Ссылка", Ссылка);
	Запр.Текст = "ВЫБРАТЬ
	             |	ОприходНоменклатуры.Номенклатура КАК Номенклатура,
	             |	ОприходНоменклатуры.Цена КАК Цена,
	             |	СУММА(ВЫБОР
	             |			КОГДА ОприходНоменклатуры.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)
	             |				ТОГДА ОприходНоменклатуры.Количество
	             |			ИНАЧЕ -ОприходНоменклатуры.Количество
	             |		КОНЕЦ) КАК Количество,
	             |	СУММА(ВЫБОР
	             |			КОГДА ОприходНоменклатуры.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)
	             |				ТОГДА ОприходНоменклатуры.СуммаСоСкидкой
	             |			ИНАЧЕ -ОприходНоменклатуры.СуммаСоСкидкой
	             |		КОНЕЦ) КАК СуммаСоСкидкой
	             |ИЗ
	             |	РегистрНакопления.ВКД_ОприходованиеНоменклатуры КАК ОприходНоменклатуры
	             |ГДЕ
	             |	ОприходНоменклатуры.Документ = &Регистратор
	             |	И ОприходНоменклатуры.Поставка = &Поставка
	             |	И ОприходНоменклатуры.Регистратор <> &Ссылка
	             |
	             |СГРУППИРОВАТЬ ПО
	             |	ОприходНоменклатуры.Номенклатура,
	             |	ОприходНоменклатуры.Цена
	             |
	             |ИМЕЮЩИЕ
	             |	СУММА(ВЫБОР
	             |			КОГДА ОприходНоменклатуры.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)
	             |				ТОГДА ОприходНоменклатуры.Количество
	             |			ИНАЧЕ -ОприходНоменклатуры.Количество
	             |		КОНЕЦ) > 0
	             |
	             |УПОРЯДОЧИТЬ ПО
	             |	Номенклатура,
	             |	Цена";
	
	Срезы = Запр.Выполнить().Выгрузить();
	Срезы.Колонки.Добавить("ЦенаСоСкидкой", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(19, 4)));
	Для Каждого Срез Из Срезы Цикл
		Если Срез.Количество = 0 Тогда
			Срез.ЦенаСоСкидкой = 0;
		Иначе
			Срез.ЦенаСоСкидкой = Срез.СуммаСоСкидкой / Срез.Количество;
		КонецЕсли;
	КонецЦикла;
	Срезы.Индексы.Добавить("Номенклатура");
	
	Индекс = 0;
	Пока Индекс < Товары.Количество() Цикл
		
		СтрокаТЧ = Товары[Индекс];
		Если Не ЗначениеЗаполнено(СтрокаТЧ.Номенклатура) Или СтрокаТЧ.Количество <= 0 Тогда
			Индекс = Индекс + 1;
			Продолжить;
		КонецЕсли;
		
		Куски = Новый Массив;
		ОсталосьВСтроке = СтрокаТЧ.Количество;
		СтрокиСрезов = Срезы.НайтиСтроки(Новый Структура("Номенклатура", СтрокаТЧ.Номенклатура));
		
		Для Каждого Срез Из СтрокиСрезов Цикл
			Если ОсталосьВСтроке <= 0 Тогда
				Прервать;
			КонецЕсли;
			Если Срез.Количество <= 0 Тогда
				Продолжить;
			КонецЕсли;
			
			Взять = Мин(ОсталосьВСтроке, Срез.Количество);
			Куски.Добавить(Новый Структура("Цена, Количество, ЦенаСоСкидкой",
				Срез.Цена, Взять, Срез.ЦенаСоСкидкой));
			
			ДоляСуммыСоСкидкой = ?(Срез.Количество = 0, 0, Взять / Срез.Количество * Срез.СуммаСоСкидкой);
			Срез.Количество = Срез.Количество - Взять;
			Срез.СуммаСоСкидкой = Срез.СуммаСоСкидкой - ДоляСуммыСоСкидкой;
			ОсталосьВСтроке = ОсталосьВСтроке - Взять;
		КонецЦикла;
		
		Если ОсталосьВСтроке > 0 Тогда
			Куски.Добавить(Новый Структура("Цена, Количество, ЦенаСоСкидкой", 0, ОсталосьВСтроке, 0));
		КонецЕсли;
	
		ЗаполнитьСтрокуТоваровПоСрезуЦены(СтрокаТЧ, Куски[0]);
		
		Для НомерКуска = 1 По Куски.ВГраница() Цикл
			НоваяСтрока = Товары.Вставить(Индекс + НомерКуска);
			НоваяСтрока.Номенклатура = СтрокаТЧ.Номенклатура;
			НоваяСтрока.Серия = СтрокаТЧ.Серия;
			ЗаполнитьСтрокуТоваровПоСрезуЦены(НоваяСтрока, Куски[НомерКуска]);
		КонецЦикла;
		
		Индекс = Индекс + Куски.Количество();
		
	КонецЦикла;
	
КонецПроцедуры

// Заполняет ценовые поля строки ТЧ Товары по одному ценовому срезу.
//
// Параметры:
//  СтрокаТЧ - СтрокаТабличнойЧасти - строка Товары;
//  Кусок    - Структура - поля Цена, Количество, ЦенаСоСкидкой.
//
Процедура ЗаполнитьСтрокуТоваровПоСрезуЦены(СтрокаТЧ, Кусок)
	
	СтрокаТЧ.Количество = Кусок.Количество;
	СтрокаТЧ.ЦенаЗакупки = Кусок.Цена;
	СтрокаТЧ.СуммаЗакупки = Кусок.Цена * Кусок.Количество;
	СтрокаТЧ.ВКД_ЦенаСоСкидкой = Кусок.ЦенаСоСкидкой;
	СтрокаТЧ.ВКД_СуммаСоСкидкой = Кусок.ЦенаСоСкидкой * Кусок.Количество;
	
КонецПроцедуры

