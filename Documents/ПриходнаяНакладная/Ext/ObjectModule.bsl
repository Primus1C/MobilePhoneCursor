				             |	СУММА(ТЧ.СуммаЗакупки) КАК СуммаЗакупки,
				             |	СУММА(ТЧ.ВКД_СуммаСоСкидкой) КАК СуммаСоСкидкой
				             |ИЗ
				             |	Документ.ПриходнаяНакладная.Товары КАК ТЧ
				             |ГДЕ
				             |	ТЧ.Ссылка = &Ссылка
				             |
				             |СГРУППИРОВАТЬ ПО
				             |	ТЧ.Номенклатура,
				             |	ТЧ.ЦенаЗакупки";
				Запр.УстановитьПараметр("Ссылка", Ссылка);
			    ТаблицаТоваров = Запр.Выполнить().Выгрузить();
				
			КонецЕсли;
				
			Для Каждого Стр Из ТаблицаТоваров Цикл
				
				Если Стр.Количество <= 0 Тогда
					Продолжить;
				КонецЕсли;
				
				Движение = Движения.ВКД_ОприходованиеНоменклатуры.Добавить();
				Движение.ВидДвижения 	= ВидДвиженияНакопления.Расход;
				Движение.Период 		= Дата;
				Движение.Документ 		= ВКД_Инвойс;
				Движение.Номенклатура 	= Стр.Номенклатура;
				Движение.Поставка		= Поставка;
				Движение.Цена			= Стр.Цена;
				Движение.Количество 	= Стр.Количество;
				Движение.СуммаЗакупки 	= Стр.СуммаЗакупки;
				Движение.СуммаСоСкидкой = Стр.СуммаСоСкидкой;
				//Движение.ЦенаЗакупки	= ?(Стр.Количество = 0, Стр.Цена, Стр.СуммаЗакупки / Стр.Количество);
				
			КонецЦикла;
			
		КонецЕсли;
		
		// РС СостоянияИнвойсов 
		Если ВКД_Инвойс.Проведен Тогда
			РаботаСИнвойсами.ЗаписатьСтатусыИнвойса(ВКД_Инвойс, СтатусПоПоступлениям(ВКД_Инвойс, Окончательно), , , , , , , Ссылка);
		КонецЕсли;
		
	КонецЕсли; 
	
КонецПроцедуры

