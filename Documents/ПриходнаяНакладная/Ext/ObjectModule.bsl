		//             |	ПриходнаяНакладнаяТовары.Серия КАК Серия,
		//             |	ОстаткиТовараОстатки.ОстатокОстаток КАК Остаток,
		//             |	ПриходнаяНакладнаяТовары.НомерСтроки КАК НомерСтроки
		//             |ИЗ
		//             |	Документ.ПриходнаяНакладная.Товары КАК ПриходнаяНакладнаяТовары
		//             |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрНакопления.ОстаткиТовара.Остатки(
		//             |				&Дата,
		//             |				Фирма = &Фирма
		//             |					И Склад = &Склад) КАК ОстаткиТовараОстатки
		//             |		ПО ПриходнаяНакладнаяТовары.Номенклатура = ОстаткиТовараОстатки.Номенклатура
		//             |			И ПриходнаяНакладнаяТовары.Серия = ОстаткиТовараОстатки.Партия.Серия
		//             |ГДЕ
		//             |	ПриходнаяНакладнаяТовары.Ссылка = &Ссылка
		//             |	И ПриходнаяНакладнаяТовары.Номенклатура.ТипНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.Товар)
		//             |	И ПриходнаяНакладнаяТовары.Номенклатура.УчетПоСериям
		//             |	И ОстаткиТовараОстатки.ОстатокОстаток > 0
		//             |
		//             |УПОРЯДОЧИТЬ ПО
		//             |	НомерСтроки";
		Запр.Текст = "ВЫБРАТЬ
		             |	Товары.Номенклатура КАК Номенклатура,
		             |	Товары.Серия КАК Серия,
		             |	Товары.НомерСтроки КАК НомерСтроки,
		             |	Партии.Ссылка КАК Партия
		             |ПОМЕСТИТЬ ВТСтроки
		             |ИЗ
		             |	Документ.ПриходнаяНакладная.Товары КАК Товары
		             |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Партии КАК Партии
		             |		ПО (Партии.Владелец = Товары.Номенклатура)
		             |			И (Партии.Серия = Товары.Серия)
		             |ГДЕ
		             |	Товары.Ссылка = &Ссылка
		             |	И Товары.Номенклатура.ТипНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.Товар)
		             |	И Товары.Номенклатура.УчетПоСериям
		             |;
		             |
		             |////////////////////////////////////////////////////////////////////////////////
		             |ВЫБРАТЬ
		             |	ВТСтроки.Номенклатура КАК Номенклатура,
		             |	ВТСтроки.Серия КАК Серия,
		             |	ОстаткиТовараОстатки.ОстатокОстаток КАК Остаток,
		             |	ВТСтроки.НомерСтроки КАК НомерСтроки
		             |ИЗ
		             |	ВТСтроки КАК ВТСтроки
		             |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрНакопления.ОстаткиТовара.Остатки(
		             |				&Дата,
		             |				Фирма = &Фирма
		             |					И Склад = &Склад
		             |					И Номенклатура В
		             |						(ВЫБРАТЬ
		             |							ВТ.Номенклатура
		             |						ИЗ
		             |							ВТСтроки КАК ВТ)
		             |					И Партия В
		             |						(ВЫБРАТЬ
		             |							ВТ.Партия
		             |						ИЗ
		             |							ВТСтроки КАК ВТ)) КАК ОстаткиТовараОстатки
		             |		ПО ВТСтроки.Номенклатура = ОстаткиТовараОстатки.Номенклатура
		             |			И ВТСтроки.Партия = ОстаткиТовараОстатки.Партия
		             |ГДЕ
		             |	ОстаткиТовараОстатки.ОстатокОстаток > 0
		             |
		             |УПОРЯДОЧИТЬ ПО
		             |	НомерСтроки";
		Выборка = Запр.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл   
			Сообщить(СтрШаблон(НСтр("ru = 'Строка %1: серия %2 товара %3 найден остаток %4 шт.'; en = 'Line %1: series %2 of product %3 remaining %4 pcs found!'"), 
									Выборка.НомерСтроки, Выборка.Серия, Выборка.Номенклатура, Формат(Выборка.Остаток, "ЧДЦ=0")));
			Отказ = Истина;
		КонецЦикла; 
	КонецЕсли;

КонецПроцедуры

// Проверяет достаточность остатка инвойса по поставке накладной и готовит таблицу
// списания по ценовым срезам регистра ВКД_ОприходованиеНоменклатуры (FIFO по Цена).
//
// Параметры:
//  ТаблицаТоваров - ТаблицаЗначений - исходящая: Номенклатура, Цена, Количество, СуммаЗакупки, СуммаСоСкидкой;
//  Отказ         - Булево - признак отказа в проведении.
//
Процедура ПроверкаВозможностиПроведения(ТаблицаТоваров, Отказ)
	
	//
	// © Primus1C  08.09.2026  НАЧАЛО ►      
	Если НЕ Контрагент.РазрешитьДублиСерий Тогда
	
		Запр = Новый Запрос;
		Запр.Текст = "ВЫБРАТЬ
		             |	ПриходнаяНакладнаяТовары.НомерСтроки КАК НомерСтроки,
		             |	ПриходнаяНакладнаяТовары.Номенклатура КАК Номенклатура,
		             |	ПриходнаяНакладнаяТовары.Серия КАК Серия,
		             |	ПриходнаяНакладнаяТовары.Партия КАК Партия
		             |ПОМЕСТИТЬ ТЧ
		             |ИЗ
		             |	Документ.ПриходнаяНакладная.Товары КАК ПриходнаяНакладнаяТовары
		             |ГДЕ
		             |	ПриходнаяНакладнаяТовары.Ссылка = &Ссылка
		             |	И ПриходнаяНакладнаяТовары.Серия <> """"
		             |;
		             |
		             |////////////////////////////////////////////////////////////////////////////////
		             |ВЫБРАТЬ
		             |	ОстаткиТовараОстатки.ОстатокОстаток КАК Остаток,
		             |	ТЧ.НомерСтроки КАК НомерСтроки,
		             |	ТЧ.Номенклатура КАК Номенклатура,
		             |	ТЧ.Серия КАК Серия,
		             |	ТЧ.Партия КАК Партия
		             |ИЗ
		             |	ТЧ КАК ТЧ
		             |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ОстаткиТовара.Остатки(&ДатаОстатков, ) КАК ОстаткиТовараОстатки
		             |		ПО ТЧ.Серия = ОстаткиТовараОстатки.Партия.Серия
		             |			И ТЧ.Номенклатура = ОстаткиТовараОстатки.Партия.Владелец
		             |ГДЕ
		             |	ОстаткиТовараОстатки.ОстатокОстаток > 0
		             |
		             |УПОРЯДОЧИТЬ ПО
		             |	НомерСтроки";
		Запр.УстановитьПараметр("Ссылка", Ссылка);
		Запр.УстановитьПараметр("ДатаОстатков", Ссылка.МоментВремени());
	    Выборка = Запр.Выполнить().Выбрать();   
		ТекстОшибки = НСтр("ru = 'Есть на остатках: '; en = 'Already at warewhouse(s): '");
		Пока Выборка.Следующий() Цикл
			ТекстОшибки = ТекстОшибки + СтрШаблон(НСтр("ru = 'строка %1 серия %2, '; en = 'line %1 series %2,'"), 
												Выборка.НомерСтроки, 
												Выборка.Серия);	
			 Отказ = Истина;
		КонецЦикла;
		Если Отказ Тогда
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = Лев(ТекстОшибки, СтрДлина(ТекстОшибки)-2);
			Сообщение.Сообщить();
		КонецЕсли;	
	КонецЕсли;
	
	// © Primus1C  ОКОНЧАНИЕ ◄
	
	//
	
	ТаблицаТоваров = Новый ТаблицаЗначений;
	ТаблицаТоваров.Колонки.Добавить("Номенклатура");
	ТаблицаТоваров.Колонки.Добавить("Цена", 			Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(19, 4)));
	ТаблицаТоваров.Колонки.Добавить("Количество", 		Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15, 0)));
	ТаблицаТоваров.Колонки.Добавить("СуммаЗакупки", 	Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(19, 4)));
	ТаблицаТоваров.Колонки.Добавить("СуммаСоСкидкой", 	Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(19, 4)));
	
	Если НЕ ЗначениеЗаполнено(ВКД_Инвойс) Тогда
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Инвойс", ВКД_Инвойс);
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	Запрос.УстановитьПараметр("Поставка", Поставка);
	Запрос.УстановитьПараметр("Период", МоментВремени());
	Запрос.Текст = "ВЫБРАТЬ
	               |	ПриходнаяНакладнаяТовары.Номенклатура КАК Номенклатура,
	               |	СУММА(ПриходнаяНакладнаяТовары.Количество) КАК Количество
	               |ПОМЕСТИТЬ ВТ
	               |ИЗ
	               |	Документ.ПриходнаяНакладная.Товары КАК ПриходнаяНакладнаяТовары
	               |ГДЕ
	               |	ПриходнаяНакладнаяТовары.Ссылка = &Ссылка
	               |	И НЕ ПриходнаяНакладнаяТовары.Ссылка.ПометкаУдаления
	               |	И ПриходнаяНакладнаяТовары.Ссылка.Проведен
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ПриходнаяНакладнаяТовары.Номенклатура
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	Остатки.Номенклатура КАК Номенклатура,
	               |	Остатки.Цена КАК Цена,
	               |	Остатки.КоличествоОстаток КАК КоличествоОстаток,
	               |	Остатки.СуммаЗакупкиОстаток КАК СуммаЗакупкиОстаток,
	               |	Остатки.СуммаСоСкидкойОстаток КАК СуммаСоСкидкойОстаток
	               |ИЗ
	               |	РегистрНакопления.ВКД_ОприходованиеНоменклатуры.Остатки(
	               |			&Период,
	               |			Документ = &Инвойс
	               |				И Поставка = &Поставка
	               |				И Номенклатура В
	               |					(ВЫБРАТЬ
	               |						ВТ.Номенклатура
	               |					ИЗ
	               |						ВТ КАК ВТ)) КАК Остатки
	               |ГДЕ
	               |	Остатки.КоличествоОстаток > 0
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	Номенклатура,
	               |	Цена
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ВТ.Номенклатура КАК Номенклатура,
	               |	ВТ.Количество КАК Количество,
	               |	ЕСТЬNULL(СУММА(Остатки.КоличествоОстаток), 0) КАК КоличествоОстаток
	               |ИЗ
	               |	ВТ КАК ВТ
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ВКД_ОприходованиеНоменклатуры.Остатки(
	               |				&Период,
	               |				Документ = &Инвойс
	               |					И Поставка = &Поставка
	               |					И Номенклатура В
	               |						(ВЫБРАТЬ
	               |							ВТНом.Номенклатура
	               |						ИЗ
	               |							ВТ КАК ВТНом)) КАК Остатки
	               |		ПО ВТ.Номенклатура = Остатки.Номенклатура
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ВТ.Номенклатура,
	               |	ВТ.Количество";
	
	Пакет = Запрос.ВыполнитьПакет();
	СрезыОстатков = Пакет[1].Выгрузить();
	СрезыОстатков.Индексы.Добавить("Номенклатура");
	ПроверкаПоНоменклатуре = Пакет[2].Выбрать();
	
	Пока ПроверкаПоНоменклатуре.Следующий() Цикл
		
		Если ПроверкаПоНоменклатуре.Количество > ПроверкаПоНоменклатуре.КоличествоОстаток Тогда
			Отказ = Истина;
			ТекстПересорта = ВозможенПересорт(ПроверкаПоНоменклатуре.Номенклатура);
			Если ТекстПересорта <> "" Тогда
				ТекстПересорта = НСтр("ru = 'В инвойсе указана похожая номенклатура: '; en = 'The invoice indicates a similar good: '") + ТекстПересорта;
			КонецЕсли;
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = СтрШаблон(
				НСтр("ru = 'Не хватает номенклатуры: %1 для оприходования в количестве %2 шт!'; en = 'There is not enough %2 items: %1 for capitalization!'"),
				ПроверкаПоНоменклатуре.Номенклатура,
				СокрЛП(ПроверкаПоНоменклатуре.Количество - ПроверкаПоНоменклатуре.КоличествоОстаток));
			Если ТекстПересорта <> "" Тогда
				Сообщение.Текст = Сообщение.Текст + Символы.ПС + ТекстПересорта;
			КонецЕсли;
			Сообщение.Сообщить();
		КонецЕсли;
		
	КонецЦикла;
	
	Если Отказ И ПараметрыСеанса.БезусловноеПроведениеДокументов Тогда
		Отказ = Ложь;
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = НСтр("ru = 'Документ проведен, несмотря на ошибки!'; en = 'The document was posted despite the error(s)!'");
		Сообщение.Сообщить();
	КонецЕсли;
	
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	// Списание по ценовым срезам в пределах остатка поставки (не больше остатка).
	ПроверкаПоНоменклатуре = Пакет[2].Выбрать();
	Пока ПроверкаПоНоменклатуре.Следующий() Цикл
		
		ОсталосьСписать = Мин(ПроверкаПоНоменклатуре.Количество, ПроверкаПоНоменклатуре.КоличествоОстаток);
		Если ОсталосьСписать <= 0 Тогда
			Продолжить;
		КонецЕсли;
		
		СтрокиСрезов = СрезыОстатков.НайтиСтроки(Новый Структура("Номенклатура", ПроверкаПоНоменклатуре.Номенклатура));
		Для Каждого Срез Из СтрокиСрезов Цикл
			
			Если ОсталосьСписать <= 0 Тогда
				Прервать;
			КонецЕсли;
			Если Срез.КоличествоОстаток <= 0 Тогда
				Продолжить;
			КонецЕсли;
			
			Взять = Мин(ОсталосьСписать, Срез.КоличествоОстаток);
			НовСтр = ТаблицаТоваров.Добавить();
			НовСтр.Номенклатура 	= ПроверкаПоНоменклатуре.Номенклатура;
			НовСтр.Цена 			= Срез.Цена;
			НовСтр.Количество 		= Взять;
			НовСтр.СуммаЗакупки 	= СуммаСписанияПоОстаткуСреза(Взять, Срез.КоличествоОстаток, Срез.СуммаЗакупкиОстаток);
			НовСтр.СуммаСоСкидкой 	= СуммаСписанияПоОстаткуСреза(Взять, Срез.КоличествоОстаток, Срез.СуммаСоСкидкойОстаток);
			
			Срез.КоличествоОстаток 		= Срез.КоличествоОстаток - Взять;
			Срез.СуммаЗакупкиОстаток 	= Срез.СуммаЗакупкиОстаток - НовСтр.СуммаЗакупки;
			Срез.СуммаСоСкидкойОстаток 	= Срез.СуммаСоСкидкойОстаток - НовСтр.СуммаСоСкидкой;
			ОсталосьСписать = ОсталосьСписать - Взять;
			
		КонецЦикла;
		
	КонецЦикла;
	
КонецПроцедуры

// Сумма списания с ценового среза: при полном закрытии среза — весь остаток суммы (без погрешности округления).
//
// Параметры:
//  КоличествоСписания - Число - списываемое количество;
//  КоличествоОстаток  - Число - остаток количества в срезе;
//  СуммаОстаток       - Число - остаток суммы в срезе.
//
// Возвращаемое значение:
//  Число - сумма к списанию.
//
Функция СуммаСписанияПоОстаткуСреза(КоличествоСписания, КоличествоОстаток, СуммаОстаток)
	
	Если КоличествоОстаток <= 0 Или КоличествоСписания <= 0 Тогда
		Возврат 0;
	ИначеЕсли КоличествоСписания = КоличествоОстаток Тогда
		Возврат СуммаОстаток;
	Иначе
		Возврат КоличествоСписания / КоличествоОстаток * СуммаОстаток;
	КонецЕсли;
	
КонецФункции

