// Возвращает Истина, если все строки — возврат товаров, переданных на комиссию.
// Смешение обычных и комиссионных расходных накладных запрещено.
//
// Параметры:
//  Отказ - Булево - устанавливается в Истина при смешении режимов.
//
// Возвращаемое значение:
//  Булево - Истина, если все заполненные расходные накладные имеют Комиссия.
//
Функция ЭтоВозвратТоваровНаКомиссии(Отказ)
	
	Запр = Новый Запрос;
	Запр.УстановитьПараметр("Ссылка", Ссылка);
	Запр.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ЕСТЬNULL(ВозвратТовары.РасходняНакладная.Комиссия, ЛОЖЬ) КАК Комиссия
	|ИЗ
	|	Документ._ВозвратОтПокупателя.Товары КАК ВозвратТовары
	|ГДЕ
	|	ВозвратТовары.Ссылка = &Ссылка
	|	И ВозвратТовары.Количество <> 0";
	
	Выборка = Запр.Выполнить().Выбрать();
	ЕстьКомиссия = Ложь;
	ЕстьОбычная = Ложь;
	Пока Выборка.Следующий() Цикл
		Если Выборка.Комиссия Тогда
			ЕстьКомиссия = Истина;
		Иначе
			ЕстьОбычная = Истина;
		КонецЕсли;
	КонецЦикла;
	
	Если ЕстьКомиссия И ЕстьОбычная Тогда
		Сообщить(НСтр("ru = 'Нельзя в одном возврате смешивать проданные товары и товары, переданные на комиссию.'; en = 'Sold goods and consignment goods cannot be mixed in one return.'"));
		Отказ = Истина;
		Возврат Ложь;
	КонецЕсли;
	
	Возврат ЕстьКомиссия;
	
КонецФункции

// Проведение возврата товаров, ранее переданных на комиссию расходной накладной.
//
Процедура СформироватьДвиженияВозвратаСКомиссии(Отказ)
	
	Запр = Новый Запрос;
	Запр.УстановитьПараметр("Ссылка", Ссылка);
	Запр.УстановитьПараметр("Дата", Дата);
	Запр.УстановитьПараметр("Фирма", Фирма);
	Запр.Текст =
	"ВЫБРАТЬ
	|	ВозвратТовары.НомерСтроки КАК НомерСтроки,
	|	ВозвратТовары.Номенклатура КАК Номенклатура,
	|	ВозвратТовары.Партия КАК Партия,
	|	ВозвратТовары.Количество КАК Количество,
	|	ВозвратТовары.СуммаПродажи КАК СуммаПродажи,
	|	ВозвратТовары.РасходняНакладная КАК РасходнаяНакладная,
	|	РН.СкладКомиссии КАК СкладКомиссии,
	|	РН.Контрагент КАК Контрагент,
	|	РН.Валюта КАК Валюта,
	|	ЕСТЬNULL(РНТовары.ВКД_ЦенаСЗатратами, 0) КАК ЦенаСЗатратами,
	|	ЕСТЬNULL(ОстаткиСклада.ОстатокОстаток, 0) КАК ОстатокНаСкладеКомиссии,
	|	ЕСТЬNULL(ОстаткиКомиссии.КоличествоОстаток, 0) КАК КоличествоНаКомиссии,
	|	ЕСТЬNULL(ОстаткиКомиссии.СуммаОстаток, 0) КАК СуммаНаКомиссии,
	|	ЕСТЬNULL(ОстаткиКомиссии.СуммаКомиссионераОстаток, 0) КАК СуммаКомиссионера
	|ИЗ
	|	Документ._ВозвратОтПокупателя.Товары КАК ВозвратТовары
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.РасходнаяНакладная КАК РН
	|		ПО ВозвратТовары.РасходняНакладная = РН.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.РасходнаяНакладная.Товары КАК РНТовары
	|		ПО ВозвратТовары.РасходняНакладная = РНТовары.Ссылка
	|			И ВозвратТовары.Партия = РНТовары.Партия
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ОстаткиТовара.Остатки(
	|				&Дата,
	|				Фирма = &Фирма
	|					И Партия В
	|						(ВЫБРАТЬ
	|							Т.Партия
	|						ИЗ
	|							Документ._ВозвратОтПокупателя.Товары КАК Т
	|						ГДЕ
	|							Т.Ссылка = &Ссылка)) КАК ОстаткиСклада
	|		ПО ВозвратТовары.Партия = ОстаткиСклада.Партия
	|			И РН.СкладКомиссии = ОстаткиСклада.Склад
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ТоварыНаКомиссии.Остатки(
	|				&Дата,
	|				Партия В
	|					(ВЫБРАТЬ
	|						Т.Партия
	|					ИЗ
	|						Документ._ВозвратОтПокупателя.Товары КАК Т
	|					ГДЕ
	|						Т.Ссылка = &Ссылка)) КАК ОстаткиКомиссии
	|		ПО ВозвратТовары.Партия = ОстаткиКомиссии.Партия
	|			И РН.СкладКомиссии = ОстаткиКомиссии.Склад
	|			И РН.Контрагент = ОстаткиКомиссии.Контрагент
	|ГДЕ
	|	ВозвратТовары.Ссылка = &Ссылка
	|	И ВозвратТовары.Количество <> 0";
	
	Выборка = Запр.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		
		Если НЕ ЗначениеЗаполнено(Выборка.СкладКомиссии) Тогда
			Сообщить(СтрШаблон(НСтр("ru = 'Строка %1: в расходной накладной не указан склад комиссии.'; en = 'Row %1: commission warehouse is not specified in the delivery note.'"), Выборка.НомерСтроки));
			Отказ = Истина;
			Продолжить;
		КонецЕсли;
		
		Если Выборка.ОстатокНаСкладеКомиссии < Выборка.Количество Тогда
			Сообщить(СтрШаблон(НСтр("ru = 'Строка %1: на складе комиссии недостаточно товара (нужно %2, есть %3).'; en = 'Row %1: insufficient stock at the commission warehouse (required %2, available %3).'"),
				Выборка.НомерСтроки, Выборка.Количество, Выборка.ОстатокНаСкладеКомиссии));
			Отказ = Истина;
		КонецЕсли;
		
		Если Выборка.КоличествоНаКомиссии < Выборка.Количество Тогда
			Сообщить(СтрШаблон(НСтр("ru = 'Строка %1: недостаточно товара на комиссии (нужно %2, есть %3).'; en = 'Row %1: insufficient consignment goods (required %2, available %3).'"),
				Выборка.НомерСтроки, Выборка.Количество, Выборка.КоличествоНаКомиссии));
			Отказ = Истина;
		КонецЕсли;
		
	КонецЦикла;
	
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	Движения.ОстаткиТовара.Записывать = Истина;
	Движения.ТоварыНаКомиссии.Записывать = Истина;
	Движения.РасходыДоходы.Записывать = Истина;
	
	Выборка.Сбросить();
	Пока Выборка.Следующий() Цикл
		
		Движение = Движения.ОстаткиТовара.ДобавитьРасход();
		Движение.Период 		= Дата;
		Движение.Фирма 			= Фирма;
		Движение.Склад 			= Выборка.СкладКомиссии;
		Движение.Номенклатура 	= Выборка.Номенклатура;
		Движение.Партия 		= Выборка.Партия;
		Движение.Остаток 		= Выборка.Количество;
		
		Движение = Движения.ОстаткиТовара.ДобавитьПриход();
		Движение.Период 		= Дата;
		Движение.Фирма 			= Фирма;
		Движение.Склад 			= Склад;
		Движение.Номенклатура 	= Выборка.Номенклатура;
		Движение.Партия 		= Выборка.Партия;
		Движение.Остаток 		= Выборка.Количество;
		
		КоэффициентСумм = ?(Выборка.КоличествоНаКомиссии = 0, 0, Выборка.Количество / Выборка.КоличествоНаКомиссии);
		СуммаКомиссии = ?(КоэффициентСумм = 0, Выборка.ЦенаСЗатратами * Выборка.Количество, Выборка.СуммаНаКомиссии * КоэффициентСумм);
		СуммаКомиссионера = ?(КоэффициентСумм = 0, Выборка.СуммаПродажи, Выборка.СуммаКомиссионера * КоэффициентСумм);
		
		Движение = Движения.ТоварыНаКомиссии.ДобавитьПриход();
		Движение.Период 			= Дата;
		Движение.Номенклатура 		= Выборка.Номенклатура;
		Движение.Партия 			= Выборка.Партия;
		Движение.Контрагент 		= Выборка.Контрагент;
		Движение.Склад 				= Выборка.СкладКомиссии;
		Движение.Количество 		= - Выборка.Количество;
		Движение.Сумма 				= - СуммаКомиссии;
		Движение.СуммаКомиссионера 	= - СуммаКомиссионера;
		
	КонецЦикла;
	
	СторнироватьДоходКомиссионныхНакладных();
	
КонецПроцедуры

// Сторнирует товарный доход «РасходыДоходы» комиссионных расходных накладных
// по статьям партий возврата (Партия.Док.ВКД_Инвойс.ДокументОснование.СкладОтправитель.Статья),
// пропорционально количеству возврата по каждой статье. Пустая статья заменяется на ДоходОтПродажи.
// Услуги и курсовая разница не сторнируются.
//
Процедура СторнироватьДоходКомиссионныхНакладных()
	
	Запр = Новый Запрос;
	Запр.УстановитьПараметр("Ссылка", Ссылка);
	Запр.Текст =
	"ВЫБРАТЬ
	|	ВозвратТовары.РасходняНакладная КАК РасходнаяНакладная,
	|	ВЫБОР
	|		КОГДА ЕСТЬNULL(ВозвратТовары.Партия.Док.ВКД_Инвойс.ДокументОснование.СкладОтправитель.Статья, ЗНАЧЕНИЕ(Справочник.Статьи.ПустаяСсылка)) = ЗНАЧЕНИЕ(Справочник.Статьи.ПустаяСсылка)
	|			ТОГДА ЗНАЧЕНИЕ(Справочник.Статьи.ДоходОтПродажи)
	|		ИНАЧЕ ВозвратТовары.Партия.Док.ВКД_Инвойс.ДокументОснование.СкладОтправитель.Статья
	|	КОНЕЦ КАК Статья,
	|	СУММА(ВозвратТовары.Количество) КАК КоличествоВозврата
	|ПОМЕСТИТЬ ВТВозврат
	|ИЗ
	|	Документ._ВозвратОтПокупателя.Товары КАК ВозвратТовары
	|ГДЕ
	|	ВозвратТовары.Ссылка = &Ссылка
	|	И ВозвратТовары.Количество <> 0
	|
	|СГРУППИРОВАТЬ ПО
	|	ВозвратТовары.РасходняНакладная,
	|	ВЫБОР
	|		КОГДА ЕСТЬNULL(ВозвратТовары.Партия.Док.ВКД_Инвойс.ДокументОснование.СкладОтправитель.Статья, ЗНАЧЕНИЕ(Справочник.Статьи.ПустаяСсылка)) = ЗНАЧЕНИЕ(Справочник.Статьи.ПустаяСсылка)
	|			ТОГДА ЗНАЧЕНИЕ(Справочник.Статьи.ДоходОтПродажи)
	|		ИНАЧЕ ВозвратТовары.Партия.Док.ВКД_Инвойс.ДокументОснование.СкладОтправитель.Статья
	|	КОНЕЦ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	РНТовары.Ссылка КАК РасходнаяНакладная,
	|	ВЫБОР
	|		КОГДА ЕСТЬNULL(РНТовары.Партия.Док.ВКД_Инвойс.ДокументОснование.СкладОтправитель.Статья, ЗНАЧЕНИЕ(Справочник.Статьи.ПустаяСсылка)) = ЗНАЧЕНИЕ(Справочник.Статьи.ПустаяСсылка)
	|			ТОГДА ЗНАЧЕНИЕ(Справочник.Статьи.ДоходОтПродажи)
	|		ИНАЧЕ РНТовары.Партия.Док.ВКД_Инвойс.ДокументОснование.СкладОтправитель.Статья
	|	КОНЕЦ КАК Статья,
	|	СУММА(РНТовары.Количество) КАК КоличествоНакладной
	|ПОМЕСТИТЬ ВТНакладные
	|ИЗ
	|	Документ.РасходнаяНакладная.Товары КАК РНТовары
	|ГДЕ
	|	РНТовары.Ссылка В
	|			(ВЫБРАТЬ
	|				ВТВозврат.РасходнаяНакладная
	|			ИЗ
	|				ВТВозврат)
	|	И РНТовары.Номенклатура.ТипНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.Товар)
	|	И РНТовары.Количество <> 0
	|
	|СГРУППИРОВАТЬ ПО
	|	РНТовары.Ссылка,
	|	ВЫБОР
	|		КОГДА ЕСТЬNULL(РНТовары.Партия.Док.ВКД_Инвойс.ДокументОснование.СкладОтправитель.Статья, ЗНАЧЕНИЕ(Справочник.Статьи.ПустаяСсылка)) = ЗНАЧЕНИЕ(Справочник.Статьи.ПустаяСсылка)
	|			ТОГДА ЗНАЧЕНИЕ(Справочник.Статьи.ДоходОтПродажи)
	|		ИНАЧЕ РНТовары.Партия.Док.ВКД_Инвойс.ДокументОснование.СкладОтправитель.Статья
	|	КОНЕЦ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТВозврат.РасходнаяНакладная КАК РасходнаяНакладная,
	|	ВТВозврат.Статья КАК Статья,
	|	ВТВозврат.КоличествоВозврата КАК КоличествоВозврата,
	|	ВТНакладные.КоличествоНакладной КАК КоличествоНакладной,
	|	РасходыДоходы.Вид КАК Вид,
	|	РасходыДоходы.Валюта КАК Валюта,
	|	СУММА(РасходыДоходы.Сумма) КАК Сумма
	|ИЗ
	|	ВТВозврат КАК ВТВозврат
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТНакладные КАК ВТНакладные
	|		ПО ВТВозврат.РасходнаяНакладная = ВТНакладные.РасходнаяНакладная
	|			И ВТВозврат.Статья = ВТНакладные.Статья
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрНакопления.РасходыДоходы КАК РасходыДоходы
	|		ПО ВТВозврат.РасходнаяНакладная = РасходыДоходы.Регистратор
	|			И ВТВозврат.Статья = РасходыДоходы.Статья
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТВозврат.РасходнаяНакладная,
	|	ВТВозврат.Статья,
	|	ВТВозврат.КоличествоВозврата,
	|	ВТНакладные.КоличествоНакладной,
	|	РасходыДоходы.Вид,
	|	РасходыДоходы.Валюта";
	
	Выборка = Запр.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		
		Если Выборка.КоличествоНакладной = 0 Или Выборка.Сумма = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		Движение = Движения.РасходыДоходы.Добавить();
		Движение.Период = Дата;
		Движение.Фирма 	= Фирма;
		Движение.Вид 	= Выборка.Вид;
		Движение.Статья = Выборка.Статья;
		Движение.Валюта = Выборка.Валюта;
		Движение.Сумма 	= - Выборка.Сумма * Выборка.КоличествоВозврата / Выборка.КоличествоНакладной;
		
	КонецЦикла;
	
КонецПроцедуры

Функция ПолучитьВыборкуПоПродажам(ТекСтрока)
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	Продажи.Период КАК Период,
	               |	Продажи.Регистратор КАК Регистратор,
	               |	Продажи.Фирма КАК Фирма,
	               |	Продажи.Покупатель КАК Покупатель,
	               |	Продажи.Поставщик КАК Поставщик,
	               |	Продажи.Автор КАК Автор,
	               |	Продажи.Валюта КАК Валюта,
	               |	Продажи.Номенклатура КАК Номенклатура,
	               |	Продажи.Партия КАК Партия,
	               |	Продажи.ДокументПрихода КАК ДокументПрихода,
	               |	Продажи.Сумма КАК Сумма,
	               |	Продажи.Количество КАК Количество,
	               |	Продажи.Наценка КАК Наценка,
	               |	Продажи.Склад КАК Склад,
	               |	Продажи.СуммаВБазВалюте КАК СуммаВБазВалюте,
	               |	Продажи.НаценкаВБазВалюте КАК НаценкаВБазВалюте
	               |ИЗ
	               |	РегистрНакопления.Продажи КАК Продажи
	               |ГДЕ
	               |	Продажи.Регистратор = &Регистратор
	               |	И Продажи.Партия = &Партия
	               |	И Продажи.Номенклатура = &Номенклатура";
	Запрос.УстановитьПараметр("Регистратор",	ТекСтрока.РасходняНакладная);
	Запрос.УстановитьПараметр("Номенклатура",	ТекСтрока.Номенклатура);
	Запрос.УстановитьПараметр("Партия",	 		ТекСтрока.Партия);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Выборка.Следующий();
	
	Возврат Выборка;

КонецФункции // ПолучитьВыборкуПоПродажам()

Функция ПолучитьВыборкуПоВзаиморасчетам(ТекСтрока)
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	Долги.Период,
	               |	Долги.Регистратор,
	               |	Долги.Фирма,
	               |	Долги.Док,
	               |	Долги.Валюта,
	               |	Долги.Контрагент,
	               |	Долги.ДолгПокупателя,
	               |	Долги.ПредоплатаПокупателя,
	               |	Долги.ДолгПоставщику,
	               |	Долги.ПредоплатаПоставщику,
	               |	Долги.Покупатель,
	               |	Долги.Поставщик,
	               |	Долги.Чем
	               |ИЗ
	               |	РегистрНакопления.Долги КАК Долги
	               |ГДЕ
	               |	Долги.Регистратор = &Регистратор";
	Запрос.УстановитьПараметр("Регистратор",	 ТекСтрока.РасходняНакладная);
	Запрос.УстановитьПараметр("Номенклатура",	 ТекСтрока.Номенклатура);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Выборка.Следующий();
	
	Возврат Выборка;
	
КонецФункции // ПолучитьВыборкуПоВзаиморасчетам()

Функция ВКД_ПолучитьНаценкуПоНаменклатуре(Ссылка,Серия)
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	РасходнаяНакладнаяТовары.ЦенаЗакупки,
	               |	РасходнаяНакладнаяТовары.ВКД_ЦенаСоСкидкой,
	               |	РасходнаяНакладнаяТовары.ВКД_ЦенаСЗатратами,
	               |	ВЫБОР
	               |		КОГДА РасходнаяНакладнаяТовары.ВКД_ЦенаСЗатратами = 0
	               |			ТОГДА РасходнаяНакладнаяТовары.СуммаПродажи - РасходнаяНакладнаяТовары.ЦенаЗакупки
	               |		КОГДА РасходнаяНакладнаяТовары.ВКД_ЦенаСоСкидкой = 0
	               |			ТОГДА РасходнаяНакладнаяТовары.СуммаПродажи - РасходнаяНакладнаяТовары.ЦенаЗакупки
	               |		ИНАЧЕ РасходнаяНакладнаяТовары.СуммаПродажи - РасходнаяНакладнаяТовары.ВКД_ЦенаСЗатратами
	               |	КОНЕЦ КАК Наценка,
	               |	РасходнаяНакладнаяТовары.СуммаПродажи
	               |ИЗ
	               |	Документ.РасходнаяНакладная.Товары КАК РасходнаяНакладнаяТовары
	               |ГДЕ
	               |	РасходнаяНакладнаяТовары.Ссылка = &Ссылка
	               |	И РасходнаяНакладнаяТовары.Серия = &Серия";
	Запрос.УстановитьПараметр("Ссылка",Ссылка);
	Запрос.УстановитьПараметр("Серия",Серия);
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	Выборка.Следующий();
	
	Если Выборка.ВКД_ЦенаСЗатратами = 0 и Выборка.ВКД_ЦенаСоСкидкой = 0 Тогда  //стандартная процедура
		Наценка = Выборка.СуммаПродажи - Выборка.ЦенаЗакупки
	ИначеЕсли Выборка.ВКД_ЦенаСоСкидкой <> 0 И Выборка.ВКД_ЦенаСЗатратами = 0 Тогда  //есть только скидка
		Наценка = Выборка.СуммаПродажи - Выборка.ВКД_ЦенаСоСкидкой 
	Иначе
		Наценка = Выборка.СуммаПродажи - Выборка.ВКД_ЦенаСЗатратами  // есть конечная цена с затратами
	КонецЕсли;
	
	Возврат Выборка.Наценка;
	
КонецФункции





