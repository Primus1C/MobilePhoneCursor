&НаКлиенте
Процедура РучнойШКПриИзменении(Элемент)

	ЛюбаяСерия(РучнойШК, Истина, Элементы.Товары.ТекущаяСтрока);

КонецПроцедуры  

&НаКлиенте
Процедура ЛюбаяСерия(НовСер, СтатьНаРучной = Ложь, СтрокаФормы = Неопределено)

	ШК = СокрЛП(НовСер);
	Если ШК = "" Тогда Возврат КонецЕсли; 

	Если ЭтаФорма.ТолькоПросмотр Тогда Возврат КонецЕсли; 
	
	Если Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацииЗаменаСерий.ЗаменаНоменклатурыВОднойСерии") Тогда
		
		СтрокаТЧ = Объект.Товары.Добавить(); 
		СтрокаТЧ.Партия 		= ПартияПоСерии(ШК);
		СтрокаТЧ.Серия 			= ШК;  
		СтрокаТЧ.Номенклатура 	= гоРеквизит(СтрокаТЧ.Партия, "Владелец");    
		
	ИначеЕсли ЭтоСтараяСерия Тогда   
		
		СписокПартий = омСервер.ПартииПоСерииОстатки(ШК, , ); 
		КвоПартий = СписокПартий.Количество();
	
		Если КвоПартий = 0 Тогда
			//Сигнал();    
			ОбщегоНазначенияКлиент.Звук();
			клОшибка(СтрШаблон("%1: %2 %3", 
								омСервер.Фрмт(НСтр("ru = 'Нет остатков по серии'; en = 'There are no remaining goods for the series!'"), "НАДПИСЬ_ЦВ1"), 
								омСервер.Фрмт(ШК, "НАДПИСЬ_ЦВ2"),
								омСервер.Фрмт("!", "НАДПИСЬ_ЦВ1")));
			Возврат;
		ИначеЕсли КвоПартий > 1 Тогда
			//Сигнал(); 
			ОбщегоНазначенияКлиент.Звук();
			Эле = СписокПартий.ВыбратьЭлемент(НСтр("ru = 'Найдено несколько партий с такой серией, выберите:'; en = 'Several batches with this series have been found, please select:'"));
			Если Эле = Неопределено Тогда Возврат КонецЕсли;
			Партия = Эле.Значение;
		Иначе
			Партия = СписокПартий[0].Значение;   
		КонецЕсли; 
		Если ЕстьДубли(ШК) Тогда
			Сообщить(НСтр("ru = 'Серия уже есть в документе!'; en = 'The series is already in the document!'"));
			Возврат;
		КонецЕсли;
		
		СтрокаТЧ = Объект.Товары.Добавить(); 
		СтрокаТЧ.Партия 		= Партия;
		СтрокаТЧ.Серия 			= ШК;  
		СтрокаТЧ.Номенклатура 	= гоРеквизит(Партия, "Владелец");    
		
	Иначе
		
		СтрокаТЧ = Элементы.Товары.ТекущаяСтрока;
		Если СтрокаТЧ = Неопределено Тогда
			Сообщить(НСтр("ru = 'Не выбрана строка табличной части!'; en = 'No table section row selected!'"));		
		//ИначеЕсли КвоПартий > 1 Тогда
		//	Сигнал();
		//	Эле = СписокПартий.ВыбратьЭлемент(НСтр("ru = 'Найдено несколько партий с такой серией, выберите:'; en = 'Several batches with this series have been found, please select:'"));
		//	Если Эле = Неопределено Тогда Возврат КонецЕсли;
		//	Партия = Эле.Значение;
		//Иначе      
		//	Партия = СписокПартий[0].Значение;   
		КонецЕсли;
		//СтрокаТЧ.Партия = Партия;  
		Если ЕстьДубли(ШК) Тогда
			Сообщить(НСтр("ru = 'Серия уже есть в документе!'; en = 'The series is already in the document!'"));
			Возврат;
		КонецЕсли;

		Элементы.Товары.ТекущиеДанные.СерияНовая = ШК;  

	КонецЕсли; 
	
	//Если СтатьНаРучной Тогда 
	//	РучнойШК = "";
	//	ПодключитьОбработчикОжидания("МоеОжидание", 0.1, Истина);
	//КонецЕсли;  
	
КонецПроцедуры

&НаКлиенте
Процедура МоеОжидание()
	
	ЭтаФорма.ТекущийЭлемент = Элементы.РучнойШК;

КонецПроцедуры

&НаКлиенте
Функция ЕстьДубли(ШК)
	
	Если ЭтоСтараяСерия Тогда
		Имя = "Серия";
	Иначе
		Имя = "СерияНовая";
	КонецЕсли;
	НайдСтроки = Объект.Товары.НайтиСтроки(Новый Структура(Имя, ШК));
	Возврат НайдСтроки.Количество() > 0;
	
КонецФункции // ЕстьДубли()

&НаКлиенте
Процедура ВыполненныеЗаменыВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)

	Если Поле.Имя = "ВыполненныеЗаменыОбъектЗамены" Тогда
		СтандартнаяОбработка = Ложь;
        ОткрытьЗначение(Элемент.ТекущиеДанные.ОбъектЗамены);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ТоварыСерияПриИзменении(Элемент)
	Если Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацииЗаменаСерий.ЗаменаНоменклатурыВОднойСерии") Тогда
		СтрокаТЧ = Элементы.Товары.ТекущаяСтрока;
	    СтрокаТЧ.Партия = ПартияПоСерии(СтрокаТЧ.Серия);
	КонецЕсли;
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПартияПоСерии(Серия)

	Запр = Новый Запрос;
	Запр.Текст = "ВЫБРАТЬ
	             |	Партии.Ссылка КАК Ссылка
	             |ИЗ
	             |	Справочник.Партии КАК Партии
	             |ГДЕ
	             |	Партии.Серия = &Серия
	             |
	             |ОБЪЕДИНИТЬ
	             |
	             |ВЫБРАТЬ
	             |	Партии.Ссылка
	             |ИЗ
	             |	Справочник.Партии КАК Партии
	             |ГДЕ
	             |	Партии.Серия = &Серия";
	Запр.УстановитьПараметр("Серия", Серия);
    Выборка = Запр.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
	    Возврат Выборка.Ссылка;
	Иначе	
	     Возврат Справочники.Партии.ПустаяСсылка();
	КонецЕсли;
	
КонецФункции // ()

#КонецОбласти  


#Область БуферОбмена

&НаКлиенте
Процедура ИзБуфераОбмена(Команда)
	
	Если ЭтаФорма.ТолькоПросмотр Тогда
		Возврат;
	КонецЕсли;
	Если Объект.ЗаменаПроведена Тогда
		клОшибка(НСтр("ru = 'Замена уже проведена. Документ заблокирован.'; en = 'Replacement already posted. Document is locked.'"));
		Возврат;
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(Объект.ВидОперации) Тогда
		клОшибка(НСтр("ru = 'Не выбран вид операции!'; en = 'Operation type is not selected!'"));
		Возврат;
	КонецЕсли;
	
	РаботаСоСканеромШК.ПолучитьИМЕИИзБуфера(Новый ОписаниеОповещения("ИзБуфераОбменаПослеПолученияБуфера", ЭтотОбъект), );
	
КонецПроцедуры

&НаКлиенте
Процедура ИзБуфераОбменаПослеПолученияБуфера(Буф, ДопПараметры) Экспорт
	
	Если Буф = Неопределено Или СокрЛП(Строка(Буф)) = "" Тогда
		Возврат;
	КонецЕсли;
	
	КвоСтрок = СтрЧислоСтрок(Буф);
	МассивСерий = Новый Массив;
	Для Н = 1 По КвоСтрок Цикл
		НовСер = "";
		С = СтрПолучитьСтроку(Буф, Н);
		Пока (НовСер = "") И (С <> "") Цикл
			НовСер = гоСледПолеТаб(С);
		КонецЦикла;
		Серия = СокрЛП(НовСер);
		Если Серия <> "" Тогда
			МассивСерий.Добавить(Серия);
		КонецЕсли;
	КонецЦикла;
	
	Если МассивСерий.Количество() = 0 Тогда
		клОшибка(НСтр("ru = 'В буфере обмена нет серий.'; en = 'No series found in the clipboard.'"));
		Возврат;
	КонецЕсли;
	
	ЗаменаНоменклатурыВСерии = Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацииЗаменаСерий.ЗаменаНоменклатурыВОднойСерии");
	
	Ошибки 			= Новый СписокЗначений;
	Предупреждения 	= Новый СписокЗначений;
	НовыхСтрок = 0;
	
	Если ЗаменаНоменклатурыВСерии Тогда
		
		СоотвПартий = СведенияПартийПоСправочнику(МассивСерий);
		Для Каждого Серия Из МассивСерий Цикл
			Если ЕстьДублиПоКолонке("Серия", Серия) Тогда
				Ошибки.Добавить(СтрШаблон(НСтр("ru = 'Серия %1 уже есть в документе'; en = 'Series %1 is already in the document'"), Серия));
				Продолжить;
			КонецЕсли;
			СведенияПартии = НайтиСведенияПартии(СоотвПартий, Серия);
			Если СведенияПартии = Неопределено Тогда
				Ошибки.Добавить(СтрШаблон(НСтр("ru = 'Серия %1 не найдена в справочнике партий'; en = 'Series %1 was not found in the batches catalog'"), Серия));
				Продолжить;
			КонецЕсли;
			Если СведенияПартии.Свойство("НесколькоПартий") И СведенияПартии.НесколькоПартий Тогда
				Ошибки.Добавить(СтрШаблон(НСтр("ru = 'Серия %1: найдено несколько партий'; en = 'Series %1: several batches found'"), Серия));
				Продолжить;
			КонецЕсли;
			Если НЕ ЗначениеЗаполнено(СведенияПартии.Номенклатура) Тогда
				Ошибки.Добавить(СтрШаблон(НСтр("ru = 'Серия %1: не определена номенклатура'; en = 'Series %1: nomenclature is not defined'"), Серия));
				Продолжить;
			КонецЕсли;
			СтрокаТЧ = Объект.Товары.Добавить();
			СтрокаТЧ.Серия 			= Серия;
			СтрокаТЧ.Номенклатура 	= СведенияПартии.Номенклатура;
			СтрокаТЧ.Партия 		= СведенияПартии.Партия;
			НовыхСтрок = НовыхСтрок + 1;
		КонецЦикла;
		
	ИначеЕсли ЭтоСтараяСерия Тогда
		
		СоотвПартий = СведенияПартийПоОстаткам(МассивСерий);
		Для Каждого Серия Из МассивСерий Цикл
			Если ЕстьДублиПоКолонке("Серия", Серия) Тогда
				Ошибки.Добавить(СтрШаблон(НСтр("ru = 'Серия %1 уже есть в документе'; en = 'Series %1 is already in the document'"), Серия));
				Продолжить;
			КонецЕсли;
			СведенияПартии = НайтиСведенияПартии(СоотвПартий, Серия);
			Если СведенияПартии = Неопределено Тогда
				Ошибки.Добавить(СтрШаблон(НСтр("ru = 'Нет остатков серии %1'; en = 'No stock for series %1'"), Серия));
				Продолжить;
			КонецЕсли;
			Если СведенияПартии.Свойство("НесколькоПартий") И СведенияПартии.НесколькоПартий Тогда
				Ошибки.Добавить(СтрШаблон(НСтр("ru = 'Серия %1: найдено несколько партий на остатках'; en = 'Series %1: several batches found on stock'"), Серия));
				Продолжить;
			КонецЕсли;
			Если НЕ ЗначениеЗаполнено(СведенияПартии.Номенклатура) Или НЕ ЗначениеЗаполнено(СведенияПартии.Партия) Тогда
				Ошибки.Добавить(СтрШаблон(НСтр("ru = 'Серия %1: не определены номенклатура или партия'; en = 'Series %1: nomenclature or batch is not defined'"), Серия));
				Продолжить;
			КонецЕсли;
			СтрокаТЧ = Объект.Товары.Добавить();
			СтрокаТЧ.Номенклатура 	= СведенияПартии.Номенклатура;
			СтрокаТЧ.Партия 		= СведенияПартии.Партия;
			СтрокаТЧ.Серия 			= Серия;
			НовыхСтрок = НовыхСтрок + 1;
		КонецЦикла;
		
	Иначе
		
		СоотвПартий = СведенияПартийПоСправочнику(МассивСерий);
		Для Каждого Серия Из МассивСерий Цикл
			Если ЕстьДублиПоКолонке("СерияНовая", Серия) Тогда
				Ошибки.Добавить(СтрШаблон(НСтр("ru = 'Новая серия %1 уже есть в документе'; en = 'New series %1 is already in the document'"), Серия));
				Продолжить;
			КонецЕсли;
			СведенияПартии = НайтиСведенияПартии(СоотвПартий, Серия);
			Если СведенияПартии = Неопределено Тогда 
				// такой серии нет, помещаем ее в первую строку с незаполненнй новой серией
				Предупреждения.Добавить(СтрШаблон(НСтр("ru = 'Серия %1 не найдена в справочнике партий'; en = 'Series %1 was not found in the batches catalog'"), Серия)); 
				НайдСтроки = Объект.Товары.НайтиСтроки(Новый Структура("СерияНовая", "")); 
				Если НайдСтроки.Количество() = 0 Тогда
					Ошибки.Добавить(СтрШаблон(НСтр("ru = 'Серия %1: нет пустых значений в табличной части'; en = 'Series %1: no empty values in the table part'"), Серия));
					Продолжить;
				Иначе
				    НайдСтроки[0].СерияНовая = Серия; 
				КонецЕсли;
			Иначе
				Если СведенияПартии.Свойство("НесколькоПартий") И СведенияПартии.НесколькоПартий Тогда
					Ошибки.Добавить(СтрШаблон(НСтр("ru = 'Серия %1: найдено несколько партий'; en = 'Series %1: several batches found'"), Серия));
					Продолжить;
				КонецЕсли;
				Если НЕ ЗначениеЗаполнено(СведенияПартии.Номенклатура) Или НЕ ЗначениеЗаполнено(СведенияПартии.Партия) Тогда
					Ошибки.Добавить(СтрШаблон(НСтр("ru = 'Серия %1: не определены номенклатура или партия'; en = 'Series %1: nomenclature or batch is not defined'"), Серия));
					Продолжить;
				КонецЕсли;
				СтрокаТЧ = Объект.Товары.Добавить();
				СтрокаТЧ.Номенклатура = СведенияПартии.Номенклатура;
				СтрокаТЧ.Партия = СведенияПартии.Партия;
				СтрокаТЧ.СерияНовая = Серия;
				НовыхСтрок = НовыхСтрок + 1;  
			КонецЕсли;
		КонецЦикла;
		
	КонецЕсли;
	
	Если Объект.Товары.Количество() > 0 Тогда
		Элементы.Товары.ТекущаяСтрока = Объект.Товары[Объект.Товары.Количество() - 1].ПолучитьИдентификатор();
	КонецЕсли;
	
	Если Ошибки.Количество() > 0 Тогда
		ТекстОшибок = "";
		Для Каждого Ош Из Ошибки Цикл
			ТекстОшибок = ТекстОшибок + Ош.Значение + Символы.ПС;
		КонецЦикла;
		клОшибка(ТекстОшибок, , ?(ЭтоСтараяСерия, 
								НСтр("ru = 'Ошибки заполнения'; en = 'Filling Errors'"), 
		                        НСтр("ru = 'Новые серии'; en = 'New Series'"))
								);
	ИначеЕсли НовыхСтрок = 0 И ЭтоСтараяСерия Тогда
		клОшибка(НСтр("ru = 'Строки не добавлены.'; en = 'No rows were added.'"));
	КонецЕсли;

	Если Ошибки.Количество() = 0 И Предупреждения.Количество() > 0 Тогда 
		ТекстОшибок = "";
		Для Каждого Ош Из Предупреждения Цикл
			ТекстОшибок = ТекстОшибок + Ош.Значение + Символы.ПС;
		КонецЦикла;
		клПредупреждение(ТекстОшибок);
	КонецЕсли;		

КонецПроцедуры

&НаКлиенте
Функция ЕстьДублиПоКолонке(ИмяКолонки, Значение)
	
	НайдСтроки = Объект.Товары.НайтиСтроки(Новый Структура(ИмяКолонки, Значение));
	Возврат НайдСтроки.Количество() > 0;
	
КонецФункции

&НаКлиенте
Функция НайтиСведенияПартии(СоотвПартий, Серия)
	
	СведенияПартии = СоотвПартий.Получить(Серия);
	Если СведенияПартии = Неопределено Тогда
		СведенияПартии = СоотвПартий.Получить(ВРег(Серия));
	КонецЕсли;
	Если СведенияПартии = Неопределено Тогда
		СведенияПартии = СоотвПартий.Получить(НРег(Серия));
	КонецЕсли;
	Возврат СведенияПартии;
	
КонецФункции

// Возвращает соответствие серия → сведения партии по справочнику Партии.
//
// Параметры:
//  МассивСерий - Массив из Строка - серии из буфера.
//
// Возвращаемое значение:
//  Соответствие - ключ серия, значение Структура(Партия, Номенклатура, НесколькоПартий).
//
&НаСервереБезКонтекста
Функция СведенияПартийПоСправочнику(МассивСерий)
	
	СоотвПартий = Новый Соответствие;
	Если МассивСерий.Количество() = 0 Тогда
		Возврат СоотвПартий;
	КонецЕсли;
	
	МассивВРег = Новый Массив;
	МассивНРег = Новый Массив;
	Для Каждого Эл Из МассивСерий Цикл
		МассивВРег.Добавить(ВРег(Эл));
		МассивНРег.Добавить(НРег(Эл));
	КонецЦикла;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	Партии.Ссылка КАК Партия,
	               |	Партии.Серия КАК Серия,
	               |	Партии.Владелец КАК Номенклатура
	               |ИЗ
	               |	Справочник.Партии КАК Партии
	               |ГДЕ
	               |	НЕ Партии.ПометкаУдаления
	               |	И (Партии.Серия В (&Серии)
	               |			ИЛИ Партии.Серия В (&СерииВРег)
	               |			ИЛИ Партии.Серия В (&СерииНРег))";
	Запрос.УстановитьПараметр("Серии", МассивСерий);
	Запрос.УстановитьПараметр("СерииВРег", МассивВРег);
	Запрос.УстановитьПараметр("СерииНРег", МассивНРег);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Серия = СокрЛП(Выборка.Серия);
		Существующие = СоотвПартий.Получить(Серия);
		Если Существующие = Неопределено Тогда
			СведенияПартии = Новый Структура("Партия, Номенклатура, НесколькоПартий",
				Выборка.Партия, Выборка.Номенклатура, Ложь);
			СоотвПартий.Вставить(Серия, СведенияПартии);
			СоотвПартий.Вставить(ВРег(Серия), СведенияПартии);
			СоотвПартий.Вставить(НРег(Серия), СведенияПартии);
		ИначеЕсли Существующие.Партия <> Выборка.Партия Тогда
			Существующие.НесколькоПартий = Истина;
		КонецЕсли;
	КонецЦикла;
	
	Возврат СоотвПартий;
	
КонецФункции

// Возвращает соответствие серия → сведения партии по остаткам.
//
// Параметры:
//  МассивСерий - Массив из Строка - серии из буфера.
//
// Возвращаемое значение:
//  Соответствие - ключ серия, значение Структура(Партия, Номенклатура, НесколькоПартий).
//
&НаСервереБезКонтекста
Функция СведенияПартийПоОстаткам(МассивСерий)
	
	СоотвПартий = Новый Соответствие;
	Если МассивСерий.Количество() = 0 Тогда
		Возврат СоотвПартий;
	КонецЕсли;
	
	МассивВРег = Новый Массив;
	МассивНРег = Новый Массив;
	Для Каждого Эл Из МассивСерий Цикл
		МассивВРег.Добавить(ВРег(Эл));
		МассивНРег.Добавить(НРег(Эл));
	КонецЦикла;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Рег.Партия КАК Партия,
	|	Рег.Партия.Серия КАК Серия,
	|	Рег.Номенклатура КАК Номенклатура
	|ИЗ
	|	РегистрНакопления.ОстаткиТовара.Остатки(
	|			,
	|			Фирма = &Фирма
	|				И (Партия.Серия В (&Серии)
	|					ИЛИ Партия.Серия В (&СерииВРег)
	|					ИЛИ Партия.Серия В (&СерииНРег))) КАК Рег
	|ГДЕ
	|	Рег.ОстатокОстаток >= 1
	|	И НЕ Рег.Партия.Серия В
	|			(ВЫБРАТЬ
	|				Буфер.Серия
	|			ИЗ
	|				РегистрСведений.БуферСканированияДляОстатков КАК Буфер
	|			ГДЕ
	|				(Буфер.Серия В (&Серии)
	|					ИЛИ Буфер.Серия В (&СерииВРег)
	|					ИЛИ Буфер.Серия В (&СерииНРег)))";
	Запрос.УстановитьПараметр("Серии", МассивСерий);
	Запрос.УстановитьПараметр("СерииВРег", МассивВРег);
	Запрос.УстановитьПараметр("СерииНРег", МассивНРег);
	Запрос.УстановитьПараметр("Фирма", ПараметрыСеанса.Фирма);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Серия = СокрЛП(Выборка.Серия);
		Существующие = СоотвПартий.Получить(Серия);
		Если Существующие = Неопределено Тогда
			СведенияПартии = Новый Структура("Партия, Номенклатура, НесколькоПартий",
				Выборка.Партия, Выборка.Номенклатура, Ложь);
			СоотвПартий.Вставить(Серия, СведенияПартии);
			СоотвПартий.Вставить(ВРег(Серия), СведенияПартии);
			СоотвПартий.Вставить(НРег(Серия), СведенияПартии);
		ИначеЕсли Существующие.Партия <> Выборка.Партия Тогда
			Существующие.НесколькоПартий = Истина;
		КонецЕсли;
	КонецЦикла;
	
	Возврат СоотвПартий;
	
КонецФункции

#КонецОбласти
