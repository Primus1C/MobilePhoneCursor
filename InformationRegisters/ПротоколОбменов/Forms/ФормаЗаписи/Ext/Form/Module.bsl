
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	// Ресурсы ValueStorage недоступны в данных формы (Запись) — читаем отдельно из БД.
	Тексты = ТекстыРесурсовПротокола(Запись.ИдентификаторЗапроса);
	HTMLТекстЗаголовки = HTMLТекстаПротокола(Тексты.Заголовки);
	HTMLТекстТелоЗапроса = HTMLТекстаПротокола(Тексты.ТелоЗапроса);
	HTMLТекстТелоОтвета = HTMLТекстаПротокола(Тексты.ТелоОтвета);
	
КонецПроцедуры

&НаСервере
Функция ТекстыРесурсовПротокола(ИдентификаторЗапроса)
	
	Результат = Новый Структура("Заголовки, ТелоЗапроса, ТелоОтвета", "", "", "");
	
	Если НЕ ЗначениеЗаполнено(ИдентификаторЗапроса) Тогда
		Возврат Результат;
	КонецЕсли;
	
	МенеджерЗаписи = РегистрыСведений.ПротоколОбменов.СоздатьМенеджерЗаписи();
	МенеджерЗаписи.ИдентификаторЗапроса = ИдентификаторЗапроса;
	МенеджерЗаписи.Прочитать();
	
	Если НЕ ЗначениеЗаполнено(МенеджерЗаписи.Дата) Тогда
		Возврат Результат;
	КонецЕсли;
	
	Результат.Заголовки = ТекстИзХранилища(МенеджерЗаписи.ЗаголовкиЗапроса);
	Результат.ТелоЗапроса = ТекстИзХранилища(МенеджерЗаписи.ТелоЗапроса);
	Результат.ТелоОтвета = ТекстИзХранилища(МенеджерЗаписи.ТелоОтвета);
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Функция ТекстИзХранилища(ЗначениеХранилища)
	
	Если НЕ ЗначениеЗаполнено(ЗначениеХранилища) Тогда
		Возврат "";
	КонецЕсли;
	
	Попытка
		Если ТипЗнч(ЗначениеХранилища) = Тип("ХранилищеЗначения") Тогда
			Значение = ЗначениеХранилища.Получить();
		Иначе
			Значение = ЗначениеХранилища;
		КонецЕсли;
		
		Если Значение = Неопределено Тогда
			Возврат "";
		КонецЕсли;
		
		Если ТипЗнч(Значение) = Тип("Строка") Тогда
			Возврат Значение;
		КонецЕсли;
		
		Возврат Строка(Значение);
	Исключение
		Возврат "";
	КонецПопытки;
	
КонецФункции

// Формирует HTML с подсветкой JSON или plain-text для произвольного текста протокола.
//
// Параметры:
//  ИсходныйТекст - Строка - текст из протокола.
//
// Возвращаемое значение:
//  Строка - HTML-документ для поля HTMLDocumentField.
//
&НаСервере
Функция HTMLТекстаПротокола(Знач ИсходныйТекст)
	
	ИсходныйТекст = Строка(ИсходныйТекст);
	Если СокрЛП(ИсходныйТекст) = "" Тогда
		Возврат HTMLОболочкаПротокола("");
	КонецЕсли;
	
	ЗначениеJSON = РазобратьJSONСтроку(ИсходныйТекст);
	Если ЗначениеJSON <> Неопределено Тогда
		Содержимое = ЗначениеJSONВHTML(ЗначениеJSON, 0);
	Иначе
		Содержимое = СтрШаблон("<span class=""json-plain"">%1</span>", ЭкранироватьHTML(ИсходныйТекст));
	КонецЕсли;
	
	Возврат HTMLОболочкаПротокола(Содержимое);
	
КонецФункции

// Пытается разобрать строку как JSON.
//
// Параметры:
//  ТекстJSON - Строка - исходный текст.
//
// Возвращаемое значение:
//  Произвольный, Неопределено - разобранное значение или Неопределено при ошибке.
//
&НаСервере
Функция РазобратьJSONСтроку(Знач ТекстJSON)
	
	ТекстJSON = СокрЛП(ТекстJSON);
	Если ТекстJSON = "" Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ПервыйСимвол = Лев(ТекстJSON, 1);
	Если ПервыйСимвол <> "{" И ПервыйСимвол <> "[" И ПервыйСимвол <> """" Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Попытка
		ЧтениеJSON = Новый ЧтениеJSON;
		ЧтениеJSON.УстановитьСтроку(ТекстJSON);
		Возврат ПрочитатьJSON(ЧтениеJSON);
	Исключение
		Возврат Неопределено;
	КонецПопытки;
	
КонецФункции

// Рекурсивно формирует HTML-представление JSON со стилями.
//
// Параметры:
//  Значение       - Произвольный - значение JSON;
//  УровеньОтступа - Число - уровень вложенности.
//
// Возвращаемое значение:
//  Строка - HTML-фрагмент.
//
&НаСервере
Функция ЗначениеJSONВHTML(Знач Значение, УровеньОтступа)
	
	ТипЗначения = ТипЗнч(Значение);
	
	Если Значение = Неопределено Тогда
		Возврат "<span class=""json-null"">null</span>";
	ИначеЕсли ТипЗначения = Тип("Булево") Тогда
		ТекстБулева = ?(Значение, "true", "false");
		Возврат СтрШаблон("<span class=""json-bool"">%1</span>", ТекстБулева);
	ИначеЕсли ТипЗначения = Тип("Число") Тогда
		Возврат СтрШаблон("<span class=""json-number"">%1</span>", ЧислоJSONСтрокой(Значение));
	ИначеЕсли ТипЗначения = Тип("Строка") Тогда
		Возврат СтрШаблон("<span class=""json-string"">""%1""</span>", ЭкранироватьHTML(Значение));
	ИначеЕсли ТипЗначения = Тип("Массив") Тогда
		Возврат МассивJSONВHTML(Значение, УровеньОтступа);
	ИначеЕсли ТипЗначения = Тип("Структура") Или ТипЗначения = Тип("Соответствие") Тогда
		Возврат ОбъектJSONВHTML(Значение, УровеньОтступа);
	КонецЕсли;
	
	Возврат СтрШаблон("<span class=""json-plain"">%1</span>", ЭкранироватьHTML(Строка(Значение)));
	
КонецФункции

&НаСервере
Функция ОбъектJSONВHTML(Объект, УровеньОтступа)
	
	Отступ = СтрокаJSONОтступ(УровеньОтступа);
	ОтступВложенный = СтрокаJSONОтступ(УровеньОтступа + 1);
	
	Если Объект.Количество() = 0 Тогда
		Возврат "{}";
	КонецЕсли;
	
	Части = Новый Массив;
	Части.Добавить("{");
	
	Индекс = 0;
	Всего = Объект.Количество();
	Для Каждого КлючИЗначение Из Объект Цикл
		
		СтрокаКлюча = СтрШаблон("%1<span class=""json-key"">""%2""</span>: %3",
			ОтступВложенный,
			ЭкранироватьHTML(Строка(КлючИЗначение.Ключ)),
			ЗначениеJSONВHTML(КлючИЗначение.Значение, УровеньОтступа + 1));
		
		Индекс = Индекс + 1;
		Если Индекс < Всего Тогда
			СтрокаКлюча = СтрокаКлюча + ",";
		КонецЕсли;
		
		Части.Добавить(СтрокаКлюча);
		
	КонецЦикла;
	
	Части.Добавить(Отступ + "}");
	Возврат СтрСоединить(Части, Символы.ПС);
	
КонецФункции

&НаСервере
Функция МассивJSONВHTML(МассивЗначений, УровеньОтступа)
	
	Отступ = СтрокаJSONОтступ(УровеньОтступа);
	ОтступВложенный = СтрокаJSONОтступ(УровеньОтступа + 1);
	
	Если МассивЗначений.Количество() = 0 Тогда
		Возврат "[]";
	КонецЕсли;
	
	Части = Новый Массив;
	Части.Добавить("[");
	
	Индекс = 0;
	Всего = МассивЗначений.Количество();
	Для Каждого Элемент Из МассивЗначений Цикл
		
		СтрокаЭлемента = СтрШаблон("%1%2",
			ОтступВложенный,
			ЗначениеJSONВHTML(Элемент, УровеньОтступа + 1));
		
		Индекс = Индекс + 1;
		Если Индекс < Всего Тогда
			СтрокаЭлемента = СтрокаЭлемента + ",";
		КонецЕсли;
		
		Части.Добавить(СтрокаЭлемента);
		
	КонецЦикла;
	
	Части.Добавить(Отступ + "]");
	Возврат СтрСоединить(Части, Символы.ПС);
	
КонецФункции

&НаСервере
Функция ЧислоJSONСтрокой(Знач Число)
	
	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.УстановитьСтроку();
	ЗаписатьJSON(ЗаписьJSON, Число);
	Возврат ЗаписьJSON.Закрыть();
	
КонецФункции

&НаСервере
Функция СтрокаJSONОтступ(УровеньОтступа)
	
	Если УровеньОтступа <= 0 Тогда
		Возврат "";
	КонецЕсли;
	
	Части = Новый Массив;
	Для Номер = 1 По УровеньОтступа Цикл
		Части.Добавить("  ");
	КонецЦикла;
	
	Возврат СтрСоединить(Части, "");
	
КонецФункции

&НаСервере
Функция HTMLОболочкаПротокола(Содержимое)
	
	Части = Новый Массив;
	Части.Добавить("<!DOCTYPE html><html><head><meta charset=""utf-8"">");
	Части.Добавить("<style type=""text/css"">");
	Части.Добавить("body{margin:4px 8px;background:#ffffff;}");
	Части.Добавить("pre.json{margin:0;font-family:Consolas,""Courier New"",monospace;font-size:12px;line-height:1.45;white-space:pre-wrap;word-break:break-word;}");
	Части.Добавить(".json-key{color:#881391;}");
	Части.Добавить(".json-string{color:#0b6125;}");
	Части.Добавить(".json-number{color:#098658;}");
	Части.Добавить(".json-bool{color:#1c00cf;}");
	Части.Добавить(".json-null{color:#808080;}");
	Части.Добавить(".json-plain{color:#1f2933;white-space:pre-wrap;}");
	Части.Добавить("</style></head><body>");
	Части.Добавить("<pre class=""json"">");
	Части.Добавить(Содержимое);
	Части.Добавить("</pre></body></html>");
	
	Возврат СтрСоединить(Части, "");
	
КонецФункции

// Экранирует спецсимволы HTML и переносит строки в &lt;br&gt;.
//
// Параметры:
//  ИсходныйТекст - Строка - исходный текст.
//
// Возвращаемое значение:
//  Строка - текст, безопасный для вставки в HTML.
//
&НаСервере
Функция ЭкранироватьHTML(Знач ИсходныйТекст)
	
	Результат = Строка(ИсходныйТекст);
	Результат = СтрЗаменить(Результат, "&", "&amp;");
	Результат = СтрЗаменить(Результат, "<", "&lt;");
	Результат = СтрЗаменить(Результат, ">", "&gt;");
	Результат = СтрЗаменить(Результат, """", "&quot;");
	Результат = СтрЗаменить(Результат, Символы.ПС, "<br>");
	Результат = СтрЗаменить(Результат, Символы.ВК, "");
	Возврат Результат;
	
КонецФункции
