
&НаКлиенте
Процедура ОтправитьПринудительно(Команда)
	
	ВыделенныеСтроки = Элементы.Список.ВыделенныеСтроки;
	Если ВыделенныеСтроки.Количество() = 0 Тогда
		клПредупреждение(НСтр("ru = 'Не выделено ни одной строки!'; en = 'No rows selected!'"));
		Возврат;
	КонецЕсли;
	
	КлючиЗаписей = Новый Массив;
	Для Каждого КлючЗаписи Из ВыделенныеСтроки Цикл
		КлючиЗаписей.Добавить(КлючЗаписи);
	КонецЦикла;
	
	Результат = ОтправитьПринудительноНаСервере(КлючиЗаписей);
	
	Если Результат.Ошибки <> "" Тогда
		клОшибка(Результат.Ошибки);
	Иначе
		клПредупреждение(СтрШаблон(НСтр("ru = 'Отправлено записей: %1'; en = 'Records sent: %1'"), Результат.Отправлено));
	КонецЕсли;
	
	Элементы.Список.Обновить();
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ОтправитьПринудительноНаСервере(КлючиЗаписей)
	
	ПустаяДата = Дата(1, 1, 1);
	КоличествоОтправлено = 0;
	ТекстыОшибок = "";
	
	Для Каждого КлючЗаписи Из КлючиЗаписей Цикл
		
		Попытка
			
			Набор = РегистрыСведений.ОчередьWebHook.СоздатьНаборЗаписей();
			Набор.Отбор.ИД.Установить(КлючЗаписи.ИД);
			Набор.Отбор.УчетнаяЗапись.Установить(КлючЗаписи.УчетнаяЗапись);
			Набор.Отбор.ТипСобытия.Установить(КлючЗаписи.ТипСобытия);
			Набор.Отбор.Номенклатура.Установить(КлючЗаписи.Номенклатура);
			Набор.Отбор.Склад.Установить(КлючЗаписи.Склад);
			Набор.Отбор.ВидЦены.Установить(КлючЗаписи.ВидЦены);
			Набор.Отбор.Валюта.Установить(КлючЗаписи.Валюта);
			Набор.Отбор.Заказ.Установить(КлючЗаписи.Заказ);
			Набор.Прочитать();
			
			Если Набор.Количество() = 0 Тогда
				Продолжить;
			КонецЕсли;
			
			Запись = Набор[0];
			Запись.Отправлен = ПустаяДата;
			Запись.КоличествоПопыток = 0;
			Запись.ПоследняяПопытка = ПустаяДата;
			Запись.Ошибка = "";
			Набор.Записать(Истина);
			
		Исключение
			ТекстыОшибок = ТекстыОшибок + ОписаниеОшибки() + Символы.ПС;
		КонецПопытки;
		
	КонецЦикла;
	
	Попытка
		StockAPI_Утилиты.ОтправитьОчередьWebHook(КлючиЗаписей.Количество());
	Исключение
		ТекстыОшибок = ТекстыОшибок + ОписаниеОшибки();
	КонецПопытки;
	
	Возврат Новый Структура("Отправлено, Ошибки", КлючиЗаписей.Количество(), СокрЛП(ТекстыОшибок));
	
КонецФункции
