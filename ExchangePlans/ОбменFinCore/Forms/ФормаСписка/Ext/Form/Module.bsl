
// Обновляет очередь узла после изменения регистрации из формы отбора.
//
// Параметры:
//  ИмяСобытия - Строка - имя оповещения;
//  Параметр   - Произвольный - параметр оповещения;
//  Источник   - Произвольный - источник оповещения.
//
&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	Если ИмяСобытия = "ОбменFinCoreИзменениеРегистрации" Тогда
		ОбновитьЗарегистрированныеПоТекущемуУзлу();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	ПодключитьОбработчикОжидания("ОбновитьЗарегистрированныеПоТекущемуУзлу", 0.1, Истина);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьСписок(Команда)
	
	Элементы.Список.Обновить();
	Элементы.ОшибкиОбмена.Обновить();
	ОбновитьЗарегистрированныеПоТекущемуУзлу();
	
КонецПроцедуры

// Запускает выгрузку зарегистрированных изменений в FinCore.
//
&НаКлиенте
Процедура ВыполнитьОбмен(Команда)
	
	Текст = ВыполнитьОбменНаСервере();
	ПоказатьОповещениеПользователя(НСтр("ru = 'Обмен FinCore'"), , Текст);
	Элементы.ОшибкиОбмена.Обновить();
	ОбновитьЗарегистрированныеПоТекущемуУзлу();
	
КонецПроцедуры

// Выполняет обмен FinCore на сервере.
//
// Возвращаемое значение:
//  Строка - итог обмена.
//
&НаСервере
Функция ВыполнитьОбменНаСервере()
	
	Возврат FinCoreОбменHTTP.ВыполнитьОбмен();
	
КонецФункции

&НаКлиенте
Процедура СписокПриАктивизацииСтроки(Элемент)
	
	ПодключитьОбработчикОжидания("ОбновитьЗарегистрированныеПоТекущемуУзлу", 0.1, Истина);
	
КонецПроцедуры

// Перечитывает очередь зарегистрированных объектов текущего узла.
//
// Параметры:
//  Команда - КомандаФормы - команда обновления таблицы зарегистрированных объектов.
//
&НаКлиенте
Процедура ОбновитьЗарегистрированные(Команда)
	
	ОбновитьЗарегистрированныеПоТекущемуУзлу();
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьЗарегистрированныеПоТекущемуУзлу()
	
	УзелОтбора = Элементы.Список.ТекущаяСтрока;
	ОбновитьСписокЗарегистрированныхНаСервере(УзелОтбора);
	
КонецПроцедуры

// Обновляет таблицу зарегистрированных изменений по выбранному узлу.
//
// Параметры:
//  УзелОтбора - ПланОбменаСсылка.FinCore, Неопределено - узел из текущей строки списка.
//
&НаСервере
Процедура ОбновитьСписокЗарегистрированныхНаСервере(УзелОтбора)
	
	ТекущийУзелОтбора = УзелОтбора;
	ЗарегистрированныеОбъекты.Очистить();
	
	Если НЕ ЗначениеЗаполнено(ТекущийУзелОтбора) Тогда
		КоличествоЗарегистрированных = НСтр("ru = 'Выберите узел обмена'");
		Возврат;
	КонецЕсли;
	
	Если ТекущийУзелОтбора = ПланыОбмена.ОбменFinCore.ЭтотУзел() Тогда
		КоличествоЗарегистрированных = НСтр(
			"ru = 'Для «Этот узел» регистрация изменений не ведётся. Выберите или создайте узел-получатель.'");
		Возврат;
	КонецЕсли;
	
	Табл = FinCoreОбмен.ТаблицаЗарегистрированныхИзменений(ТекущийУзелОтбора);
	
	Для Каждого Стр Из Табл Цикл
		НоваяСтрока = ЗарегистрированныеОбъекты.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Стр);
	КонецЦикла;
	
	КоличествоЗарегистрированных = СтрШаблон(
		НСтр("ru = 'Зарегистрированные изменения узла «%1»: %2'"),
		ТекущийУзелОтбора,
		ЗарегистрированныеОбъекты.Количество());
	
КонецПроцедуры

&НаКлиенте
Процедура ЗарегистрированныеОбъектыВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	ТекущиеДанные = Элемент.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ТекущиеДанные.Ссылка) Тогда
		ПоказатьЗначение(, ТекущиеДанные.Ссылка);
	КонецЕсли;
	
КонецПроцедуры

// Открывает объект из строки ошибки обмена.
//
// Параметры:
//  Элемент              - ТаблицаФормы - таблица ошибок;
//  ВыбраннаяСтрока      - Произвольный - идентификатор строки;
//  Поле                 - ПолеФормы - поле, на котором выполнен выбор;
//  СтандартнаяОбработка - Булево - признак стандартной обработки.
//
&НаКлиенте
Процедура ОшибкиОбменаВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	ТекущиеДанные = Элемент.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ТекущиеДанные.Объект) Тогда
		СтандартнаяОбработка = Ложь;
		ПоказатьЗначение(, ТекущиеДанные.Объект);
	КонецЕсли;
	
КонецПроцедуры

// Открывает форму регистрации документов по виду и периоду для текущего узла.
//
// Параметры:
//  Команда - КомандаФормы - команда «Изменить регистрацию».
//
&НаКлиенте
Процедура ИзменитьРегистрацию(Команда)
	
	Узел = Элементы.Список.ТекущаяСтрока;
	Если НЕ ЗначениеЗаполнено(Узел) Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Выберите узел обмена.'"));
		Возврат;
	КонецЕсли;
	
	Если Не УзелДоступенДляРегистрации(Узел) Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Для «Этот узел» регистрация изменений не ведётся. Выберите узел-получатель.'"));
		Возврат;
	КонецЕсли;
	
	ПараметрыФормы = Новый Структура("Узел", Узел);
	ОткрытьФорму("ПланОбмена.ОбменFinCore.Форма.ФормаРегистрации", ПараметрыФормы, ЭтотОбъект);
	
КонецПроцедуры

// Проверяет, что узел не является предопределённым узлом «Этот узел».
//
// Параметры:
//  Узел - ПланОбменаСсылка.ОбменFinCore - выбранный узел.
//
// Возвращаемое значение:
//  Булево - Истина, если на узле можно менять регистрацию.
//
&НаСервереБезКонтекста
Функция УзелДоступенДляРегистрации(Узел)
	
	Возврат ЗначениеЗаполнено(Узел) И Узел <> ПланыОбмена.ОбменFinCore.ЭтотУзел();
	
КонецФункции

// Снимает регистрацию выделенных объектов очереди обмена.
//
// Параметры:
//  Команда - КомандаФормы - команда «Снять регистрацию».
//
&НаКлиенте
Процедура УдалитьРегистрацию(Команда)
	
	Выделенные = Элементы.ЗарегистрированныеОбъекты.ВыделенныеСтроки;
	Если Выделенные.Количество() = 0 Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Выделите строки зарегистрированных объектов.'"));
		Возврат;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ТекущийУзелОтбора) Тогда
		Возврат;
	КонецЕсли;
	
	Если Выделенные.Количество() = 1 Тогда
		ТекстВопроса = НСтр("ru = 'Снять регистрацию выбранного объекта?'");
	Иначе
		ТекстВопроса = СтрШаблон(НСтр("ru = 'Снять регистрацию выбранных объектов (%1)?'"), Выделенные.Количество());
	КонецЕсли;
	
	Оповещение = Новый ОписаниеОповещения("УдалитьРегистрациюПослеВопроса", ЭтотОбъект, Выделенные);
	ПоказатьВопрос(Оповещение, ТекстВопроса, РежимДиалогаВопрос.ДаНет);
	
КонецПроцедуры

// Продолжает снятие регистрации после подтверждения.
//
// Параметры:
//  РезультатВопроса - КодВозвратаДиалога - ответ пользователя;
//  Выделенные       - Массив - идентификаторы строк таблицы ЗарегистрированныеОбъекты.
//
&НаКлиенте
Процедура УдалитьРегистрациюПослеВопроса(РезультатВопроса, Выделенные) Экспорт
	
	Если РезультатВопроса <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	
	Ссылки = Новый Массив;
	Для Каждого ИдентификаторСтроки Из Выделенные Цикл
		СтрокаТаблицы = ЗарегистрированныеОбъекты.НайтиПоИдентификатору(ИдентификаторСтроки);
		Если СтрокаТаблицы = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Если ЗначениеЗаполнено(СтрокаТаблицы.Ссылка) Тогда
			Ссылки.Добавить(СтрокаТаблицы.Ссылка);
		КонецЕсли;
	КонецЦикла;
	
	Если Ссылки.Количество() = 0 Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Не удалось определить объекты для снятия регистрации.'"));
		Возврат;
	КонецЕсли;
	
	УдалитьРегистрациюНаСервере(ТекущийУзелОтбора, Ссылки);
	ОбновитьЗарегистрированныеПоТекущемуУзлу();
	
КонецПроцедуры

// Снимает регистрацию изменений выбранных объектов на узле.
//
// Параметры:
//  Узел   - ПланОбменаСсылка.ОбменFinCore - узел-получатель;
//  Ссылки - Массив из ЛюбаяСсылка - объекты очереди обмена.
//
&НаСервереБезКонтекста
Процедура УдалитьРегистрациюНаСервере(Узел, Ссылки)
	
	Для Каждого СсылкаОбъекта Из Ссылки Цикл
		ПланыОбмена.УдалитьРегистрациюИзменений(Узел, СсылкаОбъекта);
	КонецЦикла;
	
КонецПроцедуры
