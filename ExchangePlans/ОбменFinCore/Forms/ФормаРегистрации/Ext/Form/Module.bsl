
// Заполняет узел и список видов документов из состава плана обмена.
//
// Параметры:
//  Отказ                - Булево - признак отказа от создания формы;
//  СтандартнаяОбработка - Булево - признак стандартной обработки.
//
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Узел = Параметры.Узел;
	РежимРегистрации = "Зарегистрировать";
	ЗаполнитьВидыДокументов();
	
КонецПроцедуры

// Отмечает все виды документов.
//
// Параметры:
//  Команда - КомандаФормы - команда «Установить пометки».
//
&НаКлиенте
Процедура УстановитьПометки(Команда)
	
	УстановитьПометкиВидов(Истина);
	
КонецПроцедуры

// Снимает пометки со всех видов документов.
//
// Параметры:
//  Команда - КомандаФормы - команда «Снять пометки».
//
&НаКлиенте
Процедура СнятьПометки(Команда)
	
	УстановитьПометкиВидов(Ложь);
	
КонецПроцедуры

// Инвертирует пометки всех видов документов.
//
// Параметры:
//  Команда - КомандаФормы - команда «Инвертировать пометки».
//
&НаКлиенте
Процедура ИнвертироватьПометки(Команда)
	
	Для Каждого СтрокаВида Из ВидыДокументов Цикл
		СтрокаВида.Пометка = Не СтрокаВида.Пометка;
	КонецЦикла;
	
КонецПроцедуры

// Устанавливает одинаковую пометку всем строкам списка видов документов.
//
// Параметры:
//  Пометка - Булево - значение пометки.
//
&НаКлиенте
Процедура УстановитьПометкиВидов(Пометка)
	
	Для Каждого СтрокаВида Из ВидыДокументов Цикл
		СтрокаВида.Пометка = Пометка;
	КонецЦикла;
	
КонецПроцедуры

// Регистрирует или снимает регистрацию документов отмеченных видов за период.
//
// Параметры:
//  Команда - КомандаФормы - команда «Выполнить регистрацию».
//
&НаКлиенте
Процедура ВыполнитьРегистрацию(Команда)
	
	Результат = ВыполнитьРегистрациюНаСервере();
	ПоказатьПредупреждение(, Результат.Текст);
	Если Результат.Успех Тогда
		Оповестить("ОбменFinCoreИзменениеРегистрации");
	КонецЕсли;
	
КонецПроцедуры

// Заполняет таблицу видов документов, входящих в состав плана ОбменFinCore.
//
&НаСервере
Процедура ЗаполнитьВидыДокументов()
	
	ВидыДокументов.Очистить();
	
	Для Каждого ЭлементСостава Из Метаданные.ПланыОбмена.ОбменFinCore.Состав Цикл
		МетаданныеОбъекта = ЭлементСостава.Метаданные;
		Если НЕ Метаданные.Документы.Содержит(МетаданныеОбъекта) Тогда
			Продолжить;
		КонецЕсли;
		НоваяСтрока = ВидыДокументов.Добавить();
		НоваяСтрока.Пометка = Истина;
		НоваяСтрока.Имя = МетаданныеОбъекта.Имя;
		НоваяСтрока.Представление = МетаданныеОбъекта.Представление();
	КонецЦикла;
	
	ВидыДокументов.Сортировать("Представление");
	
КонецПроцедуры

// Устанавливает или снимает регистрацию документов по отбору формы.
//
// Возвращаемое значение:
//  Структура - результат операции:
//   * Успех - Булево - Истина, если регистрация изменена;
//   * Текст - Строка - сообщение пользователю.
//
&НаСервере
Функция ВыполнитьРегистрациюНаСервере()
	
	Результат = Новый Структура("Успех, Текст", Ложь, "");
	
	Если НЕ ЗначениеЗаполнено(Узел) ИЛИ Узел = ПланыОбмена.ОбменFinCore.ЭтотУзел() Тогда
		Результат.Текст = НСтр("ru = 'Выберите узел-получатель. Для «Этот узел» регистрация изменений не ведётся.'");
		Возврат Результат;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(НачалоПериода) ИЛИ НЕ ЗначениеЗаполнено(КонецПериода) Тогда
		Результат.Текст = НСтр("ru = 'Укажите начало и конец периода.'");
		Возврат Результат;
	КонецЕсли;
	
	Если НачалоПериода > КонецПериода Тогда
		Результат.Текст = НСтр("ru = 'Начало периода больше конца периода.'");
		Возврат Результат;
	КонецЕсли;
	
	ИменаДокументов = ИменаДокументовПлана();
	СтрокиСообщения = Новый Массив;
	
	Для Каждого СтрокаВида Из ВидыДокументов Цикл
		Если НЕ СтрокаВида.Пометка Тогда
			Продолжить;
		КонецЕсли;
		Представление = ИменаДокументов.Получить(СтрокаВида.Имя);
		Если Представление = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Количество = ИзменитьРегистрациюДокументов(СтрокаВида.Имя, РежимРегистрации = "СнятьРегистрацию");
		СтрокиСообщения.Добавить(СтрШаблон("%1 - %2", Представление, Количество));
	КонецЦикла;
	
	Если СтрокиСообщения.Количество() = 0 Тогда
		Результат.Текст = НСтр("ru = 'Отметьте виды документов.'");
		Возврат Результат;
	КонецЕсли;
	
	Если РежимРегистрации = "СнятьРегистрацию" Тогда
		ЗаголовокСообщения = НСтр("ru = 'Снята регистрация:'");
	Иначе
		ЗаголовокСообщения = НСтр("ru = 'Зарегистрировано:'");
	КонецЕсли;
	
	СтрокиСообщения.Вставить(0, ЗаголовокСообщения);
	Результат.Успех = Истина;
	Результат.Текст = СтрСоединить(СтрокиСообщения, Символы.ПС);
	Возврат Результат;
	
КонецФункции

// Возвращает имена документов из состава плана обмена.
//
// Возвращаемое значение:
//  Соответствие из КлючИЗначение - ключ: имя документа, значение: представление.
//
&НаСервере
Функция ИменаДокументовПлана()
	
	Имена = Новый Соответствие;
	
	Для Каждого ЭлементСостава Из Метаданные.ПланыОбмена.ОбменFinCore.Состав Цикл
		МетаданныеОбъекта = ЭлементСостава.Метаданные;
		Если Метаданные.Документы.Содержит(МетаданныеОбъекта) Тогда
			Имена.Вставить(МетаданныеОбъекта.Имя, МетаданныеОбъекта.Представление());
		КонецЕсли;
	КонецЦикла;
	
	Возврат Имена;
	
КонецФункции

// Регистрирует или снимает регистрацию документов одного вида за период формы.
//
// Параметры:
//  ИмяДокумента         - Строка - имя документа из состава плана обмена;
//  СнятьРегистрациюВида - Булево - Истина, чтобы снять регистрацию.
//
// Возвращаемое значение:
//  Число - количество документов, попавших в отбор.
//
&НаСервере
Функция ИзменитьРегистрациюДокументов(ИмяДокумента, СнятьРегистрациюВида)
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Начало", НачалоДня(НачалоПериода));
	Запрос.УстановитьПараметр("Конец", КонецДня(КонецПериода));
	Запрос.Текст = ТекстЗапросаДокументов(ИмяДокумента);
	
	Ссылки = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
	Если Ссылки.Количество() = 0 Тогда
		Возврат 0;
	КонецЕсли;
	
	Если СнятьРегистрациюВида Тогда
		ПланыОбмена.УдалитьРегистрациюИзменений(Узел, Ссылки);
	Иначе
		ПланыОбмена.ЗарегистрироватьИзменения(Узел, Ссылки);
	КонецЕсли;
	
	Возврат Ссылки.Количество();
	
КонецФункции

// Возвращает текст запроса документов вида за период.
// Имя берётся только из состава плана обмена, проверенного вызывающим кодом.
//
// Параметры:
//  ИмяДокумента - Строка - имя документа метаданных.
//
// Возвращаемое значение:
//  Строка - текст запроса.
//
&НаСервере
Функция ТекстЗапросаДокументов(ИмяДокумента)
	
	Возврат
	"ВЫБРАТЬ
	|	Док.Ссылка КАК Ссылка
	|ИЗ
	|	Документ." + ИмяДокумента + " КАК Док
	|ГДЕ
	|	Док.Дата МЕЖДУ &Начало И &Конец";
	
КонецФункции
