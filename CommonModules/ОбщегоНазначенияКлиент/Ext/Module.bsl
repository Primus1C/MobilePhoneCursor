Процедура УстановитьПараметрВФормеОтчета(ФормаОтчета, ИмяПараметра, Значение) Экспорт
	
	ПараметрКД = Новый ПараметрКомпоновкиДанных(ИмяПараметра);
	
	// Ищем параметр в базовых настройках СКД отчета
	ЭлементНастройки = ФормаОтчета.Отчет.КомпоновщикНастроек.Настройки.ПараметрыДанных.НайтиЗначениеПараметра(ПараметрКД);
	
	Если ЭлементНастройки <> Неопределено Тогда
		ЭлементНастройки.Значение = Значение;
		ЭлементНастройки.Использование = Истина;
		
		// Обязательно проталкиваем в пользовательские настройки, чтобы параметры появились в шапке
		Идентификатор = ЭлементНастройки.ИдентификаторПользовательскойНастройки;
		Если ЗначениеЗаполнено(Идентификатор) Тогда
			ПользНастройка = ФормаОтчета.Отчет.КомпоновщикНастроек.ПользовательскиеНастройки.Элементы.Найти(Идентификатор);
			Если ПользНастройка <> Неопределено Тогда
				ПользНастройка.Значение = Значение;
				ПользНастройка.Использование = Истина;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

Процедура ВывестиОшибки(СписокОшибок, Отказ) Экспорт

	Если СписокОшибок.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;  
	
	ТекстОшибки = "";
	Для каждого ош Из СписокОшибок Цикл                                      
		ТекстОшибки = ТекстОшибки + ош.Значение + "<br>";
	КонецЦикла;  
	Отказ = Истина;
	клОшибка(Новый ФорматированнаяСтрока(ОбщегоНазначенияСервер.ТекстHTMLВФорматированнуюСтроку(ТекстОшибки)), , , , ,);

КонецПроцедуры


#Область ДоступностьРедактирванияДокументов
	
Процедура УстановитьДоступность(Элементы, Окончательно) Экспорт

	Для каждого Элемент Из Элементы Цикл 
		Тип = ТипЗнч(Элемент);
		Если Тип = Тип("ПолеФормы") ИЛИ Тип = Тип("ТаблицаФормы") Тогда
			Элемент.ТолькоПросмотр = Окончательно; 
		ИначеЕсли Тип = Тип("КнопкаФормы") И Элемент.Родитель <> Элементы.ФормаКоманднаяПанель И  Элемент.Родитель.Имя <> "МенюПечать" Тогда
			Если Элемент.Имя = "ИзменитьПримечание" Или Элемент.Имя = "КнопкаИзменитьДату" Тогда
				Продолжить;
			КонецЕсли;
			Элемент.Доступность = НЕ Окончательно;
		КонецЕсли;
	КонецЦикла;	    
	Если Элементы.Найти("Снять") <> Неопределено Тогда
		Элементы.Снять.Доступность = Окончательно;
	КонецЕсли;
	Если Элементы.Найти("Установить") <> Неопределено Тогда
		Элементы.Установить.Доступность = НЕ Окончательно;
	КонецЕсли;
	Элементы.Окончательно.ТолькоПросмотр = Истина;
	
КонецПроцедуры

// Настраивает доступность элементов формы документа по закрытому периоду и признаку «Окончательно».
//
// Логика:
// 1. Всегда сбрасывает Форма.ТолькоПросмотр в Ложь — управление только свойствами элементов
//    (поля/таблицы — ТолькоПросмотр, кнопки — Доступность).
// 2. Если одновременно заполнены ДоступныеЭлементы и НедоступныеЭлементы — ошибка вызова.
// 3. Закрытый период (ДатаДокумента <= дата запрета редактирования): игнорируются
//    ДоступныеЭлементы, НедоступныеЭлементы и Окончательно; все элементы недоступны,
//    кроме переданных в ДоступныВЗакрытомПериоде (с учётом потомков разрешённого родителя).
//    Кнопка «ИзменитьПримечание» (если есть) включается автоматически.
//    Кнопки «Установить» и «Снять» (если есть) недоступны.
// 4. Открытый период:
//    - Окончательно = Истина — все недоступны, кроме ДоступныеЭлементы (+ потомки);
//      «ИзменитьПримечание» включается автоматически;
//    - Окончательно = Ложь — все доступны, кроме НедоступныеЭлементы (+ потомки);
//    - Окончательно = Неопределено (документы без реквизита) — массивы Доступные/Недоступные
//      не применяются (штатно оба Неопределено); все элементы доступны.
//    Кнопки «Установить»/«Снять»: при Окончательно = Истина доступна только «Снять»,
//    при Окончательно = Ложь — только «Установить»; при Неопределено особая логика не применяется.
// 5. Поле «Окончательно» (если есть) всегда ТолькоПросмотр.
//
// Параметры:
//  Форма                     - ФормаКлиентскогоПриложения - форма документа;
//  ДатаДокумента             - Дата - дата документа для сравнения с датой запрета;
//  ДоступныеЭлементы         - Массив, Неопределено - элементы, доступные при Окончательно = Истина;
//  НедоступныеЭлементы       - Массив, Неопределено - элементы, недоступные при Окончательно = Ложь;
//  ДоступныВЗакрытомПериоде  - Массив, Неопределено - элементы, доступные в закрытом периоде;
//  Окончательно              - Булево, Неопределено - значение реквизита документа; Неопределено —
//                              если реквизита нет.
//
Процедура НастроитьДоступностьЭлементовФормыДокумента(Форма, ДатаДокумента,
	ДоступныеЭлементы = Неопределено, НедоступныеЭлементы = Неопределено,
	ДоступныВЗакрытомПериоде = Неопределено, Окончательно = Неопределено) Экспорт
	
	Если ДоступныеЭлементы <> Неопределено И НедоступныеЭлементы <> Неопределено Тогда
		клОшибка(НСтр("ru = 'Неверные параметры процедуры НастроитьДоступностьЭлементовФормыДокумента. Обратитесь к разработчику'"));
		Возврат;
	КонецЕсли;
	
	Форма.ТолькоПросмотр = Ложь;
	
	ЭлементыФормы = Форма.Элементы;
	ПериодЗакрыт = ПериодЗакрытПоДатеДокумента(ДатаДокумента);
	
	Если ПериодЗакрыт Тогда
		
		Разрешенные = СоответствиеЭлементовПоИменам(ДоступныВЗакрытомПериоде);
		ПрименитьДоступностьПоСпискуРазрешенных(ЭлементыФормы, Разрешенные);
		НастроитьКнопкуИзменитьПримечание(ЭлементыФормы, Истина);
		НастроитьКнопкиУстановитьСнять(ЭлементыФормы, Неопределено, Истина);
		УстановитьТолькоПросмотрПоляОкончательно(ЭлементыФормы);
		Возврат;
		
	КонецЕсли;
	
	Если Окончательно = Истина Тогда
		
		Разрешенные = СоответствиеЭлементовПоИменам(ДоступныеЭлементы);
		ПрименитьДоступностьПоСпискуРазрешенных(ЭлементыФормы, Разрешенные);
		НастроитьКнопкуИзменитьПримечание(ЭлементыФормы, Истина);
		НастроитьКнопкиУстановитьСнять(ЭлементыФормы, Истина, Ложь);
		
	ИначеЕсли Окончательно = Ложь Тогда
		
		Запрещенные = СоответствиеЭлементовПоИменам(НедоступныеЭлементы);
		ПрименитьДоступностьПоСпискуЗапрещенных(ЭлементыФормы, Запрещенные);
		НастроитьКнопкуИзменитьПримечание(ЭлементыФормы, Ложь);
		НастроитьКнопкиУстановитьСнять(ЭлементыФормы, Ложь, Ложь);
		
	Иначе
		// Реквизита Окончательно нет: массивы Доступные/Недоступные не используются.
		ПрименитьДоступностьВсемЭлементам(ЭлементыФормы, Истина);
		НастроитьКнопкуИзменитьПримечание(ЭлементыФормы, Ложь);
	КонецЕсли;
	
	УстановитьТолькоПросмотрПоляОкончательно(ЭлементыФормы);
	
КонецПроцедуры

// Проверяет, что дата документа входит в закрытый период.
//
// Параметры:
//  ДатаДокумента - Дата
//
// Возвращаемое значение:
//  Булево
//
Функция ПериодЗакрытПоДатеДокумента(ДатаДокумента)
	
	лДатаЗапрета = гоПараметрСеанса("ДатаЗапретаРедактирования");
	Если лДатаЗапрета = Дата(1, 1, 1) Или ДатаДокумента = Дата(1, 1, 1) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Возврат ДатаДокумента <= КонецДня(лДатаЗапрета);
	
КонецФункции

// Строит соответствие Имя → Истина по массиву элементов формы.
//
// Параметры:
//  МассивЭлементов - Массив, Неопределено
//
// Возвращаемое значение:
//  Соответствие
//
Функция СоответствиеЭлементовПоИменам(МассивЭлементов)
	
	Результат = Новый Соответствие;
	Если МассивЭлементов = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	
	Для Каждого Элемент Из МассивЭлементов Цикл
		Если Элемент = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Результат.Вставить(Элемент.Имя, Истина);
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// Истина, если элемент или один из его родителей есть в соответствии имён.
//
// Параметры:
//  ЭлементФормы   - ЭлементФормы;
//  СписокПоИменам - Соответствие
//
// Возвращаемое значение:
//  Булево
//
Функция ЭлементИлиПредокВСписке(ЭлементФормы, СписокПоИменам)
	
	Если СписокПоИменам.Количество() = 0 Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Текущий = ЭлементФормы;
	Пока Текущий <> Неопределено Цикл
		
		Попытка
			ИмяЭлемента = Текущий.Имя;
		Исключение
			Прервать;
		КонецПопытки;
		
		Если СписокПоИменам.Получить(ИмяЭлемента) <> Неопределено Тогда
			Возврат Истина;
		КонецЕсли;
		
		Попытка
			Текущий = Текущий.Родитель;
		Исключение
			Прервать;
		КонецПопытки;
		
	КонецЦикла;
	
	Возврат Ложь;
	
КонецФункции

// Устанавливает доступность одного элемента формы.
//
// Параметры:
//  ЭлементФормы - ЭлементФормы;
//  Доступен     - Булево
//
Процедура УстановитьДоступностьЭлементаФормы(ЭлементФормы, Доступен)
	
	ТипЭлемента = ТипЗнч(ЭлементФормы);
	
	Если ТипЭлемента = Тип("ПолеФормы") Или ТипЭлемента = Тип("ТаблицаФормы") Тогда
		ЭлементФормы.ТолькоПросмотр = Не Доступен;
	ИначеЕсли ТипЭлемента = Тип("КнопкаФормы") Тогда
		ЭлементФормы.Доступность = Доступен;
	ИначеЕсли ТипЭлемента = Тип("ГруппаФормы") Тогда
		Попытка
			ЭлементФормы.ТолькоПросмотр = Не Доступен;
		Исключение
			// у группы может не быть свойства ТолькоПросмотр
		КонецПопытки;
	КонецЕсли;
	
КонецПроцедуры

// Все недоступны, кроме разрешённых (и их потомков).
//
// Параметры:
//  ЭлементыФормы         - ЭлементыФормы;
//  РазрешенныеПоИменам   - Соответствие
//
Процедура ПрименитьДоступностьПоСпискуРазрешенных(ЭлементыФормы, РазрешенныеПоИменам)
	
	Для Каждого ЭлементФормы Из ЭлементыФормы Цикл
		
		Если ЭлементФормы.Имя = "Установить" Или ЭлементФормы.Имя = "Снять"
			Или ЭлементФормы.Имя = "ИзменитьПримечание" Или ЭлементФормы.Имя = "КнопкаИзменитьДату"
			Или ЭлементФормы.Имя = "Окончательно" Или ЭлементФормы.Имя = "ГруппаДатаИзменить" Тогда
			Продолжить;
		КонецЕсли;
		
		Доступен = ЭлементИлиПредокВСписке(ЭлементФормы, РазрешенныеПоИменам);
		УстановитьДоступностьЭлементаФормы(ЭлементФормы, Доступен);
		
	КонецЦикла;
	
КонецПроцедуры

// Все доступны, кроме запрещённых (и их потомков).
//
// Параметры:
//  ЭлементыФормы         - ЭлементыФормы;
//  ЗапрещенныеПоИменам   - Соответствие
//
Процедура ПрименитьДоступностьПоСпискуЗапрещенных(ЭлементыФормы, ЗапрещенныеПоИменам)
	
	Для Каждого ЭлементФормы Из ЭлементыФормы Цикл
		
		Если ЭлементФормы.Имя = "Установить" Или ЭлементФормы.Имя = "Снять"
			Или ЭлементФормы.Имя = "ИзменитьПримечание" Или ЭлементФормы.Имя = "КнопкаИзменитьДату"
			Или ЭлементФормы.Имя = "Окончательно" Или ЭлементФормы.Имя = "ГруппаДатаИзменить" Тогда
			Продолжить;
		КонецЕсли;
		
		Доступен = Не ЭлементИлиПредокВСписке(ЭлементФормы, ЗапрещенныеПоИменам);
		УстановитьДоступностьЭлементаФормы(ЭлементФормы, Доступен);
		
	КонецЦикла;
	
КонецПроцедуры

// Выставляет одинаковую доступность всем управляемым элементам.
//
// Параметры:
//  ЭлементыФормы - ЭлементыФормы;
//  Доступен      - Булево
//
Процедура ПрименитьДоступностьВсемЭлементам(ЭлементыФормы, Доступен)
	
	Для Каждого ЭлементФормы Из ЭлементыФормы Цикл
		
		Если ЭлементФормы.Имя = "Установить" Или ЭлементФормы.Имя = "Снять"
			Или ЭлементФормы.Имя = "ИзменитьПримечание" Или ЭлементФормы.Имя = "КнопкаИзменитьДату"
			Или ЭлементФормы.Имя = "Окончательно" Или ЭлементФормы.Имя = "ГруппаДатаИзменить" Тогда
			Продолжить;
		КонецЕсли;
		
		УстановитьДоступностьЭлементаФормы(ЭлементФормы, Доступен);
		
	КонецЦикла;
	
КонецПроцедуры

// Включает или скрывает кнопку изменения примечания, если она есть на форме.
//
// Параметры:
//  ЭлементыФормы - ЭлементыФормы;
//  Включить      - Булево
//
Процедура НастроитьКнопкуИзменитьПримечание(ЭлементыФормы, Включить)
	
	Кнопка = ЭлементыФормы.Найти("ИзменитьПримечание");
	Если Кнопка = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Кнопка.Видимость = Включить;
	Кнопка.Доступность = Включить;
	
КонецПроцедуры

// Особая логика кнопок Установить/Снять.
//
// Параметры:
//  ЭлементыФормы - ЭлементыФормы;
//  Окончательно  - Булево, Неопределено - значение реквизита; Неопределено при закрытом периоде
//                  или отсутствии реквизита;
//  ПериодЗакрыт  - Булево
//
Процедура НастроитьКнопкиУстановитьСнять(ЭлементыФормы, Окончательно, ПериодЗакрыт)
	
	КнопкаУстановить = ЭлементыФормы.Найти("Установить");
	КнопкаСнять = ЭлементыФормы.Найти("Снять");
	
	Если ПериодЗакрыт Тогда
		Если КнопкаУстановить <> Неопределено Тогда
			КнопкаУстановить.Доступность = Ложь;
		КонецЕсли;
		Если КнопкаСнять <> Неопределено Тогда
			КнопкаСнять.Доступность = Ложь;
		КонецЕсли;
		Возврат;
	КонецЕсли;
	
	Если Окончательно = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если КнопкаУстановить <> Неопределено Тогда
		КнопкаУстановить.Доступность = Не Окончательно;
	КонецЕсли;
	Если КнопкаСнять <> Неопределено Тогда
		КнопкаСнять.Доступность = Окончательно;
	КонецЕсли;
	
КонецПроцедуры

// Поле «Окончательно» всегда только просмотр.
//
// Параметры:
//  ЭлементыФормы - ЭлементыФормы
//
Процедура УстановитьТолькоПросмотрПоляОкончательно(ЭлементыФормы)
	
	Поле = ЭлементыФормы.Найти("Окончательно");
	Если Поле <> Неопределено Тогда
		Поле.ТолькоПросмотр = Истина;
	КонецЕсли;
	
КонецПроцедуры

// Проверяет, что дата документа в закрытом периоде (клиент).
//
// Параметры:
//  ДатаДокумента - Дата
//
// Возвращаемое значение:
//  Булево
//
Функция ПериодДокументаЗакрытНаКлиенте(ДатаДокумента) Экспорт
	
	Возврат ПериодЗакрытПоДатеДокумента(ДатаДокумента);
	
КонецФункции

// Документ недоступен для редактирования (период, Окончательно или прочие причины).
//
// Параметры:
//  ДатаДокумента                 - Дата;
//  Окончательно                  - Булево;
//  ЗаблокированПоПрочимПричинам  - Булево
//
// Возвращаемое значение:
//  Булево
//
Функция ДокументЗаблокированДляРедактированияНаКлиенте(ДатаДокумента, Окончательно, ЗаблокированПоПрочимПричинам) Экспорт
	
	Возврат ПериодДокументаЗакрытНаКлиенте(ДатаДокумента)
		Или Окончательно
		Или ЗаблокированПоПрочимПричинам;
	
КонецФункции

// Элементы панелей просмотра формы и табличных частей (без самих таблиц).
//
// Параметры:
//  ЭлементыФормы          - ЭлементыФормы;
//  ИменаТабличныхЧастей   - Массив из Строка — префиксы имён ТЧ;
//  ВключатьПанельФормы    - Булево — добавить ФормаКоманднаяПанель
//
// Возвращаемое значение:
//  Массив
//
Функция МассивЭлементовПанелейПросмотраДокумента(ЭлементыФормы, ИменаТабличныхЧастей,
	ВключатьПанельФормы = Истина, ДополнительныеИменаЭлементов = Неопределено) Экспорт
	
	Результат = Новый Массив;
	
	Если ВключатьПанельФормы Тогда
		ЭлементФормы = ЭлементыФормы.Найти("ФормаКоманднаяПанель");
		Если ЭлементФормы <> Неопределено Тогда
			Результат.Добавить(ЭлементФормы);
		КонецЕсли;
	КонецЕсли;
	
	Суффиксы = СтрРазделить("КоманднаяПанель,КонтекстноеМеню,СтрокаПоиска,УправлениеПоиском", ",");
	
	Для Каждого ПрефиксТЧ Из ИменаТабличныхЧастей Цикл
		Для Каждого Суффикс Из Суффиксы Цикл
			ЭлементФормы = ЭлементыФормы.Найти(ПрефиксТЧ + Суффикс);
			Если ЭлементФормы <> Неопределено Тогда
				Результат.Добавить(ЭлементФормы);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
	Если ДополнительныеИменаЭлементов <> Неопределено Тогда
		Для Каждого ИмяЭлемента Из ДополнительныеИменаЭлементов Цикл
			ЭлементФормы = ЭлементыФормы.Найти(ИмяЭлемента);
			Если ЭлементФормы <> Неопределено Тогда
				Результат.Добавить(ЭлементФормы);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Имена команд записи и проведения на панели формы документа.
//
// Возвращаемое значение:
//  Массив
//
Функция ИменаКомандЗаписиПроведенияДокумента() Экспорт
	
	Результат = Новый Массив;
	Результат.Добавить("ФормаЗаписать");
	Результат.Добавить("ФормаПровести");
	Результат.Добавить("ФормаПровестиИЗакрыть");
	
	Возврат Результат;
	
КонецФункции

// Включает команды записи и проведения на панели формы документа.
//
// Параметры:
//  ЭлементыФормы - ЭлементыФормы
//
Процедура ВключитьКомандыЗаписиПроведенияДокумента(ЭлементыФормы) Экспорт
	
	УстановитьДоступностьКнопокПоИменам(ЭлементыФормы, ИменаКомандЗаписиПроведенияДокумента(), Истина);
	
КонецПроцедуры

// Стандартные команды жизненного цикла документа на панели формы.
//
// Параметры:
//  Дополнительные - Массив, Неопределено
//
// Возвращаемое значение:
//  Массив
//
Функция СтандартныеИменаЗапрещенныхКомандЖизненногоЦиклаДокумента(Дополнительные = Неопределено) Экспорт
	
	Результат = Новый Массив;
	Результат.Добавить("ФормаЗаписать");
	Результат.Добавить("ФормаЗаписатьИЗакрыть");
	Результат.Добавить("ФормаПровести");
	Результат.Добавить("ФормаПровестиИЗакрыть");
	Результат.Добавить("ФормаОтменаПроведения");
	Результат.Добавить("ФормаУстановитьПометкуУдаления");
	Результат.Добавить("ФормаУдалить");
	
	Если Дополнительные <> Неопределено Тогда
		Для Каждого ИмяКнопки Из Дополнительные Цикл
			Результат.Добавить(ИмяКнопки);
		КонецЦикла;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Стандартные команды редактирования табличной части (панель и контекстное меню).
//
// Параметры:
//  ПрефиксТЧ       - Строка;
//  Дополнительные  - Массив, Неопределено
//
// Возвращаемое значение:
//  Массив
//
Функция СтандартныеИменаЗапрещенныхКомандТабличнойЧасти(ПрефиксТЧ, Дополнительные = Неопределено) Экспорт
	
	Результат = Новый Массив;
	Результат.Добавить(ПрефиксТЧ + "Добавить");
	Результат.Добавить(ПрефиксТЧ + "Скопировать");
	Результат.Добавить(ПрефиксТЧ + "Изменить");
	Результат.Добавить(ПрефиксТЧ + "Удалить");
	Результат.Добавить(ПрефиксТЧ + "ПереместитьВверх");
	Результат.Добавить(ПрефиксТЧ + "ПереместитьВниз");
	Результат.Добавить(ПрефиксТЧ + "КонтекстноеМенюДобавить");
	Результат.Добавить(ПрефиксТЧ + "КонтекстноеМенюСкопировать");
	Результат.Добавить(ПрефиксТЧ + "КонтекстноеМенюИзменить");
	Результат.Добавить(ПрефиксТЧ + "КонтекстноеМенюУдалить");
	
	Если Дополнительные <> Неопределено Тогда
		Для Каждого ИмяКнопки Из Дополнительные Цикл
			Результат.Добавить(ИмяКнопки);
		КонецЦикла;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Команды контекстного меню ТЧ: копирование в буфер и поиск.
//
// Параметры:
//  ПрефиксТЧ - Строка
//
// Возвращаемое значение:
//  Массив
//
Функция СтандартныеИменаКомандКопированияИПоискаТабличнойЧасти(ПрефиксТЧ) Экспорт
	
	Результат = Новый Массив;
	Результат.Добавить(ПрефиксТЧ + "КонтекстноеМенюКопироватьВБуферОбмена");
	Результат.Добавить(ПрефиксТЧ + "КонтекстноеМенюНайти");
	Результат.Добавить(ПрефиксТЧ + "КонтекстноеМенюОтменитьПоиск");
	Результат.Добавить(ПрефиксТЧ + "КонтекстноеМенюПоискПоТекущемуЗначению");
	Результат.Добавить(ПрефиксТЧ + "КонтекстноеМенюВыделитьВсе");
	
	Возврат Результат;
	
КонецФункции

// Собирает имена запрещённых команд редактирования документа и его ТЧ.
//
// Параметры:
//  ИменаТабличныхЧастей - Массив;
//  ДопЗапрещенные      - Массив, Неопределено
//
// Возвращаемое значение:
//  Массив
//
Функция СобратьИменаЗапрещенныхКомандРедактированияДокумента(ИменаТабличныхЧастей,
	ДопЗапрещенные = Неопределено, ДопЗапрещенныеЖизненногоЦикла = Неопределено) Экспорт
	
	Результат = СтандартныеИменаЗапрещенныхКомандЖизненногоЦиклаДокумента(ДопЗапрещенныеЖизненногоЦикла);
	
	Для Каждого ПрефиксТЧ Из ИменаТабличныхЧастей Цикл
		Для Каждого ИмяКнопки Из СтандартныеИменаЗапрещенныхКомандТабличнойЧасти(ПрефиксТЧ) Цикл
			Результат.Добавить(ИмяКнопки);
		КонецЦикла;
	КонецЦикла;
	
	Если ДопЗапрещенные <> Неопределено Тогда
		Для Каждого ИмяКнопки Из ДопЗапрещенные Цикл
			Результат.Добавить(ИмяКнопки);
		КонецЦикла;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Собирает имена разрешённых команд копирования и поиска для нескольких ТЧ.
//
// Параметры:
//  ИменаТабличныхЧастей - Массив
//
// Возвращаемое значение:
//  Массив
//
Функция СобратьИменаКомандКопированияИПоискаТабличныхЧастей(ИменаТабличныхЧастей) Экспорт
	
	Результат = Новый Массив;
	
	Для Каждого ПрефиксТЧ Из ИменаТабличныхЧастей Цикл
		Для Каждого ИмяКнопки Из СтандартныеИменаКомандКопированияИПоискаТабличнойЧасти(ПрефиксТЧ) Цикл
			Результат.Добавить(ИмяКнопки);
		КонецЦикла;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// Устанавливает доступность кнопок по списку имён.
//
// Параметры:
//  ЭлементыФормы  - ЭлементыФормы;
//  ИменаКнопок    - Массив;
//  Доступность    - Булево
//
Процедура УстановитьДоступностьКнопокПоИменам(ЭлементыФормы, ИменаКнопок, Доступность) Экспорт
	
	Для Каждого ИмяКнопки Из ИменаКнопок Цикл
		Кнопка = ЭлементыФормы.Найти(ИмяКнопки);
		Если Кнопка <> Неопределено Тогда
			Кнопка.Доступность = Доступность;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

// Отключает команды Установить и Снять.
//
// Параметры:
//  ЭлементыФормы - ЭлементыФормы
//
Процедура ОтключитьКнопкиУстановитьСнять(ЭлементыФормы) Экспорт
	
	Кнопка = ЭлементыФормы.Найти("Установить");
	Если Кнопка <> Неопределено Тогда
		Кнопка.Доступность = Ложь;
	КонецЕсли;
	Кнопка = ЭлементыФормы.Найти("Снять");
	Если Кнопка <> Неопределено Тогда
		Кнопка.Доступность = Ложь;
	КонецЕсли;
	
КонецПроцедуры

// Отключает запись/проведение и команды редактирования ТЧ при блокировке документа.
// Копирование в буфер и поиск в контекстном меню остаются доступны.
//
// Параметры:
//  ЭлементыФормы         - ЭлементыФормы;
//  ИменаТабличныхЧастей  - Массив;
//  ДопЗапрещенные        - Массив, Неопределено
//
Процедура ОтключитьКомандыРедактированияДокумента(ЭлементыФормы, ИменаТабличныхЧастей,
	ДопЗапрещенные = Неопределено, ДопЗапрещенныеЖизненногоЦикла = Неопределено) Экспорт
	
	ИменаЗапрещенных = СобратьИменаЗапрещенныхКомандРедактированияДокумента(
		ИменаТабличныхЧастей, ДопЗапрещенные, ДопЗапрещенныеЖизненногоЦикла);
	УстановитьДоступностьКнопокПоИменам(ЭлементыФормы, ИменаЗапрещенных, Ложь);
	
	ИменаРазрешенных = СобратьИменаКомандКопированияИПоискаТабличныхЧастей(ИменаТабличныхЧастей);
	УстановитьДоступностьКнопокПоИменам(ЭлементыФормы, ИменаРазрешенных, Истина);
	
КонецПроцедуры

// Включает на панелях формы и ТЧ команды, не ведущие к записи, проведению и правке данных
// (отчёты, общие команды, печать, поиск, копирование в буфер и т.п.).
// Сбрасывает Форма.ТолькоПросмотр — иначе платформа блокирует команды целиком.
//
// Параметры:
//  Форма                            - ФормаКлиентскогоПриложения;
//  ИменаТабличныхЧастей             - Массив;
//  ДопЗапрещенные                   - Массив, Неопределено;
//  ВключатьПанельФормы              - Булево;
//  ДопЗапрещенныеЖизненногоЦикла    - Массив, Неопределено;
//  ДополнительныеИменаЭлементовПанелейПросмотра - Массив, Неопределено.
//
Процедура ВключитьКомандыПросмотраНаПанеляхДокумента(Форма, ИменаТабличныхЧастей,
	ДопЗапрещенные = Неопределено, ВключатьПанельФормы = Истина,
	ДопЗапрещенныеЖизненногоЦикла = Неопределено, ДополнительныеИменаЭлементовПанелейПросмотра = Неопределено) Экспорт
	
	ЭлементыФормы = Форма.Элементы;
	Форма.ТолькоПросмотр = Ложь;
	
	ПанелиПросмотра = МассивЭлементовПанелейПросмотраДокумента(
		ЭлементыФормы, ИменаТабличныхЧастей, ВключатьПанельФормы, ДополнительныеИменаЭлементовПанелейПросмотра);
	РазрешенныеПанели = СоответствиеЭлементовПоИменам(ПанелиПросмотра);
	
	Запрещенные = Новый Соответствие;
	Для Каждого ИмяКнопки Из СобратьИменаЗапрещенныхКомандРедактированияДокумента(
		ИменаТабличныхЧастей, ДопЗапрещенные, ДопЗапрещенныеЖизненногоЦикла) Цикл
		Запрещенные.Вставить(ИмяКнопки, Истина);
	КонецЦикла;
	
	Для Каждого Панель Из ПанелиПросмотра Цикл
		УстановитьДоступностьЭлементаФормы(Панель, Истина);
	КонецЦикла;
	
	Для Каждого ЭлементФормы Из ЭлементыФормы Цикл
		
		Если НЕ ЭлементИлиПредокВСписке(ЭлементФормы, РазрешенныеПанели) Тогда
			Продолжить;
		КонецЕсли;
		
		ТипЭлемента = ТипЗнч(ЭлементФормы);
		
		Если ТипЭлемента = Тип("КнопкаФормы") Тогда
			
			Если Запрещенные.Получить(ЭлементФормы.Имя) <> Неопределено Тогда
				Продолжить;
			КонецЕсли;
			
			ЭлементФормы.Доступность = Истина;
			
		ИначеЕсли ТипЭлемента <> Тип("ПолеФормы") И ТипЭлемента <> Тип("ТаблицаФормы") Тогда
			
			УстановитьДоступностьЭлементаФормы(ЭлементФормы, Истина);
			
		КонецЕсли;
		
	КонецЦикла;
	
	ИменаРазрешенных = СобратьИменаКомандКопированияИПоискаТабличныхЧастей(ИменаТабличныхЧастей);
	УстановитьДоступностьКнопокПоИменам(ЭлементыФормы, ИменаРазрешенных, Истина);
	
КонецПроцедуры

// =============================================================================
// ДОСТУПНОСТЬ ФОРМ ДОКУМЕНТОВ (для разработчиков)
// =============================================================================
//
// Общее правило: при любой блокировке редактирования (закрытый период, «Окончательно»,
// оплата/привязки и т.п.) должны оставаться доступны команды, которые не ведут к записи,
// проведению, отмене проведения, пометке удаления и изменению данных документа/ТЧ.
// К ним относятся отчёты, общие команды, печать, поиск, копирование строк в буфер.
//
// Точка входа для типовых накладных и аналогичных форм:
//   НастроитьДоступностьДокументаПоОкончательноИПериоду(...)
// или
//   Параметры = НовыеПараметрыДоступностиФормыДокумента();
//   ... заполнить поля ...
//   НастроитьДоступностьФормыДокумента(Параметры);
//
// Параметры формы документа:
//   ИменаТабличныхЧастей — префиксы имён ТЧ (например «Товары», «Затраты»);
//     по ним собираются панели {Префикс}КоманднаяПанель, КонтекстноеМеню, СтрокаПоиска,
//     УправлениеПоиском плюс ФормаКоманднаяПанель;
//   ДопЗапрещенныеКоманды — имена кнопок редактирования, специфичные для документа
//     (массовое удаление, вставка из буфера, установка цены и т.д.);
//   ДопЗапрещенныеКомандыЖизненногоЦикла — доп. команды записи/проведения на панели формы;
//   ДополнительныеИменаЭлементовПанелейПросмотра — нестандартные панели (напр. СтрокаПоискаТовары);
//   ЗаблокированПоПрочимПричинам — оплата, привязки, основание и пр. (см. форму документа);
//   ДоступныКомандыЗаписиПроведенияПриОкончательно — в открытом периоде при «Окончательно»
//     оставить Записать/Провести/ПровестиИЗакрыть (накладные с привязками);
//   ВсегдаДоступныКомандыПросмотра — по умолчанию Истина; включает команды просмотра
//     на панелях после блокировки (сбрасывает Форма.ТолькоПросмотр).
//
// Стандартно отключаются (см. СобратьИменаЗапрещенныхКомандРедактированияДокумента):
//   ФормаЗаписать, ФормаЗаписатьИЗакрыть, ФормаПровести, ФормаПровестиИЗакрыть,
//   ФормаОтменаПроведения, ФормаУстановитьПометкуУдаления, ФормаУдалить;
//   для каждой ТЧ: Добавить, Скопировать, Изменить, Удалить, Переместить*, контекстное меню.
//
// Кнопки «Установить» / «Снять» (реквизит «Окончательно») настраиваются отдельно
// (НастроитьКнопкиУстановитьСнять): в закрытом периоде недоступны; в открытом при
// «Окончательно» доступна «Снять» для возврата документа в редактирование.
//
// Команды вне панелей формы/ТЧ (шапка, группы на форме) этим API не «разблокируются» —
// ими управляет форма документа.
//
// Пример (расходная/приходная накладная):
//   ИменаТЧ = Новый Массив; ИменаТЧ.Добавить("Товары");
//   ОбщегоНазначенияКлиент.НастроитьДоступностьДокументаПоОкончательноИПериоду(
//       ЭтаФорма, Объект.Дата, Объект.Окончательно, ИменаТЧ,
//       ДокументЗаблокированПоПрочимПричинамНаКлиенте(),
//       ДопЗапрещенныеКомандыДокумента(), Истина, Ложь, Истина);
//
// Исключение: документ «ДвижениеДенег» не использует НастроитьДоступностьФормыДокумента.
// Там своя схема: НастроитьДоступностьЭлементовФормыДокумента с разными белыми списками
// для вида движения (оплата контрагента / прочие) и ОтключитьКомандыРедактированияНаПанелиФормы
// с частичным запретом записи/проведения. При доработках ДвижениеДенег не переводить
// на универсальную процедуру без отдельного анализа.
//
// Низкоуровневые процедуры (при необходимости точечной настройки):
//   НастроитьДоступностьЭлементовФормыДокумента — только поля/кнопки по белым спискам;
//   ОтключитьКомандыРедактированияДокумента — запрет редактирования без включения просмотра;
//   ВключитьКомандыПросмотраНаПанеляхДокумента — только команды просмотра на панелях.
// =============================================================================

// Параметры настройки доступности формы документа (закрытый период, Окончательно, блокировки).
// Заполните поля и передайте в НастроитьДоступностьФормыДокумента.
//
// Возвращаемое значение:
//  Структура
//
Функция НовыеПараметрыДоступностиФормыДокумента() Экспорт
	
	Параметры = Новый Структура;
	Параметры.Вставить("Форма", 								Неопределено);
	Параметры.Вставить("ДатаДокумента", 						Дата(1, 1, 1));
	Параметры.Вставить("Окончательно", 							Ложь);
	Параметры.Вставить("ИменаТабличныхЧастей", 					Новый Массив);
	Параметры.Вставить("ЗаблокированПоПрочимПричинам", 			Ложь);
	Параметры.Вставить("ДопЗапрещенныеКоманды", 				Неопределено);
	Параметры.Вставить("ДопЗапрещенныеКомандыЖизненногоЦикла", Неопределено);
	Параметры.Вставить("ДополнительныеИменаЭлементовПанелейПросмотра", Неопределено);
	Параметры.Вставить("ВключатьПанельФормы", 					Истина);
	Параметры.Вставить("ПолнаяБлокировкаПоПрочимПричинам", 		Ложь);
	Параметры.Вставить("ДоступныКомандыЗаписиПроведенияПриОкончательно", Ложь);
	// Команды без записи/проведения/правки — доступны при любой блокировке документа.
	Параметры.Вставить("ВсегдаДоступныКомандыПросмотра", 		Истина);
	
	Возврат Параметры;
	
КонецФункции

// Универсальная настройка доступности формы документа.
// Поля и табличные части блокируются по периоду, Окончательно и прочим причинам;
// команды просмотра на панелях формы и ТЧ (отчёты, общие команды, печать, поиск)
// остаются доступны, если ВсегдаДоступныКомандыПросмотра = Истина.
//
// Параметры:
//  Параметры - Структура - см. НовыеПараметрыДоступностиФормыДокумента.
//
Процедура НастроитьДоступностьФормыДокумента(Параметры) Экспорт
	
	Форма = Параметры.Форма;
	ДатаДокумента 									= Параметры.ДатаДокумента;
	Окончательно 									= Параметры.Окончательно;
	ИменаТабличныхЧастей 							= Параметры.ИменаТабличныхЧастей;
	ЗаблокированПоПрочимПричинам					= Параметры.ЗаблокированПоПрочимПричинам;
	ДопЗапрещенныеКоманды 							= Параметры.ДопЗапрещенныеКоманды;
	ДопЗапрещенныеЖизненногоЦикла 					= Параметры.ДопЗапрещенныеКомандыЖизненногоЦикла;
	ДопИменаПанелей 								= Параметры.ДополнительныеИменаЭлементовПанелейПросмотра;
	ВключатьПанельФормы 							= Параметры.ВключатьПанельФормы;
	ПолнаяБлокировкаПоПрочимПричинам 				= Параметры.ПолнаяБлокировкаПоПрочимПричинам;
	ДоступныКомандыЗаписиПроведенияПриОкончательно 	= Параметры.ДоступныКомандыЗаписиПроведенияПриОкончательно;
	ВсегдаДоступныКомандыПросмотра 					= Параметры.ВсегдаДоступныКомандыПросмотра;
	
	ЭлементыФормы = Форма.Элементы;
	ПериодЗакрыт = ПериодДокументаЗакрытНаКлиенте(ДатаДокумента);
	
	ПолнаяБлокировкаБезПанелей = ЗаблокированПоПрочимПричинам
		И НЕ ПериодЗакрыт
		И (НЕ Окончательно ИЛИ ПолнаяБлокировкаПоПрочимПричинам);
	
	ПанелиПросмотра = МассивЭлементовПанелейПросмотраДокумента(
		ЭлементыФормы, ИменаТабличныхЧастей, ВключатьПанельФормы, ДопИменаПанелей);
	
	Если ПолнаяБлокировкаБезПанелей Тогда
		
		НастроитьДоступностьЭлементовФормыДокумента(
			Форма,
			ДатаДокумента,
			Неопределено,
			Неопределено,
			Неопределено,
			Истина);
		ОтключитьКнопкиУстановитьСнять(ЭлементыФормы);
		
	Иначе
		
		НастроитьДоступностьЭлементовФормыДокумента(
			Форма,
			ДатаДокумента,
			ПанелиПросмотра,
			Неопределено,
			ПанелиПросмотра,
			Окончательно);
		
	КонецЕсли;
	
	РедактированиеЗапрещено = ПериодЗакрыт
		Или Окончательно
		Или ПолнаяБлокировкаБезПанелей;
	
	Если РедактированиеЗапрещено Тогда
		ОтключитьКомандыРедактированияДокумента(
			ЭлементыФормы, ИменаТабличныхЧастей, ДопЗапрещенныеКоманды, ДопЗапрещенныеЖизненногоЦикла);
	КонецЕсли;
	
	Если ДоступныКомандыЗаписиПроведенияПриОкончательно
		И Окончательно
		И НЕ ПериодЗакрыт Тогда
		ВключитьКомандыЗаписиПроведенияДокумента(ЭлементыФормы);
	КонецЕсли;
	
	Если ВсегдаДоступныКомандыПросмотра Тогда
		ВключитьКомандыПросмотраНаПанеляхДокумента(
			Форма,
			ИменаТабличныхЧастей,
			ДопЗапрещенныеКоманды,
			ВключатьПанельФормы,
			ДопЗапрещенныеЖизненногоЦикла,
			ДопИменаПанелей);
	КонецЕсли;
	
КонецПроцедуры

// Настройка доступности по закрытому периоду / Окончательно / прочим блокировкам.
// Обёртка над НастроитьДоступностьФормыДокумента для совместимости с существующими формами.
//
// Параметры:
//  Форма                         - ФормаКлиентскогоПриложения;
//  ДатаДокумента                 - Дата;
//  Окончательно                  - Булево;
//  ИменаТабличныхЧастей          - Массив;
//  ЗаблокированПоПрочимПричинам  - Булево;
//  ДопЗапрещенныеКоманды         - Массив, Неопределено;
//  ВключатьПанельФормы           - Булево;
//  ПолнаяБлокировкаПоПрочимПричинам - Булево;
//  ДоступныКомандыЗаписиПроведенияПриОкончательно - Булево;
//  ДопЗапрещенныеКомандыЖизненногоЦикла - Массив, Неопределено;
//  ДополнительныеИменаЭлементовПанелейПросмотра - Массив, Неопределено;
//  ВсегдаДоступныКомандыПросмотра - Булево — по умолчанию Истина.
//
Процедура НастроитьДоступностьДокументаПоОкончательноИПериоду(Форма, ДатаДокумента, Окончательно,
	ИменаТабличныхЧастей, ЗаблокированПоПрочимПричинам,
	ДопЗапрещенныеКоманды = Неопределено, ВключатьПанельФормы = Истина,
	ПолнаяБлокировкаПоПрочимПричинам = Ложь,
	ДоступныКомандыЗаписиПроведенияПриОкончательно = Ложь,
	ДопЗапрещенныеКомандыЖизненногоЦикла = Неопределено,
	ДополнительныеИменаЭлементовПанелейПросмотра = Неопределено,
	ВсегдаДоступныКомандыПросмотра = Истина) Экспорт
	
	Параметры = НовыеПараметрыДоступностиФормыДокумента();
	Параметры.Форма = Форма;
	Параметры.ДатаДокумента = ДатаДокумента;
	Параметры.Окончательно = Окончательно;
	Параметры.ИменаТабличныхЧастей = ИменаТабличныхЧастей;
	Параметры.ЗаблокированПоПрочимПричинам = ЗаблокированПоПрочимПричинам;
	Параметры.ДопЗапрещенныеКоманды = ДопЗапрещенныеКоманды;
	Параметры.ДопЗапрещенныеКомандыЖизненногоЦикла = ДопЗапрещенныеКомандыЖизненногоЦикла;
	Параметры.ДополнительныеИменаЭлементовПанелейПросмотра = ДополнительныеИменаЭлементовПанелейПросмотра;
	Параметры.ВключатьПанельФормы = ВключатьПанельФормы;
	Параметры.ПолнаяБлокировкаПоПрочимПричинам = ПолнаяБлокировкаПоПрочимПричинам;
	Параметры.ДоступныКомандыЗаписиПроведенияПриОкончательно = ДоступныКомандыЗаписиПроведенияПриОкончательно;
	Параметры.ВсегдаДоступныКомандыПросмотра = ВсегдаДоступныКомандыПросмотра;
	
	НастроитьДоступностьФормыДокумента(Параметры);
	
КонецПроцедуры

#КонецОбласти


