// Остатки StockAPI: GET /balances, GET /leftover, GET /leftoverSeries; запросы к ОстаткиТовара.
// Зависимости: StockAPI_Утилиты, StockAPI_Цены, StockAPI_Справочники

// ─── Точка входа ─────────────────────────────────────────────────────────────

// Главная логика GET /leftover — остатки без видов цен, валют и цен.
// Возвращает Структура("КодОтвета, Тело") — Module.bsl преобразует в HTTP-ответ.
//
// Параметры:
//  Запрос              - HTTPСервисЗапрос - входящий запрос;
//  КонтекстАвторизации - Структура - результат проверки API-ключа.
//
// Возвращаемое значение:
//  Структура - поля КодОтвета, Тело.
//
Функция ПолучитьОстаткиБезЦен(Запрос, КонтекстАвторизации) Экспорт
	
	Пагинация = StockAPI_Утилиты.ПараметрыПагинацииОстатков(Запрос);
	Если Пагинация.Ошибка <> "" Тогда
		Возврат Новый Структура("КодОтвета, Тело", 400, Новый Структура("error", Пагинация.Ошибка));
	КонецЕсли;
	
	ФильтрСклад = РазрешенныйСкладИзЗапроса(Запрос, КонтекстАвторизации.УчетнаяЗапись);
	Если ФильтрСклад.Ошибка <> "" Тогда
		Возврат Новый Структура("КодОтвета, Тело", 400, Новый Структура("error", ФильтрСклад.Ошибка));
	КонецЕсли;
	
	ФильтрКоды = КодыНоменклатурыИзЗапроса(Запрос);
	Если ФильтрКоды.Ошибка <> "" Тогда
		Возврат Новый Структура("КодОтвета, Тело", 400, Новый Структура("error", ФильтрКоды.Ошибка));
	КонецЕсли;
	
	ФильтрНоменклатура = НоменклатураПоНаименованиюИзЗапроса(Запрос);
	Если ФильтрНоменклатура.Ошибка <> "" Тогда
		Возврат Новый Структура("КодОтвета, Тело", 400, Новый Структура("error", ФильтрНоменклатура.Ошибка));
	КонецЕсли;
	
	ФильтрБренд = БрендИзЗапроса(Запрос);
	Если ФильтрБренд.Ошибка <> "" Тогда
		Возврат Новый Структура("КодОтвета, Тело", 400, Новый Структура("error", ФильтрБренд.Ошибка));
	КонецЕсли;
	
	ТаблицаОстатков = ТаблицаОстатковБезЦен(ФильтрСклад.Склады, ФильтрКоды.Коды,
		ФильтрБренд.Бренд, ФильтрНоменклатура.Номенклатура);
	ВсегоНоменклатуры = ТаблицаОстатков.Количество();
	РазмерСтраницы = Пагинация.pageSize;
	ВсегоСтраниц = StockAPI_Утилиты.ВсегоСтраницПагинации(ВсегоНоменклатуры, РазмерСтраницы);
	Пропустить = (Пагинация.page - 1) * РазмерСтраницы;
	
	МассивСтрок = Новый Массив;
	Запр = Новый Запрос;
	Запр.УстановитьПараметр("ТЗ", ТаблицаОстатков);
	Запр.УстановитьПараметр("НачНом", Пропустить + 1);
	Запр.УстановитьПараметр("КонНом", Пропустить + РазмерСтраницы);
	
	Запр.Текст = "ВЫБРАТЬ
		|	ТЗ.НомСтроки КАК НомСтроки,
		|	ТЗ.Номенклатура КАК Номенклатура,
		|	ТЗ.Склад КАК Склад,
		|	ТЗ.Остаток КАК Остаток,
		|	ТЗ.Резерв КАК Резерв
		|ПОМЕСТИТЬ ВТ
		|ИЗ
		|	&ТЗ КАК ТЗ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ.Номенклатура.Код КАК КодНоменклатуры,
		|	ВТ.Номенклатура.Наименование КАК Номенклатура,
		|	ВТ.Номенклатура.SKU КАК SKU,
		|	ВТ.Номенклатура.Производитель.Наименование КАК Производитель,
		|	ВТ.Склад.Код КАК Склад,
		|	ВТ.Остаток КАК Остаток,
		|	ВТ.Резерв КАК Резерв,
		|	ВЫБОР
		|		КОГДА ВТ.Номенклатура.Родитель.Родитель = ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)
		|			ТОГДА ВТ.Номенклатура.Родитель.Наименование
		|		КОГДА ВТ.Номенклатура.Родитель.Родитель.Родитель = ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)
		|			ТОГДА ВТ.Номенклатура.Родитель.Родитель.Наименование
		|		КОГДА ВТ.Номенклатура.Родитель.Родитель.Родитель.Родитель = ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)
		|			ТОГДА ВТ.Номенклатура.Родитель.Родитель.Родитель.Наименование
		|		КОГДА ВТ.Номенклатура.Родитель.Родитель.Родитель.Родитель.Родитель = ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)
		|			ТОГДА ВТ.Номенклатура.Родитель.Родитель.Родитель.Родитель.Наименование
		|		КОГДА ВТ.Номенклатура.Родитель.Родитель.Родитель.Родитель.Родитель.Родитель = ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)
		|			ТОГДА ВТ.Номенклатура.Родитель.Родитель.Родитель.Родитель.Родитель.Наименование
		|		ИНАЧЕ """"
		|	КОНЕЦ КАК Бренд,
		|	ВЫБОР
		|		КОГДА ВТ.Номенклатура.Родитель.Родитель = ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)
		|			ТОГДА ВТ.Номенклатура.Родитель.Код
		|		КОГДА ВТ.Номенклатура.Родитель.Родитель.Родитель = ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)
		|			ТОГДА ВТ.Номенклатура.Родитель.Родитель.Код
		|		КОГДА ВТ.Номенклатура.Родитель.Родитель.Родитель.Родитель = ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)
		|			ТОГДА ВТ.Номенклатура.Родитель.Родитель.Родитель.Код
		|		КОГДА ВТ.Номенклатура.Родитель.Родитель.Родитель.Родитель.Родитель = ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)
		|			ТОГДА ВТ.Номенклатура.Родитель.Родитель.Родитель.Родитель.Код
		|		КОГДА ВТ.Номенклатура.Родитель.Родитель.Родитель.Родитель.Родитель.Родитель = ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)
		|			ТОГДА ВТ.Номенклатура.Родитель.Родитель.Родитель.Родитель.Родитель.Код
		|		ИНАЧЕ """"
		|	КОНЕЦ КАК КодБренда
		|ИЗ
		|	ВТ КАК ВТ
		|ГДЕ
		|	ВТ.НомСтроки МЕЖДУ &НачНом И &КонНом";
	
	Выборка = Запр.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Элемент = Новый Структура;
		Элемент.Вставить("warehouse", Выборка.Склад);
		Элемент.Вставить("item", Выборка.Номенклатура);
		Элемент.Вставить("itemCode", StockAPI_Утилиты.КодВСтроку(Выборка.КодНоменклатуры));
		Элемент.Вставить("brand", Выборка.Бренд);
		Элемент.Вставить("brandCode", StockAPI_Утилиты.КодВСтроку(Выборка.КодБренда));
		Элемент.Вставить("itemSku", Выборка.SKU);
		Элемент.Вставить("manufacturer", Строка(Выборка.Производитель));
		Элемент.Вставить("balance", StockAPI_Утилиты.КодВСтроку(Выборка.Остаток));
		Элемент.Вставить("reserve", StockAPI_Утилиты.КодВСтроку(Выборка.Резерв));
		МассивСтрок.Добавить(Элемент);
	КонецЦикла;
	
	ТелоОтвета = Новый Структура;
	ТелоОтвета.Вставить("page", 		Пагинация.page);
	ТелоОтвета.Вставить("pageSize", 	РазмерСтраницы);
	ТелоОтвета.Вставить("totalItems", 	ВсегоНоменклатуры);
	ТелоОтвета.Вставить("totalPages", 	ВсегоСтраниц);
	ТелоОтвета.Вставить("items", 		МассивСтрок);
	
	Возврат Новый Структура("КодОтвета, Тело", 200, ТелоОтвета);
	
КонецФункции

// Главная логика GET /leftoverSeries — серии серийных товаров на остатках склада.
// Возвращает Структура("КодОтвета, Тело") — Module.bsl преобразует в HTTP-ответ.
//
// Параметры:
//  Запрос              - HTTPСервисЗапрос - склад (обязательно), grouped, search (опционально);
//  КонтекстАвторизации - Структура - результат проверки API-ключа.
//
// Возвращаемое значение:
//  Структура - поля КодОтвета, Тело.
//
Функция ПолучитьСерииОстатковСклада(Запрос, КонтекстАвторизации) Экспорт
	
	Если Не СкладЗаданВЗапросе(Запрос) Тогда
		Возврат Новый Структура("КодОтвета, Тело", 400,
			Новый Структура("error", "Укажите склад: warehouseId, warehouseCode, code или warehouse."));
	КонецЕсли;
	
	ФильтрСклад = РазрешенныйСкладИзЗапроса(Запрос, КонтекстАвторизации.УчетнаяЗапись);
	Если ФильтрСклад.Ошибка <> "" Тогда
		Возврат Новый Структура("КодОтвета, Тело", 400, Новый Структура("error", ФильтрСклад.Ошибка));
	КонецЕсли;
	
	Если ФильтрСклад.Склады.Количество() <> 1 Тогда
		Возврат Новый Структура("КодОтвета, Тело", 400,
			Новый Структура("error", "Уточните склад: найдено несколько или ни одного доступного склада."));
	КонецЕсли;
	
	Склад = ФильтрСклад.Склады[0];
	Сгруппировано = ПараметрGroupedИзЗапроса(Запрос);
	Если Сгруппировано.Ошибка <> "" Тогда
		Возврат Новый Структура("КодОтвета, Тело", 400, Новый Структура("error", Сгруппировано.Ошибка));
	КонецЕсли;
	
	ПоискСерий = СерииПоискаИзЗапроса(Запрос);
	Если ПоискСерий.Ошибка <> "" Тогда
		Возврат Новый Структура("КодОтвета, Тело", 400, Новый Структура("error", ПоискСерий.Ошибка));
	КонецЕсли;
	
	МассивЭлементов = ЭлементыСерийОстатковСклада(Склад, Сгруппировано.Значение, ПоискСерий.Серии);
	
	ТелоОтвета = Новый Структура;
	ТелоОтвета.Вставить("warehouse", StockAPI_Утилиты.КодВСтроку(Склад.Код));
	ТелоОтвета.Вставить("grouped", Сгруппировано.Значение);
	ТелоОтвета.Вставить("items", МассивЭлементов);
	
	Возврат Новый Структура("КодОтвета, Тело", 200, ТелоОтвета);
	
КонецФункции

// Главная логика GET /balances.
// Возвращает Структура("КодОтвета, Тело") — Module.bsl преобразует в HTTP-ответ.
//
Функция ПолучитьОстатки(Запрос, КонтекстАвторизации) Экспорт
	
	Пагинация = StockAPI_Утилиты.ПараметрыПагинацииОстатков(Запрос);
	Если Пагинация.Ошибка <> "" Тогда
		Возврат Новый Структура("КодОтвета, Тело", 400, Новый Структура("error", Пагинация.Ошибка));
	КонецЕсли;
	
	ФильтрСклад = РазрешенныйСкладИзЗапроса(Запрос, КонтекстАвторизации.УчетнаяЗапись);
	Если ФильтрСклад.Ошибка <> "" Тогда
		Возврат Новый Структура("КодОтвета, Тело", 400, Новый Структура("error", ФильтрСклад.Ошибка));
	КонецЕсли;
	
	ФильтрКоды = КодыНоменклатурыИзЗапроса(Запрос);
	Если ФильтрКоды.Ошибка <> "" Тогда
		Возврат Новый Структура("КодОтвета, Тело", 400, Новый Структура("error", ФильтрКоды.Ошибка));
	КонецЕсли;

	ФильтрНоменклатура = НоменклатураПоНаименованиюИзЗапроса(Запрос);
	Если ФильтрНоменклатура.Ошибка <> "" Тогда
		Возврат Новый Структура("КодОтвета, Тело", 400, Новый Структура("error", ФильтрНоменклатура.Ошибка));
	КонецЕсли;
	
	ФильтрБренд = БрендИзЗапроса(Запрос);
	Если ФильтрБренд.Ошибка <> "" Тогда
		Возврат Новый Структура("КодОтвета, Тело", 400, Новый Структура("error", ФильтрБренд.Ошибка));
	КонецЕсли;
	
	Если ОстаткиБезПараметровЦен(Запрос) Тогда
		Возврат ПолучитьОстаткиБезПараметровЦен(Запрос, ФильтрСклад, ФильтрКоды, ФильтрНоменклатура, ФильтрБренд, Пагинация);
	КонецЕсли;
	
	ФильтрВидЦены = ВидЦеныИВалютаИзЗапроса(Запрос); 
	Если ФильтрВидЦены.Ошибка <> "" Тогда
		Возврат Новый Структура("КодОтвета, Тело", 400, Новый Структура("error", ФильтрВидЦены.Ошибка));
	КонецЕсли;
	
	ТаблицаОстатков = ТаблицаОстатков(ФильтрСклад.Склады, ФильтрВидЦены.ВидЦены, ФильтрВидЦены.Валюта, ФильтрКоды.Коды,
										ФильтрБренд.Бренд, ФильтрНоменклатура.Номенклатура);
	ВсегоНоменклатуры = ТаблицаОстатков.Количество();   
	РазмерСтраницы = Пагинация.pageSize;
	ВсегоСтраниц = StockAPI_Утилиты.ВсегоСтраницПагинации(ВсегоНоменклатуры, РазмерСтраницы);
	Пропустить = (Пагинация.page - 1) * РазмерСтраницы;
	
	РезультатВидЦены = StockAPI_Цены.ПредставлениеВидаЦеныДляAPI(ФильтрВидЦены.ВидЦены);
	РезультатВалюта = StockAPI_Цены.ПредставлениеВалютыДляAPI(ФильтрВидЦены.Валюта);
	
	МассивСтрок = Новый Массив;
	Запр = Новый Запрос;
	Запр.УстановитьПараметр("ТЗ", ТаблицаОстатков); 
	Запр.УстановитьПараметр("НачНом", Пропустить + 1); 
	Запр.УстановитьПараметр("КонНом", Пропустить + РазмерСтраницы); 
	Запр.Текст = ТекстЗапросаСтрокОстатковДляAPI(Истина);
	
	Выборка = Запр.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		МассивСтрок.Добавить(ЭлементОстаткаДляAPI(Выборка, Истина, РезультатВидЦены, РезультатВалюта));
	КонецЦикла;
	
	ТелоОтвета = Новый Структура;
	ТелоОтвета.Вставить("page", 		Пагинация.page);
	ТелоОтвета.Вставить("pageSize", 	РазмерСтраницы);
	ТелоОтвета.Вставить("totalItems", 	ВсегоНоменклатуры);
	ТелоОтвета.Вставить("totalPages", 	ВсегоСтраниц);
	ТелоОтвета.Вставить("items", 		МассивСтрок);
	
	Возврат Новый Структура("КодОтвета, Тело", 200, ТелоОтвета);

КонецФункции

Функция ТаблицаОстатков(Склады, ВидЦены, Валюта, КодыНоменклатуры = Неопределено, Бренд = Неопределено, Номенклатура = Неопределено)
	
	ФильтрПоКодам 		= КодыНоменклатуры <> Неопределено И КодыНоменклатуры.Количество() > 0;
	ФильтрПоБренду 		= ЗначениеЗаполнено(Бренд);
	ФильтрПоНоменклатуре = ЗначениеЗаполнено(Номенклатура);

	запр = Новый Запрос;
	запр.УстановитьПараметр("Склады",			Склады);
	запр.УстановитьПараметр("ВидЦены",			ВидЦены);
	запр.УстановитьПараметр("Валюта",			Валюта);
	запр.УстановитьПараметр("ФильтрПоКодам", 	ФильтрПоКодам);
	запр.УстановитьПараметр("КодыНоменклатуры", ?(ФильтрПоКодам, КодыНоменклатуры, Новый Массив));
	запр.УстановитьПараметр("ФильтрПоБренду", 	ФильтрПоБренду);
	запр.УстановитьПараметр("Бренд", 			?(ФильтрПоБренду, Бренд, Справочники.Номенклатура.ПустаяСсылка()));
	запр.УстановитьПараметр("ФильтрПоНоменклатуре", ФильтрПоНоменклатуре);
	запр.УстановитьПараметр("Номенклатура", 	?(ФильтрПоНоменклатуре, Номенклатура, Справочники.Номенклатура.ПустаяСсылка()));
	 запр.Текст = "ВЫБРАТЬ
	              |	Ост.Номенклатура КАК Номенклатура,
	              |	Ост.Склад КАК Склад,
	              |	Ост.ОстатокОстаток КАК Остаток
	              |ПОМЕСТИТЬ ВТОстатки
	              |ИЗ
	              |	РегистрНакопления.ОстаткиТовара.Остатки(
	              |			,
	              |			Склад В (&Склады)
	              |				И Номенклатура В
	              |					(ВЫБРАТЬ
	              |						Ном.Ссылка
	              |					ИЗ
	              |						Справочник.Номенклатура КАК Ном
	              |					ГДЕ
	              |						Ном.ТипНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.Товар)
	              |						И (НЕ &ФильтрПоКодам
	              |							ИЛИ Ном.Код В (&КодыНоменклатуры))
	              |						И (НЕ &ФильтрПоБренду
	              |							ИЛИ Ном.Ссылка В ИЕРАРХИИ(&Бренд))
	              |						И (НЕ &ФильтрПоНоменклатуре
	              |							ИЛИ Ном.Ссылка = &Номенклатура))) КАК Ост
	              |ГДЕ
	              |	Ост.ОстатокОстаток > 0
	              |
	              |ИНДЕКСИРОВАТЬ ПО
	              |	Ост.Склад,
	              |	Ост.Номенклатура
	              |;
	              |
	              |////////////////////////////////////////////////////////////////////////////////
	              |ВЫБРАТЬ
	              |	Рез.Номенклатура КАК Номенклатура,
	              |	Рез.Склад КАК Склад,
	              |	СУММА(Рез.КоличествоОстаток) КАК РезервЗаказов
	              |ПОМЕСТИТЬ ВТРезервыЗаказов
	              |ИЗ
	              |	РегистрНакопления.РезервыТовара.Остатки(, Склад В (&Склады)) КАК Рез
	              |
	              |СГРУППИРОВАТЬ ПО
	              |	Рез.Номенклатура,
	              |	Рез.Склад
	              |
	              |ИНДЕКСИРОВАТЬ ПО
	              |	Номенклатура,
	              |	Склад
	              |;
	              |
	              |////////////////////////////////////////////////////////////////////////////////
	              |ВЫБРАТЬ
	              |	Ост.Номенклатура КАК Номенклатура,
	              |	Ост.Склад КАК Склад,
	              |	Ост.Остаток КАК Остаток,
	              |	ЕСТЬNULL(РезЗак.РезервЗаказов, 0) КАК Резерв,
	              |	Цены.Цена0 КАК Цена0,
	              |	Цены.Цена1 КАК Цена1,
	              |	Цены.Цена2 КАК Цена2,
	              |	Цены.Цена3 КАК Цена3,
	              |	Цены.Порог1 КАК Порог1,
	              |	Цены.Порог2 КАК Порог2,
	              |	Цены.Порог3 КАК Порог3,
	              |	Цены.РазрешитьПродажу КАК РазрешитьПродажу
	              |ИЗ
	              |	ВТОстатки КАК Ост
	              |		ЛЕВОЕ СОЕДИНЕНИЕ ВТРезервыЗаказов КАК РезЗак
	              |		ПО Ост.Номенклатура = РезЗак.Номенклатура
	              |			И Ост.Склад = РезЗак.Склад
	              |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЦеныПродажи.СрезПоследних(
	              |				,
	              |				ВидЦены = &ВидЦены
	              |					И Валюта = &Валюта
	              |					И Склад В (&Склады)
	              |					И Номенклатура В
	              |						(ВЫБРАТЬ
	              |							ВТОстатки.Номенклатура
	              |						ИЗ
	              |							ВТОстатки)) КАК Цены
	              |		ПО Ост.Склад = Цены.Склад
	              |			И Ост.Номенклатура = Цены.Номенклатура
	              |
	              |УПОРЯДОЧИТЬ ПО
	              |	Склад,
	              |	Номенклатура";
 	Выгрузка = Запр.Выполнить().Выгрузить();
	
	// сканирование с остатками НАЧАЛО
	СканированиеСерий.УменьшитьОстатокНаБуфер(Выгрузка);
	УдалитьСтрокиСНулевымОстатком(Выгрузка);
	// сканирование с остатками ОКОНЧАНИЕ
	
	Выгрузка.Колонки.Добавить("НомСтроки", Новый ОписаниеТипов("Число"));
	Номер = 0;
	Для Каждого Строка Из Выгрузка Цикл
		Номер = Номер + 1;
		Строка.НомСтроки = Номер;
	КонецЦикла;

	Возврат Выгрузка;
	
КонецФункции // ТаблицаОстатков()

// Остатки по складам без цен продажи (для GET /leftover).
//
// Параметры:
//  Склады             - Массив - склады отбора;
//  КодыНоменклатуры   - Массив, Неопределено - числовые коды номенклатуры;
//  Бренд              - СправочникСсылка.Номенклатура, Неопределено - группа бренда;
//  Номенклатура       - СправочникСсылка.Номенклатура, Неопределено - точный товар.
//
// Возвращаемое значение:
//  ТаблицаЗначений - колонки Номенклатура, Склад, Остаток, Резерв, НомСтроки.
//
Функция ТаблицаОстатковБезЦен(Склады, КодыНоменклатуры = Неопределено, Бренд = Неопределено, Номенклатура = Неопределено)
	
	ФильтрПоКодам = КодыНоменклатуры <> Неопределено И КодыНоменклатуры.Количество() > 0;
	ФильтрПоБренду = ЗначениеЗаполнено(Бренд);
	ФильтрПоНоменклатуре = ЗначениеЗаполнено(Номенклатура);
	
	Запр = Новый Запрос;
	Запр.УстановитьПараметр("Склады", Склады);
	Запр.УстановитьПараметр("ФильтрПоКодам", ФильтрПоКодам);
	Запр.УстановитьПараметр("КодыНоменклатуры", ?(ФильтрПоКодам, КодыНоменклатуры, Новый Массив));
	Запр.УстановитьПараметр("ФильтрПоБренду", ФильтрПоБренду);
	Запр.УстановитьПараметр("Бренд", ?(ФильтрПоБренду, Бренд, Справочники.Номенклатура.ПустаяСсылка()));
	Запр.УстановитьПараметр("ФильтрПоНоменклатуре", ФильтрПоНоменклатуре);
	Запр.УстановитьПараметр("Номенклатура", ?(ФильтрПоНоменклатуре, Номенклатура, Справочники.Номенклатура.ПустаяСсылка()));
	
	Запр.Текст = "ВЫБРАТЬ
	             |	Ост.Номенклатура КАК Номенклатура,
	             |	Ост.Склад КАК Склад,
	             |	Ост.ОстатокОстаток КАК Остаток
	             |ПОМЕСТИТЬ ВТОстатки
	             |ИЗ
	             |	РегистрНакопления.ОстаткиТовара.Остатки(
	             |			,
	             |			Склад В (&Склады)
	             |				И Номенклатура В
	             |					(ВЫБРАТЬ
	             |						Ном.Ссылка
	             |					ИЗ
	             |						Справочник.Номенклатура КАК Ном
	             |					ГДЕ
	             |						Ном.ТипНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.Товар)
	             |						И (НЕ &ФильтрПоКодам
	             |							ИЛИ Ном.Код В (&КодыНоменклатуры))
	             |						И (НЕ &ФильтрПоБренду
	             |							ИЛИ Ном.Ссылка В ИЕРАРХИИ (&Бренд))
	             |						И (НЕ &ФильтрПоНоменклатуре
	             |							ИЛИ Ном.Ссылка = &Номенклатура))) КАК Ост
	             |ГДЕ
	             |	Ост.ОстатокОстаток > 0
	             |
	             |ИНДЕКСИРОВАТЬ ПО
	             |	Ост.Склад,
	             |	Ост.Номенклатура
	             |;
	             |
	             |////////////////////////////////////////////////////////////////////////////////
	             |ВЫБРАТЬ
	             |	Рез.Номенклатура КАК Номенклатура,
	             |	Рез.Склад КАК Склад,
	             |	СУММА(Рез.КоличествоОстаток) КАК РезервЗаказов
	             |ПОМЕСТИТЬ ВТРезервыЗаказов
	             |ИЗ
	             |	РегистрНакопления.РезервыТовара.Остатки(, Склад В (&Склады)) КАК Рез
	             |
	             |СГРУППИРОВАТЬ ПО
	             |	Рез.Номенклатура,
	             |	Рез.Склад
	             |
	             |ИНДЕКСИРОВАТЬ ПО
	             |	Номенклатура,
	             |	Склад
	             |;
	             |
	             |////////////////////////////////////////////////////////////////////////////////
	             |ВЫБРАТЬ
	             |	Ост.Номенклатура КАК Номенклатура,
	             |	Ост.Склад КАК Склад,
	             |	Ост.Остаток КАК Остаток,
	             |	ЕСТЬNULL(РезЗак.РезервЗаказов, 0) КАК Резерв
	             |ИЗ
	             |	ВТОстатки КАК Ост
	             |		ЛЕВОЕ СОЕДИНЕНИЕ ВТРезервыЗаказов КАК РезЗак
	             |		ПО Ост.Номенклатура = РезЗак.Номенклатура
	             |			И Ост.Склад = РезЗак.Склад
	             |
	             |УПОРЯДОЧИТЬ ПО
	             |	Склад,
	             |	Номенклатура";
	
	Выгрузка = Запр.Выполнить().Выгрузить();
	
	// сканирование с остатками НАЧАЛО
	СканированиеСерий.УменьшитьОстатокНаБуфер(Выгрузка);
	УдалитьСтрокиСНулевымОстатком(Выгрузка);
	// сканирование с остатками ОКОНЧАНИЕ
	
	Выгрузка.Колонки.Добавить("НомСтроки", Новый ОписаниеТипов("Число"));
	Номер = 0;
	Для Каждого Строка Из Выгрузка Цикл
		Номер = Номер + 1;
		Строка.НомСтроки = Номер;
	КонецЦикла;
	
	Возврат Выгрузка;
	
КонецФункции

// сканирование с остатками НАЧАЛО

// Удаляет из таблицы остатков строки с количеством 0 и меньше после вычета буфера.
//
// Параметры:
//  ТаблицаОстатков - ТаблицаЗначений - колонка Остаток.
//
Процедура УдалитьСтрокиСНулевымОстатком(ТаблицаОстатков)
	
	СтрокиУдалить = Новый Массив;
	Для Каждого СтрокаОстатка Из ТаблицаОстатков Цикл
		Если СтрокаОстатка.Остаток <= 0 Тогда
			СтрокиУдалить.Добавить(СтрокаОстатка);
		КонецЕсли;
	КонецЦикла;
	Для Каждого СтрокаОстатка Из СтрокиУдалить Цикл
		ТаблицаОстатков.Удалить(СтрокаОстатка);
	КонецЦикла;
	
КонецПроцедуры
// сканирование с остатками ОКОНЧАНИЕ

// GET /balances без priceType и currency: товары с остатком > 0 и все цены из регистра.
//
Функция ПолучитьОстаткиБезПараметровЦен(Запрос, ФильтрСклад, ФильтрКоды, ФильтрНоменклатура, ФильтрБренд, Пагинация)
	
	ТаблицаОстатков = ТаблицаОстатковБезЦен(ФильтрСклад.Склады, ФильтрКоды.Коды,
		ФильтрБренд.Бренд, ФильтрНоменклатура.Номенклатура);
	ВсегоНоменклатуры = ТаблицаОстатков.Количество();
	РазмерСтраницы = Пагинация.pageSize;
	ВсегоСтраниц = StockAPI_Утилиты.ВсегоСтраницПагинации(ВсегоНоменклатуры, РазмерСтраницы);
	Пропустить = (Пагинация.page - 1) * РазмерСтраницы;
	
	Запр = Новый Запрос;
	Запр.УстановитьПараметр("ТЗ", ТаблицаОстатков);
	Запр.УстановитьПараметр("НачНом", Пропустить + 1);
	Запр.УстановитьПараметр("КонНом", Пропустить + РазмерСтраницы);
	Запр.Текст = ТекстЗапросаСтрокОстатковДляAPI(Ложь);
	
	ТаблицаСтраницы = Запр.Выполнить().Выгрузить();
	МассивНоменклатуры = Новый Массив;
	МассивСкладов = Новый Массив;
	СоответствиеНоменклатуры = Новый Соответствие;
	СоответствиеСкладов = Новый Соответствие;
	
	Для Каждого Строка Из ТаблицаСтраницы Цикл
		Если СоответствиеНоменклатуры.Получить(Строка.НоменклатураСсылка) = Неопределено Тогда
			СоответствиеНоменклатуры.Вставить(Строка.НоменклатураСсылка, Истина);
			МассивНоменклатуры.Добавить(Строка.НоменклатураСсылка);
		КонецЕсли;
		Если СоответствиеСкладов.Получить(Строка.СкладСсылка) = Неопределено Тогда
			СоответствиеСкладов.Вставить(Строка.СкладСсылка, Истина);
			МассивСкладов.Добавить(Строка.СкладСсылка);
		КонецЕсли;
	КонецЦикла;
	
	ВсеЦены = StockAPI_Цены.ЗагрузитьВсеЦеныПродажиДляОстатков(МассивНоменклатуры, МассивСкладов);
	
	МассивСтрок = Новый Массив;
	Для Каждого Строка Из ТаблицаСтраницы Цикл
		МассивСтрок.Добавить(ЭлементОстаткаСВсемиЦенамиДляAPI(Строка, ВсеЦены));
	КонецЦикла;
	
	ТелоОтвета = Новый Структура;
	ТелоОтвета.Вставить("page", Пагинация.page);
	ТелоОтвета.Вставить("pageSize", РазмерСтраницы);
	ТелоОтвета.Вставить("totalItems", ВсегоНоменклатуры);
	ТелоОтвета.Вставить("totalPages", ВсегоСтраниц);
	ТелоОтвета.Вставить("items", МассивСтрок);
	
	Возврат Новый Структура("КодОтвета, Тело", 200, ТелоОтвета);
	
КонецФункции

// Истина, если в запросе не переданы priceType и currency (режим GET /balances со всеми ценами).
//
Функция ОстаткиБезПараметровЦен(Запрос)
	
	ПараметрВидаЦены = Запрос.ПараметрыЗапроса.Получить("priceType");
	ПараметрВалюты = Запрос.ПараметрыЗапроса.Получить("currency");
	ЕстьВидЦены = ПараметрВидаЦены <> Неопределено И СокрЛП(Строка(ПараметрВидаЦены)) <> "";
	ЕстьВалюта = ПараметрВалюты <> Неопределено И СокрЛП(Строка(ПараметрВалюты)) <> "";
	
	Возврат НЕ ЕстьВидЦены И НЕ ЕстьВалюта;
	
КонецФункции

// Текст запроса строк остатков для ответа API (с ценами или без).
//
Функция ТекстЗапросаСтрокОстатковДляAPI(СЦенами)
	
	ТекстЦен = "";
	Если СЦенами Тогда
		ТекстЦен = ",
	             |	ТЗ.Цена0 КАК Цена0,
	             |	ТЗ.Цена1 КАК Цена1,
	             |	ТЗ.Цена2 КАК Цена2,
	             |	ТЗ.Цена3 КАК Цена3,
	             |	ТЗ.Порог1 КАК Порог1,
	             |	ТЗ.Порог2 КАК Порог2,
	             |	ТЗ.Порог3 КАК Порог3,
	             |	ТЗ.РазрешитьПродажу КАК РазрешитьПродажу";
	КонецЕсли;
	
	ТекстПродажи = "";
	Если СЦенами Тогда
		ТекстПродажи = ",
	             |	isnull(ВТ.Цена0,0) КАК Цена0,
	             |	isnull(ВТ.Цена1,0) КАК Цена1,
	             |	isnull(ВТ.Цена2,0) КАК Цена2,
	             |	isnull(ВТ.Цена3,0) КАК Цена3,
	             |	isnull(ВТ.Порог1,0) КАК Порог1,
	             |	isnull(ВТ.Порог2,0) КАК Порог2,
	             |	isnull(ВТ.Порог3,0) КАК Порог3,
	             |	ЕСТЬNULL(ВТ.РазрешитьПродажу, ИСТИНА) КАК РазрешитьПродажу";
	КонецЕсли;
	
	Возврат "ВЫБРАТЬ
	             |	ТЗ.НомСтроки КАК НомСтроки,
	             |	ТЗ.Номенклатура КАК Номенклатура,
	             |	ТЗ.Склад КАК Склад,
	             |	ТЗ.Остаток КАК Остаток,
	             |	ТЗ.Резерв КАК Резерв" + ТекстЦен + "
	             |ПОМЕСТИТЬ ВТ
	             |ИЗ
	             |	&ТЗ КАК ТЗ
	             |;
	             |
	             |////////////////////////////////////////////////////////////////////////////////
	             |ВЫБРАТЬ
	             |	ВТ.Номенклатура.Код КАК КодНоменклатуры,
	             |	ВТ.Номенклатура.Наименование КАК Номенклатура,
	             |	ВТ.Номенклатура.SKU КАК SKU,
	             |	ВТ.Номенклатура.UPC КАК UPC,
	             |	ВТ.Номенклатура.JAN13 КАК JAN,
	             |	ВТ.Номенклатура.Производитель.Наименование КАК Производитель,
	             |	ВТ.Склад.Код КАК Склад,
	             |	ВТ.Остаток КАК Остаток,
	             |	ВТ.Резерв КАК Резерв" + ТекстПродажи + ",
	             |	ВЫБОР
	             |		КОГДА ВТ.Номенклатура.Родитель.Родитель = ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)
	             |			ТОГДА ВТ.Номенклатура.Родитель.Наименование
	             |		КОГДА ВТ.Номенклатура.Родитель.Родитель.Родитель = ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)
	             |			ТОГДА ВТ.Номенклатура.Родитель.Родитель.Наименование
	             |		КОГДА ВТ.Номенклатура.Родитель.Родитель.Родитель.Родитель = ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)
	             |			ТОГДА ВТ.Номенклатура.Родитель.Родитель.Родитель.Наименование
	             |		КОГДА ВТ.Номенклатура.Родитель.Родитель.Родитель.Родитель.Родитель = ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)
	             |			ТОГДА ВТ.Номенклатура.Родитель.Родитель.Родитель.Родитель.Наименование
	             |		КОГДА ВТ.Номенклатура.Родитель.Родитель.Родитель.Родитель.Родитель.Родитель = ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)
	             |			ТОГДА ВТ.Номенклатура.Родитель.Родитель.Родитель.Родитель.Родитель.Наименование
	             |		ИНАЧЕ """"
	             |	КОНЕЦ КАК Бренд,
	             |	ВЫБОР
	             |		КОГДА ВТ.Номенклатура.Родитель.Родитель = ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)
	             |			ТОГДА ВТ.Номенклатура.Родитель.Код
	             |		КОГДА ВТ.Номенклатура.Родитель.Родитель.Родитель = ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)
	             |			ТОГДА ВТ.Номенклатура.Родитель.Родитель.Код
	             |		КОГДА ВТ.Номенклатура.Родитель.Родитель.Родитель.Родитель = ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)
	             |			ТОГДА ВТ.Номенклатура.Родитель.Родитель.Родитель.Код
	             |		КОГДА ВТ.Номенклатура.Родитель.Родитель.Родитель.Родитель.Родитель = ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)
	             |			ТОГДА ВТ.Номенклатура.Родитель.Родитель.Родитель.Родитель.Код
	             |		КОГДА ВТ.Номенклатура.Родитель.Родитель.Родитель.Родитель.Родитель.Родитель = ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)
	             |			ТОГДА ВТ.Номенклатура.Родитель.Родитель.Родитель.Родитель.Родитель.Код
	             |		ИНАЧЕ """"
	             |	КОНЕЦ КАК КодБренда,
	             |	ВТ.Номенклатура КАК НоменклатураСсылка,
	             |	ВТ.Склад КАК СкладСсылка
	             |ИЗ
	             |	ВТ КАК ВТ
	             |ГДЕ
	             |	ВТ.НомСтроки МЕЖДУ &НачНом И &КонНом";
	
КонецФункции

// Элемент массива items для GET /balances без priceType и currency.
//
// Параметры:
//  ДанныеСтроки - СтрокаТаблицыЗначений - строка страницы остатков;
//  ВсеЦены      - Соответствие - цены по ключу StockAPI_Цены.КлючНоменклатураСкладДляЦен.
//
// Возвращаемое значение:
//  Структура - элемент ответа API.
//
Функция ЭлементОстаткаСВсемиЦенамиДляAPI(ДанныеСтроки, ВсеЦены)
	
	Элемент = БазовыеПоляОстаткаДляAPI(ДанныеСтроки);
	
	Ключ = StockAPI_Цены.КлючНоменклатураСкладДляЦен(ДанныеСтроки.НоменклатураСсылка, ДанныеСтроки.СкладСсылка);
	МассивЦен = ВсеЦены.Получить(Ключ);
	Если МассивЦен = Неопределено Тогда
		МассивЦен = Новый Массив;
	КонецЕсли;
	Элемент.Вставить("price", МассивЦен);
	
	Возврат Элемент;
	
КонецФункции

// Элемент массива items для GET /balances.
//
Функция ЭлементОстаткаДляAPI(Выборка, СЦенами, РезультатВидЦены = "", РезультатВалюта = "")
	
	Элемент = БазовыеПоляОстаткаДляAPI(Выборка);
	
	Если СЦенами Тогда
		Элемент.Вставить("salesBan", НЕ Выборка.РазрешитьПродажу);
		Элемент.Вставить("priceType", РезультатВидЦены);
		Элемент.Вставить("currency", РезультатВалюта);
		Элемент.Вставить("price", StockAPI_Цены.МассивПороговЦенДляAPI(
			Выборка.Цена0, Выборка.Цена1, Выборка.Цена2, Выборка.Цена3,
			Выборка.Порог1, Выборка.Порог2, Выборка.Порог3));
	КонецЕсли;
	
	Возврат Элемент;
	
КонецФункции

// Общие поля элемента остатка для GET /balances и GET /leftover.
//
// Параметры:
//  ДанныеСтроки - СтрокаТаблицыЗначений, ВыборкаИзРезультатаЗапроса - строка с полями ответа.
//
// Возвращаемое значение:
