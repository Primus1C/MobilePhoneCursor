// Обязательные параметры priceType (наименование ВидыЦен) и currency (валюта).
//
Функция ВидЦеныИВалютаИзЗапроса(Запрос)

	ПараметрВидаЦены = Запрос.ПараметрыЗапроса.Получить("priceType");
	ПараметрВалюты = Запрос.ПараметрыЗапроса.Получить("currency");
	
	//Возврат StockAPI_Цены.ВидЦеныИВалютаПоПараметрам(ПараметрВидаЦены, ПараметрВалюты, Истина);
	Возврат StockAPI_Цены.ВидЦеныИВалютаПоПараметрам(ПараметрВидаЦены, ПараметрВалюты, Ложь);

КонецФункции // ВидЦеныИВалютаИзЗапроса()


// Опциональный фильтр по кодам номенклатуры: itemCode (один код) или itemCodes (через запятую).
//
Функция КодыНоменклатурыИзЗапроса(Запрос)
	
	Результат = Новый Структура("Коды, Ошибка", Новый Массив, "");
	
	СтрокаКодов = StockAPI_Утилиты.СтрокаПараметраЗапроса(Запрос, "itemCodes");
	Если СтрокаКодов = "" Тогда
		СтрокаКодов = StockAPI_Утилиты.СтрокаПараметраЗапроса(Запрос, "itemCode");
	КонецЕсли;
	
	Если СтрокаКодов = "" Тогда
		Возврат Результат;
	КонецЕсли;
	
	УникальныеКоды = Новый Соответствие;
	Части = СтрРазделить(СтрокаКодов, ",", Ложь);
	Для Каждого Часть Из Части Цикл
		
		КодСтрокой = СокрЛП(Часть);
		Если КодСтрокой = "" Тогда
			Продолжить;
		КонецЕсли;
		
		Попытка
			КодЧисло = Число(КодСтрокой);
		Исключение
			Результат.Ошибка = СтрШаблон("Параметр itemCode/itemCodes: код ""%1"" должен быть числом.", КодСтрокой);
			Возврат Результат;
		КонецПопытки;
		
		УникальныеКоды.Вставить(КодЧисло, Истина);
		
	КонецЦикла;
	
	Если УникальныеКоды.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;
	
	Для Каждого КлючИЗначение Из УникальныеКоды Цикл
		Результат.Коды.Добавить(КлючИЗначение.Ключ);
	КонецЦикла;
	
	ЗапросБД = Новый Запрос;
	ЗапросБД.УстановитьПараметр("Коды", Результат.Коды);
	ЗапросБД.Текст = "ВЫБРАТЬ
	                 |	Номенклатура.Код КАК Код
	                 |ИЗ
	                 |	Справочник.Номенклатура КАК Номенклатура
	                 |ГДЕ
	                 |	Номенклатура.Код В (&Коды)
	                 |	И НЕ Номенклатура.ПометкаУдаления";
	НайденныеКоды = Новый Соответствие;
	Выборка = ЗапросБД.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		НайденныеКоды.Вставить(Выборка.Код, Истина);
	КонецЦикла;
	
	НеНайденные = Новый Массив;
	Для Каждого КодНоменклатуры Из Результат.Коды Цикл
		Если НайденныеКоды.Получить(КодНоменклатуры) = Неопределено Тогда
			НеНайденные.Добавить(StockAPI_Утилиты.КодВСтроку(КодНоменклатуры));
		КонецЕсли;
	КонецЦикла;
	
	Если НеНайденные.Количество() > 0 Тогда
		Результат.Ошибка = "Не найдена номенклатура с кодом: " + СтрСоединить(НеНайденные, ", ") + ".";
		Результат.Коды = Новый Массив;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Возвращает товар по точному наименованию из параметра item.
//
// Параметры:
//  Запрос - HTTPСервисЗапрос - входящий запрос GET /balances.
//
// Возвращаемое значение:
//  Структура - поля Номенклатура, Ошибка.
//
Функция НоменклатураПоНаименованиюИзЗапроса(Запрос)

	Результат = Новый Структура("Номенклатура, Ошибка",	Справочники.Номенклатура.ПустаяСсылка(), "");

	Наименование = StockAPI_Утилиты.СтрокаПараметраЗапроса(Запрос, "item");
	Если Наименование = "" Тогда
		Возврат Результат;
	КонецЕсли;

	ЗапросБД = Новый Запрос;
	ЗапросБД.УстановитьПараметр("Наименование", Наименование);
	ЗапросБД.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
	                 |	Номенклатура.Ссылка КАК Ссылка
	                 |ИЗ
	                 |	Справочник.Номенклатура КАК Номенклатура
	                 |ГДЕ
	                 |	Номенклатура.Наименование = &Наименование
	                 |	И НЕ Номенклатура.ЭтоГруппа
	                 |	И НЕ Номенклатура.ПометкаУдаления";
	Выборка = ЗапросБД.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Результат.Номенклатура = Выборка.Ссылка;
	Иначе
		Результат.Ошибка = СтрШаблон("Не найдена номенклатура с наименованием '%1'.", Наименование);
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Опциональный фильтр по бренду: brand (код или наименование группы первого уровня).
//
Функция БрендИзЗапроса(Запрос)
	
	Результат = Новый Структура("Бренд, Ошибка", Неопределено, "");
	
	СтрокаБренда = StockAPI_Утилиты.СтрокаПараметраЗапроса(Запрос, "brand");
	Если СтрокаБренда = "" Тогда
		Возврат Результат;
	КонецЕсли;
	
	ОшибкаПоиска = "";
	Бренд = StockAPI_Справочники.НайтиБренд(СтрокаБренда, ОшибкаПоиска);
	Если ОшибкаПоиска <> "" Тогда
		Результат.Ошибка = ОшибкаПоиска;
		Возврат Результат;
	КонецЕсли;
	
	Результат.Бренд = Бренд;
	Возврат Результат;
	
КонецФункции


// Фильтр по складу: warehouseId, warehouseCode, code (числовой код) или warehouse (наименование).
// Если параметр склада задан — возвращает доступные склады с учётом отбора;
// если не задан — массив всех разрешённых складов учётной записи.
//
Функция РазрешенныйСкладИзЗапроса(Запрос, УчетаяЗапись) Экспорт
	
	Результат = Новый Структура("Склады, Ошибка", Неопределено, "");
	
	ПараметрКода = Запрос.ПараметрыЗапроса.Получить("warehouseId");
	Если ПараметрКода = Неопределено Тогда
		ПараметрКода = Запрос.ПараметрыЗапроса.Получить("warehouseCode");
	КонецЕсли;
	Если ПараметрКода = Неопределено Тогда
		ПараметрКода = Запрос.ПараметрыЗапроса.Получить("code");
	КонецЕсли;
	
	КодЧисло = Неопределено;
	ИмяСклада = Неопределено;
	Если ПараметрКода <> Неопределено Тогда
		Попытка
			КодЧисло = Число(СокрЛП(Строка(ПараметрКода)));
		Исключение
			Результат.Ошибка = "Параметр warehouseId (или warehouseCode) должен быть числовым кодом склада.";
			Возврат Результат;
		КонецПопытки;
	Иначе
		СтрокаИмени = StockAPI_Утилиты.СтрокаПараметраЗапроса(Запрос, "warehouse");
		Если СтрокаИмени <> "" Тогда
			ИмяСклада = СтрокаИмени;
		КонецЕсли;
	КонецЕсли;
	
	Запр = Новый Запрос;  
	Запр.УстановитьПараметр("Код", КодЧисло);
	Запр.УстановитьПараметр("ИмяСклада", ИмяСклада);
	
	Если StockAPI_Утилиты.ЭтоАдминистраторAPI(УчетаяЗапись) Тогда
		Запр.УстановитьПараметр("ОбщиеСклады", StockAPI_Утилиты.СкладыОбщиеДляВсехУчетныхЗаписейAPI());
		Запр.Текст = "ВЫБРАТЬ
		             |	Склады.Ссылка КАК Склад
		             |ИЗ
		             |	Справочник.Склады КАК Склады
		             |ГДЕ
		             |	Склады.Ссылка В (&ОбщиеСклады)
		             |	И НЕ Склады.ПометкаУдаления
		             |	И ВЫБОР
		             |			КОГДА &Код = НЕОПРЕДЕЛЕНО
		             |				ТОГДА ИСТИНА
		             |			ИНАЧЕ Склады.Код = &Код
		             |		КОНЕЦ
		             |	И ВЫБОР
		             |			КОГДА &ИмяСклада = НЕОПРЕДЕЛЕНО
		             |				ТОГДА ИСТИНА
		             |			ИНАЧЕ Склады.Наименование = &ИмяСклада
		             |		КОНЕЦ";
	Иначе
		Запр.УстановитьПараметр("УчетаяЗапись", УчетаяЗапись);
		Запр.Текст = "ВЫБРАТЬ
		             |	Склады.Склад КАК Склад
		             |ИЗ
		             |	Справочник.УчетныеЗаписиИнтеграции.Склады КАК Склады
		             |ГДЕ
		             |	Склады.Ссылка = &УчетаяЗапись
		             |	И НЕ Склады.Склад.ПометкаУдаления
		             |	И ВЫБОР
		             |			КОГДА &Код = НЕОПРЕДЕЛЕНО
		             |				ТОГДА ИСТИНА
		             |			ИНАЧЕ Склады.Склад.Код = &Код
		             |		КОНЕЦ
		             |	И ВЫБОР
		             |			КОГДА &ИмяСклада = НЕОПРЕДЕЛЕНО
		             |				ТОГДА ИСТИНА
		             |			ИНАЧЕ Склады.Склад.Наименование = &ИмяСклада
		             |		КОНЕЦ";
	КонецЕсли;
	
	РезультатЗапроса = Запр.Выполнить();
	Если РезультатЗапроса.Пустой() Тогда
		Результат.Ошибка = "Нет доступа к указанному складу.";
	Иначе	
		Результат.Склады = РезультатЗапроса.Выгрузить().ВыгрузитьКолонку("Склад");
	КонецЕсли;  
	
 	Возврат Результат;
	
КонецФункции

#Область WebHook
	
// ───  WebHook остатки товара ──────────────────────────────────────────────

// ПередЗаписью: при Замещение=Истина старые движения ещё доступны
// (нужно для отмены проведения, когда новый набор пустой).
//
Процедура WebHookОстаткиПередЗаписью(Источник, Отказ, Замещение) Экспорт
	
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	ИзмененияОстатков = Новый ТаблицаЗначений;
	ИзмененияОстатков.Колонки.Добавить("Номенклатура", Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	ИзмененияОстатков.Колонки.Добавить("Склад", Новый ОписаниеТипов("СправочникСсылка.Склады"));
	
	Для Каждого ЗаписьНабора Из Источник Цикл
		ДобавитьИзменениеОстатковДляWebHook(ИзмененияОстатков, ЗаписьНабора.Номенклатура, ЗаписьНабора.Склад);
	КонецЦикла;
	
	Регистратор = РегистраторНабораОстатков(Источник);
	Если Замещение И ЗначениеЗаполнено(Регистратор) Тогда
		ДобавитьСтарыеИзмененияОстатковДляWebHook(ИзмененияОстатков, Регистратор);
	КонецЕсли;
	
	Если ИзмененияОстатков.Количество() > 0 Тогда
		Источник.ДополнительныеСвойства.Вставить("StockAPI_ИзмененияПарОстатков", ИзмененияОстатков.Скопировать());
	КонецЕсли;
	
	ПоставитьВОчередьИзмененияОстатков(ИзмененияОстатков, Регистратор);
		
КонецПроцедуры

// Ставит пары номенклатура/склад в очередь webhook остатков.
//
// Параметры:
//  ИзмененияОстатков - ТаблицаЗначений - колонки Номенклатура, Склад;
//  Инициатор         - ДокументСсылка, Неопределено - документ-инициатор события.
//
Процедура ПоставитьВОчередьИзмененияОстатков(ИзмененияОстатков, Инициатор) Экспорт
	
	Если ИзмененияОстатков = Неопределено ИЛИ ИзмененияОстатков.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ИзмененияОстатков", ИзмененияОстатков);
	Запрос.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
	               |	ИзмененияОстатков.Номенклатура КАК Номенклатура,
	               |	ИзмененияОстатков.Склад КАК Склад
	               |ПОМЕСТИТЬ ИзмененияОстатков
	               |ИЗ
	               |	&ИзмененияОстатков КАК ИзмененияОстатков
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ РАЗЛИЧНЫЕ
	               |	УчетныеЗаписи.Ссылка КАК УчетнаяЗапись,
	               |	ИзмененияОстатков.Номенклатура КАК Номенклатура,
	               |	ИзмененияОстатков.Склад КАК Склад
	               |ИЗ
	               |	ИзмененияОстатков КАК ИзмененияОстатков
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.УчетныеЗаписиИнтеграции.Склады КАК СкладыУчетныхЗаписей
	               |		ПО ИзмененияОстатков.Склад = СкладыУчетныхЗаписей.Склад
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Склады КАК СправочникСклады
	               |		ПО ИзмененияОстатков.Склад = СправочникСклады.Ссылка
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.УчетныеЗаписиИнтеграции КАК УчетныеЗаписи
	               |		ПО СкладыУчетныхЗаписей.Ссылка = УчетныеЗаписи.Ссылка
	               |ГДЕ
	               |	УчетныеЗаписи.Активен
	               |	И УчетныеЗаписи.WebhookАктивен
	               |	И УчетныеЗаписи.ОтправлятьОстатки
	               |	И УчетныеЗаписи.WebhookURL <> """"
	               |	И НЕ СправочникСклады.ПометкаУдаления";
	
	УстановитьПривилегированныйРежим(Истина);
	РезультатыЗапроса = Запрос.ВыполнитьПакет();
	Выборка = РезультатыЗапроса[1].Выбрать();
	
	Пока Выборка.Следующий() Цикл
		ПерезаполнитьОчередьWebHookОстатки(Выборка.УчетнаяЗапись, Выборка.Номенклатура, Выборка.Склад, Инициатор);
	КонецЦикла;
	УстановитьПривилегированныйРежим(Ложь);
	
КонецПроцедуры

Процедура ДобавитьИзменениеОстатковДляWebHook(ИзмененияОстатков, Номенклатура, Склад)
	
	Если НЕ ЗначениеЗаполнено(Номенклатура)
		Или НЕ ЗначениеЗаполнено(Склад) Тогда
		Возврат;
	КонецЕсли;
	
	НайдСтроки = ИзмененияОстатков.НайтиСтроки(Новый Структура("Номенклатура,Склад", Номенклатура, Склад));
	Если НайдСтроки.Количество() > 0 Тогда
		Возврат;
	КонецЕсли;
	
	НоваяСтрока = ИзмененияОстатков.Добавить();
	НоваяСтрока.Номенклатура = Номенклатура;
	НоваяСтрока.Склад = Склад;
	
КонецПроцедуры

Функция РегистраторНабораОстатков(Источник)
	
	Попытка
		Если Источник.Отбор.Регистратор.Использование Тогда
			Возврат Источник.Отбор.Регистратор.Значение;
		КонецЕсли;
	Исключение
	КонецПопытки;
	
	Возврат Неопределено;
	
КонецФункции

Процедура ДобавитьСтарыеИзмененияОстатковДляWebHook(ИзмененияОстатков, Регистратор)
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Регистратор", Регистратор);
	Запрос.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
	               |	ОстаткиТовара.Номенклатура КАК Номенклатура,
	               |	ОстаткиТовара.Склад КАК Склад
	               |ИЗ
	               |	РегистрНакопления.ОстаткиТовара КАК ОстаткиТовара
	               |ГДЕ
	               |	ОстаткиТовара.Регистратор = &Регистратор";
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		ДобавитьИзменениеОстатковДляWebHook(ИзмененияОстатков, Выборка.Номенклатура, Выборка.Склад);
	КонецЦикла;
	
КонецПроцедуры

Процедура ПерезаполнитьОчередьWebHookОстатки(УчетнаяЗапись, Номенклатура, Склад, Регистратор)
	
	ТипСобытия = Перечисления.ТипыСобытийWebHooks.Остаток;
	ПустойВидЦены = Справочники.ВидыЦен.ПустаяСсылка();
	ПустаяДатаОтправки = Дата(1, 1, 1);
	
	УдалитьНеотправленныеЗаписиОчередиWebHookОстатки(УчетнаяЗапись, Номенклатура, Склад, ТипСобытия, ПустойВидЦены, ПустаяДатаОтправки);
	
	НоваяЗапись = РегистрыСведений.ОчередьWebHook.СоздатьМенеджерЗаписи();
	НоваяЗапись.ИД 				= Новый УникальныйИдентификатор;
	НоваяЗапись.УчетнаяЗапись 	= УчетнаяЗапись;
	НоваяЗапись.ТипСобытия 		= ТипСобытия;
	НоваяЗапись.Номенклатура 	= Номенклатура;
	НоваяЗапись.Склад 			= Склад;
	НоваяЗапись.ВидЦены 		= ПустойВидЦены;
	НоваяЗапись.Отправлен 		= ПустаяДатаОтправки;
	НоваяЗапись.Создан 			= ТекущаяДатаСеанса();
	НоваяЗапись.КоличествоПопыток = 0;
	НоваяЗапись.Ошибка 			= "";
	
	Если ЗначениеЗаполнено(Регистратор) Тогда
		Попытка
			НоваяЗапись.Инициатор = Регистратор;
		Исключение
		КонецПопытки;
	КонецЕсли;
	
	НоваяЗапись.Записать();
	
КонецПроцедуры

Процедура УдалитьНеотправленныеЗаписиОчередиWebHookОстатки(УчетнаяЗапись, Номенклатура, Склад, ТипСобытия, ПустойВидЦены, ПустаяДатаОтправки)
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("УчетнаяЗапись", УчетнаяЗапись);
	Запрос.УстановитьПараметр("ТипСобытия", ТипСобытия);
	Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
	Запрос.УстановитьПараметр("Склад", Склад);
	Запрос.УстановитьПараметр("ВидЦены", ПустойВидЦены);
	Запрос.УстановитьПараметр("Отправлен", ПустаяДатаОтправки);
	Запрос.Текст = "ВЫБРАТЬ
	               |	ОчередьWebHook.ИД КАК ИД,
	               |	ОчередьWebHook.УчетнаяЗапись КАК УчетнаяЗапись,
	               |	ОчередьWebHook.ТипСобытия КАК ТипСобытия,
	               |	ОчередьWebHook.Номенклатура КАК Номенклатура,
	               |	ОчередьWebHook.Склад КАК Склад,
	               |	ОчередьWebHook.ВидЦены КАК ВидЦены,
	               |	ОчередьWebHook.Отправлен КАК Отправлен
	               |ИЗ
	               |	РегистрСведений.ОчередьWebHook КАК ОчередьWebHook
	               |ГДЕ
	               |	ОчередьWebHook.УчетнаяЗапись = &УчетнаяЗапись
	               |	И ОчередьWebHook.ТипСобытия = &ТипСобытия
	               |	И ОчередьWebHook.Номенклатура = &Номенклатура
	               |	И ОчередьWebHook.Склад = &Склад
	               |	И ОчередьWebHook.ВидЦены = &ВидЦены
	               |	И ОчередьWebHook.Отправлен = &Отправлен";
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		ЗаписьОчереди = РегистрыСведений.ОчередьWebHook.СоздатьМенеджерЗаписи();
		ЗаполнитьЗначенияСвойств(ЗаписьОчереди, Выборка);
		ЗаписьОчереди.Удалить();
	КонецЦикла;
	
КонецПроцедуры 

#КонецОбласти
