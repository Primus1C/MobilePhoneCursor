// Истина, если в запросе задан хотя бы один параметр отбора склада.
//
Функция СкладЗаданВЗапросе(Запрос)
	
	Если Запрос.ПараметрыЗапроса.Получить("warehouseId") <> Неопределено Тогда
		Возврат Истина;
	КонецЕсли;
	Если Запрос.ПараметрыЗапроса.Получить("warehouseCode") <> Неопределено Тогда
		Возврат Истина;
	КонецЕсли;
	Если Запрос.ПараметрыЗапроса.Получить("code") <> Неопределено Тогда
		Возврат Истина;
	КонецЕсли;
	Если StockAPI_Утилиты.СтрокаПараметраЗапроса(Запрос, "warehouse") <> "" Тогда
		Возврат Истина;
	КонецЕсли;
	
	Возврат Ложь;
	
КонецФункции

// Разбор параметра grouped (true/false, 1/0, yes/no). Пустой параметр — Ложь.
//
// Возвращаемое значение:
//  Структура - поля Значение (Булево), Ошибка (Строка).
//
Функция ПараметрGroupedИзЗапроса(Запрос)
	
	Результат = Новый Структура("Значение, Ошибка", Ложь, "");
	СтрокаПараметра = StockAPI_Утилиты.СтрокаПараметраЗапроса(Запрос, "grouped");
	Если СтрокаПараметра = "" Тогда
		Возврат Результат;
	КонецЕсли;
	
	СтрокаНорм = НРег(СокрЛП(СтрокаПараметра));
	Если СтрокаНорм = "true" Или СтрокаНорм = "1" Или СтрокаНорм = "yes" Тогда
		Результат.Значение = Истина;
	ИначеЕсли СтрокаНорм = "false" Или СтрокаНорм = "0" Или СтрокаНорм = "no" Тогда
		Результат.Значение = Ложь;
	Иначе
		Результат.Ошибка = "Параметр grouped: допустимы true, false, 1, 0, yes, no.";
	КонецЕсли;
	Возврат Результат;
	
КонецФункции

// Опциональный фильтр search — список серий через запятую (точное совпадение с Партии.Серия).
//
// Возвращаемое значение:
//  Структура - поля Серии (Массив), Ошибка (Строка). Пустой массив — фильтр не задан.
//
Функция СерииПоискаИзЗапроса(Запрос)
	
	Результат = Новый Структура("Серии, Ошибка", Новый Массив, "");
	СтрокаСерий = StockAPI_Утилиты.СтрокаПараметраЗапроса(Запрос, "search");
	Если СтрокаСерий = "" Тогда
		Возврат Результат;
	КонецЕсли;
	
	УникальныеСерии = Новый Соответствие;
	Части = СтрРазделить(СтрокаСерий, ",", Ложь);
	Для Каждого Часть Из Части Цикл
		Серия = СокрЛП(Часть);
		Если Серия = "" Тогда
			Продолжить;
		КонецЕсли;
		УникальныеСерии.Вставить(Серия, Истина);
	КонецЦикла;
	
	Если УникальныеСерии.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;
	
	Для Каждого КлючИЗначение Из УникальныеСерии Цикл
		Результат.Серии.Добавить(КлючИЗначение.Ключ);
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// Формирует массив items для ответа GET /leftoverSeries.
//
// Параметры:
//  Склад         - СправочникСсылка.Склады - склад отбора;
//  Сгруппировано - Булево - группировать серии по товару;
//  СерииПоиска   - Массив - необязательный список серий для отбора (пустой — все серии на остатке).
//
// Возвращаемое значение:
//  Массив - элементы ответа API.
//
Функция ЭлементыСерийОстатковСклада(Склад, Сгруппировано, СерииПоиска = Неопределено)
	
	МассивЭлементов = Новый Массив;
	ФильтрПоСериям = СерииПоиска <> Неопределено И СерииПоиска.Количество() > 0;
	
	Запр = Новый Запрос;
	Запр.УстановитьПараметр("Склад", Склад);
	Запр.УстановитьПараметр("ФильтрПоСериям", ФильтрПоСериям);
	Запр.УстановитьПараметр("СерииПоиска", ?(ФильтрПоСериям, СерииПоиска, Новый Массив));
	Запр.Текст = "ВЫБРАТЬ
	             |	Ост.Номенклатура КАК Номенклатура,
	             |	Ост.Номенклатура.Код КАК КодНоменклатуры,
	             |	Ост.Номенклатура.Наименование КАК Наименование,
	             |	Ост.Партия.Серия КАК Серия
	             |ИЗ
	             |	РегистрНакопления.ОстаткиТовара.Остатки(, Склад = &Склад) КАК Ост
	             |ГДЕ
	             |	Ост.ОстатокОстаток >= 1
	             |	И Ост.Номенклатура.УчетПоСериям
	             |	И Ост.Партия.Серия <> """"
	             |	И НЕ Ост.Номенклатура.ПометкаУдаления
	             |	И (НЕ &ФильтрПоСериям
	             |		ИЛИ Ост.Партия.Серия В (&СерииПоиска))
	             |	И НЕ Ост.Партия.Серия В
	             |			(ВЫБРАТЬ
	             |				Буфер.Серия
	             |			ИЗ
	             |				РегистрСведений.БуферСканированияДляОстатков КАК Буфер
	             |			ГДЕ
	             |				Буфер.Склад = &Склад)
	             |
	             |УПОРЯДОЧИТЬ ПО
	             |	Наименование,
	             |	Серия";
	
	Выборка = Запр.Выполнить().Выбрать();
	
	Если Не Сгруппировано Тогда
		
		Пока Выборка.Следующий() Цикл
			Серия = СокрЛП(Выборка.Серия);
			Если Серия = "" Тогда
				Продолжить;
			КонецЕсли;
			Элемент = Новый Структура;
			Элемент.Вставить("item", Выборка.Наименование);
			Элемент.Вставить("itemCode", StockAPI_Утилиты.КодВСтроку(Выборка.КодНоменклатуры));
			Элемент.Вставить("serial", Серия);
			МассивЭлементов.Добавить(Элемент);
		КонецЦикла;
		
		Возврат МассивЭлементов;
		
	КонецЕсли;
	
	ТекущаяНоменклатура = Справочники.Номенклатура.ПустаяСсылка();
	Позиция = Неопределено;
	МассивСерий = Неопределено;
	
	Пока Выборка.Следующий() Цикл
		
		Серия = СокрЛП(Выборка.Серия);
		Если Серия = "" Тогда
			Продолжить;
		КонецЕсли;
		
		Если Выборка.Номенклатура <> ТекущаяНоменклатура Тогда
			
			Если Позиция <> Неопределено Тогда
				Позиция.Вставить("serials", МассивСерий);
				МассивЭлементов.Добавить(Позиция);
			КонецЕсли;
			
			ТекущаяНоменклатура = Выборка.Номенклатура;
			Позиция = Новый Структура;
			Позиция.Вставить("item", Выборка.Наименование);
			Позиция.Вставить("itemCode", StockAPI_Утилиты.КодВСтроку(Выборка.КодНоменклатуры));
			МассивСерий = Новый Массив;
			
		КонецЕсли;
		
		ДобавитьСериюВМассивБезДубликата(МассивСерий, Серия);
		
	КонецЦикла;
	
	Если Позиция <> Неопределено Тогда
		Позиция.Вставить("serials", МассивСерий);
		МассивЭлементов.Добавить(Позиция);
	КонецЕсли;
	
	Возврат МассивЭлементов;
	
КонецФункции

// Добавляет серию в массив без дубликатов.
//
Процедура ДобавитьСериюВМассивБезДубликата(МассивСерий, ЗначениеСерии)
	
	Серия = СокрЛП(ЗначениеСерии);
	Если Серия = "" Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого Существующая Из МассивСерий Цикл
		Если Существующая = Серия Тогда
			Возврат;
		КонецЕсли;
	КонецЦикла;
	
	МассивСерий.Добавить(Серия);
	
КонецПроцедуры

