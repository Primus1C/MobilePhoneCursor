
#Область ПрограммныйИнтерфейс

// Возвращает жёстко заданные параметры HTTP-обмена FinCore.
//
// Возвращаемое значение:
//  Структура:
//   * АдресСервиса - Строка - полный URL метода приёма, например http://host/FinCore/hs/Exchange/AllInOne;
//   * Пользователь - Строка - пользователь ИБ публикации HTTP-сервиса приёмника;
//   * Пароль       - Строка - пароль этого пользователя;
//   * Таймаут      - Число - таймаут соединения в секундах;
//   * РазмерПорции - Число - максимум объектов в одном POST;
//   * ИмяУзла      - Строка - наименование узла-получателя плана ОбменFinCore.
//
Функция ПараметрыОбмена() Экспорт
	
	Параметры = Новый Структура;
	Параметры.Вставить("АдресСервиса", "http://localhost/fincore/hs/Exchange/AllInOne");
	Параметры.Вставить("Пользователь", "exchange");
	Параметры.Вставить("Пароль", "root");
	Параметры.Вставить("Таймаут", 60);
	Параметры.Вставить("РазмерПорции", 10);
	Параметры.Вставить("ИмяУзла", "FinCore");
	Возврат Параметры;
	
КонецФункции

// Выгружает зарегистрированные изменения узла FinCore порциями до подтверждения.
//
// Возвращаемое значение:
//  Строка - краткий итог для формы.
//
Функция ВыполнитьОбмен() Экспорт
	
	Параметры = ПараметрыОбмена();
	Узел = УзелПолучателя(Параметры.ИмяУзла);
	Если Узел = Неопределено Тогда
		Текст = СтрШаблон("Не найден узел-получатель с наименованием %1", Параметры.ИмяУзла);
		ЗаписатьОшибку("", Неопределено, Текст);
		Возврат Текст;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Параметры.АдресСервиса) Тогда
		Текст = "Не заполнен адрес HTTP-сервиса в функции ПараметрыОбмена";
		ЗаписатьОшибку("", Неопределено, Текст);
		Возврат Текст;
	КонецЕсли;
	
	ВсегоПодтверждено = 0;
	НомерПорции = 0;
	
	Пока Истина Цикл
		НомерПорции = НомерПорции + 1;
		РезультатПорции = ВыгрузитьПорцию(Узел, Параметры);
		ВсегоПодтверждено = ВсегоПодтверждено + РезультатПорции.Подтверждено;
		
		Если РезультатПорции.ОшибкаТранспорта Тогда
			Прервать;
		КонецЕсли;
		Если РезультатПорции.Упаковано = 0 Тогда
			Прервать;
		КонецЕсли;
		Если РезультатПорции.Подтверждено = 0 Тогда
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Возврат СтрШаблон("Обмен FinCore: порций %1, подтверждено объектов %2", НомерПорции, ВсегоПодтверждено);
	
КонецФункции

// Обработчик регламентного задания обмена FinCore.
//
Процедура ВыполнитьОбменРегламент() Экспорт
	
	ВыполнитьОбмен();
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Возвращает ссылку узла плана ОбменFinCore по наименованию.
//
// Параметры:
//  ИмяУзла - Строка - наименование узла-получателя.
//
// Возвращаемое значение:
//  ПланОбменаСсылка.ОбменFinCore, Неопределено - найденный узел.
//
Функция УзелПолучателя(ИмяУзла)
	
	Узел = ПланыОбмена.ОбменFinCore.НайтиПоНаименованию(ИмяУзла, Истина);
	Если Не ЗначениеЗаполнено(Узел) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Если Узел = ПланыОбмена.ОбменFinCore.ЭтотУзел() Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Узел;
	
КонецФункции

// Собирает порцию изменений, отправляет POST и снимает регистрацию по подтверждённым GUID.
//
// Параметры:
//  Узел      - ПланОбменаСсылка.ОбменFinCore - узел-получатель;
//  Параметры - Структура - параметры из ПараметрыОбмена.
//
// Возвращаемое значение:
//  Структура:
//   * Упаковано          - Число;
//   * Подтверждено       - Число;
//   * ОшибкаТранспорта   - Булево.
//
Функция ВыгрузитьПорцию(Узел, Параметры)
	
	Результат = Новый Структура("Упаковано, Подтверждено, ОшибкаТранспорта", 0, 0, Ложь);
	
	Пакет = Новый Структура;
	КартаСсылок = Новый Соответствие;
	НомерСообщения = Узел.НомерОтправленного + 1;
	Выборка = ПланыОбмена.ВыбратьИзменения(Узел, НомерСообщения);
	
	Пока Выборка.Следующий() И Результат.Упаковано < Параметры.РазмерПорции Цикл
		Данные = Выборка.Получить();
		Если ТипЗнч(Данные) = Тип("РегистрСведенийНаборЗаписей.КурсыВалют") Тогда
			ДобавитьКурсыВалютВПакет(Узел, Данные, Пакет, КартаСсылок, Результат, Параметры.РазмерПорции);
			Продолжить;
		КонецЕсли;
		СсылкаОбъекта = СсылкаДанныхОбмена(Данные);
		Если СсылкаОбъекта = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		МетаданныеОбъекта = СсылкаОбъекта.Метаданные();
		Если ЭтоОтложенныйТип(МетаданныеОбъекта) Тогда
			Продолжить;
		КонецЕсли;
		Если Не ЭтоВыгружаемыйТип(МетаданныеОбъекта) Тогда
			ЗаписатьОшибку(
				Строка(СсылкаОбъекта.УникальныйИдентификатор()),
				СсылкаОбъекта,
				СтрШаблон("Неизвестный тип объекта обмена: %1", МетаданныеОбъекта.ПолноеИмя()));
			Продолжить;
		КонецЕсли;
		
		Если ТипЗнч(Данные) <> Тип("УдалениеОбъекта")
			И КартаСсылок.Получить(Строка(СсылкаОбъекта.УникальныйИдентификатор())) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		КлючТипа = КлючТипаJSON(МетаданныеОбъекта);
		СтруктураОбъекта = СформироватьСтруктуруОбъекта(Данные, СсылкаОбъекта, МетаданныеОбъекта);
		Если Не Пакет.Свойство(КлючТипа) Тогда
			Пакет.Вставить(КлючТипа, Новый Массив);
		КонецЕсли;
		Пакет[КлючТипа].Добавить(СтруктураОбъекта);
		КартаСсылок.Вставить(СтруктураОбъекта.GUID, СсылкаОбъекта);
		Результат.Упаковано = Результат.Упаковано + 1;
		Если ТипЗнч(Данные) <> Тип("УдалениеОбъекта") И МетаданныеОбъекта.Имя = "_Инвойс" Тогда
			ДобавитьДокументОснованиеИнвойсаВПакет(Узел, Данные, Пакет, КартаСсылок);
		КонецЕсли;
	КонецЦикла;
	
	Если Результат.Упаковано = 0 Тогда
		Возврат Результат;
	КонецЕсли;
	
	Тело = СформироватьJSON(Пакет);
	ОтветСтрока = ОтправитьПакет(Параметры, Тело, Результат);
	Если Результат.ОшибкаТранспорта Тогда
		Возврат Результат;
	КонецЕсли;
	
	Попытка
		СтруктураОтвета = СформироватьСтруктуруИзJSON(ОтветСтрока);
	Исключение
		ЗаписатьОшибку("", Неопределено, СтрШаблон("Не удалось разобрать ответ приёмника: %1", ОписаниеОшибки()));
		Результат.ОшибкаТранспорта = Истина;
		Возврат Результат;
	КонецПопытки;
	Если ТипЗнч(СтруктураОтвета) <> Тип("Структура") Тогда
		ЗаписатьОшибку("", Неопределено, "Ответ приёмника не является JSON-объектом");
		Результат.ОшибкаТранспорта = Истина;
		Возврат Результат;
	КонецЕсли;
	
	Если СтруктураОтвета.Свойство("Report") И ТипЗнч(СтруктураОтвета.Report) = Тип("Массив") Тогда
		Для Каждого СтрокаОтчета Из СтруктураОтвета.Report Цикл
			ЗаписатьОшибку("", Неопределено, Строка(СтрокаОтчета));
		КонецЦикла;
	КонецЕсли;
	
	Для Каждого КлючИЗначение Из СтруктураОтвета Цикл
		Если КлючИЗначение.Ключ = "Report" Или КлючИЗначение.Ключ = "Errors" Тогда
			Продолжить;
		КонецЕсли;
		Если ТипЗнч(КлючИЗначение.Значение) <> Тип("Массив") Тогда
			Продолжить;
		КонецЕсли;
		Для Каждого GUIDСтрока Из КлючИЗначение.Значение Цикл
			СсылкаОбъекта = КартаСсылок.Получить(GUIDСтрока);
			Если СсылкаОбъекта = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			ПланыОбмена.УдалитьРегистрациюИзменений(Узел, СсылкаОбъекта);
			Результат.Подтверждено = Результат.Подтверждено + 1;
		КонецЦикла;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// Кладёт в тот же пакет полный документ основания инвойса.
// Краткая ссылка в реквизите не содержит данных документа: приёмник только ищет уже загруженный объект.
//
// Параметры:
//  Узел         - ПланОбменаСсылка.ОбменFinCore - узел-получатель;
//  ДанныеИнвойса - ДокументОбъект._Инвойс - выгружаемый инвойс;
//  Пакет        - Структура - JSON-пакет порции;
//  КартаСсылок  - Соответствие - GUID источника и ссылка для снятия регистрации.
//
Процедура ДобавитьДокументОснованиеИнвойсаВПакет(Узел, ДанныеИнвойса, Пакет, КартаСсылок)
	
	СсылкаОснования = ДанныеИнвойса.ДокументОснование;
	Если Не ЗначениеЗаполнено(СсылкаОснования) Тогда
		Возврат;
	КонецЕсли;
	
	МетаданныеОснования = СсылкаОснования.Метаданные();
	Если Не ЭтоВыгружаемыйТип(МетаданныеОснования) Или ЭтоОтложенныйТип(МетаданныеОснования) Тогда
		Возврат;
	КонецЕсли;
	
	ГуидОснования = Строка(СсылкаОснования.УникальныйИдентификатор());
	Если КартаСсылок.Получить(ГуидОснования) <> Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ДанныеОснования = СсылкаОснования.ПолучитьОбъект();
	Если ДанныеОснования = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ПланыОбмена.ЗарегистрироватьИзменения(Узел, СсылкаОснования);
	
	КлючТипа = КлючТипаJSON(МетаданныеОснования);
	СтруктураОбъекта = СформироватьСтруктуруОбъекта(ДанныеОснования, СсылкаОснования, МетаданныеОснования);
	Если Не Пакет.Свойство(КлючТипа) Тогда
		Пакет.Вставить(КлючТипа, Новый Массив);
	КонецЕсли;
	Пакет[КлючТипа].Добавить(СтруктураОбъекта);
	КартаСсылок.Вставить(СтруктураОбъекта.GUID, СсылкаОснования);
	
КонецПроцедуры

// Возвращает ссылку объекта из данных выборки изменений плана обмена.
//
// Параметры:
//  Данные - Произвольный - элемент выборки ПланыОбмена.ВыбратьИзменения.
//
// Возвращаемое значение:
//  ЛюбаяСсылка, Неопределено - ссылка объекта или Неопределено.
//
Функция СсылкаДанныхОбмена(Данные)
	
	Если ТипЗнч(Данные) = Тип("УдалениеОбъекта") Тогда
		Возврат Данные.Ссылка;
	КонецЕсли;
	Если Данные = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Попытка
		Возврат Данные.Ссылка;
	Исключение
		Возврат Неопределено;
	КонецПопытки;
	
КонецФункции

// Проверяет, что тип отложен на этап маппинга и не выгружается.
//
// Параметры:
//  МетаданныеОбъекта - ОбъектМетаданных - метаданные объекта очереди.
//
// Возвращаемое значение:
//  Булево - Истина, если тип не выгружается в этой задаче.
//
Функция ЭтоОтложенныйТип(МетаданныеОбъекта)
	
	ПолноеИмя = МетаданныеОбъекта.ПолноеИмя();
	Отложенные = Новый Соответствие;
	Отложенные.Вставить("Справочник.Производители", Истина);
	Отложенные.Вставить("Документ.ДвижениеДенег", Истина);
	Возврат Отложенные.Получить(ПолноеИмя) = Истина;
	
КонецФункции

// Проверяет, что тип входит в текущий состав выгрузки FinCore.
//
// Параметры:
//  МетаданныеОбъекта - ОбъектМетаданных - метаданные объекта очереди.
//
// Возвращаемое значение:
//  Булево - Истина, если объект выгружается.
//
Функция ЭтоВыгружаемыйТип(МетаданныеОбъекта)
	
	Возврат Не КлючТипаJSON(МетаданныеОбъекта) = "";
	
КонецФункции

// Возвращает ключ массива JSON для типа объекта источника.
//
// Параметры:
//  МетаданныеОбъекта - ОбъектМетаданных - метаданные объекта.
//
// Возвращаемое значение:
//  Строка - ключ JSON или пустая строка.
//
Функция КлючТипаJSON(МетаданныеОбъекта)
	
	Ключи = Новый Соответствие;
	Ключи.Вставить("Справочник.Валюты", "Валюты");
	Ключи.Вставить("РегистрСведений.КурсыВалют", "КурсыВалют");
	Ключи.Вставить("Справочник.ВидыЦен", "ВидыЦен");
	Ключи.Вставить("Справочник.Города", "Города");
	Ключи.Вставить("Справочник.ГруппыПодбораНоменклатуры", "ГруппыПодбораНоменклатуры");
	Ключи.Вставить("Справочник.ДенежныеСчета", "ДенежныеСчета");
	Ключи.Вставить("Справочник.Контрагенты", "Контрагенты");
	Ключи.Вставить("Справочник.Номенклатура", "Номенклатура");
	Ключи.Вставить("Справочник.Партии", "Партии");
	Ключи.Вставить("Справочник.Пользователи", "Пользователи");
	Ключи.Вставить("Справочник.Склады", "Склады");
	Ключи.Вставить("Справочник.Сотрудники", "Сотрудники");
	Ключи.Вставить("Справочник.Страны", "Страны");
	Ключи.Вставить("Документ.ПриходнаяНакладная", "ПриходнаяНакладная");
	Ключи.Вставить("Документ.РасходнаяНакладная", "РасходнаяНакладная");
	Ключи.Вставить("Документ.Перемещение", "Перемещение");
	Ключи.Вставить("Документ.ВозвратПоставщику", "ВозвратПоставщику");
	Ключи.Вставить("Документ._ВозвратОтПокупателя", "ВозвратОтПокупателя");
	Ключи.Вставить("Документ._Инвойс", "Инвойс");
	Ключи.Вставить("Документ.ИнвойсЗакупки", "ИнвойсЗакупки");
	Ключи.Вставить("Документ.ИнвойсПродажи", "ИнвойсПродажи");
	Ключи.Вставить("Документ.ВКД_ДополнительныеЗатраты", "КассовыйОрдер");
	Ключи.Вставить("Справочник.ТоварныеГруппыПеревозчиков", "ТоварныеГруппыПеревозчиков");
	Ключи.Вставить("Документ.Отправка", "Отправка");
	Ключи.Вставить("Документ.ОтправкаAWB", "ОтправкаAWB");
	Ключи.Вставить("Документ.ОтправкаПеремещений", "ОтправкаПеремещений");
	Результат = Ключи.Получить(МетаданныеОбъекта.ПолноеИмя());
	Если Результат = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	Возврат Результат;
	
КонецФункции

// Формирует JSON-структуру объекта обмена.
//
// Параметры:
//  Данные             - Произвольный - объект или УдалениеОбъекта;
//  СсылкаОбъекта      - ЛюбаяСсылка - ссылка;
//  МетаданныеОбъекта  - ОбъектМетаданных - метаданные.
//
// Возвращаемое значение:
//  Структура - данные для JSON.
//
Функция СформироватьСтруктуруОбъекта(Данные, СсылкаОбъекта, МетаданныеОбъекта)
	
	ЭтоУдаление = ТипЗнч(Данные) = Тип("УдалениеОбъекта");
	СтруктураОбъекта = Новый Структура;
	СтруктураОбъекта.Вставить("GUID", Строка(СсылкаОбъекта.УникальныйИдентификатор()));
	СтруктураОбъекта.Вставить("Type", КлючТипаJSON(МетаданныеОбъекта));
	
	Если ЭтоУдаление Тогда
		СтруктураОбъекта.Вставить("DelMark", "1");
		СтруктураОбъекта.Вставить("Posted", "0");
		Возврат СтруктураОбъекта;
	КонецЕсли;
	
	СтруктураОбъекта.Вставить("DelMark", ?(СсылкаОбъекта.ПометкаУдаления, "1", "0"));
	
	Если Метаданные.Справочники.Содержит(МетаданныеОбъекта) Тогда
		ДополнитьСтруктуруСправочника(СтруктураОбъекта, Данные, МетаданныеОбъекта);
	ИначеЕсли Метаданные.Документы.Содержит(МетаданныеОбъекта) Тогда
		ДополнитьСтруктуруДокумента(СтруктураОбъекта, Данные, МетаданныеОбъекта);
	КонецЕсли;
	
	Возврат СтруктураОбъекта;
	
КонецФункции

// Добавляет в структуру стандартные поля справочника и вложенные ссылки.
//
// Параметры:
//  СтруктураОбъекта  - Структура - заполняемая структура JSON;
//  Данные            - СправочникОбъект - объект справочника;
//  МетаданныеОбъекта - ОбъектМетаданных - метаданные справочника.
//
Процедура ДополнитьСтруктуруСправочника(СтруктураОбъекта, Данные, МетаданныеОбъекта)
	
	СтруктураОбъекта.Вставить("Code", Строка(Данные.Код));
	СтруктураОбъекта.Вставить("Description", Строка(Данные.Наименование));
	Если МетаданныеОбъекта.Иерархический Тогда
		СтруктураОбъекта.Вставить("IsFolder", ?(Данные.ЭтоГруппа, "1", "0"));
		СтруктураОбъекта.Вставить("Parent", СтруктураСсылкиСправочника(Данные.Родитель, Новый Соответствие));
	КонецЕсли;
	Если МетаданныеОбъекта.Владельцы.Количество() > 0 Тогда
		СтруктураОбъекта.Вставить("Owner", СтруктураСсылкиСправочника(Данные.Владелец, Новый Соответствие));
	КонецЕсли;
	ДобавитьРеквизитыОбъекта(СтруктураОбъекта, Данные, МетаданныеОбъекта);
	Если МетаданныеОбъекта.Имя = "Партии" Тогда
		ДополнитьПоляПартии(СтруктураОбъекта, Данные, Новый Соответствие);
	КонецЕсли;
	
КонецПроцедуры

// Добавляет в структуру стандартные поля документа и вложенные ссылки.
//
// Параметры:
//  СтруктураОбъекта  - Структура - заполняемая структура JSON;
//  Данные            - ДокументОбъект - объект документа;
//  МетаданныеОбъекта - ОбъектМетаданных - метаданные документа.
//
Процедура ДополнитьСтруктуруДокумента(СтруктураОбъекта, Данные, МетаданныеОбъекта)
	
	СтруктураОбъекта.Вставить("Posted", ?(Данные.Проведен, "1", "0"));
	СтруктураОбъекта.Вставить("Date", ДатаВUnixTime(Данные.Дата));
	СтруктураОбъекта.Вставить("Number", Строка(Данные.Номер));
	ДобавитьРеквизитыОбъекта(СтруктураОбъекта, Данные, МетаданныеОбъекта);
	ДобавитьТабличныеЧастиДокумента(СтруктураОбъекта, Данные, МетаданныеОбъекта);
	Если МетаданныеОбъекта.Имя = "_Инвойс" Тогда
		ДополнитьПоляИнвойса(СтруктураОбъекта);
	ИначеЕсли МетаданныеОбъекта.Имя = "ПриходнаяНакладная" Тогда
		ДополнитьИнвойсПриходной(СтруктураОбъекта, Данные);
	ИначеЕсли МетаданныеОбъекта.Имя = "_ВозвратОтПокупателя" Тогда
		ДополнитьПоляВозвратаПокупателя(СтруктураОбъекта);
	ИначеЕсли МетаданныеОбъекта.Имя = "ВКД_ДополнительныеЗатраты" Тогда
		ДополнитьПоляДополнительныхЗатрат(СтруктураОбъекта);
	КонецЕсли;
	
КонецПроцедуры

// Подставляет поля инвойса под имена реквизитов и табличной части приёмника.
//
// Параметры:
//  СтруктураОбъекта - Структура - JSON документа _Инвойс.
//
Процедура ДополнитьПоляИнвойса(СтруктураОбъекта)
	
	СкопироватьПолеJSON(СтруктураОбъекта, СтруктураОбъекта, "ВКД_Количество", "Количество");
	СкопироватьПолеJSON(СтруктураОбъекта, СтруктураОбъекта, "ВКД_НомерИнвойсаПоставщика", "НомерИнвойсаПоставщика");
	СкопироватьПолеJSON(СтруктураОбъекта, СтруктураОбъекта, "ВКД_ДатаИнвойсаПоставщика", "ДатаИнвойсаПоставщика");
	
	МассивИсточника = Неопределено;
	Если Не СтруктураОбъекта.Свойство("ВКД_Товары", МассивИсточника) Тогда
		Возврат;
	КонецЕсли;
	Если ТипЗнч(МассивИсточника) <> Тип("Массив") Тогда
		Возврат;
	КонецЕсли;
	
	МассивТоваров = Новый Массив;
	Для Каждого СтрокаИсточника Из МассивИсточника Цикл
		Если ТипЗнч(СтрокаИсточника) <> Тип("Структура") Тогда
			Продолжить;
		КонецЕсли;
		СтрокаПриёмника = Новый Структура;
		СкопироватьПолеJSON(СтрокаИсточника, СтрокаПриёмника, "Номенклатура", "Номенклатура");
		СкопироватьПолеJSON(СтрокаИсточника, СтрокаПриёмника, "Количество", "Количество");
		СкопироватьПолеJSON(СтрокаИсточника, СтрокаПриёмника, "ЦенаЗакупки", "Цена");
		СкопироватьПолеJSON(СтрокаИсточника, СтрокаПриёмника, "СуммаЗакупки", "Сумма");
		СкопироватьПолеJSON(СтрокаИсточника, СтрокаПриёмника, "ЦенаЗакупки", "ЦенаЗакупки");
		СкопироватьПолеJSON(СтрокаИсточника, СтрокаПриёмника, "СуммаЗакупки", "СуммаЗакупки");
		СкопироватьПолеJSON(СтрокаИсточника, СтрокаПриёмника, "ИДСтроки", "ИДСтроки");
		МассивТоваров.Добавить(СтрокаПриёмника);
	КонецЦикла;
	СтруктураОбъекта.Вставить("Товары", МассивТоваров);
	
КонецПроцедуры

// Добавляет ссылку на инвойс приходной под именем реквизита приёмника.
//
// Параметры:
//  СтруктураОбъекта - Структура - JSON приходной накладной;
//  Данные            - ДокументОбъект.ПриходнаяНакладная - объект источника.
//
Процедура ДополнитьИнвойсПриходной(СтруктураОбъекта, Данные)
	
	Если Не ЗначениеЗаполнено(Данные.ВКД_Инвойс) Тогда
		Возврат;
	КонецЕсли;
	СтруктураОбъекта.Вставить("Инвойс", СтруктураСсылкиИнвойса(Данные.ВКД_Инвойс));
	
КонецПроцедуры

// Формирует краткую структуру инвойса для поиска в приёмнике.
//
// Параметры:
//  СсылкаДокумента - ДокументСсылка._Инвойс - инвойс источника.
//
// Возвращаемое значение:
//  Структура - GUID, тип, номер и дата.
//
Функция СтруктураСсылкиИнвойса(СсылкаДокумента)
	
	СтруктураДокумента = Новый Структура;
	СтруктураДокумента.Вставить("GUID", Строка(СсылкаДокумента.УникальныйИдентификатор()));
	СтруктураДокумента.Вставить("Type", "Инвойс");
	СтруктураДокумента.Вставить("DelMark", ?(СсылкаДокумента.ПометкаУдаления, "1", "0"));
	СтруктураДокумента.Вставить("Number", Строка(СсылкаДокумента.Номер));
	СтруктураДокумента.Вставить("Date", ДатаВUnixTime(СсылкаДокумента.Дата));
	Возврат СтруктураДокумента;
	
КонецФункции

// Формирует краткую структуру документа обмена: GUID, тип приёмника, номер и дата.
//
// Параметры:
//  СсылкаДокумента - ДокументСсылка - документ источника из состава выгрузки.
//
// Возвращаемое значение:
//  Структура, Null - поля для поиска в приёмнике или Null, если тип не выгружается.
//
Функция СтруктураСсылкиДокументаОбмена(СсылкаДокумента)
	
	КлючТипа = КлючТипаJSON(СсылкаДокумента.Метаданные());
	Если Не ЗначениеЗаполнено(КлючТипа) Тогда
		Возврат Null;
	КонецЕсли;
	
	СтруктураДокумента = Новый Структура;
	СтруктураДокумента.Вставить("GUID", Строка(СсылкаДокумента.УникальныйИдентификатор()));
	СтруктураДокумента.Вставить("Type", КлючТипа);
	СтруктураДокумента.Вставить("DelMark", ?(СсылкаДокумента.ПометкаУдаления, "1", "0"));
	СтруктураДокумента.Вставить("Number", Строка(СсылкаДокумента.Номер));
	СтруктураДокумента.Вставить("Date", ДатаВUnixTime(СсылкаДокумента.Дата));
	Возврат СтруктураДокумента;
	
КонецФункции

// Копирует значение поля JSON под другим именем.
//
// Параметры:
//  Источник     - Структура - откуда читать;
//  Приёмник     - Структура - куда писать;
//  ИмяИсточника - Строка - имя поля источника;
//  ИмяПриёмника - Строка - имя поля приёмника.
//
Процедура СкопироватьПолеJSON(Источник, Приёмник, ИмяИсточника, ИмяПриёмника)
	
	Если Не Источник.Свойство(ИмяИсточника) Тогда
		Возврат;
	КонецЕсли;
	Если Приёмник.Свойство(ИмяПриёмника) Тогда
		Возврат;
	КонецЕсли;
	Приёмник.Вставить(ИмяПриёмника, Источник[ИмяИсточника]);
	
КонецПроцедуры

// Добавляет в JSON табличные части документа: одноимённые реквизиты строк и синонимы приёмника.
//
// Параметры:
//  СтруктураОбъекта  - Структура - заполняемая структура JSON;
//  Данные            - ДокументОбъект - объект документа;
//  МетаданныеОбъекта - ОбъектМетаданных - метаданные документа.
//
Процедура ДобавитьТабличныеЧастиДокумента(СтруктураОбъекта, Данные, МетаданныеОбъекта)
	
	Посещенные = Новый Соответствие;
	Посещенные.Вставить(Строка(Данные.Ссылка.УникальныйИдентификатор()), Истина);
	
	Для Каждого ТабличнаяЧасть Из МетаданныеОбъекта.ТабличныеЧасти Цикл
		
		МассивСтрок = Новый Массив;
		Для Каждого СтрокаТЧ Из Данные[ТабличнаяЧасть.Имя] Цикл
			
			СтруктураСтроки = Новый Структура;
			Для Каждого Реквизит Из ТабличнаяЧасть.Реквизиты Цикл
				ЗначениеJSON = ЗначениеРеквизитаДляJSON(СтрокаТЧ[Реквизит.Имя], Посещенные);
				Если ЗначениеJSON = Null Тогда
					Продолжить;
				КонецЕсли;
				СтруктураСтроки.Вставить(Реквизит.Имя, ЗначениеJSON);
			КонецЦикла;
			ДобавитьСинонимыСтрокиТабличнойЧасти(МетаданныеОбъекта.Имя, ТабличнаяЧасть.Имя, СтруктураСтроки);
			МассивСтрок.Добавить(СтруктураСтроки);
			
		КонецЦикла;
		СтруктураОбъекта.Вставить(ТабличнаяЧасть.Имя, МассивСтрок);
		
	КонецЦикла;
	
КонецПроцедуры

// Дублирует поля строки ТЧ под именами реквизитов приёмника, если они отличаются.
//
// Параметры:
//  ИмяДокумента    - Строка - имя документа источника;
//  ИмяТЧ           - Строка - имя табличной части;
//  СтруктураСтроки - Структура - JSON-строка ТЧ.
//
Процедура ДобавитьСинонимыСтрокиТабличнойЧасти(ИмяДокумента, ИмяТЧ, СтруктураСтроки)
	
	Если ИмяДокумента = "ВКД_ДополнительныеЗатраты" И ИмяТЧ = "Документы" Тогда
		СкопироватьПолеJSON(СтруктураСтроки, СтруктураСтроки, "Документ", "ДокументПрихода");
		СкопироватьПолеJSON(СтруктураСтроки, СтруктураСтроки, "СуммаНаценки", "Сумма");
		Возврат;
	КонецЕсли;
	
	Если ИмяТЧ <> "Товары" Тогда
		Возврат;
	КонецЕсли;
	
	Если ИмяДокумента = "ПриходнаяНакладная"
		Или ИмяДокумента = "ВозвратПоставщику"
		Или ИмяДокумента = "Перемещение" Тогда
		СкопироватьПолеJSON(СтруктураСтроки, СтруктураСтроки, "ЦенаЗакупки", "Цена");
		СкопироватьПолеJSON(СтруктураСтроки, СтруктураСтроки, "СуммаЗакупки", "Сумма");
	ИначеЕсли ИмяДокумента = "РасходнаяНакладная"
		Или ИмяДокумента = "_ВозвратОтПокупателя" Тогда
		СкопироватьПолеJSON(СтруктураСтроки, СтруктураСтроки, "ЦенаПродажи", "Цена");
		СкопироватьПолеJSON(СтруктураСтроки, СтруктураСтроки, "СуммаПродажи", "Сумма");
	КонецЕсли;
	
КонецПроцедуры

// Готовит дополнительные затраты к загрузке как кассовый ордер расходов и его распределение.
//
// Параметры:
//  СтруктураОбъекта - Структура - JSON документа ВКД_ДополнительныеЗатраты.
//
Процедура ДополнитьПоляДополнительныхЗатрат(СтруктураОбъекта)
	
	СтруктураОбъекта.Вставить("ВидКассовогоОрдера", "Расходы");
	
	МассивДокументов = Неопределено;
	Если Не СтруктураОбъекта.Свойство("Документы", МассивДокументов)
		Или ТипЗнч(МассивДокументов) <> Тип("Массив") Тогда
		СтруктураОбъекта.Вставить("Распределение", Новый Массив);
		Возврат;
	КонецЕсли;
	
	Распределение = Новый Массив;
	Для Каждого СтрокаДокумента Из МассивДокументов Цикл
		Если ТипЗнч(СтрокаДокумента) <> Тип("Структура") Тогда
			Продолжить;
		КонецЕсли;
		СтрокаРаспределения = Новый Структура;
		Если СтрокаДокумента.Свойство("Документ") Тогда
			СтрокаРаспределения.Вставить("Аналитика", СтрокаДокумента.Документ);
		КонецЕсли;
		Если СтрокаДокумента.Свойство("Сумма") Тогда
			СтрокаРаспределения.Вставить("Сумма", СтрокаДокумента.Сумма);
		ИначеЕсли СтрокаДокумента.Свойство("СуммаНаценки") Тогда
			СтрокаРаспределения.Вставить("Сумма", СтрокаДокумента.СуммаНаценки);
		КонецЕсли;
		Распределение.Добавить(СтрокаРаспределения);
	КонецЦикла;
	
	СтруктураОбъекта.Вставить("Распределение", Распределение);
	
КонецПроцедуры

// Переносит сумму возврата покупателя и контрагента строки в шапку приёмника.
//
// Параметры:
//  СтруктураОбъекта - Структура - JSON документа _ВозвратОтПокупателя.
//
Процедура ДополнитьПоляВозвратаПокупателя(СтруктураОбъекта)
	
	СкопироватьПолеJSON(СтруктураОбъекта, СтруктураОбъекта, "СуммаДокумента", "Сумма");
	Если СтруктураОбъекта.Свойство("Контрагент") Тогда
		Возврат;
	КонецЕсли;
	
	МассивСтрок = Неопределено;
	Если Не СтруктураОбъекта.Свойство("Товары", МассивСтрок) Тогда
		Возврат;
	КонецЕсли;
	Если ТипЗнч(МассивСтрок) <> Тип("Массив") Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого СтрокаТовары Из МассивСтрок Цикл
		Если ТипЗнч(СтрокаТовары) <> Тип("Структура") Тогда
			Продолжить;
		КонецЕсли;
		Если СтрокаТовары.Свойство("Контрагент") И ТипЗнч(СтрокаТовары.Контрагент) = Тип("Структура") Тогда
			СтруктураОбъекта.Вставить("Контрагент", СтрокаТовары.Контрагент);
			Возврат;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

// Добавляет в JSON реквизиты шапки: примитивы, перечисления и ссылки справочников обмена.
//
// Параметры:
//  СтруктураОбъекта  - Структура - заполняемая структура JSON;
//  Данные            - СправочникОбъект, ДокументОбъект - объект;
//  МетаданныеОбъекта - ОбъектМетаданных - метаданные объекта.
//
Процедура ДобавитьРеквизитыОбъекта(СтруктураОбъекта, Данные, МетаданныеОбъекта)
	
	Посещенные = Новый Соответствие;
	Посещенные.Вставить(Строка(Данные.Ссылка.УникальныйИдентификатор()), Истина);
	
	Для Каждого Реквизит Из МетаданныеОбъекта.Реквизиты Цикл
		Если Реквизит.РежимПароля Тогда
			Продолжить;
		КонецЕсли;
		ЗначениеРеквизита = Данные[Реквизит.Имя];
		ЗначениеJSON = ЗначениеРеквизитаДляJSON(ЗначениеРеквизита, Посещенные);
		Если ЗначениеJSON = Null Тогда
			Продолжить;
		КонецЕсли;
		СтруктураОбъекта.Вставить(Реквизит.Имя, ЗначениеJSON);
	КонецЦикла;
	
	Если МетаданныеОбъекта.Имя = "ВКД_ДополнительныеЗатраты" Тогда
		Возврат;
	КонецЕсли;
	ДобавитьОбщиеРеквизитыОбъекта(СтруктураОбъекта, Данные, МетаданныеОбъекта, Посещенные);
	
КонецПроцедуры

// Добавляет общие реквизиты, включённые для объекта.
//
// Параметры:
//  СтруктураОбъекта  - Структура - заполняемая структура JSON;
//  Данные            - СправочникОбъект, ДокументОбъект - объект;
//  МетаданныеОбъекта - ОбъектМетаданных - метаданные объекта;
//  Посещенные        - Соответствие - уже обойдённые GUID ссылок.
//
Процедура ДобавитьОбщиеРеквизитыОбъекта(СтруктураОбъекта, Данные, МетаданныеОбъекта, Посещенные)
	
	Для Каждого ОбщийРеквизит Из Метаданные.ОбщиеРеквизиты Цикл
		Если Не ОбщийРеквизитИспользуется(ОбщийРеквизит, МетаданныеОбъекта) Тогда
			Продолжить;
		КонецЕсли;
		Если СтруктураОбъекта.Свойство(ОбщийРеквизит.Имя) Тогда
			Продолжить;
		КонецЕсли;
		ЗначениеJSON = ЗначениеРеквизитаДляJSON(Данные[ОбщийРеквизит.Имя], Посещенные);
		Если ЗначениеJSON = Null Тогда
			Продолжить;
		КонецЕсли;
		СтруктураОбъекта.Вставить(ОбщийРеквизит.Имя, ЗначениеJSON);
	КонецЦикла;
	
КонецПроцедуры

// Проверяет, что общий реквизит используется для объекта метаданных.
//
// Параметры:
//  ОбщийРеквизит     - ОбъектМетаданных - общий реквизит;
//  МетаданныеОбъекта - ОбъектМетаданных - проверяемый объект.
//
// Возвращаемое значение:
//  Булево - Истина, если реквизит входит в состав объекта.
//
Функция ОбщийРеквизитИспользуется(ОбщийРеквизит, МетаданныеОбъекта)
	
	Для Каждого ЭлементСостава Из ОбщийРеквизит.Состав Цикл
		Если ЭлементСостава.Метаданные <> МетаданныеОбъекта Тогда
			Продолжить;
		КонецЕсли;
		Возврат ЭлементСостава.Использование = Метаданные.СвойстваОбъектов.ИспользованиеОбщегоРеквизита.Использовать;
	КонецЦикла;
	
	Возврат ОбщийРеквизит.АвтоИспользование = Метаданные.СвойстваОбъектов.АвтоИспользованиеОбщегоРеквизита.Использовать;
	
КонецФункции

// Преобразует значение реквизита в JSON-совместимое представление.
//
// Параметры:
//  ЗначениеРеквизита - Произвольный - значение реквизита;
//  Посещенные        - Соответствие - уже обойдённые GUID ссылок.
//
// Возвращаемое значение:
//  Произвольный, Null - значение для JSON или Null, если поле пропускается.
//
Функция ЗначениеРеквизитаДляJSON(ЗначениеРеквизита, Посещенные)
	
	Если ЗначениеРеквизита = Неопределено Тогда
		Возврат Null;
	КонецЕсли;
	
	ТипЗначения = ТипЗнч(ЗначениеРеквизита);
	Если ТипЗначения = Тип("Булево") Тогда
		Возврат ЗначениеРеквизита;
	КонецЕсли;
	Если ТипЗначения = Тип("Строка") Тогда
		Если Не ЗначениеЗаполнено(ЗначениеРеквизита) Тогда
			Возврат Null;
		КонецЕсли;
		Возврат ЗначениеРеквизита;
	КонецЕсли;
	Если ТипЗначения = Тип("Число") Тогда
		Возврат ЗначениеРеквизита;
	КонецЕсли;
	Если ТипЗначения = Тип("Дата") Тогда
		Если Не ЗначениеЗаполнено(ЗначениеРеквизита) Тогда
			Возврат Null;
		КонецЕсли;
		Возврат ДатаВUnixTime(ЗначениеРеквизита);
	КонецЕсли;
	
	Если Перечисления.ТипВсеСсылки().СодержитТип(ТипЗначения) Тогда
		Возврат XMLСтрока(ЗначениеРеквизита);
	КонецЕсли;
	
	Если ЭтоСсылкаВыгружаемогоСправочника(ЗначениеРеквизита) Тогда
		Возврат СтруктураСсылкиСправочника(ЗначениеРеквизита, Посещенные);
	КонецЕсли;
	
	Если Документы.ТипВсеСсылки().СодержитТип(ТипЗначения) Тогда
		Если Не ЗначениеЗаполнено(ЗначениеРеквизита) Тогда
			Возврат Null;
		КонецЕсли;
		Возврат СтруктураСсылкиДокументаОбмена(ЗначениеРеквизита);
	КонецЕсли;
	
	Возврат Null;
	
КонецФункции

// Проверяет, что значение — ссылка справочника из состава текущей выгрузки.
//
// Параметры:
//  Значение - Произвольный - значение реквизита.
//
// Возвращаемое значение:
//  Булево - Истина, если ссылку нужно вкладывать в JSON.
//
Функция ЭтоСсылкаВыгружаемогоСправочника(Значение)
	
	Если Не ЗначениеЗаполнено(Значение) Тогда
		Возврат Ложь;
	КонецЕсли;
	Попытка
		МетаданныеЗначения = Значение.Метаданные();
	Исключение
		Возврат Ложь;
	КонецПопытки;
	Если Не Метаданные.Справочники.Содержит(МетаданныеЗначения) Тогда
		Возврат Ложь;
	КонецЕсли;
	Возврат ЭтоВыгружаемыйТип(МетаданныеЗначения);
	
КонецФункции

// Формирует вложенную структуру справочника (GUID, пометка удаления, код, наименование, родитель).
//
// Параметры:
//  СсылкаСправочника - СправочникСсылка - ссылка;
//  Посещенные        - Соответствие - уже обойдённые GUID для защиты от циклов.
//
// Возвращаемое значение:
//  Структура, Неопределено - вложенная структура или Неопределено.
//
Функция СтруктураСсылкиСправочника(СсылкаСправочника, Посещенные)
	
	Если Не ЗначениеЗаполнено(СсылкаСправочника) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	GUIDСтрока = Строка(СсылкаСправочника.УникальныйИдентификатор());
	Если Посещенные.Получить(GUIDСтрока) = Истина Тогда
		Возврат КраткаяСтруктураСсылки(СсылкаСправочника, GUIDСтрока);
	КонецЕсли;
	Посещенные.Вставить(GUIDСтрока, Истина);
	
	МетаданныеСправочника = СсылкаСправочника.Метаданные();
	СтруктураСсылки = Новый Структура;
	СтруктураСсылки.Вставить("GUID", GUIDСтрока);
	СтруктураСсылки.Вставить("Type", КлючТипаJSON(МетаданныеСправочника));
	СтруктураСсылки.Вставить("DelMark", ?(СсылкаСправочника.ПометкаУдаления, "1", "0"));
	СтруктураСсылки.Вставить("Code", КодСсылкиДляJSON(СсылкаСправочника));
	СтруктураСсылки.Вставить("Description", Строка(СсылкаСправочника.Наименование));
	Если МетаданныеСправочника.Иерархический Тогда
		СтруктураСсылки.Вставить("IsFolder", ?(СсылкаСправочника.ЭтоГруппа, "1", "0"));
		ДанныеРодителя = СтруктураСсылкиСправочника(СсылкаСправочника.Родитель, Посещенные);
		Если ТипЗнч(ДанныеРодителя) = Тип("Структура") Тогда
			СтруктураСсылки.Вставить("Parent", ДанныеРодителя);
		КонецЕсли;
	КонецЕсли;
	Если МетаданныеСправочника.Владельцы.Количество() > 0 Тогда
		ДанныеВладельца = СтруктураСсылкиСправочника(СсылкаСправочника.Владелец, Посещенные);
		Если ТипЗнч(ДанныеВладельца) = Тип("Структура") Тогда
			СтруктураСсылки.Вставить("Owner", ДанныеВладельца);
		КонецЕсли;
	КонецЕсли;
	Если МетаданныеСправочника.Имя = "Партии" Тогда
		ДополнитьПоляПартии(СтруктураСсылки, СсылкаСправочника, Посещенные);
	КонецЕсли;
	Возврат СтруктураСсылки;
	
КонецФункции

// Краткая структура уже обойдённой ссылки: код и наименование достаточны, чтобы найти или создать элемент.
//
// Параметры:
//  СсылкаСправочника - СправочникСсылка - ссылка;
//  GUIDСтрока        - Строка - GUID источника.
//
// Возвращаемое значение:
//  Структура - поля GUID, Type, Code, Description.
//
Функция КраткаяСтруктураСсылки(СсылкаСправочника, GUIDСтрока)
	
	МетаданныеСправочника = СсылкаСправочника.Метаданные();
	СтруктураСсылки = Новый Структура;
	СтруктураСсылки.Вставить("GUID", GUIDСтрока);
	СтруктураСсылки.Вставить("Type", КлючТипаJSON(МетаданныеСправочника));
	СтруктураСсылки.Вставить("DelMark", ?(СсылкаСправочника.ПометкаУдаления, "1", "0"));
	СтруктураСсылки.Вставить("Code", КодСсылкиДляJSON(СсылкаСправочника));
	СтруктураСсылки.Вставить("Description", Строка(СсылкаСправочника.Наименование));
	Если МетаданныеСправочника.Иерархический
		И МетаданныеСправочника.ВидИерархии = Метаданные.СвойстваОбъектов.ВидИерархии.ИерархияГруппИЭлементов Тогда
		СтруктураСсылки.Вставить("IsFolder", ?(СсылкаСправочника.ЭтоГруппа, "1", "0"));
	КонецЕсли;
	Возврат СтруктураСсылки;
	
КонецФункции

// Возвращает код ссылки без групповых разделителей.
//
// Параметры:
//  СсылкаСправочника - СправочникСсылка - ссылка.
//
// Возвращаемое значение:
//  Строка - код для JSON.
//
Функция КодСсылкиДляJSON(СсылкаСправочника)
	
	Если ТипЗнч(СсылкаСправочника.Код) = Тип("Число") Тогда
		Возврат Формат(СсылкаСправочника.Код, "ЧГ=0");
	КонецЕсли;
	
	Возврат СтрЗаменить(СокрЛП(Строка(СсылкаСправочника.Код)), " ", "");
	
КонецФункции

// Подставляет поля партий под имена реквизитов приёмника.
//
// Параметры:
//  СтруктураОбъекта - Структура - JSON партии;
//  ДанныеПартии     - СправочникОбъект.Партии, СправочникСсылка.Партии - партия источника;
//  Посещенные       - Соответствие - уже обойдённые GUID ссылок.
//
Процедура ДополнитьПоляПартии(СтруктураОбъекта, ДанныеПартии, Посещенные)
	
	Если ТипЗнч(ДанныеПартии.Код) = Тип("Число") Тогда
		СтруктураОбъекта.Вставить("Code", Формат(ДанныеПартии.Код, "ЧГ=0"));
	КонецЕсли;
	
	Серия = СокрЛП(ДанныеПартии.Серия);
	Если ЗначениеЗаполнено(Серия) Тогда
		СтруктураОбъекта.Вставить("Description", Серия);
	Иначе
		СтруктураОбъекта.Вставить("Description", НаименованиеПартииБезСерии(ДанныеПартии));
	КонецЕсли;
	
	СтруктураОбъекта.Вставить("ЦенаВБазВалюте", ДанныеПартии.ЦенаЗакупкиВБазВалюте);
	СтруктураОбъекта.Вставить("Цена", ДанныеПартии.ЦенаЗакупки);
	
	ЗначениеВалюты = ЗначениеРеквизитаДляJSON(ДанныеПартии.Валюта, Посещенные);
	Если ЗначениеВалюты <> Null Тогда
		СтруктураОбъекта.Вставить("Валюта", ЗначениеВалюты);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ДанныеПартии.Док)
		И ТипЗнч(ДанныеПартии.Док) = Тип("ДокументСсылка.ПриходнаяНакладная") Тогда
		СтруктураОбъекта.Вставить("ДокументРегистратор", СтруктураСсылкиПриходной(ДанныеПартии.Док));
	КонецЕсли;
	
КонецПроцедуры

// Собирает наименование партии: ГГММДД, дефис, номер документа прихода и код без пробелов.
//
// Параметры:
//  ДанныеПартии - СправочникОбъект.Партии, СправочникСсылка.Партии - партия источника.
//
// Возвращаемое значение:
//  Строка - наименование для приёмника.
//
Функция НаименованиеПартииБезСерии(ДанныеПартии)
	
	ДатаДокумента = '00010101';
	НомерДокумента = "";
	Если ЗначениеЗаполнено(ДанныеПартии.Док) Тогда
		ДатаДокумента = ДанныеПартии.Док.Дата;
		НомерДокумента = СтрЗаменить(СокрЛП(ДанныеПартии.Док.Номер), " ", "");
	КонецЕсли;
	Если Не ЗначениеЗаполнено(ДатаДокумента) Тогда
		ДатаДокумента = ДанныеПартии.ДатаПартии;
	КонецЕсли;
	
	Если ТипЗнч(ДанныеПартии.Код) = Тип("Число") Тогда
		Код = Формат(ДанныеПартии.Код, "ЧГ=0");
	Иначе
		Код = СтрЗаменить(СокрЛП(Строка(ДанныеПартии.Код)), " ", "");
	КонецЕсли;
	
	Возврат Формат(ДатаДокумента, "ДФ=yyMMdd") + "-" + НомерДокумента + Код;
	
КонецФункции

// Формирует краткую структуру приходной накладной для реквизита партии.
//
// Параметры:
//  СсылкаДокумента - ДокументСсылка.ПриходнаяНакладная - документ прихода.
//
// Возвращаемое значение:
//  Структура - GUID, тип, номер и дата.
//
Функция СтруктураСсылкиПриходной(СсылкаДокумента)
	
	СтруктураДокумента = Новый Структура;
	СтруктураДокумента.Вставить("GUID", Строка(СсылкаДокумента.УникальныйИдентификатор()));
	СтруктураДокумента.Вставить("Type", "ПриходнаяНакладная");
	СтруктураДокумента.Вставить("DelMark", ?(СсылкаДокумента.ПометкаУдаления, "1", "0"));
	СтруктураДокумента.Вставить("Number", Строка(СсылкаДокумента.Номер));
	СтруктураДокумента.Вставить("Date", ДатаВUnixTime(СсылкаДокумента.Дата));
	Возврат СтруктураДокумента;
	
КонецФункции

// Преобразует дату в unix time (как в ITStep).
//
// Параметры:
//  Дата - Дата - исходная дата.
//
// Возвращаемое значение:
//  Строка - unix time без групповых разделителей.
//
Функция ДатаВUnixTime(Дата)
	
	Если Не ЗначениеЗаполнено(Дата) Тогда
		Возврат "0";
	КонецЕсли;
	Возврат Формат(Дата - Дата(1970, 1, 1, 1, 0, 0), "ЧГ=0");
	
КонецФункции

// Сериализует структуру в JSON.
//
// Параметры:
//  СтруктураДанных - Структура - данные пакета.
//
// Возвращаемое значение:
//  Строка - JSON.
//
Функция СформироватьJSON(СтруктураДанных)
	
	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.УстановитьСтроку();
	ЗаписатьJSON(ЗаписьJSON, СтруктураДанных);
	Возврат ЗаписьJSON.Закрыть();
	
КонецФункции

// Читает JSON в структуру.
//
// Параметры:
//  СтрокаJSON - Строка - тело ответа.
//
// Возвращаемое значение:
//  Произвольный - результат ПрочитатьJSON.
//
Функция СформироватьСтруктуруИзJSON(СтрокаJSON)
	
	Чтение = Новый ЧтениеJSON;
	Чтение.УстановитьСтроку(СтрокаJSON);
	Возврат ПрочитатьJSON(Чтение, Ложь);
	
КонецФункции

// Отправляет JSON-пакет на HTTP-сервис приёмника.
//
// Параметры:
//  Параметры - Структура - параметры обмена;
//  Тело      - Строка - JSON;
//  Результат - Структура - итог порции, в неё пишется ОшибкаТранспорта.
//
// Возвращаемое значение:
//  Строка - тело ответа.
//
Функция ОтправитьПакет(Параметры, Тело, Результат)
	
	Разбор = РазобратьАдресСервиса(Параметры.АдресСервиса);
	Если Не Разбор.Успех Тогда
		ЗаписатьОшибку("", Неопределено, Разбор.ТекстОшибки);
		Результат.ОшибкаТранспорта = Истина;
		Возврат "";
	КонецЕсли;
	
	ЗащищенноеСоединение = Неопределено;
	Если Разбор.HTTPS Тогда
		ЗащищенноеСоединение = Новый ЗащищенноеСоединениеOpenSSL;
	КонецЕсли;
	
	Попытка
		Соединение = Новый HTTPСоединение(
			Разбор.Сервер,
			Разбор.Порт,
			Параметры.Пользователь,
			Параметры.Пароль,
			,
			Параметры.Таймаут,
			ЗащищенноеСоединение);
		Запрос = Новый HTTPЗапрос(Разбор.Путь);
		Запрос.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
		Запрос.УстановитьТелоИзСтроки(Тело, КодировкаТекста.UTF8);
		Ответ = Соединение.ВызватьHTTPМетод("POST", Запрос);
	Исключение
		ЗаписатьОшибку("", Неопределено, СтрШаблон("Ошибка HTTP-запроса: %1", ОписаниеОшибки()));
		Результат.ОшибкаТранспорта = Истина;
		Возврат "";
	КонецПопытки;
	
	ТелоОтвета = Ответ.ПолучитьТелоКакСтроку();
	Если Ответ.КодСостояния < 200 Или Ответ.КодСостояния >= 300 Тогда
		ЗаписатьОшибку("", Неопределено, СтрШаблон("HTTP %1: %2", Ответ.КодСостояния, ТелоОтвета));
		Результат.ОшибкаТранспорта = Истина;
		Возврат "";
	КонецЕсли;
	
	Возврат ТелоОтвета;
	
КонецФункции

// Разбирает URL сервиса на сервер, порт, путь и признак HTTPS.
//
// Параметры:
//  АдресСервиса - Строка - полный URL.
//
// Возвращаемое значение:
//  Структура:
//   * Успех       - Булево;
//   * ТекстОшибки - Строка;
//   * HTTPS       - Булево;
//   * Сервер      - Строка;
//   * Порт        - Число;
//   * Путь        - Строка.
//
Функция РазобратьАдресСервиса(АдресСервиса)
	
	Результат = Новый Структура("Успех, ТекстОшибки, HTTPS, Сервер, Порт, Путь", Ложь, "", Ложь, "", 80, "");
	Адрес = СокрЛП(АдресСервиса);
	Если СтрНачинаетсяС(НРег(Адрес), "https://") Тогда
		Результат.HTTPS = Истина;
		Результат.Порт = 443;
		Адрес = Сред(Адрес, 9);
	ИначеЕсли СтрНачинаетсяС(НРег(Адрес), "http://") Тогда
		Результат.Порт = 80;
		Адрес = Сред(Адрес, 8);
	Иначе
		Результат.ТекстОшибки = "Адрес сервиса должен начинаться с http:// или https://";
		Возврат Результат;
	КонецЕсли;
	
	ПозицияПути = СтрНайти(Адрес, "/");
	Если ПозицияПути = 0 Тогда
		ХостПорт = Адрес;
		Результат.Путь = "/";
	Иначе
		ХостПорт = Лев(Адрес, ПозицияПути - 1);
		Результат.Путь = Сред(Адрес, ПозицияПути);
	КонецЕсли;
	
	ПозицияПорта = СтрНайти(ХостПорт, ":");
	Если ПозицияПорта = 0 Тогда
		Результат.Сервер = ХостПорт;
	Иначе
		Результат.Сервер = Лев(ХостПорт, ПозицияПорта - 1);
		Результат.Порт = Число(Сред(ХостПорт, ПозицияПорта + 1));
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Результат.Сервер) Тогда
		Результат.ТекстОшибки = "В адресе сервиса не задан хост";
		Возврат Результат;
	КонецЕсли;
	
	Результат.Успех = Истина;
	Возврат Результат;
	
КонецФункции

// Добавляет в пакет записи курсов. Курс рубля в источнике хранится в валюте USD и уходит на РУБ.
// Запись с кодом РУБ снимается с регистрации: это не курс рубля.
//
// Параметры:
//  Узел            - ПланОбменаСсылка.ОбменFinCore - узел-получатель;
//  НаборЗаписей    - РегистрСведенийНаборЗаписей.КурсыВалют - изменение из плана обмена;
//  Пакет           - Структура - тело JSON;
//  КартаСсылок     - Соответствие - ключ записи → набор для снятия регистрации;
//  РезультатПорции - Структура - счётчик Упаковано;
//  РазмерПорции    - Число - предел объектов в порции.
//
Процедура ДобавитьКурсыВалютВПакет(Узел, НаборЗаписей, Пакет, КартаСсылок, РезультатПорции, РазмерПорции)
	
	Если Не НаборЗаписей.Отбор.Валюта.Использование Тогда
		Возврат;
	КонецЕсли;
	
	НаборЗаписей.Прочитать();
	Если НаборЗаписей.Количество() = 0 Тогда
		ДобавитьУдалениеКурсаВалют(Узел, НаборЗаписей, Пакет, КартаСсылок, РезультатПорции, РазмерПорции);
		Возврат;
	КонецЕсли;
	
	Для Каждого Запись Из НаборЗаписей Цикл
		
		Если РезультатПорции.Упаковано >= РазмерПорции Тогда
			Возврат;
		КонецЕсли;
		Если Не ЗначениеЗаполнено(Запись.Валюта) Тогда
			Продолжить;
		КонецЕсли;
		
		КодВалюты = СокрЛП(Запись.Валюта.Код);
		Если КодВалюты = "РУБ" Тогда
			ПланыОбмена.УдалитьРегистрациюИзменений(Узел, НаборЗаписей);
			Продолжить;
		КонецЕсли;
		
		ВалютаПриёмника = ВалютаКурсаДляПриёмника(Запись.Валюта);
		Если Не ЗначениеЗаполнено(ВалютаПриёмника) Тогда
			ЗаписатьОшибку("", Неопределено, "Курс USD не перенесён: в источнике нет валюты с кодом РУБ.");
			Продолжить;
		КонецЕсли;
		
		СтруктураЗаписи = СтруктураЗаписиКурса(Запись, ВалютаПриёмника, Ложь);
		ПоместитьКурсВПакет(СтруктураЗаписи, НаборЗаписей, Пакет, КартаСсылок, РезультатПорции);
		
	КонецЦикла;
	
КонецПроцедуры

// Добавляет удаление среза курса, если набор изменений пуст.
//
// Параметры:
//  Узел            - ПланОбменаСсылка.ОбменFinCore - узел-получатель;
//  НаборЗаписей    - РегистрСведенийНаборЗаписей.КурсыВалют - набор с отбором;
//  Пакет           - Структура - тело JSON;
//  КартаСсылок     - Соответствие - ключ записи → набор;
//  РезультатПорции - Структура - счётчик Упаковано;
//  РазмерПорции    - Число - предел объектов в порции.
//
Процедура ДобавитьУдалениеКурсаВалют(Узел, НаборЗаписей, Пакет, КартаСсылок, РезультатПорции, РазмерПорции)
	
	Если РезультатПорции.Упаковано >= РазмерПорции Тогда
		Возврат;
	КонецЕсли;
	Если Не НаборЗаписей.Отбор.Валюта.Использование Тогда
		Возврат;
	КонецЕсли;
	
	ВалютаОтбора = НаборЗаписей.Отбор.Валюта.Значение;
	Если Не ЗначениеЗаполнено(ВалютаОтбора) Или СокрЛП(ВалютаОтбора.Код) = "РУБ" Тогда
		Если ЗначениеЗаполнено(ВалютаОтбора) И СокрЛП(ВалютаОтбора.Код) = "РУБ" Тогда
			ПланыОбмена.УдалитьРегистрациюИзменений(Узел, НаборЗаписей);
		КонецЕсли;
		Возврат;
	КонецЕсли;
	
	ВалютаПриёмника = ВалютаКурсаДляПриёмника(ВалютаОтбора);
	Если Не ЗначениеЗаполнено(ВалютаПриёмника) Тогда
		ЗаписатьОшибку("", Неопределено, "Удаление курса USD не перенесено: в источнике нет валюты с кодом РУБ.");
		Возврат;
	КонецЕсли;
	
	Период = '00010101';
	Фирма = Неопределено;
	Если НаборЗаписей.Отбор.Период.Использование Тогда
		Период = НаборЗаписей.Отбор.Период.Значение;
	КонецЕсли;
	Если НаборЗаписей.Отбор.Фирма.Использование Тогда
		Фирма = НаборЗаписей.Отбор.Фирма.Значение;
	КонецЕсли;
	
	СтруктураЗаписи = Новый Структура;
	СтруктураЗаписи.Вставить("GUID", КлючЗаписиКурса(Период, Фирма, ВалютаОтбора));
	СтруктураЗаписи.Вставить("Type", "КурсыВалют");
	СтруктураЗаписи.Вставить("DelMark", "1");
	СтруктураЗаписи.Вставить("Period", ДатаВUnixTime(Период));
	СтруктураЗаписи.Вставить("Валюта", СтруктураСсылкиСправочника(ВалютаПриёмника, Новый Соответствие));
	ПоместитьКурсВПакет(СтруктураЗаписи, НаборЗаписей, Пакет, КартаСсылок, РезультатПорции);
	
КонецПроцедуры

// Возвращает валюту приёмника: запись USD источника относится к валюте с кодом РУБ.
//
// Параметры:
//  ВалютаЗаписи - СправочникСсылка.Валюты - валюта измерения источника.
//
// Возвращаемое значение:
//  СправочникСсылка.Валюты - валюта для JSON.
//
Функция ВалютаКурсаДляПриёмника(ВалютаЗаписи)
	
	Если СокрЛП(ВалютаЗаписи.Код) = "USD" Тогда
		Возврат Справочники.Валюты.НайтиПоКоду("РУБ");
	КонецЕсли;
	Возврат ВалютаЗаписи;
	
КонецФункции

// Собирает JSON одной записи курса. При ОбратныйКурс ресурсы заменяются обратной величиной.
//
// Параметры:
//  Запись           - РегистрСведенийЗапись.КурсыВалют - запись источника;
//  ВалютаПриёмника  - СправочникСсылка.Валюты - валюта в приёмнике;
//  ЭтоУдаление      - Булево - признак удаления среза.
//
// Возвращаемое значение:
//  Структура - поля записи для JSON.
//
Функция СтруктураЗаписиКурса(Запись, ВалютаПриёмника, ЭтоУдаление)
	
	СтруктураЗаписи = Новый Структура;
	СтруктураЗаписи.Вставить("GUID", КлючЗаписиКурса(Запись.Период, Запись.Фирма, Запись.Валюта));
	СтруктураЗаписи.Вставить("Type", "КурсыВалют");
	СтруктураЗаписи.Вставить("DelMark", ?(ЭтоУдаление, "1", "0"));
	СтруктураЗаписи.Вставить("Period", ДатаВUnixTime(Запись.Период));
	СтруктураЗаписи.Вставить("Валюта", СтруктураСсылкиСправочника(ВалютаПриёмника, Новый Соответствие));
	Если ЭтоУдаление Тогда
		Возврат СтруктураЗаписи;
	КонецЕсли;
	
	ОбратныйКурс = ВалютаПриёмника.ОбратныйКурс;
	СтруктураЗаписи.Вставить("Курс", КурсДляПриёмника(Запись.Курс, ОбратныйКурс));
	СтруктураЗаписи.Вставить("КурсЗакупкиСредний", КурсДляПриёмника(Запись.КурсЗакупкиСредний, ОбратныйКурс));
	СтруктураЗаписи.Вставить("КурсПродажиСредний", КурсДляПриёмника(Запись.КурсПродажиСредний, ОбратныйКурс));
	Возврат СтруктураЗаписи;
	
КонецФункции

// Возвращает курс для приёмника. Ноль не обращается.
//
// Параметры:
//  ЗначениеКурса - Число - ресурс регистра источника;
//  ОбратныйКурс  - Булево - реквизит валюты приёмника.
//
// Возвращаемое значение:
//  Число - курс или обратная величина с точностью ресурса (5 знаков).
//
Функция КурсДляПриёмника(ЗначениеКурса, ОбратныйКурс)
	
	Если ЗначениеКурса = 0 Или Не ОбратныйКурс Тогда
		Возврат ЗначениеКурса;
	КонецЕсли;
	Возврат Окр(1 / ЗначениеКурса, 5);
	
КонецФункции

// Ключ подтверждения записи курса: период, фирма и валюта источника.
//
// Параметры:
//  Период - Дата - период записи;
//  Фирма  - СправочникСсылка.Фирмы, Неопределено - измерение источника;
//  Валюта - СправочникСсылка.Валюты - измерение источника.
//
// Возвращаемое значение:
//  Строка - ключ, который приёмник возвращает без изменения.
//
Функция КлючЗаписиКурса(Период, Фирма, Валюта)
	
	ИдентификаторФирмы = "";
	Если ЗначениеЗаполнено(Фирма) Тогда
		ИдентификаторФирмы = Строка(Фирма.УникальныйИдентификатор());
	КонецЕсли;
	Возврат СтрШаблон("%1|%2|%3", Формат(ДатаВUnixTime(Период), "ЧГ=0"), ИдентификаторФирмы, Строка(Валюта.УникальныйИдентификатор()));
	
КонецФункции

// Кладёт запись курса в пакет и запоминает набор для снятия регистрации.
//
// Параметры:
//  СтруктураЗаписи - Структура - JSON записи;
//  НаборЗаписей    - РегистрСведенийНаборЗаписей.КурсыВалют - изменение плана обмена;
//  Пакет           - Структура - тело JSON;
//  КартаСсылок     - Соответствие - ключ → набор;
//  РезультатПорции - Структура - счётчик Упаковано.
//
Процедура ПоместитьКурсВПакет(СтруктураЗаписи, НаборЗаписей, Пакет, КартаСсылок, РезультатПорции)
	
	Если Не Пакет.Свойство("КурсыВалют") Тогда
		Пакет.Вставить("КурсыВалют", Новый Массив);
	КонецЕсли;
	Пакет.КурсыВалют.Добавить(СтруктураЗаписи);
	КартаСсылок.Вставить(СтруктураЗаписи.GUID, НаборЗаписей);
	РезультатПорции.Упаковано = РезультатПорции.Упаковано + 1;
	
КонецПроцедуры

// Записывает ошибку обмена в регистр сведений ОшибкиОбменаFinCore.
//
// Параметры:
//  GUIDОбъекта   - Строка - GUID источника;
//  ОбъектОбмена  - ЛюбаяСсылка, Неопределено - объект;
//  ТекстОшибки   - Строка - текст.
//
Процедура ЗаписатьОшибку(GUIDОбъекта, ОбъектОбмена, ТекстОшибки)
	
	МенеджерЗаписи = РегистрыСведений.ОшибкиОбменаFinCore.СоздатьМенеджерЗаписи();
	МенеджерЗаписи.Дата = ТекущаяДатаСеанса();
	Если ЗначениеЗаполнено(GUIDОбъекта) Тогда
		МенеджерЗаписи.GUID = Лев(Строка(GUIDОбъекта), 36);
	Иначе
		МенеджерЗаписи.GUID = Строка(Новый УникальныйИдентификатор);
	КонецЕсли;
	Если ЗначениеЗаполнено(ОбъектОбмена) Тогда
		МенеджерЗаписи.Объект = ОбъектОбмена;
	КонецЕсли;
	МенеджерЗаписи.ТекстОшибки = ТекстОшибки;
	МенеджерЗаписи.Записать();
	
КонецПроцедуры

#КонецОбласти
