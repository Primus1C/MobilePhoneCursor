// Код валюты для поля currency в ответах по инвойсу.
//
// Параметры:
//  СсылкаДокумента - ДокументСсылка._Инвойс - инвойс.
//
// Возвращаемое значение:
//  Строка - код валюты для API.
//
Функция ВалютаИнвойсаДляОтветаAPI(СсылкаДокумента)
	
	Если НЕ ЗначениеЗаполнено(СсылкаДокумента) Тогда
		Возврат "";
	КонецЕсли;
	
	Реквизиты = ОбщегоНазначенияСервер.ЗначенияРеквизитовОбъекта(СсылкаДокумента, "Валюта, ВалютаЗакупки");
	Валюта = ?(ЗначениеЗаполнено(Реквизиты.ВалютаЗакупки), Реквизиты.ВалютаЗакупки, Реквизиты.Валюта);
	
	Возврат StockAPI_Цены.ПредставлениеВалютыДляAPI(Валюта);
	
КонецФункции

// Заполняет валюту закупки, валюту оплаты и курс документа `_Инвойс` при POST /invoices.
//
// Параметры:
//  Док          - ДокументОбъект._Инвойс - создаваемый или заменяемый инвойс;
//  ВалютаЗапроса - СправочникСсылка.Валюты - currency из тела запроса.
//
Процедура ЗаполнитьВалютуИКурсДокументаИнвойсаPOST(Док, ВалютаЗапроса)
	
	Док.ВалютаЗакупки = ВалютаЗапроса;
	
	Если ВалютаЗапроса <> ПараметрыСеанса.БазоваяВалюта Тогда
		Док.Валюта = ПараметрыСеанса.БазоваяВалюта;
		Док.КурсУстановленВручную = Ложь;
		Док.Курс = РаботаСВалютой.Курс(Док.ВалютаЗакупки, Док.Дата, Док.Фирма);
	Иначе
		Док.Валюта = ВалютаЗапроса;
		Док.Курс = КурсВалютыИнвойса(ВалютаЗапроса, Док.Дата, Док.Фирма);
		Док.КурсУстановленВручную = Истина;
	КонецЕсли;
	
КонецПроцедуры

// Заполняет строку табличной части ВКД_Товары при POST /invoices.
//
// Параметры:
//  СтрокаТЧ                   - СтрокаТабличнойЧасти - строка ВКД_Товары;
//  СтрокаЗапроса               - Структура - Номенклатура, Количество, Цена, Сумма из items;
//  ИдСтроки                    - Число - идентификатор строки инвойса;
//  ИностраннаяВалютаЗакупки   - Булево - валюта запроса отличается от базовой;
//  Курс                        - Число - курс документа для пересчёта в валюту оплаты.
//
Процедура ЗаполнитьСтрокуВКДТоваровИнвойсаPOST(СтрокаТЧ, СтрокаЗапроса, ИдСтроки, ИностраннаяВалютаЗакупки, Курс)
	
	СтрокаТЧ.Номенклатура = СтрокаЗапроса.Номенклатура;
	СтрокаТЧ.Количество = СтрокаЗапроса.Количество;
	СтрокаТЧ.ИДСтроки = ИдСтроки;
	
	Если ИностраннаяВалютаЗакупки Тогда
		КурсПересчета = ?(Курс = 0, 1, Курс);
		СтрокаТЧ.ЦенаЗакупки = СтрокаЗапроса.Цена;
		СтрокаТЧ.СуммаЗакупки = СтрокаЗапроса.Сумма;
		СтрокаТЧ.ЦенаСоСкидкой = СтрокаЗапроса.Цена;
		СтрокаТЧ.СуммаЗакупкиСоСкидкой = СтрокаЗапроса.Сумма;
		СтрокаТЧ.ЦенаИнвойса = СтрокаТЧ.ЦенаЗакупки * КурсПересчета;
	Иначе
		КурсПересчета = ?(Курс = 0, 1, Курс);
		СтрокаТЧ.ЦенаИнвойса = СтрокаЗапроса.Цена;
		СтрокаТЧ.ЦенаЗакупки = СтрокаЗапроса.Цена / КурсПересчета;
		СтрокаТЧ.СуммаЗакупки = СтрокаЗапроса.Сумма / КурсПересчета;
		СтрокаТЧ.ЦенаСоСкидкой = СтрокаТЧ.ЦенаЗакупки;
		СтрокаТЧ.СуммаЗакупкиСоСкидкой = СтрокаТЧ.СуммаЗакупки;
	КонецЕсли;
	
КонецПроцедуры

// Поддерживает валюту закупки и курс документа при PUT /invoices без поля currency.
//
// Параметры:
//  Док - ДокументОбъект._Инвойс - дополняемый инвойс.
//
Процедура АктуализироватьВалютуЗакупкиИКурсДокументаИнвойсаПриДополнении(Док)
	
	ВалютаЗакупки = ?(ЗначениеЗаполнено(Док.ВалютаЗакупки), Док.ВалютаЗакупки, Док.Валюта);
	Если НЕ ЗначениеЗаполнено(Док.ВалютаЗакупки) Тогда
		Док.ВалютаЗакупки = ВалютаЗакупки;
	КонецЕсли;
	
	Если ВалютаЗакупки <> ПараметрыСеанса.БазоваяВалюта Тогда
		Если НЕ Док.КурсУстановленВручную Тогда
			Док.Курс = РаботаСВалютой.Курс(Док.ВалютаЗакупки, Док.Дата, Док.Фирма);
		ИначеЕсли Док.Курс = 0 Тогда
			Док.Курс = РаботаСВалютой.Курс(Док.ВалютаЗакупки, Док.Дата, Док.Фирма);
		КонецЕсли;
	ИначеЕсли Док.Курс = 0 Тогда
		Док.Курс = КурсВалютыИнвойса(ВалютаЗакупки, Док.Дата, Док.Фирма);
	КонецЕсли;
	
КонецПроцедуры

Функция КурсВалютыИнвойса(Валюта, ДатаДокумента, Фирма)
	
	Если НЕ ЗначениеЗаполнено(Валюта) Или Валюта = ПараметрыСеанса.БазоваяВалюта Тогда
		Возврат 1;
	КонецЕсли;
	
	Курс = РаботаСВалютой.Курс(Валюта, ДатаДокумента, Фирма);
	Если Курс = 0 Тогда
		Возврат 1;
	КонецЕсли;
	
	Возврат Курс;
	
КонецФункции

Функция СтрокиТоваровИнвойсаИзЗапроса(ДанныеЗапроса)
	
	Результат = Новый Структура("Строки, Ошибки", Новый Массив, Новый СписокЗначений);
	
	Если НЕ ДанныеЗапроса.Свойство("items") Тогда
		Результат.Ошибки.Добавить("В теле запроса нет массива items.");
		Возврат Результат;
	КонецЕсли;
	
	Если ТипЗнч(ДанныеЗапроса.items) <> Тип("Массив") Тогда
		Результат.Ошибки.Добавить("Поле items должно быть массивом.");
		Возврат Результат;
	КонецЕсли;
	
	НомерПозиции = 0;
	
	Для Каждого Позиция Из ДанныеЗапроса.items Цикл
		
		НомерПозиции = НомерПозиции + 1;
		Если ТипЗнч(Позиция) <> Тип("Структура") И ТипЗнч(Позиция) <> Тип("Соответствие") Тогда
			Результат.Ошибки.Добавить(СтрШаблон("Строка %1: элемент items должен быть объектом.", НомерПозиции));
			Продолжить;
		КонецЕсли;
		
		Номенклатура = НайтиНоменклатуруДляИнвойса(Позиция);
		Если НЕ ЗначениеЗаполнено(Номенклатура) Тогда
			Результат.Ошибки.Добавить(СтрШаблон(
				"Строка %1: укажите itemCode / itemSku / itemUpc / itemJan или item (наименование).",
				НомерПозиции));
			Продолжить;
		КонецЕсли;
		
		Если Номенклатура.ЭтоГруппа Тогда
			Результат.Ошибки.Добавить(СтрШаблон("Строка %1: '%2' является группой номенклатуры.",
				НомерПозиции, СокрЛП(Номенклатура.Наименование)));
			Продолжить;
		КонецЕсли;
		
		Если Номенклатура.ТипНоменклатуры <> Перечисления.ТипыНоменклатуры.Товар Тогда
			Результат.Ошибки.Добавить(СтрШаблон("Строка %1: '%2' не является товаром.",
				НомерПозиции, СокрЛП(Номенклатура.Наименование)));
			Продолжить;
		КонецЕсли;
		
		Количество = ЧислоИзПоляПозиции(Позиция, "qty,quantity,count");
		Если Количество = Неопределено Тогда
			Результат.Ошибки.Добавить(СтрШаблон("Строка %1: укажите qty (количество).", НомерПозиции));
			Продолжить;
		КонецЕсли;
		Если Количество <= 0 Тогда
			Результат.Ошибки.Добавить(СтрШаблон("Строка %1: количество должно быть больше нуля.", НомерПозиции));
			Продолжить;
		КонецЕсли;
		
		Цена = ЧислоИзПоляПозиции(Позиция, "price,purchasePrice");
		Сумма = ЧислоИзПоляПозиции(Позиция, "amount,sum,purchaseAmount");
		
		Если Цена = Неопределено И Сумма = Неопределено Тогда
			Результат.Ошибки.Добавить(СтрШаблон("Строка %1: укажите price и/или amount.", НомерПозиции));
			Продолжить;
		КонецЕсли;
		
		Если Цена = Неопределено Тогда
			Цена = Сумма / Количество;
		КонецЕсли;
		Если Сумма = Неопределено Тогда
			Сумма = Цена * Количество;
		КонецЕсли;
		
		Если Цена < 0 Или Сумма < 0 Тогда
			Результат.Ошибки.Добавить(СтрШаблон("Строка %1: цена и сумма не могут быть отрицательными.", НомерПозиции));
			Продолжить;
		КонецЕсли;
		
		Стр = Новый Структура("Номенклатура, Количество, Цена, Сумма",
			Номенклатура, Количество, Цена, Сумма);
		Результат.Строки.Добавить(Стр);
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// Поиск номенклатуры по коду, SKU, UPC, JAN13 или наименованию.
//
// Параметры:
//  Позиция - Структура, Соответствие - элемент items[].
//
// Возвращаемое значение:
//  СправочникСсылка.Номенклатура
//
Функция НайтиНоменклатуруДляИнвойса(Позиция)
	
	Номенклатура = НайтиНоменклатуруПоПозиции(Позиция);
	Если ЗначениеЗаполнено(Номенклатура) Тогда
		Возврат Номенклатура;
	КонецЕсли;
	
	SKU = СокрЛП(Строка(StockAPI_Утилиты.СвойствоДанныхЗапроса(Позиция, "itemSku,sku,SKU")));
	UPC = СокрЛП(Строка(StockAPI_Утилиты.СвойствоДанныхЗапроса(Позиция, "itemUpc,upc,UPC")));
	JAN = СокрЛП(Строка(StockAPI_Утилиты.СвойствоДанныхЗапроса(Позиция, "itemJan,jan,JAN,jan13,JAN13")));
	
	Если SKU = "" И UPC = "" И JAN = "" Тогда
		Возврат Справочники.Номенклатура.ПустаяСсылка();
	КонецЕсли;
	
	Запр = Новый Запрос;
	Запр.УстановитьПараметр("SKU", SKU);
	Запр.УстановитьПараметр("UPC", UPC);
	Запр.УстановитьПараметр("JAN", JAN);
	Запр.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Ном.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.Номенклатура КАК Ном
	|ГДЕ
	|	НЕ Ном.ПометкаУдаления
	|	И НЕ Ном.ЭтоГруппа
	|	И ((&SKU <> """" И Ном.SKU = &SKU)
	|		ИЛИ (&UPC <> """" И Ном.UPC = &UPC)
	|		ИЛИ (&JAN <> """" И Ном.JAN13 = &JAN))";
	
	Выборка = Запр.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;
	
	Возврат Справочники.Номенклатура.ПустаяСсылка();
	
КонецФункции

Процедура ЗаполнитьРезультатПоИнвойсу(Результат, СсылкаДокумента)
	
	ЗаполнитьЗначенияСвойств(Результат, СтруктураИнвойсаJSON(СсылкаДокумента));
	
КонецПроцедуры

// JSON-представление инвойса закупки для ответа API.
//
// Параметры:
//  СсылкаДокумента - ДокументСсылка._Инвойс - инвойс.
//
// Возвращаемое значение:
//  Структура - number, date, seller, sellerCode, currency, supplierNumber, supplierDate, posted, amount, items.
//
Функция СтруктураИнвойсаJSON(СсылкаДокумента)
	
	Результат = Новый Структура(
		"number, date, seller, sellerCode, currency, supplierNumber, supplierDate, posted, amount, items",
		"", "", "", "", "", "", "", Ложь, 0, Новый Массив);
	
	Результат.number = СсылкаДокумента.Номер;
	Результат.date = StockAPI_Утилиты.ДатаВСтроку(СсылкаДокумента.Дата);
	Результат.seller = СокрЛП(Строка(СсылкаДокумента.Контрагент));
	Результат.sellerCode = StockAPI_Утилиты.КодВСтроку(СсылкаДокумента.Контрагент.Код);
	Результат.currency = ВалютаИнвойсаДляОтветаAPI(СсылкаДокумента);
	Результат.supplierNumber = СокрЛП(СсылкаДокумента.ВКД_НомерИнвойсаПоставщика);
	Результат.supplierDate = StockAPI_Утилиты.ДатаВСтроку(СсылкаДокумента.ВКД_ДатаИнвойсаПоставщика);
	Результат.posted = СсылкаДокумента.Проведен;
	Результат.amount = СсылкаДокумента.Сумма;
	
	МассивСтрок = Новый Массив;
	Для Каждого Стр Из СсылкаДокумента.ВКД_Товары Цикл
		Элемент = Новый Структура;
		Элемент.Вставить("item", СокрЛП(Строка(Стр.Номенклатура)));
		Элемент.Вставить("itemCode", StockAPI_Утилиты.КодВСтроку(Стр.Номенклатура.Код));
		Элемент.Вставить("itemSku", СокрЛП(Строка(Стр.Номенклатура.SKU)));
		Элемент.Вставить("qty", Стр.Количество);
		Элемент.Вставить("price", Стр.ЦенаИнвойса);
		Элемент.Вставить("amount", ?(Стр.ЦенаИнвойса = 0, Стр.СуммаЗакупки, Стр.ЦенаИнвойса * Стр.Количество));
		МассивСтрок.Добавить(Элемент);
	КонецЦикла;
	Результат.items = МассивСтрок;
	
	Возврат Результат;
	
КонецФункции

// Разбор параметров GET /invoices.
//
// Параметры:
//  Запрос        - HTTPСервисЗапрос;
//  УчетнаяЗапись - СправочникСсылка.УчетныеЗаписиИнтеграции.
//
// Возвращаемое значение:
//  Структура - Режим, number, supplierNumber, date, Поставщик, dateFrom, dateTo, Ошибка.
//
Функция ПараметрыПоискаИнвойсов(Запрос, УчетнаяЗапись)
	
	Результат = Новый Структура(
		"Режим, number, supplierNumber, date, Поставщик, dateFrom, dateTo, Ошибка",
		"unknown", "", "", '00010101', Неопределено, '00010101', '00010101', "");
	
	НомерДокумента = StockAPI_Утилиты.СтрокаПараметраЗапроса(Запрос, "number,invoiceNumber,invoiceNo");
	НомерПоставщика = StockAPI_Утилиты.СтрокаПараметраЗапроса(
		Запрос, "supplierNumber,supplierNo");
	
	Если НомерДокумента <> "" Или НомерПоставщика <> "" Тогда
		
		Результат.Режим = "single";
		Результат.number = НомерДокумента;
		Результат.supplierNumber = НомерПоставщика;
		
		ДатаДокумента = StockAPI_Утилиты.ДатаПараметраЗапроса(Запрос, "date,invoiceDate");
		Если ДатаДокумента = Неопределено Тогда
			СтрокаДаты = StockAPI_Утилиты.СтрокаПараметраЗапроса(Запрос, "date,invoiceDate");
			Если СтрокаДаты <> "" Тогда
				Результат.Ошибка = СтрШаблон("Некорректная дата date: '%1' (ожидается yyyy-MM-dd).", СтрокаДаты);
				Возврат Результат;
			КонецЕсли;
		ИначеЕсли ТипЗнч(ДатаДокумента) = Тип("Дата") Тогда
			Результат.date = НачалоДня(ДатаДокумента);
		КонецЕсли;
		
		КодПоиска = StockAPI_Утилиты.СтрокаПараметраЗапроса(Запрос, "sellerCode,supplierCode,code");
		Псевдоним = StockAPI_Утилиты.СтрокаПараметраЗапроса(Запрос, "alias,seller,supplier");
		Если КодПоиска <> "" Или Псевдоним <> "" Тогда
			ДанныеПоставщика = Новый Структура;
			Если КодПоиска <> "" Тогда
				ДанныеПоставщика.Вставить("sellerCode", КодПоиска);
			КонецЕсли;
			Если Псевдоним <> "" Тогда
				ДанныеПоставщика.Вставить("alias", Псевдоним);
			КонецЕсли;
			Поставщик = НайтиПоставщика(ДанныеПоставщика, УчетнаяЗапись, Результат.Ошибка);
			Если Результат.Ошибка <> "" Тогда
				Возврат Результат;
			КонецЕсли;
			Результат.Поставщик = Поставщик;
		КонецЕсли;
		
		Возврат Результат;
		
	КонецЕсли;
	
	Результат.Режим = "multiple";
	
	КодПоиска = StockAPI_Утилиты.СтрокаПараметраЗапроса(Запрос, "sellerCode,supplierCode,code");
	Псевдоним = StockAPI_Утилиты.СтрокаПараметраЗапроса(Запрос, "alias,seller,supplier");
	Если КодПоиска <> "" Или Псевдоним <> "" Тогда
		ДанныеПоставщика = Новый Структура;
		Если КодПоиска <> "" Тогда
			ДанныеПоставщика.Вставить("sellerCode", КодПоиска);
		КонецЕсли;
		Если Псевдоним <> "" Тогда
			ДанныеПоставщика.Вставить("alias", Псевдоним);
		КонецЕсли;
		Поставщик = НайтиПоставщика(ДанныеПоставщика, УчетнаяЗапись, Результат.Ошибка);
		Если Результат.Ошибка <> "" Тогда
			Возврат Результат;
		КонецЕсли;
		Результат.Поставщик = Поставщик;
	КонецЕсли;
	
	ДатаНачала = StockAPI_Утилиты.ДатаПараметраЗапроса(Запрос, "dateFrom,from");
	ДатаОкончания = StockAPI_Утилиты.ДатаПараметраЗапроса(Запрос, "dateTo,to");
	
	Если ДатаНачала = "" И ДатаОкончания = "" Тогда
		Возврат Результат;
	КонецЕсли;
	
	Если ДатаНачала = "" Или ДатаОкончания = ""
		Или ДатаНачала = Неопределено Или ДатаОкончания = Неопределено Тогда
		Результат.Ошибка = "Для поиска по периоду укажите dateFrom и dateTo (формат yyyy-MM-dd).";
		Возврат Результат;
	КонецЕсли;
	
	Если ДатаНачала > ДатаОкончания Тогда
		Результат.Ошибка = "dateFrom не может быть позже dateTo.";
		Возврат Результат;
	КонецЕсли;
	
	Результат.dateFrom = НачалоДня(ДатаНачала);
	Результат.dateTo = КонецДня(ДатаОкончания);
	Возврат Результат;
	
КонецФункции

// Ищет инвойс для изменения (PUT): номер 1С и/или номер поставщика в рамках учётной записи.
//
// Параметры:
//  ДанныеЗапроса - Структура - тело JSON / параметры URL;
//  УчетнаяЗапись - СправочникСсылка.УчетныеЗаписиИнтеграции;
//  Результат     - Структура - поля error, НеНайден.
//
// Возвращаемое значение:
//  ДокументСсылка._Инвойс
//
Функция НайтиИнвойсДляРедактирования(ДанныеЗапроса, УчетнаяЗапись, Результат)
	
	Фильтр = Новый Структура(
		"Режим, number, supplierNumber, date, Поставщик, dateFrom, dateTo, Ошибка",
		"single", "", "", '00010101', Неопределено, '00010101', '00010101', "");
	
	Фильтр.number = СокрЛП(Строка(StockAPI_Утилиты.СвойствоДанныхЗапроса(
		ДанныеЗапроса, "number,documentNumber")));
	Фильтр.supplierNumber = СокрЛП(Строка(StockAPI_Утилиты.СвойствоДанныхЗапроса(
		ДанныеЗапроса, "supplierNumber,supplierNo,invoiceNumber,invoiceNo")));
	
	Если Фильтр.number = "" И Фильтр.supplierNumber = "" Тогда
		Результат.error = "Укажите number (номер документа 1С) или supplierNumber (номер инвойса поставщика).";
		Возврат Документы._Инвойс.ПустаяСсылка();
	КонецЕсли;
	
	СтрокаДаты = StockAPI_Утилиты.СвойствоДанныхЗапроса(ДанныеЗапроса, "date");
	Если СтрокаДаты <> "" Тогда
		ДатаДокумента = StockAPI_Утилиты.СтрокаВДату(СтрокаДаты);
		Если ДатаДокумента = Неопределено Тогда
			Результат.error = СтрШаблон("Некорректная дата date: '%1' (ожидается yyyy-MM-dd).", СтрокаДаты);
			Возврат Документы._Инвойс.ПустаяСсылка();
		КонецЕсли;
		Фильтр.date = НачалоДня(ДатаДокумента);
	КонецЕсли;
	
	КодПоиска = StockAPI_Утилиты.СвойствоДанныхЗапроса(ДанныеЗапроса, "sellerCode,supplierCode,code");
	Псевдоним = StockAPI_Утилиты.СвойствоДанныхЗапроса(ДанныеЗапроса, "alias,seller,supplier");
	Если КодПоиска <> "" Или Псевдоним <> "" Тогда
		ДанныеПоставщика = Новый Структура;
		Если КодПоиска <> "" Тогда
			ДанныеПоставщика.Вставить("sellerCode", КодПоиска);
		КонецЕсли;
		Если Псевдоним <> "" Тогда
			ДанныеПоставщика.Вставить("alias", Псевдоним);
		КонецЕсли;
		ОшибкаПоставщика = "";
		Поставщик = НайтиПоставщика(ДанныеПоставщика, УчетнаяЗапись, ОшибкаПоставщика);
		Если ОшибкаПоставщика <> "" Тогда
			Результат.error = ОшибкаПоставщика;
			Возврат Документы._Инвойс.ПустаяСсылка();
		КонецЕсли;
		Фильтр.Поставщик = Поставщик;
	КонецЕсли;
	
	РезультатПоиска = Новый Структура("Ошибка, НеНайден", "", Ложь);
	СсылкаИнвойса = НайтиИнвойсДляЧтения(Фильтр, УчетнаяЗапись, РезультатПоиска);
	Если РезультатПоиска.Ошибка <> "" Тогда
		Результат.error = РезультатПоиска.Ошибка;
		Результат.НеНайден = РезультатПоиска.НеНайден;
	КонецЕсли;
	
	Возврат СсылкаИнвойса;
	
КонецФункции

// Опционально находит инвойс закупки для связи с приходной накладной (POST /incomingwaybills).
//
// Параметры:
//  ДанныеЗапроса - Структура - invoiceNumber / invoiceNo, invoiceSupplierNumber / invoiceSupplierNo;
//  Поставщик     - СправочникСсылка.Контрагенты - контрагент приходной;
//  УчетнаяЗапись - СправочникСсылка.УчетныеЗаписиИнтеграции;
//  Ошибка        - Строка - текст ошибки поиска (не меняется, если инвойс в запросе не указан).
//
// Возвращаемое значение:
//  ДокументСсылка._Инвойс - пустая ссылка, если invoiceNumber и invoiceSupplierNumber не заданы
//  (в этом случае ВКД_Инвойс приходной не заполняется).
//
Функция НайтиИнвойсОпциональноДляПриходной(ДанныеЗапроса, Поставщик, УчетнаяЗапись, Ошибка)
	
	НомерИнвойса = СокрЛП(Строка(StockAPI_Утилиты.СвойствоДанныхЗапроса(
		ДанныеЗапроса, "invoiceNumber,invoiceNo")));
	НомерИнвойсаПоставщика = СокрЛП(Строка(StockAPI_Утилиты.СвойствоДанныхЗапроса(
		ДанныеЗапроса, "invoiceSupplierNumber,invoiceSupplierNo")));
	
	Если НомерИнвойса = "" И НомерИнвойсаПоставщика = "" Тогда
		Возврат Документы._Инвойс.ПустаяСсылка();
	КонецЕсли;
	
	Фильтр = Новый Структура(
		"Режим, number, supplierNumber, date, Поставщик, dateFrom, dateTo, Ошибка",
		"single", "", "", '00010101', Поставщик, '00010101', '00010101', "");
	
	РезультатПоиска = Новый Структура("Ошибка, НеНайден", "", Ложь);
	
	Если НомерИнвойсаПоставщика <> "" Тогда
		Фильтр.supplierNumber = НомерИнвойсаПоставщика;
	КонецЕсли;
	
	Если НомерИнвойса <> "" Тогда
		Фильтр.number = НомерИнвойса;
		СсылкаИнвойса = НайтиИнвойсДляЧтения(Фильтр, УчетнаяЗапись, РезультатПоиска);
		Если РезультатПоиска.Ошибка <> "" Тогда
			Если НомерИнвойсаПоставщика = "" И РезультатПоиска.НеНайден Тогда
				Фильтр.number = "";
				Фильтр.supplierNumber = НомерИнвойса;
				РезультатПоиска = Новый Структура("Ошибка, НеНайден", "", Ложь);
				СсылкаИнвойса = НайтиИнвойсДляЧтения(Фильтр, УчетнаяЗапись, РезультатПоиска);
			КонецЕсли;
			Если РезультатПоиска.Ошибка <> "" Тогда
				Ошибка = РезультатПоиска.Ошибка;
				Возврат Документы._Инвойс.ПустаяСсылка();
			КонецЕсли;
		КонецЕсли;
		Возврат СсылкаИнвойса;
	КонецЕсли;
	
	СсылкаИнвойса = НайтиИнвойсДляЧтения(Фильтр, УчетнаяЗапись, РезультатПоиска);
	Если РезультатПоиска.Ошибка <> "" Тогда
		Ошибка = РезультатПоиска.Ошибка;
		Возврат Документы._Инвойс.ПустаяСсылка();
	КонецЕсли;
	
	Возврат СсылкаИнвойса;
	
КонецФункции

// Ищет один инвойс по номеру документа и/или номеру поставщика в рамках поставщиков учётной записи.
//
// Параметры:
//  Фильтр        - Структура - параметры поиска (Режим = single);
//  УчетнаяЗапись - СправочникСсылка.УчетныеЗаписиИнтеграции;
//  Результат     - Структура - поля Ошибка, НеНайден.
//
// Возвращаемое значение:
//  ДокументСсылка._Инвойс
//
Функция НайтиИнвойсДляЧтения(Фильтр, УчетнаяЗапись, Результат)
	
	Запр = Новый Запрос;
	Запр.УстановитьПараметр("УчетнаяЗапись", УчетнаяЗапись);
	Запр.УстановитьПараметр("Номер", Фильтр.number);
	Запр.УстановитьПараметр("НомерПоставщика", Фильтр.supplierNumber);
	Запр.УстановитьПараметр("ОтборПоНомеру", Фильтр.number <> "");
	Запр.УстановитьПараметр("ОтборПоНомеруПоставщика", Фильтр.supplierNumber <> "");
	Запр.УстановитьПараметр("ОтборПоДате", Фильтр.date <> '00010101');
	Запр.УстановитьПараметр("Дата", Фильтр.date);
	Запр.УстановитьПараметр("ОтборПоПоставщику", ЗначениеЗаполнено(Фильтр.Поставщик));
	Запр.УстановитьПараметр("Поставщик", Фильтр.Поставщик);
	
	Запр.Текст =
	"ВЫБРАТЬ
	|	Док.Ссылка КАК Ссылка,
	|	Док.ПометкаУдаления КАК ПометкаУдаления
	|ИЗ
	|	Документ._Инвойс КАК Док
	|ГДЕ
	|	НЕ Док.ПометкаУдаления
	|	И Док.Контрагент В ИЕРАРХИИ
	|			(ВЫБРАТЬ РАЗЛИЧНЫЕ
	|				ТЧ.ГруппаКонтрагентов
	|			ИЗ
	|				Справочник.УчетныеЗаписиИнтеграции.Поставщики КАК ТЧ
	|			ГДЕ
	|				ТЧ.Ссылка = &УчетнаяЗапись
	|				И ТЧ.ГруппаКонтрагентов <> ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)
	|				И НЕ ТЧ.ГруппаКонтрагентов.ПометкаУдаления)
	|	И ВЫБОР
	|			КОГДА &ОтборПоПоставщику
	|				ТОГДА Док.Контрагент = &Поставщик
	|			ИНАЧЕ ИСТИНА
	|		КОНЕЦ
	|	И ВЫБОР
	|			КОГДА &ОтборПоНомеру
	|				ТОГДА Док.Номер = &Номер
	|			ИНАЧЕ ИСТИНА
	|		КОНЕЦ
	|	И ВЫБОР
	|			КОГДА &ОтборПоНомеруПоставщика
	|				ТОГДА Док.ВКД_НомерИнвойсаПоставщика = &НомерПоставщика
	|			ИНАЧЕ ИСТИНА
	|		КОНЕЦ
	|	И ВЫБОР
	|			КОГДА &ОтборПоДате
	|				ТОГДА Док.Дата МЕЖДУ НАЧАЛОПЕРИОДА(&Дата, ДЕНЬ) И КОНЕЦПЕРИОДА(&Дата, ДЕНЬ)
	|			ИНАЧЕ ИСТИНА
	|		КОНЕЦ
	|
	|УПОРЯДОЧИТЬ ПО
	|	Док.Дата УБЫВ,
	|	Док.Номер УБЫВ";
	
	Таблица = Запр.Выполнить().Выгрузить();
	Если Таблица.Количество() = 0 Тогда
		ПредставлениеНомера = ?(Фильтр.number <> "", Фильтр.number, Фильтр.supplierNumber);
		Результат.Ошибка = СтрШаблон("Инвойс %1 не найден.", ПредставлениеНомера);
		Результат.НеНайден = Истина;
		Возврат Документы._Инвойс.ПустаяСсылка();
	КонецЕсли;
	
	Если Таблица.Количество() > 1 Тогда
		ПредставлениеНомера = ?(Фильтр.number <> "", Фильтр.number, Фильтр.supplierNumber);
		Результат.Ошибка = СтрШаблон(
			"Найдено несколько инвойсов %1. Уточните date или sellerCode / supplierNumber.",
			ПредставлениеНомера);
		Возврат Документы._Инвойс.ПустаяСсылка();
	КонецЕсли;
	
	Возврат Таблица[0].Ссылка;
	
КонецФункции

// Список ссылок на инвойсы по фильтру списка GET /invoices.
//
// Параметры:
//  Фильтр        - Структура - параметры поиска (Режим = multiple);
//  УчетнаяЗапись - СправочникСсылка.УчетныеЗаписиИнтеграции.
//
// Возвращаемое значение:
//  Массив из ДокументСсылка._Инвойс
//
Функция МассивИнвойсовПоФильтру(Фильтр, УчетнаяЗапись)
	
	Запр = Новый Запрос;
	Запр.УстановитьПараметр("УчетнаяЗапись", УчетнаяЗапись);
	Запр.УстановитьПараметр("ОтборПоПоставщику", ЗначениеЗаполнено(Фильтр.Поставщик));
	Запр.УстановитьПараметр("Поставщик", Фильтр.Поставщик);
	Запр.УстановитьПараметр("ОтборПоПериоду", Фильтр.dateFrom <> '00010101' Или Фильтр.dateTo <> '00010101');
	Запр.УстановитьПараметр("ДатаНачала", Фильтр.dateFrom);
	Запр.УстановитьПараметр("ДатаОкончания", Фильтр.dateTo);
	
	Запр.Текст =
	"ВЫБРАТЬ
	|	Док.Ссылка КАК Ссылка
	|ИЗ
	|	Документ._Инвойс КАК Док
	|ГДЕ
	|	НЕ Док.ПометкаУдаления
	|	И Док.Контрагент В ИЕРАРХИИ
	|			(ВЫБРАТЬ РАЗЛИЧНЫЕ
	|				ТЧ.ГруппаКонтрагентов
	|			ИЗ
	|				Справочник.УчетныеЗаписиИнтеграции.Поставщики КАК ТЧ
	|			ГДЕ
	|				ТЧ.Ссылка = &УчетнаяЗапись
	|				И ТЧ.ГруппаКонтрагентов <> ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)
	|				И НЕ ТЧ.ГруппаКонтрагентов.ПометкаУдаления)
	|	И ВЫБОР
	|			КОГДА &ОтборПоПоставщику
	|				ТОГДА Док.Контрагент = &Поставщик
	|			ИНАЧЕ ИСТИНА
	|		КОНЕЦ
	|	И ВЫБОР
	|			КОГДА &ОтборПоПериоду
	|				ТОГДА Док.Дата МЕЖДУ &ДатаНачала И &ДатаОкончания
	|			ИНАЧЕ ИСТИНА
	|		КОНЕЦ
	|
	|УПОРЯДОЧИТЬ ПО
	|	Док.Дата УБЫВ,
	|	Док.Номер УБЫВ";
	
	Возврат Запр.Выполнить().Выгрузить().ВыгрузитьКолонку(0);
	
КонецФункции

// JSON-представление приходной накладной для ответа API.
//
// Параметры:
//  СсылкаДокумента - ДокументСсылка.ПриходнаяНакладная - приходная.
//
// Возвращаемое значение:
//  Структура - поля документа и invoiceNumber / invoiceIncomingNumber / invoiceDate из ВКД_Инвойс.
//
Функция СтруктураПриходнойJSON(СсылкаДокумента)
	
	Результат = Новый Структура(
		"number, date, seller, sellerCode, warehouse, warehouseCode, currency, supplierNumber, supplierDate, posted, amount, items, invoiceNumber, invoiceIncomingNumber, invoiceDate",
		"", "", "", "", "", "", "", "", "", Ложь, 0, Новый Массив, "", "", "");
	
	Результат.number = СсылкаДокумента.Номер;
	Результат.date = StockAPI_Утилиты.ДатаВСтроку(СсылкаДокумента.Дата);
	Результат.seller = СокрЛП(Строка(СсылкаДокумента.Контрагент));
	Результат.sellerCode = StockAPI_Утилиты.КодВСтроку(СсылкаДокумента.Контрагент.Код);
	Результат.warehouse = СокрЛП(Строка(СсылкаДокумента.Склад));
	Результат.warehouseCode = StockAPI_Утилиты.КодВСтроку(СсылкаДокумента.Склад.Код);
	Результат.currency = StockAPI_Цены.ПредставлениеВалютыДляAPI(СсылкаДокумента.Валюта);
	Результат.supplierNumber = СокрЛП(СсылкаДокумента.НомерПоставщика);
	Результат.supplierDate = StockAPI_Утилиты.ДатаВСтроку(СсылкаДокумента.ДатаПоставщика);
	Результат.posted = СсылкаДокумента.Проведен;
	Результат.amount = СсылкаДокумента.Сумма;
	
	МассивСтрок = Новый Массив;
	Для Каждого Стр Из СсылкаДокумента.Товары Цикл
		Элемент = Новый Структура;
		Элемент.Вставить("item", СокрЛП(Строка(Стр.Номенклатура)));
		Элемент.Вставить("itemCode", StockAPI_Утилиты.КодВСтроку(Стр.Номенклатура.Код));
		Элемент.Вставить("qty", Стр.Количество);
		Элемент.Вставить("price", Стр.ЦенаЗакупки);
		Элемент.Вставить("amount", Стр.СуммаЗакупки);
		Элемент.Вставить("serial", СокрЛП(Стр.Серия));
		МассивСтрок.Добавить(Элемент);
	КонецЦикла;
	Результат.items = МассивСтрок;
	
	ИнвойсОснование = СсылкаДокумента.ВКД_Инвойс;
	Если ЗначениеЗаполнено(ИнвойсОснование) Тогда
		Результат.invoiceNumber = ИнвойсОснование.Номер;
		Результат.invoiceIncomingNumber = СокрЛП(ИнвойсОснование.ВКД_НомерИнвойсаПоставщика);
		Результат.invoiceDate = StockAPI_Утилиты.ДатаВСтроку(ИнвойсОснование.Дата);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Ищет одну приходную по номеру документа и/или номеру поставщика в рамках поставщиков учётной записи.
//
// Параметры:
//  Фильтр        - Структура - параметры поиска (Режим = single);
//  УчетнаяЗапись - СправочникСсылка.УчетныеЗаписиИнтеграции;
//  Результат     - Структура - поля Ошибка, НеНайден.
//
// Возвращаемое значение:
//  ДокументСсылка.ПриходнаяНакладная
//
Функция НайтиПриходнуюДляЧтения(Фильтр, УчетнаяЗапись, Результат)
	
	Запр = Новый Запрос;
	Запр.УстановитьПараметр("УчетнаяЗапись", УчетнаяЗапись);
	Запр.УстановитьПараметр("Номер", Фильтр.number);
	Запр.УстановитьПараметр("НомерПоставщика", Фильтр.supplierNumber);
	Запр.УстановитьПараметр("ОтборПоНомеру", Фильтр.number <> "");
	Запр.УстановитьПараметр("ОтборПоНомеруПоставщика", Фильтр.supplierNumber <> "");
	Запр.УстановитьПараметр("ОтборПоДате", Фильтр.date <> '00010101');
	Запр.УстановитьПараметр("Дата", Фильтр.date);
	Запр.УстановитьПараметр("ОтборПоПоставщику", ЗначениеЗаполнено(Фильтр.Поставщик));
	Запр.УстановитьПараметр("Поставщик", Фильтр.Поставщик);
	
	Запр.Текст =
	"ВЫБРАТЬ
	|	Док.Ссылка КАК Ссылка,
	|	Док.ПометкаУдаления КАК ПометкаУдаления
	|ИЗ
	|	Документ.ПриходнаяНакладная КАК Док
	|ГДЕ
	|	НЕ Док.ПометкаУдаления
	|	И Док.Контрагент В ИЕРАРХИИ
	|			(ВЫБРАТЬ РАЗЛИЧНЫЕ
	|				ТЧ.ГруппаКонтрагентов
	|			ИЗ
	|				Справочник.УчетныеЗаписиИнтеграции.Поставщики КАК ТЧ
	|			ГДЕ
	|				ТЧ.Ссылка = &УчетнаяЗапись
	|				И ТЧ.ГруппаКонтрагентов <> ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)
	|				И НЕ ТЧ.ГруппаКонтрагентов.ПометкаУдаления)
	|	И ВЫБОР
	|			КОГДА &ОтборПоПоставщику
	|				ТОГДА Док.Контрагент = &Поставщик
	|			ИНАЧЕ ИСТИНА
	|		КОНЕЦ
	|	И ВЫБОР
	|			КОГДА &ОтборПоНомеру
	|				ТОГДА Док.Номер = &Номер
	|			ИНАЧЕ ИСТИНА
	|		КОНЕЦ
	|	И ВЫБОР
	|			КОГДА &ОтборПоНомеруПоставщика
	|				ТОГДА Док.НомерПоставщика = &НомерПоставщика
	|			ИНАЧЕ ИСТИНА
	|		КОНЕЦ
	|	И ВЫБОР
	|			КОГДА &ОтборПоДате
	|				ТОГДА Док.Дата МЕЖДУ НАЧАЛОПЕРИОДА(&Дата, ДЕНЬ) И КОНЕЦПЕРИОДА(&Дата, ДЕНЬ)
	|			ИНАЧЕ ИСТИНА
	|		КОНЕЦ
	|
	|УПОРЯДОЧИТЬ ПО
	|	Док.Дата УБЫВ,
	|	Док.Номер УБЫВ";
	
	Таблица = Запр.Выполнить().Выгрузить();
	Если Таблица.Количество() = 0 Тогда
		ПредставлениеНомера = ?(Фильтр.number <> "", Фильтр.number, Фильтр.supplierNumber);
		Результат.Ошибка = СтрШаблон("Приходная накладная %1 не найдена.", ПредставлениеНомера);
		Результат.НеНайден = Истина;
		Возврат Документы.ПриходнаяНакладная.ПустаяСсылка();
	КонецЕсли;
	
	Если Таблица.Количество() > 1 Тогда
		ПредставлениеНомера = ?(Фильтр.number <> "", Фильтр.number, Фильтр.supplierNumber);
		Результат.Ошибка = СтрШаблон(
			"Найдено несколько приходных накладных %1. Уточните date или sellerCode / supplierNumber.",
			ПредставлениеНомера);
		Возврат Документы.ПриходнаяНакладная.ПустаяСсылка();
	КонецЕсли;
	
	Возврат Таблица[0].Ссылка;
	
КонецФункции

// Список ссылок на приходные по фильтру списка GET /incomingwaybiils.
//
// Параметры:
//  Фильтр        - Структура - параметры поиска (Режим = multiple);
//  УчетнаяЗапись - СправочникСсылка.УчетныеЗаписиИнтеграции.
//
// Возвращаемое значение:
//  Массив из ДокументСсылка.ПриходнаяНакладная
//
Функция МассивПриходныхПоФильтру(Фильтр, УчетнаяЗапись)
	
	Запр = Новый Запрос;
	Запр.УстановитьПараметр("УчетнаяЗапись", УчетнаяЗапись);
	Запр.УстановитьПараметр("ОтборПоПоставщику", ЗначениеЗаполнено(Фильтр.Поставщик));
	Запр.УстановитьПараметр("Поставщик", Фильтр.Поставщик);
	Запр.УстановитьПараметр("ОтборПоПериоду", Фильтр.dateFrom <> '00010101' Или Фильтр.dateTo <> '00010101');
	Запр.УстановитьПараметр("ДатаНачала", Фильтр.dateFrom);
	Запр.УстановитьПараметр("ДатаОкончания", Фильтр.dateTo);
	
	Запр.Текст =
	"ВЫБРАТЬ
	|	Док.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.ПриходнаяНакладная КАК Док
	|ГДЕ
	|	НЕ Док.ПометкаУдаления
	|	И Док.Контрагент В ИЕРАРХИИ
	|			(ВЫБРАТЬ РАЗЛИЧНЫЕ
	|				ТЧ.ГруппаКонтрагентов
	|			ИЗ
	|				Справочник.УчетныеЗаписиИнтеграции.Поставщики КАК ТЧ
	|			ГДЕ
	|				ТЧ.Ссылка = &УчетнаяЗапись
	|				И ТЧ.ГруппаКонтрагентов <> ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)
	|				И НЕ ТЧ.ГруппаКонтрагентов.ПометкаУдаления)
	|	И ВЫБОР
	|			КОГДА &ОтборПоПоставщику
	|				ТОГДА Док.Контрагент = &Поставщик
	|			ИНАЧЕ ИСТИНА
	|		КОНЕЦ
	|	И ВЫБОР
	|			КОГДА &ОтборПоПериоду
	|				ТОГДА Док.Дата МЕЖДУ &ДатаНачала И &ДатаОкончания
	|			ИНАЧЕ ИСТИНА
	|		КОНЕЦ
	|
	|УПОРЯДОЧИТЬ ПО
	|	Док.Дата УБЫВ,
	|	Док.Номер УБЫВ";
	
	Возврат Запр.Выполнить().Выгрузить().ВыгрузитьКолонку(0);
	
КонецФункции

// GET /awbshipment — проведенные ОтправкаAWB за интервал дат (dateFrom/dateTo, без времени).
// Каждый элемент: номер и дата документа, AWB и строки табчасти Инвойсы.
// items[] заполняется только если в строке ТЧ заполнена Поставка — товары этой поставки
// (структура элемента как в GET /invoices). Ответ с пагинацией (как GET /invoices).
//
// Параметры:
//  Запрос        - HTTPСервисЗапрос - входящий запрос (dateFrom/from, dateTo/to, page, pageSize);
//  УчетнаяЗапись - СправочникСсылка.УчетныеЗаписиИнтеграции - учётная запись API.
//
// Возвращаемое значение:
//  Структура - Тело (page, pageSize, totalItems, totalPages, items), Ошибка.
//
Функция ПолучитьОтправкиAWB(Запрос, УчетнаяЗапись) Экспорт
	
	Результат = Новый Структура("Тело, Ошибка", Неопределено, "");
	
	ДатаНачала = StockAPI_Утилиты.ДатаПараметраЗапроса(Запрос, "dateFrom,from");
	ДатаОкончания = StockAPI_Утилиты.ДатаПараметраЗапроса(Запрос, "dateTo,to");
	Если ТипЗнч(ДатаНачала) <> Тип("Дата") Или ТипЗнч(ДатаОкончания) <> Тип("Дата") Тогда
		Результат.Ошибка = "Укажите dateFrom и dateTo (формат yyyy-MM-dd).";
		Возврат Результат;
	КонецЕсли;
	Если ДатаНачала > ДатаОкончания Тогда
		Результат.Ошибка = "dateFrom не может быть позже dateTo.";
		Возврат Результат;
	КонецЕсли;
	
	Пагинация = StockAPI_Утилиты.ПараметрыПагинацииОстатков(Запрос);
	Если Пагинация.Ошибка <> "" Тогда
		Результат.Ошибка = Пагинация.Ошибка;
		Возврат Результат;
	КонецЕсли;
	
	ЗапросДокументов = Новый Запрос;
	ЗапросДокументов.УстановитьПараметр("ДатаНачала", НачалоДня(ДатаНачала));
	ЗапросДокументов.УстановитьПараметр("ДатаОкончания", КонецДня(ДатаОкончания));
	ЗапросДокументов.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
	                         |	Док.Ссылка КАК Ссылка,
	                         |	Док.Номер КАК Номер,
	                         |	Док.Дата КАК ДатаДокумента
	                         |ИЗ
	                         |	Документ.ОтправкаAWB КАК Док
	                         |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ОтправкаAWB.Инвойсы КАК ТЧ
	                         |		ПО Док.Ссылка = ТЧ.Ссылка
	                         |ГДЕ
	                         |	Док.Проведен
	                         |	И Док.Дата МЕЖДУ &ДатаНачала И &ДатаОкончания
	                         |
	                         |УПОРЯДОЧИТЬ ПО
	                         |	ДатаДокумента,
	                         |	Номер";
	
	ТаблицаДокументов = ЗапросДокументов.Выполнить().Выгрузить();
	Всего = ТаблицаДокументов.Количество();
	ВсегоСтраниц = StockAPI_Утилиты.ВсегоСтраницПагинации(Всего, Пагинация.pageSize);
	Пропустить = (Пагинация.page - 1) * Пагинация.pageSize;
	
	ОтправкиСтраницы = Новый Массив;
	Индекс = 0;
	Для Каждого СтрокаДокумента Из ТаблицаДокументов Цикл
		Если Индекс >= Пропустить И ОтправкиСтраницы.Количество() < Пагинация.pageSize Тогда
			ОтправкиСтраницы.Добавить(СтрокаДокумента.Ссылка);
		КонецЕсли;
		Индекс = Индекс + 1;
		Если ОтправкиСтраницы.Количество() >= Пагинация.pageSize Тогда
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	МассивОтправок = Новый Массив;
	Если ОтправкиСтраницы.Количество() > 0 Тогда
		
		ЗапросДанных = Новый Запрос;
		ЗапросДанных.УстановитьПараметр("Отправки", ОтправкиСтраницы);
		ЗапросДанных.Текст = "ВЫБРАТЬ
		                     |	Док.Ссылка КАК Ссылка,
		                     |	Док.Номер КАК Номер,
		                     |	Док.AWB КАК AWB,
		                     |	Док.Дата КАК ДатаДокумента,
		                     |	ТЧ.НомерСтроки КАК НомерСтроки,
		                     |	ТЧ.Инвойс.Номер КАК НомерИнвойса,
		                     |	ТЧ.Инвойс.Дата КАК ДатаИнвойса,
		                     |	ТЧ.Инвойс.ВКД_НомерИнвойсаПоставщика КАК НомерИнвойсаПоставщика,
		                     |	ТЧ.Инвойс.ВКД_ДатаИнвойсаПоставщика КАК ДатаИнвойсаПоставщика,
		                     |	ПРЕДСТАВЛЕНИЕ(ТЧ.Инвойс.Контрагент) КАК Поставщик,
		                     |	ТЧ.Инвойс.Контрагент.Код КАК КодПоставщика,
		                     |	ЕСТЬNULL(ТЧ.Инвойс.КоличествоПоставок, 0) КАК КоличествоПоставок,
		                     |	ТЧ.Поставка КАК Поставка,
		                     |	ЕСТЬNULL(СостоянияИнвойсов.Статус, ЗНАЧЕНИЕ(Перечисление.СтатусыИнвойса.ПустаяСсылка)) КАК СтатусИнвойса,
		                     |	Поставки.Номенклатура КАК Номенклатура,
		                     |	ПРЕДСТАВЛЕНИЕ(Поставки.Номенклатура) КАК НаименованиеНоменклатуры,
		                     |	Поставки.Номенклатура.Код КАК КодНоменклатуры,
		                     |	ЕСТЬNULL(Поставки.Номенклатура.SKU, """") КАК SKUНоменклатуры,
		                     |	ЕСТЬNULL(Поставки.Количество, 0) КАК КоличествоТовара,
		                     |	ЕСТЬNULL(Товары.ЦенаИнвойса, 0) КАК ЦенаИнвойса,
		                     |	ЕСТЬNULL(Поставки.Цена, 0) КАК ЦенаПоставки,
		                     |	ЕСТЬNULL(Поставки.Сумма, 0) КАК СуммаПоставки
		                     |ИЗ
		                     |	Документ.ОтправкаAWB КАК Док
		                     |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ОтправкаAWB.Инвойсы КАК ТЧ
		                     |		ПО Док.Ссылка = ТЧ.Ссылка
		                     |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СостоянияИнвойсов КАК СостоянияИнвойсов
		                     |		ПО (ТЧ.Инвойс = СостоянияИнвойсов.Инвойс)
		                     |		ЛЕВОЕ СОЕДИНЕНИЕ Документ._Инвойс.Поставки КАК Поставки
		                     |		ПО ТЧ.Инвойс = Поставки.Ссылка
		                     |			И ТЧ.Поставка > 0
		                     |			И ТЧ.Поставка = Поставки.Поставка
		                     |		ЛЕВОЕ СОЕДИНЕНИЕ Документ._Инвойс.ВКД_Товары КАК Товары
		                     |		ПО Поставки.Ссылка = Товары.Ссылка
		                     |			И Поставки.ИдСтроки = Товары.ИДСтроки
		                     |ГДЕ
		                     |	Док.Ссылка В (&Отправки)
		                     |
		                     |УПОРЯДОЧИТЬ ПО
		                     |	ДатаДокумента,
		                     |	Номер,
		                     |	НомерСтроки,
		                     |	Поставки.НомерСтроки";
		
		Выборка = ЗапросДанных.Выполнить().Выбрать();
		ТекущаяСсылка = Неопределено;
		ТекущийНомерСтроки = Неопределено;
		ЭлементОтправки = Неопределено;
		СтрокаИнвойса = Неопределено;
		Пока Выборка.Следующий() Цикл
			Если Выборка.Ссылка <> ТекущаяСсылка Тогда
				ЭлементОтправки = Новый Структура("number, date, awb, invoices");
				ЭлементОтправки.number = СокрЛП(Выборка.Номер);
				ЭлементОтправки.date = StockAPI_Утилиты.ДатаВСтроку(Выборка.ДатаДокумента);
				ЭлементОтправки.awb = СокрЛП(Выборка.AWB);
				ЭлементОтправки.invoices = Новый Массив;
				МассивОтправок.Добавить(ЭлементОтправки);
				ТекущаяСсылка = Выборка.Ссылка;
				ТекущийНомерСтроки = Неопределено;
			КонецЕсли;
			Если Выборка.НомерСтроки <> ТекущийНомерСтроки Тогда
				СтрокаИнвойса = Новый Структура(
					"number, date, supplierNumber, supplierDate, seller, sellerCode, numberOfDeliveries, delivery, invoiceStatus, items");
				СтрокаИнвойса.number = СокрЛП(Выборка.НомерИнвойса);
				СтрокаИнвойса.date = Формат(Выборка.ДатаИнвойса, "ДФ=yyyy-MM-dd");
				СтрокаИнвойса.supplierNumber = СокрЛП(Выборка.НомерИнвойсаПоставщика);
				СтрокаИнвойса.supplierDate = StockAPI_Утилиты.ДатаВСтроку(Выборка.ДатаИнвойсаПоставщика);
				СтрокаИнвойса.seller = СокрЛП(Строка(Выборка.Поставщик));
				СтрокаИнвойса.sellerCode = StockAPI_Утилиты.КодВСтроку(Выборка.КодПоставщика);
				СтрокаИнвойса.numberOfDeliveries = Выборка.КоличествоПоставок;
				СтрокаИнвойса.delivery = Выборка.Поставка;
				СтрокаИнвойса.invoiceStatus = АнглийскоеПредставлениеСтатусаИнвойса(Выборка.СтатусИнвойса);
				СтрокаИнвойса.items = Новый Массив;
				ЭлементОтправки.invoices.Добавить(СтрокаИнвойса);
				ТекущийНомерСтроки = Выборка.НомерСтроки;
			КонецЕсли;
			Если ЗначениеЗаполнено(Выборка.Поставка) И ЗначениеЗаполнено(Выборка.Номенклатура) Тогда
				Цена = Выборка.ЦенаИнвойса;
				Если Цена = 0 Тогда
					Цена = Выборка.ЦенаПоставки;
				КонецЕсли;
				СтрокаИнвойса.items.Добавить(ЭлементТовараИнвойсаДляОтветаAPI(
					Выборка.НаименованиеНоменклатуры,
					Выборка.КодНоменклатуры,
					Выборка.SKUНоменклатуры,
					Выборка.КоличествоТовара,
					Цена,
					Выборка.СуммаПоставки));
			КонецЕсли;
		КонецЦикла;
		
	КонецЕсли;
	
	ТелоОтвета = Новый Структура;
	ТелоОтвета.Вставить("page", Пагинация.page);
	ТелоОтвета.Вставить("pageSize", Пагинация.pageSize);
	ТелоОтвета.Вставить("totalItems", Всего);
	ТелоОтвета.Вставить("totalPages", ВсегоСтраниц);
	ТелоОтвета.Вставить("items", МассивОтправок);
	Результат.Тело = ТелоОтвета;
	Возврат Результат;
	
КонецФункции

// Элемент массива items[] как в GET /invoices.
//
// Параметры:
//  Наименование - Строка - представление номенклатуры;
//  Код          - Число, Строка - код номенклатуры;
//  SKU          - Строка - SKU;
//  Количество   - Число - qty;
//  Цена         - Число - price (цена инвойса);
//  Сумма        - Число - amount, если цена = 0.
//
// Возвращаемое значение:
//  Структура - item, itemCode, itemSku, qty, price, amount.
//
Функция ЭлементТовараИнвойсаДляОтветаAPI(Наименование, Код, SKU, Количество, Цена, Сумма)
	
	Элемент = Новый Структура;
	Элемент.Вставить("item", СокрЛП(Строка(Наименование)));
	Элемент.Вставить("itemCode", StockAPI_Утилиты.КодВСтроку(Код));
	Элемент.Вставить("itemSku", СокрЛП(Строка(SKU)));
	Элемент.Вставить("qty", Количество);
	Элемент.Вставить("price", Цена);
	Элемент.Вставить("amount", ?(Цена = 0, Сумма, Цена * Количество));
	Возврат Элемент;
	
КонецФункции

// Английский синоним статуса инвойса для ответа API.
//
// Параметры:
//  Статус - ПеречислениеСсылка.СтатусыИнвойса - статус из регистра СостоянияИнвойсов.
//
// Возвращаемое значение:
//  Строка - Not shipped / In transit / Partially received / Received; пустая строка, если статус не задан.
//
Функция АнглийскоеПредставлениеСтатусаИнвойса(Статус)
	
	Если Статус = Перечисления.СтатусыИнвойса.НеОтправлен Тогда
		Возврат "Not shipped";
	ИначеЕсли Статус = Перечисления.СтатусыИнвойса.ВПути Тогда
		Возврат "In transit";
	ИначеЕсли Статус = Перечисления.СтатусыИнвойса.ЧастичноПрибыл Тогда
		Возврат "Partially received";
	ИначеЕсли Статус = Перечисления.СтатусыИнвойса.Прибыл Тогда
		Возврат "Received";
	КонецЕсли;
	
	Возврат "";
	
КонецФункции

#КонецОбласти
