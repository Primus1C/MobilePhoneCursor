// Приходные / инвойсы StockAPI: GET/POST/PUT /invoices, GET /awbshipment, GET/POST/PUT/PATCH/DELETE /incomingwaybills.
// Зависимости: StockAPI_Утилиты, StockAPI_Справочники, StockAPI_Цены.

#Область ПрограммныйИнтерфейс

// POST /incomingwaybills — создание и проведение приходной накладной.
//
// Параметры:
//  ДанныеЗапроса     - Структура - тело JSON-запроса;
//  КонтекстАвторизации - Структура - поля УчетнаяЗапись и др.
//
// Возвращаемое значение:
//  Структура - success, error, number, date, seller, sellerCode, warehouse, warehouseCode,
//              currency, supplierNumber, supplierDate, posted, amount, items.
//
// Необязательно: invoiceNumber / invoiceNo — номер _Инвойс в 1С или номер инвойса поставщика;
// invoiceSupplierNumber / invoiceSupplierNo — номер инвойса поставщика (если задан вместе с invoiceNumber).
// Если параметры инвойса не переданы — реквизит ВКД_Инвойс приходной не заполняется.
//
// Необязательно: date / dateTime / documentDate — дата и время документа (Дата); иначе ТекущаяДатаСеанса().
// Если передана только дата без времени — время документа = текущее время сеанса.
//
Функция СоздатьПриходнуюНакладную(ДанныеЗапроса, КонтекстАвторизации) Экспорт
	
	Результат = НовыйРезультатСоздания();
	
	Если ДанныеЗапроса = Неопределено Тогда
		Результат.error = "Тело запроса пустое.";
		Возврат Результат;
	КонецЕсли;
	
	УчетнаяЗапись = КонтекстАвторизации.УчетнаяЗапись;
	
	Поставщик = НайтиПоставщика(ДанныеЗапроса, УчетнаяЗапись, Результат.error);
	Если Результат.error <> "" Тогда
		Возврат Результат;
	КонецЕсли;
	
	Склад = StockAPI_Справочники.НайтиСклад(ДанныеЗапроса, УчетнаяЗапись, Результат.error);
	Если Результат.error <> "" Тогда
		Возврат Результат;
	КонецЕсли;
	
	СтрокаВалюты = StockAPI_Утилиты.СвойствоДанныхЗапроса(ДанныеЗапроса, "currency");
	Если СтрокаВалюты = "" Тогда
		Результат.error = "Укажите currency (код валюты).";
		Возврат Результат;
	КонецЕсли;
	Валюта = StockAPI_Цены.ВалютаДляЗаписиAPI(СтрокаВалюты);
	Если НЕ ЗначениеЗаполнено(Валюта) Тогда
		Результат.error = СтрШаблон("Не найдена валюта '%1'.", СтрокаВалюты);
		Возврат Результат;
	КонецЕсли;
	
	НомерПоставщика = СокрЛП(Строка(StockAPI_Утилиты.СвойствоДанныхЗапроса(
		ДанныеЗапроса, "supplierNumber,supplierNo,incomingNumber,incomingNo,incoming")));
	
	СтрокаДатыПоставщика = StockAPI_Утилиты.СвойствоДанныхЗапроса(ДанныеЗапроса, "supplierDate,incomingDate");
	ДатаПоставщика = Неопределено;
	Если СтрокаДатыПоставщика <> "" Тогда
		ДатаПоставщика = StockAPI_Утилиты.СтрокаВДату(СтрокаДатыПоставщика);
		Если ДатаПоставщика = Неопределено Тогда
			Результат.error = СтрШаблон("Некорректная дата supplierDate: '%1' (ожидается yyyy-MM-dd).", СтрокаДатыПоставщика);
			Возврат Результат;
		КонецЕсли;
	КонецЕсли;
	
	ДатаДокумента = ДатаДокументаПриходнойИзДанныхAPI(ДанныеЗапроса, Результат.error, Неопределено, Истина);
	Если Результат.error <> "" Тогда
		Возврат Результат;
	КонецЕсли;
	Если ДатаПоставщика = Неопределено Тогда
		ДатаПоставщика = НачалоДня(ДатаДокумента);
	КонецЕсли;
	
	Если НомерПоставщика <> "" Тогда
		Существующая = НайтиПриходнуюПоНомеруПоставщика(Поставщик, НомерПоставщика);
		Если ЗначениеЗаполнено(Существующая) Тогда
			ЗаполнитьРезультатПоДокументу(Результат, Существующая);
			Результат.error = СтрШаблон(
				"Приходная накладная с номером поставщика '%1' уже существует (%2).",
				НомерПоставщика,
				Существующая.Номер);
			Возврат Результат;
		КонецЕсли;
	КонецЕсли;
	
	СтрокиТоваров = СтрокиТоваровИзЗапроса(ДанныеЗапроса);
	Если СтрокиТоваров.Ошибки.Количество() > 0 Тогда
		Результат.error = StockAPI_Утилиты.ТекстОшибокСписка(СтрокиТоваров.Ошибки);
		Возврат Результат;
	КонецЕсли;
	Если СтрокиТоваров.Строки.Количество() = 0 Тогда
		Результат.error = "Список items пуст.";
		Возврат Результат;
	КонецЕсли;
	
	Примечание = СокрЛП(Строка(StockAPI_Утилиты.СвойствоДанныхЗапроса(ДанныеЗапроса, "note,comment")));
	
	СсылкаИнвойса = НайтиИнвойсОпциональноДляПриходной(ДанныеЗапроса, Поставщик, УчетнаяЗапись, Результат.error);
	Если Результат.error <> "" Тогда
		Возврат Результат;
	КонецЕсли;
	
	НачатьТранзакцию();
	Попытка
		
		Док = Документы.ПриходнаяНакладная.СоздатьДокумент();
		StockAPI_Утилиты.УстановитьУчетнуюЗаписьПриПервойЗаписи(Док, УчетнаяЗапись);
		Док.Дата = ДатаДокумента;
		Док.Фирма = ПараметрыСеанса.Фирма;
		Док.Контрагент = Поставщик;
		Док.Склад = Склад;
		Док.Валюта = Валюта;
		Док.НомерПоставщика = НомерПоставщика;
		Док.ДатаПоставщика = ДатаПоставщика;
		Док.Окончательно = Истина;
		Если ЗначениеЗаполнено(СсылкаИнвойса) Тогда
			Док.ВКД_Инвойс = СсылкаИнвойса;
		КонецЕсли;
		Если Примечание <> "" Тогда
			Док.Примечание = Лев(Примечание, 200);
		Иначе
			Док.Примечание = Лев(СтрШаблон("Создано StockAPI (%1)", УчетнаяЗапись.Наименование), 200);
		КонецЕсли;
		
		Док.Записать(РежимЗаписиДокумента.Запись);
		
		ДобавитьСтрокиТоваровВПриходную(Док, СтрокиТоваров.Строки, Валюта, Поставщик, ДатаДокумента);
		
		Док.Записать(РежимЗаписиДокумента.Проведение);
		
		ЗафиксироватьТранзакцию();
		
	Исключение
		ОтменитьТранзакцию();
		Результат.error = StockAPI_Утилиты.ТекстОшибкиЗаписиДокумента(
			ИнформацияОбОшибке(),
			"Не удалось создать приходную накладную");
		Возврат Результат;
	КонецПопытки;
	
	ЗаполнитьРезультатПоДокументу(Результат, Док.Ссылка);
	Результат.success = Истина;
	Возврат Результат;
	
КонецФункции

// PATCH /incomingwaybills — полная замена шапки (как POST) и табличной части «Товары».
//
// Параметры:
//  ДанныеЗапроса       - Структура - тело JSON и параметры URL (number, supplierNumber, date для поиска);
//  КонтекстАвторизации - Структура - поля УчетнаяЗапись и др.
//
// Возвращаемое значение:
//  Структура - как у POST; дополнительно НеНайден.
//
Функция ИзменитьПриходнуюНакладную(ДанныеЗапроса, КонтекстАвторизации) Экспорт
	
	Результат = НовыйРезультатСоздания();
	Результат.Вставить("НеНайден", Ложь);
	
	Если ДанныеЗапроса = Неопределено Тогда
		Результат.error = "Тело запроса пустое.";
		Возврат Результат;
	КонецЕсли;
	
	УчетнаяЗапись = КонтекстАвторизации.УчетнаяЗапись;
	
	СсылкаДокумента = НайтиПриходнуюДляРедактирования(ДанныеЗапроса, УчетнаяЗапись, Результат);
	Если НЕ ЗначениеЗаполнено(СсылкаДокумента) Тогда
		Если Результат.error = "" Тогда
			Результат.НеНайден = Истина;
		КонецЕсли;
		Возврат Результат;
	КонецЕсли;
	
	Если НЕ ДанныеЗапроса.Свойство("items") Тогда
		Результат.error = "В теле запроса нет массива items.";
		Возврат Результат;
	КонецЕсли;
	
	Поставщик = НайтиПоставщика(ДанныеЗапроса, УчетнаяЗапись, Результат.error);
	Если Результат.error <> "" Тогда
		Возврат Результат;
	КонецЕсли;
	
	Если Поставщик <> СсылкаДокумента.Контрагент Тогда
		Результат.error = "Поставщик в запросе не совпадает с контрагентом приходной накладной.";
		Возврат Результат;
	КонецЕсли;
	
	Склад = StockAPI_Справочники.НайтиСклад(ДанныеЗапроса, УчетнаяЗапись, Результат.error);
	Если Результат.error <> "" Тогда
		Возврат Результат;
	КонецЕсли;
	
	СтрокаВалюты = StockAPI_Утилиты.СвойствоДанныхЗапроса(ДанныеЗапроса, "currency");
	Если СтрокаВалюты = "" Тогда
		Результат.error = "Укажите currency (код валюты).";
		Возврат Результат;
	КонецЕсли;
	Валюта = StockAPI_Цены.ВалютаДляЗаписиAPI(СтрокаВалюты);
	Если НЕ ЗначениеЗаполнено(Валюта) Тогда
		Результат.error = СтрШаблон("Не найдена валюта '%1'.", СтрокаВалюты);
		Возврат Результат;
	КонецЕсли;
	
	СтрокиТоваров = СтрокиТоваровИзЗапроса(ДанныеЗапроса);
	Если СтрокиТоваров.Ошибки.Количество() > 0 Тогда
		Результат.error = StockAPI_Утилиты.ТекстОшибокСписка(СтрокиТоваров.Ошибки);
		Возврат Результат;
	КонецЕсли;
	Если СтрокиТоваров.Строки.Количество() = 0 Тогда
		Результат.error = "Список items пуст.";
		Возврат Результат;
	КонецЕсли;
	
	НомерПоставщика = СокрЛП(Строка(StockAPI_Утилиты.СвойствоДанныхЗапроса(
		ДанныеЗапроса, "supplierNumber,supplierNo,incomingNumber,incomingNo,incoming")));
	Если НомерПоставщика <> "" Тогда
		Другая = НайтиПриходнуюПоНомеруПоставщика(Поставщик, НомерПоставщика);
		Если ЗначениеЗаполнено(Другая) И Другая <> СсылкаДокумента Тогда
			Результат.error = СтрШаблон(
				"Номер поставщика '%1' уже используется приходной %2.",
				НомерПоставщика,
				Другая.Номер);
			Возврат Результат;
		КонецЕсли;
	КонецЕсли;
	
	СтрокаДатыПоставщика = StockAPI_Утилиты.СвойствоДанныхЗапроса(ДанныеЗапроса, "supplierDate,incomingDate");
	ДатаПоставщика = Неопределено;
	Если СтрокаДатыПоставщика <> "" Тогда
		ДатаПоставщика = StockAPI_Утилиты.СтрокаВДату(СтрокаДатыПоставщика);
		Если ДатаПоставщика = Неопределено Тогда
			Результат.error = СтрШаблон("Некорректная дата supplierDate: '%1' (ожидается yyyy-MM-dd).", СтрокаДатыПоставщика);
			Возврат Результат;
		КонецЕсли;
	КонецЕсли;
	
	Примечание = СокрЛП(Строка(StockAPI_Утилиты.СвойствоДанныхЗапроса(ДанныеЗапроса, "note,comment")));
	
	СсылкаИнвойса = НайтиИнвойсОпциональноДляПриходной(ДанныеЗапроса, Поставщик, УчетнаяЗапись, Результат.error);
	Если Результат.error <> "" Тогда
		Возврат Результат;
	КонецЕсли;
	
	НачатьТранзакцию();
	Попытка
		
		Док = СсылкаДокумента.ПолучитьОбъект();
		StockAPI_Утилиты.УстановитьУчетнуюЗаписьПриПервойЗаписи(Док, УчетнаяЗапись);
		Если Док.Проведен Тогда
			Док.Записать(РежимЗаписиДокумента.ОтменаПроведения);
		КонецЕсли;
		
		ОшибкаДаты = "";
		Док.Дата = ДатаДокументаПриходнойИзДанныхAPI(ДанныеЗапроса, ОшибкаДаты, Док.Дата);
		Если ОшибкаДаты <> "" Тогда
			Результат.error = ОшибкаДаты;
			ОтменитьТранзакцию();
			Возврат Результат;
		КонецЕсли;
		
		Док.Склад = Склад;
		Док.Валюта = Валюта;
		Если НомерПоставщика <> "" Тогда
			Док.НомерПоставщика = НомерПоставщика;
		КонецЕсли;
		Если ДатаПоставщика <> Неопределено Тогда
			Док.ДатаПоставщика = ДатаПоставщика;
		КонецЕсли;
		Если Примечание <> "" Тогда
			Док.Примечание = Лев(Примечание, 200);
		КонецЕсли;
		Если ДанныеЗапроса.Свойство("invoiceNumber")
			Или ДанныеЗапроса.Свойство("invoiceNo")
			Или ДанныеЗапроса.Свойство("invoiceSupplierNumber")
			Или ДанныеЗапроса.Свойство("invoiceSupplierNo") Тогда
			Док.ВКД_Инвойс = СсылкаИнвойса;
		КонецЕсли;
		
		Док.Товары.Очистить();
		ДобавитьСтрокиТоваровВПриходную(Док, СтрокиТоваров.Строки, Валюта, Поставщик, Док.Дата);
		
		Док.Окончательно = Истина;
		Док.Записать(РежимЗаписиДокумента.Проведение);
		
		ЗафиксироватьТранзакцию();
		
	Исключение
		ОтменитьТранзакцию();
		Результат.error = StockAPI_Утилиты.ТекстОшибкиЗаписиДокумента(
			ИнформацияОбОшибке(),
			"Не удалось изменить приходную накладную");
		Возврат Результат;
	КонецПопытки;
	
	ЗаполнитьРезультатПоДокументу(Результат, Док.Ссылка);
	Результат.success = Истина;
	Возврат Результат;
	
КонецФункции

// DELETE /incomingwaybills — пометка приходной накладной на удаление.
// Поиск документа — те же параметры, что у PATCH (number / supplierNumber, date, поставщик).
//
// Параметры:
//  ДанныеЗапроса       - Структура - тело JSON и параметры URL;
//  КонтекстАвторизации - Структура - поля УчетнаяЗапись и др.
//
// Возвращаемое значение:
//  Структура - как у POST; дополнительно НеНайден, deleted.
//
Функция ПометитьПриходнуюНакладнуюНаУдаление(ДанныеЗапроса, КонтекстАвторизации) Экспорт
	
	Результат = НовыйРезультатСоздания();
	Результат.Вставить("НеНайден", Ложь);
	Результат.Вставить("deleted", Ложь);
	
	Если ДанныеЗапроса = Неопределено Тогда
		Результат.error = "Тело запроса пустое.";
		Возврат Результат;
	КонецЕсли;
	
	УчетнаяЗапись = КонтекстАвторизации.УчетнаяЗапись;
	
	СсылкаДокумента = НайтиПриходнуюДляРедактирования(ДанныеЗапроса, УчетнаяЗапись, Результат);
	Если НЕ ЗначениеЗаполнено(СсылкаДокумента) Тогда
		Если Результат.error = "" Тогда
			Результат.НеНайден = Истина;
		КонецЕсли;
		Возврат Результат;
	КонецЕсли;
	
	Попытка
		
		Док = СсылкаДокумента.ПолучитьОбъект();
		Док.ДополнительныеСвойства.Вставить("ОтменаПроведенияЧерезAPI", Истина);
		Док.ДополнительныеСвойства.Вставить("БезПересчетаЦен", Истина);
		
		// УстановитьПометкуУдаления после смены Окончательно пишет объект дважды
		// и падает с «данные объекта модифицированы». Пометку и отмену проведения — одной записью.
		НужнаЗапись = Ложь;
		Если Док.Окончательно Тогда
			Док.Окончательно = Ложь;
			НужнаЗапись = Истина;
		КонецЕсли;
		Если НЕ Док.ПометкаУдаления Тогда
			Док.ПометкаУдаления = Истина;
			НужнаЗапись = Истина;
		КонецЕсли;
		
		Если НужнаЗапись Тогда
			Если Док.Проведен Тогда
				Док.Записать(РежимЗаписиДокумента.ОтменаПроведения);
			Иначе
				Док.Записать(РежимЗаписиДокумента.Запись);
			КонецЕсли;
		КонецЕсли;
		
	Исключение
		Результат.error = StockAPI_Утилиты.ТекстОшибкиЗаписиДокумента(
			ИнформацияОбОшибке(),
			"Не удалось пометить приходную накладную на удаление");
		Возврат Результат;
	КонецПопытки;
	
	ЗаполнитьРезультатПоДокументу(Результат, Док.Ссылка);
	Результат.success = Истина;
	Результат.deleted = Истина;
	Результат.posted = Ложь;
	Возврат Результат;
	
КонецФункции

// PUT /incomingwaybills — добавление позиций в существующую приходную накладную.
//
// Параметры:
//  ДанныеЗапроса       - Структура - тело JSON и параметры URL;
//  КонтекстАвторизации - Структура - поля УчетнаяЗапись и др.
//
// Возвращаемое значение:
//  Структура - как у POST; дополнительно НеНайден.
//
Функция ДобавитьПозицииВПриходнуюНакладную(ДанныеЗапроса, КонтекстАвторизации) Экспорт
	
	Результат = НовыйРезультатСоздания();
	Результат.Вставить("НеНайден", Ложь);
	
	Если ДанныеЗапроса = Неопределено Тогда
		Результат.error = "Тело запроса пустое.";
		Возврат Результат;
	КонецЕсли;
	
	УчетнаяЗапись = КонтекстАвторизации.УчетнаяЗапись;
	
	СсылкаДокумента = НайтиПриходнуюДляРедактирования(ДанныеЗапроса, УчетнаяЗапись, Результат);
	Если НЕ ЗначениеЗаполнено(СсылкаДокумента) Тогда
		Если Результат.error = "" Тогда
			Результат.НеНайден = Истина;
		КонецЕсли;
		Возврат Результат;
	КонецЕсли;
	
	Если НЕ ДанныеЗапроса.Свойство("items") Тогда
		Результат.error = "В теле запроса нет массива items.";
		Возврат Результат;
	КонецЕсли;
	
	СтрокиТоваров = СтрокиТоваровИзЗапроса(ДанныеЗапроса);
	Если СтрокиТоваров.Ошибки.Количество() > 0 Тогда
		Результат.error = StockAPI_Утилиты.ТекстОшибокСписка(СтрокиТоваров.Ошибки);
		Возврат Результат;
	КонецЕсли;
	Если СтрокиТоваров.Строки.Количество() = 0 Тогда
		Результат.error = "Список items пуст или все позиции отклонены.";
		Возврат Результат;
	КонецЕсли;
	
	НачатьТранзакцию();
	Попытка
		
		Док = СсылкаДокумента.ПолучитьОбъект();
		StockAPI_Утилиты.УстановитьУчетнуюЗаписьПриПервойЗаписи(Док, УчетнаяЗапись);
		Если Док.Проведен Тогда
			Док.Записать(РежимЗаписиДокумента.ОтменаПроведения);
		КонецЕсли;
		
		Если ЗаданаДатаДокументаПриходнойВЗапросе(ДанныеЗапроса) Тогда
			ОшибкаДаты = "";
			Док.Дата = ДатаДокументаПриходнойИзДанныхAPI(ДанныеЗапроса, ОшибкаДаты);
			Если ОшибкаДаты <> "" Тогда
				Результат.error = ОшибкаДаты;
				ОтменитьТранзакцию();
				Возврат Результат;
			КонецЕсли;
		КонецЕсли;
		
		ДобавитьСтрокиТоваровВПриходную(
			Док,
			СтрокиТоваров.Строки,
			Док.Валюта,
			Док.Контрагент,
			Док.Дата);
		
		Док.Окончательно = Истина;
		Док.Записать(РежимЗаписиДокумента.Проведение);
		
		ЗафиксироватьТранзакцию();
		
	Исключение
		ОтменитьТранзакцию();
		Результат.error = StockAPI_Утилиты.ТекстОшибкиЗаписиДокумента(
			ИнформацияОбОшибке(),
			"Не удалось добавить позиции в приходную накладную");
		Возврат Результат;
	КонецПопытки;
	
	ЗаполнитьРезультатПоДокументу(Результат, Док.Ссылка);
	Результат.success = Истина;
	Возврат Результат;
	
КонецФункции

// POST /invoices — создание или полная замена документа `_Инвойс` (upsert).
// Ключ: номер инвойса поставщика + поставщик. Замена запрещена, если есть приходные по инвойсу.
//
// Параметры:
//  ДанныеЗапроса       - Структура - тело JSON-запроса;
//  КонтекстАвторизации - Структура - поля УчетнаяЗапись и др.
//
// Возвращаемое значение:
//  Структура - success, error, number, date, seller, sellerCode, currency,
//              supplierNumber, supplierDate, posted, amount, items, replaced.
//
Функция СоздатьИлиЗаменитьИнвойс(ДанныеЗапроса, КонтекстАвторизации) Экспорт
	
	Результат = НовыйРезультатИнвойса();
	
	Если ДанныеЗапроса = Неопределено Тогда
		Результат.error = "Тело запроса пустое.";
		Возврат Результат;
	КонецЕсли;
	
	УчетнаяЗапись = КонтекстАвторизации.УчетнаяЗапись;
	
	Поставщик = НайтиПоставщика(ДанныеЗапроса, УчетнаяЗапись, Результат.error);
	Если Результат.error <> "" Тогда
		Возврат Результат;
	КонецЕсли;
	
	СтрокаВалюты = StockAPI_Утилиты.СвойствоДанныхЗапроса(ДанныеЗапроса, "currency");
	Если СтрокаВалюты = "" Тогда
		Результат.error = "Укажите currency (код валюты).";
		Возврат Результат;
	КонецЕсли;
	Валюта = StockAPI_Цены.ВалютаДляЗаписиAPI(СтрокаВалюты);
	Если НЕ ЗначениеЗаполнено(Валюта) Тогда
		Результат.error = СтрШаблон("Не найдена валюта '%1'.", СтрокаВалюты);
		Возврат Результат;
	КонецЕсли;
	
	НомерПоставщика = СокрЛП(Строка(StockAPI_Утилиты.СвойствоДанныхЗапроса(
		ДанныеЗапроса, "supplierNumber,supplierNo,invoiceNumber,invoiceNo")));
	Если НомерПоставщика = "" Тогда
		Результат.error = "Укажите supplierNumber (номер инвойса поставщика).";
		Возврат Результат;
	КонецЕсли;
	
	СтрокаДатыПоставщика = StockAPI_Утилиты.СвойствоДанныхЗапроса(ДанныеЗапроса, "supplierDate,invoiceDate");
	Если СтрокаДатыПоставщика = "" Тогда
		Результат.error = "Укажите supplierDate (дата инвойса поставщика, yyyy-MM-dd).";
		Возврат Результат;
	КонецЕсли;
	ДатаПоставщика = StockAPI_Утилиты.СтрокаВДату(СтрокаДатыПоставщика);
	Если ДатаПоставщика = Неопределено Тогда
		Результат.error = СтрШаблон("Некорректная дата supplierDate: '%1' (ожидается yyyy-MM-dd).", СтрокаДатыПоставщика);
		Возврат Результат;
	КонецЕсли;
	
	СтрокаДатыДокумента = StockAPI_Утилиты.СвойствоДанныхЗапроса(ДанныеЗапроса, "date");
	ДатаДокумента = Неопределено;
	Если СтрокаДатыДокумента <> "" Тогда
		ДатаДокумента = StockAPI_Утилиты.СтрокаВДату(СтрокаДатыДокумента);
		Если ДатаДокумента = Неопределено Тогда
			Результат.error = СтрШаблон("Некорректная дата date: '%1' (ожидается yyyy-MM-dd).", СтрокаДатыДокумента);
			Возврат Результат;
		КонецЕсли;
	Иначе
		ДатаДокумента = ТекущаяДатаСеанса();
	КонецЕсли;
	
	СтрокиТоваров = СтрокиТоваровИнвойсаИзЗапроса(ДанныеЗапроса);
	Если СтрокиТоваров.Ошибки.Количество() > 0 Тогда
		Результат.error = StockAPI_Утилиты.ТекстОшибокСписка(СтрокиТоваров.Ошибки);
		Возврат Результат;
	КонецЕсли;
	Если СтрокиТоваров.Строки.Количество() = 0 Тогда
		Результат.error = "Список items пуст.";
		Возврат Результат;
	КонецЕсли;
	
	Существующий = НайтиИнвойсПоНомеруПоставщика(Поставщик, НомерПоставщика);
	ЭтоЗамена = ЗначениеЗаполнено(Существующий);
	
	Если ЭтоЗамена Тогда
		Приходная = ПриходнаяПоИнвойсу(Существующий);
		Если ЗначениеЗаполнено(Приходная) Тогда
			ЗаполнитьРезультатПоИнвойсу(Результат, Существующий);
			Результат.replaced = Ложь;
			Если Приходная.Проведен Тогда
				Результат.error = СтрШаблон(
					"Нельзя заменить инвойс: есть проведённая приходная накладная %1.",
					Приходная.Номер);
			Иначе
				Результат.error = СтрШаблон(
					"Нельзя заменить инвойс: есть приходная накладная %1.",
					Приходная.Номер);
			КонецЕсли;
			Возврат Результат;
		КонецЕсли;
	КонецЕсли;
	
	Фирма = ПараметрыСеанса.Фирма;
	ИностраннаяВалютаЗакупки = (Валюта <> ПараметрыСеанса.БазоваяВалюта);
	
	НачатьТранзакцию();
	Попытка
		
		Если ЭтоЗамена Тогда
			Док = Существующий.ПолучитьОбъект();
			StockAPI_Утилиты.УстановитьУчетнуюЗаписьПриПервойЗаписи(Док, УчетнаяЗапись);
			Если Док.Проведен Тогда
				Док.Записать(РежимЗаписиДокумента.ОтменаПроведения);
			КонецЕсли;
			Док.ВКД_Товары.Очистить();
			Док.Поставки.Очистить();
		Иначе
			Док = Документы._Инвойс.СоздатьДокумент();
			StockAPI_Утилиты.УстановитьУчетнуюЗаписьПриПервойЗаписи(Док, УчетнаяЗапись);
		КонецЕсли;
		
		Док.Дата = ДатаДокумента;
		Док.Фирма = Фирма;
		Док.Контрагент = Поставщик;
		ЗаполнитьВалютуИКурсДокументаИнвойсаPOST(Док, Валюта);
		Док.ВКД_НомерИнвойсаПоставщика = НомерПоставщика;
		Док.ВКД_ДатаИнвойсаПоставщика = НачалоДня(ДатаПоставщика);
		Док.ВидОперации = Перечисления.ВидыОперацииИнвойс.Товар;
		Док.ТолькоУслуги = Ложь;
		Док.Примечание = ПримечаниеИнвойсаStockAPI(УчетнаяЗапись);
		
		ИдСтроки = 0;
		Для Каждого СтрТовара Из СтрокиТоваров.Строки Цикл
			ИдСтроки = ИдСтроки + 1;
			НовСтр = Док.ВКД_Товары.Добавить();
			ЗаполнитьСтрокуВКДТоваровИнвойсаPOST(НовСтр, СтрТовара, ИдСтроки, ИностраннаяВалютаЗакупки, Док.Курс);
		КонецЦикла;
		
		Док.Сумма = Док.ВКД_Товары.Итог("СуммаЗакупки");
		Док.ВКД_СуммаЗакупкиСоСкидкой = Док.ВКД_Товары.Итог("СуммаЗакупкиСоСкидкой");
		Док.ВКД_Количество = Док.ВКД_Товары.Итог("Количество");
		
		Док.Записать(РежимЗаписиДокумента.Проведение);
		
		ЗафиксироватьТранзакцию();
		
	Исключение
		ОтменитьТранзакцию();
		Результат.error = "Не удалось сохранить инвойс: "
			+ КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		Возврат Результат;
	КонецПопытки;
	
	ОшибкаВложения = "";
	Вложение = StockAPI_Утилиты.ИзвлечьВложениеИзДанныхЗапроса(ДанныеЗапроса, ОшибкаВложения);
	Если ОшибкаВложения <> "" Тогда
		ЗаполнитьРезультатПоИнвойсу(Результат, Док.Ссылка);
		Результат.replaced = ЭтоЗамена;
		Результат.error = ОшибкаВложения;
		Возврат Результат;
	КонецЕсли;
	Если Вложение <> Неопределено Тогда
		ОтказВложения = Ложь;
		ТекстОшибкиВложения = "";
		StockAPI_Утилиты.ПрикрепитьФайлКОбъекту(
			Док.Ссылка, Вложение.ИмяФайла, Вложение.ДвоичныеДанные, ОтказВложения, ТекстОшибкиВложения);
		Если ОтказВложения Тогда
			ЗаполнитьРезультатПоИнвойсу(Результат, Док.Ссылка);
			Результат.replaced = ЭтоЗамена;
			Результат.error = ?(ЗначениеЗаполнено(ТекстОшибкиВложения),
				ТекстОшибкиВложения, "Не удалось прикрепить файл к инвойсу.");
			Возврат Результат;
		КонецЕсли;
	КонецЕсли;
	
	ЗаполнитьРезультатПоИнвойсу(Результат, Док.Ссылка);
	Результат.replaced = ЭтоЗамена;
	Результат.success = Истина;
	Возврат Результат;
	
КонецФункции

// PUT /invoices — добавление позиций в существующий `_Инвойс`.
// Изменение запрещено, если по инвойсу есть приходная накладная.
//
// Параметры:
//  ДанныеЗапроса - Структура - тело JSON и параметры URL;
//  УчетнаяЗапись - СправочникСсылка.УчетныеЗаписиИнтеграции - учётная запись API.
//
// Возвращаемое значение:
//  Структура - success, error, number, date, seller, sellerCode, currency,
//              supplierNumber, supplierDate, posted, amount, items, НеНайден, Приходован.
//
Функция ДобавитьПозицииВИнвойс(ДанныеЗапроса, УчетнаяЗапись) Экспорт
	
	Результат = НовыйРезультатИнвойса();
	Результат.Вставить("НеНайден", Ложь);
	Результат.Вставить("Приходован", Ложь);
	
	Если ДанныеЗапроса = Неопределено Тогда
		Результат.error = "Тело запроса пустое.";
		Возврат Результат;
	КонецЕсли;
	
	СсылкаИнвойса = НайтиИнвойсДляРедактирования(ДанныеЗапроса, УчетнаяЗапись, Результат);
	Если НЕ ЗначениеЗаполнено(СсылкаИнвойса) Тогда
		Возврат Результат;
	КонецЕсли;
	
	Приходная = ПриходнаяПоИнвойсу(СсылкаИнвойса);
	Если ЗначениеЗаполнено(Приходная) Тогда
		ЗаполнитьРезультатПоИнвойсу(Результат, СсылкаИнвойса);
		Результат.Приходован = Приходная.Проведен;
		Если Приходная.Проведен Тогда
			Результат.error = СтрШаблон(
				"Нельзя изменить инвойс: есть проведённая приходная накладная %1.",
				Приходная.Номер);
		Иначе
			Результат.error = СтрШаблон(
				"Нельзя изменить инвойс: есть приходная накладная %1.",
				Приходная.Номер);
		КонецЕсли;
		Возврат Результат;
	КонецЕсли;
	
	СтрокиТоваров = СтрокиТоваровИнвойсаИзЗапроса(ДанныеЗапроса);
	Если СтрокиТоваров.Ошибки.Количество() > 0 Тогда
		Результат.error = StockAPI_Утилиты.ТекстОшибокСписка(СтрокиТоваров.Ошибки);
		Возврат Результат;
	КонецЕсли;
	Если СтрокиТоваров.Строки.Количество() = 0 Тогда
		Результат.error = "Список items пуст или все позиции отклонены.";
		Возврат Результат;
	КонецЕсли;
	
	ВалютаЗапроса = Неопределено;
	СтрокаВалюты = StockAPI_Утилиты.СвойствоДанныхЗапроса(ДанныеЗапроса, "currency");
	Если СтрокаВалюты <> "" Тогда
		ВалютаЗапроса = StockAPI_Цены.ВалютаДляЗаписиAPI(СтрокаВалюты);
		Если НЕ ЗначениеЗаполнено(ВалютаЗапроса) Тогда
			Результат.error = СтрШаблон("Не найдена валюта '%1'.", СтрокаВалюты);
			Возврат Результат;
		КонецЕсли;
	КонецЕсли;
	
	НачатьТранзакцию();
	Попытка
		
		Док = СсылкаИнвойса.ПолучитьОбъект();
		StockAPI_Утилиты.УстановитьУчетнуюЗаписьПриПервойЗаписи(Док, УчетнаяЗапись);
		Если Док.Проведен Тогда
			Док.Записать(РежимЗаписиДокумента.ОтменаПроведения);
		КонецЕсли;
		
		Если ВалютаЗапроса <> Неопределено Тогда
			ЗаполнитьВалютуИКурсДокументаИнвойсаPOST(Док, ВалютаЗапроса);
			ИностраннаяВалютаЗакупки = (ВалютаЗапроса <> ПараметрыСеанса.БазоваяВалюта);
		Иначе
			АктуализироватьВалютуЗакупкиИКурсДокументаИнвойсаПриДополнении(Док);
			ВалютаЗакупки = ?(ЗначениеЗаполнено(Док.ВалютаЗакупки), Док.ВалютаЗакупки, Док.Валюта);
			ИностраннаяВалютаЗакупки = (ВалютаЗакупки <> ПараметрыСеанса.БазоваяВалюта);
		КонецЕсли;
		
		ИдСтроки = 0;
		Для Каждого СтрТЧ Из Док.ВКД_Товары Цикл
			Если СтрТЧ.ИДСтроки > ИдСтроки Тогда
				ИдСтроки = СтрТЧ.ИДСтроки;
			КонецЕсли;
		КонецЦикла;
		
		Для Каждого СтрТовара Из СтрокиТоваров.Строки Цикл
			ИдСтроки = ИдСтроки + 1;
			НовСтр = Док.ВКД_Товары.Добавить();
			ЗаполнитьСтрокуВКДТоваровИнвойсаPOST(НовСтр, СтрТовара, ИдСтроки, ИностраннаяВалютаЗакупки, Док.Курс);
		КонецЦикла;
		
		Док.Сумма = Док.ВКД_Товары.Итог("СуммаЗакупки");
		Док.ВКД_СуммаЗакупкиСоСкидкой = Док.ВКД_Товары.Итог("СуммаЗакупкиСоСкидкой");
		Док.ВКД_Количество = Док.ВКД_Товары.Итог("Количество");
		Док.Примечание = ПримечаниеИнвойсаStockAPI(УчетнаяЗапись);
		
		Док.Записать(РежимЗаписиДокумента.Проведение);
		
		ЗафиксироватьТранзакцию();
		
	Исключение
		ОтменитьТранзакцию();
		Результат.error = "Не удалось сохранить инвойс: "
			+ КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		Возврат Результат;
	КонецПопытки;
	
	ЗаполнитьРезультатПоИнвойсу(Результат, Док.Ссылка);
	Результат.success = Истина;
	Возврат Результат;
	
КонецФункции

// GET /invoices — один инвойс или список с пагинацией в рамках поставщиков учётной записи.
// В каждом элементе items поле currency — ВалютаЗакупки, если заполнена, иначе Валюта (см. ВалютаИнвойсаДляОтветаAPI).
//
// Параметры:
//  Запрос        - HTTPСервисЗапрос - входящий запрос;
//  УчетнаяЗапись - СправочникСсылка.УчетныеЗаписиИнтеграции - учётная запись API.
//
// Возвращаемое значение:
//  Структура - Тело (page, pageSize, totalItems, totalPages, items), Ошибка, НеНайден.
//
Функция ПолучитьИнвойсы(Запрос, УчетнаяЗапись) Экспорт
	
	Результат = Новый Структура("Тело, Ошибка, НеНайден", Неопределено, "", Ложь);
	
	Фильтр = ПараметрыПоискаИнвойсов(Запрос, УчетнаяЗапись);
	Если Фильтр.Ошибка <> "" Тогда
		Результат.Ошибка = Фильтр.Ошибка;
		Возврат Результат;
	КонецЕсли;
	
	Пагинация = StockAPI_Утилиты.ПараметрыПагинацииОстатков(Запрос);
	Если Пагинация.Ошибка <> "" Тогда
		Результат.Ошибка = Пагинация.Ошибка;
		Возврат Результат;
	КонецЕсли;
	
	Если Фильтр.Режим = "single" Тогда
		
		СсылкаИнвойса = НайтиИнвойсДляЧтения(Фильтр, УчетнаяЗапись, Результат);
		Если Результат.Ошибка <> "" Тогда
			Возврат Результат;
		КонецЕсли;
		
		МассивИнвойсов = Новый Массив;
		МассивИнвойсов.Добавить(СтруктураИнвойсаJSON(СсылкаИнвойса));
		
		ТелоОтвета = Новый Структура;
		ТелоОтвета.Вставить("page", 1);
		ТелоОтвета.Вставить("pageSize", Пагинация.pageSize);
		ТелоОтвета.Вставить("totalItems", 1);
		ТелоОтвета.Вставить("totalPages", 1);
		ТелоОтвета.Вставить("items", МассивИнвойсов);
		Результат.Тело = ТелоОтвета;
		
	Иначе
		
		МассивСсылок = МассивИнвойсовПоФильтру(Фильтр, УчетнаяЗапись);
		Всего = МассивСсылок.Количество();
		ВсегоСтраниц = StockAPI_Утилиты.ВсегоСтраницПагинации(Всего, Пагинация.pageSize);
		Пропустить = (Пагинация.page - 1) * Пагинация.pageSize;
		
		МассивИнвойсов = Новый Массив;
		Индекс = 0;
		Для Каждого СсылкаИнвойса Из МассивСсылок Цикл
			Если Индекс >= Пропустить И МассивИнвойсов.Количество() < Пагинация.pageSize Тогда
				МассивИнвойсов.Добавить(СтруктураИнвойсаJSON(СсылкаИнвойса));
			КонецЕсли;
			Индекс = Индекс + 1;
			Если МассивИнвойсов.Количество() >= Пагинация.pageSize Тогда
				Прервать;
			КонецЕсли;
		КонецЦикла;
		
		ТелоОтвета = Новый Структура;
		ТелоОтвета.Вставить("page", Пагинация.page);
		ТелоОтвета.Вставить("pageSize", Пагинация.pageSize);
		ТелоОтвета.Вставить("totalItems", Всего);
		ТелоОтвета.Вставить("totalPages", ВсегоСтраниц);
		ТелоОтвета.Вставить("items", МассивИнвойсов);
		Результат.Тело = ТелоОтвета;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// GET /incomingwaybills — получение приходной накладной или списка с пагинацией.
// Параметры и проверки — как у GET /invoices.
//
// Параметры:
//  Запрос        - HTTPСервисЗапрос - входящий запрос;
//  УчетнаяЗапись - СправочникСсылка.УчетныеЗаписиИнтеграции - учётная запись API.
//
// Возвращаемое значение:
//  Структура - Тело, Ошибка, НеНайден.
//
Функция ПолучитьПриходныеНакладные(Запрос, УчетнаяЗапись) Экспорт
	
	Результат = Новый Структура("Тело, Ошибка, НеНайден", Неопределено, "", Ложь);
	
	Фильтр = ПараметрыПоискаИнвойсов(Запрос, УчетнаяЗапись);
	Если Фильтр.Ошибка <> "" Тогда
		Результат.Ошибка = Фильтр.Ошибка;
		Возврат Результат;
	КонецЕсли;
	
	Пагинация = StockAPI_Утилиты.ПараметрыПагинацииОстатков(Запрос);
	Если Пагинация.Ошибка <> "" Тогда
		Результат.Ошибка = Пагинация.Ошибка;
		Возврат Результат;
	КонецЕсли;
	
	Если Фильтр.Режим = "single" Тогда
		
		СсылкаДокумента = НайтиПриходнуюДляЧтения(Фильтр, УчетнаяЗапись, Результат);
		Если Результат.Ошибка <> "" Тогда
			Возврат Результат;
		КонецЕсли;
		
		МассивДокументов = Новый Массив;
		МассивДокументов.Добавить(СтруктураПриходнойJSON(СсылкаДокумента));
		
		ТелоОтвета = Новый Структура;
		ТелоОтвета.Вставить("page", 1);
		ТелоОтвета.Вставить("pageSize", Пагинация.pageSize);
		ТелоОтвета.Вставить("totalItems", 1);
		ТелоОтвета.Вставить("totalPages", 1);
		ТелоОтвета.Вставить("items", МассивДокументов);
		Результат.Тело = ТелоОтвета;
		
	Иначе
		
		МассивСсылок = МассивПриходныхПоФильтру(Фильтр, УчетнаяЗапись);
		Всего = МассивСсылок.Количество();
		ВсегоСтраниц = StockAPI_Утилиты.ВсегоСтраницПагинации(Всего, Пагинация.pageSize);
		Пропустить = (Пагинация.page - 1) * Пагинация.pageSize;
		
		МассивДокументов = Новый Массив;
		Индекс = 0;
		Для Каждого СсылкаДокумента Из МассивСсылок Цикл
			Если Индекс >= Пропустить И МассивДокументов.Количество() < Пагинация.pageSize Тогда
				МассивДокументов.Добавить(СтруктураПриходнойJSON(СсылкаДокумента));
			КонецЕсли;
			Индекс = Индекс + 1;
			Если МассивДокументов.Количество() >= Пагинация.pageSize Тогда
				Прервать;
			КонецЕсли;
		КонецЦикла;
		
		ТелоОтвета = Новый Структура;
		ТелоОтвета.Вставить("page", Пагинация.page);
		ТелоОтвета.Вставить("pageSize", Пагинация.pageSize);
		ТелоОтвета.Вставить("totalItems", Всего);
		ТелоОтвета.Вставить("totalPages", ВсегоСтраниц);
		ТелоОтвета.Вставить("items", МассивДокументов);
		Результат.Тело = ТелоОтвета;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти


#Область СлужебныеПроцедурыИФункции

// Дата документа приходной из JSON: date, dateTime, documentDate.
//
// Параметры:
//  ДанныеЗапроса                 - Структура - тело запроса;
//  Ошибка                        - Строка - текст ошибки разбора (выходной параметр);
//  ДатаЕслиНеЗадано              - Дата, Неопределено - при отсутствии полей в запросе: Неопределено → ТекущаяДатаСеанса(),
//                                  иначе — переданное значение (для PATCH — сохранить дату документа);
//  ТекущееВремяЕслиНеУказано     - Булево - Истина: если в строке нет времени, подставить текущее время сеанса.
//
// Возвращаемое значение:
//  Дата - значение для реквизита Дата.
//
Функция ДатаДокументаПриходнойИзДанныхAPI(ДанныеЗапроса, Ошибка, ДатаЕслиНеЗадано = Неопределено, ТекущееВремяЕслиНеУказано = Ложь)
	
	Ошибка = "";
	СтрокаДатыДокумента = СокрЛП(Строка(StockAPI_Утилиты.СвойствоДанныхЗапроса(
		ДанныеЗапроса, "date,dateTime,documentDate")));
	
	Если СтрокаДатыДокумента = "" Тогда
		Если ДатаЕслиНеЗадано = Неопределено Тогда
			Возврат ТекущаяДатаСеанса();
		КонецЕсли;
		Возврат ДатаЕслиНеЗадано;
	КонецЕсли;
	
	ДатаДокумента = StockAPI_Утилиты.СтрокаВДатуВремя(СтрокаДатыДокумента);
	Если ДатаДокумента = Неопределено Тогда
		Ошибка = СтрШаблон(
			"Некорректная дата документа '%1' (ожидается yyyy-MM-dd или yyyy-MM-ddTHH:mm:ss).",
			СтрокаДатыДокумента);
		Возврат ДатаДокумента;
	КонецЕсли;
	
	Если ТекущееВремяЕслиНеУказано И НЕ СтрокаДатыДокументаСодержитВремя(СтрокаДатыДокумента) Тогда
		Возврат ДатаСТекущимВременемСеанса(ДатаДокумента);
	КонецЕсли;
	
	Возврат ДатаДокумента;
	
КонецФункции

// Истина, если в строке даты API есть непустая часть времени (после T или пробела).
//
// Параметры:
//  СтрокаДаты - Строка - дата или дата-время из запроса.
//
// Возвращаемое значение:
//  Булево - Истина, если время указано явно.
//
Функция СтрокаДатыДокументаСодержитВремя(СтрокаДаты)
	
	ПозицияT = СтрНайти(СтрокаДаты, "T");
	Если ПозицияT > 0 Тогда
		Возврат СокрЛП(Сред(СтрокаДаты, ПозицияT + 1)) <> "";
	КонецЕсли;
	
	ПозицияПробел = СтрНайти(СтрокаДаты, " ");
	Если ПозицияПробел > 0 Тогда
		Возврат СокрЛП(Сред(СтрокаДаты, ПозицияПробел + 1)) <> "";
	КонецЕсли;
	
	Возврат Ложь;
	
КонецФункции

// Подставляет к дате текущие час, минуту и секунду сеанса.
//
// Параметры:
//  ДатаДокумента - Дата - дата без времени или с любым временем.
//
// Возвращаемое значение:
//  Дата - та же календарная дата с текущим временем сеанса.
//
Функция ДатаСТекущимВременемСеанса(ДатаДокумента)
	
	ТекущийМомент = ТекущаяДатаСеанса();
	Возврат Дата(
		Год(ДатаДокумента),
		Месяц(ДатаДокумента),
		День(ДатаДокумента),
		Час(ТекущийМомент),
		Минута(ТекущийМомент),
		Секунда(ТекущийМомент));
	
КонецФункции

// Истина, если в запросе явно передано date / dateTime / documentDate (непустая строка).
//
Функция ЗаданаДатаДокументаПриходнойВЗапросе(ДанныеЗапроса)
	
	Возврат СокрЛП(Строка(StockAPI_Утилиты.СвойствоДанныхЗапроса(
		ДанныеЗапроса, "date,dateTime,documentDate"))) <> "";
	
КонецФункции

// Добавляет строки в ТЧ «Товары» с созданием партий (как POST /incomingwaybills).
//
// Параметры:
//  Док           - ДокументОбъект.ПриходнаяНакладная;
//  СтрокиТоваров - Массив из Структура - Номенклатура, Цена, Серия, Количество;
//  Валюта        - СправочникСсылка.Валюты;
//  Поставщик     - СправочникСсылка.Контрагенты;
//  ДатаДокумента - Дата - дата документа для партий.
//
Процедура ДобавитьСтрокиТоваровВПриходную(Док, СтрокиТоваров, Валюта, Поставщик, ДатаДокумента)
	
	Для Каждого СтрТовара Из СтрокиТоваров Цикл
		
		Партия = СоздатьПартиюПрихода(
			Док.Ссылка,
			СтрТовара.Номенклатура,
			СтрТовара.Цена,
			СтрТовара.Серия,
			Валюта,
			ДатаДокумента,
			Док.Фирма,
			Поставщик);
		
		НовСтр = Док.Товары.Добавить();
		НовСтр.Номенклатура = СтрТовара.Номенклатура;
		НовСтр.Партия = Партия;
		НовСтр.Серия = СтрТовара.Серия;
		НовСтр.Количество = СтрТовара.Количество;
		НовСтр.ЦенаЗакупки = СтрТовара.Цена;
		НовСтр.СуммаЗакупки = СтрТовара.Цена * СтрТовара.Количество;
		НовСтр.ВКД_ЦенаСоСкидкой = СтрТовара.Цена;
		НовСтр.ВКД_СуммаСоСкидкой = НовСтр.СуммаЗакупки;
		НовСтр.ВКД_ЦенаСЗатратами = СтрТовара.Цена;
		НовСтр.ВКД_СуммаСЗатратами = НовСтр.СуммаЗакупки;
		
	КонецЦикла;
	
КонецПроцедуры

// Ищет приходную для PUT/PATCH: number и/или supplierNumber (+ date, sellerCode для уточнения).
//
// Параметры:
//  ДанныеЗапроса - Структура - тело JSON / параметры URL;
//  УчетнаяЗапись - СправочникСсылка.УчетныеЗаписиИнтеграции;
//  Результат     - Структура - поля error, НеНайден.
//
// Возвращаемое значение:
//  ДокументСсылка.ПриходнаяНакладная
//
Функция НайтиПриходнуюДляРедактирования(ДанныеЗапроса, УчетнаяЗапись, Результат)
	
	Фильтр = Новый Структура(
		"Режим, number, supplierNumber, date, Поставщик, dateFrom, dateTo, Ошибка",
		"single", "", "", '00010101', Неопределено, '00010101', '00010101', "");
	
	Фильтр.number = СокрЛП(Строка(StockAPI_Утилиты.СвойствоДанныхЗапроса(
		ДанныеЗапроса, "number,invoiceNumber,invoiceNo")));
	Фильтр.supplierNumber = СокрЛП(Строка(StockAPI_Утилиты.СвойствоДанныхЗапроса(
		ДанныеЗапроса, "supplierNumber,supplierNo,incomingNumber,incomingNo,incoming")));
	
	Если Фильтр.number = "" И Фильтр.supplierNumber = "" Тогда
		Результат.error = "Укажите number (номер документа 1С) или supplierNumber (номер поставщика).";
		Результат.НеНайден = Ложь;
		Возврат Документы.ПриходнаяНакладная.ПустаяСсылка();
	КонецЕсли;
	
	СтрокаДаты = StockAPI_Утилиты.СвойствоДанныхЗапроса(ДанныеЗапроса, "date");
	Если СтрокаДаты <> "" Тогда
		ДатаПоиска = StockAPI_Утилиты.СтрокаВДату(СтрокаДаты);
		Если ДатаПоиска = Неопределено Тогда
			Результат.error = СтрШаблон("Некорректная дата date: '%1' (ожидается yyyy-MM-dd).", СтрокаДаты);
			Возврат Документы.ПриходнаяНакладная.ПустаяСсылка();
		КонецЕсли;
		Фильтр.date = НачалоДня(ДатаПоиска);
	КонецЕсли;
	
	КодПоиска = StockAPI_Утилиты.СвойствоДанныхЗапроса(ДанныеЗапроса, "sellerCode,supplierCode,code");
	Псевдоним = StockAPI_Утилиты.СвойствоДанныхЗапроса(ДанныеЗапроса, "alias,seller,supplier");
	Если КодПоиска <> "" Или Псевдоним <> "" Тогда
		ДанныеПоставщика = Новый Структура;
		Если КодПоиска <> "" Тогда
			ДанныеПоставщика.Вставить("sellerCode", КодПоиска);
		КонецЕсли;
		Если Псевдоним <> "" Тогда
			ДанныеПоставщика.Вставить("alias", Псевдоним);
		КонецЕсли;
		ОшибкаПоставщика = "";
		Поставщик = НайтиПоставщика(ДанныеПоставщика, УчетнаяЗапись, ОшибкаПоставщика);
		Если ОшибкаПоставщика <> "" Тогда
			Результат.error = ОшибкаПоставщика;
			Возврат Документы.ПриходнаяНакладная.ПустаяСсылка();
		КонецЕсли;
		Фильтр.Поставщик = Поставщик;
	КонецЕсли;
	
	РезультатПоиска = Новый Структура("Ошибка, НеНайден", "", Ложь);
	СсылкаДокумента = НайтиПриходнуюДляЧтения(Фильтр, УчетнаяЗапись, РезультатПоиска);
	Если РезультатПоиска.Ошибка <> "" Тогда
		Результат.error = РезультатПоиска.Ошибка;
		Результат.НеНайден = РезультатПоиска.НеНайден;
	КонецЕсли;
	
	Возврат СсылкаДокумента;
	
КонецФункции

Функция НовыйРезультатСоздания()
	
	Возврат Новый Структура(
		"success, error, number, date, seller, sellerCode, warehouse, warehouseCode, currency, supplierNumber, supplierDate, posted, amount, items",
		Ложь, "", "", "", "", "", "", "", "", "", "", Ложь, 0, Новый Массив);
	
КонецФункции

Функция НовыйРезультатИнвойса()
	
	Возврат Новый Структура(
		"success, error, number, date, seller, sellerCode, currency, supplierNumber, supplierDate, posted, amount, items, replaced",
		Ложь, "", "", "", "", "", "", "", "", Ложь, 0, Новый Массив, Ложь);
	
КонецФункции

// Ищет поставщика в иерархии групп ТЧ «Поставщики» учётной записи.
//
// Параметры:
//  ДанныеЗапроса - Структура - sellerCode / seller / code / alias;
//  УчетнаяЗапись - СправочникСсылка.УчетныеЗаписиИнтеграции;
//  Ошибка        - Строка - текст ошибки.
//
// Возвращаемое значение:
//  СправочникСсылка.Контрагенты.
//
Функция НайтиПоставщика(ДанныеЗапроса, УчетнаяЗапись, Ошибка)
	
	КодПоиска = StockAPI_Утилиты.СвойствоДанныхЗапроса(ДанныеЗапроса, "sellerCode,supplierCode,code");
	Псевдоним = StockAPI_Утилиты.СвойствоДанныхЗапроса(ДанныеЗапроса, "alias,seller,supplier");
	
	Если КодПоиска = "" И Псевдоним = "" Тогда
		Ошибка = "Укажите поставщика: sellerCode (или supplierCode, code) либо alias (или seller, supplier).";
		Возврат Справочники.Контрагенты.ПустаяСсылка();
	КонецЕсли;
	
	КодЧисло = Неопределено;
	Если КодПоиска <> "" Тогда
		Попытка
			КодЧисло = Число(СокрЛП(Строка(КодПоиска)));
		Исключение
			Ошибка = СтрШаблон("Значение кода поставщика не числовое: '%1'.", КодПоиска);
			Возврат Справочники.Контрагенты.ПустаяСсылка();
		КонецПопытки;
	КонецЕсли;
	
	Запр = Новый Запрос;
	Запр.УстановитьПараметр("УчетнаяЗапись", УчетнаяЗапись);
	Запр.УстановитьПараметр("Код", КодЧисло);
	Запр.УстановитьПараметр("Псевдоним", СокрЛП(Строка(Псевдоним)));
	Запр.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Конт.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.Контрагенты КАК Конт
	|ГДЕ
	|	Конт.Ссылка В ИЕРАРХИИ
	|			(ВЫБРАТЬ РАЗЛИЧНЫЕ
	|				ТЧ.ГруппаКонтрагентов
	|			ИЗ
	|				Справочник.УчетныеЗаписиИнтеграции.Поставщики КАК ТЧ
	|			ГДЕ
	|				ТЧ.Ссылка = &УчетнаяЗапись
	|				И ТЧ.ГруппаКонтрагентов <> ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)
	|				И НЕ ТЧ.ГруппаКонтрагентов.ПометкаУдаления)
	|	И НЕ Конт.ЭтоГруппа
	|	И НЕ Конт.ПометкаУдаления
	|	И ВЫБОР
	|			КОГДА &Код = НЕОПРЕДЕЛЕНО
	|				ТОГДА ИСТИНА
	|			ИНАЧЕ Конт.Код = &Код
	|		КОНЕЦ
	|	И ВЫБОР
	|			КОГДА &Псевдоним = """"
	|				ТОГДА ИСТИНА
	|			ИНАЧЕ Конт.Псевдоним = &Псевдоним
	|					ИЛИ Конт.Наименование = &Псевдоним
	|		КОНЕЦ";
	
	Выборка = Запр.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;
	
	Ошибка = "Поставщик не найден в иерархии «Поставщики» учётной записи.";
	Возврат Справочники.Контрагенты.ПустаяСсылка();
	
КонецФункции

Функция НайтиПриходнуюПоНомеруПоставщика(Поставщик, НомерПоставщика)
	
	Запр = Новый Запрос;
	Запр.УстановитьПараметр("Контрагент", Поставщик);
	Запр.УстановитьПараметр("НомерПоставщика", НомерПоставщика);
	Запр.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Док.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.ПриходнаяНакладная КАК Док
	|ГДЕ
	|	Док.Контрагент = &Контрагент
	|	И Док.НомерПоставщика = &НомерПоставщика
	|	И НЕ Док.ПометкаУдаления
	|
	|УПОРЯДОЧИТЬ ПО
	|	Док.Дата УБЫВ";
	
	Выборка = Запр.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;
	
	Возврат Документы.ПриходнаяНакладная.ПустаяСсылка();
	
КонецФункции

Функция СтрокиТоваровИзЗапроса(ДанныеЗапроса)
	
	Результат = Новый Структура("Строки, Ошибки", Новый Массив, Новый СписокЗначений);
	
	Если НЕ ДанныеЗапроса.Свойство("items") Тогда
		Результат.Ошибки.Добавить("В теле запроса нет массива items.");
		Возврат Результат;
	КонецЕсли;
	
	Если ТипЗнч(ДанныеЗапроса.items) <> Тип("Массив") Тогда
		Результат.Ошибки.Добавить("Поле items должно быть массивом.");
		Возврат Результат;
	КонецЕсли;
	
	УникальныеСерии = Новый Соответствие;
	НомерПозиции = 0;
	
	Для Каждого Позиция Из ДанныеЗапроса.items Цикл
		
		НомерПозиции = НомерПозиции + 1;
		Если ТипЗнч(Позиция) <> Тип("Структура") И ТипЗнч(Позиция) <> Тип("Соответствие") Тогда
			Результат.Ошибки.Добавить(СтрШаблон("Строка %1: элемент items должен быть объектом.", НомерПозиции));
			Продолжить;
		КонецЕсли;
		
		Номенклатура = НайтиНоменклатуруПоПозиции(Позиция);
		Если НЕ ЗначениеЗаполнено(Номенклатура) Тогда
			Результат.Ошибки.Добавить(СтрШаблон("Строка %1: укажите itemCode или item (наименование).", НомерПозиции));
			Продолжить;
		КонецЕсли;
		
		Если Номенклатура.ЭтоГруппа Тогда
			Результат.Ошибки.Добавить(СтрШаблон("Строка %1: '%2' является группой номенклатуры.",
				НомерПозиции, СокрЛП(Номенклатура.Наименование)));
			Продолжить;
		КонецЕсли;
		
		Если Номенклатура.ТипНоменклатуры <> Перечисления.ТипыНоменклатуры.Товар Тогда
			Результат.Ошибки.Добавить(СтрШаблон("Строка %1: '%2' не является товаром.",
				НомерПозиции, СокрЛП(Номенклатура.Наименование)));
			Продолжить;
		КонецЕсли;
		
		Цена = ЧислоИзПоляПозиции(Позиция, "price,purchasePrice");
		Если Цена = Неопределено Тогда
			Результат.Ошибки.Добавить(СтрШаблон("Строка %1: укажите price (цена закупки).", НомерПозиции));
			Продолжить;
		КонецЕсли;
		Если Цена < 0 Тогда
			Результат.Ошибки.Добавить(СтрШаблон("Строка %1: цена не может быть отрицательной.", НомерПозиции));
			Продолжить;
		КонецЕсли;
		
		УчетПоСериям = (Номенклатура.УчетПоСериям = Истина);
		МассивСерий = СерииИзПозиции(Позиция);
		
		Если УчетПоСериям Тогда
			
			Если МассивСерий.Количество() = 0 Тогда
				Результат.Ошибки.Добавить(СтрШаблон(
					"Строка %1: для серийного товара '%2' укажите serial или serials.",
					НомерПозиции,
					СокрЛП(Номенклатура.Наименование)));
				Продолжить;
			КонецЕсли;
			
			Для Каждого СерияСтрокой Из МассивСерий Цикл
				
				КлючСерии = ВРег(СерияСтрокой);
				Если УникальныеСерии.Получить(КлючСерии) <> Неопределено Тогда
					Результат.Ошибки.Добавить(СтрШаблон("Строка %1: серия '%2' повторяется в запросе.",
						НомерПозиции, СерияСтрокой));
					Продолжить;
				КонецЕсли;
				УникальныеСерии.Вставить(КлючСерии, Истина);
				
				Стр = Новый Структура("Номенклатура, Количество, Цена, Серия",
					Номенклатура, 1, Цена, СерияСтрокой);
				Результат.Строки.Добавить(Стр);
				
			КонецЦикла;
			
		Иначе
			
			Если МассивСерий.Количество() > 0 Тогда
				Результат.Ошибки.Добавить(СтрШаблон(
					"Строка %1: у товара '%2' нет учёта по сериям — поле serial/serials недопустимо.",
					НомерПозиции,
					СокрЛП(Номенклатура.Наименование)));
				Продолжить;
			КонецЕсли;
			
			Количество = ЧислоИзПоляПозиции(Позиция, "qty,quantity,count");
			Если Количество = Неопределено Тогда
				Результат.Ошибки.Добавить(СтрШаблон("Строка %1: укажите qty (количество).", НомерПозиции));
				Продолжить;
			КонецЕсли;
			Если Количество <= 0 Тогда
				Результат.Ошибки.Добавить(СтрШаблон("Строка %1: количество должно быть больше нуля.", НомерПозиции));
				Продолжить;
			КонецЕсли;
			
			Стр = Новый Структура("Номенклатура, Количество, Цена, Серия",
				Номенклатура, Количество, Цена, "");
			Результат.Строки.Добавить(Стр);
			
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция НайтиНоменклатуруПоПозиции(Позиция)
	
	КодТовара = StockAPI_Утилиты.СвойствоДанныхЗапроса(Позиция, "itemCode,code");
	Если КодТовара <> "" Тогда
		Номенклатура = Справочники.Номенклатура.НайтиПоКоду(СокрЛП(Строка(КодТовара)));
		Если ЗначениеЗаполнено(Номенклатура) Тогда
			Возврат Номенклатура;
		КонецЕсли;
	КонецЕсли;
	
	Наименование = StockAPI_Утилиты.СвойствоДанныхЗапроса(Позиция, "item,name");
	Если Наименование <> "" Тогда
		Номенклатура = Справочники.Номенклатура.НайтиПоНаименованию(Наименование, Истина);
		Если НЕ ЗначениеЗаполнено(Номенклатура) Тогда
			Номенклатура = Справочники.Номенклатура.НайтиПоНаименованию(Наименование, Ложь);
		КонецЕсли;
		Если ЗначениеЗаполнено(Номенклатура) Тогда
			Возврат Номенклатура;
		КонецЕсли;
	КонецЕсли;
	
	Возврат Справочники.Номенклатура.ПустаяСсылка();
	
КонецФункции

Функция ЧислоИзПоляПозиции(Позиция, ИменаПолей)
	
	СтрокаЗн = StockAPI_Утилиты.СвойствоДанныхЗапроса(Позиция, ИменаПолей, Неопределено);
	Если СтрокаЗн = Неопределено Или СтрокаЗн = "" Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Попытка
		Возврат Число(СтрокаЗн);
	Исключение
		Возврат Неопределено;
	КонецПопытки;
	
КонецФункции

Функция СерииИзПозиции(Позиция)
	
	Результат = Новый Массив;
	
	ЗначениеСерий = StockAPI_Утилиты.СвойствоДанныхЗапроса(Позиция, "serials", Неопределено);
	Если ТипЗнч(ЗначениеСерий) = Тип("Массив") Тогда
		Для Каждого Элемент Из ЗначениеСерий Цикл
			СерияСтрокой = НормализоватьСерию(Элемент);
			Если СерияСтрокой <> "" Тогда
				Результат.Добавить(СерияСтрокой);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	ОднаСерия = StockAPI_Утилиты.СвойствоДанныхЗапроса(Позиция, "serial,series,imei");
	Если ОднаСерия <> "" Тогда
		СерияСтрокой = НормализоватьСерию(ОднаСерия);
		Если СерияСтрокой <> "" Тогда
			Результат.Добавить(СерияСтрокой);
		КонецЕсли;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция НормализоватьСерию(ЗначениеСерии)
	
	Если ТипЗнч(ЗначениеСерии) = Тип("Число") Тогда
		Возврат Формат(ЗначениеСерии, "ЧГ=");
	КонецЕсли;
	
	Возврат СокрЛП(Строка(ЗначениеСерии));
	
КонецФункции

Функция СоздатьПартиюПрихода(СсылкаДокумента, Номенклатура, Цена, Серия, Валюта, Дата, Фирма, Контрагент)
	
	П = Справочники.Партии.СоздатьЭлемент();
	П.Владелец = Номенклатура;
	П.Док = СсылкаДокумента;
	П.Наименование = "ПН_" + Лев(гоМгновение(Дата), 8);
	П.Контрагент = Контрагент;
	П.ЦенаЗакупки = Цена;
	П.Валюта = Валюта;
	П.ДатаПартии = НачалоДня(Дата);
	П.Фирма = Фирма;
	П.Серия = Серия;
	П.ВКД_ЦенаСоСкидкой = Цена;
	П.ЦенаЗакупкиВБазВалюте = РаботаСВалютой.Пересчитать2025(
		Цена, Валюта, ПараметрыСеанса.БазоваяВалюта, Фирма, Дата);
	П.Записать();
	
	Возврат П.Ссылка;
	
КонецФункции

Процедура ЗаполнитьРезультатПоДокументу(Результат, СсылкаДокумента)
	
	Результат.number = СсылкаДокумента.Номер;
	Результат.date = StockAPI_Утилиты.ДатаВСтроку(СсылкаДокумента.Дата);
	Результат.seller = СокрЛП(Строка(СсылкаДокумента.Контрагент));
	Результат.sellerCode = StockAPI_Утилиты.КодВСтроку(СсылкаДокумента.Контрагент.Код);
	Результат.warehouse = СокрЛП(Строка(СсылкаДокумента.Склад));
	Результат.warehouseCode = StockAPI_Утилиты.КодВСтроку(СсылкаДокумента.Склад.Код);
	Результат.currency = StockAPI_Цены.ПредставлениеВалютыДляAPI(СсылкаДокумента.Валюта);
	Результат.supplierNumber = СокрЛП(СсылкаДокумента.НомерПоставщика);
	Результат.supplierDate = StockAPI_Утилиты.ДатаВСтроку(СсылкаДокумента.ДатаПоставщика);
	Результат.posted = СсылкаДокумента.Проведен;
	Результат.amount = СсылкаДокумента.Сумма;
	
	МассивСтрок = Новый Массив;
	Для Каждого Стр Из СсылкаДокумента.Товары Цикл
		Элемент = Новый Структура;
		Элемент.Вставить("item", СокрЛП(Строка(Стр.Номенклатура)));
		Элемент.Вставить("itemCode", StockAPI_Утилиты.КодВСтроку(Стр.Номенклатура.Код));
		Элемент.Вставить("qty", Стр.Количество);
		Элемент.Вставить("price", Стр.ЦенаЗакупки);
		Элемент.Вставить("amount", Стр.СуммаЗакупки);
		Элемент.Вставить("serial", СокрЛП(Стр.Серия));
		МассивСтрок.Добавить(Элемент);
	КонецЦикла;
	Результат.items = МассивСтрок;
	
КонецПроцедуры

Функция НайтиИнвойсПоНомеруПоставщика(Поставщик, НомерПоставщика)
	
	Запр = Новый Запрос;
	Запр.УстановитьПараметр("Контрагент", Поставщик);
	Запр.УстановитьПараметр("НомерПоставщика", НомерПоставщика);
	Запр.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Док.Ссылка КАК Ссылка
	|ИЗ
	|	Документ._Инвойс КАК Док
	|ГДЕ
	|	Док.Контрагент = &Контрагент
	|	И Док.ВКД_НомерИнвойсаПоставщика = &НомерПоставщика
	|	И НЕ Док.ПометкаУдаления
	|
	|УПОРЯДОЧИТЬ ПО
	|	Док.Дата УБЫВ";
	
	Выборка = Запр.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;
	
	Возврат Документы._Инвойс.ПустаяСсылка();
	
КонецФункции

// Первая приходная накладная, созданная на основании инвойса (не помеченная на удаление).
//
// Параметры:
//  Инвойс - ДокументСсылка._Инвойс
//
// Возвращаемое значение:
//  ДокументСсылка.ПриходнаяНакладная
//
Функция ПриходнаяПоИнвойсу(Инвойс)
	
	Запр = Новый Запрос;
	Запр.УстановитьПараметр("Инвойс", Инвойс);
	Запр.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Док.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.ПриходнаяНакладная КАК Док
	|ГДЕ
	|	Док.ВКД_Инвойс = &Инвойс
