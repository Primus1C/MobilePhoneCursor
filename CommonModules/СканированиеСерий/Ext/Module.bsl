// сканирование с остатками НАЧАЛО

#Область ПрограммныйИнтерфейс

// Истина, если у текущего пользователя включено сканирование без проведения (СообщатьСобытияШК = 3).
//
// Возвращаемое значение:
//  Булево - использовать буфер остатков вместо проведения после каждой серии.
//
Функция РежимАльтернативногоСканирования() Экспорт
	
	Возврат гоПользователь().СообщатьСобытияШК = 3;
	
КонецФункции

// Истина, если по документу есть записи буфера сканирования.
//
// Параметры:
//  Документ - ДокументСсылка.РасходнаяНакладная - документ сканирования.
//
// Возвращаемое значение:
//  Булево - в регистре есть хотя бы одна запись.
//
Функция ЕстьЗаписиБуфера(Документ) Экспорт
	
	Если НЕ ЗначениеЗаполнено(Документ) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Документ", Документ);
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Буфер.Серия КАК Серия
	|ИЗ
	|	РегистрСведений.БуферСканированияДляОстатков КАК Буфер
	|ГДЕ
	|	Буфер.ДокументОснование = &Документ";
	
	Возврат НЕ Запрос.Выполнить().Пустой();
	
КонецФункции

// Добавляет отсканированную серию в буфер. Серия уникальна глобально.
//
// Параметры:
//  Документ     - ДокументСсылка.РасходнаяНакладная - документ сканирования;
//  Номенклатура - СправочникСсылка.Номенклатура - номенклатура серии;
//  Серия        - Строка - отсканированная серия;
//  Склад        - СправочникСсылка.Склады - склад документа;
//  Фирма        - СправочникСсылка.Фирмы - фирма документа;
//  Партия       - СправочникСсылка.Партии - партия серии;
//  Количество   - Число - количество (для серии обычно 1);
//  ТекстОшибки  - Строка - текст ошибки при отказе;
//  Отказ        - Булево - Истина, если серия уже есть в буфере или не записана.
//
Процедура ДобавитьСериюВБуфер(Документ, Номенклатура, Серия, Склад, Фирма, Партия, Количество, ТекстОшибки, Отказ) Экспорт
	
	СерияБуфера = СокрЛП(Серия);
	Если СерияБуфера = "" Тогда
		ТекстОшибки = НСтр("ru = 'Пустая серия не записывается в буфер сканирования.'; en = 'An empty series is not written to the scan buffer.'");
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(Документ) Тогда
		ТекстОшибки = НСтр("ru = 'Документ не записан: некуда привязать серию буфера.'; en = 'The document is not saved: the series cannot be bound to the buffer.'");
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	
	КоличествоБуфера = ?(Количество = 0, 1, Количество);
	
	НачатьТранзакцию();
	Попытка
		
		Блокировка = Новый БлокировкаДанных;
		ЭлементБлокировки = Блокировка.Добавить("РегистрСведений.БуферСканированияДляОстатков");
		ЭлементБлокировки.УстановитьЗначение("Серия", СерияБуфера);
		ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
		Блокировка.Заблокировать();
		
		Если СерияЕстьВБуфере(СерияБуфера, ТекстОшибки) Тогда
			Отказ = Истина;
			ОтменитьТранзакцию();
			Возврат;
		КонецЕсли;
		
		МенеджерЗаписи = РегистрыСведений.БуферСканированияДляОстатков.СоздатьМенеджерЗаписи();
		МенеджерЗаписи.ДокументОснование = Документ;
		МенеджерЗаписи.Номенклатура = Номенклатура;
		МенеджерЗаписи.Серия = СерияБуфера;
		МенеджерЗаписи.Склад = Склад;
		МенеджерЗаписи.Фирма = Фирма;
		МенеджерЗаписи.Количество = КоличествоБуфера;
		МенеджерЗаписи.Партия = Партия;
		МенеджерЗаписи.ДатаСканирования = ТекущаяДатаСеанса();
		МенеджерЗаписи.Записать();
		
		ЗафиксироватьТранзакцию();
		
	Исключение
		ОтменитьТранзакцию();
		ТекстОшибки = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		Отказ = Истина;
		Возврат;
	КонецПопытки;
	
	гоЗаписьЖурналаРегистрации(СтрШаблон("%1|%2|%3", СерияБуфера, КоличествоБуфера, Строка(Номенклатура)),
		"СканированиеСерий", "Добавление в буфер", Документ, 2);
	
КонецПроцедуры

// Обёртка для вызова с клиента: параметры ServerCall передаются по значению.
//
// Параметры:
//  Документ     - ДокументСсылка.РасходнаяНакладная - документ сканирования;
//  Номенклатура - СправочникСсылка.Номенклатура - номенклатура серии;
//  Серия        - Строка - отсканированная серия;
//  Склад        - СправочникСсылка.Склады - склад документа;
//  Фирма        - СправочникСсылка.Фирмы - фирма документа;
//  Партия       - СправочникСсылка.Партии - партия серии;
//  Количество   - Число - количество (для серии обычно 1).
//
// Возвращаемое значение:
//  Строка - текст ошибки; пустая строка, если серия записана в буфер.
//
Функция ПопыткаДобавитьСериюВБуфер(Документ, Номенклатура, Серия, Склад, Фирма, Партия, Количество) Экспорт
	
	Отказ = Ложь;
	ТекстОшибки = "";
	ДобавитьСериюВБуфер(Документ, Номенклатура, Серия, Склад, Фирма, Партия, Количество, ТекстОшибки, Отказ);
	Если Отказ Тогда
		Возврат ТекстОшибки;
	КонецЕсли;
	Возврат "";
	
КонецФункции

// Текст ошибки, если серия уже есть в буфере любого документа. Пустая строка, если свободна.
//
// Параметры:
//  Серия - Строка - проверяемая серия.
//
// Возвращаемое значение:
//  Строка - текст ошибки занятости серии.
//
Функция ТекстОшибкиСерииВБуфере(Серия) Экспорт
	
	ТекстОшибки = "";
	Если СерияЕстьВБуфере(Серия, ТекстОшибки) Тогда
		Возврат ТекстОшибки;
	КонецЕсли;
	Возврат "";
	
КонецФункции

// Удаляет из буфера указанные серии документа.
//
// Параметры:
//  Документ    - ДокументСсылка.РасходнаяНакладная - документ сканирования;
//  МассивСерий - Массив из Строка - серии к удалению.
//
Процедура УдалитьСерииИзБуфера(Документ, МассивСерий) Экспорт
	
	Если НЕ ЗначениеЗаполнено(Документ) ИЛИ МассивСерий = Неопределено ИЛИ МассивСерий.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого СерияБуфера Из МассивСерий Цикл
		СерияСокр = СокрЛП(СерияБуфера);
		Если СерияСокр = "" Тогда
			Продолжить;
		КонецЕсли;
		Набор = РегистрыСведений.БуферСканированияДляОстатков.СоздатьНаборЗаписей();
		Набор.Отбор.ДокументОснование.Установить(Документ);
		Набор.Отбор.Серия.Установить(СерияСокр);
		Набор.Записать();
	КонецЦикла;
	
	гоЗаписьЖурналаРегистрации(СтрШаблон("Серий: %1", МассивСерий.Количество()),
		"СканированиеСерий", "Удаление из буфера", Документ, 2);
	
КонецПроцедуры

// Удаляет все записи буфера по документу.
//
// Параметры:
//  Документ - ДокументСсылка.РасходнаяНакладная - документ сканирования.
//
Процедура ОчиститьБуферДокумента(Документ) Экспорт
	
	Если НЕ ЗначениеЗаполнено(Документ) Тогда
		Возврат;
	КонецЕсли;
	Если НЕ ЕстьЗаписиБуфера(Документ) Тогда
		Возврат;
	КонецЕсли;
	
	Набор = РегистрыСведений.БуферСканированияДляОстатков.СоздатьНаборЗаписей();
	Набор.Отбор.ДокументОснование.Установить(Документ);
	Набор.Записать();
	
	гоЗаписьЖурналаРегистрации("", "СканированиеСерий", "Очистка буфера", Документ, 2);
	
КонецПроцедуры

// Заменяет записи буфера документа строками табличной части Товары (с непустой серией).
//
// Параметры:
//  Документ - ДокументСсылка.РасходнаяНакладная, ДокументОбъект.РасходнаяНакладная - документ сканирования.
//
Процедура ЗаполнитьБуферИзТабличнойЧасти(Документ) Экспорт
	
	СсылкаДокумента = СсылкаДокументаБуфера(Документ);
	Если НЕ ЗначениеЗаполнено(СсылкаДокумента) Тогда
		Возврат;
	КонецЕсли;
	
	ТаблицаТоваров = ТаблицаТоваровДокумента(Документ);
	СкладДокумента = СсылкаДокумента.Склад;
	ФирмаДокумента = СсылкаДокумента.Фирма;
	ДатаСканирования = ТекущаяДатаСеанса();
	
	Набор = РегистрыСведений.БуферСканированияДляОстатков.СоздатьНаборЗаписей();
	Набор.Отбор.ДокументОснование.Установить(СсылкаДокумента);
	
	ДобавленныеСерии = Новый Соответствие;
	Для Каждого СтрокаТовара Из ТаблицаТоваров Цикл
		СерияБуфера = СокрЛП(СтрокаТовара.Серия);
		Если СерияБуфера = "" Тогда
			Продолжить;
		КонецЕсли;
		Если ДобавленныеСерии.Получить(СерияБуфера) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		ДобавленныеСерии.Вставить(СерияБуфера, Истина);
		
		ЗаписьНабора = Набор.Добавить();
		ЗаписьНабора.ДокументОснование = СсылкаДокумента;
		ЗаписьНабора.Номенклатура = СтрокаТовара.Номенклатура;
		ЗаписьНабора.Серия = СерияБуфера;
		ЗаписьНабора.Склад = СкладДокумента;
		ЗаписьНабора.Фирма = ФирмаДокумента;
		ЗаписьНабора.Количество = ?(СтрокаТовара.Количество = 0, 1, СтрокаТовара.Количество);
		ЗаписьНабора.Партия = СтрокаТовара.Партия;
		ЗаписьНабора.ДатаСканирования = ДатаСканирования;
	КонецЦикла;
	
	Набор.Записать();
	
	гоЗаписьЖурналаРегистрации(СтрШаблон("Серий: %1", ДобавленныеСерии.Количество()),
		"СканированиеСерий", "Заполнение буфера из ТЧ", СсылкаДокумента, 2);
	
КонецПроцедуры

// Сравнивает серии буфера и табличной части документа.
//
// Параметры:
//  Документ - ДокументСсылка.РасходнаяНакладная - документ сканирования.
//
// Возвращаемое значение:
//  Структура - ТолькоВБуфере, ТолькоВДокументе (таблицы: Номенклатура, Серия, Партия, Количество, Склад, Фирма).
//
Функция РасхожденияБуфераИДокумента(Документ) Экспорт
	
	Результат = Новый Структура("ТолькоВБуфере,ТолькоВДокументе", НоваяТаблицаСерийБуфера(), НоваяТаблицаСерийБуфера());
	Если НЕ ЗначениеЗаполнено(Документ) Тогда
		Возврат Результат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Документ", Документ);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Буфер.Номенклатура КАК Номенклатура,
	|	Буфер.Серия КАК Серия,
	|	Буфер.Партия КАК Партия,
	|	Буфер.Количество КАК Количество,
	|	Буфер.Склад КАК Склад,
	|	Буфер.Фирма КАК Фирма
	|ПОМЕСТИТЬ ВТБуфер
	|ИЗ
	|	РегистрСведений.БуферСканированияДляОстатков КАК Буфер
	|ГДЕ
	|	Буфер.ДокументОснование = &Документ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Товары.Номенклатура КАК Номенклатура,
	|	Товары.Серия КАК Серия,
	|	Товары.Партия КАК Партия,
	|	Товары.Количество КАК Количество,
	|	Товары.Ссылка.Склад КАК Склад,
	|	Товары.Ссылка.Фирма КАК Фирма
	|ПОМЕСТИТЬ ВТДокумент
	|ИЗ
	|	Документ.РасходнаяНакладная.Товары КАК Товары
	|ГДЕ
	|	Товары.Ссылка = &Документ
	|	И Товары.Серия <> """"
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТБуфер.Номенклатура КАК Номенклатура,
	|	ВТБуфер.Серия КАК Серия,
	|	ВТБуфер.Партия КАК Партия,
	|	ВТБуфер.Количество КАК Количество,
	|	ВТБуфер.Склад КАК Склад,
	|	ВТБуфер.Фирма КАК Фирма
	|ИЗ
	|	ВТБуфер КАК ВТБуфер
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТДокумент КАК ВТДокумент
	|		ПО ВТБуфер.Серия = ВТДокумент.Серия
	|ГДЕ
	|	ВТДокумент.Серия ЕСТЬ NULL
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТДокумент.Номенклатура КАК Номенклатура,
	|	ВТДокумент.Серия КАК Серия,
	|	ВТДокумент.Партия КАК Партия,
	|	ВТДокумент.Количество КАК Количество,
	|	ВТДокумент.Склад КАК Склад,
	|	ВТДокумент.Фирма КАК Фирма
	|ИЗ
	|	ВТДокумент КАК ВТДокумент
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТБуфер КАК ВТБуфер
	|		ПО ВТДокумент.Серия = ВТБуфер.Серия
	|ГДЕ
	|	ВТБуфер.Серия ЕСТЬ NULL";
	
	Пакет = Запрос.ВыполнитьПакет();
	Результат.ТолькоВБуфере = Пакет[2].Выгрузить();
	Результат.ТолькоВДокументе = Пакет[3].Выгрузить();
	Возврат Результат;
	
КонецФункции

// Текст вопроса при расхождении буфера и документа. Пустая строка, если расхождений нет.
//
// Параметры:
//  Документ - ДокументСсылка.РасходнаяНакладная - документ сканирования.
//
// Возвращаемое значение:
//  Строка - перечень серий для диалога.
//
Функция ТекстРасхожденийБуфераИДокумента(Документ) Экспорт
	
	Расхождения = РасхожденияБуфераИДокумента(Документ);
	Если Расхождения.ТолькоВБуфере.Количество() = 0 И Расхождения.ТолькоВДокументе.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;
	
	Части = Новый Массив;
	Части.Добавить(НСтр("ru = 'Буфер сканирования не совпадает с табличной частью.'; en = 'The scan buffer does not match the tabular section.'"));
	
	Если Расхождения.ТолькоВБуфере.Количество() > 0 Тогда
		Части.Добавить(НСтр("ru = 'Только в буфере (будут добавлены в документ):'; en = 'Only in the buffer (will be added to the document):'"));
		Для Каждого СтрокаБуфера Из Расхождения.ТолькоВБуфере Цикл
			Части.Добавить(СтрШаблон("  %1, %2", СтрокаБуфера.Серия, СтрокаБуфера.Номенклатура));
		КонецЦикла;
	КонецЕсли;
	
	Если Расхождения.ТолькоВДокументе.Количество() > 0 Тогда
		Части.Добавить(НСтр("ru = 'Только в документе (будут добавлены в буфер):'; en = 'Only in the document (will be added to the buffer):'"));
		Для Каждого СтрокаДокумента Из Расхождения.ТолькоВДокументе Цикл
			Части.Добавить(СтрШаблон("  %1, %2", СтрокаДокумента.Серия, СтрокаДокумента.Номенклатура));
		КонецЦикла;
	КонецЕсли;
	
	Части.Добавить(НСтр("ru = 'Дополнить документ из буфера?'; en = 'Supplement the document from the buffer?'"));
	Возврат СтрСоединить(Части, Символы.ПС);
	
КонецФункции

// Истина, если серия уже есть в буфере любого документа.
//
// Параметры:
//  Серия       - Строка - проверяемая серия;
//  ТекстОшибки - Строка - заполняется при наличии серии в буфере.
//
// Возвращаемое значение:
//  Булево - серия занята буфером.
//
Функция СерияЕстьВБуфере(Серия, ТекстОшибки = "") Экспорт
	
	СерияБуфера = СокрЛП(Серия);
	Если СерияБуфера = "" Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Серия", СерияБуфера);
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Буфер.ДокументОснование КАК ДокументОснование,
	|	Буфер.Номенклатура КАК Номенклатура
	|ИЗ
	|	РегистрСведений.БуферСканированияДляОстатков КАК Буфер
	|ГДЕ
	|	Буфер.Серия = &Серия";
	Выборка = Запрос.Выполнить().Выбрать();
	Если НЕ Выборка.Следующий() Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ТекстОшибки = СтрШаблон(НСтр("ru = 'Серия %1 уже отсканирована в %2 (%3).'; en = 'Series %1 has already been scanned in %2 (%3).'"),
		СерияБуфера, Выборка.ДокументОснование, Выборка.Номенклатура);
	Возврат Истина;
	
КонецФункции

// Количество в буфере по номенклатуре (и складу, если он задан).
//
// Параметры:
//  Фирма        - СправочникСсылка.Фирмы - фирма;
//  Склад        - СправочникСсылка.Склады, Число - склад или 0, если без отбора;
//  Номенклатура - СправочникСсылка.Номенклатура - номенклатура.
//
// Возвращаемое значение:
//  Число - сумма ресурса Количество.
//
Функция КоличествоБуфераНоменклатуры(Фирма, Склад, Номенклатура) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Фирма", Фирма);
	Запрос.УстановитьПараметр("ОтборФирма", ЗначениеЗаполнено(Фирма));
	Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
	Запрос.УстановитьПараметр("ОтборСклад", ЗначениеЗаполнено(Склад) И ТипЗнч(Склад) <> Тип("Число"));
	Запрос.УстановитьПараметр("Склад", ?(ТипЗнч(Склад) = Тип("Число"), Справочники.Склады.ПустаяСсылка(), Склад));
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ЕСТЬNULL(СУММА(Буфер.Количество), 0) КАК Количество
	|ИЗ
	|	РегистрСведений.БуферСканированияДляОстатков КАК Буфер
	|ГДЕ
	|	Буфер.Номенклатура = &Номенклатура
	|	И (НЕ &ОтборФирма
	|			ИЛИ Буфер.Фирма = &Фирма)
	|	И (НЕ &ОтборСклад
	|			ИЛИ Буфер.Склад = &Склад)";
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Количество;
	КонецЕсли;
	Возврат 0;
	
КонецФункции

// Количество в буфере по партии.
//
// Параметры:
//  Фирма  - СправочникСсылка.Фирмы - фирма;
//  Склад  - СправочникСсылка.Склады, Число - склад или 0, если без отбора;
//  Партия - СправочникСсылка.Партии - партия.
//
// Возвращаемое значение:
//  Число - сумма ресурса Количество.
//
Функция КоличествоБуфераПартии(Фирма, Склад, Партия) Экспорт
	
	Если НЕ ЗначениеЗаполнено(Партия) Тогда
		Возврат 0;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Фирма", Фирма);
	Запрос.УстановитьПараметр("Партия", Партия);
	Запрос.УстановитьПараметр("Серия", СокрЛП(Строка(Партия.Серия)));
	Запрос.УстановитьПараметр("ОтборСклад", ЗначениеЗаполнено(Склад) И ТипЗнч(Склад) <> Тип("Число"));
	Запрос.УстановитьПараметр("Склад", ?(ТипЗнч(Склад) = Тип("Число"), Справочники.Склады.ПустаяСсылка(), Склад));
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ЕСТЬNULL(СУММА(Буфер.Количество), 0) КАК Количество
	|ИЗ
	|	РегистрСведений.БуферСканированияДляОстатков КАК Буфер
	|ГДЕ
	|	Буфер.Фирма = &Фирма
	|	И (НЕ &ОтборСклад
	|			ИЛИ Буфер.Склад = &Склад)
	|	И (Буфер.Партия = &Партия
	|			ИЛИ &Серия <> """"
	|				И Буфер.Серия = &Серия)";
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Количество;
	КонецЕсли;
	Возврат 0;
	
КонецФункции

// Записи буфера документа для переноса в табличную часть.
//
// Параметры:
//  Документ - ДокументСсылка.РасходнаяНакладная - документ сканирования.
//
// Возвращаемое значение:
//  ТаблицаЗначений - Номенклатура, Серия, Партия, Количество, Склад, Фирма.
//
Функция ТаблицаБуфераДокумента(Документ) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Документ", Документ);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Буфер.Номенклатура КАК Номенклатура,
	|	Буфер.Серия КАК Серия,
	|	Буфер.Партия КАК Партия,
	|	Буфер.Количество КАК Количество,
	|	Буфер.Склад КАК Склад,
	|	Буфер.Фирма КАК Фирма
	|ИЗ
	|	РегистрСведений.БуферСканированияДляОстатков КАК Буфер
	|ГДЕ
	|	Буфер.ДокументОснование = &Документ
	|
	|УПОРЯДОЧИТЬ ПО
	|	Буфер.ДатаСканирования";
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции

// Уменьшает колонку Остаток таблицы на количество буфера (по Номенклатура + Склад).
//
// Параметры:
//  ТаблицаОстатков - ТаблицаЗначений - колонки Номенклатура, Склад, Остаток.
//
Процедура УменьшитьОстатокНаБуфер(ТаблицаОстатков) Экспорт
	
	Если ТаблицаОстатков = Неопределено ИЛИ ТаблицаОстатков.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ключи", ТаблицаОстатков.Скопировать(, "Номенклатура,Склад"));
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Ключи.Номенклатура КАК Номенклатура,
	|	Ключи.Склад КАК Склад
	|ПОМЕСТИТЬ Ключи
	|ИЗ
	|	&Ключи КАК Ключи
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Буфер.Номенклатура КАК Номенклатура,
	|	Буфер.Склад КАК Склад,
	|	СУММА(Буфер.Количество) КАК Количество
	|ИЗ
	|	РегистрСведений.БуферСканированияДляОстатков КАК Буфер
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Ключи КАК Ключи
	|		ПО Буфер.Номенклатура = Ключи.Номенклатура
	|			И Буфер.Склад = Ключи.Склад
	|
	|СГРУППИРОВАТЬ ПО
	|	Буфер.Номенклатура,
	|	Буфер.Склад";
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		НайдСтроки = ТаблицаОстатков.НайтиСтроки(Новый Структура("Номенклатура,Склад", Выборка.Номенклатура, Выборка.Склад));
		Для Каждого СтрокаОстатка Из НайдСтроки Цикл
			СтрокаОстатка.Остаток = СтрокаОстатка.Остаток - Выборка.Количество;
			Если СтрокаОстатка.Остаток < 0 Тогда
				СтрокаОстатка.Остаток = 0;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
КонецПроцедуры

// Удаляет зависшие записи буфера старше 1 дня (проведённый / удалённый документ или серии нет в ТЧ).
//
Процедура ОчисткаЗависшихЗаписейБуфера() Экспорт
	
	Граница = ТекущаяДатаСеанса() - 86400;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Граница", Граница);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Буфер.ДокументОснование КАК ДокументОснование,
	|	Буфер.Номенклатура КАК Номенклатура,
	|	Буфер.Серия КАК Серия,
	|	Буфер.Склад КАК Склад,
	|	Буфер.Фирма КАК Фирма
	|ИЗ
	|	РегистрСведений.БуферСканированияДляОстатков КАК Буфер
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.РасходнаяНакладная.Товары КАК Товары
	|		ПО Буфер.ДокументОснование = Товары.Ссылка
	|			И Буфер.Серия = Товары.Серия
	|ГДЕ
	|	Буфер.ДатаСканирования <> ДАТАВРЕМЯ(1, 1, 1)
	|	И Буфер.ДатаСканирования < &Граница
	|	И (Буфер.ДокументОснование.Проведен
	|			ИЛИ Буфер.ДокументОснование.ПометкаУдаления
	|			ИЛИ Буфер.ДокументОснование = ЗНАЧЕНИЕ(Документ.РасходнаяНакладная.ПустаяСсылка)
	|			ИЛИ Товары.Серия ЕСТЬ NULL)";
	
	Выборка = Запрос.Выполнить().Выбрать();
	Удалено = 0;
	Пока Выборка.Следующий() Цикл
		МенеджерЗаписи = РегистрыСведений.БуферСканированияДляОстатков.СоздатьМенеджерЗаписи();
		МенеджерЗаписи.ДокументОснование = Выборка.ДокументОснование;
		МенеджерЗаписи.Номенклатура = Выборка.Номенклатура;
		МенеджерЗаписи.Серия = Выборка.Серия;
		МенеджерЗаписи.Склад = Выборка.Склад;
		МенеджерЗаписи.Фирма = Выборка.Фирма;
		МенеджерЗаписи.Прочитать();
		Если МенеджерЗаписи.Выбран() Тогда
			МенеджерЗаписи.Удалить();
			Удалено = Удалено + 1;
		КонецЕсли;
	КонецЦикла;
	
	Если Удалено > 0 Тогда
		гоЗаписьЖурналаРегистрации(СтрШаблон("Удалено записей: %1", Удалено),
			"СканированиеСерий", "Очистка зависших", Неопределено, 2);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныйПрограммныйИнтерфейс

// ПередЗаписью набора буфера: ставит изменения номенклатуры/склада в очередь webhook остатков.
//
// Параметры:
//  Источник  - РегистрСведенийНаборЗаписей.БуферСканированияДляОстатков - записываемый набор;
//  Отказ     - Булево - признак отказа;
//  Замещение - Булево - набор записывается с замещением.
//
Процедура БуферСканированияПередЗаписью(Источник, Отказ, Замещение) Экспорт
	
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	ИзмененияОстатков = Новый ТаблицаЗначений;
	ИзмененияОстатков.Колонки.Добавить("Номенклатура", Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	ИзмененияОстатков.Колонки.Добавить("Склад", Новый ОписаниеТипов("СправочникСсылка.Склады"));
	
	Для Каждого ЗаписьНабора Из Источник Цикл
		ДобавитьИзменениеОстатков(ИзмененияОстатков, ЗаписьНабора.Номенклатура, ЗаписьНабора.Склад);
	КонецЦикла;
	
	Инициатор = Неопределено;
	Если Замещение И Источник.Отбор.ДокументОснование.Использование Тогда
		Инициатор = Источник.Отбор.ДокументОснование.Значение;
		ДобавитьСтарыеИзмененияОстатковБуфера(ИзмененияОстатков, Инициатор);
	КонецЕсли;
	
	Если ИзмененияОстатков.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	StockAPI_Остатки.ПоставитьВОчередьИзмененияОстатков(ИзмененияОстатков, Инициатор);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция СсылкаДокументаБуфера(Документ)
	
	Если Документ = Неопределено Тогда
		Возврат Документы.РасходнаяНакладная.ПустаяСсылка();
	КонецЕсли;
	Если ТипЗнч(Документ) = Тип("ДокументСсылка.РасходнаяНакладная") Тогда
		Возврат Документ;
	КонецЕсли;
	Возврат Документ.Ссылка;
	
КонецФункции

Функция ТаблицаТоваровДокумента(Документ)
	
	Если ТипЗнч(Документ) <> Тип("ДокументСсылка.РасходнаяНакладная") Тогда
		Возврат Документ.Товары.Выгрузить(, "Номенклатура,Серия,Партия,Количество");
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Документ", Документ);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Товары.Номенклатура КАК Номенклатура,
	|	Товары.Серия КАК Серия,
	|	Товары.Партия КАК Партия,
	|	Товары.Количество КАК Количество
	|ИЗ
	|	Документ.РасходнаяНакладная.Товары КАК Товары
	|ГДЕ
	|	Товары.Ссылка = &Документ";
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции

Функция НоваяТаблицаСерийБуфера()
	
	ТаблицаСерий = Новый ТаблицаЗначений;
	ТаблицаСерий.Колонки.Добавить("Номенклатура", Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	ТаблицаСерий.Колонки.Добавить("Серия", Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(50)));
	ТаблицаСерий.Колонки.Добавить("Партия", Новый ОписаниеТипов("СправочникСсылка.Партии"));
	ТаблицаСерий.Колонки.Добавить("Количество", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(5, 0)));
	ТаблицаСерий.Колонки.Добавить("Склад", Новый ОписаниеТипов("СправочникСсылка.Склады"));
	ТаблицаСерий.Колонки.Добавить("Фирма", Новый ОписаниеТипов("СправочникСсылка.Фирмы"));
	Возврат ТаблицаСерий;
	
КонецФункции

Процедура ДобавитьИзменениеОстатков(ИзмененияОстатков, Номенклатура, Склад)
	
	Если НЕ ЗначениеЗаполнено(Номенклатура) ИЛИ НЕ ЗначениеЗаполнено(Склад) Тогда
		Возврат;
	КонецЕсли;
	Если ИзмененияОстатков.НайтиСтроки(Новый Структура("Номенклатура,Склад", Номенклатура, Склад)).Количество() > 0 Тогда
		Возврат;
	КонецЕсли;
	НоваяСтрока = ИзмененияОстатков.Добавить();
	НоваяСтрока.Номенклатура = Номенклатура;
	НоваяСтрока.Склад = Склад;
	
КонецПроцедуры

Процедура ДобавитьСтарыеИзмененияОстатковБуфера(ИзмененияОстатков, Документ)
	
	Если НЕ ЗначениеЗаполнено(Документ) Тогда
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Документ", Документ);
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Буфер.Номенклатура КАК Номенклатура,
	|	Буфер.Склад КАК Склад
	|ИЗ
	|	РегистрСведений.БуферСканированияДляОстатков КАК Буфер
	|ГДЕ
	|	Буфер.ДокументОснование = &Документ";
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ДобавитьИзменениеОстатков(ИзмененияОстатков, Выборка.Номенклатура, Выборка.Склад);
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

// сканирование с остатками ОКОНЧАНИЕ
