
#Область ПрограммныйИнтерфейс

// Настраивает получателей обмена FinCore перед записью документа.
//
// Параметры:
//  Источник         - ДокументОбъект - записываемый документ;
//  Отказ            - Булево - признак отказа от записи;
//  РежимЗаписи      - РежимЗаписиДокумента - режим записи;
//  РежимПроведения  - РежимПроведенияДокумента - режим проведения.
//
Процедура НастроитьРегистрациюFinCoreПередЗаписьюДокумент(Источник, Отказ, РежимЗаписи, РежимПроведения) Экспорт
	
	НастроитьРегистрациюFinCoreПередЗаписью(Источник);
	
КонецПроцедуры

// Настраивает получателей обмена FinCore перед записью набора записей регистра сведений.
//
// Параметры:
//  Источник   - РегистрСведенийНаборЗаписей - записываемый набор;
//  Отказ      - Булево - признак отказа от записи;
//  Замещение  - Булево - признак замещения существующих записей.
//
Процедура НастроитьРегистрациюFinCoreПередЗаписьюРегистр(Источник, Отказ, Замещение) Экспорт
	
	НастроитьРегистрациюFinCoreПередЗаписью(Источник);
	
КонецПроцедуры

// Настраивает получателей обмена FinCore перед записью объекта.
//
// Параметры:
//  Источник - ДокументОбъект, РегистрСведенийНаборЗаписей - записываемый объект.
//
Процедура НастроитьРегистрациюFinCoreПередЗаписью(Источник)
	
	Если Источник.ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	МетаданныеОбъекта = Источник.Метаданные();
	Если НЕ ОбъектСРучнойРегистрациейFinCore(МетаданныеОбъекта) Тогда
		Возврат;
	КонецЕсли;
	
	УстановитьПолучателейFinCore(Источник);
	
КонецПроцедуры

// Регистрирует или снимает регистрацию FinCore после записи объекта.
//
// Параметры:
//  Источник - ДокументОбъект, РегистрСведенийНаборЗаписей - записанный объект;
//  Отказ    - Булево - признак отказа от записи.
//
Процедура ОбновитьРегистрациюПриЗаписи(Источник, Отказ) Экспорт
	
	Если Источник.ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	МетаданныеОбъекта = Источник.Метаданные();
	Если НЕ ОбъектСРучнойРегистрациейFinCore(МетаданныеОбъекта) Тогда
		Возврат;
	КонецЕсли;
	
	Данные = ДанныеРегистрацииFinCore(Источник);
	Если ТребуетсяРегистрацияFinCore(Источник) Тогда
		ЗарегистрироватьВFinCore(Данные);
	Иначе
		УдалитьРегистрациюFinCore(Данные);
	КонецЕсли;
	
КонецПроцедуры

// Регистрирует удаление объекта в плане обмена FinCore, если он подпадает под дату учёта.
//
// Параметры:
//  Источник - ДокументОбъект, РегистрСведенийНаборЗаписей - удаляемый объект.
//  Отказ    - Булево - признак отказа от удаления.
//
Процедура ЗарегистрироватьУдалениеFinCore(Источник, Отказ) Экспорт
	
	Если Источник.ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	МетаданныеОбъекта = Источник.Метаданные();
	Если НЕ ОбъектСРучнойРегистрациейFinCore(МетаданныеОбъекта) Тогда
		Возврат;
	КонецЕсли;
	
	Если ТребуетсяРегистрацияFinCore(Источник) Тогда
		ЗарегистрироватьВFinCore(ДанныеРегистрацииFinCore(Источник));
	КонецЕсли;
	
КонецПроцедуры

// Возвращает количество узлов-получателей плана обмена FinCore.
//
// Возвращаемое значение:
//  Число - количество узлов, отличных от «Этот узел».
//
Функция КоличествоУзловПолучателейFinCore() Экспорт
	
	Возврат УзлыFinCore().Количество();
	
КонецФункции

// Возвращает таблицу зарегистрированных изменений узла плана обмена FinCore.
//
// Параметры:
//  УзелОбмена - ПланОбменаСсылка.FinCore - узел обмена.
//
// Возвращаемое значение:
//  ТаблицаЗначений - колонки: Ссылка, ТипОбъекта, Представление, ДатаОбъекта, Удаление.
//
Функция ТаблицаЗарегистрированныхИзменений(УзелОбмена) Экспорт
	
	Табл = Новый ТаблицаЗначений;
	Табл.Колонки.Добавить("Ссылка");
	Табл.Колонки.Добавить("ТипОбъекта", Новый ОписаниеТипов("Строка"));
	Табл.Колонки.Добавить("Представление", Новый ОписаниеТипов("Строка"));
	Табл.Колонки.Добавить("ДатаОбъекта", Новый ОписаниеТипов("Дата"));
	Табл.Колонки.Добавить("Удаление", Новый ОписаниеТипов("Булево"));
	
	Если НЕ ЗначениеЗаполнено(УзелОбмена) Тогда
		Возврат Табл;
	КонецЕсли;
	
	ИндексСсылок = Новый Соответствие;
	Для Каждого ЭлементСостава Из Метаданные.ПланыОбмена.ОбменFinCore.Состав Цикл
		ДобавитьИзмененияПоМетаданным(Табл, ЭлементСостава.Метаданные, УзелОбмена, ИндексСсылок);
	КонецЦикла;
	
	Возврат Табл;
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Определяет, входит ли объект в состав FinCore с запрещённой авторегистрацией.
//
// Параметры:
//  МетаданныеОбъекта - ОбъектМетаданных - метаданные проверяемого объекта.
//
// Возвращаемое значение:
//  Булево - Истина, если регистрация выполняется вручную.
//
Функция ОбъектСРучнойРегистрациейFinCore(МетаданныеОбъекта)
	
	Если НЕ ОбъектВСоставеПланаFinCore(МетаданныеОбъекта) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	// В составе FinCore авторегистрация отключена (AutoRecord = Deny) для документов и «Курсы валют».
	Если Метаданные.Документы.Содержит(МетаданныеОбъекта) Тогда
		Возврат Истина;
	КонецЕсли;
	
	Если Метаданные.РегистрыСведений.Содержит(МетаданныеОбъекта)
		И МетаданныеОбъекта.Имя = "КурсыВалют" Тогда
		Возврат Истина;
	КонецЕсли;
	
	Возврат Ложь;
	
КонецФункции

// Проверяет включение объекта метаданных в состав плана обмена FinCore.
//
// Параметры:
//  МетаданныеОбъекта - ОбъектМетаданных - проверяемый объект.
//
// Возвращаемое значение:
//  Булево - Истина, если объект входит в состав плана обмена.
//
Функция ОбъектВСоставеПланаFinCore(МетаданныеОбъекта)
	
	Для Каждого ЭлементСостава Из Метаданные.ПланыОбмена.ОбменFinCore.Состав Цикл
		Если ЭлементСостава.Метаданные = МетаданныеОбъекта Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Ложь;
	
КонецФункции

// Проверяет, подлежит ли объект регистрации в FinCore по дате.
//
// Параметры:
//  Источник - ДокументОбъект, РегистрСведенийНаборЗаписей - проверяемый объект.
//
// Возвращаемое значение:
//  Булево - Истина, если дата объекта не раньше даты учёта FinCore.
//
Функция ТребуетсяРегистрацияFinCore(Источник)
	
	ДатаОбъекта = ДатаОбъектаFinCore(Источник);
	Если ДатаОбъекта = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Возврат НачалоДня(ДатаОбъекта) >= ОбщегоНазначенияПовтИсп.ПредустановленнаяДатаУчета("НачалоОбменаFinCore");
	
КонецФункции

// Возвращает дату объекта для отбора регистрации FinCore.
//
// Параметры:
//  Источник - ДокументОбъект, РегистрСведенийНаборЗаписей - объект обмена.
//
// Возвращаемое значение:
//  Дата, Неопределено - дата документа или период набора записей регистра сведений.
//
Функция ДатаОбъектаFinCore(Источник)
	
	МетаданныеОбъекта = Источник.Метаданные();
	
	Если Метаданные.Документы.Содержит(МетаданныеОбъекта) Тогда
		Возврат Источник.Дата;
	КонецЕсли;
	
	Если Метаданные.РегистрыСведений.Содержит(МетаданныеОбъекта) Тогда
		Возврат ПериодНабораЗаписейFinCore(Источник);
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции

// Возвращает период набора записей регистра сведений FinCore.
//
// Параметры:
//  НаборЗаписей - РегистрСведенийНаборЗаписей - набор записей регистра сведений.
//
// Возвращаемое значение:
//  Дата, Неопределено - период записей набора.
//
Функция ПериодНабораЗаписейFinCore(НаборЗаписей)
	
	Если НаборЗаписей.Отбор.Период.Использование Тогда
		Возврат НаборЗаписей.Отбор.Период.Значение;
	КонецЕсли;
	
	Для Каждого Запись Из НаборЗаписей Цикл
		Возврат Запись.Период;
	КонецЦикла;
	
	Возврат Неопределено;
	
КонецФункции

// Возвращает данные для регистрации изменений FinCore.
//
// Параметры:
//  Источник - ДокументОбъект, РегистрСведенийНаборЗаписей - объект обмена.
//
// Возвращаемое значение:
//  Произвольный - ссылка или набор записей для регистрации в плане обмена.
//
Функция ДанныеРегистрацииFinCore(Источник)
	
	МетаданныеОбъекта = Источник.Метаданные();
	
	Если Метаданные.Документы.Содержит(МетаданныеОбъекта) Тогда
		Возврат Источник.Ссылка;
	КонецЕсли;
	
	Возврат Источник;
	
КонецФункции

// Устанавливает получателей обмена FinCore для записываемого объекта.
//
// Параметры:
//  Источник - ДокументОбъект, РегистрСведенийНаборЗаписей - записываемый объект.
//
Процедура УстановитьПолучателейFinCore(Источник)
	
	// Без отключения автозаполнения платформа игнорирует ручной список получателей
	// при AutoRecord = Deny и может сбросить его.
	Источник.ОбменДанными.Получатели.Автозаполнение = Ложь;
	Источник.ОбменДанными.Получатели.Очистить();
	
	Если НЕ ТребуетсяРегистрацияFinCore(Источник) Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого Узел Из УзлыFinCore() Цикл
		Источник.ОбменДанными.Получатели.Добавить(Узел);
	КонецЦикла;
	
КонецПроцедуры

// Возвращает ссылки на узлы-получатели плана обмена FinCore (без «Этот узел»).
//
// Возвращаемое значение:
//  Массив из ПланОбменаСсылка.FinCore - узлы обмена-получатели.
//
Функция УзлыFinCore()
	
	Результат = Новый Массив;
	ЭтотУзел = ПланыОбмена.ОбменFinCore.ЭтотУзел();
	
	Выборка = ПланыОбмена.ОбменFinCore.Выбрать();
	Пока Выборка.Следующий() Цикл
		Если Выборка.Ссылка <> ЭтотУзел И НЕ Выборка.ПометкаУдаления Тогда
			Результат.Добавить(Выборка.Ссылка);
		КонецЕсли;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// Регистрирует изменения объекта во всех узлах плана обмена FinCore.
//
// Параметры:
//  Данные - Произвольный - ссылка или набор записей для регистрации.
//
Процедура ЗарегистрироватьВFinCore(Данные)
	
	Если НЕ ДанныеГотовыКРегистрацииFinCore(Данные) Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого Узел Из УзлыFinCore() Цикл
		ПланыОбмена.ЗарегистрироватьИзменения(Узел, Данные);
	КонецЦикла;
	
КонецПроцедуры

// Удаляет регистрацию изменений объекта во всех узлах плана обмена FinCore.
//
// Параметры:
//  Данные - Произвольный - ссылка или набор записей для снятия регистрации.
//
Процедура УдалитьРегистрациюFinCore(Данные)
	
	Если НЕ ДанныеГотовыКРегистрацииFinCore(Данные) Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого Узел Из УзлыFinCore() Цикл
		ПланыОбмена.УдалитьРегистрациюИзменений(Узел, Данные);
	КонецЦикла;
	
КонецПроцедуры

// Проверяет, что данные можно передать в методы регистрации плана обмена.
//
// Параметры:
//  Данные - Произвольный - ссылка или набор записей.
//
// Возвращаемое значение:
//  Булево - Истина, если данные пригодны для регистрации.
//
Функция ДанныеГотовыКРегистрацииFinCore(Данные)
	
	Если Данные = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ЭтоНаборЗаписей = Ложь;
	Попытка
		ЭтоНаборЗаписей = Метаданные.РегистрыСведений.Содержит(Данные.Метаданные());
	Исключение
		ЭтоНаборЗаписей = Ложь;
	КонецПопытки;
	
	Если ЭтоНаборЗаписей Тогда
		Возврат Истина;
	КонецЕсли;
	
	Возврат ЗначениеЗаполнено(Данные);
	
КонецФункции

// Добавляет в таблицу изменения объекта метаданных из виртуальной таблицы «Изменения».
//
// Параметры:
//  Табл               - ТаблицаЗначений - таблица результата;
//  МетаданныеОбъекта  - ОбъектМетаданных - объект из состава плана обмена;
//  УзелОбмена         - ПланОбменаСсылка.FinCore - узел обмена;
//  ИндексСсылок       - Соответствие - уже добавленные ссылки для исключения дублей.
//
Процедура ДобавитьИзмененияПоМетаданным(Табл, МетаданныеОбъекта, УзелОбмена, ИндексСсылок)
	
	Если Метаданные.Справочники.Содержит(МетаданныеОбъекта)
		ИЛИ Метаданные.Документы.Содержит(МетаданныеОбъекта) Тогда
		
		Запрос = Новый Запрос;
		Запрос.Текст = ТекстЗапросаИзмененийСсылочногоОбъекта(МетаданныеОбъекта);
		Запрос.УстановитьПараметр("Узел", УзелОбмена);
		
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			
			Ключ = Строка(Выборка.Ссылка.УникальныйИдентификатор());
			Если ИндексСсылок.Получить(Ключ) <> Неопределено Тогда
				Продолжить;
			КонецЕсли;
			ИндексСсылок.Вставить(Ключ, Истина);
			
			НоваяСтрока = Табл.Добавить();
			ЗаполнитьСтрокуЗарегистрированногоИзменения(НоваяСтрока, Выборка.Ссылка);
			
		КонецЦикла;
		
	ИначеЕсли Метаданные.РегистрыСведений.Содержит(МетаданныеОбъекта) Тогда
		ДобавитьИзмененияРегистраСведений(Табл, МетаданныеОбъекта, УзелОбмена);
	КонецЕсли;
	
КонецПроцедуры

// Формирует текст запроса к виртуальной таблице «Изменения» ссылочного объекта.
//
// Параметры:
//  МетаданныеОбъекта - ОбъектМетаданных - метаданные справочника или документа.
//
// Возвращаемое значение:
//  Строка - текст запроса.
//
Функция ТекстЗапросаИзмененийСсылочногоОбъекта(МетаданныеОбъекта)
	
	ПолноеИмя = МетаданныеОбъекта.ПолноеИмя();
	
	Возврат
	"ВЫБРАТЬ
	|	Изменения.Ссылка КАК Ссылка
	|ИЗ
	|	" + ПолноеИмя + ".Изменения КАК Изменения
	|ГДЕ
	|	Изменения.Узел = &Узел";
	
КонецФункции

// Добавляет в таблицу изменения регистра сведений из виртуальной таблицы «Изменения».
//
// Параметры:
//  Табл               - ТаблицаЗначений - таблица результата;
//  МетаданныеОбъекта  - ОбъектМетаданных - метаданные регистра сведений;
//  УзелОбмена         - ПланОбменаСсылка.FinCore - узел обмена.
//
Процедура ДобавитьИзмененияРегистраСведений(Табл, МетаданныеОбъекта, УзелОбмена)
	
	Если МетаданныеОбъекта.Имя <> "КурсыВалют" Тогда
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Изменения.Период КАК Период,
	|	Изменения.Фирма КАК Фирма,
	|	Изменения.Валюта КАК Валюта
	|ИЗ
	|	РегистрСведений.КурсыВалют.Изменения КАК Изменения
	|ГДЕ
	|	Изменения.Узел = &Узел";
	Запрос.УстановитьПараметр("Узел", УзелОбмена);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		НоваяСтрока = Табл.Добавить();
		НоваяСтрока.ТипОбъекта = МетаданныеОбъекта.Синоним;
		НоваяСтрока.ДатаОбъекта = Выборка.Период;
		НоваяСтрока.Представление = СтрШаблон("%1 / %2 / %3",
			Формат(Выборка.Период, "ДЛФ=D"),
			Выборка.Фирма,
			Выборка.Валюта);
	КонецЦикла;
	
КонецПроцедуры

// Заполняет строку таблицы зарегистрированных изменений FinCore.
//
// Параметры:
//  СтрокаТаблицы - СтрокаТаблицыЗначений - заполняемая строка;
//  Ссылка        - ЛюбаяСсылка - ссылка на объект.
//
Процедура ЗаполнитьСтрокуЗарегистрированногоИзменения(СтрокаТаблицы, Ссылка)
	
	СтрокаТаблицы.Ссылка = Ссылка;
	СтрокаТаблицы.Удаление = Ложь;
	СтрокаТаблицы.Представление = Строка(Ссылка);
	
	Попытка
		МетаданныеОбъекта = Ссылка.Метаданные();
		СтрокаТаблицы.ТипОбъекта = МетаданныеОбъекта.Синоним;
		Если Метаданные.Документы.Содержит(МетаданныеОбъекта) Тогда
			СтрокаТаблицы.ДатаОбъекта = омСервер.ПолучитьРеквизит(Ссылка, "Дата");
			СтрокаТаблицы.Удаление = омСервер.ПолучитьРеквизит(Ссылка, "ПометкаУдаления");
		Иначе
			СтрокаТаблицы.ДатаОбъекта = Дата(1, 1, 1);
			СтрокаТаблицы.Удаление = омСервер.ПолучитьРеквизит(Ссылка, "ПометкаУдаления");
		КонецЕсли;
	Исключение
		СтрокаТаблицы.ТипОбъекта = "";
		СтрокаТаблицы.Удаление = Истина;
	КонецПопытки;
	
КонецПроцедуры

#КонецОбласти
