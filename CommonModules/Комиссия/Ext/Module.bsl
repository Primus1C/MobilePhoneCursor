// Возвращает ТЗ партий, имеющихся на складе комиссии
//
Функция ОстаткиПартийНаКомиссии(Серия, Дата = Неопределено, Фирма = Неопределено, Склад = Неопределено) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Дата", 	Дата);
	Запрос.УстановитьПараметр("Серия", 	Серия);
	Запрос.УстановитьПараметр("Фирма", 	?(Фирма=Неопределено, ПараметрыСеанса.Фирма, Фирма));
	Запрос.УстановитьПараметр("Склад", 	Склад);
	Запрос.Текст = "ВЫБРАТЬ
	               |	&Серия КАК Серия,
	               |	ТоварыНаКомиссии.Партия КАК Партия,
	               |	ТоварыНаКомиссии.Номенклатура КАК Номенклатура,
	               |	ТоварыНаКомиссии.Номенклатура.Наименование КАК ИмяНоменклатуры,
	               |	ТоварыНаКомиссии.КоличествоОстаток КАК Количество,
	               |	ТоварыНаКомиссии.СуммаОстаток КАК Сумма,
	               |	ВЫБОР
	               |		КОГДА ТоварыНаКомиссии.КоличествоОстаток = 0
	               |			ТОГДА 0
	               |		ИНАЧЕ ТоварыНаКомиссии.СуммаОстаток / ТоварыНаКомиссии.КоличествоОстаток
	               |	КОНЕЦ КАК Цена,
	               |	ТоварыНаКомиссии.СуммаКомиссионераОстаток КАК СуммаКомиссионера,
	               |	ВЫБОР
	               |		КОГДА ТоварыНаКомиссии.КоличествоОстаток = 0
	               |			ТОГДА 0
	               |		ИНАЧЕ ТоварыНаКомиссии.СуммаКомиссионераОстаток / ТоварыНаКомиссии.КоличествоОстаток
	               |	КОНЕЦ КАК ЦенаКомитента
	               |ИЗ
	               |	РегистрНакопления.ТоварыНаКомиссии.Остатки({(&Дата)}, Партия.Серия = &Серия {(Контрагент = &Контрагент
	               |			    И Склад = &Склад) КАК Поле2}) КАК ТоварыНаКомиссии";
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции

// Цены комитента по партиям: СуммаКомиссионера / Количество регистра ТоварыНаКомиссии.
// Для продажи — остаток на момент (без движений текущего документа).
// Для возврата — расход отчёта продажи по партии.
//
// Параметры:
//  Партии             - Массив из СправочникСсылка.Партии - партии строк;
//  Граница            - Дата, Граница - момент остатков для продажи;
//  Контрагент         - СправочникСсылка.Контрагенты - комиссионер;
//  Склад              - СправочникСсылка.Склады - склад комиссии;
//  ЭтоВозврат         - Булево - вид операции «Возврат от покупателя»;
//  ДокументыПродажи   - Массив из ДокументСсылка.ОтчетКомиссионера - отчёты продажи (для возврата).
//
// Возвращаемое значение:
//  Соответствие - ключ партия, значение цена комитента.
//
Функция ЦеныКомитентаПоПартиям(Партии, Граница, Контрагент, Склад, ЭтоВозврат, ДокументыПродажи) Экспорт
	
	Результат = Новый Соответствие;
	Если Партии.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Партии", Партии);
	
	Если ЭтоВозврат Тогда
		
		Если ДокументыПродажи.Количество() = 0 Тогда
			Возврат Результат;
		КонецЕсли;
		
		Запрос.УстановитьПараметр("ДокументыПродажи", ДокументыПродажи);
		Запрос.Текст =
		"ВЫБРАТЬ
		|	Движения.Партия КАК Партия,
		|	ВЫБОР
		|		КОГДА СУММА(Движения.Количество) = 0
		|			ТОГДА 0
		|		ИНАЧЕ СУММА(Движения.СуммаКомиссионера) / СУММА(Движения.Количество)
		|	КОНЕЦ КАК ЦенаКомитента
		|ИЗ
		|	РегистрНакопления.ТоварыНаКомиссии КАК Движения
		|ГДЕ
		|	Движения.Активность
		|	И Движения.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход)
		|	И Движения.Регистратор В (&ДокументыПродажи)
		|	И Движения.Партия В (&Партии)
		|
		|СГРУППИРОВАТЬ ПО
		|	Движения.Партия";
		
	Иначе
		
		Запрос.УстановитьПараметр("Граница", Граница);
		Запрос.УстановитьПараметр("Контрагент", Контрагент);
		Запрос.УстановитьПараметр("Склад", Склад);
		Запрос.Текст =
		"ВЫБРАТЬ
		|	Остатки.Партия КАК Партия,
		|	ВЫБОР
		|		КОГДА Остатки.КоличествоОстаток = 0
		|			ТОГДА 0
		|		ИНАЧЕ Остатки.СуммаКомиссионераОстаток / Остатки.КоличествоОстаток
		|	КОНЕЦ КАК ЦенаКомитента
		|ИЗ
		|	РегистрНакопления.ТоварыНаКомиссии.Остатки(
		|			&Граница,
		|			Контрагент = &Контрагент
		|				И Склад = &Склад
		|				И Партия В (&Партии)) КАК Остатки";
		
	КонецЕсли;
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Результат.Вставить(Выборка.Партия, Выборка.ЦенаКомитента);
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции
