//
// Возвращаемое значение:
//  Число
//
Функция МесяцевДвиженийПоУмолчанию() Экспорт
	
	Возврат 12;
	
КонецФункции

// Разбор параметра months / monthsCount запроса API.
//
// Параметры:
//  Запрос - HTTPСервисЗапрос - входящий HTTP-запрос.
//
// Возвращаемое значение:
//  Структура - поля Месяцев, Ошибка.
//
Функция ПараметрыМесяцевИзЗапроса(Запрос) Экспорт
	
	Результат = Новый Структура("Месяцев, Ошибка", МесяцевДвиженийПоУмолчанию(), "");
	СтрокаМесяцев = СтрокаПараметраЗапроса(Запрос, "months,monthsCount");
	Если СтрокаМесяцев = "" Тогда
		Возврат Результат;
	КонецЕсли;
	
	Попытка
		Результат.Месяцев = Цел(Число(СтрокаМесяцев));
	Исключение
		Результат.Ошибка = "Параметр months должен быть целым числом.";
		Возврат Результат;
	КонецПопытки;
	
	Если Результат.Месяцев < 1 ИЛИ Результат.Месяцев > 120 Тогда
		Результат.Ошибка = "Параметр months должен быть от 1 до 120.";
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Собирает все строки из СписокЗначений или Массива в одну строку с переносами.
//
Функция ТекстОшибокСписка(Ошибки) Экспорт
	
	Текст = "";
	Для Каждого Ошибка Из Ошибки Цикл
		Если ТипЗнч(Ошибка) = тип("Строка") Тогда
			Текст = Текст + Ошибка + Символы.ПС;
		Иначе
			Текст = Текст + Ошибка.Значение + Символы.ПС;
		КонецЕсли;
	КонецЦикла;
	Возврат СокрЛП(Текст);
	
КонецФункции

// Собирает тексты сообщений пользователю (отказ в проведении, СообщениеПользователю) в одну строку.
//
// Параметры:
//  УдалятьПолученные - Булево - Истина, чтобы очистить буфер сообщений сеанса после чтения.
//
// Возвращаемое значение:
//  Строка - тексты сообщений через перевод строки; пустая строка, если сообщений нет.
//
Функция ТекстСообщенийПользователю(УдалятьПолученные = Истина) Экспорт
	
	Тексты = Новый Массив;
	Для Каждого Сообщение Из ПолучитьСообщенияПользователю(УдалятьПолученные) Цикл
		Текст = СокрЛП(Сообщение.Текст);
		Если Текст <> "" Тогда
			Тексты.Добавить(Текст);
		КонецЕсли;
	КонецЦикла;
	
	Возврат СтрСоединить(Тексты, Символы.ПС);
	
КонецФункции

// Текст ошибки записи или проведения документа: префикс, исключение платформы и сообщения пользователю.
// Сообщения из процедур проверки проведения (СообщениеПользователю) иначе не попадают в ответ API.
//
// Параметры:
//  ИнформацияОбОшибкеЗаписи - ИнформацияОбОшибке, Неопределено - исключение метода Записать;
//  Префикс                  - Строка - пояснение операции без двоеточия в конце.
//
// Возвращаемое значение:
//  Строка - текст для поля error.
//
Функция ТекстОшибкиЗаписиДокумента(ИнформацияОбОшибкеЗаписи, Префикс = "") Экспорт
	
	ТекстИсключения = "";
	Если ИнформацияОбОшибкеЗаписи <> Неопределено Тогда
		ТекстИсключения = КраткоеПредставлениеОшибки(ИнформацияОбОшибкеЗаписи);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Префикс) И ЗначениеЗаполнено(ТекстИсключения) Тогда
		ТекстОшибки = СтрШаблон("%1: %2", Префикс, ТекстИсключения);
	ИначеЕсли ЗначениеЗаполнено(Префикс) Тогда
		ТекстОшибки = Префикс;
	Иначе
		ТекстОшибки = ТекстИсключения;
	КонецЕсли;
	
	ТекстСообщений = ТекстСообщенийПользователю();
	Если НЕ ЗначениеЗаполнено(ТекстСообщений) Тогда
		Возврат ТекстОшибки;
	ИначеЕсли НЕ ЗначениеЗаполнено(ТекстОшибки) Тогда
		Возврат ТекстСообщений;
	КонецЕсли;
	
	Возврат ТекстОшибки + Символы.ПС + ТекстСообщений;
	
КонецФункции

// Заполняет УчетнаяЗапись документа при первой записи через API (если ещё пуста).
//
// Параметры:
//  ДокументОбъект - ДокументОбъект - ИнвойсПродажи, _Инвойс, ПриходнаяНакладная или РасходнаяНакладная;
//  УчетнаяЗапись  - СправочникСсылка.УчетныеЗаписиИнтеграции - учётная запись ключа API.
//
Процедура УстановитьУчетнуюЗаписьПриПервойЗаписи(ДокументОбъект, УчетнаяЗапись) Экспорт
	
	Если НЕ ЗначениеЗаполнено(УчетнаяЗапись) Тогда
		Возврат;
	КонецЕсли;
	Если ЗначениеЗаполнено(ДокументОбъект.УчетнаяЗапись) Тогда
		Возврат;
	КонецЕсли;
	
	ДокументОбъект.УчетнаяЗапись = УчетнаяЗапись;
	
КонецПроцедуры

// serials=with|without. ПоУмолчаниюССериями — если параметр не передан.       
//
Функция ПараметрSerialsЗапроса(Запрос, ПоУмолчаниюССериями = Истина) Экспорт
	
	Результат = Новый Структура("ССериями, Ошибка", ПоУмолчаниюССериями, "");
	СтрокаПараметра = НРег(СтрокаПараметраЗапроса(Запрос, "serials"));
	Если СтрокаПараметра = "" Тогда
		Возврат Результат;
	КонецЕсли;
	
	Если СтрокаПараметра = "with"
		Или СтрокаПараметра = "true"
		Или СтрокаПараметра = "1"
		Или СтрокаПараметра = "yes" Тогда
		Результат.ССериями = Истина;
	ИначеЕсли СтрокаПараметра = "without"
		Или СтрокаПараметра = "false"
		Или СтрокаПараметра = "0"
		Или СтрокаПараметра = "no" Тогда
		Результат.ССериями = Ложь;
	Иначе
		Результат.Ошибка = "Неподдерживаемый serials. Допустимые значения: with, without (или true, false).";
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

