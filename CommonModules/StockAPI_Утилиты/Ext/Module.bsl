// Безопасно удаляет свойства из СтруктурыЗначений по их именам
// 
// Параметры:
//  СтруктураДанных - Структура
//  ИменаПолей - Строка - имена, разделенные запятой
//
Процедура УдалитьСвойства(СтруктураДанных, ИменаПолей) Экспорт
	
	Если ТипЗнч(СтруктураДанных) <> Тип("Структура") Тогда
		Возврат;
	КонецЕсли;  
	
	массивИмен = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(ИменаПолей, ",", Истина);	
    Для каждого Имя Из массивИмен Цикл
		Если СтруктураДанных.Свойство(Имя) Тогда
			СтруктураДанных.Удалить(Имя);
		КонецЕсли;
	КонецЦикла; 
	
КонецПроцедуры 

// Читает тело HTTP-запроса: JSON или multipart/form-data.
// Для multipart поддерживаются текстовые поля (в т.ч. fileName + fileContent base64),
// часть json/payload/data и бинарная часть file/attachment/fileContent.
//
// Параметры:
//  Запрос - HTTPСервисЗапрос - входящий запрос.
//
// Возвращаемое значение:
//  Структура - поля ДанныеЗапроса, Ошибка.
//
Функция ПрочитатьТелоЗапросаJSONИлиMultipart(Запрос) Экспорт
	
	Результат = Новый Структура("ДанныеЗапроса, Ошибка", Новый Структура, "");
	
	ТипСодержимого = "";
	Если Запрос.Заголовки.Получить("Content-Type") <> Неопределено Тогда
		ТипСодержимого = НРег(СокрЛП(Строка(Запрос.Заголовки.Получить("Content-Type"))));
	КонецЕсли;
	
	Если СтрНачинаетсяС(ТипСодержимого, "multipart/form-data") Тогда
		Разбор = РазобратьMultipartFormData(Запрос, ТипСодержимого);
		Результат.ДанныеЗапроса = Разбор.ДанныеЗапроса;
		Результат.Ошибка = Разбор.Ошибка;
		УстановитьКэшТелаЗапросаПротокола(СтруктураВJSON(Разбор.ДанныеЗапроса));
		Возврат Результат;
	КонецЕсли;
	
	Тело = Запрос.ПолучитьТелоКакСтроку();
	УстановитьКэшТелаЗапросаПротокола(Тело);
	Если СокрЛП(Тело) = "" Тогда
		Возврат Результат;
	КонецЕсли;
	
	Попытка
		ЧтениеJSON = Новый ЧтениеJSON;
		ЧтениеJSON.УстановитьСтроку(Тело);
		Прочитанное = ПрочитатьJSON(ЧтениеJSON);
		Если ТипЗнч(Прочитанное) = Тип("Структура") Тогда
			Результат.ДанныеЗапроса = Прочитанное;
		ИначеЕсли ТипЗнч(Прочитанное) = Тип("Соответствие") Тогда
			ДанныеСтруктура = Новый Структура;
			Для Каждого КлючЗначение Из Прочитанное Цикл
				ДанныеСтруктура.Вставить(Строка(КлючЗначение.Ключ), КлючЗначение.Значение);
			КонецЦикла;
			Результат.ДанныеЗапроса = ДанныеСтруктура;
		Иначе
			Результат.Ошибка = "Тело запроса должно быть JSON-объектом.";
		КонецЕсли;
	Исключение
		Результат.Ошибка = "Некорректный JSON в теле запроса.";
	КонецПопытки;
	
	Возврат Результат;
	
КонецФункции

// Извлекает необязательное вложение fileName + fileContent (base64) или fileBinary.
//
// Параметры:
//  ДанныеЗапроса - Структура - тело запроса;
//  Ошибка        - Строка - текст ошибки (выходной).
//
// Возвращаемое значение:
//  Структура, Неопределено - поля ИмяФайла, ДвоичныеДанные; Неопределено, если файла нет.
//
Функция ИзвлечьВложениеИзДанныхЗапроса(ДанныеЗапроса, Ошибка) Экспорт
	
	Ошибка = "";
	Если ДанныеЗапроса = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ДвоичныеДанные = Неопределено;
	Если ДанныеЗапроса.Свойство("fileBinary") И ТипЗнч(ДанныеЗапроса.fileBinary) = Тип("ДвоичныеДанные") Тогда
		ДвоичныеДанные = ДанныеЗапроса.fileBinary;
	КонецЕсли;
	
	ИмяФайла = СокрЛП(Строка(СвойствоДанныхЗапроса(ДанныеЗапроса, "fileName")));
	СтрокаСодержимого = СвойствоДанныхЗапроса(ДанныеЗапроса, "fileContent");
	
	ЕстьИмя = ИмяФайла <> "";
	ЕстьСодержимое = ДвоичныеДанные <> Неопределено
		Или (СтрокаСодержимого <> Неопределено И СокрЛП(Строка(СтрокаСодержимого)) <> "");
	
	Если НЕ ЕстьИмя И НЕ ЕстьСодержимое Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Если НЕ ЕстьИмя Тогда
		Ошибка = "Укажите fileName вместе с содержимым файла.";
		Возврат Неопределено;
	КонецЕсли;
	Если НЕ ЕстьСодержимое Тогда
		Ошибка = "Укажите fileContent (base64) или передайте бинарную часть файла.";
		Возврат Неопределено;
	КонецЕсли;
	
	Если ДвоичныеДанные = Неопределено Тогда
		Попытка
			ДвоичныеДанные = Base64Значение(СокрЛП(Строка(СтрокаСодержимого)));
		Исключение
			Ошибка = "Некорректный fileContent: ожидается base64.";
			Возврат Неопределено;
		КонецПопытки;
	КонецЕсли;
	
	Если ДвоичныеДанные = Неопределено Или ДвоичныеДанные.Размер() = 0 Тогда
		Ошибка = "Пустое содержимое файла.";
		Возврат Неопределено;
	КонецЕсли;
	
	Расширение = ОбщегоНазначения.ПолучитьРасширение(ИмяФайла);
	Если НЕ ЗначениеЗаполнено(Расширение) Или Расширение = "." Тогда
		Ошибка = "fileName должен содержать расширение (например invoice.pdf).";
		Возврат Неопределено;
	КонецЕсли;
	
	Возврат Новый Структура("ИмяФайла, ДвоичныеДанные", ИмяФайла, ДвоичныеДанные);
	
КонецФункции

// Прикрепляет файл к владельцу через регистр ХранилищеФайлов.
// При совпадении имени файл заменяется.
//
// Параметры:
//  ВладелецСсылка - ОпределяемыйТип.ВладелецПрисоединенныхФайлов - владелец;
//  ИмяФайла       - Строка - имя файла с расширением;
//  ДвоичныеДанные - ДвоичныеДанные - содержимое;
//  Отказ          - Булево - признак ошибки (выходной);
//  ТекстОшибки    - Строка - текст ошибки (выходной).
//
Процедура ПрикрепитьФайлКОбъекту(ВладелецСсылка, ИмяФайла, ДвоичныеДанные, Отказ, ТекстОшибки) Экспорт
	
	Отказ = Ложь;
	ТекстОшибки = "";
	
	Если НЕ ЗначениеЗаполнено(ВладелецСсылка) Тогда
		Отказ = Истина;
		ТекстОшибки = "Нельзя прикрепить файл: объект не записан.";
		Возврат;
	КонецЕсли;
	
	ИмяБезРасширения = ОбщегоНазначения.ПолучитьИмяБезРасширения(ИмяФайла);
	Расширение = ОбщегоНазначения.ПолучитьРасширение(ИмяФайла);
	Назначение = Перечисления.НазначениеФайлов.Прочее;
	
	УдалитьФайлОбъектаСТемЖеИменем(ВладелецСсылка, ИмяБезРасширения, Расширение, Назначение, Отказ, ТекстОшибки);
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	Адрес = ПоместитьВоВременноеХранилище(ДвоичныеДанные);
	ОписаниеФайла = Новый Структура;
	ОписаниеФайла.Вставить("Имя", ИмяФайла);
	ОписаниеФайла.Вставить("ИмяБезРасширения", ИмяБезРасширения);
	ОписаниеФайла.Вставить("ПолноеИмя", "");
	ОписаниеФайла.Вставить("Путь", "");
	ОписаниеФайла.Вставить("Расширение", Расширение);
	ОписаниеФайла.Вставить("Размер", ДвоичныеДанные.Размер());
	ОписаниеФайла.Вставить("Назначение", Назначение);
	ОписаниеФайла.Вставить("АдресВременногоХранилища", Адрес);
	
	КлючЗаписи = Новый Структура("ОбъектУИД,ОбъектСсылка,МестоХраненияФайлов,ИмяФайла,РасширениеИмениФайла,Автор,НазначениеФайла");
	ОбщегоНазначенияСервер.ДобавитьВложенныйФайл(Адрес, ВладелецСсылка, ОписаниеФайла, Отказ, Ложь, КлючЗаписи, ТекстОшибки);
	
КонецПроцедуры

Функция РазобратьMultipartFormData(Запрос, ТипСодержимого)
	
	Результат = Новый Структура("ДанныеЗапроса, Ошибка", Новый Структура, "");
	
	Граница = ГраницаMultipartИзContentType(ТипСодержимого);
	Если Граница = "" Тогда
		Результат.Ошибка = "В Content-Type multipart/form-data не указан boundary.";
		Возврат Результат;
	КонецЕсли;
	
	ДвоичныеДанныеТела = Запрос.ПолучитьТелоКакДвоичныеДанные();
	Если ДвоичныеДанныеТела = Неопределено Или ДвоичныеДанныеТела.Размер() = 0 Тогда
		Возврат Результат;
	КонецЕсли;
	
	ТелоКакСтрока = ПолучитьСтрокуИзДвоичныхДанных(ДвоичныеДанныеТела, "iso-8859-1");
	РазделительЧастей = "--" + Граница;
	Части = СтрРазделить(ТелоКакСтрока, РазделительЧастей, Ложь);
	
	ДанныеЗапроса = Новый Структура;
	
	Для Каждого ЧастьСырая Из Части Цикл
		
		Часть = ЧастьСырая;
		Если СтрНачинаетсяС(СокрЛ(Часть), "--") Тогда
			Продолжить;
		КонецЕсли;
		Часть = СокрЛ(Часть);
		Если СтрНачинаетсяС(Часть, Символы.ПС) Тогда
			Часть = Сред(Часть, 2);
		ИначеЕсли СтрНачинаетсяС(Часть, Символы.ВК + Символы.ПС) Тогда
			Часть = Сред(Часть, 3);
		КонецЕсли;
		Если Часть = "" Или Часть = "--" Или СтрНачинаетсяС(Часть, "--") Тогда
			Продолжить;
		КонецЕсли;
		
		ПозицияРазделителя = СтрНайти(Часть, Символы.ВК + Символы.ПС + Символы.ВК + Символы.ПС);
		РазделительЗаголовков = Символы.ВК + Символы.ПС + Символы.ВК + Символы.ПС;
		Если ПозицияРазделителя = 0 Тогда
			ПозицияРазделителя = СтрНайти(Часть, Символы.ПС + Символы.ПС);
			РазделительЗаголовков = Символы.ПС + Символы.ПС;
		КонецЕсли;
		Если ПозицияРазделителя = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		ЗаголовкиЧасти = Лев(Часть, ПозицияРазделителя - 1);
		ТелоЧасти = Сред(Часть, ПозицияРазделителя + СтрДлина(РазделительЗаголовков));
		Если СтрЗаканчиваетсяНа(ТелоЧасти, Символы.ВК + Символы.ПС) Тогда
			ТелоЧасти = Лев(ТелоЧасти, СтрДлина(ТелоЧасти) - 2);
		ИначеЕсли СтрЗаканчиваетсяНа(ТелоЧасти, Символы.ПС) Тогда
			ТелоЧасти = Лев(ТелоЧасти, СтрДлина(ТелоЧасти) - 1);
		КонецЕсли;
		
		ИмяПоля = ИмяПоляИзContentDisposition(ЗаголовкиЧасти);
		ИмяФайлаЧасти = ИмяФайлаИзContentDisposition(ЗаголовкиЧасти);
		Если ИмяПоля = "" Тогда
			Продолжить;
		КонецЕсли;
		
		ИмяПоляНрег = НРег(ИмяПоля);
		Если ИмяПоляНрег = "json" Или ИмяПоляНрег = "payload" Или ИмяПоляНрег = "data" Тогда
			Попытка
				ТекстJSON = ПолучитьСтрокуИзДвоичныхДанных(
					ПолучитьДвоичныеДанныеИзСтроки(ТелоЧасти, "iso-8859-1"),
					КодировкаТекста.UTF8);
				ЧтениеJSON = Новый ЧтениеJSON;
				ЧтениеJSON.УстановитьСтроку(ТекстJSON);
				Прочитанное = ПрочитатьJSON(ЧтениеJSON);
				Если ТипЗнч(Прочитанное) = Тип("Структура") Тогда
					Для Каждого КлючЗначение Из Прочитанное Цикл
						ДанныеЗапроса.Вставить(КлючЗначение.Ключ, КлючЗначение.Значение);
					КонецЦикла;
				ИначеЕсли ТипЗнч(Прочитанное) = Тип("Соответствие") Тогда
					Для Каждого КлючЗначение Из Прочитанное Цикл
						ДанныеЗапроса.Вставить(Строка(КлючЗначение.Ключ), КлючЗначение.Значение);
					КонецЦикла;
				КонецЕсли;
			Исключение
				Результат.Ошибка = "Некорректный JSON в части multipart '" + ИмяПоля + "'.";
				Возврат Результат;
			КонецПопытки;
			Продолжить;
		КонецЕсли;
		
		ЭтоБинарныйФайл = ЗначениеЗаполнено(ИмяФайлаЧасти)
			Или ИмяПоляНрег = "file"
			Или ИмяПоляНрег = "attachment";
		
		Если ЭтоБинарныйФайл Тогда
			ДвоичныеДанныеФайла = ПолучитьДвоичныеДанныеИзСтроки(ТелоЧасти, "iso-8859-1");
			ДанныеЗапроса.Вставить("fileBinary", ДвоичныеДанныеФайла);
			Если ЗначениеЗаполнено(ИмяФайлаЧасти) Тогда
				ДанныеЗапроса.Вставить("fileName", ИмяФайлаЧасти);
			КонецЕсли;
			Продолжить;
		КонецЕсли;
		
		ТекстПоля = ПолучитьСтрокуИзДвоичныхДанных(
			ПолучитьДвоичныеДанныеИзСтроки(ТелоЧасти, "iso-8859-1"),
			КодировкаТекста.UTF8);
		ДанныеЗапроса.Вставить(ИмяПоля, ТекстПоля);
		
	КонецЦикла;
	
	Результат.ДанныеЗапроса = ДанныеЗапроса;
	Возврат Результат;
	
КонецФункции

Функция ГраницаMultipartИзContentType(ТипСодержимого)
	
	Маркер = "boundary=";
	Позиция = СтрНайти(НРег(ТипСодержимого), Маркер);
	Если Позиция = 0 Тогда
		Возврат "";
	КонецЕсли;
	
	Граница = СокрЛП(Сред(ТипСодержимого, Позиция + СтрДлина(Маркер)));
	Если СтрНачинаетсяС(Граница, """") Тогда
		Граница = Сред(Граница, 2);
		ПозицияКонца = СтрНайти(Граница, """");
		Если ПозицияКонца > 0 Тогда
			Граница = Лев(Граница, ПозицияКонца - 1);
		КонецЕсли;
	Иначе
		ПозицияТочкиСЗапятой = СтрНайти(Граница, ";");
		Если ПозицияТочкиСЗапятой > 0 Тогда
			Граница = СокрЛП(Лев(Граница, ПозицияТочкиСЗапятой - 1));
		КонецЕсли;
	КонецЕсли;
	
	Возврат Граница;
	
КонецФункции

Функция ИмяПоляИзContentDisposition(ЗаголовкиЧасти)
	
	Для Каждого СтрокаЗаголовка Из СтрРазделить(ЗаголовкиЧасти, Символы.ПС, Ложь) Цикл
		СтрокаЗаголовка = СтрЗаменить(СокрЛП(СтрокаЗаголовка), Символы.ВК, "");
		Если НЕ СтрНачинаетсяС(НРег(СтрокаЗаголовка), "content-disposition:") Тогда
			Продолжить;
		КонецЕсли;
		ПозицияName = СтрНайти(НРег(СтрокаЗаголовка), "name=");
		Если ПозицияName = 0 Тогда
			Возврат "";
		КонецЕсли;
		Хвост = СокрЛП(Сред(СтрокаЗаголовка, ПозицияName + 5));
		Если СтрНачинаетсяС(Хвост, """") Тогда
			Хвост = Сред(Хвост, 2);
			ПозицияКонца = СтрНайти(Хвост, """");
			Если ПозицияКонца = 0 Тогда
				Возврат Хвост;
			КонецЕсли;
			Возврат Лев(Хвост, ПозицияКонца - 1);
		КонецЕсли;
		ПозицияРазделителя = СтрНайти(Хвост, ";");
		Если ПозицияРазделителя > 0 Тогда
			Возврат СокрЛП(Лев(Хвост, ПозицияРазделителя - 1));
		КонецЕсли;
		Возврат Хвост;
	КонецЦикла;
	
	Возврат "";
	
КонецФункции

Функция ИмяФайлаИзContentDisposition(ЗаголовкиЧасти)
	
	Для Каждого СтрокаЗаголовка Из СтрРазделить(ЗаголовкиЧасти, Символы.ПС, Ложь) Цикл
		СтрокаЗаголовка = СтрЗаменить(СокрЛП(СтрокаЗаголовка), Символы.ВК, "");
		Если НЕ СтрНачинаетсяС(НРег(СтрокаЗаголовка), "content-disposition:") Тогда
			Продолжить;
		КонецЕсли;
		ПозицияFileName = СтрНайти(НРег(СтрокаЗаголовка), "filename=");
		Если ПозицияFileName = 0 Тогда
			Возврат "";
		КонецЕсли;
		Хвост = СокрЛП(Сред(СтрокаЗаголовка, ПозицияFileName + 9));
		Если СтрНачинаетсяС(Хвост, """") Тогда
			Хвост = Сред(Хвост, 2);
			ПозицияКонца = СтрНайти(Хвост, """");
			Если ПозицияКонца = 0 Тогда
				Возврат Хвост;
			КонецЕсли;
			Возврат Лев(Хвост, ПозицияКонца - 1);
		КонецЕсли;
		ПозицияРазделителя = СтрНайти(Хвост, ";");
		Если ПозицияРазделителя > 0 Тогда
			Возврат СокрЛП(Лев(Хвост, ПозицияРазделителя - 1));
		КонецЕсли;
		Возврат Хвост;
	КонецЦикла;
	
	Возврат "";
	
КонецФункции

Процедура УдалитьФайлОбъектаСТемЖеИменем(ВладелецСсылка, ИмяБезРасширения, Расширение, Назначение, Отказ, ТекстОшибки)
	
	ИмяДляСравнения = НормализованноеИмяФайлаДляСравнения(ИмяБезРасширения + Расширение);
	ФайлыОбъекта = РегистрыСведений.ХранилищеФайлов.ПолучитьМассивФайловОбъекта(ВладелецСсылка, Назначение);
	
	Для Каждого ОписаниеФайла Из ФайлыОбъекта Цикл
		
		ПолноеИмяСуществующего = ОписаниеФайла.ИмяФайла + ОписаниеФайла.РасширениеИмениФайла;
		Если НормализованноеИмяФайлаДляСравнения(ПолноеИмяСуществующего) <> ИмяДляСравнения Тогда
			Продолжить;
		КонецЕсли;
		
		ПараметрыФайла = Новый Структура("ИмяБезРасширения,Расширение,Назначение",
			ОписаниеФайла.ИмяФайла, ОписаниеФайла.РасширениеИмениФайла, Назначение);
		КлючЗаписи = РегистрыСведений.ХранилищеФайлов.ПолучитьКлючЗаписи(ВладелецСсылка, ПараметрыФайла);
		
		ТекстУдаления = "";
		РегистрыСведений.ХранилищеФайлов.УдалитьФайлСДиска(КлючЗаписи, Отказ, ТекстУдаления);
		Если Отказ Тогда
			// Файл мог храниться только в ИБ — продолжаем удаление записи.
			Отказ = Ложь;
		КонецЕсли;
		
		РегистрыСведений.ХранилищеФайлов.УдалитьЗаписьИзРегистра(КлючЗаписи, Отказ, ТекстОшибки);
		Если Отказ Тогда
			Если НЕ ЗначениеЗаполнено(ТекстОшибки) Тогда
				ТекстОшибки = "Не удалось заменить существующий файл с тем же именем.";
			КонецЕсли;
			Возврат;
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Функция НормализованноеИмяФайлаДляСравнения(ИмяФайла)
	
	Результат = ВРег(СокрЛП(Строка(ИмяФайла)));
	Пока СтрНайти(Результат, "  ") > 0 Цикл
		Результат = СтрЗаменить(Результат, "  ", " ");
	КонецЦикла;
	Результат = СтрЗаменить(Результат, " ", "_");
	Возврат Результат;
	
КонецФункции

