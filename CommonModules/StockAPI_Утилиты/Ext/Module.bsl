#Область Форматирование

Функция СтрокаВЧисло(ЧислоСтрокой) Экспорт

	Если ТипЗнч(ЧислоСтрокой) = Тип("Число") Тогда
		Возврат ЧислоСтрокой;
	Иначе
	    Возврат Число(СтрЗаменить(ЧислоСтрокой, " ", ""));
	КонецЕсли;	

КонецФункции // СтрокаВЧисло()()

// Преобразует число в строку без разделителей групп
//
Функция КодВСтроку(Код) Экспорт
	
	Если ЗначениеЗаполнено(Код) Тогда 
		Возврат Формат(Код, "ЧГ=0");
	Иначе	
		Возврат "";
	КонецЕсли;
	
КонецФункции

//
//
Функция ДатаВСтроку(Дата) Экспорт

	Возврат Формат(Дата, "ДФ=yyyy-MM-ddTHH:mm:ss");	

КонецФункции // ()

// Преобразует строку формата yyyy-MM-dd в дату (время обнуляется).
// Суффикс времени в строке игнорируется; для даты и времени см. СтрокаВДатуВремя.
// Пустая или некорректная строка — Неопределено.
//
Функция СтрокаВДату(СтрокаДаты) Экспорт
	
	СтрокаДаты = СокрЛП(СтрокаДаты);
	Если СтрокаДаты = "" Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Если СтрДлина(СтрокаДаты) >= 10 Тогда
		СтрокаДаты = Лев(СтрокаДаты, 10);
	КонецЕсли;
	
	Части = СтрРазделить(СтрокаДаты, "-", Ложь);
	Если Части.Количество() <> 3 Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Попытка
		Возврат Дата(Число(Части[0]), Число(Части[1]), Число(Части[2]));
	Исключение
		Возврат Неопределено;
	КонецПопытки;
	
КонецФункции

// Преобразует строку yyyy-MM-dd или yyyy-MM-ddTHH:mm:ss (допускается пробел вместо T) в дату сеанса.
// Пустая или некорректная строка — Неопределено.
//
// Параметры:
//  СтрокаДаты - Строка - дата или дата-время в формате API.
//
// Возвращаемое значение:
//  Дата, Неопределено - значение для реквизита Дата документа.
//
Функция СтрокаВДатуВремя(СтрокаДаты) Экспорт
	
	СтрокаДаты = СокрЛП(СтрокаДаты);
	Если СтрокаДаты = "" Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	СтрокаВремени = "";
	СтрокаДатыБезВремени = СтрокаДаты;
	
	ПозицияT = СтрНайти(СтрокаДаты, "T");
	Если ПозицияT > 0 Тогда
		СтрокаДатыБезВремени = Лев(СтрокаДаты, ПозицияT - 1);
		СтрокаВремени = Сред(СтрокаДаты, ПозицияT + 1);
	Иначе
		ПозицияПробел = СтрНайти(СтрокаДаты, " ");
		Если ПозицияПробел > 0 Тогда
			СтрокаДатыБезВремени = Лев(СтрокаДаты, ПозицияПробел - 1);
			СтрокаВремени = СокрЛП(Сред(СтрокаДаты, ПозицияПробел + 1));
		КонецЕсли;
	КонецЕсли;
	
	ДатаБезВремени = СтрокаВДату(СтрокаДатыБезВремени);
	Если ДатаБезВремени = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Если СтрокаВремени = "" Тогда
		Возврат ДатаБезВремени;
	КонецЕсли;
	
	ПозицияZ = СтрНайти(СтрокаВремени, "Z");
	Если ПозицияZ > 0 Тогда
		СтрокаВремени = Лев(СтрокаВремени, ПозицияZ - 1);
	Иначе
		ПозицияСмещения = СтрНайти(СтрокаВремени, "+");
		Если ПозицияСмещения = 0 Тогда
			ПозицияСмещения = СтрНайти(СтрокаВремени, "-", НаправлениеПоиска.СКонца);
		КонецЕсли;
		Если ПозицияСмещения > 0 Тогда
			СтрокаВремени = Лев(СтрокаВремени, ПозицияСмещения - 1);
		КонецЕсли;
	КонецЕсли;
	
	ЧастиВремени = СтрРазделить(СтрокаВремени, ":", Ложь);
	Если ЧастиВремени.Количество() < 2 Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Попытка
		Час = Число(ЧастиВремени[0]);
		Минута = Число(ЧастиВремени[1]);
		Секунда = 0;
		Если ЧастиВремени.Количество() >= 3 Тогда
			СтрокаСекунд = ЧастиВремени[2];
			ПозицияТочки = СтрНайти(СтрокаСекунд, ".");
			Если ПозицияТочки > 0 Тогда
				СтрокаСекунд = Лев(СтрокаСекунд, ПозицияТочки - 1);
			КонецЕсли;
			Секунда = Число(СтрокаСекунд);
		КонецЕсли;
		Возврат Дата(Год(ДатаБезВремени), Месяц(ДатаБезВремени), День(ДатаБезВремени), Час, Минута, Секунда);
	Исключение
		Возврат Неопределено;
	КонецПопытки;
	
КонецФункции

#КонецОбласти


#Область Протокол

// Сохраняет текст тела HTTP-запроса для протоколирования (после первого чтения тела).
