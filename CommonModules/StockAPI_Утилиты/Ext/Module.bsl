	Кэш = StockAPI_ПротоколПовтИсп.ДанныеКэшаТелаЗапроса();
	Кэш.Тело = Тело;
	
КонецПроцедуры

// Строка параметров URL HTTP-запроса (key=value&...).
//
// Параметры:
//  Запрос - HTTPСервисЗапрос - входящий запрос StockAPI.
//
// Возвращаемое значение:
//  Строка - параметры запроса без ведущего «?».
//
Функция СтрокаПараметровHTTPЗапроса(Запрос) Экспорт
	
	Части = Новый Массив;
	
	Попытка
		Для Каждого КлючИЗначение Из Запрос.ПараметрыЗапроса Цикл
			Части.Добавить(СтрШаблон("%1=%2", КлючИЗначение.Ключ, КлючИЗначение.Значение));
		КонецЦикла;
	Исключение
	КонецПопытки;
	
	Возврат СтрСоединить(Части, "&");
	
КонецФункции

// Краткий текст запроса для реквизита ПротоколОбменов.ТекстЗапроса:
// параметры URL, а при их отсутствии — тело запроса.
//
// Параметры:
//  Запрос       - HTTPСервисЗапрос - входящий запрос;
//  ТелоЗапроса  - Строка, Неопределено - уже прочитанное тело (если передано явно).
//
// Возвращаемое значение:
//  Строка - параметры URL или тело запроса.
//
Функция ТекстЗапросаДляПротокола(Запрос, ТелоЗапроса = Неопределено) Экспорт
	
	ТекстПараметров = СтрокаПараметровHTTPЗапроса(Запрос);
	Если ТекстПараметров <> "" Тогда
		Возврат ТекстПараметров;
	КонецЕсли;
	
	Возврат ТелоHTTPЗапросаДляПротокола(Запрос, ТелоЗапроса);
	
КонецФункции

// Возвращает значение перечисления HTTPМетод по строке метода HTTP-запроса.
//
// Параметры:
//  ИмяМетода - Строка - HTTP-метод платформы (GET, POST, PUT, PATCH, DELETE).
//
// Возвращаемое значение:
//  ПеречислениеСсылка.HTTPМетод - найденное значение или пустая ссылка.
//
Функция HTTPМетодПоСтроке(ИмяМетода)
	
	Имя = ВРег(СокрЛП(Строка(ИмяМетода)));
	Если Имя = "DEL" Тогда
		Имя = "DELETE";
	КонецЕсли;
	
	Попытка
		Возврат Перечисления.HTTPМетод[Имя];
	Исключение
		Возврат Перечисления.HTTPМетод.ПустаяСсылка();
	КонецПопытки;
	
КонецФункции

//
//
Процедура ЗаписатьВПротокол(Запрос, Ответ, ПользовательИнтеграции, ДлительностьМс, ТекстОшибкиВнутр = "", ТелоЗапроса = Неопределено, ТелоОтвета = Неопределено) Экспорт
	
	Попытка
		МЗ = РегистрыСведений.ПротоколОбменов.СоздатьМенеджерЗаписи();
		
		// Измерения и базовые реквизиты
		МЗ.ИдентификаторЗапроса = Новый УникальныйИдентификатор;
		МЗ.Дата 			= ТекущаяДатаСеанса();
		МЗ.ИмяСервиса 		= "StockAPI";
		
		//МЗ.ШаблонURL = Запрос.ШаблонURL;  
		Попытка
			МЗ.ШаблонURL 	= Лев(Запрос.ОтносительныйURL, 50);
		Исключение
			МЗ.ШаблонURL 	= "";
		КонецПопытки;

		МЗ.HTTPМетод = HTTPМетодПоСтроке(Запрос.HTTPМетод);
		
		МЗ.КодСостояния 	= Ответ.КодСостояния;
		МЗ.Длительность 	= ДлительностьМс;
		МЗ.Пользователь 	= ПользовательИнтеграции;
		МЗ.ТекстОшибки 		= Лев(ТекстОшибкиВнутр, 200);
		
		// Определение IP адреса
		IP = Запрос.Заголовки.Получить("X-Forwarded-For");
		Если IP = Неопределено Тогда
			IP = Запрос.Заголовки.Получить("Remote-Addr");
		КонецЕсли;
		МЗ.IPАдрес 			= ?(IP = Неопределено, "", Лев(IP, 50));
		
		ТекстЗапроса = ТекстЗапросаДляПротокола(Запрос, ТелоЗапроса);
		ТекстТелаЗапроса = ТелоHTTPЗапросаДляПротокола(Запрос, ТелоЗапроса);
		Если ТекстТелаЗапроса = "" И ТекстЗапроса <> "" Тогда
			ТекстТелаЗапроса = ТекстЗапроса;
		КонецЕсли;
		
		Попытка
			МЗ.ТекстЗапроса = ТекстЗапроса;
		Исключение
		КонецПопытки;
		
		// Запись ресурсов (ХранилищеЗначения)
		МЗ.ЗаголовкиЗапроса = Новый ХранилищеЗначения(СтруктураВJSON(Запрос.Заголовки), Новый СжатиеДанных(9));
		МЗ.ТелоЗапроса 		= Новый ХранилищеЗначения(ТекстТелаЗапроса, Новый СжатиеДанных(9));
		МЗ.ТелоОтвета 		= Новый ХранилищеЗначения(ТелоHTTPОтветаДляПротокола(Ответ, ТелоОтвета), Новый СжатиеДанных(9));
		
		МЗ.Записать();
	Исключение
		// Ошибка записи лога не должна ронять сам API
		ЗаписьЖурналаРегистрации("StockAPI.Протоколирование", УровеньЖурналаРегистрации.Ошибка,,, ОписаниеОшибки());
	КонецПопытки;
	
	ОчиститьКэшТелаЗапросаПротокола();
	
КонецПроцедуры

// Сбрасывает кэш тела HTTP-запроса после записи протокола.
//
Процедура ОчиститьКэшТелаЗапросаПротокола()
	
	Кэш = StockAPI_ПротоколПовтИсп.ДанныеКэшаТелаЗапроса();
	Кэш.Тело = "";
	
КонецПроцедуры

// Возвращает закэшированное тело HTTP-запроса, если оно уже было прочитано.
//
// Возвращаемое значение:
//  Строка - тело запроса или пустая строка.
//
Функция КэшТелаЗапросаПротокола()
	
	Кэш = StockAPI_ПротоколПовтИсп.ДанныеКэшаТелаЗапроса();
	Возврат Кэш.Тело;
	
КонецФункции

//
//
Функция ТелоHTTPЗапросаДляПротокола(Запрос, ТелоЗапроса = Неопределено)
	
	Если ТипЗнч(ТелоЗапроса) = Тип("Строка") Тогда
		Возврат ТелоЗапроса;
	КонецЕсли;
	
	ТелоКэша = КэшТелаЗапросаПротокола();
	Если ТелоКэша <> "" Тогда
		Возврат ТелоКэша;
	КонецЕсли;
	
	Попытка
		Возврат Запрос.ПолучитьТелоКакСтроку(КодировкаТекста.UTF8);
	Исключение
		Попытка
			Возврат Запрос.ПолучитьТелоКакСтроку();
		Исключение
			Возврат "";
		КонецПопытки;
	КонецПопытки;
	
КонецФункции

//
//
Функция ТелоHTTPОтветаДляПротокола(Ответ, ТелоОтвета = Неопределено)
	
	Если ТипЗнч(ТелоОтвета) = Тип("Строка") Тогда
		Возврат ТелоОтвета;
	КонецЕсли;
	
	Попытка
		Возврат Ответ.ПолучитьТелоКакСтроку(КодировкаТекста.UTF8);
	Исключение
		Попытка
			Возврат Ответ.ПолучитьТелоКакСтроку();
		Исключение
		КонецПопытки;
	КонецПопытки;
	
	Попытка
		ДвоичныеДанные = Ответ.ПолучитьТелоКакДвоичныеДанные();
		Если ДвоичныеДанные = Неопределено Тогда
			Возврат "";
		КонецЕсли;
		
		Размер = ДвоичныеДанные.Размер();
		Если Размер = 0 Тогда
			Возврат "";
		КонецЕсли;
		
		ContentType = Ответ.Заголовки.Получить("Content-Type");
		Если ContentType = Неопределено Тогда
			ContentType = "";
		КонецЕсли;
		
		Возврат СтрШаблон("<binary body, %1 bytes, Content-Type: %2>", Размер, ContentType);
	Исключение
		Возврат "";
	КонецПопытки;
	
КонецФункции

#КонецОбласти


// ─── Настройки обязательности сотрудника по методам API ───────────────────────

// Возвращает имена не-GET обработчиков HTTP-сервиса StockAPI.
//
// Возвращаемое значение:
//  Массив из Строка - имена обработчиков (Handler).
//
Функция ИменаMutatingОбработчиковStockAPI() Экспорт

	Результат = Новый Массив;
	ДобавленныеИмена = Новый Соответствие;
	HTTPСервис = Метаданные.HTTPСервисы.StockAPI;
	Если HTTPСервис = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;

	Для Каждого ШаблонURL Из HTTPСервис.ШаблоныURL Цикл
		Для Каждого МетодHTTP Из ШаблонURL.Методы Цикл
			КлючМетода = ВРег(МетодHTTP.Имя);
			Если ВРег(МетодHTTP.HTTPМетод) <> "GET"
				И ДобавленныеИмена.Получить(КлючМетода) = Неопределено Тогда
				Результат.Добавить(МетодHTTP.Имя);
				ДобавленныеИмена.Вставить(КлючМетода, Истина);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Возвращает настройки обязательности сотрудника по методам учётной записи.
//
// Параметры:
//  УчетнаяЗапись - СправочникСсылка.УчетныеЗаписиИнтеграции - учётная запись API.
//
// Возвращаемое значение:
//  Соответствие - ключ: имя метода в верхнем регистре; значение: Булево.
//
Функция НастройкиИдентификацииСотрудниковУчетнойЗаписи(УчетнаяЗапись) Экспорт

	Настройки = Новый Соответствие;
	Если ЗначениеЗаполнено(УчетнаяЗапись) Тогда
		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ
		|	Идентификация.ИмяМетода КАК ИмяМетода,
		|	Идентификация.ОбязательныйСотрудник КАК ОбязательныйСотрудник
		|ИЗ
		|	Справочник.УчетныеЗаписиИнтеграции.ИдентификацияСотрудников КАК Идентификация
		|ГДЕ
		|	Идентификация.Ссылка = &УчетнаяЗапись";
		Запрос.УстановитьПараметр("УчетнаяЗапись", УчетнаяЗапись);
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			ИмяМетода = СокрЛП(Выборка.ИмяМетода);
			Если ИмяМетода <> "" Тогда
				Настройки.Вставить(ВРег(ИмяМетода), Выборка.ОбязательныйСотрудник);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

	Возврат Настройки;

КонецФункции

// Определяет, обязателен ли сотрудник для метода учётной записи.
//
// Параметры:
//  УчетнаяЗапись - СправочникСсылка.УчетныеЗаписиИнтеграции - учётная запись API;
//  ИмяМетода      - Строка - имя обработчика HTTP-сервиса.
//
// Возвращаемое значение:
//  Булево - Истина, если для метода требуется employeeCode или employeePin.
//
Функция ОбязателенСотрудникДляМетода(УчетнаяЗапись, ИмяМетода) Экспорт

	ИмяВРег = ВРег(СокрЛП(ИмяМетода));
	Если ИмяВРег = "" Тогда
		Возврат Ложь;
	КонецЕсли;

	Настройки = НастройкиИдентификацииСотрудниковУчетнойЗаписи(УчетнаяЗапись);
	ЗначениеФлага = Настройки.Получить(ИмяВРег);
	Если ЗначениеФлага = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;

	Возврат ЗначениеФлага = Истина;

КонецФункции

// Проверяет наличие и корректность сотрудника в данных запроса согласно настройкам метода.
//
// Параметры:
//  УчетнаяЗапись - СправочникСсылка.УчетныеЗаписиИнтеграции - учётная запись API;
//  ИмяМетода      - Строка - имя обработчика HTTP-сервиса;
//  ДанныеЗапроса  - Структура, Соответствие - данные HTTP-запроса.
//
// Возвращаемое значение:
//  Структура - поля Ошибка, Сотрудник.
//
Функция ПроверитьСотрудникаЗапроса(УчетнаяЗапись, ИмяМетода, ДанныеЗапроса) Экспорт

	Результат = Новый Структура("Ошибка, Сотрудник", "", Справочники.Сотрудники.ПустаяСсылка());
	Обязательно = ОбязателенСотрудникДляМетода(УчетнаяЗапись, ИмяМетода);

	КодСотрудника = СокрЛП(Строка(СвойствоДанныхЗапроса(ДанныеЗапроса, "employeeCode", "")));
	ПинСотрудника = СокрЛП(Строка(СвойствоДанныхЗапроса(ДанныеЗапроса, "employeePin", "")));
	ПараметрыЗаданы = (КодСотрудника <> "" Или ПинСотрудника <> "");

	Если НЕ Обязательно И НЕ ПараметрыЗаданы Тогда
		Возврат Результат;
	КонецЕсли;

	Если Обязательно И НЕ ПараметрыЗаданы Тогда
		Результат.Ошибка = СтрШаблон("Для метода %1 требуется employeeCode или employeePin.", ИмяМетода);
		Возврат Результат;
	КонецЕсли;

	ДанныеСотрудника = StockAPI_Справочники.СотрудникИзДанныхЗапроса(ДанныеЗапроса, УчетнаяЗапись);
	Если ДанныеСотрудника.Ошибка <> "" Тогда
		Результат.Ошибка = ДанныеСотрудника.Ошибка;
		Возврат Результат;
	КонецЕсли;

	Если НЕ ЗначениеЗаполнено(ДанныеСотрудника.Сотрудник) Тогда
		Результат.Ошибка = "Сотрудник не найден.";
		Возврат Результат;
	КонецЕсли;

	Результат.Сотрудник = ДанныеСотрудника.Сотрудник;
	Возврат Результат;

КонецФункции


#Область ВебХуки  

Процедура ОтправкаWebHook() Экспорт
	
	Попытка
		ОтправитьОчередьWebHook();
	Исключение
		ЗаписьЖурналаРегистрации("StockAPI.WebHook", УровеньЖурналаРегистрации.Ошибка,,,
			"Ошибка регламентной отправки web hook: " + ОписаниеОшибки());
	КонецПопытки;
	
КонецПроцедуры

// Регламентная очистка очереди webhook: удаляет доставленные записи старше срока хранения.
// Недоставленные записи (пустая дата отправки) не удаляются.
//
Процедура ОчисткаОтправленныхWebHook() Экспорт
	
	Попытка
		УдалитьОтправленныеЗаписиОчередиWebHook(СрокХраненияОтправленныхWebHookДней());
	Исключение
		ЗаписьЖурналаРегистрации("StockAPI.WebHook", УровеньЖурналаРегистрации.Ошибка,,,
			"Ошибка очистки отправленных web hook: " + ОписаниеОшибки());
	КонецПопытки;
	
КонецПроцедуры

// Срок хранения доставленных записей очереди webhook.
//
// Возвращаемое значение:
//  Число - количество дней.
//
Функция СрокХраненияОтправленныхWebHookДней()
	
	Возврат 7;
	
КонецФункции

// Удаляет из регистра ОчередьWebHook доставленные записи, отправленные раньше границы хранения.
// Записи удаляются порциями, каждая порция - в отдельной транзакции.
//
// Параметры:
//  СрокХраненияДней - Число - сколько дней хранить доставленные записи.
//
Процедура УдалитьОтправленныеЗаписиОчередиWebHook(СрокХраненияДней)
	
	РазмерПорции = 1000;
	МаксимумПорций = 100;
	ПустаяДата = Дата(1, 1, 1);
	ГраницаУдаления = ТекущаяДатаСеанса() - СрокХраненияДней * 86400;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ПустаяДата", ПустаяДата);
	Запрос.УстановитьПараметр("ГраницаУдаления", ГраницаУдаления);
	Запрос.Текст = СтрШаблон(
		"ВЫБРАТЬ ПЕРВЫЕ %1
		|	ОчередьWebHook.ИД КАК ИД
		|ИЗ
		|	РегистрСведений.ОчередьWebHook КАК ОчередьWebHook
		|ГДЕ
		|	ОчередьWebHook.Отправлен <> &ПустаяДата
		|	И ОчередьWebHook.Отправлен < &ГраницаУдаления",
		Формат(РазмерПорции, "ЧГ=0"));
	
	Для НомерПорции = 1 По МаксимумПорций Цикл
		
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Количество() = 0 Тогда
			Прервать;
		КонецЕсли;
		
		НачатьТранзакцию();
		Попытка
			Пока Выборка.Следующий() Цикл
				НаборЗаписей = РегистрыСведений.ОчередьWebHook.СоздатьНаборЗаписей();
				НаборЗаписей.Отбор.ИД.Установить(Выборка.ИД);
				НаборЗаписей.Записать();
			КонецЦикла;
			ЗафиксироватьТранзакцию();
		Исключение
			ОтменитьТранзакцию();
			ВызватьИсключение;
		КонецПопытки;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ОтправитьОчередьWebHook(МаксимумЗаписей = 500) Экспорт
	
	Если МаксимумЗаписей <= 0 Тогда
		МаксимумЗаписей = 100;
	КонецЕсли;
	
	Расписание = РасписаниеПовторовWebHook();
	ТекущаяДата = ТекущаяДатаСеанса();
	ПустаяДата = Дата(1, 1, 1);
	ЛимитВыборки = МаксимумЗаписей * 500;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ПустаяДата", ПустаяДата);
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ " + Формат(ЛимитВыборки, "ЧГ=0") + "
	               |	ОчередьWebHook.ИД КАК ИД,
	               |	ОчередьWebHook.УчетнаяЗапись КАК УчетнаяЗапись,
	               |	ОчередьWebHook.ТипСобытия КАК ТипСобытия,
	               |	ОчередьWebHook.Номенклатура КАК Номенклатура,
	               |	ОчередьWebHook.Склад КАК Склад,
	               |	ОчередьWebHook.ВидЦены КАК ВидЦены,
	               |	ОчередьWebHook.Валюта КАК Валюта,
	               |	ОчередьWebHook.Заказ КАК Заказ,
	               |	ОчередьWebHook.Отправлен КАК Отправлен,
	               |	ОчередьWebHook.Создан КАК Создан,
	               |	ОчередьWebHook.Ошибка КАК Ошибка,
	               |	ОчередьWebHook.Инициатор КАК Инициатор,
	               |	ОчередьWebHook.КоличествоПопыток КАК КоличествоПопыток,
	               |	ОчередьWebHook.ПоследняяПопытка КАК ПоследняяПопытка,
	               |	ОчередьWebHook.УчетнаяЗапись.WebhookURL КАК WebhookURL,
	               |	ОчередьWebHook.УчетнаяЗапись.WebhookToken КАК WebhookToken
	               |ИЗ
	               |	РегистрСведений.ОчередьWebHook КАК ОчередьWebHook
	               |ГДЕ
	               |	ОчередьWebHook.Отправлен = &ПустаяДата
				   |	И ОчередьWebHook.УчетнаяЗапись.Активен
				   |	И ОчередьWebHook.УчетнаяЗапись.WebhookАктивен
				   |	И ОчередьWebHook.УчетнаяЗапись.WebhookURL <> """"
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	ОчередьWebHook.Создан,
	               |	ОчередьWebHook.ИД";
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пакеты = СформироватьПакетыWebHook(Выборка, Расписание, ТекущаяДата, ПустаяДата);
	ОтправленоПакетов = 0;
	
	Для Каждого Пакет Из Пакеты Цикл
		
		Если ОтправленоПакетов >= МаксимумЗаписей Тогда
			Прервать;
		КонецЕсли;
		
		ПодготовленныйПакет = ПодготовитьПакетWebHook(Пакет);
		
		Для Каждого СтрокаБезЦен Из ПодготовленныйПакет.СтрокиБезЦен Цикл
			УдалитьЗаписьОчередиWebHook(СтрокаБезЦен);
		КонецЦикла;
		
		Если ПодготовленныйПакет.СтрокиОтправки.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		ДатаПопытки = ТекущаяДатаСеанса();
		ТекстОшибки = "";
		Отправлено = Ложь;
		
		Попытка
			ТелоJSON = СтруктураВJSON(ПодготовленныйПакет.Тело);
			ОтветHTTP = ОтправитьPOSTWebHook(Пакет.WebhookURL, ТелоJSON, Пакет.WebhookToken);
			Отправлено = ОтветHTTP.КодСостояния >= 200 И ОтветHTTP.КодСостояния < 300;
			Если НЕ Отправлено Тогда
				ТекстОшибки = СтрШаблон("HTTP %1: %2", ОтветHTTP.КодСостояния, ОтветHTTP.ТелоОтвета);
			КонецЕсли;
		Исключение
			ТекстОшибки = ОписаниеОшибки();
		КонецПопытки;
		
		ЗаписатьРезультатОтправкиПакетаWebHook(ПодготовленныйПакет.СтрокиОтправки, ДатаПопытки, Отправлено, ТекстОшибки);
		ОтправленоПакетов = ОтправленоПакетов + 1;
		
	КонецЦикла;
	
КонецПроцедуры

Функция РасписаниеПовторовWebHook()
	
	СтрокаРасписания = Константы.ПериодичностьОповещенийИнтеграции.Получить();
	Результат = Новый Массив;
	
	Если Не ЗначениеЗаполнено(СтрокаРасписания) Тогда
		СтрокаРасписания = "30, 30, 30, 60, 60, 300, 600, 3600";
	КонецЕсли;
	
	Части = СтрРазделить(СтрокаРасписания, ",", Ложь);
	Для Каждого Часть Из Части Цикл
		
		Попытка
			Интервал = Цел(Число(СокрЛП(Часть)));
		Исключение
			Интервал = 0;
		КонецПопытки;
		
		Если Интервал > 0 Тогда
			Результат.Добавить(Интервал);
		КонецЕсли;
		
	КонецЦикла;
	
	Если Результат.Количество() = 0 Тогда
		Результат.Добавить(30);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ИнтервалПовтораWebHook(КоличествоПопыток, Расписание)
	
	Если КоличествоПопыток <= 0 Тогда
		Возврат 0;
	КонецЕсли;
	
	Индекс = КоличествоПопыток;
	Если Индекс > Расписание.Количество() Тогда
		Индекс = Расписание.Количество();
	КонецЕсли;
	
	Возврат Расписание[Индекс - 1];
	
КонецФункции

Функция ЗаписьWebHookГотоваКОтправке(СтрокаОчереди, Расписание, ТекущаяДата, ПустаяДата)
	
	Если СтрокаОчереди.КоличествоПопыток = 0 Тогда
		Возврат Истина;
	КонецЕсли;
	
	Если СтрокаОчереди.ПоследняяПопытка = ПустаяДата Тогда
		Возврат Истина;
	КонецЕсли;
	
	ИнтервалСекунд = ИнтервалПовтораWebHook(СтрокаОчереди.КоличествоПопыток, Расписание);
	СледующаяПопытка = СтрокаОчереди.ПоследняяПопытка + ИнтервалСекунд;
	
	Возврат СледующаяПопытка <= ТекущаяДата;
	
КонецФункции

Функция МаксимумЭлементовВПакетеWebHook()
	
	Возврат 400;
	
КонецФункции

Функция КлючПакетаWebHook(СтрокаОчереди)
	
	Возврат Строка(СтрокаОчереди.УчетнаяЗапись) + "|" + Строка(СтрокаОчереди.ТипСобытия);
	
КонецФункции

Функция СформироватьПакетыWebHook(Выборка, Расписание, ТекущаяДата, ПустаяДата)
	
	ПакетыПоКлючу = Новый Соответствие;
	Пакеты = Новый Массив;
	МаксимумЭлементов = МаксимумЭлементовВПакетеWebHook();
	
	Пока Выборка.Следующий() Цикл
		
		Если НЕ ЗаписьWebHookГотоваКОтправке(Выборка, Расписание, ТекущаяДата, ПустаяДата) Тогда
			Продолжить;
		КонецЕсли;
		
		Ключ = КлючПакетаWebHook(Выборка);
		Пакет = ПакетыПоКлючу.Получить(Ключ);
		
		Если Пакет = Неопределено Или Пакет.Строки.Количество() >= МаксимумЭлементов Тогда
			Пакет = Новый Структура("УчетнаяЗапись,ТипСобытия,WebhookURL,WebhookToken,Строки,МинСоздан",
				Выборка.УчетнаяЗапись, Выборка.ТипСобытия, Выборка.WebhookURL, Выборка.WebhookToken, Новый Массив, Выборка.Создан);
			Пакеты.Добавить(Пакет);
			ПакетыПоКлючу.Вставить(Ключ, Пакет);
		КонецЕсли;
		
		Пакет.Строки.Добавить(СтрокаОчередиWebHookИзВыборки(Выборка));
		
		Если Выборка.Создан < Пакет.МинСоздан Тогда
			Пакет.МинСоздан = Выборка.Создан;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Пакеты;
	
КонецФункции

Функция СтрокаОчередиWebHookИзВыборки(Выборка)
	
	Возврат Новый Структура(
		"ИД,УчетнаяЗапись,ТипСобытия,Номенклатура,Склад,ВидЦены,Валюта,Заказ,Отправлен,Создан,Ошибка,Инициатор,КоличествоПопыток,ПоследняяПопытка",
		Выборка.ИД, Выборка.УчетнаяЗапись, Выборка.ТипСобытия, Выборка.Номенклатура, Выборка.Склад, Выборка.ВидЦены, Выборка.Валюта, Выборка.Заказ,
		Выборка.Отправлен, Выборка.Создан, Выборка.Ошибка, Выборка.Инициатор, Выборка.КоличествоПопыток, Выборка.ПоследняяПопытка);
	
КонецФункции

// Формирует тело пакета webhook и отделяет строки цены без непустого массива price.
//
// Параметры:
//  Пакет - Структура - сформированный пакет очереди.
//
// Возвращаемое значение:
//  Структура - поля Тело, СтрокиОтправки, СтрокиБезЦен.
//
Функция ПодготовитьПакетWebHook(Пакет)
	
	Тело = Новый Структура;
	Тело.Вставить("batchId", Строка(Новый УникальныйИдентификатор));
	Тело.Вставить("eventType", Строка(Пакет.ТипСобытия));
	Тело.Вставить("createdAt", ДатаВСтроку(Пакет.МинСоздан));
	
	ДанныеОбогащения = ДанныеОбогащенияWebHook(Пакет.ТипСобытия, Пакет.Строки);
	МассивЭлементов = Новый Массив;
	СтрокиОтправки = Новый Массив;
	СтрокиБезЦен = Новый Массив;
	ТипСобытияЦена = Перечисления.ТипыСобытийWebHooks.Цена;
	
	Для Каждого СтрокаОчереди Из Пакет.Строки Цикл
		
		Если Пакет.ТипСобытия = ТипСобытияЦена Тогда
			ДанныеЦены = Неопределено;
			Если ДанныеОбогащения <> Неопределено Тогда
				ДанныеЦены = ДанныеОбогащения.Получить(КлючТовараWebHook(СтрокаОчереди.Номенклатура, СтрокаОчереди.Склад,
					СтрокаОчереди.ВидЦены, СтрокаОчереди.Валюта));
			КонецЕсли;
			Если НЕ ЕстьЦеныДляWebHook(ДанныеЦены) Тогда
				СтрокиБезЦен.Добавить(СтрокаОчереди);
				Продолжить;
			КонецЕсли;
		КонецЕсли;
		
		МассивЭлементов.Добавить(ЭлементСообщенияWebHook(СтрокаОчереди, Пакет.ТипСобытия, ДанныеОбогащения));
		СтрокиОтправки.Добавить(СтрокаОчереди);
		
	КонецЦикла;
	
	Тело.Вставить("items", МассивЭлементов);
	
	Возврат Новый Структура("Тело,СтрокиОтправки,СтрокиБезЦен", Тело, СтрокиОтправки, СтрокиБезЦен);
	
КонецФункции

Функция ДанныеОбогащенияWebHook(ТипСобытия, СтрокиПакета)
	
	Если ТипСобытия = Перечисления.ТипыСобытийWebHooks.Остаток Тогда
		Возврат ЗагрузитьОстаткиДляWebHook(СтрокиПакета);
	ИначеЕсли ТипСобытия = Перечисления.ТипыСобытийWebHooks.Цена Тогда
		Возврат ЗагрузитьЦеныДляWebHook(СтрокиПакета);
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции

// Ключ строки webhook: номенклатура, склад, при необходимости вид цены и валюта.
//
// Параметры:
//  Номенклатура - СправочникСсылка.Номенклатура;
//  Склад        - СправочникСсылка.Склады;
//  ВидЦены      - СправочникСсылка.ВидыЦен - пустая ссылка для остатков;
//  Валюта       - СправочникСсылка.Валюты - пустая ссылка, если валюта не задана.
//
// Возвращаемое значение:
//  Строка - ключ соответствия.
//
Функция КлючТовараWebHook(Номенклатура, Склад, ВидЦены, Валюта)
	
	Ключ = Строка(Номенклатура) + "|" + Строка(Склад);
	Если ЗначениеЗаполнено(ВидЦены) Тогда
		Ключ = Ключ + "|" + Строка(ВидЦены);
	КонецЕсли;
	Если ЗначениеЗаполнено(Валюта) Тогда
		Ключ = Ключ + "|" + Строка(Валюта);
	КонецЕсли;
	
	Возврат Ключ;
	
КонецФункции

Функция ЗагрузитьОстаткиДляWebHook(СтрокиПакета)
	
	Результат = Новый Соответствие;
	ТаблицаКлючей = Новый ТаблицаЗначений;
	ТаблицаКлючей.Колонки.Добавить("Номенклатура", Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	ТаблицаКлючей.Колонки.Добавить("Склад", Новый ОписаниеТипов("СправочникСсылка.Склады"));
	ДобавленныеКлючи = Новый Соответствие;
	
	Для Каждого СтрокаОчереди Из СтрокиПакета Цикл
		
		Если НЕ ЗначениеЗаполнено(СтрокаОчереди.Номенклатура) Или НЕ ЗначениеЗаполнено(СтрокаОчереди.Склад) Тогда
			Продолжить;
		КонецЕсли;
		
		Ключ = КлючТовараWebHook(СтрокаОчереди.Номенклатура, СтрокаОчереди.Склад, СтрокаОчереди.ВидЦены, СтрокаОчереди.Валюта);
		Если ДобавленныеКлючи.Получить(Ключ) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		ДобавленныеКлючи.Вставить(Ключ, Истина);
		НоваяСтрока = ТаблицаКлючей.Добавить();
		НоваяСтрока.Номенклатура = СтрокаОчереди.Номенклатура;
		НоваяСтрока.Склад = СтрокаОчереди.Склад;
		
	КонецЦикла;
	
	Если ТаблицаКлючей.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ключи", ТаблицаКлючей);
	Запрос.Текст = "ВЫБРАТЬ
	               |	Ключи.Номенклатура КАК Номенклатура,
	               |	Ключи.Склад КАК Склад
	               |ПОМЕСТИТЬ Ключи
	               |ИЗ
	               |	&Ключи КАК Ключи
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	Ост.Номенклатура КАК Номенклатура,
	               |	Ост.Склад КАК Склад,
	               |	СУММА(Ост.ОстатокОстаток) КАК Остаток
	               |ПОМЕСТИТЬ Остатки
	               |ИЗ
	               |	РегистрНакопления.ОстаткиТовара.Остатки(
	               |			,
	               |			(Номенклатура, Склад) В
	               |				(ВЫБРАТЬ
	               |					Ключи.Номенклатура,
	               |					Ключи.Склад
	               |				ИЗ
	               |					Ключи)) КАК Ост
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	Ост.Номенклатура,
	               |	Ост.Склад
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	Рез.Номенклатура КАК Номенклатура,
	               |	Рез.Склад КАК Склад,
	               |	СУММА(Рез.КоличествоОстаток) КАК Резерв
	               |ПОМЕСТИТЬ Резервы
	               |ИЗ
	               |	РегистрНакопления.РезервыТовара.Остатки(
	               |			,
	               |			(Номенклатура, Склад) В
	               |				(ВЫБРАТЬ
	               |					Ключи.Номенклатура,
	               |					Ключи.Склад
	               |				ИЗ
	               |					Ключи)) КАК Рез
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	Рез.Номенклатура,
	               |	Рез.Склад
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	Ключи.Номенклатура КАК Номенклатура,
	               |	Ключи.Склад КАК Склад,
	               |	ЕСТЬNULL(Ост.Остаток, 0) КАК Остаток,
	               |	ЕСТЬNULL(Рез.Резерв, 0) КАК Резерв
	               |ИЗ
	               |	Ключи КАК Ключи
	               |		ЛЕВОЕ СОЕДИНЕНИЕ Остатки КАК Ост
	               |		ПО Ключи.Номенклатура = Ост.Номенклатура
	               |			И Ключи.Склад = Ост.Склад
	               |		ЛЕВОЕ СОЕДИНЕНИЕ Резервы КАК Рез
	               |		ПО Ключи.Номенклатура = Рез.Номенклатура
	               |			И Ключи.Склад = Рез.Склад";
	ТаблицаОстатков = Запрос.Выполнить().Выгрузить();
	
	// сканирование с остатками НАЧАЛО
	СканированиеСерий.УменьшитьОстатокНаБуфер(ТаблицаОстатков);
	// сканирование с остатками ОКОНЧАНИЕ
	
	Для Каждого СтрокаОстатка Из ТаблицаОстатков Цикл
		Данные = Новый Структура("balance,reserve", КодВСтроку(СтрокаОстатка.Остаток), КодВСтроку(СтрокаОстатка.Резерв));
		Результат.Вставить(КлючТовараWebHook(СтрокаОстатка.Номенклатура, СтрокаОстатка.Склад, 0,0 ), Данные);
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// Загружает актуальные цены продажи для строк пакета webhook.
//
// Параметры:
//  СтрокиПакета - Массив - структуры строк очереди.
//
// Возвращаемое значение:
//  Соответствие - ключ товара → структура цен регистра.
//
Функция ЗагрузитьЦеныДляWebHook(СтрокиПакета)
	
	Результат = Новый Соответствие;
	Группы = Новый Соответствие;
	
	Для Каждого СтрокаОчереди Из СтрокиПакета Цикл
		
		Если НЕ ЗначениеЗаполнено(СтрокаОчереди.Номенклатура)
			Или НЕ ЗначениеЗаполнено(СтрокаОчереди.Склад)
			Или НЕ ЗначениеЗаполнено(СтрокаОчереди.ВидЦены)
			Или НЕ ЗначениеЗаполнено(СтрокаОчереди.Валюта) Тогда
			Продолжить;
		КонецЕсли;
		
		КлючГруппы = Строка(СтрокаОчереди.Склад) + "|" + Строка(СтрокаОчереди.ВидЦены) + "|" + Строка(СтрокаОчереди.Валюта);
		Группа = Группы.Получить(КлючГруппы);
		
		Если Группа = Неопределено Тогда
			Группа = Новый Структура("Склад,ВидЦены,Валюта,Номенклатура",
				СтрокаОчереди.Склад, СтрокаОчереди.ВидЦены, СтрокаОчереди.Валюта, Новый Массив);
			Группы.Вставить(КлючГруппы, Группа);
		КонецЕсли;
		
		Если Группа.Номенклатура.Найти(СтрокаОчереди.Номенклатура) = Неопределено Тогда
			Группа.Номенклатура.Добавить(СтрокаОчереди.Номенклатура);
		КонецЕсли;
		
	КонецЦикла;
	
	Для Каждого КлючИЗначение Из Группы Цикл
		
		Группа = КлючИЗначение.Значение;
		Цены = StockAPI_Цены.ЗагрузитьЦеныПродажи(Группа.Номенклатура, Группа.ВидЦены, Группа.Склад, Группа.Валюта);
		
		Для Каждого КлючЦены Из Цены Цикл
			Результат.Вставить(КлючТовараWebHook(КлючЦены.Ключ, Группа.Склад, Группа.ВидЦены, Группа.Валюта), КлючЦены.Значение);
		КонецЦикла;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция ЭлементСообщенияWebHook(СтрокаОчереди, ТипСобытия, ДанныеОбогащения)
	
	Если ТипСобытия = Перечисления.ТипыСобытийWebHooks.СтатусЗаказа Тогда
		Возврат ЭлементСтатусаWebHook(СтрокаОчереди);
	КонецЕсли;
	
	Элемент = Новый Структура;
	Элемент.Вставить("eventId", Строка(СтрокаОчереди.ИД));
	Элемент.Вставить("createdAt", ДатаВСтроку(СтрокаОчереди.Создан));
	
	Если ЗначениеЗаполнено(СтрокаОчереди.Номенклатура) Тогда
		Элемент.Вставить("itemCode", Формат(СтрокаОчереди.Номенклатура.Код, "ЧГ=0"));
		Элемент.Вставить("item", Строка(СтрокаОчереди.Номенклатура));
	КонецЕсли;
	
	Если ЗначениеЗаполнено(СтрокаОчереди.Склад) Тогда
		Элемент.Вставить("warehouse", Формат(СтрокаОчереди.Склад.Код, "ЧГ=0"));
		Элемент.Вставить("warehouseName", Строка(СтрокаОчереди.Склад));
	КонецЕсли;
	
	Если ЗначениеЗаполнено(СтрокаОчереди.ВидЦены) Тогда
		Элемент.Вставить("priceType", StockAPI_Цены.ПредставлениеВидаЦеныДляAPI(СтрокаОчереди.ВидЦены));
	КонецЕсли;
	
	Если ЗначениеЗаполнено(СтрокаОчереди.Инициатор) Тогда
		Элемент.Вставить("source", Строка(СтрокаОчереди.Инициатор));
	КонецЕсли;
	
	Если ТипСобытия = Перечисления.ТипыСобытийWebHooks.Остаток И ДанныеОбогащения <> Неопределено Тогда
		ДанныеОстатка = ДанныеОбогащения.Получить(КлючТовараWebHook(СтрокаОчереди.Номенклатура, СтрокаОчереди.Склад, 0, СтрокаОчереди.Валюта));
		Если ДанныеОстатка <> Неопределено Тогда
			Элемент.Вставить("balance", ДанныеОстатка.balance);
			Элемент.Вставить("reserve", ДанныеОстатка.reserve);
		КонецЕсли;
	ИначеЕсли ТипСобытия = Перечисления.ТипыСобытийWebHooks.Цена И ДанныеОбогащения <> Неопределено Тогда
		ДанныеЦены = ДанныеОбогащения.Получить(КлючТовараWebHook(СтрокаОчереди.Номенклатура, СтрокаОчереди.Склад, СтрокаОчереди.ВидЦены, СтрокаОчереди.Валюта));
		Если ДанныеЦены <> Неопределено Тогда
			Элемент.Вставить("price", ЦеныWebHookИзДанныхРегистра(ДанныеЦены));
			Элемент.Вставить("currency", ДанныеЦены.Валюта);
		КонецЕсли;
	КонецЕсли;
	
	Возврат Элемент;
	
КонецФункции

Функция ЦеныWebHookИзДанныхРегистра(ДанныеЦены)
	
	МассивЦен = Новый Массив;
	
	Если ДанныеЦены.Цена0 <> 0 Тогда
		Запись = Новый Структура("qty,price", 1, ДанныеЦены.Цена0);
		МассивЦен.Добавить(Запись);
	КонецЕсли;
	
	Если ДанныеЦены.Порог1 <> 0 И ДанныеЦены.Цена1 <> 0 Тогда
		Запись = Новый Структура("qty,price", ДанныеЦены.Порог1, ДанныеЦены.Цена1);
		МассивЦен.Добавить(Запись);
	КонецЕсли;
	
	Если ДанныеЦены.Порог2 <> 0 И ДанныеЦены.Цена2 <> 0 Тогда
		Запись = Новый Структура("qty,price", ДанныеЦены.Порог2, ДанныеЦены.Цена2);
		МассивЦен.Добавить(Запись);
	КонецЕсли;
	
	Если ДанныеЦены.Порог3 <> 0 И ДанныеЦены.Цена3 <> 0 Тогда
		Запись = Новый Структура("qty,price", ДанныеЦены.Порог3, ДанныеЦены.Цена3);
		МассивЦен.Добавить(Запись);
	КонецЕсли;
	
	Возврат МассивЦен;
	
КонецФункции

// Проверяет, есть ли у позиции хотя бы одна ненулевая цена для webhook.
//
// Параметры:
//  ДанныеЦены - Структура, Неопределено - данные регистра ЦеныПродажи.
//
// Возвращаемое значение:
//  Булево - Истина, если массив price будет непустым.
//
Функция ЕстьЦеныДляWebHook(ДанныеЦены)
	
	Если ДанныеЦены = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Возврат ЦеныWebHookИзДанныхРегистра(ДанныеЦены).Количество() > 0;
	
КонецФункции

Функция ЭлементСтатусаWebHook(СтрокаОчереди)
	
	Элемент = Новый Структура;
	Элемент.Вставить("eventId", Строка(СтрокаОчереди.ИД));
	Элемент.Вставить("createdAt", ДатаВСтроку(СтрокаОчереди.Создан));
	
	Если ЗначениеЗаполнено(СтрокаОчереди.Инициатор) Тогда
		Элемент.Вставить("source", Строка(СтрокаОчереди.Инициатор));
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(СтрокаОчереди.Заказ) Тогда
		Возврат Элемент;
	КонецЕсли;
	
	РеквизитыЗаказа = ОбщегоНазначенияСервер.ЗначенияРеквизитовОбъекта(СтрокаОчереди.Заказ, "Номер,НомерВходящий");
	Элемент.Вставить("orderNumber", РеквизитыЗаказа.Номер);
	Элемент.Вставить("incomingNumber", РеквизитыЗаказа.НомерВходящий);
	
	Статус = РаботаСИнвойсами.ПолучитьСтатусИнвойсаПродажи(СтрокаОчереди.Заказ);
	Элемент.Вставить("status", Строка(Статус.Состояние));
	Элемент.Вставить("statusSetBy", Строка(Статус.КемИзменено));
	Элемент.Вставить("statusDate", ДатаВСтроку(Статус.Зарегистрировано));
	
	Возврат Элемент;
	
КонецФункции

Функция ОтправитьPOSTWebHook(URL, ТелоJSON, Токен)
	
	ДанныеURL = РазобратьURLWebHook(URL);
	
	Заголовки = Новый Соответствие;
	Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
	Заголовки.Вставить("Accept", "application/json");
	Если ЗначениеЗаполнено(Токен) Тогда
		//Заголовки.Вставить("X-Webhook-Token", Строка(Токен));
		Заголовки.Вставить("Authorization", "Bearer " + Строка(Токен));
	КонецЕсли;
	
	ТаймаутСекунд = 30;
	Если ДанныеURL.HTTPS Тогда
		Соединение = Новый HTTPСоединение(ДанныеURL.Сервер, ДанныеURL.Порт, , , , ТаймаутСекунд, Новый ЗащищенноеСоединениеOpenSSL());
	Иначе
		Соединение = Новый HTTPСоединение(ДанныеURL.Сервер, ДанныеURL.Порт, , , , ТаймаутСекунд);
	КонецЕсли;
	
	ЗапросHTTP = Новый HTTPЗапрос(ДанныеURL.Адрес, Заголовки);
	ЗапросHTTP.УстановитьТелоИзСтроки(ТелоJSON, КодировкаТекста.UTF8, ИспользованиеByteOrderMark.НеИспользовать);
	Ответ = Соединение.ВызватьHTTPМетод("POST", ЗапросHTTP);
	
	Возврат Новый Структура("КодСостояния,ТелоОтвета", Ответ.КодСостояния, Ответ.ПолучитьТелоКакСтроку());
	
КонецФункции

Функция РазобратьURLWebHook(URL)
	
	СтрокаURL = СокрЛП(Строка(URL));
	НижнийURL = НРег(СтрокаURL);
	
	Если СтрНачинаетсяС(НижнийURL, "https://") Тогда
		HTTPS = Истина;
		БезСхемы = Сред(СтрокаURL, 9);
		Порт = 443;
	ИначеЕсли СтрНачинаетсяС(НижнийURL, "http://") Тогда
		HTTPS = Ложь;
		БезСхемы = Сред(СтрокаURL, 8);
		Порт = 80;
	Иначе
		ВызватьИсключение "WebhookURL должен начинаться с http:// или https://.";
	КонецЕсли;
	
	ПозицияПути = СтрНайти(БезСхемы, "/");
	Если ПозицияПути = 0 Тогда
		Хост = БезСхемы;
		Адрес = "/";
	Иначе
		Хост = Лев(БезСхемы, ПозицияПути - 1);
		Адрес = Сред(БезСхемы, ПозицияПути);
	КонецЕсли;
	
	ПозицияПорта = СтрНайти(Хост, ":");
	Если ПозицияПорта > 0 Тогда
		Порт = Число(Сред(Хост, ПозицияПорта + 1));
		Хост = Лев(Хост, ПозицияПорта - 1);
	КонецЕсли;
	
	Если Хост = "" Тогда
		ВызватьИсключение "В WebhookURL не указан сервер.";
	КонецЕсли;
	
	Возврат Новый Структура("HTTPS,Сервер,Порт,Адрес", HTTPS, Хост, Порт, Адрес);
	
КонецФункции

Процедура ЗаписатьРезультатОтправкиПакетаWebHook(СтрокиПакета, ДатаПопытки, Отправлено, ТекстОшибки)
	
	Для Каждого СтрокаОчереди Из СтрокиПакета Цикл
		ЗаписатьРезультатОтправкиWebHook(СтрокаОчереди, ДатаПопытки, Отправлено, ТекстОшибки);
	КонецЦикла;
	
КонецПроцедуры

// Удаляет запись очереди webhook по ключу измерений.
//
// Параметры:
//  СтрокаОчереди - Структура - строка очереди с полями измерений регистра.
//
Процедура УдалитьЗаписьОчередиWebHook(СтрокаОчереди)
	
	ЗаписьОчереди = РегистрыСведений.ОчередьWebHook.СоздатьМенеджерЗаписи();
	ЗаписьОчереди.ИД = СтрокаОчереди.ИД;
	ЗаписьОчереди.УчетнаяЗапись = СтрокаОчереди.УчетнаяЗапись;
	ЗаписьОчереди.ТипСобытия = СтрокаОчереди.ТипСобытия;
	ЗаписьОчереди.Номенклатура = СтрокаОчереди.Номенклатура;
	ЗаписьОчереди.Склад = СтрокаОчереди.Склад;
	ЗаписьОчереди.ВидЦены = СтрокаОчереди.ВидЦены;
	ЗаписьОчереди.Валюта = СтрокаОчереди.Валюта;
	ЗаписьОчереди.Заказ = СтрокаОчереди.Заказ;
	ЗаписьОчереди.Удалить();
	
КонецПроцедуры

Процедура ЗаписатьРезультатОтправкиWebHook(СтрокаОчереди, ДатаПопытки, Отправлено, ТекстОшибки)
	
	НаборЗаписей = РегистрыСведений.ОчередьWebHook.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.ИД.Установить(СтрокаОчереди.ИД);
	НаборЗаписей.Отбор.УчетнаяЗапись.Установить(СтрокаОчереди.УчетнаяЗапись);
	НаборЗаписей.Отбор.ТипСобытия.Установить(СтрокаОчереди.ТипСобытия);
	НаборЗаписей.Отбор.Номенклатура.Установить(СтрокаОчереди.Номенклатура);
	НаборЗаписей.Отбор.Склад.Установить(СтрокаОчереди.Склад);
	НаборЗаписей.Отбор.ВидЦены.Установить(СтрокаОчереди.ВидЦены);
	НаборЗаписей.Отбор.Валюта.Установить(СтрокаОчереди.Валюта);
	НаборЗаписей.Отбор.Заказ.Установить(СтрокаОчереди.Заказ);
	
	Запись = НаборЗаписей.Добавить();
	Запись.ИД 				= СтрокаОчереди.ИД;
	Запись.УчетнаяЗапись 	= СтрокаОчереди.УчетнаяЗапись;
	Запись.ТипСобытия 		= СтрокаОчереди.ТипСобытия;
	Запись.Номенклатура 	= СтрокаОчереди.Номенклатура;
	Запись.Склад 			= СтрокаОчереди.Склад;
	Запись.ВидЦены 			= СтрокаОчереди.ВидЦены;
	Запись.Валюта 			= СтрокаОчереди.Валюта;
	Запись.Заказ 			= СтрокаОчереди.Заказ;
	Запись.Отправлен 		= ?(Отправлено, ДатаПопытки, СтрокаОчереди.Отправлен);
	Запись.Создан 			= СтрокаОчереди.Создан;
	Запись.Инициатор 		= СтрокаОчереди.Инициатор;
	Запись.КоличествоПопыток = СтрокаОчереди.КоличествоПопыток + 1;
	Запись.ПоследняяПопытка = ДатаПопытки;
	Запись.Ошибка 			= ?(Отправлено, "", Лев(ТекстОшибки, 500));
	
	НаборЗаписей.Записать(Истина);
	
КонецПроцедуры

// Ставит в очередь webhook смены перечислимого статуса заказа.
// API-признаки blocked / cancelled / readyToShip сюда не попадают.
//
// Параметры:
//  Заказ     - ДокументСсылка.ИнвойсПродажи - заказ, у которого сменилось Состояние;
//  Инициатор - ДокументСсылка - документ, вызвавший смену статуса; не документ — не записывается.
//
Процедура ЗарегистрироватьWebHookСтатусЗаказа(Заказ, Инициатор = Неопределено) Экспорт
	
	Если НЕ ЗначениеЗаполнено(Заказ) Тогда
		Возврат;
	КонецЕсли;
	
	Попытка
		
		Запрос = Новый Запрос;
		Запрос.УстановитьПараметр("Заказ", Заказ);
		Запрос.Текст =
		"ВЫБРАТЬ
		|	ИнвойсПродажи.УчетнаяЗапись КАК УчетнаяЗапись
		|ИЗ
		|	Документ.ИнвойсПродажи КАК ИнвойсПродажи
		|ГДЕ
		|	ИнвойсПродажи.Ссылка = &Заказ
		|	И ИнвойсПродажи.УчетнаяЗапись <> ЗНАЧЕНИЕ(Справочник.УчетныеЗаписиИнтеграции.ПустаяСсылка)
		|	И ИнвойсПродажи.УчетнаяЗапись.Активен
		|	И ИнвойсПродажи.УчетнаяЗапись.WebhookАктивен
		|	И ИнвойсПродажи.УчетнаяЗапись.WebhookURL <> """"";
		Выборка = Запрос.Выполнить().Выбрать();
		Если НЕ Выборка.Следующий() Тогда
			Возврат;
		КонецЕсли;
		
		УчетнаяЗапись = Выборка.УчетнаяЗапись;
		ТипСобытия = Перечисления.ТипыСобытийWebHooks.СтатусЗаказа;
		ПустаяДатаОтправки = Дата(1, 1, 1);
		
		ЗапросОчереди = Новый Запрос;
		ЗапросОчереди.УстановитьПараметр("УчетнаяЗапись", УчетнаяЗапись);
		ЗапросОчереди.УстановитьПараметр("ТипСобытия", ТипСобытия);
		ЗапросОчереди.УстановитьПараметр("Заказ", Заказ);
		ЗапросОчереди.УстановитьПараметр("Отправлен", ПустаяДатаОтправки);
		ЗапросОчереди.Текст =
		"ВЫБРАТЬ
		|	ОчередьWebHook.ИД КАК ИД,
		|	ОчередьWebHook.УчетнаяЗапись КАК УчетнаяЗапись,
		|	ОчередьWebHook.ТипСобытия КАК ТипСобытия,
		|	ОчередьWebHook.Номенклатура КАК Номенклатура,
		|	ОчередьWebHook.Склад КАК Склад,
		|	ОчередьWebHook.ВидЦены КАК ВидЦены,
		|	ОчередьWebHook.Валюта КАК Валюта,
		|	ОчередьWebHook.Заказ КАК Заказ
		|ИЗ
		|	РегистрСведений.ОчередьWebHook КАК ОчередьWebHook
		|ГДЕ
		|	ОчередьWebHook.УчетнаяЗапись = &УчетнаяЗапись
		|	И ОчередьWebHook.ТипСобытия = &ТипСобытия
		|	И ОчередьWebHook.Заказ = &Заказ
		|	И ОчередьWebHook.Отправлен = &Отправлен";
		ВыборкаОчереди = ЗапросОчереди.Выполнить().Выбрать();
		Пока ВыборкаОчереди.Следующий() Цикл
			ЗаписьОчереди = РегистрыСведений.ОчередьWebHook.СоздатьМенеджерЗаписи();
			ЗаполнитьЗначенияСвойств(ЗаписьОчереди, ВыборкаОчереди);
			ЗаписьОчереди.Удалить();
		КонецЦикла;
		
		НоваяЗапись = РегистрыСведений.ОчередьWebHook.СоздатьМенеджерЗаписи();
		НоваяЗапись.ИД = Новый УникальныйИдентификатор;
		НоваяЗапись.УчетнаяЗапись = УчетнаяЗапись;
		НоваяЗапись.ТипСобытия = ТипСобытия;
		НоваяЗапись.Заказ = Заказ;
		НоваяЗапись.Отправлен = ПустаяДатаОтправки;
		НоваяЗапись.Создан = ТекущаяДатаСеанса();
		НоваяЗапись.КоличествоПопыток = 0;
		НоваяЗапись.Ошибка = "";
		
		Если ЗначениеЗаполнено(Инициатор)
			И Документы.ТипВсеСсылки().СодержитТип(ТипЗнч(Инициатор)) Тогда
			НоваяЗапись.Инициатор = Инициатор;
		КонецЕсли;
		
		НоваяЗапись.Записать();
		
	Исключение
		ЗаписьЖурналаРегистрации("StockAPI.WebHook", УровеньЖурналаРегистрации.Ошибка, , Заказ,
			"Ошибка постановки webhook статуса заказа: " + ОписаниеОшибки());
	КонецПопытки;
	
КонецПроцедуры

