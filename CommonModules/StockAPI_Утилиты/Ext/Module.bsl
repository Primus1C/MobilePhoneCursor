// Возвращает криптографически стойкий хеш SHA-256 (строка 64 символа в нижнем регистре)   
//
Функция СгенерироватьТокенSHA256() Экспорт
	
	// 1. Формируем уникальную исходную строку (соль)
	// Комбинация GUID и времени до миллисекунд исключает совпадения даже теоретически
	УникальнаяСтрока = Строка(Новый УникальныйИдентификатор) 
	                 + Строка(ТекущаяУниверсальнаяДатаВМиллисекундах());
	
	// 2. Инициализируем объект хеширования алгоритмом SHA-256
	Хеширование = Новый ХешированиеДанных(ХешФункция.SHA256);
	
	// 3. Вычисляем хеш для нашей строки
	Хеширование.Добавить(УникальнаяСтрока);
	
	// 4. Получаем результат в виде двоичных данных
	ДвоичныеДанныеХеша = Хеширование.ХешСумма;
	
	// 5. Конвертируем в шестнадцатеричную строку (Hex)
	СтрокаHex = НРег(ПолучитьHexСтрокуИзДвоичныхДанных(ДвоичныеДанныеХеша));
	
	Возврат СтрокаHex;
	
КонецФункции

Функция ПроверитьКлючAPI(ЗапросАПИ, КонтекстАвторизации) Экспорт
	
	// Ожидаем, что клиент присылает ключ в заголовке X-Api-Key
	КлючКлиента = ЗапросАПИ.Заголовки.Получить("X-Api-Key");

	Если Не ЗначениеЗаполнено(КлючКлиента) Тогда
		КонтекстАвторизации.Вставить("Ошибка", "Отсутствует заголовок ключа.");
		Возврат Ложь;
	КонецЕсли;
	
	ЗапросБД = Новый Запрос;
	ЗапросБД.Текст = "ВЫБРАТЬ
	                 |	УчЗаписи.Ссылка КАК УчетнаяЗапись,
	                 |	УчЗаписи.Активен КАК Активен,
	                 |	УчЗаписи.Администратор КАК Администратор
	                 |ИЗ
	                 |	Справочник.УчетныеЗаписиИнтеграции КАК УчЗаписи
	                 |ГДЕ
	                 |	УчЗаписи.ТокенАвторизации = &КлючAPI";
		
	ЗапросБД.УстановитьПараметр("КлючAPI", КлючКлиента);
	Выборка = ЗапросБД.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда 
		Если Выборка.Активен Тогда
			КонтекстАвторизации.Вставить("УчетнаяЗапись", Выборка.УчетнаяЗапись);
			КонтекстАвторизации.Вставить("Администратор", Выборка.Администратор = Истина);
			Возврат Истина; 
		Иначе
			КонтекстАвторизации.Вставить("Ошибка", "Учетная запись отключена.");
			Возврат Ложь;
		КонецЕсли;
	Иначе 
		КонтекстАвторизации.Вставить("Ошибка", "Ошибка авторизации: неверный логин или пароль.");
		Возврат Ложь;
	КонецЕсли;
	
КонецФункции

#КонецОбласти


#Область СведенияУчетнойЗаписи
	
// Признак «Администратор» учётной записи API.
//
// Параметры:
//  УчетнаяЗапись - СправочникСсылка.УчетныеЗаписиИнтеграции - учётная запись из авторизации.
//
// Возвращаемое значение:
//  Булево - Истина, если у записи включён реквизит Администратор.
//
Функция ЭтоАдминистраторAPI(УчетнаяЗапись) Экспорт
	
	Если НЕ ЗначениеЗаполнено(УчетнаяЗапись) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Возврат УчетнаяЗапись.Администратор = Истина;
	
КонецФункции

// Склады, входящие в ТЧ «Склады» всех активных учётных записей.
//
// Возвращаемое значение:
//  Массив из СправочникСсылка.Склады.
//
Функция СкладыОбщиеДляВсехУчетныхЗаписейAPI() Экспорт
	
	Запр = Новый Запрос;
	Запр.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
	             |	СкладыУЗ.Склад КАК Склад
	             |ИЗ
	             |	Справочник.УчетныеЗаписиИнтеграции.Склады КАК СкладыУЗ
	             |ГДЕ
	             |	НЕ СкладыУЗ.Склад.ПометкаУдаления
	             |	И СкладыУЗ.Ссылка.Активен";
	
	Возврат Запр.Выполнить().Выгрузить().ВыгрузитьКолонку(0);
	
КонецФункции

// Группы контрагентов из ТЧ «Контрагенты» учётной записи интеграции.
//
// Параметры:
//  УчетнаяЗапись - СправочникСсылка.УчетныеЗаписиИнтеграции - учётная запись API.
//
// Возвращаемое значение:
//  Массив из СправочникСсылка.Контрагенты - группы (папки) из ТЧ.
//
Функция ГруппыКонтрагентовУчетнойЗаписи(УчетнаяЗапись) Экспорт
	
	Если НЕ ЗначениеЗаполнено(УчетнаяЗапись) Тогда
		Возврат Новый Массив;
	КонецЕсли;
	
	Запр = Новый Запрос;
	Запр.УстановитьПараметр("УчетнаяЗапись", УчетнаяЗапись);
	Запр.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
	             |	КонтрагентыУЗ.ГруппаКонтрагентов КАК Группа
	             |ИЗ
	             |	Справочник.УчетныеЗаписиИнтеграции.Контрагенты КАК КонтрагентыУЗ
	             |ГДЕ
	             |	КонтрагентыУЗ.Ссылка = &УчетнаяЗапись
	             |	И КонтрагентыУЗ.ГруппаКонтрагентов <> ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)
	             |	И КонтрагентыУЗ.Ссылка.Активен";
	РезультатЗапроса = Запр.Выполнить();
	Если РезультатЗапроса.Пустой() Тогда
		Возврат Новый Массив;
	Иначе
	    Возврат РезультатЗапроса.Выгрузить().ВыгрузитьКолонку(0);
	КонецЕсли;
	
КонецФункции

// Контрагенты, доступные учётной записи по группам из ТЧ «Контрагенты».
//
// Параметры:
//  УчетнаяЗапись - СправочникСсылка.УчетныеЗаписиИнтеграции - учётная запись API;
//  Ошибка        - Строка - текст ошибки, если группы не настроены.
//
// Возвращаемое значение:
//  Массив из СправочникСсылка.Контрагенты - элементы в иерархиях доступных групп.
//
Функция РазрешенныеКонтрагентыУчетнойЗаписи(УчетнаяЗапись, Ошибка = "") Экспорт
	
	Группы = ГруппыКонтрагентовУчетнойЗаписи(УчетнаяЗапись);
	Если Группы.Количество() = 0 Тогда
		Ошибка = "В учётной записи интеграции не указаны группы контрагентов.";
		Возврат Новый Массив;
	КонецЕсли;
	
	Запр = Новый Запрос;
	Запр.УстановитьПараметр("Группы", Группы);
	Запр.Текст = "ВЫБРАТЬ
	             |	Контрагенты.Ссылка КАК Ссылка
	             |ИЗ
	             |	Справочник.Контрагенты КАК Контрагенты
	             |ГДЕ
	             |	Контрагенты.Родитель В(&Группы)
	             |	И НЕ Контрагенты.ЭтоГруппа
	             |	И НЕ Контрагенты.ПометкаУдаления
	             |
	             |УПОРЯДОЧИТЬ ПО
	             |	Контрагенты.Код";
	
	Возврат Запр.Выполнить().Выгрузить().ВыгрузитьКолонку(0);
	
КонецФункции

// Группа-родитель для создания контрагента по параметру groupCode запроса API.
//
// Параметры:
//  ДанныеЗапроса - Структура - тело POST-запроса;
//  УчетнаяЗапись - СправочникСсылка.УчетныеЗаписиИнтеграции - учётная запись API;
//  Ошибка        - Строка - текст ошибки.
//
// Возвращаемое значение:
//  СправочникСсылка.Контрагенты - группа из ТЧ учётной записи или пустая ссылка.
//
Функция ГруппаСозданияКонтрагентаИзЗапроса(ДанныеЗапроса, УчетнаяЗапись, Ошибка) Экспорт
	
	ГруппыДоступа = ГруппыКонтрагентовДоступныеAPI(УчетнаяЗапись);
	Если ГруппыДоступа.Количество() = 0 Тогда
		Ошибка = "В учётной записи интеграции не указаны группы контрагентов).";
		Возврат Справочники.Контрагенты.ПустаяСсылка();
	КонецЕсли;
	
	КодГруппы = StockAPI_Утилиты.СвойствоДанныхЗапроса(ДанныеЗапроса, "groupCode");
	Если КодГруппы = "" Тогда
		Ошибка = "Укажите groupCode — код группы контрагентов (родителя).";
		Возврат Справочники.Контрагенты.ПустаяСсылка();
	КонецЕсли;
	
	Попытка
		КодГруппыЧисло = Число(КодГруппы);
	Исключение
		Ошибка = СтрШаблон("Значение groupCode не числовое: '%1'.", КодГруппы);
		Возврат Справочники.Контрагенты.ПустаяСсылка();
	КонецПопытки;
	
	Для Каждого Группа Из ГруппыДоступа Цикл
		Если Группа.Код = КодГруппыЧисло Тогда
			Возврат Группа;
		КонецЕсли;
	КонецЦикла;
	
	Ошибка = СтрШаблон("Группа с кодом %1 недоступна для учётной записи.",
		КодВСтроку(КодГруппыЧисло));
	Возврат Справочники.Контрагенты.ПустаяСсылка();
	
КонецФункции

// Группы контрагентов, доступные учётной записи для создания контрагента и списка groupCode.
// Для администратора — из ТЧ всех активных учётных записей.
//
// Параметры:
//  УчетнаяЗапись - СправочникСсылка.УчетныеЗаписиИнтеграции - учётная запись API.
//
// Возвращаемое значение:
//  Массив из СправочникСсылка.Контрагенты.
//
Функция ГруппыКонтрагентовДоступныеAPI(УчетнаяЗапись) Экспорт
	
	Если ЭтоАдминистраторAPI(УчетнаяЗапись) Тогда
		Запр = Новый Запрос;
		Запр.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
		             |	УчетныеЗаписиИнтеграцииКонтрагенты.ГруппаКонтрагентов КАК ГруппаКонтрагентов
		             |ИЗ
		             |	Справочник.УчетныеЗаписиИнтеграции.Контрагенты КАК УчетныеЗаписиИнтеграцииКонтрагенты
		             |ГДЕ
		             |	НЕ УчетныеЗаписиИнтеграцииКонтрагенты.ГруппаКонтрагентов.ПометкаУдаления
		             |	И УчетныеЗаписиИнтеграцииКонтрагенты.Ссылка.Активен";
		Возврат Запр.Выполнить().Выгрузить().ВыгрузитьКолонку(0);
	Иначе
		Возврат ГруппыКонтрагентовУчетнойЗаписи(УчетнаяЗапись);
	КонецЕсли;
	
КонецФункции

// Контрагенты всех учётных записей.
//
// Возвращаемое значение:
//  Массив из СправочникСсылка.Контрагенты.
//
Функция КонтрагентыОбщиеДляВсехУчетныхЗаписейAPI() Экспорт
	
	Запр = Новый Запрос;
	Запр.Текст = "ВЫБРАТЬ
	             |	Контрагенты.Ссылка КАК Ссылка
	             |ИЗ
	             |	Справочник.Контрагенты КАК Контрагенты
	             |ГДЕ
	             |	Контрагенты.Ссылка В ИЕРАРХИИ
	             |			(ВЫБРАТЬ РАЗЛИЧНЫЕ
	             |				ТЧ.ГруппаКонтрагентов
	             |			ИЗ
	             |				Справочник.УчетныеЗаписиИнтеграции.Контрагенты КАК ТЧ
	             |			ГДЕ
	             |				ТЧ.Ссылка.Активен
	             |				И НЕ ТЧ.ГруппаКонтрагентов.ПометкаУдаления)
	             |	И НЕ Контрагенты.ПометкаУдаления";
	РезультатЗапроса = Запр.Выполнить();
	Если РезультатЗапроса.Пустой() Тогда
		Возврат Новый Массив;
	Иначе
		Возврат РезультатЗапроса.Выгрузить().ВыгрузитьКолонку(0);
	КонецЕсли;
	
КонецФункции

