// Справочники StockAPI: форматирование кодов, поиск фирмы/склада/контрагента, списки складов и валют.

// Поиск склада: сначала из запроса, затем склад фирмы, затем первый доступный склад.  
//
Функция НайтиСклад(ДанныеЗапроса, УчетнаяЗапись, Ошибка) Экспорт
	
	ПараметрКод = Неопределено;
	ПараметрИмя = Неопределено;

	ПараметрКод = StockAPI_Утилиты.СвойствоДанныхЗапроса(ДанныеЗапроса, "warehouseId,warehouseCode", Неопределено);	

	Если ПараметрКод = Неопределено Тогда  
		Если ДанныеЗапроса.Свойство("warehouse") И СокрЛП(ДанныеЗапроса.warehouse) <> ""  Тогда
			ПараметрИмя = СокрЛП(ДанныеЗапроса.warehouse);
		Иначе
			Ошибка = "Не указан код или наименование склада: warehouseId, или warehouseCode, или warehouse (наименование).";
			Возврат Справочники.Склады.ПустаяСсылка();
		КонецЕсли;
	Иначе	
		Попытка
			ПараметрКод = Число(СокрЛП(Строка(ПараметрКод)));
		Исключение
			Ошибка = "Параметр warehouseId (или warehouseCode) должен быть числовым кодом склада.";
			Возврат Справочники.Склады.ПустаяСсылка();
		КонецПопытки;
	КонецЕсли;
	
	Запр = Новый Запрос;
	Запр.УстановитьПараметр("ШаблонПоискаКод", ПараметрКод); 
	Запр.УстановитьПараметр("ШаблонПоискаИмя", ПараметрИмя);
	
	Если StockAPI_Утилиты.ЭтоАдминистраторAPI(УчетнаяЗапись) Тогда
		ОбщиеСклады = StockAPI_Утилиты.СкладыОбщиеДляВсехУчетныхЗаписейAPI();
		Запр.УстановитьПараметр("ОбщиеСклады", ОбщиеСклады);
		Запр.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
		             |	Склады.Ссылка КАК Склад
		             |ИЗ
		             |	Справочник.Склады КАК Склады
		             |ГДЕ
		             |	Склады.Ссылка В (&ОбщиеСклады)
		             |	И НЕ Склады.ПометкаУдаления
		             |	И ВЫБОР
		             |			КОГДА &ШаблонПоискаКод = НЕОПРЕДЕЛЕНО
		             |				ТОГДА ИСТИНА
		             |			ИНАЧЕ Склады.Код = &ШаблонПоискаКод
		             |		КОНЕЦ
		             |	И ВЫБОР
		             |			КОГДА &ШаблонПоискаИмя = НЕОПРЕДЕЛЕНО
		             |				ТОГДА ИСТИНА
		             |			ИНАЧЕ Склады.Наименование = &ШаблонПоискаИмя
		             |		КОНЕЦ";
	Иначе
		Запр.УстановитьПараметр("УчетнаяЗапись", УчетнаяЗапись);
		Запр.Текст = "ВЫБРАТЬ
		             |	Склады.Склад КАК Склад
		             |ИЗ
		             |	Справочник.УчетныеЗаписиИнтеграции.Склады КАК Склады
		             |ГДЕ
		             |	Склады.Ссылка = &УчетнаяЗапись
		             |	И ВЫБОР
		             |			КОГДА &ШаблонПоискаКод = НЕОПРЕДЕЛЕНО
		             |				ТОГДА ИСТИНА
		             |			ИНАЧЕ Склады.Склад.Код = &ШаблонПоискаКод
		             |		КОНЕЦ
		             |	И ВЫБОР
		             |			КОГДА &ШаблонПоискаИмя = НЕОПРЕДЕЛЕНО
		             |				ТОГДА ИСТИНА
		             |			ИНАЧЕ Склады.Склад.Наименование = &ШаблонПоискаИмя
		             |		КОНЕЦ";
	КонецЕсли;
	
	РезультатЗапроса = Запр.Выполнить();
	Если РезультатЗапроса.Пустой() Тогда
		Если ПараметрКод <> Неопределено Тогда
			Ошибка = СтрШаблон(
				"Не найден склад (или нет доступа к указанному складу) с кодом '%1'.",
				StockAPI_Утилиты.КодВСтроку(ПараметрКод));
		Иначе
			Ошибка = СтрШаблон(
				"Не найден склад (или нет доступа к указанному складу) '%1'.",
				ПараметрИмя);
		КонецЕсли;
		Возврат Справочники.Склады.ПустаяСсылка();
	Иначе
		Выборка = РезультатЗапроса.Выбрать();	
		Выборка.Следующий(); 
		Возврат Выборка.Склад;   
	КонецЕсли;

КонецФункции

// GET /warehouses — список складов с фильтрацией по доступу, поиску, коду.
//
Функция ПолучитьСписокСкладов(ЗапросАПИ) Экспорт
	
	СтрокаПоиска = "";
	ПараметрПоиска = ЗапросАПИ.ПараметрыЗапроса.Получить("search");
	Если ПараметрПоиска <> Неопределено Тогда
		СтрокаПоиска = СокрЛП(ПараметрПоиска);
	КонецЕсли;
	ШаблонПоиска = ?(ЗначениеЗаполнено(СтрокаПоиска), "%" + СтрокаПоиска + "%", "");
	
	СтрокаКода = "";
	ПараметрКода = ЗапросАПИ.ПараметрыЗапроса.Получить("warehouseCode");
	Если ПараметрКода = Неопределено Тогда
		ПараметрКода = ЗапросАПИ.ПараметрыЗапроса.Получить("code");
	КонецЕсли;
	Если ПараметрКода <> Неопределено Тогда
		СтрокаКода = СокрЛП(Строка(ПараметрКода));
	КонецЕсли; 
	Если ЗначениеЗаполнено(СтрокаКода) Тогда
		КодЧисло = Число(СтрокаКода);
	Иначе
		КодЧисло = Неопределено;
	КонецЕсли;
	
	Запр = Новый Запрос;
	Запр.УстановитьПараметр("ШаблонПоиска", ШаблонПоиска);
	Запр.УстановитьПараметр("Код", КодЧисло);
	
	ТокенАвторизации = ЗапросАПИ.Заголовки.Получить("X-Api-Key");
	УчетнаяЗапись = Справочники.УчетныеЗаписиИнтеграции.НайтиПоРеквизиту("ТокенАвторизации", ТокенАвторизации);
	
	Если StockAPI_Утилиты.ЭтоАдминистраторAPI(УчетнаяЗапись) Тогда
		Запр.УстановитьПараметр("ОбщиеСклады", StockAPI_Утилиты.СкладыОбщиеДляВсехУчетныхЗаписейAPI());
		Запр.Текст = "ВЫБРАТЬ
		             |	Склады.Наименование КАК Наименование,
		             |	Склады.НаименованиеАнгл КАК НаименованиеАнгл,
		             |	Склады.Код КАК Код
		             |ИЗ
		             |	Справочник.Склады КАК Склады
		             |ГДЕ
		             |	Склады.Ссылка В (&ОбщиеСклады)
		             |	И НЕ Склады.ПометкаУдаления
		             |	И ВЫБОР
		             |			КОГДА &ШаблонПоиска = """"
		             |				ТОГДА ИСТИНА
		             |			ИНАЧЕ Склады.Наименование ПОДОБНО &ШаблонПоиска
		             |		КОНЕЦ
		             |	И ВЫБОР
		             |			КОГДА &Код = НЕОПРЕДЕЛЕНО
		             |				ТОГДА ИСТИНА
		             |			ИНАЧЕ Склады.Код = &Код
		             |		КОНЕЦ";
	Иначе
		Запр.Текст = "ВЫБРАТЬ
		             |	Склады.Склад.Наименование КАК Наименование,
		             |	Склады.Склад.НаименованиеАнгл КАК НаименованиеАнгл,
		             |	Склады.Склад.Код КАК Код
		             |ИЗ
		             |	Справочник.УчетныеЗаписиИнтеграции.Склады КАК Склады
		             |ГДЕ
		             |	Склады.Ссылка.ТокенАвторизации = &ТокенАвторизации
		             |	И ВЫБОР
		             |			КОГДА &ШаблонПоиска = """"
		             |				ТОГДА ИСТИНА
		             |			ИНАЧЕ Склады.Склад.Наименование ПОДОБНО &ШаблонПоиска
		             |		КОНЕЦ
		             |	И ВЫБОР
		             |			КОГДА &Код = НЕОПРЕДЕЛЕНО
		             |				ТОГДА ИСТИНА
		             |			ИНАЧЕ Склады.Склад.Код = &Код
		             |		КОНЕЦ";
		Запр.УстановитьПараметр("ТокенАвторизации", ТокенАвторизации);
	КонецЕсли;
	
	Таблица = Запр.Выполнить().Выгрузить();
	Массив = Новый Массив;
	
	Для Каждого Стр Из Таблица Цикл
		Элемент = Новый Структура;
		Элемент.Вставить("warehouse", 		Стр.Наименование);
		Элемент.Вставить("warehouseEn", 	Стр.НаименованиеАнгл);
		Элемент.Вставить("warehouseCode", 	StockAPI_Утилиты.КодВСтроку(Стр.Код));
		Массив.Добавить(Элемент);
	КонецЦикла;
	
	Возврат Массив;
	
КонецФункции

// + GET /currencies — список валют с фильтрацией по поиску и коду.    
//
Функция ПолучитьСписокВалют(ЗапросАПИ) Экспорт
	
	СтрокаПоиска = "";
	ПараметрПоиска = ЗапросАПИ.ПараметрыЗапроса.Получить("search");
	Если ПараметрПоиска <> Неопределено Тогда
		СтрокаПоиска = СокрЛП(ПараметрПоиска);
	КонецЕсли;
	ШаблонПоиска = ?(ЗначениеЗаполнено(СтрокаПоиска), "%" + СтрокаПоиска + "%", "");

	СтрокаКода = "";
	ПараметрКода = ЗапросАПИ.ПараметрыЗапроса.Получить("currencyCode");
	Если ПараметрКода = Неопределено Тогда
		ПараметрКода = ЗапросАПИ.ПараметрыЗапроса.Получить("code");
	КонецЕсли;
	Если ПараметрКода <> Неопределено Тогда
		СтрокаКода = СокрЛП(Строка(ПараметрКода));
	КонецЕсли; 
	Если ЗначениеЗаполнено(СтрокаКода) Тогда
		КодЧисло = Число(СтрокаКода);
	Иначе
		КодЧисло = Неопределено;
	КонецЕсли;
	
	Зап = Новый Запрос;
	Зап.Текст = "ВЫБРАТЬ
	            |	Вал.Код КАК currency,
	            |	Вал.КодISO КАК Код,
	            |	Вал.Наименование КАК Наименование,
	            |	Вал.Символ КАК Символ
	            |ИЗ
	            |	Справочник.Валюты КАК Вал
	            |ГДЕ
	            |	НЕ Вал.ПометкаУдаления
	            |	И ВЫБОР
	            |			КОГДА &ШаблонПоиска = """"
	            |				ТОГДА ИСТИНА
	            |			ИНАЧЕ Вал.Наименование ПОДОБНО &ШаблонПоиска
	            |		КОНЕЦ
	            |	И ВЫБОР
	            |			КОГДА &Код = НЕОПРЕДЕЛЕНО
	            |				ТОГДА ИСТИНА
	            |			ИНАЧЕ Вал.КодISO = &Код
	            |		КОНЕЦ
	            |
	            |УПОРЯДОЧИТЬ ПО
	            |	Вал.Наименование";
	Зап.УстановитьПараметр("ШаблонПоиска", 	ШаблонПоиска);
	Зап.УстановитьПараметр("Код", 			КодЧисло);
	
	Выборка  = Зап.Выполнить().Выбрать();
	Массив = Новый Массив;
	
	Пока Выборка.Следующий() Цикл
		Элемент = Новый Структура;
		Элемент.Вставить("currencyCode", 	СокрЛП(Выборка.Код));
		Элемент.Вставить("currency", 		Строка(Выборка.currency));
		Элемент.Вставить("name", 			Строка(Выборка.Наименование));
		Элемент.Вставить("sign", 			Строка(Выборка.Символ));
		Массив.Добавить(Элемент);
	КонецЦикла;
	
	Возврат Массив;
	
КонецФункции

// Поиск сотрудника-оператора склада по коду (приоритет) или пину среди складов учётной записи API.
//    
Функция НайтиСотрудника(КодСотрудника, ПинСотрудника, УчетнаяЗапись, Ошибка = "") Экспорт
	
	СтрокаКода = СокрЛП(Строка(КодСотрудника));
	СтрокаПина = СокрЛП(Строка(ПинСотрудника));
	ПоКоду = СтрокаКода <> "";
	
	Если НЕ ПоКоду И СтрокаПина = "" Тогда
		Возврат Справочники.Сотрудники.ПустаяСсылка();
	КонецЕсли;
	
	//Если НЕ ЗначениеЗаполнено(УчетнаяЗапись) Тогда
	//	Ошибка = "Не указана учётная запись для поиска сотрудника.";
	//	Возврат Справочники.Сотрудники.ПустаяСсылка();
	//КонецЕсли;
	
	КодЧисло = 0;
	ПинЧисло = 0;
	
	Если ПоКоду Тогда
		Попытка
			КодЧисло = Число(СтрокаКода);
		Исключение
			Ошибка = "Параметр employeeCode должен быть числовым кодом сотрудника.";
			Возврат Справочники.Сотрудники.ПустаяСсылка();
		КонецПопытки;
	Иначе
		Попытка
			ПинЧисло = Число(СтрокаПина);
		Исключение
			Ошибка = "Параметр employeePin должен быть числом.";
			Возврат Справочники.Сотрудники.ПустаяСсылка();
		КонецПопытки;
	КонецЕсли;
	
	Зап = Новый Запрос;
	Если StockAPI_Утилиты.ЭтоАдминистраторAPI(УчетнаяЗапись) Тогда
		Зап.УстановитьПараметр("ОбщиеСотрудники", StockAPI_Утилиты.СотрудникиОбщиеДляВсехУчетныхЗаписейAPI());
		Зап.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
		            |	Сотрудники.Ссылка КАК Ссылка
		            |ИЗ
		            |	Справочник.Сотрудники КАК Сотрудники
		            |ГДЕ
		            |	Сотрудники.Ссылка В (&ОбщиеСотрудники)
		            |	И НЕ Сотрудники.ЭтоГруппа
		            |	И НЕ Сотрудники.ПометкаУдаления
		            |	И (Сотрудники.ДатаУвольнения = &ПустаяДата
		            |			ИЛИ Сотрудники.ДатаУвольнения >= &ТекущаяДата)
		            |	И ВЫБОР
		            |			КОГДА &ПоКоду
		            |				ТОГДА Сотрудники.Код = &Код
		            |			ИНАЧЕ Сотрудники.Пин = &Пин
		            |		КОНЕЦ";
	Иначе
		Зап.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
		            |	Сотрудники.Ссылка КАК Ссылка
		            |ИЗ
		            |	Справочник.Сотрудники.Склады КАК СотрудникиСклады
		            |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Сотрудники КАК Сотрудники
		            |		ПО СотрудникиСклады.Ссылка = Сотрудники.Ссылка
		            |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.УчетныеЗаписиИнтеграции.Склады КАК СкладыУчетнойЗаписи
		            |		ПО СотрудникиСклады.Склад = СкладыУчетнойЗаписи.Склад
		            |			И (СкладыУчетнойЗаписи.Ссылка = &УчетнаяЗапись)
		            |ГДЕ
		            |	НЕ Сотрудники.ЭтоГруппа
		            |	И НЕ Сотрудники.ПометкаУдаления
		            |	И (Сотрудники.ДатаУвольнения = &ПустаяДата
		            |			ИЛИ Сотрудники.ДатаУвольнения >= &ТекущаяДата)
		            |	И ВЫБОР
		            |			КОГДА &ПоКоду
		            |				ТОГДА Сотрудники.Код = &Код
		            |			ИНАЧЕ Сотрудники.Пин = &Пин
		            |		КОНЕЦ";
		Зап.УстановитьПараметр("УчетнаяЗапись", УчетнаяЗапись);
	КонецЕсли;
	Зап.УстановитьПараметр("ПоКоду", 		ПоКоду);
	Зап.УстановитьПараметр("Код", 			КодЧисло);
	Зап.УстановитьПараметр("Пин", 			ПинЧисло); 
	Зап.УстановитьПараметр("ПустаяДата", 	Дата(1, 1, 1));
	Зап.УстановитьПараметр("ТекущаяДата", 	НачалоДня(ТекущаяДатаСеанса()));
	
	РезультатЗапроса = Зап.Выполнить();
	Если РезультатЗапроса.Пустой() Тогда
		Если ПоКоду Тогда
			Ошибка = СтрШаблон("Сотрудник с кодом %1 не найден среди операторов складов, доступных учётной записи API.", СтрокаКода);
		Иначе
			Ошибка = СтрШаблон("Сотрудник с пином %1 не найден среди операторов складов, доступных учётной записи API.", СтрокаПина);
		КонецЕсли;
		Возврат Справочники.Сотрудники.ПустаяСсылка();
	КонецЕсли;
	
	Выборка = РезультатЗапроса.Выбрать();
	Выборка.Следующий();
	Возврат Выборка.Ссылка;
	
КонецФункции

// Сотрудник-оператор склада из параметров запроса API (employeeCode, employeePin).
//
Функция СотрудникИзДанныхЗапроса(ДанныеЗапроса, УчетнаяЗапись) Экспорт	

	Результат = Новый Структура("Сотрудник, Ошибка", Справочники.Сотрудники.ПустаяСсылка(), "");
	
	Если ДанныеЗапроса = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	
	Если ДанныеЗапроса.Свойство("employeeCode") Тогда
		КодСотрудника = ДанныеЗапроса.employeeCode;
	Иначе
	    КодСотрудника = "";
	КонецЕсли;                       
	Если ДанныеЗапроса.Свойство("employeePin") Тогда
		ПинСотрудника = ДанныеЗапроса.employeePin;
	Иначе
	    ПинСотрудника = "";
	КонецЕсли;                       
	
	Если СокрЛП(Строка(КодСотрудника)) = "" И СокрЛП(Строка(ПинСотрудника)) = "" Тогда
		Возврат Результат;
	КонецЕсли;
	
	ОшибкаПоиска = "";
	Сотрудник = НайтиСотрудника(КодСотрудника, ПинСотрудника, УчетнаяЗапись, ОшибкаПоиска);
	Результат.Сотрудник = Сотрудник;
	Результат.Ошибка = ОшибкаПоиска;
	Возврат Результат;
	
КонецФункции

// GET /emploees — сотрудники склада (операторы) по табличной части Сотрудники.Склады.
//
// Параметры:
//  Запрос          - HTTPСервисЗапрос - параметры warehouseCode/warehouse, search;
//  УчетнаяЗапись   - СправочникСсылка.УчетныеЗаписиИнтеграции - учётная запись API.
//
// Возвращаемое значение:
//  Структура - поля Тело, Ошибка, НеНайден.
//
Функция ПолучитьСотрудниковСклада(Запрос, УчетнаяЗапись) Экспорт
	
	Результат = Новый Структура("Тело, Ошибка, НеНайден", Неопределено, "", Ложь);
	
	ДанныеСклада = Новый Структура;
	СтрокаКода = StockAPI_Утилиты.СтрокаПараметраЗапроса(Запрос, "warehouseCode");
	Если СтрокаКода <> "" Тогда
		ДанныеСклада.Вставить("warehouseCode", СтрокаКода);
	КонецЕсли;
	СтрокаИмени = StockAPI_Утилиты.СтрокаПараметраЗапроса(Запрос, "warehouse");
	Если СтрокаИмени <> "" Тогда
		ДанныеСклада.Вставить("warehouse", СтрокаИмени);
	КонецЕсли;
	
	ОшибкаСклада = "";
	Склад = НайтиСклад(ДанныеСклада, УчетнаяЗапись, ОшибкаСклада);
	Если НЕ ЗначениеЗаполнено(Склад) Тогда
		Результат.Ошибка = ОшибкаСклада;
		Результат.НеНайден = Истина;
		Возврат Результат;
	КонецЕсли;
	
	СтрокаПоиска = StockAPI_Утилиты.СтрокаПараметраЗапроса(Запрос, "search");
	ШаблонПоиска = ?(ЗначениеЗаполнено(СтрокаПоиска), "%" + СтрокаПоиска + "%", "");
	
	Зап = Новый Запрос;
	Если StockAPI_Утилиты.ЭтоАдминистраторAPI(УчетнаяЗапись) Тогда
		Зап.УстановитьПараметр("ОбщиеСотрудники", StockAPI_Утилиты.СотрудникиОбщиеДляВсехУчетныхЗаписейAPI());
		Зап.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
		            |	Сотрудники.Наименование КАК Наименование,
		            |	Сотрудники.Код КАК Код,
		            |	Сотрудники.Пин КАК Пин
		            |ИЗ
		            |	Справочник.Сотрудники.Склады КАК СотрудникиСклады
		            |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Сотрудники КАК Сотрудники
		            |		ПО СотрудникиСклады.Ссылка = Сотрудники.Ссылка
		            |ГДЕ
		            |	СотрудникиСклады.Склад = &Склад
		            |	И Сотрудники.Ссылка В (&ОбщиеСотрудники)
		            |	И НЕ Сотрудники.ЭтоГруппа
		            |	И НЕ Сотрудники.ПометкаУдаления
		            |	И (Сотрудники.ДатаУвольнения = &ПустаяДата
		            |			ИЛИ Сотрудники.ДатаУвольнения >= &ТекущаяДата)
		            |	И ВЫБОР
		            |			КОГДА &СтрокаПоиска = """"
		            |				ТОГДА ИСТИНА
		            |			ИНАЧЕ Сотрудники.Наименование ПОДОБНО &ШаблонПоиска
		            |					ИЛИ Сотрудники.Код = &СтрокаПоиска
		            |		КОНЕЦ
		            |
		            |УПОРЯДОЧИТЬ ПО
		            |	Сотрудники.Наименование";
	Иначе
		Зап.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
		            |	Сотрудники.Наименование КАК Наименование,
		            |	Сотрудники.Код КАК Код,
		            |	Сотрудники.Пин КАК Пин
		            |ИЗ
		            |	Справочник.Сотрудники.Склады КАК СотрудникиСклады
		            |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Сотрудники КАК Сотрудники
		            |		ПО СотрудникиСклады.Ссылка = Сотрудники.Ссылка
		            |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.УчетныеЗаписиИнтеграции.Склады КАК СкладыУчетнойЗаписи
		            |		ПО СотрудникиСклады.Склад = СкладыУчетнойЗаписи.Склад
		            |			И (СкладыУчетнойЗаписи.Ссылка = &УчетнаяЗапись)
		            |ГДЕ
		            |	СотрудникиСклады.Склад = &Склад
		            |	И НЕ Сотрудники.ЭтоГруппа
		            |	И НЕ Сотрудники.ПометкаУдаления
		            |	И (Сотрудники.ДатаУвольнения = &ПустаяДата
		            |			ИЛИ Сотрудники.ДатаУвольнения >= &ТекущаяДата)
		            |	И ВЫБОР
		            |			КОГДА &СтрокаПоиска = """"
		            |				ТОГДА ИСТИНА
		            |			ИНАЧЕ Сотрудники.Наименование ПОДОБНО &ШаблонПоиска
		            |					ИЛИ Сотрудники.Код = &СтрокаПоиска
		            |		КОНЕЦ
		            |
		            |УПОРЯДОЧИТЬ ПО
		            |	Сотрудники.Наименование";
		Зап.УстановитьПараметр("УчетнаяЗапись", УчетнаяЗапись);
	КонецЕсли;
	Зап.УстановитьПараметр("Склад", 		Склад);
	Зап.УстановитьПараметр("ПустаяДата", 	Дата(1, 1, 1));
	Зап.УстановитьПараметр("ТекущаяДата", 	НачалоДня(ТекущаяДатаСеанса()));
	Зап.УстановитьПараметр("СтрокаПоиска", 	СтрокаПоиска);
	Зап.УстановитьПараметр("ШаблонПоиска", 	ШаблонПоиска);
	
	МассивСотрудников = Новый Массив;
	Выборка = Зап.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Элемент = Новый Структура;
		Элемент.Вставить("employee", 		Выборка.Наименование);
		Элемент.Вставить("employeeCode", 	StockAPI_Утилиты.КодВСтроку(Выборка.Код));
		Элемент.Вставить("pin", 			StockAPI_Утилиты.КодВСтроку(Выборка.Пин));
		МассивСотрудников.Добавить(Элемент);
	КонецЦикла;
	
	ТелоОтвета = Новый Структура;
	ТелоОтвета.Вставить("warehouse", 		Склад.Наименование);
	ТелоОтвета.Вставить("warehouseCode", 	StockAPI_Утилиты.КодВСтроку(Склад.Код));
	ТелоОтвета.Вставить("employees", 		МассивСотрудников);
	Результат.Тело = ТелоОтвета;
	Возврат Результат;
	
КонецФункции

// GET /brands — элементы первого уровня справочника Номенклатура с типом «Товар».
//
// Возвращаемое значение:
//  Массив из Структура - Код, Наименование.
//
Функция ПолучитьСписокБрендов() Экспорт
	
	Зап = Новый Запрос;
	Зап.Текст = "ВЫБРАТЬ
	            |	Ном.Код КАК Код,
	            |	Ном.Наименование КАК Наименование
	            |ИЗ
	            |	Справочник.Номенклатура КАК Ном
	            |ГДЕ
	            |	Ном.Родитель = ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)
	            |	И НЕ Ном.ПометкаУдаления
	            |	И Ном.ТипНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.Товар)
	            |	И Ном.ЭтоГруппа
	            |
	            |УПОРЯДОЧИТЬ ПО
	            |	Ном.Наименование";
	
	Выборка = Зап.Выполнить().Выбрать();
	Массив = Новый Массив;
	
	Пока Выборка.Следующий() Цикл
		Элемент = Новый Структура;
		Элемент.Вставить("code", StockAPI_Утилиты.КодВСтроку(Выборка.Код));
		Элемент.Вставить("brand", СокрЛП(Выборка.Наименование));
		Массив.Добавить(Элемент);
	КонецЦикла;
	
	Возврат Массив;
	
КонецФункции

// Поиск бренда (группа первого уровня) по коду или наименованию.
//
// Параметры:
//  ЗначениеБренда - Строка - код или наименование;
//  Ошибка         - Строка - текст ошибки, если бренд не найден.
//
// Возвращаемое значение:
//  СправочникСсылка.Номенклатура - найденный бренд; пустая ссылка при ошибке.
//
Функция НайтиБренд(ЗначениеБренда, Ошибка = "") Экспорт
	
	СтрокаБренда = СокрЛП(Строка(ЗначениеБренда));
	Если СтрокаБренда = "" Тогда
		Возврат Справочники.Номенклатура.ПустаяСсылка();
	КонецЕсли;
	
	КодЧисло = Неопределено;
	Попытка
		КодЧисло = Число(СтрокаБренда);
	Исключение
		КодЧисло = Неопределено;
	КонецПопытки;
	
	Зап = Новый Запрос;
	Зап.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
	            |	Ном.Ссылка КАК Ссылка
	            |ИЗ
	            |	Справочник.Номенклатура КАК Ном
	            |ГДЕ
	            |	Ном.Родитель = ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)
	            |	И НЕ Ном.ПометкаУдаления
	            |	И Ном.ТипНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.Товар)
	            |	И Ном.ЭтоГруппа
	            |	И ВЫБОР
	            |			КОГДА &ПоКоду
	            |				ТОГДА Ном.Код = &Код
	            |			ИНАЧЕ Ном.Наименование = &Наименование
	            |		КОНЕЦ";
	Зап.УстановитьПараметр("ПоКоду", КодЧисло <> Неопределено);
	Зап.УстановитьПараметр("Код", ?(КодЧисло = Неопределено, 0, КодЧисло));
	Зап.УстановитьПараметр("Наименование", СтрокаБренда);
	
	Выборка = Зап.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;
	
	Ошибка = СтрШаблон("Не найден бренд ""%1"".", СтрокаБренда);
	Возврат Справочники.Номенклатура.ПустаяСсылка();
	
КонецФункции

// GET /goods — товары (тип «Товар»), не выведенные из ассортимента,
// у которых были остатки/движения на складах учётной записи за последние N месяцев.
// Пагинация: page, pageSize/limit (как в /balances, /counterparties).
//
// Параметры:
//  Запрос        - HTTPСервисЗапрос - входящий запрос (months, page, pageSize,
//                  warehouse / warehouseCode / warehouseId — необязательный отбор по складу);
//  УчетнаяЗапись - СправочникСсылка.УчетныеЗаписиИнтеграции - учётная запись API.
//
// Возвращаемое значение:
//  Структура - поля КодОтвета, Тело.
//
Функция ПолучитьСписокТоваров(Запрос, УчетнаяЗапись) Экспорт
	
	Результат = Новый Структура("КодОтвета, Тело", 200, Неопределено);
	
	Пагинация = StockAPI_Утилиты.ПараметрыПагинацииОстатков(Запрос);
	Если Пагинация.Ошибка <> "" Тогда
		Результат.КодОтвета = 400;
		Результат.Тело = Новый Структура("error", Пагинация.Ошибка);
		Возврат Результат;
	КонецЕсли;
	
	ПараметрыМесяцев = StockAPI_Утилиты.ПараметрыМесяцевИзЗапроса(Запрос);
	Если ПараметрыМесяцев.Ошибка <> "" Тогда
		Результат.КодОтвета = 400;
		Результат.Тело = Новый Структура("error", ПараметрыМесяцев.Ошибка);
		Возврат Результат;
	КонецЕсли;
	Месяцев = ПараметрыМесяцев.Месяцев;
	
	ФильтрСклад = StockAPI_Остатки.РазрешенныйСкладИзЗапроса(Запрос, УчетнаяЗапись);
	Если ФильтрСклад.Ошибка <> "" Тогда
		Результат.КодОтвета = 400;
		Результат.Тело = Новый Структура("error", ФильтрСклад.Ошибка);
		Возврат Результат;
	КонецЕсли;
	Если ФильтрСклад.Склады = Неопределено ИЛИ ФильтрСклад.Склады.Количество() = 0 Тогда
		Результат.КодОтвета = 400;
		Результат.Тело = Новый Структура("error", "Для учётной записи не заданы склады.");
		Возврат Результат;
	КонецЕсли;
	
	КонДата = КонецДня(ТекущаяДатаСеанса());
	НачДата = НачалоДня(ДобавитьМесяц(КонДата, -Месяцев));
	
	Запр = Новый Запрос;
	Запр.УстановитьПараметр("Склады", ФильтрСклад.Склады);
	Запр.УстановитьПараметр("НачДата", НачДата);
	Запр.УстановитьПараметр("КонДата", КонДата);
	// ОстаткиИОбороты с периодичностью Авто/пустой на практике даёт пустую выборку.
	// Берём: остаток на начало периода + движения за период + текущий остаток.
	Запр.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
	             |	ОстНач.Номенклатура КАК Номенклатура
	             |ПОМЕСТИТЬ ВТ
	             |ИЗ
	             |	РегистрНакопления.ОстаткиТовара.Остатки(&НачДата, Склад В (&Склады)) КАК ОстНач
	             |ГДЕ
	             |	ОстНач.ОстатокОстаток <> 0
	             |
	             |ОБЪЕДИНИТЬ
	             |
	             |ВЫБРАТЬ РАЗЛИЧНЫЕ
	             |	Движения.Номенклатура
	             |ИЗ
	             |	РегистрНакопления.ОстаткиТовара КАК Движения
	             |ГДЕ
	             |	Движения.Склад В(&Склады)
	             |	И Движения.Период МЕЖДУ &НачДата И &КонДата
	             |
	             |ОБЪЕДИНИТЬ
	             |
	             |ВЫБРАТЬ РАЗЛИЧНЫЕ
	             |	ОстТек.Номенклатура
	             |ИЗ
	             |	РегистрНакопления.ОстаткиТовара.Остатки(, Склад В (&Склады)) КАК ОстТек
	             |ГДЕ
	             |	ОстТек.ОстатокОстаток <> 0
	             |
	             |ИНДЕКСИРОВАТЬ ПО
	             |	Номенклатура
	             |;
	             |
	             |////////////////////////////////////////////////////////////////////////////////
	             |ВЫБРАТЬ
	             |	Ном.Код КАК Код,
	             |	Ном.Наименование КАК Наименование,
	             |	ЕСТЬNULL(Ном.Производитель.Наименование, """") КАК Производитель,
	             |	Ном.УчетПоСериям КАК УчетПоСериям,
	             |	Ном.Описание КАК Описание,
	             |	Ном.Вес КАК Вес,
	             |	ЕСТЬNULL(Ном.ОсновнойПоставщик.Код, 0) КАК КодПоставщика,
	             |	ЕСТЬNULL(Ном.ОсновнойПоставщик.Наименование, """") КАК Поставщик,
	             |	Ном.SKU КАК SKU,
	             |	Ном.UPC КАК UPC,
	             |	Ном.JAN13 КАК JAN
	             |ИЗ
	             |	Справочник.Номенклатура КАК Ном
	             |ГДЕ
	             |	Ном.Ссылка В
	             |			(ВЫБРАТЬ
	             |				ВТ.Номенклатура
	             |			ИЗ
	             |				ВТ КАК ВТ)
	             |	И НЕ Ном.ПометкаУдаления
	             |	И НЕ Ном.ЭтоГруппа
	             |	И Ном.ТипНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.Товар)
	             //|	И НЕ Ном.ВыводитьИзАссортимента
	             |
	             |УПОРЯДОЧИТЬ ПО
	             |	Ном.Наименование";
	
	ТаблицаВсе = Запр.Выполнить().Выгрузить();
	ВсегоТоваров = ТаблицаВсе.Количество();
	РазмерСтраницы = Пагинация.pageSize;
	ВсегоСтраниц = StockAPI_Утилиты.ВсегоСтраницПагинации(ВсегоТоваров, РазмерСтраницы);
	Пропустить = (Пагинация.page - 1) * РазмерСтраницы;
	
	МассивТоваров = Новый Массив;
	НомерСтроки = 0;
	Для Каждого Стр Из ТаблицаВсе Цикл
		НомерСтроки = НомерСтроки + 1;
		Если НомерСтроки <= Пропустить Тогда
			Продолжить;
		КонецЕсли;
		Если МассивТоваров.Количество() >= РазмерСтраницы Тогда
			Прервать;
		КонецЕсли;
		Элемент = Новый Структура;
		Элемент.Вставить("itemCode", 		StockAPI_Утилиты.КодВСтроку(Стр.Код));
		Элемент.Вставить("item", 			СокрЛП(Стр.Наименование));
		Элемент.Вставить("manufacturer", 	СокрЛП(Стр.Производитель));
		Элемент.Вставить("serialAccounting", Стр.УчетПоСериям = Истина);
		Элемент.Вставить("description", 	СокрЛП(Строка(Стр.Описание)));
		Элемент.Вставить("weight", 			Стр.Вес);
		Элемент.Вставить("supplierCode", 	StockAPI_Утилиты.КодВСтроку(Стр.КодПоставщика));
		Элемент.Вставить("supplier", 		СокрЛП(Стр.Поставщик));
		Элемент.Вставить("itemSku", 		СокрЛП(Строка(Стр.SKU)));
		Элемент.Вставить("itemUpc", 		СокрЛП(Строка(Стр.UPC)));
		Элемент.Вставить("itemJan", 		СокрЛП(Строка(Стр.JAN)));
		МассивТоваров.Добавить(Элемент);
	КонецЦикла;
	
	Тело = Новый Структура;
	Тело.Вставить("page", 		Пагинация.page);
	Тело.Вставить("pageSize", 	РазмерСтраницы);
	Тело.Вставить("totalItems", ВсегоТоваров);
	Тело.Вставить("totalPages", ВсегоСтраниц);
	Тело.Вставить("months", Месяцев);
	Если ФильтрСклад.Склады.Количество() = 1
		И StockAPI_Утилиты.СтрокаПараметраЗапроса(Запрос, "warehouseId,warehouseCode,code,warehouse") <> "" Тогда
		Склад = ФильтрСклад.Склады[0];
		Тело.Вставить("warehouse", Склад.Наименование);
		Тело.Вставить("warehouseCode", StockAPI_Утилиты.КодВСтроку(Склад.Код));
	КонецЕсли;
	Тело.Вставить("items", МассивТоваров);
	Результат.Тело = Тело;
	Возврат Результат;
	
КонецФункции

// GET /goodGroups — папки номенклатуры без подчинённых групп.
// Не помечены на удаление, ВыводитьИзАссортимента = Ложь.
//
// Возвращаемое значение:
//  Структура - поле items: массив структур code, name, fullName.
//  fullName — наименования от верхней группы к текущей через "->", не глубже 6 уровней.
//
Функция ПолучитьКонечныеГруппыНоменклатуры() Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Ном.Код КАК Код,
	|	Ном.Наименование КАК Наименование,
	|	Ном.Родитель.Наименование КАК ИмяРодителя1,
	|	Ном.Родитель.Родитель.Наименование КАК ИмяРодителя2,
	|	Ном.Родитель.Родитель.Родитель.Наименование КАК ИмяРодителя3,
	|	Ном.Родитель.Родитель.Родитель.Родитель.Наименование КАК ИмяРодителя4,
	|	Ном.Родитель.Родитель.Родитель.Родитель.Родитель.Наименование КАК ИмяРодителя5
	|ИЗ
	|	Справочник.Номенклатура КАК Ном
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК ПодчиненныеГруппы
	|		ПО ПодчиненныеГруппы.Родитель = Ном.Ссылка
	|			И ПодчиненныеГруппы.ЭтоГруппа
	|			И НЕ ПодчиненныеГруппы.ПометкаУдаления
	|ГДЕ
	|	Ном.ЭтоГруппа
	|	И НЕ Ном.ПометкаУдаления
	|	И НЕ Ном.ВыводитьИзАссортимента
	|	И ПодчиненныеГруппы.Ссылка ЕСТЬ NULL
	|
	|УПОРЯДОЧИТЬ ПО
	|	Ном.Наименование";
	
	Группы = Новый Массив;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Элемент = Новый Структура;
		Элемент.Вставить("code", StockAPI_Утилиты.КодВСтроку(Выборка.Код));
		Элемент.Вставить("name", СокрЛП(Выборка.Наименование));
		Элемент.Вставить("fullName", ПолноеИмяГруппыНоменклатуры(
			Выборка.Наименование,
			Выборка.ИмяРодителя1,
			Выборка.ИмяРодителя2,
			Выборка.ИмяРодителя3,
			Выборка.ИмяРодителя4,
			Выборка.ИмяРодителя5));
		Группы.Добавить(Элемент);
	КонецЦикла;
	
	Возврат Новый Структура("items", Группы);
	
КонецФункции

// Собирает полное имя группы: от верхней к текущей, разделитель "->".
// Пустые уровни выше корня пропускаются.
//
// Параметры:
//  Наименование - Строка - имя текущей группы;
//  ИмяРодителя1 - Строка - непосредственный родитель;
//  ИмяРодителя2 - Строка - родитель на два уровня выше;
//  ИмяРодителя3 - Строка - родитель на три уровня выше;
//  ИмяРодителя4 - Строка - родитель на четыре уровня выше;
//  ИмяРодителя5 - Строка - родитель на пять уровней выше.
//
// Возвращаемое значение:
//  Строка - путь наименований. Для группы верхнего уровня совпадает с её именем.
//
Функция ПолноеИмяГруппыНоменклатуры(Наименование, ИмяРодителя1, ИмяРодителя2, ИмяРодителя3, ИмяРодителя4, ИмяРодителя5)
	
	ЧастиИмени = Новый Массив;
	ДобавитьИмяУровняГруппы(ЧастиИмени, ИмяРодителя5);
	ДобавитьИмяУровняГруппы(ЧастиИмени, ИмяРодителя4);
	ДобавитьИмяУровняГруппы(ЧастиИмени, ИмяРодителя3);
	ДобавитьИмяУровняГруппы(ЧастиИмени, ИмяРодителя2);
	ДобавитьИмяУровняГруппы(ЧастиИмени, ИмяРодителя1);
	ДобавитьИмяУровняГруппы(ЧастиИмени, Наименование);
	Возврат СтрСоединить(ЧастиИмени, "->");
	
КонецФункции

// Добавляет непустое наименование уровня в путь группы.
//
// Параметры:
//  ЧастиИмени - Массив из Строка - уже собранные имена, от верхнего уровня;
//  ИмяУровня  - Строка - наименование уровня; пустое и NULL не добавляются.
//
Процедура ДобавитьИмяУровняГруппы(ЧастиИмени, ИмяУровня)
	
	Имя = СокрЛП(Строка(ИмяУровня));
	Если Имя = "" Тогда
		Возврат;
	КонецЕсли;
	ЧастиИмени.Добавить(Имя);
	
КонецПроцедуры

// POST /goods — создаёт товары из массива items.
// Каждая строка записывается отдельно: ошибка одной не отменяет уже созданные.
//
// Параметры:
//  ДанныеЗапроса - Структура - тело запроса, поле items;
//  УчетнаяЗапись - СправочникСсылка.УчетныеЗаписиИнтеграции - учётная запись API.
//
// Возвращаемое значение:
//  Структура - success (Истина, только если созданы все строки), error, items.
//  Элемент items: success, error, item, itemCode.
//
Функция СоздатьСписокНоменклатуры(ДанныеЗапроса, УчетнаяЗапись) Экспорт
	
	Результат = Новый Структура("success, error, items", Ложь, "", Новый Массив);
	
	Если ТипЗнч(ДанныеЗапроса) <> Тип("Структура")
		ИЛИ НЕ ДанныеЗапроса.Свойство("items") Тогда
		Результат.error = "В теле запроса нет массива items.";
		Возврат Результат;
	КонецЕсли;
	
	Позиции = ДанныеЗапроса.items;
	Если ТипЗнч(Позиции) <> Тип("Массив") Тогда
		Результат.error = "Поле items должно быть массивом.";
		Возврат Результат;
	КонецЕсли;
	Если Позиции.Количество() = 0 Тогда
		Результат.error = "Список items пуст.";
		Возврат Результат;
	КонецЕсли;
	
	Успешно = 0;
	НомерСтроки = 0;
	Для Каждого Позиция Из Позиции Цикл
		
		НомерСтроки = НомерСтроки + 1;
		Если ТипЗнч(Позиция) <> Тип("Структура") Тогда
			СтрокаРезультата = Новый Структура("success, error, item, itemCode",
				Ложь, СтрШаблон("Строка %1: неверный формат позиции.", НомерСтроки), "", "");
		Иначе
			СтрокаРезультата = СоздатьНоменклатуру(Позиция, УчетнаяЗапись);
			Если НЕ СтрокаРезультата.success Тогда
				СтрокаРезультата.error = СтрШаблон("Строка %1: %2", НомерСтроки, СтрокаРезультата.error);
			КонецЕсли;
		КонецЕсли;
		
		Результат.items.Добавить(СтрокаРезультата);
		Если СтрокаРезультата.success Тогда
			Успешно = Успешно + 1;
		КонецЕсли;
		
	КонецЦикла;
	
	Всего = Позиции.Количество();
	Результат.success = (Успешно = Всего);
	Если Успешно = Всего Тогда
		Результат.error = "";
	ИначеЕсли Успешно = 0 Тогда
		Результат.error = "Не создан ни один товар.";
	Иначе
		Результат.error = СтрШаблон("Создано товаров: %1 из %2.", Успешно, Всего);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Создаёт один элемент номенклатуры (товар) — строку массива POST /goods.
// Ассортимент берётся из склада. Склад должен быть в ТЧ учётной записи.
//
// Параметры:
//  ДанныеЗапроса - Структура - поля одной позиции items;
//  УчетнаяЗапись - СправочникСсылка.УчетныеЗаписиИнтеграции - учётная запись API.
//
// Возвращаемое значение:
//  Структура - success, error, item, itemCode.
//
Функция СоздатьНоменклатуру(ДанныеЗапроса, УчетнаяЗапись)
	
	Результат = Новый Структура("success, error, item, itemCode", Ложь, "", "", "");
	
	КодСтрокой = СтрокаСвойстваЗапроса(ДанныеЗапроса, "code,itemCode");
	Если КодСтрокой <> "" Тогда
		КодЧисло = 0;
		Если НЕ ЧисловойКодНоменклатуры(КодСтрокой, КодЧисло, Результат.error) Тогда
			Возврат Результат;
		КонецЕсли;
		КодСтрокой = StockAPI_Утилиты.КодВСтроку(КодЧисло);
		
		Существующая = Справочники.Номенклатура.НайтиПоКоду(КодСтрокой, Истина);
		Если ЗначениеЗаполнено(Существующая) Тогда
			Результат.error = СтрШаблон("Номенклатура с кодом %1 уже существует.", КодСтрокой);
			Возврат Результат;
		КонецЕсли;
	КонецЕсли;
	
	Наименование = СтрокаСвойстваЗапроса(ДанныеЗапроса, "name,item");
	Если Наименование = "" Тогда
		Результат.error = "Укажите наименование номенклатуры (name).";
		Возврат Результат;
	КонецЕсли;
	Если СтрДлина(Наименование) > 150 Тогда
		Результат.error = "Наименование номенклатуры длиннее 150 символов.";
		Возврат Результат;
	КонецЕсли;
	
	ОшибкаРодителя = "";
	Родитель = ГруппаНоменклатурыИзЗапроса(ДанныеЗапроса, ОшибкаРодителя);
	Если ОшибкаРодителя <> "" Тогда
		Результат.error = ОшибкаРодителя;
		Возврат Результат;
	КонецЕсли;
	
	ОшибкаСклада = "";
	Склад = СкладСозданияНоменклатуры(ДанныеЗапроса, УчетнаяЗапись, ОшибкаСклада);
	Если ОшибкаСклада <> "" Тогда
		Результат.error = ОшибкаСклада;
		Возврат Результат;
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(Склад.Ассортимент) Тогда
		Результат.error = СтрШаблон("У склада %1 не установлен ассортимент в 1С", Склад.Наименование);
		Возврат Результат;
	КонецЕсли;
	
	ОшибкаКодов = "";
	КодыТовара = КодыТовараИзЗапроса(ДанныеЗапроса, ОшибкаКодов);
	Если ОшибкаКодов <> "" Тогда
		Результат.error = ОшибкаКодов;
		Возврат Результат;
	КонецЕсли;
	
	ОшибкаСерий = "";
	УчетПоСериям = УчетПоСериямИзЗапроса(ДанныеЗапроса, ОшибкаСерий);
	Если ОшибкаСерий <> "" Тогда
		Результат.error = ОшибкаСерий;
		Возврат Результат;
	КонецЕсли;
	
	НоменклатураОбъект = Справочники.Номенклатура.СоздатьЭлемент();
	Если КодСтрокой <> "" Тогда
		НоменклатураОбъект.Код = КодСтрокой;
	КонецЕсли;
	НоменклатураОбъект.Наименование 	= Наименование;
	НоменклатураОбъект.Родитель 		= Родитель;
	НоменклатураОбъект.ТипНоменклатуры 	= Перечисления.ТипыНоменклатуры.Товар;
	НоменклатураОбъект.УчетПоСериям 	= УчетПоСериям;
	НоменклатураОбъект.SKU 				= КодыТовара.SKU;
	НоменклатураОбъект.UPC 				= КодыТовара.UPC;
	НоменклатураОбъект.JAN13 			= КодыТовара.JAN13;
	НоменклатураОбъект.Ассортимент 		= Склад.Ассортимент;
	
	Попытка
		НоменклатураОбъект.Записать();
	Исключение
		Результат.error = "Не удалось создать номенклатуру: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		Возврат Результат;
	КонецПопытки;
	
	Результат.success = Истина;
	Результат.item = НоменклатураОбъект.Наименование;
	Результат.itemCode = StockAPI_Утилиты.КодВСтроку(НоменклатураОбъект.Код);
	Возврат Результат;
	
КонецФункции

// Ищет группу-родителя номенклатуры по коду и/или наименованию.
// Если родитель не передан, возвращает группу из параметра сеанса АПИ_ГруппаНовойНоменклатуры.
//
// Параметры:
//  ДанныеЗапроса - Структура - тело запроса;
//  Ошибка        - Строка - текст ошибки, если группа не найдена или группа по умолчанию не задана.
//
// Возвращаемое значение:
//  СправочникСсылка.Номенклатура - найденная группа.
//
Функция ГруппаНоменклатурыИзЗапроса(ДанныеЗапроса, Ошибка)
	
	КодГруппы = СтрокаСвойстваЗапроса(ДанныеЗапроса, "parentCode,groupCode");
	ИмяГруппы = СтрокаСвойстваЗапроса(ДанныеЗапроса, "parent,group,parentName");
	Если КодГруппы = "" И ИмяГруппы = "" Тогда
		Возврат ГруппаНовойНоменклатурыПоУмолчанию(Ошибка);
	КонецЕсли;
	
	КодЧисло = 0;
	ОтборПоКоду = КодГруппы <> "";
	Если ОтборПоКоду И НЕ ЧисловойКодНоменклатуры(КодГруппы, КодЧисло, Ошибка) Тогда
		Возврат Справочники.Номенклатура.ПустаяСсылка();
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ОтборПоКоду", ОтборПоКоду);
	Запрос.УстановитьПараметр("Код", КодЧисло);
	Запрос.УстановитьПараметр("ОтборПоИмени", ИмяГруппы <> "");
	Запрос.УстановитьПараметр("Наименование", ИмяГруппы);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Ном.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.Номенклатура КАК Ном
	|ГДЕ
	|	Ном.ЭтоГруппа
	|	И НЕ Ном.ПометкаУдаления
	|	И (НЕ &ОтборПоКоду
	|			ИЛИ Ном.Код = &Код)
	|	И (НЕ &ОтборПоИмени
	|			ИЛИ Ном.Наименование = &Наименование)";
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если НЕ Выборка.Следующий() Тогда
		Ошибка = "Группа номенклатуры (родитель) не найдена.";
		Возврат Справочники.Номенклатура.ПустаяСсылка();
	КонецЕсли;
	
	Группа = Выборка.Ссылка;
	Если Выборка.Следующий() Тогда
		Ошибка = СтрШаблон("Найдено несколько групп номенклатуры с наименованием '%1'. Укажите parentCode.", ИмяГруппы);
		Возврат Справочники.Номенклатура.ПустаяСсылка();
	КонецЕсли;
	
	Возврат Группа;
	
КонецФункции

// Возвращает группу для новой номенклатуры, когда родитель в запросе не передан.
// Значение берётся из параметра сеанса АПИ_ГруппаНовойНоменклатуры.
//
// Параметры:
//  Ошибка - Строка - текст ошибки, если группа по умолчанию не задана или не является группой.
//
// Возвращаемое значение:
//  СправочникСсылка.Номенклатура - группа по умолчанию.
//
Функция ГруппаНовойНоменклатурыПоУмолчанию(Ошибка)
	
	Группа = ПараметрыСеанса.АПИ_ГруппаНовойНоменклатуры;
	Если НЕ ЗначениеЗаполнено(Группа) Тогда
		Ошибка = "Укажите код или наименование родителя (parentCode или parent) либо задайте группу новой номенклатуры в общих настройках.";
		Возврат Справочники.Номенклатура.ПустаяСсылка();
	КонецЕсли;
	
	РеквизитыГруппы = ОбщегоНазначенияСервер.ЗначенияРеквизитовОбъекта(Группа, "ЭтоГруппа, ПометкаУдаления");
	Если РеквизитыГруппы.ЭтоГруппа <> Истина ИЛИ РеквизитыГруппы.ПометкаУдаления <> Ложь Тогда
		Ошибка = "Группа новой номенклатуры в общих настройках не найдена или помечена на удаление.";
		Возврат Справочники.Номенклатура.ПустаяСсылка();
	КонецЕсли;
	
	Возврат Группа;
	
КонецФункции

// Ищет склад в табличной части учётной записи по коду и/или наименованию.
//
// Параметры:
//  ДанныеЗапроса - Структура - тело запроса;
//  УчетнаяЗапись - СправочникСсылка.УчетныеЗаписиИнтеграции - учётная запись API;
//  Ошибка        - Строка - текст ошибки, если склад не указан или недоступен.
//
// Возвращаемое значение:
//  СправочникСсылка.Склады - найденный склад.
//
Функция СкладСозданияНоменклатуры(ДанныеЗапроса, УчетнаяЗапись, Ошибка)
	
	КодСклада = СтрокаСвойстваЗапроса(ДанныеЗапроса, "warehouseCode,warehouseId");
	ИмяСклада = СтрокаСвойстваЗапроса(ДанныеЗапроса, "warehouse");
	Если КодСклада = "" И ИмяСклада = "" Тогда
		Ошибка = "Укажите код или наименование склада (warehouseCode или warehouse).";
		Возврат Справочники.Склады.ПустаяСсылка();
	КонецЕсли;
	
	КодЧисло = 0;
	ОтборПоКоду = КодСклада <> "";
	Если ОтборПоКоду Тогда
		Попытка
			КодЧисло = Число(КодСклада);
		Исключение
			Ошибка = СтрШаблон("Код склада не числовой: '%1'.", КодСклада);
			Возврат Справочники.Склады.ПустаяСсылка();
		КонецПопытки;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("УчетнаяЗапись", УчетнаяЗапись);
	Запрос.УстановитьПараметр("ОтборПоКоду", ОтборПоКоду);
	Запрос.УстановитьПараметр("Код", КодЧисло);
	Запрос.УстановитьПараметр("ОтборПоИмени", ИмяСклада <> "");
	Запрос.УстановитьПараметр("Наименование", ИмяСклада);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	СкладыУЗ.Склад КАК Склад
	|ИЗ
	|	Справочник.УчетныеЗаписиИнтеграции.Склады КАК СкладыУЗ
	|ГДЕ
	|	СкладыУЗ.Ссылка = &УчетнаяЗапись
	|	И НЕ СкладыУЗ.Склад.ПометкаУдаления
	|	И (НЕ &ОтборПоКоду
	|			ИЛИ СкладыУЗ.Склад.Код = &Код)
	|	И (НЕ &ОтборПоИмени
	|			ИЛИ СкладыУЗ.Склад.Наименование = &Наименование)";
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если НЕ Выборка.Следующий() Тогда
		Если ОтборПоКоду Тогда
			Ошибка = СтрШаблон("Не найден склад (или нет доступа к указанному складу) с кодом '%1'.", КодСклада);
		Иначе
			Ошибка = СтрШаблон("Не найден склад (или нет доступа к указанному складу) '%1'.", ИмяСклада);
		КонецЕсли;
		Возврат Справочники.Склады.ПустаяСсылка();
	КонецЕсли;
	
	Склад = Выборка.Склад;
	Если Выборка.Следующий() Тогда
		Ошибка = СтрШаблон("Найдено несколько складов с наименованием '%1'. Укажите warehouseCode.", ИмяСклада);
		Возврат Справочники.Склады.ПустаяСсылка();
	КонецЕсли;
	
	Возврат Склад;
	
КонецФункции

// Читает обязательный sku, необязательные upc, jan13 и проверяет длину.
//
// Параметры:
//  ДанныеЗапроса - Структура - тело запроса;
//  Ошибка        - Строка - текст ошибки, если sku не указан или значение длиннее реквизита.
//
// Возвращаемое значение:
//  Структура - поля SKU, UPC, JAN13.
//
Функция КодыТовараИзЗапроса(ДанныеЗапроса, Ошибка)
	
	Коды = Новый Структура("SKU, UPC, JAN13", "", "", "");
	Коды.SKU = СтрокаСвойстваЗапроса(ДанныеЗапроса, "sku,itemSku");
	Коды.UPC = СтрокаСвойстваЗапроса(ДанныеЗапроса, "upc,itemUpc");
	Коды.JAN13 = СтрокаСвойстваЗапроса(ДанныеЗапроса, "jan13,itemJan");
	
	Если Коды.SKU = "" Тогда
		Ошибка = "Укажите SKU номенклатуры (sku).";
	ИначеЕсли СтрДлина(Коды.SKU) > 26 Тогда
		Ошибка = "SKU длиннее 26 символов.";
	ИначеЕсли СтрДлина(Коды.UPC) > 12 Тогда
		Ошибка = "UPC длиннее 12 символов.";
	ИначеЕсли СтрДлина(Коды.JAN13) > 13 Тогда
		Ошибка = "JAN13 длиннее 13 символов.";
	КонецЕсли;
	
	Возврат Коды;
	
КонецФункции

// Читает признак учёта по сериям. Если параметр не передан — Ложь.
//
// Параметры:
//  ДанныеЗапроса - Структура - тело запроса;
//  Ошибка        - Строка - текст ошибки, если значение не булево.
//
// Возвращаемое значение:
//  Булево - учитывать номенклатуру по сериям.
//
Функция УчетПоСериямИзЗапроса(ДанныеЗапроса, Ошибка)
	
	Если НЕ ДанныеЗапроса.Свойство("serialAccounting") Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Значение = ДанныеЗапроса.serialAccounting;
	Если ТипЗнч(Значение) = Тип("Булево") Тогда
		Возврат Значение;
	КонецЕсли;
	
	СтрокаЗнач = НРег(СокрЛП(Строка(Значение)));
	Если СтрокаЗнач = "true" ИЛИ СтрокаЗнач = "1" ИЛИ СтрокаЗнач = "yes" Тогда
		Возврат Истина;
	ИначеЕсли СтрокаЗнач = "false" ИЛИ СтрокаЗнач = "0" ИЛИ СтрокаЗнач = "no" ИЛИ СтрокаЗнач = "" Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Ошибка = "Параметр serialAccounting должен быть булевым.";
	Возврат Ложь;
	
КонецФункции

// Проверяет, что код номенклатуры — целое число не длиннее 7 знаков.
//
// Параметры:
//  КодСтрокой - Строка - исходное значение кода;
//  КодЧисло   - Число - распознанный код;
//  Ошибка     - Строка - текст ошибки.
//
// Возвращаемое значение:
//  Булево - Истина, если код допустим.
//
Функция ЧисловойКодНоменклатуры(КодСтрокой, КодЧисло, Ошибка)
	
	Попытка
		КодЧисло = Число(СокрЛП(КодСтрокой));
	Исключение
		Ошибка = СтрШаблон("Код номенклатуры не числовой: '%1'.", КодСтрокой);
		Возврат Ложь;
	КонецПопытки;
	
	Если КодЧисло <> Цел(КодЧисло) ИЛИ КодЧисло <= 0 Тогда
		Ошибка = СтрШаблон("Код номенклатуры должен быть целым положительным числом: '%1'.", КодСтрокой);
		Возврат Ложь;
	КонецЕсли;
	
	Если СтрДлина(Формат(КодЧисло, "ЧГ=0")) > 7 Тогда
		Ошибка = "Код номенклатуры длиннее 7 знаков.";
		Возврат Ложь;
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции

// Возвращает первое непустое строковое свойство из списка имён.
//
// Параметры:
//  ДанныеЗапроса - Структура - тело запроса;
//  Имена         - Строка - имена свойств через запятую.
//
// Возвращаемое значение:
//  Строка - значение свойства или пустая строка.
//
Функция СтрокаСвойстваЗапроса(ДанныеЗапроса, Имена)
	
	Значение = StockAPI_Утилиты.СвойствоДанныхЗапроса(ДанныеЗапроса, Имена, "");
	Если Значение = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	
	Возврат СокрЛП(Строка(Значение));
	
КонецФункции
