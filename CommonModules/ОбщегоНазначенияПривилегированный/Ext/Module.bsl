// Серверные процедуры, выполняемые в привилегированном режиме (без проверки прав на объекты).

#Область НулевыеОстатки

// ПриЗаписи набора ОстаткиТовара / РезервыТовара: актуализирует РС НулевыеОстатки по парам,
// сохранённым в BeforeWrite (StockAPI_ИзмененияПарОстатков).
//
// Параметры:
//  Источник  - РегистрНакопленияНаборЗаписей - записываемый набор;
//  Отказ     - Булево - признак отказа от записи;
//  Замещение - Булево - режим замещения движений регистратора.
//
Процедура НулевыеОстаткиПриЗаписиОстатков(Источник, Отказ, Замещение) Экспорт
	
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	ИзмененияПар = Неопределено;
	Если НЕ Источник.ДополнительныеСвойства.Свойство("StockAPI_ИзмененияПарОстатков", ИзмененияПар) Тогда
		Возврат;
	КонецЕсли;
	
	Если ИзмененияПар.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ОбновитьРегистрНулевыеОстатки(ИзмененияПар);
	
КонецПроцедуры

// Добавляет или удаляет записи РС НулевыеОстатки по фактическому остатку ОстаткиТовара.
//
// Параметры:
//  ИзмененияПар - ТаблицаЗначений - колонки Номенклатура, Склад.
//
Процедура ОбновитьРегистрНулевыеОстатки(ИзмененияПар) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ИзмененияПар", ИзмененияПар);
	Запрос.Текст = "ВЫБРАТЬ
	               |	Изм.Номенклатура КАК Номенклатура,
	               |	Изм.Склад КАК Склад
	               |ПОМЕСТИТЬ ИзмененияПар
	               |ИЗ
	               |	&ИзмененияПар КАК Изм
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	Изм.Номенклатура КАК Номенклатура,
	               |	Изм.Склад КАК Склад,
	               |	ЕСТЬNULL(Ост.ОстатокОстаток, 0) КАК Остаток
	               |ИЗ
	               |	ИзмененияПар КАК Изм
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ОстаткиТовара.Остатки(, ) КАК Ост
	               |		ПО Изм.Номенклатура = Ост.Номенклатура
	               |			И Изм.Склад = Ост.Склад";
	Выборка = Запрос.Выполнить().Выбрать();
	ДатаСеанса = ТекущаяДатаСеанса();
	
	Пока Выборка.Следующий() Цикл
		
		ЗаписьРС = РегистрыСведений.НулевыеОстатки.СоздатьМенеджерЗаписи();
		ЗаписьРС.Номенклатура = Выборка.Номенклатура;
		ЗаписьРС.Склад = Выборка.Склад;
		ЗаписьРС.Прочитать();
		
		Если Выборка.Остаток <= 0 Тогда
			Если НЕ ЗаписьРС.Выбран() Тогда
				ЗаписьРС.Номенклатура = Выборка.Номенклатура;
				ЗаписьРС.Склад = Выборка.Склад;
				ЗаписьРС.ДатаОбнуленияЦен = ДатаСеанса;
				ЗаписьРС.Записать();
			КонецЕсли;
		Иначе
			Если ЗаписьРС.Выбран() Тогда
				ЗаписьРС.Удалить();
			КонецЕсли;
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

// Регламентное задание: обнуление цен по позициям из РС НулевыеОстатки (после задержки с момента ДатаОбнуленияЦен).
//
Процедура УстановкаЦенПоНулевымОстаткам() Экспорт
	
	ЗадержкаПередОбнулениемСек = 86400;
	ПорогГотовности = ТекущаяДатаСеанса() - ЗадержкаПередОбнулениемСек;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ПорогГотовности", ПорогГотовности);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Нулев.Номенклатура КАК Номенклатура,
	|	Нулев.Склад КАК Склад,
	|	Нулев.ДатаОбнуленияЦен КАК ДатаОбнуленияЦен,
	|	ЕСТЬNULL(Ост.ОстатокОстаток, 0) КАК Остаток
	|ИЗ
	|	РегистрСведений.НулевыеОстатки КАК Нулев
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ОстаткиТовара.Остатки(, ) КАК Ост
	|		ПО Нулев.Номенклатура = Ост.Номенклатура
	|			И Нулев.Склад = Ост.Склад
	|ГДЕ
	|	Нулев.ДатаОбнуленияЦен <= &ПорогГотовности";
	
	ТаблицаКОбработке = Запрос.Выполнить().Выгрузить();
	Если ТаблицаКОбработке.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ВидыЦенДляДокумента = ВидыЦенБезПометкиУдаления();
	Если ВидыЦенДляДокумента.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	КОбнулению = ТаблицаКОбработке.СкопироватьКолонки();
	
	Для Каждого СтрокаДанных Из ТаблицаКОбработке Цикл
		
		Если СтрокаДанных.Остаток > 0 Тогда
			УдалитьЗаписьРегистраНулевыеОстатки(СтрокаДанных.Номенклатура, СтрокаДанных.Склад);
			Продолжить;
		КонецЕсли;
		
		НоваяСтрока = КОбнулению.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаДанных);
		
	КонецЦикла;
	
	Если КОбнулению.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	КОбнулению.Сортировать("Склад, Номенклатура");
	ТекущийСклад = Неопределено;
	СтрокиСклада = Новый Массив;
	
	Для Каждого СтрокаДанных Из КОбнулению Цикл
		
		Если ТекущийСклад <> Неопределено
			И СтрокаДанных.Склад <> ТекущийСклад Тогда
			СоздатьИПровестиУстановкуЦенПоСкладу(ТекущийСклад, СтрокиСклада, ВидыЦенДляДокумента);
			СтрокиСклада = Новый Массив;
		КонецЕсли;
		
		ТекущийСклад = СтрокаДанных.Склад;
		СтрокиСклада.Добавить(СтрокаДанных);
		
	КонецЦикла;
	
	Если СтрокиСклада.Количество() > 0 Тогда
		СоздатьИПровестиУстановкуЦенПоСкладу(ТекущийСклад, СтрокиСклада, ВидыЦенДляДокумента);
	КонецЕсли;
	
КонецПроцедуры

// Возвращает таблицу активных видов цен (ВидЦены, Валюта).
//
// Возвращаемое значение:
//  ТаблицаЗначений - колонки ВидЦены, Валюта.
//
Функция ВидыЦенБезПометкиУдаления()
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ВидыЦен.Ссылка КАК ВидЦены,
	|	ВидыЦен.Валюта КАК Валюта
	|ИЗ
	|	Справочник.ВидыЦен КАК ВидыЦен
	|ГДЕ
	|	НЕ ВидыЦен.ПометкаУдаления";
	
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции

// Создаёт и проводит документ УстановкаЦен по списку позиций одного склада; удаляет обработанные записи РС.
//
// Параметры:
//  Склад               - СправочникСсылка.Склады;
//  СтрокиСклада        - Массив из СтрокаТаблицыЗначений - Номенклатура, Склад, ДатаОбнуленияЦен;
//  ВидыЦенДляДокумента - ТаблицаЗначений - колонки ВидЦены, Валюта.
//
Процедура СоздатьИПровестиУстановкуЦенПоСкладу(Склад, СтрокиСклада, ВидыЦенДляДокумента)
	
	Если СтрокиСклада.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Документ = Документы.УстановкаЦен.СоздатьДокумент();
	Документ.Дата = ТекущаяДатаСеанса();
	Документ.Фирма = гоФирма();
	Документ.Склад = Склад;
	Документ.ПороговЦен = 0;
	Документ.Примечание = НСтр("ru = 'Обнуление цен при нулевом остатке (регламент)'; en = 'Zero prices for zero stock (scheduled)'");
	Документ.КемСоздан = гоПользователь();
	Документ.Создан = ТекущаяДатаСеанса();
	
	Для Каждого СтрокаВидаЦены Из ВидыЦенДляДокумента Цикл
		НовСтрокаВид = Документ.ВидыЦен.Добавить();
		НовСтрокаВид.ВидЦены = СтрокаВидаЦены.ВидЦены;
		НовСтрокаВид.Валюта = СтрокаВидаЦены.Валюта;
	КонецЦикла;
	
	НомСтроки = 0;
	Для Каждого СтрокаПозиции Из СтрокиСклада Цикл
		Для Каждого СтрокаВидаЦены Из ВидыЦенДляДокумента Цикл
			НомСтроки = НомСтроки + 1;
			СтрокаТоваров = Документ.Товары.Добавить();
			СтрокаТоваров.НомСтроки = НомСтроки;
			СтрокаТоваров.Номенклатура = СтрокаПозиции.Номенклатура;
			СтрокаТоваров.ВидЦены = СтрокаВидаЦены.ВидЦены;
			СтрокаТоваров.Валюта = СтрокаВидаЦены.Валюта;
			СтрокаТоваров.Цена0 = 0;
			СтрокаТоваров.РазрешитьПродажу = Ложь;
		КонецЦикла;
	КонецЦикла;
	
	НачатьТранзакцию();
	Попытка
		Документ.Записать(РежимЗаписиДокумента.Проведение);
		Для Каждого СтрокаПозиции Из СтрокиСклада Цикл
			УдалитьЗаписьРегистраНулевыеОстатки(СтрокаПозиции.Номенклатура, СтрокаПозиции.Склад);
		КонецЦикла;
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ТекстОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		гоЗаписьЖурналаРегистрации(
			СтрШаблон("Не удалось обнулить цены по складу %1: %2", гоИмя(Склад, Ложь), ТекстОшибки),
			"Установка цен",
			"Регламент НулевыеОстатки",
			Склад,
			2);
	КонецПопытки;
	
КонецПроцедуры

// Удаляет запись РС НулевыеОстатки по паре номенклатура + склад.
//
// Параметры:
//  Номенклатура - СправочникСсылка.Номенклатура;
//  Склад        - СправочникСсылка.Склады.
//
Процедура УдалитьЗаписьРегистраНулевыеОстатки(Номенклатура, Склад)
	
	ЗаписьРС = РегистрыСведений.НулевыеОстатки.СоздатьМенеджерЗаписи();
	ЗаписьРС.Номенклатура = Номенклатура;
	ЗаписьРС.Склад = Склад;
	ЗаписьРС.Прочитать();
	Если ЗаписьРС.Выбран() Тогда
		ЗаписьРС.Удалить();
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область Ассортимент

// Возвращает элементы номенклатуры с заполненным реквизитом Ассортимент.
// Выполняется привилегированно: при выключенной ФО реквизит недоступен в обычном запросе.
//
// Возвращаемое значение:
//  Массив из СправочникСсылка.Номенклатура - элементы с заполненным ассортиментом.
//
Функция НоменклатураСЗаполненнымАссортиментом() Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Номенклатура.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.Номенклатура КАК Номенклатура
	|ГДЕ
	|	НЕ Номенклатура.ЭтоГруппа
	|	И Номенклатура.Ассортимент <> ЗНАЧЕНИЕ(Справочник.Ассортимент.ПустаяСсылка)";
	
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
	
КонецФункции

#КонецОбласти
