// Регистрирует документ в РС ДокументыКПроведению для отложенного перепроведения.
// Документы с датой в закрытом периоде (до границы запрета редактирования) в очередь не ставятся.
//
// Параметры:
//  ДокументСсылка - ДокументСсылка - документ для перепроведения;
//  Инициатор      - ДокументСсылка - документ, инициировавший регистрацию.
//
Процедура ЗарегистрироватьДокументКПроведению(ДокументСсылка, Инициатор) Экспорт
	
	Если НЕ ЗначениеЗаполнено(ДокументСсылка) Тогда
		Возврат;
	КонецЕсли;
	
	Если глДатаВЗакрытомПериоде(ДокументСсылка.Дата) Тогда
		лДатаЗапрета = глДатаЗапретаРедактирования();
		гоЗаписьЖурналаРегистрации(
			СтрШаблон("Инициатор %1 регистрация к проведению отклонена: граница запрета редактирования %2",
				Инициатор,
				Формат(лДатаЗапрета, "ДФ=dd.MM.yyyy")),
			ДокументСсылка.Метаданные().Синоним,
			"Автоматическая запись",
			ДокументСсылка,
			4);
		Возврат;
	КонецЕсли;
	
	Мен = РегистрыСведений.ДокументыКПроведению.СоздатьМенеджерЗаписи();
	Мен.Документ 			= ДокументСсылка;
	Мен.Инициатор 			= Инициатор;
	Мен.Зарегистрировано 	= ТекущаяДатаСеанса();
	Мен.Записать();
	гоЗаписьЖурналаРегистрации("Регистрация к доп.проведению документом " + Инициатор, ДокументСсылка.Метаданные().Синоним, "Автоматическая запись", ДокументСсылка, 4);
	
КонецПроцедуры

// Регистрирует проведённые приходные накладные, зависящие от инвойса.
//
// Параметры:
//  Инвойс    - ДокументСсылка._Инвойс - инвойс-источник затрат/цен;
//  Инициатор - ДокументСсылка - документ, инициировавший пересчёт.
//
Процедура ЗарегистрироватьЗависимыеПриходныеПоИнвойсу(Инвойс, Инициатор) Экспорт
	
	Если НЕ ЗначениеЗаполнено(Инвойс) Тогда
		Возврат;
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Истина);
	
	Запр = Новый Запрос;
	Запр.УстановитьПараметр("Ссылка", Инвойс);
	Запр.УстановитьПараметр("ВидДвижения", ВидДвиженияНакопления.Расход);
	Запр.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ВКД_ОприходованиеНоменклатуры.Регистратор КАК ПриходнаяНакладная
	|ИЗ
	|	РегистрНакопления.ВКД_ОприходованиеНоменклатуры КАК ВКД_ОприходованиеНоменклатуры
	|ГДЕ
	|	ВКД_ОприходованиеНоменклатуры.Документ = &Ссылка
	|	И ВКД_ОприходованиеНоменклатуры.ВидДвижения = &ВидДвижения
	|	И ВКД_ОприходованиеНоменклатуры.Регистратор ССЫЛКА Документ.ПриходнаяНакладная
	|	И ВКД_ОприходованиеНоменклатуры.Регистратор.Проведен";
	Выборка = Запр.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ЗарегистрироватьДокументКПроведению(Выборка.ПриходнаяНакладная, Инициатор);
	КонецЦикла;
	
	УстановитьПривилегированныйРежим(Ложь);
	
КонецПроцедуры

// Регистрирует расходные накладные (и иные регистраторы продаж) по партиям.
//
// Параметры:
//  Партии    - Массив из СправочникСсылка.Партии - партии приходной накладной;
//  Инициатор - ДокументСсылка - документ, инициировавший пересчёт.
//
Процедура ЗарегистрироватьРасходныеПоПартиям(Партии, Инициатор) Экспорт
	
	Если Партии = Неопределено ИЛИ Партии.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Истина);
	
	Запр = Новый Запрос;
	Запр.УстановитьПараметр("Партии", Партии);
	Запр.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Продажи.Регистратор КАК Регистратор
	|ИЗ
	|	РегистрНакопления.Продажи КАК Продажи
	|ГДЕ
	|	Продажи.Партия В (&Партии)
	|	И Продажи.Регистратор.Проведен";
	Выборка = Запр.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ЗарегистрироватьДокументКПроведению(Выборка.Регистратор, Инициатор);
	КонецЦикла;
	
	УстановитьПривилегированныйРежим(Ложь);
	
КонецПроцедуры

// Сохраняет в доп.свойствах инвойсы отправки (текущие + удалённые из ТЧ) для каскада затрат.
//
// Параметры:
//  ДокументОбъект - ДокументОбъект.Отправка, ДокументОбъект.ОтправкаAWB - записываемый документ.
//
Процедура ЗапомнитьИнвойсыОтправкиКПерепроведению(ДокументОбъект) Экспорт
	
	МассивИнвойсов = ДокументОбъект.Инвойсы.Выгрузить(, "Инвойс").ВыгрузитьКолонку(0);
	
	Если НЕ ДокументОбъект.ЭтоНовый() Тогда
		ИмяТЧ = ДокументОбъект.Метаданные().ПолноеИмя() + ".Инвойсы";
		Запр = Новый Запрос;
		Запр.УстановитьПараметр("Ссылка", ДокументОбъект.Ссылка);
		Запр.Текст =
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ТЧ.Инвойс КАК Инвойс
		|ИЗ
		|	" + ИмяТЧ + " КАК ТЧ
		|ГДЕ
		|	ТЧ.Ссылка = &Ссылка";
		Выборка = Запр.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			Если ЗначениеЗаполнено(Выборка.Инвойс) И МассивИнвойсов.Найти(Выборка.Инвойс) = Неопределено Тогда
				МассивИнвойсов.Добавить(Выборка.Инвойс);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	ДокументОбъект.ДополнительныеСвойства.Вставить("ИнвойсыКПерепроведению", МассивИнвойсов);
	
КонецПроцедуры

// Ставит в очередь ПН по инвойсам отправки / AWB (текущие + удалённые).
//
// Параметры:
//  ДокументОбъект - ДокументОбъект.Отправка, ДокументОбъект.ОтправкаAWB - инициатор каскада.
//
Процедура ЗарегистрироватьПриходныеПоИнвойсамОтправки(ДокументОбъект) Экспорт
	
	Если ПараметрыСеанса.ГрупповоеПерепроведениеДокументов = Истина Тогда
		Возврат;
	КонецЕсли;
	
	МассивИнвойсов = Неопределено;
	Если НЕ ДокументОбъект.ДополнительныеСвойства.Свойство("ИнвойсыКПерепроведению", МассивИнвойсов) Тогда
		МассивИнвойсов = ДокументОбъект.Инвойсы.Выгрузить(, "Инвойс").ВыгрузитьКолонку(0);
	КонецЕсли;
	
	Если МассивИнвойсов = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Обработанные = Новый Соответствие;
	Для Каждого Инвойс Из МассивИнвойсов Цикл
		Если НЕ ЗначениеЗаполнено(Инвойс) Тогда
			Продолжить;
		КонецЕсли;
		Если Обработанные.Получить(Инвойс) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Обработанные.Вставить(Инвойс, Истина);
		ЗарегистрироватьЗависимыеПриходныеПоИнвойсу(Инвойс, ДокументОбъект.Ссылка);
	КонецЦикла;
	
КонецПроцедуры

// Сохраняет партии товарных документов отправки перемещений (текущие + прежние) для каскада.
//
// Параметры:
//  ДокументОбъект - ДокументОбъект.ОтправкаПеремещений - записываемый документ.
//
Процедура ЗапомнитьПартииОтправкиПеремещенийКПерепроведению(ДокументОбъект) Экспорт
	
	МассивДокументов = ДокументОбъект.ТоварныеДокументы.Выгрузить(, "ТоварныйДокумент").ВыгрузитьКолонку(0);
	
	Если НЕ ДокументОбъект.ЭтоНовый() Тогда
		Запр = Новый Запрос;
		Запр.УстановитьПараметр("Ссылка", ДокументОбъект.Ссылка);
		Запр.Текст =
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ТЧ.ТоварныйДокумент КАК ТоварныйДокумент
		|ИЗ
		|	Документ.ОтправкаПеремещений.ТоварныеДокументы КАК ТЧ
		|ГДЕ
		|	ТЧ.Ссылка = &Ссылка";
		Выборка = Запр.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			Если ЗначениеЗаполнено(Выборка.ТоварныйДокумент)
				И МассивДокументов.Найти(Выборка.ТоварныйДокумент) = Неопределено Тогда
				МассивДокументов.Добавить(Выборка.ТоварныйДокумент);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	ДокументОбъект.ДополнительныеСвойства.Вставить(
		"ПартииКПерепроведению",
		ПартииТоварныхДокументов(МассивДокументов));
	
КонецПроцедуры

// Возвращает различные партии из перемещений и расходных накладных.
//
// Параметры:
//  МассивДокументов - Массив - ссылки Перемещение / РасходнаяНакладная.
//
// Возвращаемое значение:
//  Массив из СправочникСсылка.Партии.
//
Функция ПартииТоварныхДокументов(МассивДокументов) Экспорт
	
	Результат = Новый Массив;
	Если МассивДокументов = Неопределено ИЛИ МассивДокументов.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;
	
	Запр = Новый Запрос;
	Запр.УстановитьПараметр("Документы", МассивДокументов);
	Запр.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ПеремещениеТовары.Партия КАК Партия
	|ИЗ
	|	Документ.Перемещение.Товары КАК ПеремещениеТовары
	|ГДЕ
	|	ПеремещениеТовары.Ссылка В (&Документы)
	|	И ПеремещениеТовары.Партия <> ЗНАЧЕНИЕ(Справочник.Партии.ПустаяСсылка)
	|
	|ОБЪЕДИНИТЬ
	|
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	РНТовары.Партия
	|ИЗ
	|	Документ.РасходнаяНакладная.Товары КАК РНТовары
	|ГДЕ
	|	РНТовары.Ссылка В (&Документы)
	|	И РНТовары.Партия <> ЗНАЧЕНИЕ(Справочник.Партии.ПустаяСсылка)";
	Выборка = Запр.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Результат.Добавить(Выборка.Партия);
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// Ставит в очередь РН (и др. по Продажи) по партиям отправки перемещений.
//
// Параметры:
//  ДокументОбъект - ДокументОбъект.ОтправкаПеремещений - инициатор каскада.
//
Процедура ЗарегистрироватьРасходныеПоОтправкеПеремещений(ДокументОбъект) Экспорт
	
	Если ПараметрыСеанса.ГрупповоеПерепроведениеДокументов = Истина Тогда
		Возврат;
	КонецЕсли;
	
	Партии = Неопределено;
	Если НЕ ДокументОбъект.ДополнительныеСвойства.Свойство("ПартииКПерепроведению", Партии) Тогда
		МассивДокументов = ДокументОбъект.ТоварныеДокументы.Выгрузить(, "ТоварныйДокумент").ВыгрузитьКолонку(0);
		Партии = ПартииТоварныхДокументов(МассивДокументов);
	КонецЕсли;
	
	ЗарегистрироватьРасходныеПоПартиям(Партии, ДокументОбъект.Ссылка);
	
КонецПроцедуры

// Приоритет документа в очереди доп.проведения (меньше — раньше).
//
// Параметры:
//  ДокументСсылка - ДокументСсылка - документ из РС ДокументыКПроведению.
//
// Возвращаемое значение:
//  Число - приоритет обработки.
//
Функция ПриоритетДокументаКПроведению(ДокументСсылка) Экспорт
	
	ТипДокумента = ТипЗнч(ДокументСсылка);
	Если ТипДокумента = Тип("ДокументСсылка._Инвойс") Тогда
		Возврат 1;
	ИначеЕсли ТипДокумента = Тип("ДокументСсылка.ПриходнаяНакладная") Тогда
		Возврат 2;
	ИначеЕсли ТипДокумента = Тип("ДокументСсылка.РасходнаяНакладная")
		ИЛИ ТипДокумента = Тип("ДокументСсылка._ВозвратОтПокупателя") Тогда
		Возврат 3;
	Иначе
		Возврат 9;
	КонецЕсли;
	
КонецФункции

Процедура ПроведениеДокументовПриЗаписи(Источник, Отказ) Экспорт
	
	Если ПараметрыСеанса.ГрупповоеПерепроведениеДокументов = Истина Тогда
		Возврат;
	КонецЕсли;
	
	Если ТипЗнч(Источник) = Тип("ДокументОбъект.ДвижениеДенег") Тогда
		Если Источник.ДополнительныеСвойства.Свойство("БезЗависимыхДокументов")
			И Источник.ДополнительныеСвойства.БезЗависимыхДокументов = Истина Тогда
			Возврат;
		КонецЕсли;
		ЗарегистрироватьИнвойсыДвиженияДенегКПроведению(Источник);
	КонецЕсли;
	
КонецПроцедуры

// Ставит в очередь инвойсы из ТЧ и ранее удалённые из ТЧ (сохранены до записи).
//
// Параметры:
//  Источник - ДокументОбъект.ДвижениеДенег - записываемый документ.
//
Процедура ЗарегистрироватьИнвойсыДвиженияДенегКПроведению(Источник)
	
	МассивИнвойсов = Неопределено;
	Если Источник.ДополнительныеСвойства.Свойство("ИнвойсыКПерепроведению", МассивИнвойсов) Тогда
		// объединённый список: текущие + удалённые из ТЧ
	ИначеЕсли Источник.ДополнительныеСвойства.Свойство("ИнвойсыДляЗаписиСтатусов", МассивИнвойсов) Тогда
		// совместимость со статусами оплаты
	Иначе
		МассивИнвойсов = Источник.Инвойсы.Выгрузить(, "Инвойс").ВыгрузитьКолонку(0);
	КонецЕсли;
	
	Если МассивИнвойсов = Неопределено ИЛИ МассивИнвойсов.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ИнвойсыБезПересчета = Новый Соответствие;
	Для Каждого СтрокаТЧ Из Источник.Инвойсы Цикл
		Если СтрокаТЧ.НеПересчитыватьПриходТовара И ЗначениеЗаполнено(СтрокаТЧ.Инвойс) Тогда
			ИнвойсыБезПересчета.Вставить(СтрокаТЧ.Инвойс, Истина);
		КонецЕсли;
	КонецЦикла;
	
	Обработанные = Новый Соответствие;
	Для Каждого Инвойс Из МассивИнвойсов Цикл
		
		Если НЕ ЗначениеЗаполнено(Инвойс) Тогда
			Продолжить;
		КонецЕсли;
		Если Обработанные.Получить(Инвойс) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Обработанные.Вставить(Инвойс, Истина);
		
		// Удалённые из ТЧ всегда перепроводим; для оставшихся уважаем флаг строки
		Если ИнвойсыБезПересчета.Получить(Инвойс) = Истина Тогда
			Продолжить;
		КонецЕсли;
		
		Если НЕ Инвойс.Проведен Тогда
			Продолжить;
		КонецЕсли;
		
		ЗарегистрироватьДокументКПроведению(Инвойс, Источник.Ссылка);
		
	КонецЦикла;
	
КонецПроцедуры

//
//
Процедура ПроведениеДокументов() Экспорт
	
	омСервер.УстановитьПараметрСеанса("ГрупповоеПерепроведениеДокументов", Истина);
	
	Попытка
		
		МаксПроходов = 5;
		Для НомерПрохода = 1 По МаксПроходов Цикл
			
			Запр = Новый Запрос;
			Запр.Текст = "ВЫБРАТЬ
			             |	ДокументыКПроведению.Документ КАК Документ,
			             |	ДокументыКПроведению.Документ.ПометкаУдаления КАК ПометкаУдаления,
			             |	ДокументыКПроведению.Инициатор КАК Инициатор,
			             |	ДокументыКПроведению.Зарегистрировано КАК Зарегистрировано
			             |ИЗ
			             |	РегистрСведений.ДокументыКПроведению КАК ДокументыКПроведению
			             |ГДЕ
			             |	ДокументыКПроведению.Документ.Проведен";
			ТаблицаОчереди = Запр.Выполнить().Выгрузить();
			Если ТаблицаОчереди.Количество() = 0 Тогда
				Прервать;
			КонецЕсли;
			
			ТаблицаОчереди.Колонки.Добавить("Приоритет", Новый ОписаниеТипов("Число"));
			Для Каждого СтрокаОчереди Из ТаблицаОчереди Цикл
				СтрокаОчереди.Приоритет = ПриоритетДокументаКПроведению(СтрокаОчереди.Документ);
			КонецЦикла;
			ТаблицаОчереди.Сортировать("Приоритет, Зарегистрировано");
			
			БылоПроведение = Ложь;
			Для Каждого СтрокаОчереди Из ТаблицаОчереди Цикл
				
				Если СтрокаОчереди.ПометкаУдаления Тогда
					ОчиститьДокументКПроведению(СтрокаОчереди.Документ);
					Продолжить;
				КонецЕсли;
				
				ДокОбъект = СтрокаОчереди.Документ.ПолучитьОбъект();
				Попытка
					ДокОбъект.Записать(РежимЗаписиДокумента.Проведение);
					ОчиститьДокументКПроведению(СтрокаОчереди.Документ);
					БылоПроведение = Истина;
					гоЗаписьЖурналаРегистрации(
						"Регламентное проведение: инициатор " + СтрокаОчереди.Инициатор,
						СтрЗаменить(Строка(ТипЗнч(СтрокаОчереди.Документ)), "ДокументСсылка.", ""),
						"Проведение",
						СтрокаОчереди.Документ,
						);
				Исключение
					гоЗаписьЖурналаРегистрации(
						"Ошибка регламентного проведения: " + ОписаниеОшибки(),
						СтрЗаменить(Строка(ТипЗнч(СтрокаОчереди.Документ)), "ДокументСсылка.", ""),
						"Проведение",
						СтрокаОчереди.Документ,
						1);
				КонецПопытки;
				
			КонецЦикла;
			
			Если НЕ БылоПроведение Тогда
				Прервать;
			КонецЕсли;
			
		КонецЦикла;
		
	Исключение
		омСервер.УстановитьПараметрСеанса("ГрупповоеПерепроведениеДокументов", Ложь);
		ВызватьИсключение;
	КонецПопытки;
	
	Попытка
		Последовательности.ПартииВалют.Восстановить();
	Исключение
		гоЗаписьЖурналаРегистрации(
			"Ошибка восстановления последовательности партий валют: " + ОписаниеОшибки(),
			,
			"Проведение",
			,
			);
	КонецПопытки;

	омСервер.УстановитьПараметрСеанса("ГрупповоеПерепроведениеДокументов", Ложь);
	
КонецПроцедуры

// Удаляет документ из РС ДокументыКПроведению.
//
// Параметры:
//  ДокументСсылка - ДокументСсылка - документ очереди.
//
Процедура ОчиститьДокументКПроведению(ДокументСсылка)
	
	НаборЗаписей = РегистрыСведений.ДокументыКПроведению.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.Документ.Установить(ДокументСсылка);
	НаборЗаписей.Записать();
	
КонецПроцедуры
