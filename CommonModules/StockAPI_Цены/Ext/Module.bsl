Функция СоздатьДокументУстановкиЦен(Запрос, ДанныеЗапроса, КонтекстАвторизации) Экспорт
	
	Результат = Новый Структура("success,error,documentNumber,items", Ложь, "", "", 0);
	
	Если ДанныеЗапроса = Неопределено Тогда
		Результат.error = "Тело запроса пустое.";
		Возврат Результат;
	КонецЕсли;
	
	ВидЦены = ВидЦеныДляЗаписиAPI(StockAPI_Утилиты.ЗначениеПоляJSON(ДанныеЗапроса, "priceType"));
	Если НЕ ЗначениеЗаполнено(ВидЦены) Тогда
		Результат.error = "Не найден вид цены priceType.";
		Возврат Результат;
	КонецЕсли;
	
	Валюта = ВалютаДляЗаписиAPI(StockAPI_Утилиты.ЗначениеПоляJSON(ДанныеЗапроса, "currency"));
	Если НЕ ЗначениеЗаполнено(Валюта) Тогда
		Результат.error = "Не найдена валюта currency.";
		Возврат Результат;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ВидЦены.Валюта) И ВидЦены.Валюта <> Валюта Тогда
		Результат.error = СтрШаблон("Валюта %1 не соответствует виду цены %2.", Строка(Валюта), Строка(ВидЦены));
		Возврат Результат;
	КонецЕсли;
	
	Склад = StockAPI_Справочники.НайтиСклад(ДанныеЗапроса, КонтекстАвторизации.УчетнаяЗапись, Результат.error); 
	Если Результат.error <> "" Тогда
		Возврат Результат;
	КонецЕсли;
	
	Позиции = ПозицииЦенИзЗапроса(ДанныеЗапроса);
	Если Позиции = Неопределено Тогда
		Результат.error = "В запросе не найден массив строк items.";
		Возврат Результат;
	КонецЕсли;
	
	Документ = Документы.УстановкаЦен.СоздатьДокумент();
	Документ.Дата 		= ТекущаяДатаСеанса();
	Документ.Фирма 		= гоФирма();
	Документ.КемСоздан 	= гоПользователь();
	Документ.Создан 	= ТекущаяДатаСеанса();
	Документ.Склад 		= Склад;
	Документ.ПороговЦен = 0;
	Документ.Примечание = "Создано StockAPI";
	Документ.ВидыЦен.Добавить().ВидЦены = ВидЦены;
	
	НомСтроки = 0;
	Для Каждого Позиция Из Позиции Цикл
		
		Номенклатура = НоменклатураДляЗаписиЦенAPI(StockAPI_Утилиты.ЗначениеПоляJSON(Позиция, "itemCode"));
		Если НЕ ЗначениеЗаполнено(Номенклатура) Тогда
			Результат.error = СтрШаблон("Не найдена номенклатура itemCode=%1.", Строка(StockAPI_Утилиты.ЗначениеПоляJSON(Позиция, "itemCode")));
			Возврат Результат;
		КонецЕсли;
		
		ЦеныПозиции = StockAPI_Утилиты.ЗначениеПоляJSON(Позиция, "price");
		Если ЦеныПозиции = Неопределено Тогда
			Результат.error = СтрШаблон("Для товара %1 не заполнен массив price.", Строка(StockAPI_Утилиты.ЗначениеПоляJSON(Позиция, "itemCode")));
			Возврат Результат;
		КонецЕсли;
		
		НомСтроки = НомСтроки + 1;
		СтрокаЦены = Документ.Товары.Добавить();
		СтрокаЦены.НомСтроки 		= НомСтроки;
		СтрокаЦены.Номенклатура 	= Номенклатура;
		СтрокаЦены.ВидЦены 			= ВидЦены;
		СтрокаЦены.РазрешитьПродажу = Истина;
		
		ПороговЦенСтроки = ЗаполнитьЦеныСтрокиДокументаAPI(СтрокаЦены, ЦеныПозиции);
		Если ПороговЦенСтроки > Документ.ПороговЦен Тогда
			Документ.ПороговЦен = ПороговЦенСтроки;
		КонецЕсли;
		
	КонецЦикла;
	
	Если Документ.Товары.Количество() = 0 Тогда
		Результат.error = "В запросе нет строк цен.";
		Возврат Результат;
	КонецЕсли;
	
	Документ.Записать(РежимЗаписиДокумента.Проведение);
	
	Результат.success 			= Истина;
	Результат.documentNumber 	= Документ.Номер;
	Результат.items 			= Документ.Товары.Количество();
	
	Возврат Результат;
	
КонецФункции

Функция ПозицииЦенИзЗапроса(ДанныеЗапроса)
	
	Позиции = StockAPI_Утилиты.ЗначениеПоляJSON(ДанныеЗапроса, "items");
	Если Позиции <> Неопределено Тогда
		Возврат Позиции;
	КонецЕсли;
	
	Позиции = StockAPI_Утилиты.ЗначениеПоляJSON(ДанныеЗапроса, "prices");
	Если Позиции <> Неопределено Тогда
		Возврат Позиции;
	КонецЕсли;
	
	Позиции = StockAPI_Утилиты.ЗначениеПоляJSON(ДанныеЗапроса, "data");
	Если Позиции <> Неопределено Тогда
		Возврат Позиции;
	КонецЕсли;
	
	Если StockAPI_Утилиты.ЗначениеПоляJSON(ДанныеЗапроса, "itemCode") <> Неопределено Тогда
		Позиции = Новый Массив;
		Позиции.Добавить(ДанныеЗапроса);
		Возврат Позиции;
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции

Функция ВидЦеныПоИмениВаюты(ИмяВалюты) Экспорт

	Результат = Новый Структура("ВидЦены, ВидЦеныСтрокой, Валюта", 
								Справочники.ВидыЦен.ПустаяСсылка(), "", Справочники.Валюты.ПустаяСсылка());
	Если ЗначениеЗаполнено(ИмяВалюты) Тогда
		Запрос = Новый Запрос;
		Запрос.УстановитьПараметр("ИмяВалюты", ИмяВалюты);
		Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
		               |	Валюты.Ссылка КАК Валюта
		               |ИЗ
		               |	Справочник.Валюты КАК Валюты
		               |ГДЕ
		               |	НЕ Валюты.ПометкаУдаления
		               |	И (Валюты.Код = &ИмяВалюты
		               |			ИЛИ Валюты.Наименование = &ИмяВалюты
		               |			ИЛИ Валюты.КодISO = &ИмяВалюты)";
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			Результат.Валюта 		= Выборка.Валюта;
			Результат.ВидЦены 		= Справочники.ВидыЦен.НайтиПоРеквизиту("Валюта", Выборка.Валюта); 
			Результат.ВидЦеныСтрокой= Результат.ВидЦены.НаименованиеДляAPI;
		КонецЕсли;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции 

Функция ВидЦеныДляЗаписиAPI(ИмяВидаЦены)
	
	Если ИмяВидаЦены = Неопределено Тогда
		Возврат Справочники.ВидыЦен.ПустаяСсылка();
	КонецЕсли;
	
	Возврат Справочники.ВидыЦен.НайтиПоРеквизиту("НаименованиеДляAPI", СокрЛП(Строка(ИмяВидаЦены)));
	
КонецФункции

Функция ВалютаДляЗаписиAPI(ИмяВалюты) Экспорт
	
	Если ИмяВалюты = Неопределено Тогда
		Возврат Справочники.Валюты.ПустаяСсылка();
	КонецЕсли;
	
	Норм = ВРег(СокрЛП(Строка(ИмяВалюты)));
	Если Норм = "" Тогда
		Возврат Справочники.Валюты.ПустаяСсылка();
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ИмяВалюты", Норм);
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
	               |	Валюты.Ссылка КАК Валюта
	               |ИЗ
	               |	Справочник.Валюты КАК Валюты
	               |ГДЕ
	               |	НЕ Валюты.ПометкаУдаления
	               |	И ((ВЫРАЗИТЬ(Валюты.Код КАК СТРОКА(20))) = &ИмяВалюты
	               |			ИЛИ Валюты.Наименование = &ИмяВалюты
	               |			ИЛИ Валюты.КодISO = &ИмяВалюты)";
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Валюта;
	КонецЕсли;
	
	Возврат Справочники.Валюты.ПустаяСсылка();
	
КонецФункции

Функция НоменклатураДляЗаписиЦенAPI(КодНоменклатуры)
	
	Если КодНоменклатуры = Неопределено Тогда
		Возврат Справочники.Номенклатура.ПустаяСсылка();
	КонецЕсли;
	
	Возврат Справочники.Номенклатура.НайтиПоКоду(СокрЛП(Строка(КодНоменклатуры)));
	
КонецФункции

Функция ЗаполнитьЦеныСтрокиДокументаAPI(СтрокаЦены, ЦеныПозиции)
	
	ПороговЦен = 0;
	
	Для Каждого СтрокаПрайса Из ЦеныПозиции Цикл
		
		Количество = Число(StockAPI_Утилиты.ЗначениеПоляJSON(СтрокаПрайса, "qty"));
		Цена = Число(StockAPI_Утилиты.ЗначениеПоляJSON(СтрокаПрайса, "priceQty"));
		
		Если Количество = 0 Тогда
			СтрокаЦены.Цена0 = Цена;
		ИначеЕсли СтрокаЦены.Порог1 = 0 Тогда
			СтрокаЦены.Порог1 = Количество;
			СтрокаЦены.Цена1 = Цена;
			ПороговЦен = 1;
		ИначеЕсли СтрокаЦены.Порог2 = 0 Тогда
			СтрокаЦены.Порог2 = Количество;
			СтрокаЦены.Цена2 = Цена;
			ПороговЦен = 2;
		ИначеЕсли СтрокаЦены.Порог3 = 0 Тогда
			СтрокаЦены.Порог3 = Количество;
			СтрокаЦены.Цена3 = Цена;
			ПороговЦен = 3;
		Иначе
			ВызватьИсключение "Документ УстановкаЦен поддерживает не более трех порогов цен.";
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат ПороговЦен;
	
КонецФункции
