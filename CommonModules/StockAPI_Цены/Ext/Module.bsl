// Цены StockAPI: вид цены, загрузка из регистра, проверка при создании/изменении заказа.

// Загружает цены продажи из регистра ЦеныПродажи на заданную дату.
// Возвращает Соответствие: Номенклатура → {Цена0..Цена3, Порог1..Порог3, РазрешитьПродажу, Валюта}.
//
// Параметры:
//  МассивНоменклатуры - Массив - ссылки номенклатуры;
//  ВидЦены            - СправочникСсылка.ВидыЦен;
//  Склад              - СправочникСсылка.Склады;
//  Валюта             - СправочникСсылка.Валюты - измерение регистра (обязательно).
//
// Возвращаемое значение:
//  Соответствие - цены по номенклатуре.
//
Функция ЗагрузитьЦеныПродажи(МассивНоменклатуры, ВидЦены, Склад, Валюта) Экспорт
	
	Результат = Новый Соответствие;
	
	Если МассивНоменклатуры.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;
	
	Зап = Новый Запрос;
	Зап.Текст = "ВЫБРАТЬ
	            |	Цены.Номенклатура КАК Номенклатура,
	            |	Цены.Цена0 КАК Цена0,
	            |	Цены.Цена1 КАК Цена1,
	            |	Цены.Цена2 КАК Цена2,
	            |	Цены.Цена3 КАК Цена3,
	            |	Цены.Порог1 КАК Порог1,
	            |	Цены.Порог2 КАК Порог2,
	            |	Цены.Порог3 КАК Порог3,
	            |	Цены.РазрешитьПродажу КАК РазрешитьПродажу,
	            |	Цены.Валюта.Наименование КАК Валюта
	            |ИЗ
	            |	РегистрСведений.ЦеныПродажи.СрезПоследних(
	            |			,
	            |			Номенклатура В (&Номенклатура)
	            |				И ВидЦены = &ВидЦены
	            |				И Склад = &Склад
	            |				И Валюта = &Валюта) КАК Цены";
	Зап.УстановитьПараметр("Номенклатура", 	МассивНоменклатуры);
	Зап.УстановитьПараметр("ВидЦены", 		ВидЦены);
	Зап.УстановитьПараметр("Склад", 		Склад);
	Зап.УстановитьПараметр("Валюта", 		Валюта);
	
	Выборка = Зап.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		СтруктураЗаписи = Новый Структура("Цена0,Цена1,Цена2,Цена3,Порог1,Порог2,Порог3,РазрешитьПродажу,Валюта");   
		ЗаполнитьЗначенияСвойств(СтруктураЗаписи, Выборка);
		Результат.Вставить(Выборка.Номенклатура, СтруктураЗаписи);
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// Загружает все цены продажи из регистра ЦеныПродажи для пар номенклатура+склад.
//
// Параметры:
//  МассивНоменклатуры - Массив - ссылки номенклатуры;
//  МассивСкладов      - Массив - ссылки складов.
//
// Возвращаемое значение:
//  Соответствие - ключ КлючНоменклатураСкладДляЦен, значение — массив структур
//   {priceType, currency, prices} для ответа GET /balances без priceType и currency.
//
Функция ЗагрузитьВсеЦеныПродажиДляОстатков(МассивНоменклатуры, МассивСкладов) Экспорт
	
	Результат = Новый Соответствие;
	
	Если МассивНоменклатуры.Количество() = 0 Или МассивСкладов.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;
	
	Зап = Новый Запрос;
	Зап.Текст = "ВЫБРАТЬ
	            |	Цены.Номенклатура КАК Номенклатура,
	            |	Цены.Склад КАК Склад,
	            |	Цены.ВидЦены КАК ВидЦены,
	            |	Цены.Валюта КАК Валюта,
	            |	Цены.Цена0 КАК Цена0,
	            |	Цены.Цена1 КАК Цена1,
	            |	Цены.Цена2 КАК Цена2,
	            |	Цены.Цена3 КАК Цена3,
	            |	Цены.Порог1 КАК Порог1,
	            |	Цены.Порог2 КАК Порог2,
	            |	Цены.Порог3 КАК Порог3
	            |ИЗ
	            |	РегистрСведений.ЦеныПродажи.СрезПоследних(
	            |			,
	            |			Номенклатура В (&Номенклатура)
	            |				И Склад В (&Склады)) КАК Цены
	            |УПОРЯДОЧИТЬ ПО
	            |	Цены.Номенклатура,
	            |	Цены.Склад,
	            |	Цены.ВидЦены.Наименование,
	            |	Цены.Валюта.Код";
	Зап.УстановитьПараметр("Номенклатура", МассивНоменклатуры);
	Зап.УстановитьПараметр("Склады", МассивСкладов);
	
	Выборка = Зап.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		
		Ключ = КлючНоменклатураСкладДляЦен(Выборка.Номенклатура, Выборка.Склад);
		МассивЦен = Результат.Получить(Ключ);
		Если МассивЦен = Неопределено Тогда
			МассивЦен = Новый Массив;
			Результат.Вставить(Ключ, МассивЦен);
		КонецЕсли;
		
		ЭлементЦены = Новый Структура;
		ЭлементЦены.Вставить("priceType", ПредставлениеВидаЦеныДляAPI(Выборка.ВидЦены));
		ЭлементЦены.Вставить("currency", ПредставлениеВалютыДляAPI(Выборка.Валюта));
		ЭлементЦены.Вставить("prices", МассивПороговЦенДляAPI(
			Выборка.Цена0, Выборка.Цена1, Выборка.Цена2, Выборка.Цена3,
			Выборка.Порог1, Выборка.Порог2, Выборка.Порог3));
		МассивЦен.Добавить(ЭлементЦены);
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// Ключ для группировки цен по паре номенклатура+склад.
//
// Параметры:
//  Номенклатура - СправочникСсылка.Номенклатура;
//  Склад        - СправочникСсылка.Склады.
//
// Возвращаемое значение:
//  Строка - составной ключ.
//
Функция КлючНоменклатураСкладДляЦен(Номенклатура, Склад) Экспорт
	
	Возврат СтрШаблон("%1|%2", XMLСтрока(Номенклатура), XMLСтрока(Склад));
	
КонецФункции

// Формирует массив порогов цены для ответа API (priceQty/qty).
//
// Параметры:
//  Цена0, Цена1, Цена2, Цена3 - Число - цены по порогам;
//  Порог1, Порог2, Порог3     - Число - количественные пороги.
//
// Возвращаемое значение:
//  Массив из Структура с полями priceQty, qty.
//
Функция МассивПороговЦенДляAPI(Цена0, Цена1, Цена2, Цена3, Порог1, Порог2, Порог3) Экспорт
	
	Мас = Новый Массив;
	Мас.Добавить(Новый Структура("priceQty,qty", Цена0, 0));
	
	Цены = Новый Массив;
	Цены.Добавить(Цена1);
	Цены.Добавить(Цена2);
	Цены.Добавить(Цена3);
	Пороги = Новый Массив;
	Пороги.Добавить(Порог1);
	Пороги.Добавить(Порог2);
	Пороги.Добавить(Порог3);
	
	Для Инд = 0 По 2 Цикл
		Если Цены[Инд] > 0 Тогда
			Мас.Добавить(Новый Структура("priceQty,qty", Цены[Инд], Пороги[Инд]));
		КонецЕсли;
	КонецЦикла;
	
	Возврат Мас;
	
КонецФункции

// Извлекает цену из позиции запроса (поля price или salePrice).
//
Функция ЦенаИзПозицииЗапроса(Позиция) Экспорт
	
	Если Позиция.Свойство("price") Тогда
		Возврат Число(Позиция.price);
	КонецЕсли;
	
	Если Позиция.Свойство("salePrice") Тогда
		Возврат Число(Позиция.salePrice);
	КонецЕсли;
	
	Возврат 0;
	
КонецФункции

Функция ЦеныСовпадают(ЦенаЗапроса, ОжидаемаяЦена) Экспорт
	
	Возврат Окр(ЦенаЗапроса, 2) = Окр(ОжидаемаяЦена, 2);
	
КонецФункции

// Проверяет, допустима ли цена строки заказа относительно цены из регистра
// с учётом настроек учётной записи API.
//
// Параметры:
//  ЦенаЗапроса - Число - цена из запроса;
//  ОжидаемаяЦена - Число - цена продажи по регистру для количества;
//  РазрешитьПревышениеЦен - Булево - разрешены цены выше установленных;
//  РазрешитьСнижениеЦенНа - Число - допустимое снижение в процентах
//   (0 / не заполнено — снижение не допускается).
//
// Возвращаемое значение:
//  Булево - Истина, если цену можно перенести в заказ.
//
Функция ЦенаСтрокиЗаказаДопустима(ЦенаЗапроса, ОжидаемаяЦена, РазрешитьПревышениеЦен, РазрешитьСнижениеЦенНа) Экспорт
	
	Если ЦеныСовпадают(ЦенаЗапроса, ОжидаемаяЦена) Тогда
		Возврат Истина;
	КонецЕсли;
	
	ЦенаЗапросаОкр = Окр(ЦенаЗапроса, 2);
	ОжидаемаяЦенаОкр = Окр(ОжидаемаяЦена, 2);
	
	Если ЦенаЗапросаОкр > ОжидаемаяЦенаОкр Тогда
		Возврат РазрешитьПревышениеЦен = Истина;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(РазрешитьСнижениеЦенНа) Или РазрешитьСнижениеЦенНа <= 0 Тогда
		Возврат Ложь;
	КонецЕсли;
	
	МинимальнаяЦена = Окр(ОжидаемаяЦена * (1 - РазрешитьСнижениеЦенНа / 100), 2);
	Возврат ЦенаЗапросаОкр >= МинимальнаяЦена;
	
КонецФункции

// Текст допустимого диапазона цены для сообщения об ошибке
// (по настройкам учётной записи).
//
// Параметры:
//  ОжидаемаяЦена - Число - цена продажи по регистру;
//  РазрешитьПревышениеЦен - Булево - разрешены цены выше установленных;
//  РазрешитьСнижениеЦенНа - Число - допустимое снижение в процентах.
//
// Возвращаемое значение:
//  Строка - фрагмент сообщения («допустимо …»).
//
Функция ТекстДопустимогоДиапазонаЦен(ОжидаемаяЦена, РазрешитьПревышениеЦен, РазрешитьСнижениеЦенНа)
	
	ФорматЦены = "ЧДЦ=2; ЧРД=.; ЧГ=0";
	ОжидаемаяОкр = Окр(ОжидаемаяЦена, 2);
	ОжидаемаяТекст = Формат(ОжидаемаяОкр, ФорматЦены);
	
	МинимальнаяЦена = ОжидаемаяОкр;
	Если ЗначениеЗаполнено(РазрешитьСнижениеЦенНа) И РазрешитьСнижениеЦенНа > 0 Тогда
		МинимальнаяЦена = Окр(ОжидаемаяЦена * (1 - РазрешитьСнижениеЦенНа / 100), 2);
	КонецЕсли;
	
	Если НЕ РазрешитьПревышениеЦен И МинимальнаяЦена >= ОжидаемаяОкр Тогда
		Возврат СтрШаблон("допустимо %1", ОжидаемаяТекст);
	КонецЕсли;
	
	Если НЕ РазрешитьПревышениеЦен Тогда
		Возврат СтрШаблон("допустимо от %1 до %2",
			Формат(МинимальнаяЦена, ФорматЦены),
			ОжидаемаяТекст);
	КонецЕсли;
	
	Если МинимальнаяЦена < ОжидаемаяОкр Тогда
		Возврат СтрШаблон("допустимо от %1 и выше", Формат(МинимальнаяЦена, ФорматЦены));
	КонецЕсли;
	
	Возврат СтрШаблон("допустимо %1 и выше", ОжидаемаяТекст);
	
КонецФункции

// Проверяет цены строк заказа относительно регистра ЦеныПродажи
// с учётом допусков учётной записи (РазрешитьПревышениеЦен, РазрешитьСнижениеЦенНа).
// Без настроек (или если реквизиты не заданы) допускается только точное совпадение.
//
// Параметры:
//  СтрокиЗаказа - Массив - строки с полями Номенклатура, Количество, Цена, НомерПозиции;
//  ЦеныПродажи - Соответствие - цены из регистра;
//  ВидЦены - СправочникСсылка.ВидыЦен - для текста ошибки;
//  УчетнаяЗапись - СправочникСсылка.УчетныеЗаписиИнтеграции - настройки допуска (необязательно).
//
// Возвращаемое значение:
//  СписокЗначений - тексты ошибок; пустой список, если цены корректны.
//
Функция ПроверитьЦеныСтрокЗаказа(СтрокиЗаказа, ЦеныПродажи, ВидЦены, УчетнаяЗапись = Неопределено) Экспорт
	
	Ошибки = Новый СписокЗначений;
	
	ИмяВидаЦены = ПредставлениеВидаЦеныДляAPI(ВидЦены);
	
	РазрешитьПревышениеЦен = Ложь;
	РазрешитьСнижениеЦенНа = 0;
	Если ЗначениеЗаполнено(УчетнаяЗапись) Тогда
		РазрешитьПревышениеЦен = УчетнаяЗапись.РазрешитьПревышениеЦен;
		РазрешитьСнижениеЦенНа = УчетнаяЗапись.РазрешитьСнижениеЦенНа;
	КонецЕсли;
	
	Для Каждого СтрЗаказа Из СтрокиЗаказа Цикл
		
		ДанныеЦены = ЦеныПродажи.Получить(СтрЗаказа.Номенклатура);
		ОжидаемаяЦена = ЦенаПродажиПоКоличеству(ДанныеЦены, СтрЗаказа.Количество);
		
		Если ОжидаемаяЦена <= 0 Тогда
			Ошибки.Добавить(СтрШаблон("Строка %1: для товара %2 не задана цена продажи (вид цены '%3').",
				СтрЗаказа.НомерПозиции,
				Строка(СтрЗаказа.Номенклатура),
				ИмяВидаЦены));
			Продолжить;
		КонецЕсли;
		
		Если НЕ ЦенаСтрокиЗаказаДопустима(СтрЗаказа.Цена, ОжидаемаяЦена, РазрешитьПревышениеЦен, РазрешитьСнижениеЦенНа) Тогда
			ДиапазонЦен = ТекстДопустимогоДиапазонаЦен(ОжидаемаяЦена, РазрешитьПревышениеЦен, РазрешитьСнижениеЦенНа);
			Ошибки.Добавить(СтрШаблон("Строка %1: неверная цена. Указано %2, установленная %3, %4 (price, вид цены '%5').",
				СтрЗаказа.НомерПозиции,
				Формат(СтрЗаказа.Цена, "ЧДЦ=2; ЧРД=.; ЧГ=0"),
				Формат(ОжидаемаяЦена, "ЧДЦ=2; ЧРД=.; ЧГ=0"),
				ДиапазонЦен,
				ИмяВидаЦены));
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Ошибки;
	
КонецФункции

// Определяет цену продажи с учётом порога количества. 
//
Функция ЦенаПродажиПоКоличеству(ДанныеЦены, Количество) Экспорт
	
	Если ДанныеЦены = Неопределено Тогда
		Возврат 0;
	КонецЕсли;
	
	Если ДанныеЦены.Порог3 > 0
		И Количество >= ДанныеЦены.Порог3
		И ДанныеЦены.Цена3 > 0 Тогда
		Возврат ДанныеЦены.Цена3;
	КонецЕсли;
	Если ДанныеЦены.Порог2 > 0
		И Количество >= ДанныеЦены.Порог2
		И ДанныеЦены.Цена2 > 0 Тогда
		Возврат ДанныеЦены.Цена2;
	КонецЕсли;
	Если ДанныеЦены.Порог1 > 0
		И Количество >= ДанныеЦены.Порог1
		И ДанныеЦены.Цена1 > 0 Тогда
		Возврат ДанныеЦены.Цена1;
	КонецЕсли;
	
	Возврат ДанныеЦены.Цена0;
	
КонецФункции

//
//
Функция СоздатьДокументУстановкиЦен(Запрос, ДанныеЗапроса, КонтекстАвторизации) Экспорт
	
	Результат = Новый Структура("success,error,documentNumber,items", Ложь, "", "", 0);
	
	Если ДанныеЗапроса = Неопределено Тогда
		Результат.error = "Тело запроса пустое.";
		Возврат Результат;
	КонецЕсли;
	
	ПараметрыЦен = ВидЦеныИВалютаИзДанныхЗапроса(ДанныеЗапроса, Истина);
	Если ПараметрыЦен.Ошибка <> "" Тогда
		Результат.error = ПараметрыЦен.Ошибка;
		Возврат Результат;
	КонецЕсли;
	ВидЦены = ПараметрыЦен.ВидЦены;
	Валюта = ПараметрыЦен.Валюта;
	
	Склад = StockAPI_Справочники.НайтиСклад(ДанныеЗапроса, КонтекстАвторизации.УчетнаяЗапись, Результат.error); 
	Если Результат.error <> "" Тогда
		Возврат Результат;
	КонецЕсли;
	
	Позиции = ПозицииЦенИзЗапроса(ДанныеЗапроса);
	Если Позиции = Неопределено Тогда
		Результат.error = "В запросе не найден массив строк items.";
		Возврат Результат;
	КонецЕсли;
	
	Документ = Документы.УстановкаЦен.СоздатьДокумент();
	Документ.Дата 			= ТекущаяДатаСеанса();
	Документ.Фирма 			= гоФирма();
	Документ.КемСоздан 		= гоПользователь();  
	Документ.УчетнаяЗапись 	= КонтекстАвторизации.УчетнаяЗапись;
	Документ.Создан 		= ТекущаяДатаСеанса();
	Документ.Склад 			= Склад;
	Документ.ПороговЦен 	= 0;
	Документ.Примечание 	= СтрШаблон("Создано StockAPI (%1)", КонтекстАвторизации.УчетнаяЗапись.Наименование);
	СтрокаВидаЦены = Документ.ВидыЦен.Добавить();
	СтрокаВидаЦены.ВидЦены 	= ВидЦены;
	СтрокаВидаЦены.Валюта 	= Валюта;
	
	// Корневой salesBan — значение по умолчанию; приоритет у salesBan в позиции items[]
	// (уровень детализации: склад + вид цены + валюта + номенклатура).
	ЗапретПродажиПоУмолчанию = StockAPI_Утилиты.БулевоПараметраЗапроса(ДанныеЗапроса, "salesBan") = Истина;
	
	НомСтроки = 0;
	Для Каждого Позиция Из Позиции Цикл
		
		Номенклатура = НоменклатураДляЗаписиЦенAPI(StockAPI_Утилиты.ЗначениеПоляJSON(Позиция, "itemCode"));
		Если НЕ ЗначениеЗаполнено(Номенклатура) Тогда
			Результат.error = СтрШаблон("Не найдена номенклатура itemCode=%1.", Строка(StockAPI_Утилиты.ЗначениеПоляJSON(Позиция, "itemCode")));
			Возврат Результат;
		КонецЕсли;
		
		ЦеныПозиции = StockAPI_Утилиты.ЗначениеПоляJSON(Позиция, "price");
		Если ЦеныПозиции = Неопределено Тогда
			Результат.error = СтрШаблон("Для товара %1 не заполнен массив price.", Строка(StockAPI_Утилиты.ЗначениеПоляJSON(Позиция, "itemCode")));
			Возврат Результат;
		КонецЕсли;
		
		ЗапретПродажиПозиции = StockAPI_Утилиты.БулевоПараметраЗапроса(Позиция, "salesBan");
		Если ЗапретПродажиПозиции = Неопределено Тогда
			РазрешитьПродажу = НЕ ЗапретПродажиПоУмолчанию;
		Иначе
			РазрешитьПродажу = НЕ ЗапретПродажиПозиции;
		КонецЕсли;
		
		НомСтроки = НомСтроки + 1;
		СтрокаЦены = Документ.Товары.Добавить();
		СтрокаЦены.НомСтроки 		= НомСтроки;
		СтрокаЦены.Номенклатура 	= Номенклатура;
		СтрокаЦены.ВидЦены 			= ВидЦены;
		СтрокаЦены.Валюта 			= Валюта;
		СтрокаЦены.РазрешитьПродажу = РазрешитьПродажу;
		
		ПороговЦенСтроки = ЗаполнитьЦеныСтрокиДокументаAPI(СтрокаЦены, ЦеныПозиции);
		Если ПороговЦенСтроки > Документ.ПороговЦен Тогда
			Документ.ПороговЦен = ПороговЦенСтроки;
		КонецЕсли;
		
	КонецЦикла;
	
	Если Документ.Товары.Количество() = 0 Тогда
		Результат.error = "В запросе нет строк с ценами.";
		Возврат Результат;
	КонецЕсли;
	
	Документ.Записать(РежимЗаписиДокумента.Проведение);
	
	Результат.success 			= Истина;
	Результат.documentNumber 	= Документ.Номер;
	Результат.items 			= Документ.Товары.Количество();
	ДобавитьПоляВидаЦеныВСтруктуру(Результат, ВидЦены, Валюта);
	
	Возврат Результат;
	
КонецФункции

Функция ПозицииЦенИзЗапроса(ДанныеЗапроса)
	
	Позиции = StockAPI_Утилиты.ЗначениеПоляJSON(ДанныеЗапроса, "items");
	Если Позиции <> Неопределено Тогда
		Возврат Позиции;
	КонецЕсли;
	
	Позиции = StockAPI_Утилиты.ЗначениеПоляJSON(ДанныеЗапроса, "prices");
	Если Позиции <> Неопределено Тогда
		Возврат Позиции;
	КонецЕсли;
	
	Позиции = StockAPI_Утилиты.ЗначениеПоляJSON(ДанныеЗапроса, "data");
	Если Позиции <> Неопределено Тогда
		Возврат Позиции;
	КонецЕсли;
	
	Если StockAPI_Утилиты.ЗначениеПоляJSON(ДанныеЗапроса, "itemCode") <> Неопределено Тогда
		Позиции = Новый Массив;
		Позиции.Добавить(ДанныеЗапроса);
		Возврат Позиции;
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции

// Разбирает пару priceType + currency из тела JSON-запроса.
// Обязательность currency совпадает с обязательностью priceType.
//
// Параметры:
//  ДанныеЗапроса   - Структура - тело запроса;
//  Обязательные    - Булево - если Истина, оба параметра обязательны.
//
// Возвращаемое значение:
//  Структура - поля ВидЦены, Валюта, Ошибка.
//
Функция ВидЦеныИВалютаИзДанныхЗапроса(ДанныеЗапроса, Обязательные = Ложь) Экспорт
	
	ИмяВидаЦены = Неопределено;
	ИмяВалюты = Неопределено;
	Если ДанныеЗапроса <> Неопределено Тогда
		ИмяВидаЦены = StockAPI_Утилиты.ЗначениеПоляJSON(ДанныеЗапроса, "priceType");
		ИмяВалюты = StockAPI_Утилиты.ЗначениеПоляJSON(ДанныеЗапроса, "currency");
	КонецЕсли;
	
	Возврат ВидЦеныИВалютаПоПараметрам(ИмяВидаЦены, ИмяВалюты, Обязательные);
	
КонецФункции

// Разбирает пару priceType + currency (query или тело).
//
// Параметры:
//  ИмяВидаЦены  - Строка, Неопределено;
//  ИмяВалюты    - Строка, Неопределено;
//  Обязательные - Булево - если Истина, оба параметра обязательны.
//
// Возвращаемое значение:
//  Структура - поля ВидЦены, Валюта, Ошибка.
//
Функция ВидЦеныИВалютаПоПараметрам(ИмяВидаЦены, ИмяВалюты, Обязательные = Ложь) Экспорт
	
	Результат = Новый Структура("ВидЦены, Валюта, Ошибка",
		Справочники.ВидыЦен.ПустаяСсылка(), Справочники.Валюты.ПустаяСсылка(), "");
	
	ПараметрВидаПередан = ИмяВидаЦены <> Неопределено;
	ПараметрВалютыПередан = ИмяВалюты <> Неопределено;
	ЕстьВидЦены = ПараметрВидаПередан И СокрЛП(Строка(ИмяВидаЦены)) <> "";
	ЕстьВалюта = ПараметрВалютыПередан И СокрЛП(Строка(ИмяВалюты)) <> "";
	
	Если Обязательные Тогда
		Если НЕ ПараметрВидаПередан Тогда
			Результат.Ошибка = "Параметр priceType не найден.";
			Возврат Результат;
		КонецЕсли;
		Если НЕ ЕстьВидЦены Тогда
			Результат.Ошибка = "Параметр priceType не заполнен.";
			Возврат Результат;
		КонецЕсли;
		Если НЕ ПараметрВалютыПередан Тогда
			Результат.Ошибка = "Параметр currency не найден.";
			Возврат Результат;
		КонецЕсли;
		Если НЕ ЕстьВалюта Тогда
			Результат.Ошибка = "Параметр currency не заполнен.";
			Возврат Результат;
		КонецЕсли;
	ИначеЕсли ПараметрВидаПередан Тогда
		Если НЕ ЕстьВидЦены Тогда
			Результат.Ошибка = "Параметр priceType не заполнен.";
			Возврат Результат;
		КонецЕсли;
		Если НЕ ПараметрВалютыПередан Тогда
			Результат.Ошибка = "Параметр currency не найден. Параметры priceType и currency заполняются вместе.";
			Возврат Результат;
		КонецЕсли;
		Если НЕ ЕстьВалюта Тогда
			Результат.Ошибка = "Параметр currency не заполнен.";
			Возврат Результат;
		КонецЕсли;
	ИначеЕсли ЕстьВалюта Тогда
		Результат.Ошибка = "Параметры priceType и currency заполняются вместе.";
		Возврат Результат;
	Иначе
		Возврат Результат;
	КонецЕсли;
	
	ВидЦены = ВидЦеныДляЗаписиAPI(ИмяВидаЦены);
	Если НЕ ЗначениеЗаполнено(ВидЦены) Тогда
		Результат.Ошибка = СтрШаблон("Не найден вид цены '%1'.", СокрЛП(Строка(ИмяВидаЦены)));
		Возврат Результат;
	КонецЕсли;
	
	Валюта = ВалютаДляЗаписиAPI(ИмяВалюты);
	Если НЕ ЗначениеЗаполнено(Валюта) Тогда
		Результат.Ошибка = СтрШаблон("Не найдена валюта '%1'.", СокрЛП(Строка(ИмяВалюты)));
		Возврат Результат;
	КонецЕсли;
	
	Результат.ВидЦены = ВидЦены;
	Результат.Валюта = Валюта;
	Возврат Результат;
	
КонецФункции

// Добавляет в структуру ответа поля priceType и currency.
//
// Параметры:
//  СтруктураJSON - Структура - формируемый элемент ответа;
//  ВидЦены       - СправочникСсылка.ВидыЦен;
//  Валюта        - СправочникСсылка.Валюты.
//
Процедура ДобавитьПоляВидаЦеныВСтруктуру(СтруктураJSON, ВидЦены, Валюта = Неопределено) Экспорт
	
	Если СтруктураJSON = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	СтруктураJSON.Вставить("priceType", ПредставлениеВидаЦеныДляAPI(ВидЦены));
	СтруктураJSON.Вставить("currency", ПредставлениеВалютыДляAPI(Валюта));
	
КонецПроцедуры

// Наименование вида цены для ответов API (имя элемента справочника).
//
Функция ПредставлениеВидаЦеныДляAPI(ВидЦены) Экспорт
	
	Если НЕ ЗначениеЗаполнено(ВидЦены) Тогда
		Возврат "";
	КонецЕсли;
	
	Возврат СокрЛП(Строка(ВидЦены));
	
КонецФункции

// Наименование валюты для ответов API (реквизит Код справочника Валюты).
//
Функция ПредставлениеВалютыДляAPI(Валюта) Экспорт
	
	Если НЕ ЗначениеЗаполнено(Валюта) Тогда
		Возврат "";
	КонецЕсли;
	
	Возврат СокрЛП(Валюта.Код);
	
КонецФункции

// Ищет вид цены по наименованию элемента справочника ВидыЦен.
//
Функция ВидЦеныДляЗаписиAPI(ИмяВидаЦены) Экспорт
	
	Если ИмяВидаЦены = Неопределено Тогда
		Возврат Справочники.ВидыЦен.ПустаяСсылка();
	КонецЕсли;
	
	Имя = СокрЛП(Строка(ИмяВидаЦены));
	Если Имя = "" Тогда
		Возврат Справочники.ВидыЦен.ПустаяСсылка();
	КонецЕсли;
	
	Возврат Справочники.ВидыЦен.НайтиПоНаименованию(Имя, Истина);
	
КонецФункции

// Ищет валюту по параметру currency API: сначала по реквизиту Код, затем по КодISO.
//
// Параметры:
//  ИмяВалюты - Строка, Число, Неопределено - код (Код) или код ISO (КодISO).
//
// Возвращаемое значение:
//  СправочникСсылка.Валюты - пустая ссылка, если не найдена.
//
Функция ВалютаДляЗаписиAPI(ИмяВалюты) Экспорт
	
	Если ИмяВалюты = Неопределено Тогда
		Возврат Справочники.Валюты.ПустаяСсылка();
	КонецЕсли;
	
	КодПоиска = СокрЛП(Строка(ИмяВалюты));
	Если КодПоиска = "" Тогда
		Возврат Справочники.Валюты.ПустаяСсылка();
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Код", ВРег(КодПоиска));
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
	               |	Валюты.Ссылка КАК Валюта
	               |ИЗ
	               |	Справочник.Валюты КАК Валюты
	               |ГДЕ
	               |	НЕ Валюты.ПометкаУдаления
	               |	И ВРЕГ(СОКРЛП(Валюты.Код)) = &Код";
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Валюта;
	КонецЕсли;
	
	Попытка
		КодISO = Число(КодПоиска);
	Исключение
		Возврат Справочники.Валюты.ПустаяСсылка();
	КонецПопытки;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("КодISO", КодISO);
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
	               |	Валюты.Ссылка КАК Валюта
	               |ИЗ
	               |	Справочник.Валюты КАК Валюты
	               |ГДЕ
	               |	НЕ Валюты.ПометкаУдаления
	               |	И Валюты.КодISO = &КодISO";
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Валюта;
	КонецЕсли;
	
	Возврат Справочники.Валюты.ПустаяСсылка();
	
КонецФункции

Функция НоменклатураДляЗаписиЦенAPI(КодНоменклатуры)
	
	Если КодНоменклатуры = Неопределено Тогда
		Возврат Справочники.Номенклатура.ПустаяСсылка();
	КонецЕсли;
	
	Возврат Справочники.Номенклатура.НайтиПоКоду(СокрЛП(Строка(КодНоменклатуры)));
	
КонецФункции

Функция ЗаполнитьЦеныСтрокиДокументаAPI(СтрокаЦены, ЦеныПозиции)
	
	ПороговЦен = 0;
	
	Для Каждого СтрокаПрайса Из ЦеныПозиции Цикл
		
		Количество = Число(StockAPI_Утилиты.ЗначениеПоляJSON(СтрокаПрайса, "qty"));
		Цена = Число(StockAPI_Утилиты.ЗначениеПоляJSON(СтрокаПрайса, "priceQty"));
		
		Если Количество = 0 Тогда
			СтрокаЦены.Цена0 = Цена;
		ИначеЕсли СтрокаЦены.Порог1 = 0 Тогда
			СтрокаЦены.Порог1 = Количество;
			СтрокаЦены.Цена1 = Цена;
			ПороговЦен = 1;
		ИначеЕсли СтрокаЦены.Порог2 = 0 Тогда
			СтрокаЦены.Порог2 = Количество;
			СтрокаЦены.Цена2 = Цена;
			ПороговЦен = 2;
		ИначеЕсли СтрокаЦены.Порог3 = 0 Тогда
			СтрокаЦены.Порог3 = Количество;
			СтрокаЦены.Цена3 = Цена;
			ПороговЦен = 3;
		Иначе
			ВызватьИсключение "Документ УстановкаЦен поддерживает не более трех порогов цен.";
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат ПороговЦен;
	
КонецФункции
